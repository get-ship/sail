# Rust
/target
.cargo/config.local.toml

# JS / bun
**/node_modules/
node_modules/
*.tsbuildinfo
out-tsc/
dist/

# wasm-pack output (regenerated via `bun run wasm`)
packages/sail/compiler-wasm/pkg/

# deck's OWN baked product — sail-runtime/dom/sdk-client + deck-route. Canonical
# bake target is .deck/framework/ (covered by the `.deck/` rule below). build.rs
# copies .deck/framework/sail-*.js → crates/deck/deck-core/assets/ at compile time
# (the include_str! staging path). Regenerated by `cargo run -p deck-cli -- build-assets`.
crates/deck/deck-core/assets/*.js
!crates/deck/deck-core/assets/live-reload.js
!crates/deck/deck-core/assets/error-overlay.js
crates/deck/deck-core/assets/sail-custom-elements.json

# View bundles, framework bundles, code-split chunks — all bake into .deck/ at
# build/runtime. Never tracked. Use `.deck/*` (not `.deck/`) so the exception
# below can re-include the committed empty stamp file; git cannot re-include a
# file inside an ignored parent directory.
.deck/*
# The bake stamp is committed empty and touched by `deck build-assets`; it is
# the single trigger for `deck-core/build.rs` to re-stage framework bundles.
!.deck/framework-stamp

# Generated sources
**/src/generated.ts
**/components.gen.ts
# Adjacent `.sail.d.ts` type companions — sail-compiler emits one next to each
# `.sail` so a controller's `import type { Scope } from './x.sail'` resolves with
# no rootDirs into a build dir. Regenerated by scripts/gen-component-types.mjs.
**/*.sail.d.ts
# Adjacent `.controller.ts` — post-SFC the controller lives inline in the
# `.sail`'s <controller> block; the compiler extracts it to this generated
# companion for the emit to consume. The `.sail` is the source of truth, so
# this is a build artifact, not hand-edited. (Migration window: un-migrated
# components still carry a tracked `.controller.ts` until each converts.)
**/*.controller.ts

# Logs / OS
*.log
.DS_Store

# Task artifacts (CLAUDE.md: artifacts → .artifacts/)
.artifacts/

# Ship-harness output + runtime (mirror og Ship/ship). `.ship/` holds tracked
# config too, so ignore selectively: the sail-compiler's `.ship/sail-out/` mirror,
# worktrees, and local dbs are generated/runtime — never committed.
.sail-out/
.ship/sail-out/
.ship/worktrees/
.ship/.trash/
.ship/.boundary
.ship/*.db
.ship/*.db-*

# Generated agent config — never committed (mirror og Ship/ship).
CLAUDE.md
AGENTS.md
GEMINI.md
.mcp.json
.claude/
.codex/
.cursor/
.gemini/
.grok/
.agents/
skills-lock.json

# Local worktree junk / cost benches — not product
scratch/
.l1cost/

# Agent / browser-debug screenshots dumped at repo root (never product)
/*.png
/*.jpg
/*.jpeg
/*.webp
# Mis-scaffolds if deck/cli is run from monorepo root by mistake
/routes/
/app/

# bundle-cost.mjs scratch
apps/sail-site/.bundle-cost/
.archive/

# Internal planning (not product docs)
spike-notes/
docs/ship-sail/

# Eval harness run artifacts (trajectories may contain machine paths)
eval/runs/

# Python bytecode
__pycache__/
*.py[cod]

# Hygiene prove+clean probes (tests/hygiene may write then delete these)
**/.__hygiene_*
tests/parity/geometry/out/
tests/parity/paint/out/

# Bundled action artifacts (regenerable)
**/.actions.bundle.js
