# Rust
/target
.cargo/config.local.toml

# JS / bun
**/node_modules/
node_modules/
*.tsbuildinfo
out-tsc/
dist/

# wasm-pack output (regenerated via `bun run wasm`)
packages/sail/compiler-wasm/pkg/

# deck's OWN baked product — sail-runtime/dom/sdk-client + deck-route. Canonical
# bake target is .deck/framework/ (covered by the `.deck/` rule below). build.rs
# copies .deck/framework/sail-*.js → crates/deck/deck-core/assets/ at compile time
# (the include_str! staging path). Regenerated by `cargo run -p deck-cli -- build-assets`.
crates/deck/deck-core/assets/*.js
!crates/deck/deck-core/assets/live-reload.js
!crates/deck/deck-core/assets/error-overlay.js
crates/deck/deck-core/assets/sail-custom-elements.json

# View bundles, framework bundles, code-split chunks — all bake into .deck/ at
# build/runtime. Never tracked.
.deck/

# Generated sources
**/src/generated.ts
**/components.gen.ts
# Adjacent `.sui.d.ts` type companions — sail-compiler emits one next to each
# `.sui` so a controller's `import type { Scope } from './x.sui'` resolves with
# no rootDirs into a build dir. Regenerated by scripts/gen-component-types.mjs.
**/*.sui.d.ts
# Adjacent `.controller.ts` — post-SFC the controller lives inline in the
# `.sui`'s <controller> block; the compiler extracts it to this generated
# companion for the emit to consume. The `.sui` is the source of truth, so
# this is a build artifact, not hand-edited. (Migration window: un-migrated
# components still carry a tracked `.controller.ts` until each converts.)
**/*.controller.ts

# Logs / OS
*.log
.DS_Store

# Task artifacts (CLAUDE.md: artifacts → .artifacts/)
.artifacts/

# Ship-harness output + runtime (mirror og Ship/ship). `.ship/` holds tracked
# config too, so ignore selectively: the sail-compiler's `.ship/sail-out/` mirror,
# worktrees, and local dbs are generated/runtime — never committed.
.sail-out/
.ship/sail-out/
.ship/worktrees/
.ship/.trash/
.ship/.boundary
.ship/*.db
.ship/*.db-*

# Generated agent config — never committed (mirror og Ship/ship).
CLAUDE.md
AGENTS.md
GEMINI.md
.mcp.json
.claude/
.codex/
.cursor/
.gemini/
.agents/
skills-lock.json

