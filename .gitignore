# Rust
/target
.cargo/config.local.toml

# JS / bun
**/node_modules/
node_modules/
*.tsbuildinfo
out-tsc/
dist/

# wasm-pack output (regenerated via `bun run wasm`)
packages/sail/compiler-wasm/pkg/

# deck's OWN baked product — sail-runtime/dom/sdk-client + deck-route. Canonical
# bake target is .sail/framework/. build.rs copies those sail-*.js into
# crates/deck/deck-core/assets/ at compile time (the include_str! staging path).
# Regenerated by `cargo run -p deck-cli -- build-assets`.
crates/deck/deck-core/assets/*.js
!crates/deck/deck-core/assets/live-reload.js
!crates/deck/deck-core/assets/error-overlay.js
crates/deck/deck-core/assets/sail-custom-elements.json

# Generate tree — never tracked. The cargo rebuild trigger lives at
# crates/deck/deck-core/framework-stamp (not in here).

# Generated sources
**/src/generated.ts
**/components.gen.ts
# Adjacent `.sail.d.ts` type companions — sail-compiler emits one next to each
# `.sail` so a controller's `import type { Scope } from './x.sail'` resolves with
# no rootDirs into a build dir. Regenerated by scripts/gen-component-types.mjs.
**/*.sail.d.ts
# Adjacent `.controller.ts` — post-SFC the controller lives inline in the
# `.sail`'s <controller> block; the compiler extracts it to this generated
# companion for the emit to consume. The `.sail` is the source of truth, so
# this is a build artifact, not hand-edited. (Migration window: un-migrated
# components still carry a tracked `.controller.ts` until each converts.)
**/*.controller.ts
# Adjacent CEM / JSON Schema / sail.meta next to component `.sail` sources.
# Regenerated by bake/CEM emit. Do not ignore compiler test fixtures
# (`*.expected.schema.json`) or runtime fixtures under packages/sail/.
packages/components/**/*.custom-elements.json
packages/components/**/*.sail.meta.json
packages/components/**/*.schema.json
# npm pack leftovers
*.tgz
# Generated per-tree solution tsconfigs (IDE only; overwritten on build/dev).
# Keep committed app-root tsconfigs (apps/sail-site/tsconfig.json, etc.).
apps/**/src/tsconfig.json
apps/**/routes/tsconfig.json
# Leftover `sail types` shells when the command is run from monorepo root,
# the components umbrella, or the conformance fixture (not product apps).
/tsconfig.json
/packages/components/sail/tsconfig.json
/crates/deck/deck-conformance/app/tsconfig.json
# Studio/test scratch
**/_tmp-*.sail
**/_tmp-save.sail

# Logs / OS
*.log
.DS_Store

# Task artifacts (CLAUDE.md: artifacts → .artifacts/)
.artifacts/

# Profiler dumps — not source. `sail-compiler profile` writes here if you ask.
tests/perf/baselines/

# Site crawl leftovers (absolute machine paths).
**/.static-inventory.json
**/.static-crawl.json

# Residual local dirs only — `.deck` is not a product home.
.sail-out/
# Generate (types, bake, mirrors, tasks). Deploy is `dist/` above.
.sail/
