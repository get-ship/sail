{
  "id": "mini-app-routing",
  "prompt": "Complete a small multi-route app using the provided overlay scaffold under routes/: list page at /items, detail page at /items/[id] with a route param, a 404 page, and active nav highlighting for the current section. List should link into detail; detail should show the id param; unknown paths should hit 404. Prefer the deck routing model already sketched in the scaffold — extend it, do not replace with a single-page hash hack unless routing is truly unavailable. Follow AGENTS.md: read the skill first, check after every edit, stop only when checks are fully clean.",
  "systems": ["routing"],
  "scaffold": "overlay",
  "overlay": [
    "routes/page.sail",
    "routes/_layout.sail",
    "routes/items/page.sail",
    "routes/items/[id]/page.sail",
    "routes/404.sail"
  ],
  "grading": {
    "compile": true,
    "vocab_share": { "min": 0.25 },
    "gates": true,
    "beauty": true
  },
  "falsification": "Is the deck routing model discoverable + sufficient?"
}
