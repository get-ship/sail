{
  "name": "sail-framework",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/sail/compiler-wasm",
      "packages/sail/dom",
      "packages/sail/runtime",
      "packages/sail/tokens",
      "packages/sail/test-setup",
      "packages/sail/tutorial",
      "packages/sail/studio-bridge",
      "packages/sail/studio-shell",
      "packages/sail/studio-client",
      "packages/components/sail/*",
      "packages/deck/*",
      "apps/*"
    ]
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@ship/sdk": "^0.2.0"
  },
  "trustedDependencies": [
    "lightningcss"
  ],
  "scripts": {
    "wasm": "wasm-pack build crates/sail/compiler --target web --out-dir ../../../packages/sail/compiler-wasm/pkg --out-name sail_compiler -- --features wasm",
    "build:bundles": "cargo run -p deck-cli -- build-assets",
    "typecheck": "node scripts/typecheck-components.mjs",
    "typecheck:tsgo": "tsgo --noEmit -p packages/sail/runtime/tsconfig.json && tsgo --noEmit -p packages/sail/dom/tsconfig.json",
    "test": "bash -c 'vitest run; v=$?; bun test tests/hygiene || v=1; exit $v'",
    "test:vitest": "vitest run",
    "test:hygiene": "bun test tests/hygiene"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript/native-preview": "^7.0.0-dev.20260628.1",
    "lucide-static": "^1.22.0",
    "playwright": "^1.59.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
