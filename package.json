{
  "name": "sail-framework",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/sail/compiler-wasm",
      "packages/sail/dom",
      "packages/sail/runtime",
      "packages/sail/tokens",
      "packages/sail/test-setup",
      "packages/sail/sail-test",
      "packages/sail/l1",
      "packages/sail/blocks",
      "packages/sail/studio-bridge",
      "packages/sail/studio-shell",
      "packages/sail/studio-client",
      "packages/sail/tsconfig",
      "packages/components/sail",
      "packages/deck/*",
      "apps/*"
    ]
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@ship/sdk": "^0.2.0"
  },
  "trustedDependencies": [
    "lightningcss"
  ],
  "scripts": {
    "wasm": "wasm-pack build crates/sail/compiler --target web --out-dir ../../../packages/sail/compiler-wasm/pkg --out-name sail_compiler -- --features wasm",
    "build:bundles": "cargo run -p deck-cli --bin deck-bake -- build-assets",
    "prepare": "bun scripts/emit-package-dts.ts",
    "typecheck": "bun scripts/typecheck-components.ts",
    "typecheck:tsgo": "tsgo --noEmit -p packages/sail/runtime/tsconfig.json && tsgo --noEmit -p packages/sail/dom/tsconfig.json",
    "emit:package-dts": "bun scripts/emit-package-dts.ts",
    "typecheck:sail:studio": "bun scripts/emit-package-dts.ts && tsc --noEmit -p apps/studio/.sail/tsconfig.sail.json",
    "typecheck:sail:site": "bun scripts/emit-package-dts.ts && cargo run -q -p sail-compiler --offline -- prop-registry && bun apps/sail-site/scripts/gen-runtime-surface.ts && tsc --noEmit -p apps/sail-site/.sail/tsconfig.sail.json",
    "typecheck:sail": "bun run typecheck:sail:studio && bun run typecheck:sail:site",
    "test": "bash -c 'vitest run; v=$?; bun test tests/hygiene || v=1; exit $v'",
    "test:vitest": "vitest run",
    "test:hygiene": "bun test tests/hygiene",
    "test:parity": "bun tests/parity/run.ts",
    "test:parity:geometry": "bun tests/parity/geometry/run.ts",
    "test:parity:paint": "bun tests/parity/paint/run.ts",
    "test:parity:report": "bun tests/parity/run.ts --report-only"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript/native-preview": "^7.0.0-dev.20260628.1",
    "lucide-static": "^1.22.0",
    "playwright": "^1.59.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
