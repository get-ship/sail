{
  "name": "sui-framework",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/sui/compiler-wasm",
      "packages/sui/dom",
      "packages/sui/runtime",
      "packages/sui/tokens",
      "packages/sui/test-setup",
      "packages/sui/tutorial",
      "packages/components/sui/*",
      "packages/deck/*"
    ]
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@ship/sdk": "^0.2.0"
  },
  "trustedDependencies": [
    "lightningcss"
  ],
  "scripts": {
    "wasm": "wasm-pack build crates/sui/compiler --target web --out-dir ../../../packages/sui/compiler-wasm/pkg --out-name sui_compiler -- --features wasm",
    "build:bundles": "cargo run -p deck-cli -- build-assets",
    "typecheck": "node scripts/typecheck-components.mjs",
    "typecheck:tsgo": "tsgo --noEmit -p packages/sui/runtime/tsconfig.json && tsgo --noEmit -p packages/sui/dom/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript/native-preview": "^7.0.0-dev.20260628.1",
    "playwright": "^1.59.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
