<!--
  sui-app-shell — the app chrome for Mise.

  This is the layout component the root routes/_layout.sui mounts. deck's router
  finds the chrome by its first custom-element tag, then appends a route slot
  div holding the active route's content — so the chrome MUST project a
  <slot name="route">. The header (brand, nav, theme toggle) stays put across
  client-side navigations; only the route slot swaps.

  Nav uses plain anchors: deck's router intercepts same-origin anchor clicks via
  composedPath(), so these links navigate client-side even from shadow DOM.
-->

<style>
  :host {
    display: block;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-body);
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--border);
    background: var(--surface-1);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    color: var(--foreground);
    text-decoration: none;
  }
  .brand .dot { color: var(--primary); }

  nav {
    display: flex;
    gap: var(--space-2);
    margin-inline-start: var(--space-2);
  }
  nav a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    transition: background-color 0.15s, color 0.15s;
  }
  nav a:hover { color: var(--foreground); background: var(--surface-2); }

  .spacer { flex: 1; }

  .theme-toggle {
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--foreground);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
  }
  .theme-toggle:hover { border-color: var(--border-strong); }

  .outlet {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5);
  }
</style>

<header class="topbar" part="topbar">
  <a class="brand" href="/">Mise<span class="dot">.</span></a>
  <nav>
    <a href="/">Home</a>
    <a href="/recipes">Recipes</a>
    <a href="/kitchen">Kitchen</a>
  </nav>
  <span class="spacer"></span>
  <button class="theme-toggle" type="button" on:click={() => toggleTheme()}>
    {dark() ? '☀ Light' : '☾ Dark'}
  </button>
</header>

<main class="outlet" part="outlet">
  <slot name="route"></slot>
</main>
