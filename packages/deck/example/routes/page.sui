<!-- Home (index route `/`). Hero + feature cards. Styles live in the sibling
     style.css (deck-route-css convention; inline route styles are dropped). -->
<section class="home">
  <p class="eyebrow">A tiny, ship-free deck app</p>
  <h1>Mise <sui-badge tone="primary" variant="soft" size="sm">demo</sui-badge></h1>
  <p class="lede">
    A recipe box that shows off the deck framework end-to-end — nested and
    dynamic routes, a layout chain, reactive controllers, a local data client,
    SUI component packs, and light/dark theming.
  </p>

  <div class="cta">
    <button class="btn btn-primary" type="button" on:click={() => navigate('/recipes')}>
      Browse recipes
    </button>
    <button class="btn" type="button" on:click={() => navigate('/kitchen')}>
      Open the kitchen
    </button>
  </div>

  <div class="grid">
    <article class="card">
      <h3>Routes</h3>
      <p>
        Index, nested, and a dynamic <code>[id]</code> route. The detail page
        reads <code>route.params.id()</code> as a signal.
      </p>
    </article>
    <article class="card">
      <h3>Reactivity</h3>
      <p>
        Controllers built on <code>signal()</code> drive a counter, a toggle,
        and a form that mutates shared client state.
      </p>
    </article>
    <article class="card">
      <h3>Components &amp; theme</h3>
      <p>
        Real <code>@ship/sui-primitives</code> elements (badge, switch), themed
        by <code>@ship/tokens</code>. Flip light/dark in the header.
      </p>
    </article>
  </div>
</section>
