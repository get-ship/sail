<!--
  Kitchen (`/kitchen`) — interactivity + a form mutation.
  Counter + toggle use plain signals; the form appends to the shared data
  client and navigates to the new recipe. <sui-switch> is a real primitive.
-->
<section class="kitchen">
  <h1>Kitchen</h1>
  <p class="lede">A scratch space wired to the same reactive runtime the rest of the app uses.</p>

  <div class="panels">
    <article class="card">
      <h3>Counter</h3>
      <p class="big">{count()}</p>
      <div class="row">
        <button class="btn btn-primary" type="button" on:click={() => count.set(count() + 1)}>Increment</button>
        <button class="btn" type="button" on:click={() => count.set(0)}>Reset</button>
      </div>
    </article>

    <article class="card">
      <h3>Burner</h3>
      <p class="status">
        Status:
        <strong class:on={timerOn()}>{timerOn() ? 'On 🔥' : 'Off'}</strong>
      </p>
      <sui-switch
        label="Toggle burner"
        prop:checked={timerOn()}
        on:change={(e) => timerOn.set(e.detail.checked)}
      ></sui-switch>
    </article>
  </div>

  <article class="card">
    <h3>Add a recipe</h3>
    <form class="add-form" on:submit={(e) => { e.preventDefault(); addRecipe() }}>
      <label class="field">
        <span>Title</span>
        <input type="text" name="title" placeholder="e.g. Garlic Noodles" bind:value={title} required />
      </label>
      <label class="field minutes">
        <span>Minutes</span>
        <input type="number" name="minutes" min="0" max="600" bind:value={minutes} />
      </label>
      <button class="btn btn-primary" type="submit">Add &amp; open</button>
    </form>
    <p class="count">The box currently holds <strong>{recipes().length}</strong> recipes.</p>
  </article>
</section>
