{
  // Host-customized entry bootstrap (vs. the default no-clients bootstrap).
  //
  // deck ALWAYS generates `entry.gen.ts` (the SPA bootstrap that imports the
  // route tables, the design-token CSS, and calls `mountRouter`). Declaring an
  // `entry` here only CUSTOMIZES the `clients` map: deck emits
  //   import { data } from './src/clients'
  // (the path is relative to the generated `entry.gen.ts` at the project root)
  // and spreads `{ data }` into `mountRouter({ clients })`. Every view then
  // reads the client off `ctx.clients.data`.
  //
  // This is the framework's "clients seam" — a plain in-memory data client,
  // with NO ship product, no daemon, no SDK. The host decides which clients to
  // expose; deck names none.
  "entry": {
    "clientsModule": "./src/clients.ts",
    "exposeNames": ["data"]
  }
}
