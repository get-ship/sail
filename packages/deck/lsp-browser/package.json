{
  "name": "@ship/sail-lsp-browser",
  "version": "0.2.0",
  "description": "Browser-side analyser for .sail files. Pure parse + diagnostics + scope-aware completions for editors that can't shell out to the Node LSP (docs playground, shell source editor).",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./worker": "./src/worker.ts",
    "./completions": "./src/completions.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./hover": "./src/hover.ts"
  },
  "scripts": {
    "test": "bun test test/",
    "test:watch": "bun test --watch test/"
  },
  "dependencies": {
    "@ship/sail-compiler-wasm": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
