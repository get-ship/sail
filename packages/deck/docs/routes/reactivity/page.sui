<!--
  Reactivity (`/reactivity`) — the diamond-dependency glitch test, live.
  Change `a`; watch b, c, and d update; watch d recompute exactly once.
-->

<controller>
// Reactivity playground — the diamond-dependency glitch test.
//
//   a ─┬─▶ b = a × 2 ─┐
//      └─▶ c = a + 10 ─┴─▶ d = b + c
//
// When `a` changes, both b and c change, and both feed d. A naive reactive
// system recomputes d TWICE (once per changed input) — a "glitch", where d
// briefly holds an inconsistent value. SUI's colored push-pull scheduler
// recomputes d exactly ONCE per `a` change. We prove it live: an effect counts
// d's recomputes; it should climb by exactly 1 each time you nudge `a`.
import { controller, signal, derived, effect, untrack, type ViewScope } from '@ship/sui-runtime'
import type { Scope } from './page.sui'

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const a = signal(1)
    const b = derived(() => a() * 2)
    const c = derived(() => a() + 10)
    const d = derived(() => b() + c())

    const dRecomputes = signal(0)
    const aChanges = signal(0)

    // Count d's actual recomputes. Track `d`; write the counter untracked so the
    // effect never depends on its own output (no loop).
    effect(() => {
      d()
      dRecomputes.set(untrack(() => dRecomputes()) + 1)
    })

    const nudge = (delta: number): void => {
      a.set(a() + delta)
      aChanges.set(untrack(() => aChanges()) + 1)
    }

    return {
      a,
      b,
      c,
      d,
      dRecomputes,
      aChanges,
      inc: (): void => nudge(1),
      dec: (): void => nudge(-1),
      // Reset `a` but KEEP the counters, so the "1 recompute per change" ratio
      // stays visible as evidence.
      resetValue: (): void => nudge(1 - a()),
    }
  },
})
</controller>

<section class="rx">
  <header class="rx-head">
    <p class="eyebrow">reactivity · the signal graph</p>
    <h1>The diamond, with no glitch.</h1>
    <p class="lede">
      Change <code>a</code>. It feeds both <code>b</code> and <code>c</code>, and
      both feed <code>d</code>. SUI recomputes <code>d</code> exactly once per
      change — never the double-fire a naive reactive system does.
    </p>
  </header>

  <div class="graph">
    <article class="node signal" data-tier="source">
      <div class="node-head">
        <span class="dot signal"></span><span class="name">a</span>
        <span class="kind">signal · source</span>
      </div>
      <div class="val">{a()}</div>
      <div class="row controls">
        <button class="btn" type="button" on:click={() => dec()}>− 1</button>
        <button class="btn btn-primary" type="button" on:click={() => inc()}>+ 1</button>
        <button class="btn ghost" type="button" on:click={() => resetValue()}>set 1</button>
      </div>
    </article>

    <p class="edge">feeds ↓</p>

    <div class="pair">
      <article class="node derived">
        <div class="node-head"><span class="dot derived"></span><span class="name">b</span><span class="kind">a × 2</span></div>
        <div class="val">{b()}</div>
      </article>
      <article class="node derived">
        <div class="node-head"><span class="dot derived"></span><span class="name">c</span><span class="kind">a + 10</span></div>
        <div class="val">{c()}</div>
      </article>
    </div>

    <p class="edge">join ↓</p>

    <article class="node derived join">
      <div class="node-head"><span class="dot derived"></span><span class="name">d</span><span class="kind">b + c</span></div>
      <div class="val xl">{d()}</div>
    </article>
  </div>

  <aside class="proof">
    <div class="proof-stats">
      <div class="stat"><span class="k">you changed a</span><span class="v">{aChanges()}×</span></div>
      <div class="stat accent"><span class="k">d recomputed</span><span class="v">{dRecomputes()}×</span></div>
    </div>
    <p class="proof-note">
      One recompute per change (plus one at first paint). A glitchy system would
      <em>double</em> that — <code>d</code> would briefly equal
      <code>b_new + c_old</code>. SUI's colored push-pull scheduler never lets
      that intermediate value exist.
    </p>
  </aside>

  <div class="page-nav">
    <a href="/layouts">← Layouts</a>
    <a href="/data">The data seam →</a>
  </div>
</section>
