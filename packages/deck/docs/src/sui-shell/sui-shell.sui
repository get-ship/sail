<!--
  <sui-shell> — the docs chrome: top bar + left sidebar nav + content slot.

  routes/_layout.sui mounts this; deck finds the chrome by its first
  custom-element tag, then mounts each route's content into <slot name="route">.
  The chrome persists across client-side navigations; only the slot swaps. Nav
  uses plain anchors — deck's router intercepts same-origin clicks via
  composedPath(), so links navigate client-side from shadow DOM. Active state
  comes from `path` (the controller reads location.pathname per nav).
-->

<style>
  :host {
    display: block;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-body);
  }

  /* ── Top bar ──────────────────────────────────────────────────────────── */
  .topbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 3.5rem;
    padding: 0 var(--space-5);
    border-bottom: 1px solid var(--border);
    background: var(--surface-1);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }
  .brand { display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none; color: var(--foreground); }
  .brand .word { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); letter-spacing: -0.02em; }
  .brand .word b { color: var(--primary); }
  .ver {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.1rem var(--space-2);
  }
  .spacer { flex: 1; }
  .theme-toggle {
    font: inherit; font-size: var(--text-sm); cursor: pointer;
    border: 1px solid var(--border); background: var(--surface-2); color: var(--foreground);
    border-radius: var(--radius-full); padding: var(--space-1) var(--space-3);
  }
  .theme-toggle:hover { border-color: var(--border-strong); }

  /* ── Body grid ────────────────────────────────────────────────────────── */
  .body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    max-width: 78rem;
    margin: 0 auto;
  }

  .sidebar {
    position: sticky;
    top: 3.5rem;
    align-self: start;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
    padding: var(--space-5) var(--space-4);
    border-right: 1px solid var(--border);
  }
  .group + .group { margin-top: var(--space-5); }
  .group h4 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-2) var(--space-2);
    font-weight: 600;
  }
  .sidebar a {
    display: block;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    border-left: 2px solid transparent;
  }
  .sidebar a:hover { color: var(--foreground); background: var(--surface-1); }
  .sidebar a.active {
    color: var(--foreground);
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    border-left-color: var(--primary);
    font-weight: 600;
  }

  .content {
    padding: var(--space-7) var(--space-7);
    max-width: 48rem;
  }

  @media (max-width: 820px) {
    .body { grid-template-columns: 1fr; }
    .sidebar { display: none; }
  }
</style>

<header class="topbar" part="topbar">
  <a class="brand" href="/" aria-label="deck home">
    <svg width="24" height="24" viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <rect x="3" y="7" width="13" height="17" rx="3" fill="var(--accent)" opacity="0.55" />
      <rect x="7" y="4" width="13" height="17" rx="3" fill="var(--primary)" opacity="0.75" />
      <rect x="10.5" y="1.5" width="13" height="17" rx="3" fill="var(--primary)" />
    </svg>
    <span class="word"><b>deck</b> docs</span>
  </a>
  <span class="ver">0.2.0</span>
  <span class="spacer"></span>
  <button class="theme-toggle" type="button" on:click={() => toggleTheme()}>
    {dark() ? '☀ Light' : '☾ Dark'}
  </button>
</header>

<div class="body">
  <nav class="sidebar" part="sidebar">
    <div class="group">
      <h4>Introduction</h4>
      <a href="/" class:active={path() === '/'}>Overview</a>
      <a href="/getting-started" class:active={path() === '/getting-started'}>Getting started</a>
    </div>
    <div class="group">
      <h4>Routing</h4>
      <a href="/routing" class:active={path() === '/routing'}>File routing</a>
      <a href="/dynamic-routes" class:active={path() === '/dynamic-routes'}>Dynamic routes</a>
      <a href="/layouts" class:active={path() === '/layouts'}>Layouts</a>
    </div>
    <div class="group">
      <h4>Reactivity</h4>
      <a href="/reactivity" class:active={path() === '/reactivity'}>Reactivity</a>
      <a href="/data" class:active={path() === '/data'}>The data seam</a>
    </div>
    <div class="group">
      <h4>Rendering &amp; build</h4>
      <a href="/rendering" class:active={path() === '/rendering'}>Rendering modes</a>
      <a href="/hmr" class:active={path() === '/hmr'}>HMR</a>
      <a href="/build" class:active={path() === '/build'}>Build &amp; deploy</a>
    </div>
  </nav>

  <main class="content" part="content">
    <slot name="route"></slot>
  </main>
</div>
