<!--
  <sui-shell> — the playground chrome.

  routes/_layout.sui mounts this; deck finds the chrome by its first
  custom-element tag, then appends a route slot holding the active route's
  content — so the chrome MUST project a <slot name="route">. The header (brand,
  nav, theme toggle) stays put across client-side navigations; only the slot
  swaps. Nav uses plain anchors: deck's router intercepts same-origin anchor
  clicks via composedPath(), so these links navigate client-side from shadow DOM.
-->

<style>
  :host {
    display: block;
    min-height: 100vh;
    background:
      radial-gradient(1200px 600px at 80% -10%, color-mix(in oklch, var(--primary) 22%, transparent), transparent 60%),
      var(--background);
    color: var(--foreground);
    font-family: var(--font-body);
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklch, var(--surface-1) 75%, transparent);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--foreground);
  }
  .brand svg { display: block; }
  .brand .word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }
  .brand .word b { color: var(--primary); font-weight: 700; }

  nav {
    display: flex;
    gap: var(--space-1);
    margin-inline-start: var(--space-3);
  }
  nav a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    transition: background-color 0.15s, color 0.15s;
  }
  nav a:hover {
    color: var(--foreground);
    background: var(--surface-2);
  }

  .spacer { flex: 1; }

  .theme-toggle {
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--foreground);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    transition: border-color 0.15s;
  }
  .theme-toggle:hover { border-color: var(--border-strong); }

  .outlet {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-6);
  }
</style>

<header class="topbar" part="topbar">
  <a class="brand" href="/" aria-label="deck home">
    <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <rect x="3" y="7" width="13" height="17" rx="3" fill="var(--accent)" opacity="0.55" />
      <rect x="7" y="4" width="13" height="17" rx="3" fill="var(--primary)" opacity="0.75" />
      <rect x="10.5" y="1.5" width="13" height="17" rx="3" fill="var(--primary)" />
    </svg>
    <span class="word"><b>deck</b></span>
  </a>
  <nav>
    <a href="/">Overview</a>
    <a href="/reactivity">Reactivity</a>
  </nav>
  <span class="spacer"></span>
  <button class="theme-toggle" type="button" on:click={() => toggleTheme()}>
    {dark() ? '☀ Light' : '☾ Dark'}
  </button>
</header>

<main class="outlet" part="outlet">
  <slot name="route"></slot>
</main>
