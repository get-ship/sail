<!--
  <sail-citation> — a numbered source pill. Clicking it emits
  `sail-citation-open` with `{ source, index }` so the consumer can open
  the reference (panel, new tab, footnote scroll — the pill doesn't
  decide). Pure framework primitive: no navigation, no SDK.

  The pill is a bare <button>, so the framework's control contracts own
  its cursor, focus ring, and hover transition; the sx surface only
  restates what a citation pill is (small, round, muted, tinted on hover).

  Props
  ─────────────────────────────────────────────────────────────────────
  source  (string)  URL or label of the cited source.
  index   (number)  1-based citation number shown in the pill.
  ─────────────────────────────────────────────────────────────────────
  Events
    sail-citation-open  { detail: { source: string, index: number } }
  ─────────────────────────────────────────────────────────────────────
-->

<scope>
  props: {
    source = ''
    index = 0
  }
</scope>


<controller>
import { controller, ref } from '@ship/sail-runtime'
import type { ViewScope } from '@ship/sail-runtime'
import type { Scope } from './sail-citation.sui'

export default controller((_ctx: ViewScope<Scope>) => {
    const pillEl = ref<HTMLButtonElement>(null)

    mount((host) => {
      const btn = pillEl()
      if (!btn) return

      const onClick = () => {
        host.dispatchEvent(
          new CustomEvent('sail-citation-open', {
            detail: { source: _ctx.source(), index: _ctx.index() },
            bubbles: true,
            composed: true,
          }),
        )
      }
      btn.addEventListener('click', onClick)
      return () => btn.removeEventListener('click', onClick)
    })

    return { pillEl }
  })

</controller>
<button
  type="button"
  bind:this={pillEl}
  aria-label={'Open citation ' + index() + ': ' + source()}
  sx="min-h-0 py-half pl-0_75 pr-2 rounded-full text-xs leading-snug font-normal text-foreground bg-muted border border-border shadow-none cursor-pointer hover:bg-tone-primary-bg hover:border hover:border-tone-primary-border"
>
  <row gap="1" align="center">
    <row
      aria-hidden="true"
      gap="0"
      align="center"
      justify="center"
      sx="min-w-4 h-4 px-1 font-semibold text-primary-foreground bg-primary rounded-full"
    >{index()}</row>
    <span sx="truncate">{source()}</span>
  </row>
</button>
