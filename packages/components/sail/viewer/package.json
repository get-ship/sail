{
  "name": "@ship/sail-viewer",
  "version": "0.3.0",
  "description": "Ship Viewer components package \u2014 the browser compile seam (`ensureWasm`/`makeCompile`) and `<sail-render>`, the mount stage every surface composes for a live preview of a SAIL component.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist/custom-elements.json"
  ],
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./wasm-bootstrap": {
      "types": "./dist/wasm-bootstrap.d.ts",
      "default": "./src/wasm-bootstrap.ts"
    },
    "./same-doc-mount": {
      "types": "./dist/same-doc-mount.d.ts",
      "default": "./src/same-doc-mount.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "test -f dist/custom-elements.json || (cd ../../../.. && cargo run -p deck-cli -- build-assets)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sail-compiler-wasm": "workspace:*",
    "@ship/sail-dom": "workspace:*",
    "@ship/sail-primitives": "workspace:*",
    "@ship/sail-runtime": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.5"
  },
  "private": true
}
