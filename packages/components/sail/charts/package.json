{
  "name": "@ship/sail-charts",
  "version": "0.3.0",
  "description": "Ship Charts components package — `<sail-*-chart>` + sparkline / donut / gauge / heatmap custom elements.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist/custom-elements.json"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts",
    "./sail-area-chart": "./src/sail-area-chart/sail-area-chart.compiled.js",
    "./sail-bar-chart": "./src/sail-bar-chart/sail-bar-chart.compiled.js",
    "./sail-line-chart": "./src/sail-line-chart/sail-line-chart.compiled.js",
    "./sail-sparkline": "./src/sail-sparkline/sail-sparkline.compiled.js",
    "./sail-donut": "./src/sail-donut/sail-donut.compiled.js",
    "./sail-gauge": "./src/sail-gauge/sail-gauge.compiled.js",
    "./sail-heatmap": "./src/sail-heatmap/sail-heatmap.compiled.js"
  },
  "scripts": {
    "prepublishOnly": "test -f dist/custom-elements.json || (cd ../../../.. && cargo run -p deck-cli -- build-assets)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sail-dom": "workspace:*",
    "@ship/sail-runtime": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  },
  "private": true
}
