{
  "name": "@ship/sail-primitives",
  "version": "0.3.0",
  "description": "Ship Primitives pack \u2014 generic `<sail-*>` UI elements (button, input, dialog, popover, etc.).",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist/custom-elements.json"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prepublishOnly": "test -f dist/custom-elements.json || (cd ../../../.. && cargo run -p deck-cli -- build-assets)",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ship/sail-dom": "workspace:*",
    "@ship/sail-runtime": "workspace:*",
    "@ship/tokens": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "@types/node": "24.12.4",
    "fast-formula-parser": "1.0.19",
    "vitest": "^4.1.5"
  }
}
