{
  "name": "@ship/sail-primitives",
  "version": "0.3.0",
  "description": "Ship Primitives components package \u2014 generic `<sail-*>` UI elements (diff, tree, calendar, \u2026).",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist/custom-elements.json"
  ],
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./sail-calendar": "./src/sail-calendar/sail-calendar.compiled.js",
    "./sail-cmdk": "./src/sail-cmdk/sail-cmdk.compiled.js",
    "./sail-color-picker": "./src/sail-color-picker/sail-color-picker.compiled.js",
    "./sail-date-picker": "./src/sail-date-picker/sail-date-picker.compiled.js",
    "./sail-diff": "./src/sail-diff/sail-diff.compiled.js",
    "./sail-error-boundary": "./src/sail-error-boundary/sail-error-boundary.compiled.js",
    "./sail-file-upload": "./src/sail-file-upload/sail-file-upload.compiled.js",
    "./sail-json-view": "./src/sail-json-view/sail-json-view.compiled.js",
    "./sail-markdown": "./src/sail-markdown/sail-markdown.compiled.js",
    "./sail-timeline": "./src/sail-timeline/sail-timeline.compiled.js",
    "./sail-timeline-item": "./src/sail-timeline/sail-timeline-item.compiled.js",
    "./sail-tree": "./src/sail-tree/sail-tree.compiled.js",
    "./sail-tree-grid": "./src/sail-tree-grid/sail-tree-grid.compiled.js"
  },
  "scripts": {
    "prepublishOnly": "test -f dist/custom-elements.json || (cd ../../../.. && cargo run -p deck-cli -- build-assets)",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ship/sail-dom": "workspace:*",
    "@ship/sail-runtime": "workspace:*",
    "@ship/tokens": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "@types/node": "24.12.4",
    "fast-formula-parser": "1.0.19",
    "vitest": "^4.1.5"
  },
  "private": true
}
