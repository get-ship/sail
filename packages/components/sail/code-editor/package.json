{
  "name": "@ship/sail-code-editor",
  "version": "0.3.0",
  "description": "SAIL code-editor components package — <sail-code-editor> (CodeMirror 6), framework-pure (no ship-platform deps). Drop-in successor to <ship-code-editor> for sail-site public surfaces.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@ship/sail-runtime": "workspace:*",
    "@ship/sail-dom": "workspace:*",
    "@ship/sail-lsp-browser": "workspace:*",
    "@ship/sail-primitives": "workspace:*",
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  },
  "deck_pending_floor_migration": {
    "bundles": [
      {
        "name": "sail-code-editor",
        "entry": "src/index.ts",
        "externals": [
          "@ship/sail-runtime",
          "@ship/sail-dom"
        ],
        "lazy": true
      }
    ]
  },
  "private": true
}
