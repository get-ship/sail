<!--
  <sui-tool-call> — a collapsible record of one tool invocation. The
  header shows the tool name + a status dot; the body (args + result)
  collapses behind it. Composes <sui-collapsible> for the disclosure
  behavior (click / Enter / Space, animated height) rather than
  reimplementing it.

  Args arrive via the default slot; the result via the `result` slot.
  Both render monospace. Pure framework primitive — no SDK, no runtime.

  Props
  ─────────────────────────────────────────────────────────────────────
  name    (string)  Tool name shown in the header.
  status  (union)   running | ok | error — colors the status dot.
  open    (bool)    Whether the body starts expanded.
  ─────────────────────────────────────────────────────────────────────
  Slots
    (default)  tool arguments (monospace)
    result     tool result (monospace)
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="status" values="running|ok|error" default="running" reflect />
<prop name="open" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
    --status-color: var(--muted-foreground);
  }
  :host([hidden]) { display: none; }
  :host([status='running']) { --status-color: var(--info); }
  :host([status='ok'])      { --status-color: var(--success); }
  :host([status='error'])   { --status-color: var(--destructive); }

  .frame {
    border: 1px solid var(--border);
    /* State-colored left rail — instant at-a-glance scannability of the
       invocation's status, echoing the status dot / status-text tint. */
    border-left: 3px solid var(--status-color);
    border-radius: var(--radius-md);
    background: var(--card);
    overflow: hidden;
  }
  .header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-color);
    flex: 0 0 auto;
  }
  :host([status='running']) .status-dot {
    animation: sui-tool-call-pulse 1.4s var(--ease-in-out) infinite;
  }
  @keyframes sui-tool-call-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    :host([status='running']) .status-dot { animation: none; }
  }

  .name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status-text {
    margin-inline-start: auto;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--status-color);
  }
  .chevron {
    flex: 0 0 auto;
    transition: transform var(--duration-fast) var(--ease-out);
    color: var(--muted-foreground);
  }
  :host([open]) .chevron { transform: rotate(90deg); }

  .body {
    border-top: 1px solid var(--border);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .body-label {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
    margin-bottom: var(--space-1);
  }
  .args { white-space: pre-wrap; overflow-wrap: anywhere; }
  .result-block { margin-top: var(--space-2); }
  ::slotted([slot='result']) { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>

<div class="frame" part="frame">
  <sui-collapsible open={open()}>
    <div slot="trigger" class="header" part="header">
      <span class="status-dot" part="status-dot" aria-hidden="true"></span>
      <span class="name" part="name">{name()}</span>
      <span class="status-text" part="status">{status()}</span>
      <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round" aria-hidden="true">
        <path d="M4 2l4 4-4 4" />
      </svg>
    </div>
    <div class="body" part="body">
      <span class="body-label">Arguments</span>
      <div class="args"><slot></slot></div>
      <div class="result-block">
        <span class="body-label">Result</span>
        <slot name="result"></slot>
      </div>
    </div>
  </sui-collapsible>
</div>
