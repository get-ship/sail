<!--
  <sui-thinking-dots> — three bouncing dots that signal an assistant is
  composing a reply. Pure presentational primitive, no controller.

  Accessibility: the host is a polite live region labelled "Assistant is
  thinking" so screen readers announce the pending state once without
  spamming. The dots themselves are decorative (aria-hidden).

  Props
  ─────────────────────────────────────────────────────────────────────
  label   (string)  Overrides the announced label.
  size    (union)   sm | md | lg — scales the dots.
  tone    (union)   Colors the dots; defaults to muted-foreground.
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="label" type="string" default="Assistant is thinking" />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    --dot-size: 7px;
    --dot-gap: 5px;
    --dot-color: var(--muted-foreground);
  }
  :host([size='sm']) { --dot-size: 5px; --dot-gap: 4px; }
  :host([size='lg']) { --dot-size: 9px; --dot-gap: 7px; }

  :host([tone='primary'])     { --dot-color: var(--primary); }
  :host([tone='info'])        { --dot-color: var(--info); }
  :host([tone='success'])     { --dot-color: var(--success); }
  :host([tone='warning'])     { --dot-color: var(--warning); }
  :host([tone='destructive']) { --dot-color: var(--destructive); }
  :host([tone='accent'])      { --dot-color: var(--accent); }
  :host([tone='muted'])       { --dot-color: var(--muted-foreground); }

  .dots {
    display: inline-flex;
    align-items: center;
    gap: var(--dot-gap);
  }
  .dot {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--dot-color);
    animation: sui-thinking-bounce 1.2s var(--ease-in-out, ease-in-out) infinite;
  }
  .dot:nth-child(2) { animation-delay: 0.15s; }
  .dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes sui-thinking-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
    40%           { transform: translateY(-25%); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; opacity: 0.7; }
  }
</style>

<span
  class="dots"
  part="dots"
  role="status"
  aria-live="polite"
  aria-label={label()}
>
  <span class="dot" part="dot" aria-hidden="true"></span>
  <span class="dot" part="dot" aria-hidden="true"></span>
  <span class="dot" part="dot" aria-hidden="true"></span>
</span>
