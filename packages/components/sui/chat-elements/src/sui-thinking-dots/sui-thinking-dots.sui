<!--
  <sui-thinking-dots> — three bouncing dots that signal an assistant is
  composing a reply. Pure presentational primitive, no controller.

  Accessibility: the host is a polite live region labelled "Assistant is
  thinking" so screen readers announce the pending state once without
  spamming. The dots themselves are decorative (aria-hidden).

  Props
  ─────────────────────────────────────────────────────────────────────
  label   (string)  Overrides the announced label.
  size    (union)   sm | md | lg — scales the dots.
  tone    (union)   Colors the dots; defaults to muted-foreground.
  ─────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    label: 'Assistant is thinking',
    size: 'md' | 'sm' | 'lg',
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
  },
}</component>
<style>
  .sui-thinking-dots {
    display: inline-flex;
    vertical-align: middle;
    --dot-size: 7px;
    --dot-gap: 5px;
    --dot-color: var(--muted-foreground);
  }
  .sui-thinking-dots[size='sm'] { --dot-size: 5px; --dot-gap: 4px; }
  .sui-thinking-dots[size='lg'] { --dot-size: 9px; --dot-gap: 7px; }

  .sui-thinking-dots[tone='primary']     { --dot-color: var(--primary); }
  .sui-thinking-dots[tone='info']        { --dot-color: var(--info); }
  .sui-thinking-dots[tone='success']     { --dot-color: var(--success); }
  .sui-thinking-dots[tone='warning']     { --dot-color: var(--warning); }
  .sui-thinking-dots[tone='destructive'] { --dot-color: var(--destructive); }
  .sui-thinking-dots[tone='accent']      { --dot-color: var(--accent); }
  .sui-thinking-dots[tone='muted']       { --dot-color: var(--muted-foreground); }

  .dots {
    display: inline-flex;
    align-items: center;
    gap: var(--dot-gap);
  }
  .dot {
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--dot-color);
    animation: sui-thinking-bounce 1.2s var(--ease-in-out) infinite;
  }
  .dot:nth-child(2) { animation-delay: 0.15s; }
  .dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes sui-thinking-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
    40%           { transform: translateY(-25%); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; opacity: 0.7; }
  }
</style>

<span class="dots" role="status" aria-live="polite" aria-label={label()}>
  <span class="dot" aria-hidden="true"></span>
  <span class="dot" aria-hidden="true"></span>
  <span class="dot" aria-hidden="true"></span>
</span>
