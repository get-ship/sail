<!--
  <sui-citation> — a numbered source pill. Clicking it emits
  `sui-citation-open` with `{ source, index }` so the consumer can open
  the reference (panel, new tab, footnote scroll — the pill doesn't
  decide). Pure framework primitive: no navigation, no SDK.

  Props
  ─────────────────────────────────────────────────────────────────────
  source  (string)  URL or label of the cited source.
  index   (number)  1-based citation number shown in the pill.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-citation-open  { detail: { source: string, index: number } }
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="source" type="string" default="" />
<prop name="index" type="number" default="0" />

<style>
  :host {
    display: inline-flex;
    vertical-align: baseline;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    max-width: 220px;
    padding: 1px 7px 1px 3px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .pill:hover {
    background: var(--tone-primary-bg);
    border-color: var(--tone-primary-border);
  }
  .pill:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  .index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 var(--space-1);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-semibold);
    color: var(--primary-foreground);
    background: var(--primary);
    border-radius: var(--radius-full);
  }
  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<button
  type="button"
  class="pill"
  part="pill"
  bind:this={pillEl}
  aria-label={'Open citation ' + index() + ': ' + source()}
>
  <span class="index" part="index" aria-hidden="true">{index()}</span>
  <span class="label" part="label">{source()}</span>
</button>
