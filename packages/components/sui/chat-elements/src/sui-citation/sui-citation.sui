<!--
  <sui-citation> — a numbered source pill. Clicking it emits
  `sui-citation-open` with `{ source, index }` so the consumer can open
  the reference (panel, new tab, footnote scroll — the pill doesn't
  decide). Pure framework primitive: no navigation, no SDK.

  The pill is a bare <button>, so the framework's control contracts own
  its cursor, focus ring, and hover transition; the sx surface only
  restates what a citation pill is (small, round, muted, tinted on hover).

  Props
  ─────────────────────────────────────────────────────────────────────
  source  (string)  URL or label of the cited source.
  index   (number)  1-based citation number shown in the pill.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-citation-open  { detail: { source: string, index: number } }
  ─────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    source: '',
    index: 0,
  },
}</component>


<controller>
import { controller, ref } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-citation.sui'

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const pillEl = ref<HTMLButtonElement>(null)
    return { pillEl }
  },

  mount(state, host) {
    const btn = state.pillEl as HTMLButtonElement | null
    if (!btn) return

    const onClick = () => {
      host.dispatchEvent(
        new CustomEvent('sui-citation-open', {
          detail: { source: state.source, index: state.index },
          bubbles: true,
          composed: true,
        }),
      )
    }
    btn.addEventListener('click', onClick)
    return () => btn.removeEventListener('click', onClick)
  },
})

</controller>
<button
  type="button"
  bind:this={pillEl}
  aria-label={'Open citation ' + index() + ': ' + source()}
  sx="min-h:0 py:half pl:0_75 pr:2 radius:full text:xs leading:snug weight:normal
      fg:foreground bg:muted border:border shadow:none cursor:pointer
      hover:bg:tone-primary-bg hover:border:tone-primary-border"
>
  <row gap="1" align="center">
    <row
      aria-hidden="true"
      gap="0"
      align="center"
      justify="center"
      sx="min-w:4 h:4 px:1 weight:semibold fg:primary-foreground bg:primary radius:full"
    >{index()}</row>
    <span sx="wrap:truncate">{source()}</span>
  </row>
</button>
