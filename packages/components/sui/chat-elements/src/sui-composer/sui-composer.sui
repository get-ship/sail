<!--
  <sui-composer> — the message input + send control. Single-line by
  default; `multiline` switches to a growing textarea. Enter submits;
  Shift+Enter inserts a newline (multiline only). Composes a bare
  <button> for the send action.

  Attachments (files, canvases, code snippets) are owned by the
  consumer: render their chips into the `attachments` slot and set the
  `attachments` JS-property on the host. The composer echoes that array
  back in the submit event — it never fabricates attachment data.

  Props
  ─────────────────────────────────────────────────────────────────────
  placeholder  (string)  Input placeholder.
  disabled     (bool)    Disables the input + send button.
  multiline    (bool)    Use a textarea + Shift+Enter for newlines.
  ─────────────────────────────────────────────────────────────────────
  Slots
    attachments  attachment chips (file / canvas / code)
    trailing     extra actions beside Send
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-composer-submit  { detail: { text: string, attachments: unknown[] } }
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="placeholder" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="multiline" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .frame:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--tone-primary-ring);
  }
  :host([disabled]) .frame {
    background: var(--muted);
    opacity: 0.7;
  }

  .attachments { display: contents; }
  ::slotted([slot='attachments']) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .field {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    resize: none;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--foreground);
    padding: var(--space-1) 2px;
  }
  .field::placeholder { color: var(--muted-foreground); }
  .field:disabled { cursor: not-allowed; }
  textarea.field {
    min-height: calc(1.5em + 8px);
    max-height: 200px;
    overflow-y: auto;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 0 0 auto;
  }
</style>


<controller>
import { controller, effect, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-composer.sui'

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const text = signal('')
    // Consumer-owned attachment payloads. The composer never fabricates
    // these — it echoes whatever the host assigned in the submit event.
    const attachments = signal<unknown[]>([])
    const fieldEl = ref<HTMLInputElement | HTMLTextAreaElement>(null)
    const sendEl = ref<HTMLElement>(null)
    return { text, attachments, fieldEl, sendEl }
  },

  mount(state, host) {
    // Expose `attachments` as a JS-property: `el.attachments = [...]`.
    const init = (host as unknown as { attachments?: unknown[] }).attachments
    if (init != null) state.attachments = init
    Object.defineProperty(host, 'attachments', {
      configurable: true,
      get: () => state.attachments,
      set: (v: unknown[]) => { state.attachments = v },
    })

    const submit = () => {
      if (state.disabled) return
      const text = state.text.trim()
      if (text.length === 0) return
      host.dispatchEvent(
        new CustomEvent('sui-composer-submit', {
          detail: { text, attachments: [...state.attachments] },
          bubbles: true,
          composed: true,
        }),
      )
      state.text = ''
    }

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key !== 'Enter') return
      // Shift+Enter inserts a newline in multiline mode; plain Enter
      // always submits. Single-line mode submits on Enter regardless.
      if (state.multiline && e.shiftKey) return
      e.preventDefault()
      submit()
    }

    // `fieldEl` swaps element when `multiline` toggles the {#if}, so
    // track it via effect to rebind keydown onto the live field.
    const stopField = effect(() => {
      // HTMLElement (not the input|textarea union): addEventListener's typed
      // overload resolves the 'keydown' listener cleanly on a single element
      // type, where the union receiver collapses it to a non-assignable shape.
      const field = state.fieldEl as HTMLElement | null
      if (!field) return
      field.addEventListener('keydown', onKeydown)
      return () => field.removeEventListener('keydown', onKeydown)
    })

    const stopSend = effect(() => {
      const send = state.sendEl as HTMLElement | null
      if (!send) return
      send.addEventListener('click', submit)
      return () => send.removeEventListener('click', submit)
    })

    return () => {
      stopField()
      stopSend()
    }
  },
})

</controller>
<div class="frame" part="frame">
  <div class="attachments">
    <slot name="attachments"></slot>
  </div>
  <div class="row" part="row">
    {#if multiline()}
      <textarea
        class="field"
        part="field"
        rows="1"
        placeholder={placeholder()}
        disabled={disabled()}
        bind:value={text}
        bind:this={fieldEl}
      ></textarea>
    {/if}
    {#if !multiline()}
      <input
        class="field"
        part="field"
        type="text"
        placeholder={placeholder()}
        disabled={disabled()}
        bind:value={text}
        bind:this={fieldEl}
      />
    {/if}
    <div class="actions">
      <slot name="trailing"></slot>
      <button
        bind:this={sendEl}
        solid
        primary
        sm
        aria-label="Send"
        disabled={disabled() || text().trim().length === 0}
      >Send</button>
    </div>
  </div>
</div>
