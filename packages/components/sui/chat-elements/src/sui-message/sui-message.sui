<!--
  <sui-message> — a single chat bubble. Renders one turn from any
  participant in any modality. Pure declarative primitive: the consumer
  supplies the content via the default slot and any per-message actions
  via the `trailing` slot. No controller — role / content-type / status
  drive presentation entirely through host-attribute CSS.

  Props
  ─────────────────────────────────────────────────────────────────────
  role          (union)  user | assistant | system | tool. Drives
                        bubble alignment + tone.
  content-type  (union)  text | code | drawing | terminal-snapshot |
                        tool-call | citation | image. Drives the inner
                        shape (monospace surface for code/terminal,
                        framed media for drawing/image, etc.).
  timestamp     (string) ISO timestamp; surfaced via the `time`
                        element's datetime + shown in the meta row.
  status        (union)  sending | sent | error. Tints the bubble edge.
  ─────────────────────────────────────────────────────────────────────
  Slots
    (default)   message content
    trailing    per-message actions (copy, retry, …)
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="role" values="user|assistant|system|tool" default="assistant" reflect />
<prop name="content-type" values="text|code|drawing|terminal-snapshot|tool-call|citation|image" default="text" reflect />
<prop name="timestamp" type="string" default="" />
<prop name="status" values="sending|sent|error" default="sent" reflect />

<style>
  :host {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 4px);
    max-width: 100%;
    font-family: var(--font-body);
    color: var(--foreground);
    --bubble-bg: var(--card);
    --bubble-border: var(--border);
    --bubble-fg: var(--foreground);
  }
  :host([hidden]) { display: none; }

  /* Role tones the bubble surface + aligns user turns to the end. */
  :host([role='user']) {
    align-items: flex-end;
    --bubble-bg: color-mix(in oklch, var(--primary) 14%, var(--card));
    --bubble-border: color-mix(in oklch, var(--primary) 30%, transparent);
  }
  :host([role='system']) {
    --bubble-bg: color-mix(in oklch, var(--muted) 60%, var(--card));
    --bubble-border: var(--border);
    --bubble-fg: var(--muted-foreground);
  }
  :host([role='tool']) {
    --bubble-bg: color-mix(in oklch, var(--accent) 10%, var(--card));
    --bubble-border: color-mix(in oklch, var(--accent) 28%, transparent);
  }

  /* Status tints the leading edge of the bubble. */
  :host([status='error']) {
    --bubble-border: color-mix(in oklch, var(--destructive) 55%, transparent);
    --bubble-fg: var(--foreground);
  }
  :host([status='sending']) .bubble { opacity: 0.7; }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-2, 8px);
    font-size: 11px;
    color: var(--muted-foreground);
    padding-inline: 2px;
  }
  .role-label { text-transform: capitalize; font-weight: var(--font-weight-medium, 500); }
  .time { font-variant-numeric: tabular-nums; }

  .bubble {
    box-sizing: border-box;
    padding: var(--space-2, 8px) var(--space-3, 12px);
    background: var(--bubble-bg);
    border: 1px solid var(--bubble-border);
    border-radius: var(--radius-lg, 10px);
    color: var(--bubble-fg);
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* Monospace surfaces for code-shaped content. */
  :host([content-type='code']) .content,
  :host([content-type='terminal-snapshot']) .content,
  :host([content-type='tool-call']) .content {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-size: 12px;
    white-space: pre-wrap;
  }
  :host([content-type='terminal-snapshot']) .bubble {
    background: color-mix(in oklch, var(--foreground) 92%, var(--background));
    color: color-mix(in oklch, var(--background) 88%, var(--foreground));
    border-color: color-mix(in oklch, var(--foreground) 18%, transparent);
  }
  /* Framed media for visual content. */
  :host([content-type='drawing']) .content,
  :host([content-type='image']) .content {
    display: block;
  }
  :host([content-type='drawing']) ::slotted(*),
  :host([content-type='image']) ::slotted(*) {
    max-width: 100%;
    border-radius: var(--radius-md, 8px);
  }

  .trailing { display: contents; }
  ::slotted([slot='trailing']) { margin-top: var(--space-1, 4px); }
</style>

<div class="meta" part="meta">
  <span class="role-label" part="role">{role()}</span>
  {#if timestamp()}
    <time class="time" part="time" datetime={timestamp()}>{timestamp()}</time>
  {/if}
</div>

<div class="bubble" part="bubble">
  <div class="content" part="content">
    <slot></slot>
  </div>
</div>

<div class="trailing">
  <slot name="trailing"></slot>
</div>
