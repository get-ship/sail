<!--
  <sui-message> — a single chat bubble. Renders one turn from any
  participant in any modality. Pure declarative primitive: the consumer
  supplies the content via the default slot and any per-message actions
  via the `trailing` slot. No controller — role / content-type / status
  drive presentation entirely through host-attribute CSS.

  Props
  ─────────────────────────────────────────────────────────────────────
  role          (union)  user | assistant | system | tool. Drives
                        bubble alignment + tone.
  content-type  (union)  text | code | drawing | terminal-snapshot |
                        tool-call | citation | image. Drives the inner
                        shape (monospace surface for code/terminal,
                        framed media for drawing/image, etc.).
  timestamp     (string) ISO timestamp; surfaced via the `time`
                        element's datetime + shown in the meta row.
  status        (union)  sending | sent | error. Tints the bubble edge.
  ─────────────────────────────────────────────────────────────────────
  Slots
    (default)   message content
    trailing    per-message actions (copy, retry, …)
  ─────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    role: 'assistant' | 'user' | 'system' | 'tool',
    'content-type': 'text' | 'code' | 'drawing' | 'terminal-snapshot' | 'tool-call' | 'citation' | 'image',
    timestamp: '',
    status: 'sent' | 'sending' | 'error',
  },
}</component>
<style>
  .sui-message {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 100%;
    font-family: var(--font-body);
    color: var(--foreground);
    --bubble-bg: var(--card);
    --bubble-border: var(--border);
    --bubble-fg: var(--foreground);
  }
  .sui-message[hidden] { display: none; }

  /* Role tones the bubble surface + aligns user turns to the end. */
  .sui-message[role='user'] {
    align-items: flex-end;
    --bubble-bg: var(--tone-primary-bg);
    --bubble-border: var(--tone-primary-border);
  }
  .sui-message[role='system'] {
    --bubble-bg: var(--tone-muted-bg);
    --bubble-border: var(--border);
    --bubble-fg: var(--muted-foreground);
  }
  .sui-message[role='tool'] {
    --bubble-bg: var(--tone-accent-bg);
    --bubble-border: var(--tone-accent-border);
  }

  /* Status tints the leading edge of the bubble. */
  .sui-message[status='error'] {
    --bubble-border: var(--tone-destructive-border);
    --bubble-fg: var(--foreground);
  }
  .sui-message[status='sending'] .bubble { opacity: 0.7; }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    padding-inline: 2px;
  }
  .role-label { text-transform: capitalize; font-weight: var(--font-weight-medium); }
  .time { font-variant-numeric: tabular-nums; }

  .bubble {
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    background: var(--bubble-bg);
    border: 1px solid var(--bubble-border);
    border-radius: var(--radius-lg);
    color: var(--bubble-fg);
    font-size: var(--text-base);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* Monospace surfaces for code-shaped content. */
  .sui-message[content-type='code'] .content,
  .sui-message[content-type='terminal-snapshot'] .content,
  .sui-message[content-type='tool-call'] .content {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: pre-wrap;
  }
  .sui-message[content-type='terminal-snapshot'] .bubble {
    background: var(--surface-inverse);
    color: var(--background);
    border-color: var(--border-subtle);
  }
  /* Framed media for visual content. */
  .sui-message[content-type='drawing'] .content,
  .sui-message[content-type='image'] .content {
    display: block;
  }
  .sui-message[content-type='drawing'] ::slotted(*),
  .sui-message[content-type='image'] ::slotted(*) {
    max-width: 100%;
    border-radius: var(--radius-md);
  }

  .trailing { display: contents; }
  ::slotted([slot='trailing']) { margin-top: var(--space-1); }
</style>

<div class="meta">
  <span class="role-label role">{role()}</span>
  {#if timestamp()}
    <time class="time" datetime={timestamp()}>{timestamp()}</time>
  {/if}
</div>

<div class="bubble">
  <div class="content">
    <slot></slot>
  </div>
</div>

<div class="trailing">
  <slot name="trailing"></slot>
</div>
