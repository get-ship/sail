<!--
  <sui-message-list> — a keyed, windowed, scrollable column of
  <sui-message> bubbles. Items arrive via the `items` JS-property
  (`prop:items={...}`); each must carry a stable `id` for keyed
  reconciliation. With `sticky-bottom` (default), the list auto-scrolls
  to the newest message unless the user has scrolled up to read history.

  Long threads window through the shared `createVirtualizer`: only the
  visible slice (+overscan) of <sui-message> elements is in the DOM, so
  a 10k-message thread renders ~a dozen bubbles, not 10k. A spacer
  encodes the full thread height so the scrollbar stays honest; each row
  is absolutely positioned at its virtual offset.

  Item shape (all but `id` / `content` optional):
    { id, content, role?, contentType?, timestamp?, status? }

  Pure framework primitive — no SDK, no data fetching. Consumers feed
  their own array.

  Props
  ─────────────────────────────────────────────────────────────────────
  sticky-bottom  (bool)  Auto-scroll to newest unless scrolled up.
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="sticky-bottom" type="bool" default="true" reflect />

<style>
  :host {
    display: block;
    min-height: 0;
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }

  .scroll {
    position: relative;
    height: 100%;
    overflow-y: auto;
    padding: var(--space-3, 12px);
    scrollbar-width: thin;
  }
  .spacer {
    position: relative;
    width: 100%;
  }
  .row {
    position: absolute;
    left: var(--space-3, 12px);
    right: var(--space-3, 12px);
    display: flex;
    flex-direction: column;
  }
  .empty {
    display: contents;
  }
  ::slotted([slot='empty']) {
    margin: auto;
  }
</style>

<div class="scroll" part="scroll" bind:this={scrollEl}>
  <div class="spacer" part="spacer" style:height={`${totalSize()}px`}>
    {#for w of windowItems() key={w.key}}
      <div class="row" part="row" style:transform={`translateY(${w.start}px)`}>
        <sui-message
          role={w.item.role || 'assistant'}
          content-type={w.item.contentType || 'text'}
          timestamp={w.item.timestamp || ''}
          status={w.item.status || 'sent'}
        >{w.item.content}</sui-message>
      </div>
    {/for}
  </div>
  {#if items().length === 0}
    <div class="empty"><slot name="empty"></slot></div>
  {/if}
</div>
