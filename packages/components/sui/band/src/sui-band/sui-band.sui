<!--
  <sui-band> — a seamless marquee band.

  Scrolls its light-DOM content in an endless horizontal loop. The author
  writes the content ONCE; the component owns the seam math — it measures the
  content against the band and clones the content (aria-hidden, inert) until
  the -50% translate loop can never show a gap or a bare stretch at any
  viewport. The original nodes are the accessible copy; every clone is
  presentation only.

    <sui-band tone="primary" speed="fast" angle="rise">
      <span>NO RAW CSS ◆ SIGNALS BUILT IN ◆ A11Y BY CONSTRUCTION</span>
    </sui-band>

  Props:
    speed      normal | slow | fast — real px/s rates, so two bands with
               different content lengths still move at the same speed.
    direction  forward | reverse — forward scrolls the content leftward.
    angle      none | rise | fall — a ±1deg tilt. A tilted band widens
               itself by --space-8 per side so its rotated ends bleed past
               the container instead of showing bare corners.
    tone       Rides the global tone contract ([tone] fills --tone /
               --tone-contrast; contracts.css): unset/default is the muted
               surface band; any branded tone is the filled band.

  direction / angle / tone are pure CSS channels: the template mirrors them
  onto the root element, where the attribute-keyed rules (and the global
  [tone] channel) pick them up. Only `speed` reaches the controller — the
  animation duration is derived from measured content width.

  Reduced motion: under prefers-reduced-motion the animation is off (CSS —
  both the rule below and the runtime's global [data-component] kill-switch)
  and the controller removes every clone: the original content stands alone,
  fully visible and static.

  Seam math: the keyframe travels exactly -50% of the track, so the track
  must hold an EVEN number of identical copies (the loop point lands on a
  copy boundary — no seam) and each half must be at least as wide as the
  band (the tail is always covered — no bare stretch). The inter-copy gap
  lives INSIDE each copy (padding-inline-end), never as flex gap on the
  track: a track-level gap is excluded from the -50% distance and shows up
  as a one-gap jump at the loop point.
-->

<component>{
  props: {
    speed: 'normal' | 'slow' | 'fast',
    direction: 'forward' | 'reverse',
    angle: 'none' | 'rise' | 'fall',
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
  },
}</component>

<style>
  /* The band surface. Default (no tone / tone='default') is the muted band:
     surface + muted text + hairline borders. Any branded tone flips it to
     the filled band via the global tone channel — contracts.css fills
     --tone / --tone-contrast from the mirrored [tone] attribute. */
  .sui-band {
    display: block;
    overflow: hidden;
    padding-block: var(--space-2_5);
    background: var(--surface-2);
    color: var(--muted-foreground);
    border-block: 1px solid var(--border);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
  }
  .sui-band[tone]:not([tone='default']) {
    background: var(--tone);
    color: var(--tone-contrast);
    border-block: none;
  }

  /* Tilt. The rotated box's ends would expose bare corners inside a
     same-width container, so a tilted band bleeds one spacing step past
     each edge; the parent decides whether to clip the bleed. */
  .sui-band[angle='rise'],
  .sui-band[angle='fall'] {
    margin-inline: calc(-1 * var(--space-8));
  }
  .sui-band[angle='rise'] { transform: rotate(-1deg); }
  .sui-band[angle='fall'] { transform: rotate(1deg); }

  /* The moving track: original copy + controller-appended clones, single
     row, sized by content. --sui-band-duration is the stylesheet default;
     the controller overrides it inline from measured width x speed so the
     px/s rate is constant regardless of content length. */
  .track {
    --sui-band-duration: 24s;
    display: flex;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: sui-band-scroll var(--sui-band-duration) linear infinite;
  }
  .sui-band[direction='reverse'] .track { animation-direction: reverse; }

  /* One copy of the content. The inter-copy gap is padding INSIDE the copy
     (see the seam-math note above). flex:none — a shrinking copy would
     desynchronize the copies and break the loop-point alignment. */
  .copy {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-8);
    padding-inline-end: var(--space-8);
  }

  @keyframes sui-band-scroll {
    to { transform: translateX(-50%); }
  }

  /* Motion off, content still visible. The controller also removes the
     clones under this preference — the original stands alone. */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>

<controller>
// <sui-band> controller — the seam math for the marquee loop.
//
// The CSS animates the track by -50%, so correctness is a counting problem:
// the track must hold an even number of identical copies, and each half must
// be at least as wide as the band. copies = 2 x ceil(bandWidth / copyWidth);
// the controller appends (copies - 1) aria-hidden+inert clones after the
// original and keeps the count in step with resizes, content changes, and
// the speed prop. Clones are snapshots (cloneNode) with their ids stripped —
// the original slotted nodes stay the one accessible, interactive copy.
//
// Speed is honest px/s, not a fixed duration: duration = halfWidth / rate,
// re-derived from measurement, so short and long bands move at the same
// visual rate. The value rides the --sui-band-duration custom property
// (inline style beats the stylesheet default).
//
// Environments without layout (SSR-adjacent test DOMs measure 0) fall back
// to the minimum seamless shape — original + 1 clone — and the stylesheet's
// default duration, so the element never divides by zero and never renders
// an empty track.
//
// Under prefers-reduced-motion the CSS disables the animation and this
// controller removes every clone: no motion, no redundant content.

import { controller, effect } from "@ship/sui-runtime";
import type { Scope } from "./sui-band.sui";

// The slice of the mount `state` we touch: the `speed` prop signal and the
// `bind:this` refs, exposed as callables on `$signals` (the mount-style
// controller contract — same seam <sui-mermaid> uses).
interface BandState {
  $signals: {
    speed: () => string | undefined;
    band: () => HTMLElement | null;
    track: () => HTMLElement | null;
    copy: () => HTMLElement | null;
  };
}

/** Scroll rates. Pixels per second of real movement — the duration is
 *  derived from measured content width so the rate holds for any content. */
const PX_PER_SECOND: Record<string, number> = {
  slow: 40,
  normal: 80,
  fast: 160,
};

export default controller<Scope>({
  mount(state: BandState, host: HTMLElement) {
    void host;
    const band = state.$signals.band();
    const track = state.$signals.track();
    const copy = state.$signals.copy();
    if (!band || !track || !copy) return () => {};

    const reduced =
      typeof matchMedia === "function"
        ? matchMedia("(prefers-reduced-motion: reduce)")
        : null;

    let clones: HTMLElement[] = [];

    /** The content nodes of the original copy. Shadow mount: the slot's
     *  assigned (light-DOM) nodes. Light mount: the slot wrapper's children
     *  (the runtime projects the light children into it). */
    const contentNodes = (): Node[] => {
      const slotEl = copy.querySelector("slot");
      if (!slotEl) return Array.from(copy.childNodes);
      const assigned =
        typeof slotEl.assignedNodes === "function" ? slotEl.assignedNodes() : [];
      return assigned.length > 0 ? assigned : Array.from(slotEl.childNodes);
    };

    /** A presentation-only snapshot of the content: hidden from the a11y
     *  tree, unfocusable, ids stripped so the document never carries dupes. */
    const buildClone = (): HTMLElement => {
      const c = document.createElement("div");
      c.className = "copy";
      c.setAttribute("aria-hidden", "true");
      c.setAttribute("inert", "");
      c.setAttribute("data-sui-band-clone", "");
      for (const n of contentNodes()) {
        const dup = n.cloneNode(true);
        if (dup instanceof Element) {
          dup.removeAttribute("id");
          for (const idEl of dup.querySelectorAll("[id]")) idEl.removeAttribute("id");
        }
        c.appendChild(dup);
      }
      return c;
    };

    const clearClones = (): void => {
      for (const c of clones) c.remove();
      clones = [];
    };

    const setCloneCount = (n: number): void => {
      while (clones.length > n) clones.pop()!.remove();
      while (clones.length < n) {
        const c = buildClone();
        track.appendChild(c);
        clones.push(c);
      }
    };

    /** Re-derive clone count + duration from current measurements. */
    const layout = (): void => {
      const rate =
        PX_PER_SECOND[state.$signals.speed() ?? "normal"] ?? PX_PER_SECOND["normal"]!;
      if (reduced?.matches) {
        clearClones();
        track.style.removeProperty("--sui-band-duration");
        return;
      }
      const bandWidth = band.getBoundingClientRect().width;
      const copyWidth = copy.getBoundingClientRect().width;
      if (!(bandWidth > 0) || !(copyWidth > 0)) {
        // No layout to measure — minimum seamless shape, default duration.
        setCloneCount(1);
        track.style.removeProperty("--sui-band-duration");
        return;
      }
      const perHalf = Math.max(1, Math.ceil(bandWidth / copyWidth));
      setCloneCount(perHalf * 2 - 1);
      track.style.setProperty("--sui-band-duration", `${(perHalf * copyWidth) / rate}s`);
    };

    /** Content changed — stale snapshots must not scroll by. */
    const rebuild = (): void => {
      clearClones();
      layout();
    };

    // `speed` is reactive; direction/angle/tone are pure CSS attribute
    // channels mirrored onto the root by the template and never reach here.
    const stopSpeed = effect(() => {
      void state.$signals.speed();
      layout();
    });

    // Band resize: recount copies + duration. Copy resize: the content
    // itself changed size, so the snapshots are stale — rebuild them.
    // (Clones append to the track, which is not observed — no feedback loop.)
    const ro =
      typeof ResizeObserver === "undefined"
        ? null
        : new ResizeObserver((entries) => {
            if (entries.some((e) => e.target === copy)) rebuild();
            else layout();
          });
    ro?.observe(band);
    ro?.observe(copy);

    // Shadow mount: re-clone when the slot's assigned nodes change.
    const slotEl = copy.querySelector("slot");
    const onSlotChange = (): void => rebuild();
    slotEl?.addEventListener("slotchange", onSlotChange);

    const onMotionPref = (): void => rebuild();
    reduced?.addEventListener?.("change", onMotionPref);

    // First REAL pass once the slot projection has settled — the light-DOM
    // runtime places the captured children after mount returns, so the
    // effect's synchronous first run above snapshots an empty slot. Rebuild
    // (not just re-count) so that stale empty clone is replaced.
    queueMicrotask(rebuild);

    return () => {
      stopSpeed();
      ro?.disconnect();
      slotEl?.removeEventListener("slotchange", onSlotChange);
      reduced?.removeEventListener?.("change", onMotionPref);
      clearClones();
    };
  },
});
</controller>

<div class="sui-band" tone={tone()} direction={direction()} angle={angle()} bind:this={band}>
  <div class="track" bind:this={track}>
    <div class="copy" bind:this={copy}><slot></slot></div>
  </div>
</div>
