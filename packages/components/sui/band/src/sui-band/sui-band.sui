<!--
  <sui-band> — a seamless marquee band.

  Scrolls its light-DOM content in an endless horizontal loop. The author
  writes the content ONCE; the component owns the seam math — it measures the
  content against the band and clones the content (aria-hidden, inert) until
  the -50% translate loop can never show a gap or a bare stretch at any
  viewport. The original nodes are the accessible copy; every clone is
  presentation only.

    <sui-band tone="primary" speed="fast" angle="rise">
      <span>NO RAW CSS ◆ SIGNALS BUILT IN ◆ A11Y BY CONSTRUCTION</span>
    </sui-band>

  Props:
    speed      normal | slow | fast — real px/s rates, so two bands with
               different content lengths still move at the same speed.
    direction  forward | reverse — forward scrolls the content leftward.
    angle      none | rise | fall — a ±1deg tilt.
    tone       Rides the global tone contract ([tone] fills --tone /
               --tone-contrast; contracts.css): unset/default is the muted
               surface band; any branded tone is the filled band.

  speed + direction parameterize the loop and reach the controller; tone is a
  variant map on the root; angle reflects onto the host.

  Reduced motion: the runtime is the single authority. `motion:loop` is
  skipped entirely (ambient motion is decoration) and the band shows the
  content statically — original + zero clones, the original stands alone,
  fully visible, no horizontal scroll.

  Seam math: the loop travels exactly -50% of the track, so the track must
  hold an EVEN number of identical copies (the loop point lands on a copy
  boundary — no seam) and each half must be at least as wide as the band (the
  tail is always covered — no bare stretch). The inter-copy gap lives INSIDE
  each copy (its trailing padding), never as gap on the track: a track-level
  gap is excluded from the -50% distance and shows up as a one-gap jump at the
  loop point.
-->

<component>{
  props: {
    speed: 'normal' | 'slow' | 'fast',
    direction: 'forward' | 'reverse',
    angle: 'none' | 'rise' | 'fall',
    tone: variant({
      default: '',
      primary: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      info: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      success: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      warning: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      destructive: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      accent: 'bg:tone fg:tone-contrast border-t:none border-b:none',
      muted: 'bg:tone fg:tone-contrast border-t:none border-b:none',
    }),
  },
}</component>

<controller>
// <sui-band> controller — the seam math for the marquee loop.
//
// The track animates by -50%, so correctness is a counting problem: the track
// must hold an even number of identical copies, and each half must be at least
// as wide as the band. copies = 2 x ceil(bandWidth / copyWidth); the controller
// appends (copies - 1) aria-hidden+inert clones after the original and keeps the
// count in step with resizes, content changes, and the speed prop. Clones are
// snapshots (cloneNode) with their ids stripped — the original slotted nodes
// stay the one accessible, interactive copy.
//
// Speed is honest px/s, not a fixed duration: duration = halfWidth / rate,
// re-derived from measurement, so short and long bands move at the same visual
// rate.
//
// The LOOP is owned by the runtime: `motion:loop` creates the WAAPI animation
// through motion.dev, so the runtime is the single reduced-motion authority.
// The controller owns the SEAM MATH (a measurement concern) and the
// direction prop: when `direction` flips, the controller tears down the
// current motion and reattaches with the right `repeatType`. When
// `prefers-reduced-motion` is on, the runtime skips the motion entirely;
// the controller clears its clones so the original content stands alone
// (the band never scrolls under reduced motion — content gone would be
// the worst kind of correctness).
//
// Environments without layout (SSR-adjacent test DOMs measure 0) fall back to
// the minimum seamless shape — original + 1 clone — and the fallback duration,
// so the element never divides by zero and never renders an empty track.

import { controller, effect, __sui_motion_attach } from "@ship/sui-runtime";
import type { Scope } from "./sui-band.sui";

interface BandState {
  $signals: {
    speed: () => string | undefined;
    direction: () => string | undefined;
    band: () => HTMLElement | null;
    track: () => HTMLElement | null;
    copy: () => HTMLElement | null;
  };
}

/** Scroll rates. Pixels per second of real movement — the duration is
 *  derived from measured content width so the rate holds for any content. */
const PX_PER_SECOND: Record<string, number> = {
  slow: 40,
  normal: 80,
  fast: 160,
};

/** The loop duration when there is nothing to measure: px/s needs a width. */
const FALLBACK_DURATION_MS = 24_000;

export default controller<Scope>({
  mount(state: BandState, host: HTMLElement) {
    void host;
    const band = state.$signals.band();
    const track = state.$signals.track();
    const copy = state.$signals.copy();
    if (!band || !track || !copy) return () => {};

    const reduced =
      typeof matchMedia === "function"
        ? matchMedia("(prefers-reduced-motion: reduce)")
        : null;

    let clones: HTMLElement[] = [];
    let loopDispose: (() => void) | null = null;
    /** The measured half-track width in pixels — the loop's -50% target. */
    let lastHalfTrack = 0;

    /** The content nodes of the original copy. Shadow mount: the slot's
     *  assigned (light-DOM) nodes. Light mount: the slot wrapper's children
     *  (the runtime projects the light children into it). */
    const contentNodes = (): Node[] => {
      const slotEl = copy.querySelector("slot");
      if (!slotEl) return Array.from(copy.childNodes);
      const assigned =
        typeof slotEl.assignedNodes === "function" ? slotEl.assignedNodes() : [];
      return assigned.length > 0 ? assigned : Array.from(slotEl.childNodes);
    };

    /** A presentation-only snapshot of the content: hidden from the a11y tree,
     *  unfocusable, ids stripped so the document never carries dupes. It wears
     *  the original copy's classes — every copy must be the same box, or the
     *  measured half-track is not half the track. */
    const buildClone = (): HTMLElement => {
      const c = document.createElement("div");
      c.className = copy.className;
      c.setAttribute("aria-hidden", "true");
      c.setAttribute("inert", "");
      c.setAttribute("data-sui-band-clone", "");
      for (const n of contentNodes()) {
        const dup = n.cloneNode(true);
        if (dup instanceof Element) {
          dup.removeAttribute("id");
          for (const idEl of dup.querySelectorAll("[id]")) idEl.removeAttribute("id");
        }
        c.appendChild(dup);
      }
      return c;
    };

    const clearClones = (): void => {
      for (const c of clones) c.remove();
      clones = [];
    };

    const setCloneCount = (n: number): void => {
      while (clones.length > n) clones.pop()!.remove();
      while (clones.length < n) {
        const c = buildClone();
        track.appendChild(c);
        clones.push(c);
      }
    };

    const stopLoop = (): void => {
      if (loopDispose) loopDispose();
      loopDispose = null;
    };

    /** (Re)start the runtime-owned loop. The runtime creates the WAAPI
     *  animation through motion.dev; we hand it the resolved duration
     *  (derived from measurement + px/s rate) and the directional
     *  repeatType. `marquee` is the runtime's one-direction-infinite
     *  preset; `marquee-reverse` alternates. The runtime is the single
     *  reduced-motion authority — under reduced motion the loop is
     *  skipped at attach time. */
    const playLoop = (durationMs: number): void => {
      stopLoop();
      // The runtime owns the WAAPI loop. `translate-x` here is a PIXEL
      // value of `-50%` of the measured half-track — the band measures
      // the track once per layout, so the runtime gets a number it can
      // hand to motion.dev as `x: [0, -px]`. (Motion's per-value keyframes
      // interpolate between numbers; the `direction: 'normal'` runs the
      // loop one way; `direction: 'reverse'` runs it the other.)
      const dir = state.$signals.direction() === "reverse" ? "reverse" : "normal";
      const halfTrack = lastHalfTrack ?? 0;
      const targetPx = dir === "reverse" ? halfTrack : -halfTrack;
      loopDispose = __sui_motion_attach(track, {
        trigger: "loop",
        motions: [
          {
            property: "translate-x",
            preset: dir === "reverse" ? "marquee-reverse" : "marquee",
            kind: "tween",
            duration: durationMs / 1000,
            from: 0,
            to: targetPx,
            iterations: Infinity,
            direction: "normal",
          },
        ],
      });
    };

    /** Re-derive clone count + duration from current measurements. */
    const layout = (): void => {
      const rate =
        PX_PER_SECOND[state.$signals.speed() ?? "normal"] ?? PX_PER_SECOND["normal"]!;
      if (reduced?.matches) {
        clearClones();
        stopLoop();
        return;
      }
      const bandWidth = band.getBoundingClientRect().width;
      const copyWidth = copy.getBoundingClientRect().width;
      if (!(bandWidth > 0) || !(copyWidth > 0)) {
        // No layout to measure — minimum seamless shape, fallback duration.
        setCloneCount(1);
        playLoop(FALLBACK_DURATION_MS);
        return;
      }
      const perHalf = Math.max(1, Math.ceil(bandWidth / copyWidth));
      lastHalfTrack = perHalf * copyWidth;
      setCloneCount(perHalf * 2 - 1);
      playLoop((lastHalfTrack / rate) * 1000);
    };

    /** Content changed — stale snapshots must not scroll by. */
    const rebuild = (): void => {
      clearClones();
      layout();
    };

    // `speed` and `direction` both parameterize the loop. `angle`/`tone` are
    // reflected host attributes the stylesheet reads; they never reach here.
    const stopSpeed = effect(() => {
      void state.$signals.speed();
      void state.$signals.direction();
      layout();
    });

    // Band resize: recount copies + duration. Copy resize: the content
    // itself changed size, so the snapshots are stale — rebuild them.
    // (Clones append to the track, which is not observed — no feedback loop.)
    const ro =
      typeof ResizeObserver === "undefined"
        ? null
        : new ResizeObserver((entries) => {
            if (entries.some((e) => e.target === copy)) rebuild();
            else layout();
          });
    ro?.observe(band);
    ro?.observe(copy);

    // Shadow mount: re-clone when the slot's assigned nodes change.
    const slotEl = copy.querySelector("slot");
    const onSlotChange = (): void => rebuild();
    slotEl?.addEventListener("slotchange", onSlotChange);

    const onMotionPref = (): void => rebuild();
    reduced?.addEventListener?.("change", onMotionPref);

    // First REAL pass once the slot projection has settled — the light-DOM
    // runtime places the captured children after mount returns, so the
    // effect's synchronous first run above snapshots an empty slot. Rebuild
    // (not just re-count) so that stale empty clone is replaced.
    queueMicrotask(rebuild);

    return () => {
      stopSpeed();
      ro?.disconnect();
      slotEl?.removeEventListener("slotchange", onSlotChange);
      reduced?.removeEventListener?.("change", onMotionPref);
      clearClones();
      stopLoop();
    };
  },
});
</controller>

<column gap="0" bind:this={band} sx="overflow-hidden py-2_5 bg-surface-2 text-muted-foreground border-t border-t-border border-b border-b-border text-sm font-semibold tracking-wide">
  <row gap="0" align="center" bind:this={track} sx="w-max whitespace-nowrap">
    <row gap="8" align="center" bind:this={copy} sx="grow-0 pr-8"><slot></slot></row>
  </row>
</column>
