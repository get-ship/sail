<!--
  <sui-render> — THE engine primitive: a live, reactive mount stage for a SUI
  component (build-spec §1 / §Render-engine seam).

  Thin shell. ALL render-engine work (compile + view-mode `__mount` + net-new
  component-mode createElement / prop-apply / slot-inject / versioned-tag swap
  + dispose) lives in the paired controller + `engine/*.ts`. The template only:
    - declares the scalar control props (mode / component-name / viewport-width)
    - hosts the stage container via `bind:this={stageEl}` (ref in scope) —
      NEVER a post-mount querySelector
    - wraps the fault-prone subtree in <sui-error-boundary> so an agent's `.sui`
      that throws in setup/mount/render is CAUGHT, not a white screen
    - folds the compile-error display (the culled sui-compile-error) and the
      runtime-error panel, plus a <sui-spinner> while compiling

  Data (the bound `compile()`, raw `source`, `propValues`, `setup`, `slots`)
  arrives via `prop:*` identity/snapshot — the host owns discovery. NO
  object/json attribute props (Cardinal: `<prop type=json>` does not exist).
-->

<prop name="mode" values="source|tag" default="source" reflect />
<prop name="component-name" type="string" default="" reflect />
<prop name="viewport-width" values="full|desktop|tablet|mobile" default="full" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
    /* Viewport-width presets defined locally (no theme token exists for
       device widths). Referenced by the [viewport-width] host-attr rules. */
    --viewport-desktop: 1280px;
    --viewport-tablet: 768px;
    --viewport-mobile: 390px;
  }
  :host([hidden]) { display: none; }

  .frame {
    position: relative;
    min-height: var(--space-8);
  }

  /* Viewport framing — a stage width constraint (build-spec §Responsive).
     Theme/density are orthogonal axes, unaffected by the width. */
  .stage {
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }
  :host([viewport-width='desktop']) .stage { max-width: var(--viewport-desktop); }
  :host([viewport-width='tablet']) .stage { max-width: var(--viewport-tablet); }
  :host([viewport-width='mobile']) .stage { max-width: var(--viewport-mobile); }

  .compiling {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
</style>

<sui-error-boundary fallback-text="The specimen threw while rendering.">
  <column gap="2" class="frame" part="frame">
    {#if compiling()}
      <div class="compiling" part="compiling">
        <sui-spinner size="sm" label="Compiling"></sui-spinner>
      </div>
    {/if}

    {#if compileError() !== null}
      <column gap="2" part="compile-error" data-test="compile-error">
        <sui-alert tone="destructive">{compileErrorSummary()}</sui-alert>
        <div role="region" aria-label="text code block" sx="bg:surface-2 fg:foreground border:subtle radius:md overflow:hidden">
          <header sx="p:2 px:3 text:xs fg:muted-foreground bg:muted weight:medium tracking:wide">TEXT</header>
          <separator sx="m:0"></separator>
          <pre sx="py:3 px:4 overflow-x:auto leading:normal-plus">{compileErrorBody()}</pre>
        </div>
      </column>
    {/if}

    {#if runtimeError() !== null}
      <column gap="2" part="runtime-error" data-test="runtime-error">
        <sui-alert tone="destructive">The specimen threw at runtime.</sui-alert>
        <div role="region" aria-label="text code block" sx="bg:surface-2 fg:foreground border:subtle radius:md overflow:hidden">
          <header sx="p:2 px:3 text:xs fg:muted-foreground bg:muted weight:medium tracking:wide">TEXT</header>
          <separator sx="m:0"></separator>
          <pre sx="py:3 px:4 overflow-x:auto leading:normal-plus">{runtimeError()}</pre>
        </div>
      </column>
    {/if}

    <div class="stage" part="stage" bind:this={stageEl}></div>
  </column>
</sui-error-boundary>
