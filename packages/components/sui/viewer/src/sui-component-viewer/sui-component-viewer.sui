<!--
  <sui-component-viewer> — the shared component-viewing surface: a live stage
  holding the REAL component (slot="stage"), variant chips that drive a real
  attribute on it, and its generated prop table. Every surface that shows a
  component composes this one — docs, studio, devtools, eval.

    <sui-component-viewer name="badge" variant-attr="variant"
                          prop:variants={['solid','soft','outline']}
                          prop:props={PROP_REGISTRY.badge}
                          usage={snippet}>
      <badge slot="stage" variant="solid" tone="primary">Live</badge>
    </sui-component-viewer>

  The specimen is slotted, so the viewer never mounts a fake: the host renders
  the component it actually ships. Picking a variant writes the named attribute
  onto every slotted element and emits sui-variant-change.
-->

<component>{
  props: {
    /** Component name — the heading. */
    name: '',
    /** Short blurb under the heading. */
    blurb: '',
    /** Pack label chip (e.g. "L1 · language element"). */
    pack: '',
    /** Which attribute the variant chips drive (empty = no chips). */
    'variant-attr': '',
    /** Variant values. */
    variants: string[],
    /** Prop rows — the generated registry's shape. (`props` is the runtime's
        own context key, so the rows land on `rows`.) */
    rows: PropRow[],
    /** A complete, compiling usage program. */
    usage: '',
    /** Hide the a11y assurance chip (fx actions and the like). */
    'no-a11y-chip': false,
  },
}</component>

<controller>
import { controller, derived, effect, signal } from '@ship/sui-runtime'
import type { Scope } from './sui-component-viewer.sui'

export interface PropRow {
  name: string
  type: string
  desc: string
}

export default controller<Scope>({
  scope: ({ variants, rows, usage, variantAttr }: Scope) => {
    const active = signal('')
    const variantList = derived(() => variants() ?? [])
    const hasVariants = derived(() => (variantAttr() ?? '') !== '' && variantList().length > 0)
    const current = derived(() => active() || variantList()[0] || '')
    const propRows = derived(() => rows() ?? [])
    const hasProps = derived(() => propRows().length > 0)
    const hasUsage = derived(() => (usage() ?? '') !== '')
    const chips = derived(() =>
      variantList().map((v) => ({ v, variant: v === current() ? 'solid' : 'ghost' })),
    )
    return { active, current, chips, hasVariants, propRows, hasProps, hasUsage }
  },

  mount(state, host) {
    // Picking a variant writes the real attribute onto the slotted specimen —
    // the viewer drives the component, it does not simulate it.
    const apply = (): void => {
      const attr = (state.$signals.variantAttr as unknown as () => string)()
      const val = (state.$signals.current as unknown as () => string)()
      if (!attr || !val) return
      for (const el of host.querySelectorAll('[slot="stage"]')) el.setAttribute(attr, val)
    }
    const onClick = (e: Event): void => {
      const btn = (e.target as HTMLElement).closest('[data-variant]')
      if (!btn) return
      const v = btn.getAttribute('data-variant') ?? ''
      state.active = v
      apply()
      host.dispatchEvent(
        new CustomEvent('sui-variant-change', {
          detail: { variant: v },
          bubbles: true,
          composed: true,
        }),
      )
    }
    host.addEventListener('click', onClick)
    // The specimen tracks the selection: identity props (variants) may land
    // after mount, and a pick must reach the slotted element either way.
    const stop = effect(apply)
    return () => {
      stop()
      host.removeEventListener('click', onClick)
    }
  },
})
</controller>

<column class="viewer" gap="4" sx="w:full">
  <row class="head" gap="3" align="center">
    <h2 class="name" sx="font:mono tracking:tight">{name()}</h2>
    {#if pack() !== ''}
      <badge tone="primary" variant="soft">{pack()}</badge>
    {/if}
    {#if !noA11yChip()}
      <badge tone="muted" variant="outline">a11y ✓ · keyboard ✓</badge>
    {/if}
  </row>
  {#if blurb() !== ''}
    <p class="blurb" sx="fg:muted-foreground">{blurb()}</p>
  {/if}

  <column class="stage-shell" gap="4" sx="p:5 radius:lg border:border bg:surface-0">
    <row class="stage-bar" gap="2" align="center" justify="between">
      <row gap="2" align="center">
        {#if hasVariants()}
          <span class="attr" sx="font:mono text:xs fg:muted-foreground">{variantAttr()}:</span>
          {#for c of chips() key={c.v}}
            <button size="sm" tone="primary" variant={c.variant} data-variant={c.v}>{c.v}</button>
          {/for}
        {/if}
      </row>
      <row gap="2" align="center">
        <status-dot tone="success"></status-dot>
        <span class="live" sx="font:mono text:xs fg:muted-foreground">live</span>
      </row>
    </row>

    <center class="stage" data-stage sx="p:6 min-h:9 grow:1">
      <slot name="stage"></slot>
    </center>
  </column>

  {#if hasUsage()}
    <column class="usage" gap="2">
      <p class="pane-label" sx="text:xs fg:muted-foreground case:upper tracking:wide">Usage — a complete program</p>
      <code-block code={usage()}></code-block>
    </column>
  {/if}

  {#if hasProps()}
    <card class="props" sx="p:4">
      <column gap="3">
        <p class="pane-label" sx="text:xs fg:muted-foreground case:upper tracking:wide">Props</p>
        {#for r of propRows() key={r.name}}
          <column gap="1">
            <row gap="3" align="baseline">
              <code>{r.name}</code>
              <span class="type" sx="font:mono text:xs fg:muted-foreground grow:1">{r.type}</span>
            </row>
            {#if r.desc !== ''}
              <p sx="text:sm fg:muted-foreground">{r.desc}</p>
            {/if}
          </column>
        {/for}
      </column>
    </card>
  {/if}

  <slot></slot>
</column>
