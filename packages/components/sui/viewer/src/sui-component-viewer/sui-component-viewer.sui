<!--
  <sui-component-viewer> — THE composition primitive + the embeddable product
  tag (build-spec §The viewing components #6 / Slice 5).

  The single tag a host drops in to get a live, reactive preview of a SUI
  component. It COMPOSES the four committed viewing tags — it does NOT rebuild
  any of them:
    - <sui-render>        the live mount stage (view-mode over the source signal)
    - <sui-prop-knobs>    the CEM-driven playground
    - <sui-prop-matrix>   the Storybook-style state sweep
    - <sui-source-panel>  source + paste-able snippet
    - the folded props/slots loop  (name/type/default from the CEM)
  flipped between via <sui-tabs>/<sui-tab-panel>, the whole subtree wrapped in
  an internal <sui-error-boundary>.

  Thin shell. The shared 'viewer:propValues' store + the cross-child lockstep
  (knob/matrix/reset → the shared store → stage render + matrix highlight +
  snippet) live in the paired controller + `lockstep.ts`. The template only:
    - declares the scalar control props (component-name / viewport-width)
    - lays out the stage + the inspector tabs
    - hides (does NOT error) the knobs/matrix/props-table in no-CEM degraded mode
    - threads `propValues()` / `compile()` / `sourceText()` / `slots()` down to
      the children via `prop:*` identity

  Data (the live source signal, the CEM `attributes[]`, the bound `compile()`,
  slots) arrives via `prop:*` IDENTITY — set as JS properties on the host. NO
  object/json attribute props (`<prop type=json>` does not exist). So this
  template declares only the two scalar control props.

  READ-ONLY-OVER-SOURCE: nothing here writes back to the source signal — the
  viewer is read-only over an injected source (the no-IDE fence).
-->

<prop name="component-name" type="string" default="" reflect />
<prop name="viewport-width" values="full|desktop|tablet|mobile" default="full" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .layout {
    display: grid;
    gap: var(--space-4);
  }

  .stage-shell {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-4);
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-3);
  }

  /* The folded props/slots table — rows are row-shaped, so padding reads the
     density channel, not the base --space-* scale. */
  .props-table {
    display: grid;
    gap: 0;
  }
  .prop-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: var(--density-row-gap);
    align-items: baseline;
    padding: var(--density-row-py) var(--density-row-px);
    border-bottom: 1px solid var(--divider);
    font-size: var(--density-text);
  }
  .prop-row:last-child { border-bottom: none; }
  .prop-name {
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }
  .prop-type { color: var(--muted-foreground); }
  .prop-default { color: var(--muted-foreground); }

  .meta-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
</style>

<sui-error-boundary fallback-text="The viewer threw while composing.">
  <column gap="4" class="layout" part="layout">

    <!-- The live render stage (view-mode over the source signal). A flip of the
         host's source signal re-derives sourceText() → the stage re-mounts. The
         stage also receives propValues so a host mounting by tag patches in
         place; in source-mode they are simply unused. -->
    <div class="stage-shell" part="stage-shell">
      <sui-render
        part="stage"
        mode={componentName() !== '' ? 'tag' : 'source'}
        component-name={componentName()}
        viewport-width={viewportWidth()}
        prop:compile={compile()}
        prop:source={sourceText()}
        prop:prop-values={propValues()}
        prop:slots={slots()}
      ></sui-render>
    </div>

    <!-- The CEM-driven playground. HIDDEN (not errored) in no-CEM degraded mode.
         Reads the shared 'viewer:propValues' via useShared; falls back to
         prop:value when detached. -->
    <sui-prop-knobs
      part="knobs"
      hidden={showInspector() ? null : true}
      prop:props={cem()}
      prop:value={propValues()}
    ></sui-prop-knobs>

    <!-- The inspector tabs: flip the state-matrix / props-table / source. -->
    <sui-tabs active="source" variant="underline" size="sm" part="tabs">
      <sui-tab name="source">Source</sui-tab>
      {#if showInspector()}
        <sui-tab name="matrix">States</sui-tab>
        <sui-tab name="props">Props</sui-tab>
      {/if}

      <sui-tab-panel name="source" part="source-panel">
        <sui-source-panel
          component-name={componentName()}
          prop:source={sourceText()}
          prop:props={cem()}
          prop:value={propValues()}
          prop:slot-content={slots()}
        ></sui-source-panel>
      </sui-tab-panel>

      <sui-tab-panel name="matrix" part="matrix-panel">
        <sui-prop-matrix
          hidden={showInspector() ? null : true}
          component-name={componentName()}
          prop:props={cem()}
          prop:compile={compile()}
          prop:source={sourceText()}
          prop:active={propValues()}
          prop:slot-content={slots()}
        ></sui-prop-matrix>
      </sui-tab-panel>

      <sui-tab-panel name="props" part="props-panel">
        <div
          class="panel"
          part="props-table-shell"
          data-props-table
          hidden={showInspector() ? null : true}
        >
          <div class="section-head" part="props-head">
            <span class="meta-label" part="meta-label">{meta()}</span>
          </div>

          {#if propRows().length === 0}
            <sui-empty-state part="props-empty"></sui-empty-state>
          {:else}
            <div class="props-table" part="props-table" role="table">
              {#for row of propRows() key={row.name}}
                <div class="prop-row" part="prop-row" data-prop-row role="row">
                  <span class="prop-name" part="prop-name" role="cell">{row.name}</span>
                  <span class="prop-type" part="prop-type" role="cell">
                    <sui-code lang="ts">{row.type}</sui-code>
                  </span>
                  <span class="prop-default" part="prop-default" role="cell">{row.def}</span>
                </div>
              {/for}
            </div>
          {/if}

          <div class="section" part="slots-section" data-slots-section>
            {#if hasSlots()}
              <span class="meta-label" part="slots-label">Slots</span>
            {:else}
              <sui-empty-state part="slots-empty"></sui-empty-state>
            {/if}
          </div>
        </div>
      </sui-tab-panel>
    </sui-tabs>
  </column>
</sui-error-boundary>
