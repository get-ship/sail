<!--
  <sui-prop-matrix> — the Storybook-style state sweep (build-spec §3).

  Derives axes from the target's CEM (`deriveAxes`: variant primary, tone/size
  secondary, else sole axis) and builds the full cartesian grid (`buildCells`).
  EACH cell is its OWN <sui-render> in component-mode — so the matrix COMPOSES
  the committed engine (it does not rebuild it). One bad combination cannot
  blank the grid: every <sui-render> brings its own <sui-error-boundary>.

  Thin shell. ALL derivation + the cell store + the active-match + the click
  emit live in the paired controller + `matrix.ts`. The template only:
    - declares the scalar control prop (component-name)
    - loops the cells with a STABLE per-cell key (cell.id is REQUIRED, else
      active-cell identity is lost on a CEM re-derive)
    - hands each cell its merged props / shared compile / shared source / shared
      slot-content down to a per-cell <sui-render> via `prop:*` identity
    - marks the cell matching `prop:active` with [data-active]

  Structured data (CEM `attributes[]`, the bound `compile()`, the source, the
  active prop-values, the slot markup) arrives via `prop:*` identity — NO
  object/json attribute props (`<prop type=json>` does not exist).

  Cells are ROW-SHAPED → padding/gap/text read the `--density-*` channel
  (`<html data-density>`), NOT the base `--space-*` scale.
-->

<prop name="component-name" type="string" default="" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--density-text);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--density-row-gap);
  }

  /* A cell is row-shaped — padding from the density channel, not --space-*.
     The vertical rhythm is the inner <sui-stack>; this rule is only the
     button frame (border / surface / active ring). */
  .cell {
    display: block;
    width: 100%;
    text-align: start;
    padding: var(--density-row-py) var(--density-row-px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    cursor: pointer;
    transition: box-shadow var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .cell[data-active] {
    border-color: var(--primary);
    box-shadow: var(--shadow-accent);
  }

  .cell-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-transform: lowercase;
    letter-spacing: var(--tracking-wide);
  }

  .cell-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--density-icon);
  }
</style>

{#if cells().length === 0}
  <sui-empty-state part="empty"></sui-empty-state>
{:else}
  <div class="grid" part="grid" role="group" aria-label={gridLabel()}>
    {#for cell of cells() key={cell.id}}
      <button
        type="button"
        class="cell"
        part="cell"
        data-matrix-cell
        data-cell-id={cell.id}
        data-active={activeId() === cell.id ? true : null}
        aria-pressed={activeId() === cell.id ? 'true' : 'false'}
      >
        <sui-stack gap="1">
          <span class="cell-label" part="cell-label">{cell.label}</span>
          <span class="cell-stage" part="cell-stage">
            <sui-render
              mode="tag"
              component-name={componentName()}
              prop:compile={compile()}
              prop:source={source()}
              prop:prop-values={cell.props}
              prop:slots={slotContent()}
            ></sui-render>
          </span>
        </sui-stack>
      </button>
    {/for}
  </div>
{/if}
