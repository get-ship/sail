<!--
  <sui-prop-knobs> — the CEM-driven playground control set
  (build-spec §The viewing components #2).

  Thin shell. The 4-way classification + propValues store + default-seeding +
  dedup-before-emit live in the paired controller (`sui-prop-knobs.controller`)
  + the pure `classify.ts`. The template only:
    - iterates the classified `knobs()` (keyed by name)
    - per knob, picks the control via {#match knob.kind}:
        enum   → sui-toggle-group variant=segmented + a sui-toggle per option
        bool   → sui-switch
        number → sui-input type=number
        string → sui-input
    - tags each knob row `data-knob={knob.name}` so the controller's delegated
      sui-change / sui-input listener can resolve the owning prop, and a host
      can target one knob.

  The CEM `attributes[]` (`props`) and the controlled `propValues` snapshot
  (`value`) arrive via prop:* IDENTITY — set as JS properties on the host in the
  controller's mount, NEVER a json/object <prop> (Cardinal: `<prop type=json>`
  does not exist). So this template declares no structural <prop>.
-->

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }
</style>

<sui-stack gap="4" part="knobs">
  {#for knob of knobs() key={knob.name}}
    <sui-stack gap="2" part="knob" data-knob={knob.name}>
      <sui-label size="sm">{knob.name}</sui-label>

      {#match knob.kind}
        {:case 'enum'}
          <sui-toggle-group
            variant="segmented"
            type="single"
            size="sm"
            prop:value={knob.value()}
          >
            {#for opt of knob.options key={opt}}
              <sui-toggle value={opt}>{opt}</sui-toggle>
            {/for}
          </sui-toggle-group>
        {:case 'bool'}
          <sui-switch size="sm" prop:checked={knob.checked()}></sui-switch>
        {:case 'number'}
          <sui-input type="number" size="sm" prop:value={knob.value()}></sui-input>
        {:default}
          <sui-input type="text" size="sm" prop:value={knob.value()}></sui-input>
      {/match}
    </sui-stack>
  {/for}
</sui-stack>
