<!--
  <sui-graph-canvas> — SUI port of <ship-graph-canvas>.
  Generic positioned-graph primitive. Renders an SVG edge layer with bezier
  paths plus absolutely-positioned node cards.

  Prop / event parity vs <ship-graph-canvas>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                           SUI                          Notes
  ─────────────────────────────────────────────────────────────────────────────
  nodes (array|string, [])      nodes (string, '')            ✓ JSON-encoded
  edges (array|string, [])      edges (string, '')            ✓ JSON-encoded
  width (number, 1000, reflect) width (number, 1000, reflect) ✓
  height (number, 600, reflect) height (number, 600, reflect) ✓
  layout ('positioned'|'radial' layout (union, 'positioned',  ✓
    , 'positioned', reflect)      reflect)
  selectedId (string, '',       selected-id (string, '',      ✓
    reflect, attribute:           reflect)
    'selected-id')
  ─────────────────────────────────────────────────────────────────────────────
  ship-node-select {id, kind}   sui-node-select {id, kind}    renamed
  ship-node-hover  {id, kind}   sui-node-hover  {id, kind}    renamed
  ─────────────────────────────────────────────────────────────────────────────
  Slots: node (hidden; per-kind <template slot="node" data-kind="...">)
  ─────────────────────────────────────────────────────────────────────────────
  Parts: canvas, edges, node
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="nodes" type="string" default="" />
<prop name="edges" type="string" default="" />
<prop name="width" type="number" default="1000" reflect />
<prop name="height" type="number" default="600" reflect />
<prop name="layout" values="positioned|radial" default="positioned" reflect />
<prop name="selected-id" type="string" default="" reflect />

<style>
  :host {
    display: block;
    position: relative;
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    /* Component knobs — consumers may override on the host. */
    --graph-aspect: 5 / 3;
    --node-w: 180px;
    --edge-default: var(--border);
    --edge-agent: var(--tone-primary-fg);
    --edge-skill: var(--tone-success-fg);
    --edge-mcp: var(--tone-info-fg);
    --edge-rule: var(--tone-warning-fg);
    --edge-perm: var(--tone-destructive-fg);
    --edge-harness: var(--tone-accent-fg);
  }
  :host([hidden]) { display: none; }

  .canvas {
    position: relative;
    width: 100%;
    aspect-ratio: var(--graph-aspect, 5 / 3);
  }

  svg.edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  svg.edges path {
    fill: none;
    stroke: var(--edge-default);
    stroke-width: 1.5;
    opacity: 0.85;
  }
  svg.edges path[data-kind='agent']    { stroke: var(--edge-agent); }
  svg.edges path[data-kind='skill']    { stroke: var(--edge-skill); }
  svg.edges path[data-kind='mcp']      { stroke: var(--edge-mcp); }
  svg.edges path[data-kind='rule']     { stroke: var(--edge-rule); }
  svg.edges path[data-kind='perm']     { stroke: var(--edge-perm); }
  svg.edges path[data-kind='harness'] { stroke: var(--edge-harness); }
  svg.edges path[data-dashed] { stroke-dasharray: 4 3; }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: var(--node-w, 180px);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    color: var(--foreground);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    transition: box-shadow var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .node:hover { box-shadow: var(--shadow-sm); }
  .node:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .node[data-selected] {
    border-color: var(--ring);
    box-shadow: var(--shadow-sm);
  }
  .node[data-kind='agent']    { border-left: 3px solid var(--edge-agent); }
  .node[data-kind='skill']    { border-left: 3px solid var(--edge-skill); }
  .node[data-kind='mcp']      { border-left: 3px solid var(--edge-mcp); }
  .node[data-kind='rule']     { border-left: 3px solid var(--edge-rule); }
  .node[data-kind='perm']     { border-left: 3px solid var(--edge-perm); }
  .node[data-kind='harness'] { border-left: 3px solid var(--edge-harness); }

  .node-h {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .tag {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .node-title {
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }
  .node-sub {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  ::slotted(template) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .node { transition: none; }
  }
</style>

<div class="canvas" part="canvas" bind:this={canvasEl}></div>
<slot name="node" hidden></slot>
