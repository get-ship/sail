<!--
  <sui-graph-canvas> — SUI port of <ship-graph-canvas>.
  Generic positioned-graph primitive. Renders an SVG edge layer with bezier
  paths plus absolutely-positioned node cards.

  Prop / event parity vs <ship-graph-canvas>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                           SUI                          Notes
  ─────────────────────────────────────────────────────────────────────────────
  nodes (array|string, [])      nodes (string, '')            ✓ JSON-encoded
  edges (array|string, [])      edges (string, '')            ✓ JSON-encoded
  width (number, 1000, reflect) width (number, 1000, reflect) ✓
  height (number, 600, reflect) height (number, 600, reflect) ✓
  layout ('positioned'|'radial' layout (union, 'positioned',  ✓
    , 'positioned', reflect)      reflect)
  selectedId (string, '',       selected-id (string, '',      ✓
    reflect, attribute:           reflect)
    'selected-id')
  ─────────────────────────────────────────────────────────────────────────────
  ship-node-select {id, kind}   sui-node-select {id, kind}    renamed
  ship-node-hover  {id, kind}   sui-node-hover  {id, kind}    renamed
  ─────────────────────────────────────────────────────────────────────────────
  Slots: node (hidden; per-kind <template slot="node" data-kind="...">)
  ─────────────────────────────────────────────────────────────────────────────
  Parts: canvas, edges, node
  ─────────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    nodes: '',
    edges: '',
    width: 1000,
    height: 600,
    layout: 'positioned' | 'radial',
    'selected-id': '',
  },
}</component>
<style>
  .sui-graph-canvas {
    display: block;
    position: relative;
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    /* Component knobs — consumers may override on the host. */
    --graph-aspect: 5 / 3;
    --node-w: 180px;
    --edge-default: var(--border);
    --edge-agent: var(--tone-primary-fg);
    --edge-skill: var(--tone-success-fg);
    --edge-mcp: var(--tone-info-fg);
    --edge-rule: var(--tone-warning-fg);
    --edge-perm: var(--tone-destructive-fg);
    --edge-harness: var(--tone-accent-fg);
  }
  .sui-graph-canvas[hidden] { display: none; }

  .canvas {
    position: relative;
    width: 100%;
    aspect-ratio: var(--graph-aspect, 5 / 3);
  }

  svg.edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  svg.edges path {
    fill: none;
    stroke: var(--edge-default);
    stroke-width: 1.5;
    opacity: 0.85;
  }
  svg.edges path[data-kind='agent']    { stroke: var(--edge-agent); }
  svg.edges path[data-kind='skill']    { stroke: var(--edge-skill); }
  svg.edges path[data-kind='mcp']      { stroke: var(--edge-mcp); }
  svg.edges path[data-kind='rule']     { stroke: var(--edge-rule); }
  svg.edges path[data-kind='perm']     { stroke: var(--edge-perm); }
  svg.edges path[data-kind='harness'] { stroke: var(--edge-harness); }
  svg.edges path[data-dashed] { stroke-dasharray: 4 3; }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: var(--node-w, 180px);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    color: var(--foreground);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    transition: box-shadow var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .node:hover { box-shadow: var(--shadow-sm); }
  .node:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .node[data-selected] {
    border-color: var(--ring);
    box-shadow: var(--shadow-sm);
  }
  .node[data-kind='agent']    { border-left: 3px solid var(--edge-agent); }
  .node[data-kind='skill']    { border-left: 3px solid var(--edge-skill); }
  .node[data-kind='mcp']      { border-left: 3px solid var(--edge-mcp); }
  .node[data-kind='rule']     { border-left: 3px solid var(--edge-rule); }
  .node[data-kind='perm']     { border-left: 3px solid var(--edge-perm); }
  .node[data-kind='harness'] { border-left: 3px solid var(--edge-harness); }

  .node-h {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .tag {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .node-title {
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }
  .node-sub {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  ::slotted(template) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .node { transition: none; }
  }
</style>


<controller>
import { controller, bindHtml } from '@ship/sui-runtime'
import type { Scope } from './sui-graph-canvas.sui'

export interface GraphNode {
  id: string
  kind: string
  title?: string
  sub?: string
  x?: number
  y?: number
  w?: number
  data?: Record<string, unknown>
}

export interface GraphEdge {
  from: string
  to: string
  kind?: string
  dashed?: boolean
}

function esc(s: string): string {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
}

function coerce<T>(v: unknown, fallback: T[]): T[] {
  if (Array.isArray(v)) return v as T[]
  if (typeof v === 'string' && v.trim()) {
    try {
      const parsed = JSON.parse(v)
      return Array.isArray(parsed) ? (parsed as T[]) : fallback
    } catch {
      return fallback
    }
  }
  return fallback
}

function computePositions(
  nodes: GraphNode[],
  width: number,
  height: number,
  layout: string,
): Map<string, { x: number; y: number }> {
  const map = new Map<string, { x: number; y: number }>()
  const missing = nodes.some((n) => typeof n.x !== 'number' || typeof n.y !== 'number')
  if (layout === 'positioned' && !missing) {
    for (const n of nodes) map.set(n.id, { x: n.x as number, y: n.y as number })
    return map
  }
  const cx = width * 0.22
  const cy = height * 0.5
  const centers = nodes.filter((n) => n.kind === 'agent')
  const satellites = nodes.filter((n) => n.kind !== 'agent')
  centers.forEach((n, i) => {
    const span = Math.max(1, centers.length)
    const y = cy + (i - (span - 1) / 2) * 80
    map.set(n.id, { x: cx, y })
  })
  const byKind = new Map<string, GraphNode[]>()
  for (const n of satellites) {
    const list = byKind.get(n.kind) ?? []
    list.push(n)
    byKind.set(n.kind, list)
  }
  const kinds = Array.from(byKind.keys())
  kinds.forEach((kind, bandIdx) => {
    const list = byKind.get(kind)!
    const bandX = width * (0.5 + ((bandIdx + 1) / (kinds.length + 1)) * 0.45)
    list.forEach((n, i) => {
      const y = (height * (i + 1)) / (list.length + 1)
      map.set(n.id, { x: bandX, y })
    })
  })
  return map
}

function bezierPath(
  a: { x: number; y: number },
  b: { x: number; y: number },
): string {
  const dx = Math.max(40, Math.abs(b.x - a.x) * 0.4)
  return `M ${a.x} ${a.y} C ${a.x + dx} ${a.y}, ${b.x - dx} ${b.y}, ${b.x} ${b.y}`
}

function kindTemplateFor(host: HTMLElement, kind: string): HTMLTemplateElement | null {
  const tpls = host.querySelectorAll('template[slot="node"]')
  for (const t of Array.from(tpls)) {
    if ((t as HTMLElement).dataset.kind === kind) return t as HTMLTemplateElement
  }
  return null
}

function nodeBodyHtml(host: HTMLElement, n: GraphNode): string {
  const tpl = kindTemplateFor(host, n.kind)
  if (!tpl) {
    const sub = n.sub ? `<div class="node-sub">${esc(n.sub)}</div>` : ''
    return `<div class="node-h"><span class="tag">${esc(n.kind)}</span></div><div class="node-title">${esc(n.title ?? n.id)}</div>${sub}`
  }
  return tpl.innerHTML
    .replace(/\$\{title\}/g, esc(n.title ?? ''))
    .replace(/\$\{sub\}/g, esc(n.sub ?? ''))
    .replace(/\$\{id\}/g, esc(n.id))
}

function renderGraphHtml(
  host: HTMLElement,
  nodesRaw: string,
  edgesRaw: string,
  width: number,
  height: number,
  layout: string,
  selectedId: string,
): string {
  const nodes = coerce<GraphNode>(nodesRaw, [])
  const edges = coerce<GraphEdge>(edgesRaw, [])
  const pos = computePositions(nodes, width, height, layout)

  const edgePaths = edges
    .map((e) => {
      const a = pos.get(e.from)
      const b = pos.get(e.to)
      if (!a || !b) return ''
      const d = esc(bezierPath(a, b))
      const dashed = e.dashed ? ' data-dashed' : ''
      return `<path d="${d}" data-kind="${esc(e.kind ?? 'default')}"${dashed}></path>`
    })
    .join('')

  const nodeDivs = nodes
    .map((n) => {
      const p = pos.get(n.id)
      if (!p) return ''
      const left = (p.x / width) * 100
      const top = (p.y / height) * 100
      const sel = selectedId && selectedId === n.id ? ' data-selected' : ''
      const wStyle = n.w ? `--node-w: ${n.w}px;` : ''
      const label = esc(`${n.kind}: ${n.title ?? n.id}`)
      const body = nodeBodyHtml(host, n)
      return `<div class="node" data-kind="${esc(n.kind)}" data-id="${esc(n.id)}"${sel} tabindex="0" role="button" aria-label="${label}" style="left: ${left}%; top: ${top}%;${wStyle}">${body}</div>`
    })
    .join('')

  return (
    `<svg class="edges" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" aria-hidden="true">${edgePaths}</svg>` +
    nodeDivs
  )
}

export default controller<Scope>({
  mount(state, host) {
    const canvas = state.canvasEl as HTMLElement | null
    if (!canvas) return

    const inner = canvas.ownerDocument.createElement('div')
    canvas.appendChild(inner)

    const stopRender = bindHtml(inner, () => {
      const nodesRaw = state.nodes as string
      const edgesRaw = state.edges as string
      const width = (state.width as number) || 1000
      const height = (state.height as number) || 600
      const layout = (state.layout as string) || 'positioned'
      const selectedId = state.selectedId as string
      return renderGraphHtml(host, nodesRaw, edgesRaw, width, height, layout, selectedId)
    })

    let lastHoveredId = ''

    const onClick = (e: MouseEvent) => {
      const node = (e.target as HTMLElement).closest<HTMLElement>('.node[data-id]')
      if (!node) return
      const id = node.getAttribute('data-id') ?? ''
      const kind = node.getAttribute('data-kind') ?? ''
      host.setAttribute('selected-id', id)
      host.dispatchEvent(
        new CustomEvent('sui-node-select', {
          detail: { id, kind },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key !== 'Enter' && e.key !== ' ') return
      const node = (e.target as HTMLElement).closest<HTMLElement>('.node[data-id]')
      if (!node) return
      e.preventDefault()
      const id = node.getAttribute('data-id') ?? ''
      const kind = node.getAttribute('data-kind') ?? ''
      host.setAttribute('selected-id', id)
      host.dispatchEvent(
        new CustomEvent('sui-node-select', {
          detail: { id, kind },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const onMouseOver = (e: MouseEvent) => {
      const node = (e.target as HTMLElement).closest<HTMLElement>('.node[data-id]')
      if (!node) {
        lastHoveredId = ''
        return
      }
      const id = node.getAttribute('data-id') ?? ''
      if (id === lastHoveredId) return
      lastHoveredId = id
      const kind = node.getAttribute('data-kind') ?? ''
      host.dispatchEvent(
        new CustomEvent('sui-node-hover', {
          detail: { id, kind },
          bubbles: true,
          composed: true,
        }),
      )
    }

    canvas.addEventListener('click', onClick)
    canvas.addEventListener('keydown', onKeyDown)
    canvas.addEventListener('mouseover', onMouseOver)

    return () => {
      stopRender()
      canvas.removeEventListener('click', onClick)
      canvas.removeEventListener('keydown', onKeyDown)
      canvas.removeEventListener('mouseover', onMouseOver)
    }
  },
})

</controller>
<div class="canvas" bind:this={canvasEl}></div>
<slot name="node" hidden></slot>
