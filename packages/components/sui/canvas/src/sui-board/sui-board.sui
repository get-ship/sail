<!--
  <sui-board> — SVG-native node/edge/port diagram on the canvas substrate.

  Builds createCanvas() + a board model in the controller. Nodes/edges/ports/
  selection are DOM/SVG (selectable, accessible, token-themeable) — NO canvas
  engine. The board composes <sui-canvas> as its substrate via prop:canvas
  identity and renders its domain layer into the world slot. Edges live in an
  SVG overlay; nodes are absolutely-positioned <div>s carrying a default slot
  for consumer-owned visuals (the board owns geometry, not content).

  Props
  ─────────────────────────────────────────────────────────────────────
  value     (string, '')              SSR/declarative board-JSON FALLBACK
                                        (parsed via JSON.parse). prop:* wins.
  readonly  (bool, false reflect)      Pan/zoom only; no node edits.
  theme     ('light'|'dark' reflect)   Forwarded to the substrate.
  grid      ('none'|'dots'|'lines')    Forwarded background grid hint.
  layout    ('none'|'layered'|'force') Auto-layout algorithm (Slice 7).
  label     (string, '')               → aria-label on the application region.
  ─────────────────────────────────────────────────────────────────────
  Events (host.emit!):
    sui-board-change { value, version } — debounced board mutation.
    sui-node-select  { ids }            — selection changed.
    sui-edge-create  { source, target } — drag-from-port created an edge.
-->

<prop name="value" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="theme" values="light|dark" default="light" reflect />
<prop name="grid" values="none|dots|lines" default="none" reflect />
<prop name="layout" values="none|layered|force" default="none" reflect />
<prop name="label" type="string" default="" />

<sui-canvas
  part="canvas"
  role="application"
  aria-label={label()}
  prop:canvas={canvas}
  prop:readonly={readonly()}
>
  <svg class="edges" part="edges" aria-hidden="true">
    {#for r of routes() key={r.id}}
      <path
        class="edge"
        part="edge"
        d={r.path}
        data-edge-id={r.id}
        data-incident={incidentSet().has(r.id)}
      ></path>
    {/for}
    {#if pendingPath()}
      <path class="edge edge-pending" part="edge-pending" d={pendingPath()}></path>
    {/if}
  </svg>

  {#for n of nodes() key={n.id}}
    <div
      class="node"
      part="node"
      role="group"
      tabindex="0"
      aria-label={n.id}
      data-node-id={n.id}
      data-selected={selectedSet().has(n.id)}
      style={`transform: translate(${n.rect.x}px, ${n.rect.y}px); width: ${n.rect.w}px; height: ${n.rect.h}px;`}
      on:pointerdown={nodePointerDown}
    >
      <slot name={n.id}></slot>
      {#for p of n.ports key={p.id}}
        <span
          class="port"
          part="port"
          data-port-id={p.id}
          data-side={p.side}
          on:pointerdown={portPointerDown}
        ></span>
      {/for}
    </div>
  {/for}
</sui-canvas>
