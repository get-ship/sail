<!--
  <sui-canvas> — the bare pan/zoom/infinite-surface substrate primitive.

  Backbone #3: a viewport + a transformed world layer + a `default` slot for
  arbitrary world-space content. Pan/zoom/coordinate state lives in
  `createCanvas()` (engine/) on @ship/sui-runtime signals — no React, no
  Excalidraw, no SDK. This pack imports @ship/sui-runtime + @ship/sui-dom ONLY.

  Props
  ─────────────────────────────────────────────────────────────────────
  value       (string, '')          SSR/declarative snapshot FALLBACK only
                                     (parsed via JSON.parse in the controller).
                                     prop:* identity supersedes.
  readonly    (bool,  false reflect) Pan/zoom allowed but no edits.
  theme       ('light'|'dark')       Read imperatively off the host.
  grid        ('none'|'dots'|'lines')Background grid render hint.
  min-scale   (number)               Zoom clamp.
  max-scale   (number)               Zoom clamp.
  label       (string, '')           → aria-label on the application region.
  ─────────────────────────────────────────────────────────────────────
  Event: sui-canvas-viewport { transform } — debounced, on pan/zoom change.
-->

<prop name="value" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="theme" values="light|dark" default="light" reflect />
<prop name="grid" values="none|dots|lines" default="none" reflect />
<prop name="min-scale" type="number" />
<prop name="max-scale" type="number" />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: none;
  }
  :host([hidden]) { display: none; }

  .viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
  }

  .world {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
</style>

<div
  class="viewport"
  part="viewport"
  role="application"
  aria-label={label()}
  bind:this={viewportEl}
  on:pointerdown={pointerDown}
  on:pointermove={pointerMove}
  on:pointerup={pointerUp}
  on:wheel={wheel}
>
  <div class="world" part="world" style={transformCss()}>
    <slot></slot>
  </div>
</div>
