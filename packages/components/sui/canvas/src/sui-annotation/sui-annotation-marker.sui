<!--
  <sui-annotation-marker> — SUI port of <ship-annotation-marker>.
  Visual pin or region-box marker for a staged / sent annotation.

  Prop surface
  ──────────────────────────────────────────────────────────────────────────────
  kind   (point|region, 'point', reflect) — which visual form to render
  x      (number, 0)                      — point mode: left offset in px
  y      (number, 0)                      — point mode: top offset in px
  rect   (string, '')                     — region mode: "x,y,w,h" in px
  active (bool, false, reflect)           — highlights the marker
  index  (number, 0)                      — ordinal badge inside point pins
  ──────────────────────────────────────────────────────────────────────────────
  Parts: pin, box
  ──────────────────────────────────────────────────────────────────────────────
  Note: positioning is driven by the controller via inline style on each part.
  CSS hides the inactive part based on [kind] attribute.
-->

<prop name="kind" values="point|region" default="point" reflect />
<prop name="x" type="number" default="0" />
<prop name="y" type="number" default="0" />
<prop name="rect" type="string" default="" />
<prop name="active" type="bool" default="false" reflect />
<prop name="index" type="number" default="0" />

<style>
  :host {
    position: absolute;
    pointer-events: auto;
    font-family: var(--font-body);
    font-size: var(--text-xs);
  }
  :host([hidden]) { display: none; }

  [part='pin'] {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    display: none;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-medium);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transform: translate(-50%, -50%);
    border: 2px solid var(--background);
    transition: filter var(--duration-fast) var(--ease-out);
  }
  :host([kind='point']) [part='pin'] { display: inline-flex; }
  :host([active]) [part='pin'] {
    filter: brightness(1.2);
    outline: 2px solid var(--ring-color);
    outline-offset: 2px;
  }

  [part='box'] {
    position: absolute;
    border: 2px dashed var(--primary);
    background: var(--tone-primary-bg);
    border-radius: var(--radius-sm);
    cursor: pointer;
    box-sizing: border-box;
    display: none;
  }
  :host([kind='region']) [part='box'] { display: block; }
  :host([active]) [part='box'] {
    background: color-mix(in oklch, var(--primary) 14%, transparent);
  }
</style>

<div part="pin" role="button" tabindex="0" bind:this={pinEl}></div>
<div part="box" role="button" tabindex="0" bind:this={boxEl}></div>
