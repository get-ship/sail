<!--
  <sui-annotation-list> — SUI port of <ship-annotation-list>.
  Compact list of staged AnnotationEvents with per-item remove controls.

  API surface
  ──────────────────────────────────────────────────────────────────────────────
  JS property:
    staged: AnnotationEvent[]  — set to re-render the list (not attribute-backed;
                                  set the property directly from the parent layer)
  ──────────────────────────────────────────────────────────────────────────────
  Events:
    sui-annotation-remove  { detail: { id: string } }  bubbles, composed
      Fired when the user clicks Remove on an item.
  ──────────────────────────────────────────────────────────────────────────────
  Parts: list, item, empty
  ──────────────────────────────────────────────────────────────────────────────
  Parity vs <ship-annotation-list>:
    staged property           → staged JS property (same)
    ship-annotation-remove    → sui-annotation-remove (renamed)
    attributeChangedCallback JSON parsing → controller setAttribute interception
-->

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--background);
  }
  .kind {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    min-width: 48px;
  }
  .note {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .empty {
    color: var(--muted-foreground);
    padding: var(--space-1) var(--space-2);
  }
  button {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: var(--text-xs);
    padding: 2px 6px;
  }
  button:hover {
    color: var(--destructive);
    border-color: var(--destructive);
  }
</style>

{#if staged().length === 0}
  <div class="empty" part="empty">No staged annotations.</div>
{:else}
  <ol part="list">
    {#for a of staged() key={a.id}}
      <li part="item" data-id={a.id}>
        <span class="kind">{a.kind}</span>
        <span class="note" title={a.note ?? ''}>{a.note ?? '(no note)'}</span>
        <button type="button" aria-label="Remove annotation" on:click={() => emitRemove(a.id)}>Remove</button>
      </li>
    {/for}
  </ol>
{/if}
