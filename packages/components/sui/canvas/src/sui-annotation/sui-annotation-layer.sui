<!--
  <sui-annotation-layer> — SUI port of <ship-annotation-layer>.
  Framework-agnostic capture overlay. Wraps slotted content, captures pointer
  gestures (point click or region drag), opens an inline note popover, and
  either POSTs each annotation immediately or stages them for batch send().

  Prop surface
  ──────────────────────────────────────────────────────────────────────────────
  view-id   (string, '')              target.view_id on emitted events
  mode      (off|point|region, 'off', reflect)  gesture capture mode
  endpoint  (string, '/api/feedback') override default POST target
  staging   (bool, false, reflect)    batch until send() is called
  ──────────────────────────────────────────────────────────────────────────────
  Events (bubbles, composed):
    sui-annotation-staged  → detail: AnnotationEvent
    sui-annotation-sent    → detail: { id, status }
    sui-annotation-error   → detail: { code, message?, id? }
  ──────────────────────────────────────────────────────────────────────────────
  JS methods (exposed on host by controller):
    send()   — POST all staged items serially
    clear()  — drop all staged items without sending
  JS property:
    staged: AnnotationEvent[]  — current staged array (readonly getter)
  ──────────────────────────────────────────────────────────────────────────────
  Slots: (default) — wraps the annotatable content
  Anatomy: the slotted content sits under a capture overlay (data-state=capture
  while armed); staged annotations render as <sui-annotation-marker> children.
  ──────────────────────────────────────────────────────────────────────────────
  Parity vs <ship-annotation-layer>:
    view-id, mode, endpoint, staging attrs  → identical
    ship-annotation-staged/sent/error       → sui-annotation-staged/sent/error
    send(), clear()                         → identical
-->

<scope>
  props: {
    'view-id' = ''
    mode: 'off' | 'point' | 'region' = 'off'
    endpoint = '/api/feedback'
    staging = false
  }
</scope>
<controller>
import { controller, signal, derived, ref } from '@ship/sail-runtime'
import type { ViewScope } from '@ship/sail-runtime'
import type { Scope } from './sui-annotation-layer.sui'
import { type AnnotationEvent, buildAnnotationEvent } from './sui-annotation.internals'

type Mode = 'off' | 'point' | 'region'

interface Pending {
  kind: 'point' | 'region'
  x: number
  y: number
  selector?: string
  rect?: [number, number, number, number]
}

interface Drag {
  startX: number
  startY: number
  curX: number
  curY: number
}

const DEFAULT_ENDPOINT = '/api/feedback'

export default controller((props: ViewScope<Scope>, _host?: Element) => {
    const viewIdProp = props.viewId
    const endpointProp = props.endpoint
    const stagingProp = props.staging

    const staged = signal<AnnotationEvent[]>([])
    const pending = signal<Pending | null>(null)
    const drag = signal<Drag | null>(null)
    const noteText = signal('')

    // The host element is not present in the scope factory (the post-
    // convergence "SUI names no host" compile stops passing it as the 2nd
    // arg), so read it through this signal — set in `mount` once the
    // runtime hands over the real element. The `sendOne` / `confirmNote`
    // closures below emit `sui-annotation-{staged,sent,error}` on the host,
    // so they must read the host from this signal, not the dead scope arg.
    const hostEl = signal<HTMLElement | null>(null)

    const _positions: Record<string, { x: number; y: number }> = {}

    const dragVisible = derived(() => {
      const d = drag()
      if (!d) return false
      return Math.abs(d.curX - d.startX) > 4 || Math.abs(d.curY - d.startY) > 4
    })

    // Overlay-px geometry of the live drag; the template binds it onto the
    // rubber-band rect through the style: channel (runtime geometry).
    // `dragVisible` gates the rect, so the resting value is a zero box.
    const dragRect = derived(() => {
      const d = drag()
      if (!d) return { x: 0, y: 0, w: 0, h: 0 }
      return {
        x: Math.min(d.startX, d.curX),
        y: Math.min(d.startY, d.curY),
        w: Math.abs(d.curX - d.startX),
        h: Math.abs(d.curY - d.startY),
      }
    })

    // The note popover sits just below-right of the captured point, clamped so
    // a wild coordinate can't fling it out of the document. `pending` gates it.
    const popoverPos = derived(() => {
      const p = pending()
      if (!p) return { left: 0, top: 0 }
      return { left: Math.min(p.x + 12, 10_000), top: Math.min(p.y + 12, 10_000) }
    })

    // `off` leaves the overlay inert; point/region arm it for capture.
    const captureState = derived(() => (props.mode() === 'off' ? '' : 'capture'))

    const markers = derived(() =>
      staged().map((a, i) => ({
        id: a.id,
        kind: a.kind,
        index: i,
        rect: a.kind === 'region' && a.target.rect ? a.target.rect.join(',') : '',
        pos: _positions[a.id] ?? { x: 0, y: 0 },
      })),
    )

    async function sendOne(ev: AnnotationEvent): Promise<void> {
      const ep = endpointProp() || DEFAULT_ENDPOINT
      try {
        const resp = await fetch(ep, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(ev),
        })
        if (!resp.ok) {
          hostEl()?.dispatchEvent(
            new CustomEvent('sui-annotation-error', {
              detail: { code: `http_${resp.status}`, id: ev.id },
              bubbles: true,
              composed: true,
            }),
          )
          return
        }
        staged.set(staged().filter((s) => s.id !== ev.id))
        hostEl()?.dispatchEvent(
          new CustomEvent('sui-annotation-sent', {
            detail: { id: ev.id, status: resp.status },
            bubbles: true,
            composed: true,
          }),
        )
      } catch (e) {
        hostEl()?.dispatchEvent(
          new CustomEvent('sui-annotation-error', {
            detail: { code: 'network_error', message: String(e), id: ev.id },
            bubbles: true,
            composed: true,
          }),
        )
      }
    }

    function confirmNote(note: string): void {
      const p = pending()
      if (!p) return
      const trimmed = note.trim()
      if (!trimmed) {
        pending.set(null)
        noteText.set('')
        return
      }
      const ev = buildAnnotationEvent({
        viewId: viewIdProp() || undefined,
        kind: p.kind,
        selector: p.kind === 'point' ? p.selector : undefined,
        rect: p.kind === 'region' ? p.rect : undefined,
        note: trimmed,
      })
      _positions[ev.id] = { x: p.x, y: p.y }
      staged.set([...staged(), ev])
      hostEl()?.dispatchEvent(
        new CustomEvent('sui-annotation-staged', {
          detail: ev,
          bubbles: true,
          composed: true,
        }),
      )
      pending.set(null)
      noteText.set('')
      if (!stagingProp()) void sendOne(ev)
    }

    const sendNote = (): void => {
      confirmNote(noteText())
    }

    const cancelPending = (): void => {
      pending.set(null)
      noteText.set('')
    }

    const onNoteKeydown = (e: KeyboardEvent): void => {
      if (e.key === 'Escape') {
        cancelPending()
      } else if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
        const ta = e.currentTarget as HTMLTextAreaElement
        confirmNote(ta.value)
      }
    }

    const overlayEl = ref<HTMLDivElement>(null)

    mount((host) => {
      // The runtime hands the real host element here. The scope's `sendOne`
      // and `confirmNote` closures read through `hostEl` (the dead-`host`
      // workaround) — publish the element now that it exists, before the
      // first user gesture can fire.
      hostEl.set(host as HTMLElement)

      let _drag: Drag | null = null
      let _raf: number | null = null

      const overlayPos = (e: PointerEvent): { x: number; y: number } => {
        const el = overlayEl() as HTMLElement | null
        if (!el) return { x: 0, y: 0 }
        const r = el.getBoundingClientRect()
        return { x: e.clientX - r.left, y: e.clientY - r.top }
      }

      const onPointerDown = (e: PointerEvent): void => {
        const m = props.mode() as Mode
        if (m === 'off') return
        const t = e.target as HTMLElement
        if (t.closest('[data-annotation-popover]') || t.closest('sui-annotation-marker')) return
        if (pending()) {
          pending.set(null)
          noteText.set('')
          return
        }
        e.preventDefault()
        const p = overlayPos(e)
        _drag = { startX: p.x, startY: p.y, curX: p.x, curY: p.y }
        drag.set(_drag)
        ;(e.target as Element).setPointerCapture?.(e.pointerId)
      }

      const onPointerMove = (e: PointerEvent): void => {
        if (!_drag) return
        const p = overlayPos(e)
        _drag = { ..._drag, curX: p.x, curY: p.y }
        if (_raf !== null) return
        _raf = requestAnimationFrame(() => {
          _raf = null
          if (_drag) drag.set({ ..._drag })
        })
      }

      const onPointerUp = (e: PointerEvent): void => {
        if (!_drag) return
        const p = overlayPos(e)
        const dx = Math.abs(p.x - _drag.startX)
        const dy = Math.abs(p.y - _drag.startY)
        const m = props.mode() as Mode
        let next: Pending | null = null
        if (m === 'point' || (m === 'region' && dx < 8 && dy < 8)) {
          next = { kind: 'point', x: p.x, y: p.y, selector: 'body' }
        } else if (m === 'region') {
          const x = Math.min(_drag.startX, p.x)
          const y = Math.min(_drag.startY, p.y)
          const rect: [number, number, number, number] = [
            Math.round(x),
            Math.round(y),
            Math.round(dx),
            Math.round(dy),
          ]
          next = { kind: 'region', x: x + dx / 2, y: y + dy / 2, rect }
        }
        _drag = null
        drag.set(null)
        noteText.set('')
        if (next) pending.set(next)
      }

      const overlayNode = overlayEl() as HTMLElement | null
      if (overlayNode) {
        overlayNode.addEventListener('pointerdown', onPointerDown)
        overlayNode.addEventListener('pointermove', onPointerMove)
        overlayNode.addEventListener('pointerup', onPointerUp)
      }

      Object.defineProperty(host, 'staged', {
        configurable: true,
        get: () => staged(),
      })

      type LayerHost = HTMLElement & {
        send: () => Promise<void>
        clear: () => void
      }
      ;(host as LayerHost).send = async () => {
        for (const ev of [...staged()]) await sendOne(ev)
      }
      ;(host as LayerHost).clear = () => {
        staged.set([])
      }

      return () => {
        if (_raf !== null) {
          cancelAnimationFrame(_raf)
          _raf = null
        }
        if (overlayNode) {
          overlayNode.removeEventListener('pointerdown', onPointerDown)
          overlayNode.removeEventListener('pointermove', onPointerMove)
          overlayNode.removeEventListener('pointerup', onPointerUp)
        }
      }
    })

    return {
      staged,
      pending,
      drag,
      noteText,
      dragVisible,
      dragRect,
      popoverPos,
      captureState,
      markers,
      overlayEl,
      confirmNote,
      sendNote,
      cancelPending,
      onNoteKeydown,
      sendOne,
      hostEl,
    }
  })

</controller>
<div sx="relative w-full h-full font-body">
  <slot></slot>
  <div bind:this={overlayEl} data-state={captureState()} sx="absolute top-0 right-0 bottom-0 left-0 z-dropdown pointer-events-none state-capture:pointer-events-auto">
    {#if dragVisible()}
      <div
        aria-hidden="true"
        use:rect={dragRect()}
        sx="absolute left-(--box-left) top-(--box-top) w-(--box-w) h-(--box-h) pointer-events-none bg-tone-primary-bg border border-primary border-dashed rounded-sm"
      ></div>
    {/if}
    {#for m of markers() key={m.id}}
      <sui-annotation-marker
        prop:kind={m.kind}
        prop:index={m.index}
        prop:rect={m.rect}
        prop:x={m.pos.x}
        prop:y={m.pos.y}
      ></sui-annotation-marker>
    {/for}
    {#if pending()}
      <column
        data-annotation-popover
        gap="2"
        use:rect={popoverPos()}
        on:pointerdown={(e) => e.stopPropagation()}
        sx="absolute left-(--box-left) top-(--box-top) z-sticky min-w-panel-min-w-md p-2 bg-popover text-popover-foreground border border-border rounded-md shadow-lg pointer-events-auto"
      >
        <textarea placeholder="Add a note…" bind:value={noteText} on:keydown={onNoteKeydown} sx="w-full rounded-sm"></textarea>
        <row gap="2" justify="end">
          <button type="button" on:click={cancelPending} sx="text-sm px-2_5 rounded-sm cursor-pointer">Cancel</button>
          <button type="button" data-primary variant="solid" tone="primary" on:click={sendNote} sx="text-sm px-2_5 rounded-sm cursor-pointer">Send</button>
        </row>
      </column>
    {/if}
  </div>
</div>
