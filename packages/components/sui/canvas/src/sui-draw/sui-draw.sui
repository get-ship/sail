<!--
  <sui-draw> — an Excalidraw-class whiteboard, OWNED on the canvas substrate.

  Builds createCanvas() + an owned scene model in the controller. Strokes /
  shapes / arrows / text live as DOM/SVG paths (selectable, accessible,
  token-themeable) — NO canvas engine. Pen outlines come from vendored
  perfect-freehand; the optional hand-drawn aesthetic from vendored roughjs
  (the rough-adapter is the sole importer). The whiteboard composes
  <sui-canvas> as its substrate via prop:canvas identity and renders its scene
  into the world layer; selection/transform are an SVG overlay.

  This REPLACES the deleted React + Excalidraw bridge. v1 ships owned
  SVG-native strokes + shapes + selection + move + undo/redo. Resize/rotate
  transform handles are not implemented — the scene is intentionally
  SVG-native (no canvas scene-graph engine), so when they land they will be
  SVG-overlay handles driven by the scene model, not a vendored canvas lib.

  Props
  ─────────────────────────────────────────────────────────────────────
  value     (string, '')                       SSR scene-JSON FALLBACK
                                                  (JSON.parse). prop:* wins.
  readonly  (bool, false reflect)               Pan/zoom only; no edits.
  theme     ('light'|'dark' reflect)            Forwarded to the substrate.
  grid      ('none'|'dots'|'lines')             Forwarded background grid hint.
  tool      ('select'|'pan'|'pen'|'rect'|       Active tool (reflect).
             'ellipse'|'arrow'|'line'|'text')
  sketchy   (bool, false reflect)               Hand-drawn aesthetic (roughjs).
  label     (string, '')                        → aria-label on the region.
  ─────────────────────────────────────────────────────────────────────
  Events (host.emit!):
    sui-draw-change { value, version } — debounced 200ms scene mutation.
    sui-draw-select { ids }            — selection changed.
-->

<prop name="value" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="theme" values="light|dark" default="light" reflect />
<prop name="grid" values="none|dots|lines" default="none" reflect />
<prop name="tool" values="select|pan|pen|rect|ellipse|arrow|line|text" default="select" reflect />
<prop name="sketchy" type="bool" default="false" reflect />
<prop name="label" type="string" default="" />

<div class="toolbar" part="toolbar" role="toolbar" aria-label="Drawing tools">
  <slot name="toolbar"></slot>
</div>

<sui-canvas
  part="canvas"
  role="application"
  aria-label={label()}
  prop:canvas={canvas}
  prop:readonly={readonly()}
  on:pointerdown={surfaceDown}
>
  <svg class="scene" part="scene" role="group" aria-label={statusLabel()}>
    {#for el of rendered() key={el.id}}
      {#if el.kind === 'text'}
        <text
          class="el el-text"
          part="element"
          x={el.at.x}
          y={el.at.y}
          fill={el.color}
          data-el-id={el.id}
          data-selected={selectedSet().has(el.id)}
          on:pointerdown={elementDown}
        >{el.text}</text>
      {:else}
        <path
          class="el"
          part="element"
          d={el.path}
          data-el-id={el.id}
          data-kind={el.kind}
          data-selected={selectedSet().has(el.id)}
          style={`stroke: ${el.color};`}
          on:pointerdown={elementDown}
        ></path>
      {/if}
    {/for}

    {#if draftPath()}
      <path class="el el-draft" part="draft" d={draftPath()} style={`stroke: ${draftColor()};`}></path>
    {/if}

    {#if selectionRect()}
      <rect
        class="selection-box"
        part="selection-box"
        x={selectionRect().x}
        y={selectionRect().y}
        width={selectionRect().w}
        height={selectionRect().h}
      ></rect>
    {/if}
  </svg>
</sui-canvas>

<div class="status" part="status" role="status" aria-live="polite">{statusLabel()}</div>
