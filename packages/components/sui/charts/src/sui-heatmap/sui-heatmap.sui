<!--
  <sui-heatmap> — 2D grid of SVG rect cells, intensity-colored.

  MIGRATED onto the createChartData engine + cellGeometry helper: 1D-comma /
  2D-JSON `data` decodes through `normalizeSeries` (reshaped into rows by the
  rows/cols labels), cells are a pure `derived` over `cellGeometry` (present at
  first paint), and empty / loading branch on the engine discriminators
  composing the full-size primitives (heatmap is full-size despite being compact).

  TOKEN CLEANUP: the controller-built `color-mix(in oklch,…)` string is GONE —
  each cell fills with the tone role token `var(--<tone>)` and drives intensity
  via `fill-opacity` bound from the normalized value (0..1). This is the only
  token-clean continuous-intensity path; a null/zero cell renders empty
  (fill-opacity 0). Cells expose `part="cell"`.

  Props
  ─────────────────────────────────────────────────────────────────────────────
  data       string  reflect   1D comma nums OR JSON [[row],[row]]; prop:series
                               identity supersedes (normalizeSeries handles both).
  rows       string             comma-separated y labels (shapes the grid).
  cols       string             comma-separated x labels (shapes the grid).
  tone       union   reflect    cell base hue (toneColor role-token map).
  cell-size  number  20         px per cell.
  gap        number  3          px between cells.
  label      string  "heatmap"  aria-label kind (prefixes the data summary).
  loading    bool    reflect    loading branch (engine isLoading) → sui-skeleton.
  error      —       prop:error identity-only → sui-error-state.
  ─────────────────────────────────────────────────────────────────────────────
  Slots: description (described-data override)
  Parts: cell
-->

<prop name="data" type="string" default="" reflect />
<prop name="rows" type="string" default="" />
<prop name="cols" type="string" default="" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="primary" reflect />
<prop name="cell-size" type="number" default="20" />
<prop name="gap" type="number" default="3" />
<prop name="label" type="string" default="heatmap" />
<prop name="loading" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-block;
    font-family: var(--font-body);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; overflow: visible; }
  .a11y-table {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
  }
</style>

{#if loading()}
  <span skeleton shape="block" size="lg" part="loading" role="status" aria-label="Loading" aria-live="polite" aria-busy="true"></span>
{:else if chart.error()}
  <sui-error-state part="error"></sui-error-state>
{:else if chart.isEmpty()}
  <sui-empty-state part="empty"></sui-empty-state>
{:else}
  <svg
    viewBox={'0 0 ' + svgW() + ' ' + svgH()}
    role="img"
    aria-label={ariaLabel()}
    aria-describedby="chart-data">
    {#for cell of cells() key={cell.id}}
      <rect
        part="cell"
        x={cell.x}
        y={cell.y}
        width={cell.w}
        height={cell.h}
        rx="2"
        fill={cell.color}
        fill-opacity={cell.intensity}>
      </rect>
    {/for}
  </svg>
  <div class="a11y-table" id="chart-data">
    <slot name="description">
      <table>
        {#for row of chart.ariaTable() key={row[0].text}}
          <tr>
            {#for c of row key={c.text}}
              <td>{c.text}</td>
            {/for}
          </tr>
        {/for}
      </table>
    </slot>
  </div>
{/if}
