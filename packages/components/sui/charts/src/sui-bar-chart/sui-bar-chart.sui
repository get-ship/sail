<!--
  <sui-bar-chart> — vertical or horizontal categorical bar chart, SVG-rendered.

  MIGRATED onto the createChartData engine + createChartViewport adapter: the
  comma-string `data` decodes through `normalizeSeries`, bars are a pure
  `derived` (present at first paint), the ad-hoc `isEmpty` signal is replaced by
  the engine discriminator composing `sui-empty-state`, loading composes
  `sui-skeleton`, and the `max=0`→auto domain convention is preserved by the
  engine extent. Bars expose `part="series"`; the viewBox tracks the measured box.

  Props
  ─────────────────────────────────────────────────────────────────────────────
  data         string  reflect    comma-separated numbers (normalizeSeries).
  labels       string             used as <title> per bar.
  tone         union   reflect    series color (toneColor role-token map).
  orientation  union   reflect    vertical | horizontal.
  width        number  300        initial estimate — measured box drives render.
  height       number  200        same.
  max          number  0          0 = auto (engine extent yMax-null semantics).
  label        string  "bar chart"  aria-label kind (prefixes the data summary).
  loading      bool    reflect    loading branch (engine isLoading) → sui-skeleton.
  error        —       prop:error identity-only → sui-error-state.
  ─────────────────────────────────────────────────────────────────────────────
  Slots: description (described-data override)
  Parts: series
-->

<prop name="data" type="string" default="" reflect />
<prop name="labels" type="string" default="" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="primary" reflect />
<prop name="orientation" values="vertical|horizontal" default="vertical" reflect />
<prop name="width" type="number" default="300" />
<prop name="height" type="number" default="200" />
<prop name="max" type="number" default="0" />
<prop name="label" type="string" default="bar chart" />
<prop name="loading" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    width: 100%;
    height: 200px;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; width: 100%; height: 100%; overflow: hidden; }
  /* Hover-brighten: bars rest slightly dimmed and lift to full on hover
     for at-a-glance focus, matching the elevated bar treatment. */
  .bar { opacity: 0.85; transition: opacity var(--duration-fast) var(--ease-out); }
  .bar:hover { opacity: 1; }
  .a11y-table {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
    .bar { transition: none; }
  }
</style>

{#if loading()}
  <sui-skeleton shape="block" size="lg" part="loading"></sui-skeleton>
{:else if chart.error()}
  <sui-error-state part="error"></sui-error-state>
{:else if chart.isEmpty()}
  <sui-empty-state part="empty"></sui-empty-state>
{:else}
  <svg
    viewBox={'0 0 ' + viewport.width() + ' ' + viewport.height()}
    role="img"
    aria-label={ariaLabel()}
    aria-describedby="chart-data"
    bind:this={svgEl}>
    {#for b of bars() key={b.id}}
      <rect class="bar" part="series" x={b.x} y={b.y} width={b.w} height={b.h} rx={b.rx} ry={b.ry} fill={b.color}>
        <title>{b.title}</title>
      </rect>
    {/for}
  </svg>
  <div class="a11y-table" id="chart-data">
    <slot name="description">
      <table>
        {#for row of chart.ariaTable() key={row[0].text}}
          <tr>
            {#for cell of row key={cell.text}}
              <td>{cell.text}</td>
            {/for}
          </tr>
        {/for}
      </table>
    </slot>
  </div>
{/if}
