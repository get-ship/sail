<!--
  <sui-gauge> — single-value 270° arc gauge with optional tone thresholds.

  MIGRATED onto the createChartData engine + gaugeGeometry helper: the track +
  value arc + threshold color are a pure `derived` over `gaugeGeometry` (present
  at first paint), and loading / error branch on the engine discriminators
  composing the full-size primitives (gauge is full-size despite being compact).
  The value arc carries `part="fill"`; the track `part="track"`.

  Props
  ─────────────────────────────────────────────────────────────────────────────
  value           number  reflect   the measured value (default 0).
  min             number  0         domain floor.
  max             number  100       domain ceiling.
  tone            union   reflect   explicit arc color; empty = resolve from thresholds.
  low-threshold   number  0         0 = unset (below → destructive).
  high-threshold  number  0         0 = unset (below → warning, above → success).
  size            number  140       outer diameter.
  thickness       number  12        arc stroke width.
  label           string  "gauge"   aria-label kind (prefixes the data summary).
  loading         bool    reflect   loading branch (engine isLoading) → sui-skeleton.
  error           —       prop:error identity-only → sui-error-state.
  ─────────────────────────────────────────────────────────────────────────────
  Slots: (default) center label
  Parts: track · fill
-->

<prop name="value" type="number" default="0" reflect />
<prop name="min" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="" reflect />
<prop name="low-threshold" type="number" default="0" />
<prop name="high-threshold" type="number" default="0" />
<prop name="size" type="number" default="140" />
<prop name="thickness" type="number" default="12" />
<prop name="label" type="string" default="gauge" />
<prop name="loading" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-block;
    position: relative;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; }
  .track { stroke: var(--muted); }
  .gauge-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--heading-font);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-xl);
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
  }
</style>

{#if loading()}
  <span skeleton shape="circle" size="lg" part="loading" role="status" aria-label="Loading" aria-live="polite" aria-busy="true"></span>
{:else if chart.error()}
  <sui-error-state part="error"></sui-error-state>
{:else}
  <svg
    viewBox={'0 0 ' + size() + ' ' + size()}
    role="img"
    aria-label={ariaLabel()}
    style={'width:' + size() + 'px;height:' + size() + 'px'}>
    <path
      class="track"
      part="track"
      d={arc().trackD}
      fill="none"
      stroke-width={thickness()}
      stroke-linecap="round">
    </path>
    {#if arc().fillD}
      <path
        part="fill"
        d={arc().fillD}
        fill="none"
        stroke={arc().color}
        stroke-width={thickness()}
        stroke-linecap="round">
      </path>
    {/if}
  </svg>
  <div class="gauge-label"><slot></slot></div>
{/if}
