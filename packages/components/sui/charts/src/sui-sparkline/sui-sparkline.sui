<!--
  <sui-sparkline> — compact inline trend line, SVG-rendered.

  MIGRATED onto the createChartData engine + createChartViewport adapter: the
  comma-string `data` decodes through `normalizeSeries`, geometry is a pure
  `derived` (present at first paint), and a null comma slot splits the stroke per
  the gap contract. Sparkline is the ONE lightweight presentation exception —
  loading composes `sui-spinner` (skeleton is too heavy inline) and empty stays
  the `aria-hidden` empty SVG (no full-size `sui-empty-state`).

  Props
  ─────────────────────────────────────────────────────────────────────────────
  data     string  reflect   comma-separated numbers (normalizeSeries); prop:series
                             identity supersedes (normalizeSeries handles both).
  tone     union   reflect   line color (toneColor role-token map).
  width    number  80        initial estimate — measured box drives the render.
  height   number  20        same.
  fill     bool    reflect   fill the area under the line at 18% alpha.
  label    string  "sparkline"  aria-label kind (prefixes the data summary).
  loading  bool    reflect   loading branch (engine isLoading) → sui-spinner.
  ─────────────────────────────────────────────────────────────────────────────
  Slots: none
  Parts: series
-->

<prop name="data" type="string" default="" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="primary" reflect />
<prop name="width" type="number" default="80" />
<prop name="height" type="number" default="20" />
<prop name="fill" type="bool" default="false" reflect />
<prop name="label" type="string" default="sparkline" />
<prop name="loading" type="bool" default="false" reflect />

<style>
  :host {
    --sui-sparkline-w: auto;
    --sui-sparkline-h: 40px;
    display: inline-block;
    width: var(--sui-sparkline-w);
    height: var(--sui-sparkline-h);
    line-height: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; overflow: visible; }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
  }
</style>


<controller>
import { controller, derived, ref } from '@ship/sui-runtime'
import { createChartData } from '../engine/create-chart-data'
import { createChartViewport } from '../engine/create-chart-viewport'
import { normalizeSeries } from '../engine/normalize'
import { areaGeometry } from '../engine/geometry-cartesian'
import { toneColor } from '../chart-util'
import type { Scope } from './sui-sparkline.sui'

// `error` arrives via `prop:error={…}` identity (no decodable <prop> for
// `unknown`); read off the host in `mount` and patch the engine.
interface SparkHost extends Element {
  error?: unknown
}

export default controller({
  scope: ({ data, tone, width, height, label, loading }: Scope) => {
    const svgEl = ref<SVGSVGElement>(null) // bind:this target → viewport observe
    const viewport = createChartViewport({
      initialWidth: width(),
      initialHeight: height(),
    })
    const chart = createChartData({
      series: derived(() => normalizeSeries(data())),
      isLoading: loading,
    })

    // GEOMETRY IS A PURE DERIVED — areaGeometry yields both fillD + strokeD so
    // one derivation serves the fill-on and fill-off template branches. The
    // single series' tone overrides the comma-string default (toneColor map).
    const seriesPaths = derived(() => {
      const t = tone()
      return areaGeometry(chart.normalized(), {
        w: viewport.width(),
        h: viewport.height(),
      }).map((p) => ({ ...p, color: toneColor(t) }))
    })
    const ariaLabel = derived(() => `${label()}: ${chart.ariaSummary()}`)

    return { chart, viewport, svgEl, seriesPaths, ariaLabel }
  },
  mount(state, host) {
    if (state.svgEl) state.viewport.observe(state.svgEl)
    const err = (host as SparkHost).error
    if (err !== undefined) state.chart.setOptions({ error: err })
    return () => state.viewport.dispose()
  },
})

</controller>
{#if loading()}
  <spinner part="loading"></spinner>
{:else if chart.isEmpty()}
  <svg
    viewBox={'0 0 ' + viewport.width() + ' ' + viewport.height()}
    width={viewport.width()}
    height={viewport.height()}
    aria-hidden="true">
  </svg>
{:else}
  <svg
    viewBox={'0 0 ' + viewport.width() + ' ' + viewport.height()}
    width={viewport.width()}
    height={viewport.height()}
    role="img"
    aria-label={ariaLabel()}
    bind:this={svgEl}>
    {#for s of seriesPaths() key={s.name}}
      {#if fill()}
        <path d={s.fillD} fill={s.color} fill-opacity="0.18" stroke="none"></path>
      {/if}
      <path
        part="series"
        d={s.strokeD}
        fill="none"
        stroke={s.color}
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round">
      </path>
    {/for}
  </svg>
{/if}
