<!--
  <sui-code-editor> — SUI primitive, framework-pure. CodeMirror 6 wrapped as a
  lazy-loaded web-component. Drop-in for any code-editing surface in sui-site
  (or any SUI app) without depending on the ship platform.

  Prop / event parity
  ───────────────────────────────────────────────────────────────────────────
  value (string, '', form-value)   controlled text contents
  language (string, '')            dynamic-imported extension on assignment
  placeholder (string)             empty-state copy
  readonly (bool, false, reflect)  drop all editor interactions
  line-numbers (bool, true, reflect)
  size (sm|md|lg, md, reflect)     controls font-size + line-height
  tone (default|info|success|warning|destructive, default, reflect)
  theme (light|dark|auto, auto, reflect)
  ───────────────────────────────────────────────────────────────────────────
  sui-change              debounced 150ms `value` updates
  sui-save                Mod-s saves (host-bound events)
  sui-cancel              Escape cancels pending save
  input                   native bubbling change event
  ───────────────────────────────────────────────────────────────────────────
  host.setDiagnostics()   imperative API for compiler-error squiggles
  host.focus()            imperative focus
  ───────────────────────────────────────────────────────────────────────────
-->

<prop name="value" type="string" default="" form-value />
<prop name="language" type="string" default="" />
<prop name="placeholder" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="line-numbers" type="bool" default="true" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|info|success|warning|destructive" default="default" reflect />
<prop name="theme" values="light|dark|auto" default="auto" reflect />
<prop name="wasm-url" type="string" default="/sui_compiler_bg.wasm" />

<style>
  :host {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  :host([hidden]) { display: none; }
  :host([size="sm"]) { font-size: var(--text-xs); line-height: 1.5; }
  :host([size="lg"]) { font-size: var(--text-base); line-height: 1.7; }

  :host([tone="info"])        { --ring-color: var(--tone-info-border); }
  :host([tone="success"])     { --ring-color: var(--tone-success-border); }
  :host([tone="warning"])     { --ring-color: var(--tone-warning-border); }
  :host([tone="destructive"]) { --ring-color: var(--tone-destructive-border); }

  :host(:focus-within) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .editor-root {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .editor-root .cm-editor { height: 100%; }
  .editor-root .cm-scroller { overflow: auto; }

  @media (forced-colors: active) {
    :host { outline: 1px solid CanvasText; }
  }
</style>

<div
  class="editor-root"
  part="editor"
  bind:this={editorHost}
></div>
