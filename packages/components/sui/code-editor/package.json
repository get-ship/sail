{
  "name": "@ship/sui-code-editor",
  "version": "0.1.0",
  "description": "SUI code-editor pack — <sui-code-editor> (CodeMirror 6), framework-pure (no ship-platform deps). Drop-in successor to <ship-code-editor> for sui-site public surfaces.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "deck": {
    "bundles": [
      {
        "name": "sui-code-editor",
        "entry": "src/index.ts",
        "externals": [
          "@ship/sui-runtime",
          "@ship/sui-dom"
        ],
        "lazy": true
      }
    ]
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-lsp-browser": "workspace:*",
    "@ship/sui-primitives": "workspace:*",
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1"
  }
}
