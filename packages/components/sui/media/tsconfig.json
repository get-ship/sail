{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    // Controllers do `import type { Scope } from './<stem>.sui'`. The
    // sui-compiler emits `<stem>.sui.d.ts` into the project mirror tree
    // at `<repo-root>/.ship/sui-out/<src-rel>/`. `rootDirs` lets tsc
    // treat the source tree and its mirror as a single virtual root for
    // relative module resolution.
    "rootDirs": [
      "src",
      "../../../../.ship/sui-out/packages/components/sui/media/src"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["test", "dist"]
}
