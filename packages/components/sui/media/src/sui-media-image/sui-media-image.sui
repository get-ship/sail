<!--
  <sui-media-image> — the raster + SVG image renderer arm of the sui-media
  family (Backbone #2 — ViewerRenderer).

  Read-only, source-in-never-fetch. A resolved source arrives via `prop:src`
  identity (a raster object-url/bytes, or SVG text the consumer already fetched)
  — NEVER an attribute, NEVER a fetch. A raster source paints into the native
  <img part="img"> (whose `load`/`error` drive the lifecycle events) inside a
  `part="stage"` zoom/pan surface. An SVG TEXT source inlines through `bindHtml`
  into a sandboxed `role="img"` container (no raster <img>, no innerHTML in the
  controller). A `gallery` source array renders a `role="listbox"` thumbnail
  strip with arrow-key navigation.

  Density is the platform axis (`<html data-density>`): this renderer is NOT
  row-shaped and exposes NEITHER `density` NOR `dense`.

  Props (build-spec §Props):
    alt       string                    reflect — the real accessible name (<img alt> / SVG aria-label)
    fit       contain|cover|actual      reflect — object-fit
    zoomable  bool, true                reflect — wheel/keyboard zoom + pan
    gallery   bool, false               reflect — multi-image strip (sources via prop:src array)

  Events (ViewerRenderer contract, via emit):
    sui-viewer-load              — first successful raster load / SVG inline
    sui-viewer-error {message}   — raster decode failure
    sui-viewer-zoom {scale}      — wheel/keyboard zoom
    sui-viewer-index-change {index} — gallery arrow-navigation

  Parts: img · stage · thumb.
-->

<prop name="alt" type="string" default="" reflect />
<prop name="fit" values="contain|cover|actual" default="contain" reflect />
<prop name="zoomable" type="bool" default="true" reflect />
<prop name="gallery" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    width: 100%;
    color: var(--foreground);
    /* Thumbnail edge — a fixed gallery-strip dimension (not a row metric). */
    --sui-thumb-size: 3rem;
  }
  :host([hidden]) { display: none; }

  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    overflow: hidden;
    /* Checkerboard transparency matte — reveals image alpha (PNG/SVG)
       against a neutral surface instead of a flat fill. */
    background-color: var(--surface-1);
    background-image: repeating-conic-gradient(
      color-mix(in oklch, var(--foreground) 5%, transparent) 0% 25%,
      transparent 0% 50%);
    background-size: 22px 22px;
    border-radius: var(--radius-md);
    outline: none;
  }

  img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  :host([fit='cover']) img { object-fit: cover; }
  :host([fit='actual']) img { object-fit: none; }

  .svg-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .svg-stage svg { max-width: 100%; height: auto; }

  .strip {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2);
    overflow-x: auto;
    list-style: none;
    margin: 0;
  }
  .thumb {
    flex: 0 0 auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0;
    background: var(--surface-1);
    cursor: pointer;
    overflow: hidden;
  }
  .thumb[aria-selected='true'] {
    border-color: var(--primary);
    box-shadow: var(--shadow-accent);
  }
  .thumb img { width: var(--sui-thumb-size); height: var(--sui-thumb-size); object-fit: cover; }

  @media (prefers-reduced-motion: reduce) {
    img { transition: none; }
  }
</style>

{#if isSvg()}
  <div class="svg-stage" part="stage" role="img" aria-label={alt()}>
    <span bind:this={svgEl}></span>
  </div>
{:else}
  <div class="stage" part="stage" tabindex="0" bind:this={stageEl}>
    <img part="img" alt={alt()} bind:this={imgEl} />
  </div>
  {#if isGallery()}
    <ul class="strip" part="strip" role="listbox" aria-label="Image gallery" bind:this={stripEl}>
      {#for item of galleryItems() key={item.id}}
        <li
          class="thumb"
          part="thumb"
          role="option"
          aria-selected={item.selected ? 'true' : 'false'}
        ><img src={item.url} alt="" /></li>
      {/for}
    </ul>
  {/if}
{/if}
