<!--
  <sui-markdown> — SUI port of <ship-markdown>.
  Minimal inline markdown renderer. Supports: headings, lists,
  fenced code blocks, inline code, links, bold, italic, paragraphs,
  blockquotes. Uses a bundled parser (no external dep).

  Prop parity vs <ship-markdown>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  value (String, '')           value (string, reflect)  ✓ markdown source
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  (no slots)                   (no slots)               ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="value" type="string" default="" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-tracking);
    line-height: var(--leading-tight);
    margin: var(--space-5) 0 var(--space-2);
  }
  h1 { font-size: var(--text-2xl); line-height: 1.25; margin-top: var(--space-6); margin-bottom: var(--space-3); }
  h2 { font-size: var(--text-xl); line-height: 1.25; margin-top: var(--space-6); margin-bottom: var(--space-3); }
  h3 { font-size: var(--text-lg); margin-top: var(--space-5); margin-bottom: var(--space-2); }
  h4, h5, h6 { font-size: var(--text-md); }
  p { margin: var(--space-3) 0; }
  a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: var(--selected-border);
    text-underline-offset: 2px;
  }
  a:hover { text-decoration-color: var(--primary); }
  code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
  }
  pre {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    line-height: 1.6;
  }
  pre code { background: transparent; border: none; padding: 0; }
  blockquote {
    margin: var(--space-4) 0;
    padding: var(--space-2) var(--space-4);
    border-left: 3px solid var(--primary);
    color: var(--muted-foreground);
    background: var(--tone-primary-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  ul, ol { margin: var(--space-3) 0; padding-inline-start: var(--space-5); }
  li { margin: var(--space-1) 0; }
  li::marker { color: var(--muted-foreground); }
  strong { font-weight: var(--font-weight-semibold); }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: var(--space-3) 0;
    font-size: var(--text-sm);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  thead th {
    background: var(--muted);
    color: var(--foreground);
    font-weight: var(--font-weight-semibold);
  }
  th, td {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-3);
    text-align: left;
    font-variant-numeric: tabular-nums;
  }
  tbody tr:last-child td { border-bottom: 0; }
</style>

<div class="md-root" bind:this={contentEl}></div>
