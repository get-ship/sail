<!--
  <sui-accordion-item> — co-located child for <sui-accordion>.
  Expandable panel with grid-based height animation (same trick as sui-collapsible).

  Prop parity vs <ship-accordion-item>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  value (string, '')           value (string, '',       ✓
                                 reflect)
  disabled (bool, false)       disabled (bool, reflect) ✓
  open (bool, false)           open (bool, reflect)     ✓ managed by parent
  ─────────────────────────────────────────────────────────────────────────────
  slots: trigger               trigger                  ✓
         (default) content     (default) content        ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: trigger, content,     trigger, content,        ✓
         chevron                chevron
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: aria-expanded + aria-controls on trigger;
        role="region" + aria-labelledby on content region
  ─────────────────────────────────────────────────────────────────────────────
  animation: grid-template-rows 0fr→1fr (same as sui-collapsible)
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="value" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="open" type="bool" default="false" reflect />

<variants>
  [hidden]:   display:none
  [open]:     bg:muted
</variants>
<variants part="trigger">
  hover:     bg:hover-bg
  [disabled]: cursor:not-allowed opacity:50
</variants>
<variants part="chevron">
  [open]:    fg:foreground
</variants>
<variants part="content">
  [open]:    grid-template-rows:1fr
</variants>

<!-- Residual: .trigger visual (display:flex + align-items + width +
     padding + background + border:0 + text-align + font:inherit +
     font-size + font-weight + color + cursor + gap); .chevron
     geometry (flex-shrink + width + height + color + transform on
     open); .content-wrap grid-template-rows 0fr (no sx prop for
     grid-template-rows; the open variant flips to 1fr); the
     transform/grid-template-rows transitions (motion); the .trigger
     focus outline (vs the 2-layer box-shadow ring); forced-colors
     CanvasText outline (system color); the prefers-reduced-motion
     reset; .trigger-label flex:1; .content-inner overflow:hidden;
     .content-body padding. -->
<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  [part~='trigger'] {
    display: flex;
    align-items: center;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 0;
    text-align: start;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    cursor: pointer;
    gap: var(--space-2);
    transition: background var(--duration-fast) var(--ease-out);
  }
  [part~='trigger']:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    [part~='trigger']:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  .trigger-label { flex: 1; }
  [part~='chevron'] {
    flex-shrink: 0;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    color: var(--muted-foreground);
    transition: transform var(--duration-medium) var(--ease-out);
  }
  :host([open]) [part~='chevron'] { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { [part~='chevron'] { transition: none; } }
  [part~='content'] {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-medium) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) { [part~='content'] { transition: none; } }
  .content-inner { overflow: hidden; }
  .content-body { padding: var(--space-3) 0; }
</style>

<button class="trigger" part="trigger" bind:this={triggerBtn} disabled={disabled()}>
  <span class="trigger-label"><slot name="trigger"></slot></span>
  <svg class="chevron" part="chevron" viewBox="0 0 16 16" fill="none"
    stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
    stroke-linejoin="round" aria-hidden="true">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
</button>
<div class="content-wrap" part="content" bind:this={contentWrap} role="region">
  <div class="content-inner">
    <div class="content-body">
      <slot></slot>
    </div>
  </div>
</div>
