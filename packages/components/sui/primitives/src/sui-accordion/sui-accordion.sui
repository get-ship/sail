<!--
  <sui-accordion> — SUI port of <ship-accordion>.
  Declarative accordion with single or multiple open mode.

  Prop parity vs <ship-accordion>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  type ('single'|'multiple',   type (string, 'single',  ✓ feat/next declares
    'single')                    reflect)                 this as a free string
                                                          (not a closed enum) —
                                                          kept exactly as-is,
                                                          not tightened, so an
                                                          off-list value keeps
                                                          falling through to
                                                          "multiple" behavior
                                                          in the controller,
                                                          same as today.
  value (string, '')           value (string, '',       ✓ comma-sep open vals
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-change → {value}        sui-change → {value}     event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: (default) items       (default) items          ✓
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - No tone/size channel here — nothing to delete/globalize.
  - No L1 controls — this is a plain slotted container.
  - `type`/`value` are both free strings with `reflect`; the new
    component-object prop shorthand can't express reflect on a plain
    string (it only auto-reflects tone/size/unions/bools — see
    sui-alert's dismissible/tone for the shapes it DOES cover), so both
    stay declared via the plain prop directive, unchanged from
    feat/next.
  - The host's own surface (bordered rounded panel) moves to a host-sx
    directive — the closed-vocabulary equivalent of the old bare
    `:host{border;radius;overflow;background}` block. `display:block`
    and `[hidden]` are dropped: framework-owned now (BASE_CSS).
  - `::slotted(sui-accordion-item:not(:first-child))` stays in <style> —
    sx/variants have no reach into slotted descendants.
-->

<prop name="type" type="string" default="single" reflect />
<prop name="value" type="string" default="" reflect />

<host sx="border:border radius:lg overflow:hidden bg:surface-1" />

<style>
  ::slotted(sui-accordion-item:not(:first-child)) {
    border-top: 1px solid var(--border-subtle);
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-accordion.sui'

export default controller<Scope>({
  mount(state, host) {

    const getItems = (): Element[] =>
      Array.from(host.querySelectorAll(':scope > sui-accordion-item'))

    const getEnabledItems = (): Element[] =>
      getItems().filter(i => !i.hasAttribute('disabled'))

    const getOpenValues = (): Set<string> => {
      const v = state.$signals.value()
      return new Set(v ? v.split(',').filter(Boolean) : [])
    }

    const syncItems = () => {
      const open = getOpenValues()
      for (const item of getItems()) {
        const val = item.getAttribute('value') || ''
        if (open.has(val)) {
          item.setAttribute('open', '')
        } else {
          item.removeAttribute('open')
        }
      }
    }

    const stopEffect = effect(() => {
      state.$signals.value()
      syncItems()
    })

    // Re-sync when items are added/removed AFTER connect. The value→open
    // effect only re-runs on `value` changes, so items inserted later (dynamic
    // children, or a framework that sets attributes then projects children)
    // would never pick up the initial open value without this.
    const mo = new MutationObserver(syncItems)
    mo.observe(host, { childList: true })

    const onToggle = (e: Event) => {
      const ev = e as CustomEvent
      ev.stopPropagation()
      const itemVal = ev.detail?.value as string
      const open = getOpenValues()

      if (state.$signals.type() === 'single') {
        state.$signals.value.set(open.has(itemVal) ? '' : itemVal)
      } else {
        if (open.has(itemVal)) {
          open.delete(itemVal)
        } else {
          open.add(itemVal)
        }
        state.$signals.value.set(Array.from(open).join(','))
      }

      host.dispatchEvent(
        new CustomEvent('sui-change', {
          detail: { value: state.$signals.value() },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const onNav = (e: Event) => {
      const ev = e as CustomEvent
      ev.stopPropagation()
      const enabled = getEnabledItems()
      if (!enabled.length) return

      const current = (ev.target as Element | null)?.closest('sui-accordion-item')
      const idx = current ? enabled.indexOf(current) : -1
      let target: Element | undefined

      switch (ev.detail?.direction) {
        case 'next':  target = enabled[(idx + 1) % enabled.length]; break
        case 'prev':  target = enabled[(idx - 1 + enabled.length) % enabled.length]; break
        case 'first': target = enabled[0]; break
        case 'last':  target = enabled[enabled.length - 1]; break
      }

      if (target) {
        const summary = target.shadowRoot?.querySelector('summary') as HTMLElement | null
        summary?.focus()
      }
    }

    host.addEventListener('sui-accordion-item-toggle', onToggle)
    host.addEventListener('sui-accordion-nav', onNav)

    return () => {
      stopEffect()
      mo.disconnect()
      host.removeEventListener('sui-accordion-item-toggle', onToggle)
      host.removeEventListener('sui-accordion-nav', onNav)
    }
  },
})

</controller>
<slot></slot>
