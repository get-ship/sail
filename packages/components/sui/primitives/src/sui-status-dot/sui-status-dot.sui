<!--
  <sui-status-dot> — SUI port of <ship-status-dot>.
  Colored dot for live/online state indicators with optional pulse animation.

  Prop / event / method parity vs <ship-status-dot>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (String, 'success')        tone (union, reflect)   ✓
  pulse (Boolean, false)          pulse (bool, reflect)   ✓
  size ('sm'|'md', 'md')          size (union, reflect)   ✓
  label (String, '')              label (string)          ✓
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)             ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: dot                      part="dot"              ✓
  ─────────────────────────────────────────────────────────────────────────────
  reducedMotion mixin             @media prefers-reduced-motion inline   ✓
  toneVars mixin                  :host([tone=...]) inline               ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="pulse" type="bool" default="false" reflect />
<prop name="size" values="sm|md" default="md" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    --tone-fg: var(--success);
  }
  :host([tone='default'])     { --tone-fg: var(--foreground);     --tone-halo-strong: var(--tone-default-border); --tone-halo-soft: var(--tone-default-ring); }
  :host([tone='primary'])     { --tone-fg: var(--primary);         --tone-halo-strong: var(--tone-primary-border); --tone-halo-soft: var(--tone-primary-ring); }
  :host([tone='info'])        { --tone-fg: var(--info);            --tone-halo-strong: var(--tone-info-border);    --tone-halo-soft: var(--tone-info-ring); }
  :host([tone='success'])     { --tone-fg: var(--success);         --tone-halo-strong: var(--tone-success-border); --tone-halo-soft: var(--tone-success-ring); }
  :host([tone='warning'])     { --tone-fg: var(--warning);         --tone-halo-strong: var(--tone-warning-border); --tone-halo-soft: var(--tone-warning-ring); }
  :host([tone='destructive']) { --tone-fg: var(--destructive);     --tone-halo-strong: var(--tone-destructive-border); --tone-halo-soft: var(--tone-destructive-ring); }
  :host([tone='accent'])      { --tone-fg: var(--accent);          --tone-halo-strong: var(--tone-accent-border);  --tone-halo-soft: var(--tone-accent-ring); }
  :host([tone='muted'])       { --tone-fg: var(--muted-foreground); --tone-halo-strong: var(--tone-muted-border);  --tone-halo-soft: var(--tone-muted-ring); }
  .dot {
    display: inline-block;
    width: var(--icon-size-3xs);
    height: var(--icon-size-3xs);
    border-radius: 50%;
    background: var(--tone-fg);
    box-shadow:
      0 0 0 var(--space-1_25) var(--tone-halo-strong),
      0 0 0 var(--space-4_5) var(--tone-halo-soft);
  }
  :host([size='sm']) .dot {
    width: var(--space-1_5);
    height: var(--space-1_5);
    box-shadow:
      0 0 0 1px var(--tone-halo-strong),
      0 0 0 var(--space-3_5) var(--tone-halo-soft);
  }

  :host([pulse]) .dot { animation: sui-status-dot-pulse 2.5s var(--ease-out) infinite; }
  @keyframes sui-status-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.82; transform: scale(0.92); }
  }

  @media (prefers-reduced-motion: reduce) {
    :host([pulse]) .dot { animation: none; }
  }
</style>

<span
  class="dot"
  part="dot"
  role={label() ? 'img' : null}
  aria-label={label() || null}
  aria-hidden={label() ? null : 'true'}
></span>
