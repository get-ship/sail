<!--
  <sui-input> — SUI port of <ship-input>.
  Native <input> delegation with ARIA wiring, event bridging, and
  imperative proxy API. Controller handles value sync, event dispatch,
  and host method delegation.

  Prop / event / method parity vs <ship-input>
  ──────────────────────────────────────────────────────────────────────────────
  Lit                            SUI                       Notes
  ──────────────────────────────────────────────────────────────────────────────
  type (String, 'text')          type (union, 'text',      ✓ values enumerated
                                   reflect)                for DX
  value (String, '')             value (string, '')        ✓ two-way via bind:value
  placeholder (String, '')       placeholder (string)      ✓
  name (String, '')              name (string)             ✓
  autocomplete (String, '')      autocomplete (string)     ✓
  required (Boolean, false)      required (bool, reflect)  ✓ aria-required wired
  disabled (Boolean, false)      disabled (bool, reflect)  ✓
  readonly (Boolean, false)      readonly (bool, reflect)  ✓
  invalid (Boolean, false)       invalid (bool, reflect)   ✓ aria-invalid wired;
                                                           overrides tone to
                                                           destructive ring
  loading (Boolean, false)       loading (bool, reflect)   ✓ spinner replaces
                                                           trailing slot
  tone (Tone, undefined)         tone (union, 'default',   ✓ tints focus ring
                                   reflect)
  variant ('default'|'ghost',    variant (default|ghost,   ✓ ghost removes border
    'default')                     'default', reflect)     until focus
  size ('sm'|'md'|'lg', 'md')    size (sm|md|lg, 'md',    ✓
                                   reflect)
  label (String, '')             label (string)            ✓ → aria-label
  describedBy (String, '')       described-by (string)     ✓ → describedBy in scope
                                                           + aria-describedby wired
                                                           by controller
  errorMessage (String, '')      error-message (string)    ✓ → errorMessage in scope
                                                           rendered when invalid
  ──────────────────────────────────────────────────────────────────────────────
  Events: ship-input             sui-input                 ✓ renamed; detail.value
    (CustomEvent, composed)        (CustomEvent, composed)
  Events: (native change)        sui-input-change          ✓ re-dispatched from
                                   (CustomEvent, composed)   host (native change
                                                             is not composed from
                                                             shadow)
  ──────────────────────────────────────────────────────────────────────────────
  Methods: (none explicit)       host.focus()              ✓ proxies to inner input
                                 host.blur()               ✓
                                 host.clear()              ✓ resets value + signal
                                 host.reportValidity()     ✓ proxies to inner input
  ──────────────────────────────────────────────────────────────────────────────
  formAssociated / internals     NATIVE                    `form-value` on the value
                                                           prop and `form-disabled`
                                                           on the disabled prop wire
                                                           ElementInternals.setFormValue
                                                           plus formResetCallback /
                                                           formStateRestoreCallback /
                                                           formDisabledCallback at
                                                           the compiler level.
  ──────────────────────────────────────────────────────────────────────────────
  Slots: leading, trailing       leading, trailing         ✓
  Parts: field, input            wrap, input               ✓ 'input' satisfies
                                                           test table; 'wrap'
                                                           mirrors outer container
  ──────────────────────────────────────────────────────────────────────────────
-->

<prop name="type" values="text|search|email|url|tel|password|number" default="text" reflect />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="name" type="string" default="" />
<prop name="autocomplete" type="string" default="" />
<prop name="required" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="loading" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|ghost" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />
<prop name="described-by" type="string" default="" />
<prop name="error-message" type="string" default="" />

<theme prop="tone" channels="tone-border, tone-ring, tone-ring-soft">
  default:     border,                primary,        border-subtle
  primary:     primary,               primary,        tone-primary-border
  info:        info,                  info,           tone-info-border
  success:     success,               success,        tone-success-border
  warning:     warning,               warning,        tone-warning-border
  destructive: destructive,           destructive,    tone-destructive-border
  accent:      accent,                accent,         tone-accent-border
  muted:       muted-foreground,      muted-foreground, border-subtle
</theme>
<theme prop="size" channels="input-h, input-fs, input-px, input-icon">
  default: control-h-md, density-text, density-row-px, icon-size-sm
  sm:      control-h-sm, text-xs,     space-2,        icon-size-xs
  md:      control-h-md, density-text, density-row-px, icon-size-sm
  lg:      control-h-lg, text-sm,     space-3,        icon-size-md
</theme>
<variants>
  [hidden]:  display:none
</variants>
<variants part="wrap">
  focus-within: border:tone-ring
</variants>

<!-- Residual: host column layout (flex column + gap + width — no layout
     primitive for the input+error vertical stack); compound descendant
     state selectors (`.wrap:hover:not(:focus-within)`) — variants only
     target :host attrs; the inner <input> element styling (no sx, no
     shadow part, native form control); ::placeholder/::slotted pseudo-
     elements (no sx story); multi-property transition (motion);
     @keyframes (animation); forced-colors CanvasText focus outline
     (system color); saturate filter (compound disabled state); the
     spinner border-color: a 2-tone border with border-top-color override
     (no sx prop for per-side color); the .error/--input-icon local vars
     + .wrap layout detail. -->
<style>
  :host {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-1);
    vertical-align: middle;
    width: 100%;
    --tone-ring-soft: var(--border-subtle);
    --input-h: var(--control-h-md);
    --input-fs: var(--density-text);
    --input-px: var(--density-row-px);
    --input-icon: var(--icon-size-sm);
  }
  :host([variant='ghost']) { --tone-border: transparent; }
  :host([variant='default']:not([disabled])) [part~='wrap']:hover:not(:focus-within) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  :host([variant='ghost']:not([disabled])) [part~='wrap']:hover:not(:focus-within) {
    background: var(--tone-muted-bg);
    border-color: transparent;
    box-shadow: none;
  }
  [part~='wrap'] {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--input-h);
    padding: 0 var(--input-px);
    background: var(--background);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  [part~='wrap']:host([variant='ghost']) { border-color: transparent; }
  :host([variant='ghost']) [part~='wrap'] {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }
  :host([disabled]) [part~='wrap'] {
    background: var(--muted);
    border-color: var(--border-subtle);
    box-shadow: none;
    cursor: not-allowed;
    filter: saturate(0.6);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--input-fs);
    color: var(--foreground);
  }
  input::placeholder { color: var(--muted-foreground); }
  input:disabled { cursor: not-allowed; }
  input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    input:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  ::slotted([slot='leading']),
  ::slotted([slot='trailing']) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--input-icon);
    height: var(--input-icon);
    color: var(--muted-foreground);
  }
  .spinner {
    display: inline-block;
    flex: 0 0 auto;
    width: var(--input-icon);
    border: 2px solid var(--tone-ring-soft);
    border-top-color: var(--tone-ring);
    border-radius: 50%;
    animation: sui-spin 0.6s linear infinite;
  }
  @keyframes sui-spin {
    to { transform: rotate(360deg); }
  }
  .error {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--destructive);
    line-height: 1.4;
  }
</style>


<controller>
import { bindAttr, bindNativeEvent, controller, onCleanup } from '@ship/sui-runtime'
import type { Scope } from './sui-input.sui'

let _idSeq = 0

export default controller<Scope>({
  mount(state, host) {
    const inputEl = state.$signals.inputEl()
    if (!inputEl) return
    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      clear: () => { inputEl.value = ''; state.$signals.value.set('') },
      reportValidity: () => inputEl.reportValidity(),
    })
    bindNativeEvent(inputEl, 'input', () =>
      host.emit!('sui-input', { value: inputEl.value }))
    bindNativeEvent(inputEl, 'change', () =>
      host.emit!('sui-input-change', { value: inputEl.value }))
    const errId = `sui-input-err-${++_idSeq}`
    onCleanup(bindAttr(inputEl, 'aria-describedby', () => {
      const parts: string[] = []
      if (state.$signals.invalid() && state.$signals.errorMessage()) {
        const errorEl = state.$signals.errorEl()
        if (errorEl) { errorEl.id = errId; parts.push(errId) }
      }
      const extra = state.$signals.describedBy()
      if (extra) parts.push(extra)
      return parts.length > 0 ? parts.join(' ') : null
    }))
  },
})

</controller>
<row class="wrap" part="wrap" align="center" gap="2">
  <slot name="leading" reflect-empty="data-no-leading"></slot>
  <input
    part="input"
    type={type()}
    placeholder={placeholder()}
    name={name()}
    autocomplete={autocomplete() || 'off'}
    disabled={disabled()}
    readonly={readonly()}
    required={required()}
    aria-label={label()}
    aria-invalid={invalid() ? 'true' : 'false'}
    aria-required={required() ? 'true' : 'false'}
    aria-busy={loading() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
  {#if loading()}
    <span class="spinner" aria-hidden="true"></span>
  {:else}
    <slot name="trailing" reflect-empty="data-no-trailing"></slot>
  {/if}
</row>
{#if invalid() && errorMessage()}
  <span class="error" role="alert" bind:this={errorEl} sx="text:sm fg:destructive">{errorMessage()}</span>
{/if}
