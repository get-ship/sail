<!--
  <sui-alert> — SUI port of <ship-alert>.
  Inline status banner. Tone-driven surface.

  Prop parity vs <ship-alert>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone ('info'|'success'|      tone (union, reflect)    ✓ same values; default
    'warning'|'destructive'|                              changed 'info' →
    'muted', 'info')                                      'default' (SUI
                                                           catalog convention,
                                                           as sui-badge/-chip)
  dismissible (bool, false)    dismissible (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-dismiss                 sui-dismiss               event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: icon, title,          icon, title, (default),  ✓
    (default), actions           actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" for             same, reactive           ✓
    warning/destructive;
    role="status" otherwise
  aria-live="assertive" for    same, reactive           ✓
    warning/destructive;
    "polite" otherwise
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                box, ico, content,       SUI adds parts +
                                title, body, actions,     classes (anatomy);
                                close                     close mirrors class
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - tone is a GLOBAL framework channel now (contracts.css / suiTonesSheet):
    no per-component <theme prop="tone"> block. This skin reads
    var(--tone)/var(--tone-bg)/var(--tone-fg) directly, filled for whichever
    of the 8 catalog tones the host's [tone] attribute names.
  - The dismiss control is a bare framework `<button ghost xs>` — no
    hand-styled `.close` (no color/hover/focus CSS authored here). See
    LANG-GAP below: this doesn't yet render skinned (tracked, not routed
    around).
  - sx is closed-vocabulary (tokens + tone-*/size-* channels only); `<style>`
    keeps only what sx structurally cannot express (pseudo-elements,
    ::slotted, gap, grid, position/display for non-primitive elements).
  - Bugfix while re-porting: the pre-existing spike `.box` had dropped
    `position: relative` (present in feat/next) — without it the
    `.box::before` tone stripe anchors to the wrong ancestor. Restored (as
    sx `position:relative`, not <style>, per closed-sx).

  LANG-GAP — dismiss button renders unskinned today
  ─────────────────────────────────────────────────────────────────────────────
  The framework's L1 `<button>` skin (ghost/solid/soft/outline — ownership of
  color/hover/focus for a control) lives ONLY in the light-DOM document
  contracts (`ensureLightContracts()` / `LIGHT_CONTRACTS_CSS` in
  packages/sui/runtime/src/styles/index.ts). Shadow components adopt
  `adoptSuiSheets()`, which carries base + tones + sizes + typography —
  NOT the button/input/toggle control skins. This component still compiles
  shadow (`shadowForComponentCompilePlugin` hardcodes `shadow:true`; the CLI
  component-mode default is also shadow — `--light` is an opt-in the shared
  test/build harness never passes). So `<button ghost xs>` here is, today, a
  functionally-correct but VISUALLY BARE native button — no ghost background,
  no hover wash, no size-channel padding. This is a framework/toolchain gap,
  not a `.sui` authoring gap: nothing in this file can reach across the
  shadow boundary to the document-level sheet. Reported, not eaten with an
  ad-hoc `.close` skin (that would be exactly the escape hatch the parity
  gate forbids). Fix belongs to the framework: either extend
  `adoptSuiSheets()` to also carry the control skins for shadow components,
  or flip this component's compile to `--light` once the harness supports a
  per-component opt-in.
-->

<component>{
  props: {
    tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'muted',
    dismissible: false,
  },
}</component>

<variants class="close">
  [dismissible]: display:inline-flex
</variants>

<style>
  .box {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-3);
    font-family: var(--font-body);
  }
  .box::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: var(--space-1);
    background: var(--tone);
  }
  .ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .close { display: none; }
  ::slotted([slot='icon']) { display: inline-flex; width: var(--icon-size-sm); height: var(--icon-size-sm); }
</style>

<div class="box" part="box"
     role={tone() === 'destructive' || tone() === 'warning' ? 'alert' : 'status'}
     aria-live={tone() === 'destructive' || tone() === 'warning' ? 'assertive' : 'polite'}
     aria-atomic="true"
     sx="position:relative p:3 radius:md overflow:hidden border:border bg:surface-1 text:base leading:normal shadow:xs">
  <span class="ico" part="ico"
    sx="w:control-h-xs h:control-h-xs radius:md bg:tone-bg fg:tone-fg">
    <slot name="icon"></slot>
  </span>
  <column class="content" part="content" gap="1" sx="min-w:0">
    <div class="title" part="title" sx="weight:semibold"><slot name="title"></slot></div>
    <div class="body" part="body" sx="fg:muted-foreground"><slot></slot></div>
    <div class="actions" part="actions"><slot name="actions"></slot></div>
  </column>
  <button ghost xs class="close" part="close" type="button" aria-label="Dismiss" bind:this={closeBtn}>
    <svg viewBox="0 0 10 10" aria-hidden="true" sx="w:icon-size-sm h:icon-size-sm">
      <path d="M2 2 L8 8 M8 2 L2 8" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" fill="none"/>
    </svg>
  </button>
</div>
