<!--
  <sui-toggle> — child element of <sui-toggle-group> or standalone.
  Pressed/unpressed button that participates in single or multiple selection.

  Prop parity vs <ship-toggle>
  ────────────────────────────────────────────────────────────────────────
  pressed (bool, false)             ✓ reflect
  disabled (bool, false)            ✓ reflect
  value (string, '')                ✓ reflect — identifier for group selection
  size (sm|md|lg, 'md')             ✓ reflect
  variant (outline|ghost, 'outline') ✓ reflect
  ────────────────────────────────────────────────────────────────────────
  Events: ship-toggle → sui-toggle { detail: { pressed, value } }
  ────────────────────────────────────────────────────────────────────────
  Slots: (default) — button content
  Parts: button
-->

<prop name="pressed" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="value" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="outline|ghost|segmented" default="outline" reflect />

<theme prop="size" channels="tgl-h, tgl-px, tgl-fs">
  default: control-h-md, space-3, text-base
  md:      control-h-md, space-3, text-base
  sm:      control-h-sm, space-2, text-sm
  lg:      control-h-xl, space-4, text-base
</theme>
<variants>
  [hidden]:   display:none
  [pressed]:  bg:selected fg:foreground weight:semibold
  [disabled]: cursor:not-allowed opacity:75
</variants>
<variants part="button">
  hover:           bg:hover-bg fg:foreground
  (variant=segmented, [pressed]): bg:surface-1 fg:foreground shadow:xs
</variants>

<!-- Residual: button visual (display:inline-flex + align + justify +
     gap + height + padding + font + line-height + color + background +
     border + border-radius + cursor) — hand-rolled because the inner
     <button> is a real form control with a `part` for the slot
     recipe and the layout keywords don't fit; the segmented variant's
     `border:0; border-radius:sm` reset + the compound
     (variant=ghost, [pressed]) zeroing; aria-pressed:hover target on
     the unpressed button (descendant attribute) — variants only match
     :host's own attrs; multi-property transition (motion); forced-colors
     CanvasText outline (system color); saturate(0.6) compound disabled
     filter; pointer-events:none compound disabled; the focus outline
     (vs the 2-layer box-shadow ring). -->
<style>
  :host { display: inline-flex; }
  [part~='button'] {
    display: inline-flex;
  :host {
    --tgl-h: var(--control-h-md);
    --tgl-px: var(--space-3);
    --tgl-fs: var(--text-base);
  }
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--tgl-h);
    padding: 0 var(--tgl-px);
    font-family: var(--font-body);
    font-size: var(--tgl-fs);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-none);
    color: var(--muted-foreground);
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  :host([variant='ghost']) [part~='button'] { border-color: transparent; background: transparent; }
  [part~='button']:not([aria-pressed='true']):hover {
    background: var(--hover-bg);
    color: var(--foreground);
  }
  [part~='button']:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  :host([pressed]) [part~='button'] {
    background: var(--selected-bg);
    color: var(--foreground);
    border-color: var(--selected-border);
    font-weight: var(--font-weight-semibold);
  }
  :host([disabled]) [part~='button'] {
    cursor: not-allowed;
    color: var(--muted-foreground);
    filter: saturate(0.6);
    pointer-events: none;
  }
  :host([variant='segmented']) [part~='button'] {
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    background: transparent;
  }
  :host([variant='segmented']:not([size])) [part~='button'],
  :host([variant='segmented'][size='md']) [part~='button'] {
    height: auto;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }
  :host([variant='segmented'][size='sm']) [part~='button'] {
    height: auto;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
  }
  :host([variant='segmented'][size='lg']) [part~='button'] {
    height: auto;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-md);
  }
  :host([variant='segmented']) [part~='button']:hover {
    background: var(--hover-bg);
    color: var(--foreground);
  }
  :host([variant='segmented'][pressed]) [part~='button'] {
    background: var(--surface-1);
    color: var(--foreground);
    box-shadow: var(--shadow-xs);
    border: 0;
  }
  @media (forced-colors: active) {
    [part~='button']:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
    :host([pressed]) [part~='button'] { outline: 2px solid CanvasText; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<button
  part="button"
  type="button"
  aria-pressed={pressed() ? 'true' : 'false'}
  disabled={disabled()}
  bind:this={buttonEl}
>
  <slot></slot>
</button>
