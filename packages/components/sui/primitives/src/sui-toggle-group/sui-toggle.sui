<!--
  sui-toggle: child of sui-toggle-group or standalone. Pressed/unpressed
  button. Prop parity vs ship-toggle: pressed (bool, false, reflect),
  disabled (bool, false, reflect), value (string, '', reflect),
  size (sm|md|lg, 'md', reflect),
  variant (outline|ghost|segmented, 'outline', reflect). Events: ship-toggle
  → sui-toggle { detail: { pressed, value } }. Slots: (default). Parts: button.

  NEW SURFACE — re-port from feat/next:
  - The theme prop="size" block DELETED (ad-hoc per-component channels
    "closed sx" back door the new surface forbids). The three local CSS
    vars (button height, inline padding, font size per size) are declared
    directly in the style block on .sui-toggle with the same token values
    (control-h-md / space-3 / text-base for default+md, etc.) — kept as a
    component-internal ladder; the global size-h channel is for the size
    prop's L1 contract and the toggle is its own visual unit, not a form
    control).

  - L1 <button> skin handles baseline font / line-height / focus-visible /
    disabled cursor / transition; the component-specific skin (unpressed
    muted-foreground, surface-1 fill, the pressed selected-bg, segmented
    lift, disabled saturate) is sx via `variants part="button"`. The
    descendant-state selectors (unpressed button's hover wash, disabled
    saturate/pointer-events) and the segmented size ladder (per-size
  height/padding/font-size) stay in the style block.
  - part="button" STAYS on the inner <button> (the test table selects on
    [part~="button"]; part= is the existing public hook, class= is the
    forward-looking anatomy target — both can coexist for a single part).
  - [hidden] display:none deleted (BASE_CSS owns it).
-->

<component>{
  props: {
    pressed: false,
    disabled: false,
    value: '',
    size: 'sm' | 'md' | 'lg',
    variant: 'outline' | 'ghost' | 'segmented',
  },
}</component>

<variants>
  [disabled]: cursor:not-allowed
</variants>

<variants class="button">
  [pressed]:                 bg:selected       fg:foreground       weight:semibold       border:selected-border
  (variant=segmented, [pressed]):  bg:surface-1  fg:foreground  shadow:xs
  (variant=segmented):       border:none        radius:sm           bg:transparent        fg:muted-foreground
  (variant=ghost):           border:none        bg:transparent      fg:muted-foreground
  [disabled]:                opacity:75         fg:muted-foreground
</variants>

<!--
  Residual: host display override (inline-flex); per-size local CSS vars
  (size channel ladder for the button's own height/padding/font-size);
  button baseline (font, line-height, gap); the framework's button skin
  runs at :where() zero specificity, and the component's button visual
  needs the same non-zero specificity to win ties in the cascade;
  descendant-state selectors; segmented size ladder; forced-colors
  CanvasText outline (system color); reduce-motion kill.
-->
<style>
  .sui-toggle { display: inline-flex; }

  /* size channel — local CSS vars */
  .sui-toggle:not([size]), .sui-toggle[size='md'] {
    --tgl-h: var(--control-h-md);
    --tgl-px: var(--space-3);
    --tgl-fs: var(--text-base);
  }
  .sui-toggle[size='sm'] {
    --tgl-h: var(--control-h-sm);
    --tgl-px: var(--space-2);
    --tgl-fs: var(--text-sm);
  }
  .sui-toggle[size='lg'] {
    --tgl-h: var(--control-h-xl);
    --tgl-px: var(--space-4);
    --tgl-fs: var(--text-base);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--tgl-h);
    padding: 0 var(--tgl-px);
    font-family: var(--font-body);
    font-size: var(--tgl-fs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  /* Unpressed hover wash: descendant state, no host attr. */
  button:not([aria-pressed='true']):hover {
    background: var(--hover-bg);
    color: var(--foreground);
  }
  /* Disabled: cursor/opacity on variants; saturate + pointer-events
     stay in <style> (compound descendant-state, no variants channel). */
  .sui-toggle[disabled] button {
    filter: saturate(0.6);
    pointer-events: none;
  }
  /* Segmented size ladder. Reset (border:0, transparent bg, sm radius)
     is on variants; what's left is per-size dimensional composition. */
  .sui-toggle[variant='segmented']:not([size]) button,
  .sui-toggle[variant='segmented'][size='md'] button {
    height: auto;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }
  .sui-toggle[variant='segmented'][size='sm'] button {
    height: auto;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
  }
  .sui-toggle[variant='segmented'][size='lg'] button {
    height: auto;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-md);
  }
  /* Segmented hover: descendant state. */
  .sui-toggle[variant='segmented'] button:hover {
    background: var(--hover-bg);
    color: var(--foreground);
  }
  /* Segmented pressed: variants paint bg:surface-1 + shadow:xs; the
     border:0 here belt-and-suspenders against a parent cascade. */
  .sui-toggle[variant='segmented'][pressed] button { border: 0; }

  @media (forced-colors: active) {
    button:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
    .sui-toggle[pressed] button { outline: 2px solid CanvasText; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-toggle.sui'

export default controller<Scope>({
  mount(state, host) {

    const stop = effect(() => {
      const btn = state.$signals.buttonEl() as HTMLButtonElement | null
      if (!btn) return
      const onClick = () => {
        if (state.$signals.disabled()) return
        state.$signals.pressed.set(!state.$signals.pressed())
        host.dispatchEvent(new CustomEvent('sui-toggle', {
          detail: { pressed: state.$signals.pressed(), value: state.$signals.value() },
          bubbles: true,
          composed: true,
        }))
      }
      btn.addEventListener('click', onClick)
      return () => btn.removeEventListener('click', onClick)
    })

    // Group calls this to move keyboard focus.
    ;(host as unknown as { focusButton(): void }).focusButton = () => {
      const btn = host.shadowRoot?.querySelector('button') as HTMLButtonElement | null
      btn?.focus()
    }

    return () => stop()
  },
})

</controller>
<button class="button" type="button" aria-pressed={pressed() ? 'true' : 'false'} disabled={disabled()} bind:this={buttonEl}>
  <slot></slot>
</button>
