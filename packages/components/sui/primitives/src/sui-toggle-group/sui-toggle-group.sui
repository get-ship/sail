<!--
  <sui-toggle-group> — SUI port of <ship-toggle-group>.
  Toggle button container with single or multiple selection, arrow-key
  navigation, and merged-border layout.

  Prop parity vs <ship-toggle-group>
  ────────────────────────────────────────────────────────────────────────
  type (single|multiple, 'single')  ✓ reflect
  value (string, '')                ✓ reflect — comma-separated selected values
  size (sm|md|lg, 'md')             ✓ reflect — propagated to children
  variant (outline|ghost, 'outline') ✓ reflect — propagated to children
  name (string, '')                 ✓ — form field name
  orientation (horizontal|vertical, 'horizontal') ✓ reflect — Radix-parity;
    controls which arrow keys move focus (←→ horizontal, ↑↓ vertical) and
    drives aria-orientation on the role=group host.
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change → sui-change { detail: { value: string } }
  ────────────────────────────────────────────────────────────────────────
  Slots: (default) — sui-toggle children
-->

<prop name="type" values="single|multiple" default="single" reflect />
<prop name="value" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="outline|ghost|segmented" default="outline" reflect />
<prop name="name" type="string" default="" />
<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />

<style>
  :host {
    /* Segmented variant: 2px frame, 1px cell separator. Off the spacing
     * scale — exposed as local tokens so component CSS stays scale-free. */
    --tg-seg-pad: var(--space-half);
    --tg-seg-gap: 1px;
    display: inline-flex;
    gap: 0;
  }
  :host([hidden]) { display: none; }
  :host([orientation='vertical']) { flex-direction: column; }

  ::slotted(sui-toggle:not(:first-child)) { margin-inline-start: -1px; }
  ::slotted(sui-toggle:first-child) { border-radius: var(--radius) 0 0 var(--radius); }
  ::slotted(sui-toggle:last-child) { border-radius: 0 var(--radius) var(--radius) 0; }
  ::slotted(sui-toggle:not(:first-child):not(:last-child)) { border-radius: 0; }

  :host([orientation='vertical']) ::slotted(sui-toggle:not(:first-child)) { margin-inline-start: 0; margin-top: -1px; }
  :host([orientation='vertical']) ::slotted(sui-toggle:first-child) { border-radius: var(--radius) var(--radius) 0 0; }
  :host([orientation='vertical']) ::slotted(sui-toggle:last-child) { border-radius: 0 0 var(--radius) var(--radius); }
  :host([orientation='vertical']) ::slotted(sui-toggle:not(:first-child):not(:last-child)) { border-radius: 0; }

  :host([variant='segmented']) {
    padding: var(--tg-seg-pad);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    gap: var(--tg-seg-gap);
  }
  :host([variant='segmented']) ::slotted(sui-toggle:not(:first-child)) { margin-inline-start: 0; }
  :host([variant='segmented']) ::slotted(sui-toggle:first-child) { border-radius: var(--radius-sm); }
  :host([variant='segmented']) ::slotted(sui-toggle:last-child) { border-radius: var(--radius-sm); }
  :host([variant='segmented']) ::slotted(sui-toggle:not(:first-child):not(:last-child)) { border-radius: var(--radius-sm); }
</style>

<slot bind:this={defaultSlotEl}></slot>
