<!--
  <sui-drawer> — SUI port of <ship-drawer>.
  Side-sheet panel built on the native <dialog> element. Slides in from
  the right (or left) edge instead of centering like sui-dialog.

  Why <dialog> not popover="manual"? <dialog> gives us showModal() modal
  semantics (focus trap, ::backdrop, ESC close) for free. popover="manual"
  would require re-implementing all of that.

  Prop / event / method parity vs <ship-drawer>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  side ('right'|'left')        side (union, 'right', ref)   ✓
  size ('sm'|'md'|'lg')        size (union, 'md', reflect)  ✓
  dismissible (bool, true)     dismissible (bool, true)     ✓ no reflect
  ────────────────────────────────────────────────────────────────────────
  Events: ship-open/close/dismiss → sui-open/close/dismiss              ✓
  Methods: show(), close()                                               ✓
  Slots: title, description, (default), footer                          ✓
  Parts: dialog, header, body, footer, close                            ✓
  ────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ────────────────────────────────────────────────────────────────────────
  - side / size are component-specific unions — they don't fit the
    global tone/size channels, so they remain as `props:` on the
    component. The size-derived custom channels (--dr-w, --dr-px, etc.)
    live as `:host([size=…])` overrides in <style>, exactly like
    sui-dialog's --dlg-max-w channel.
  - The close control is a bare framework `<button ghost xs>` — no
    hand-styled `.close` (no color/hover/focus CSS authored here). The
    framework's <button> skin supplies the ghost background, hover wash,
    focus ring, and size-channel padding; we position the close button
    absolutely via a single <style> rule (sx lacks `top`/`right`/etc.).
  - sx is closed-vocabulary (tokens + tone-*/size-* channels only); the
    dialog surface (background/foreground/shadow/border/radius) moves
    onto `sx=`; the dialog's position/transform/transition and
    dialog::backdrop / dialog[open] pseudo-states stay in <style> (sx
    can't do `transform`, `top`/`right`, pseudo-elements, or multi-prop
    transitions).
  - The dialog element is the slot host; the sentinel spans, header,
    body, and footer wrap it. The header and footer are real <row>
    elements (the framework's `display: inline-flex` layout primitive),
    so we get the right flex layout without authoring `display:flex`
    raw. Their padding / border / typography stay in <style> (padding
    reads the --dr-px / --dr-hpy channels, single-side borders are not
    in sx, font weight + line-height + color are raw typography).
  - The size-related <theme> block from the previous spike is GONE — the
    same data lives in plain :host([size]) CSS in <style>, with no
    indirection through a theme record. sx is the only style surface
    for what sx can express.
-->

<component>{
  props: {
    open: false,
    side: 'right',
    size: 'md',
    dismissible: true,
  },
}</component>

<style>
  /* Local channel markers — the css-token lint recognises these as
   * touched variables, and the size rule below uses them. */
  --dr-w: ; --dr-px: ; --dr-hpy: ; --dr-bpy: ; --dr-fpy: ;

  /* Hidden host + the [hidden] attr default. */
  :host { display: contents; }
  :host([hidden]) { display: none; }

  /* Size channels — panel width + the four padding slots. Panel widths
   * are component-specific and don't fit the global --size-h /
   * --size-px / --size-fs / --size-gap channels, so we expose them
   * as custom --dr-* CSS vars here, and the consumer selectors below
   * reference them. */
  :host(:not([size])), :host([size='md']) { --dr-w: 420px; --dr-px: var(--space-6);    --dr-hpy: var(--space-4);   --dr-bpy: var(--space-4);   --dr-fpy: var(--space-3_5); }
  :host([size='sm'])                       { --dr-w: 320px; --dr-px: var(--space-5);    --dr-hpy: var(--space-3_5); --dr-bpy: var(--space-3_5); --dr-fpy: var(--space-3); }
  :host([size='lg'])                       { --dr-w: 560px; --dr-px: var(--space-7);    --dr-hpy: var(--space-5);   --dr-bpy: var(--space-5);   --dr-fpy: var(--space-4); }

  /* Dialog surface — placement, motion, border. The dialog's
   * background / color / shadow / border / radius are sx; everything
   * else (position/inset/transform/transition + ::backdrop) is raw
   * because sx has no `transform`, no `top/right/bottom/left`, no
   * `::backdrop`, and no multi-property transition shorthand. */
  dialog {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0; padding: 0;
    border: none;
    border-left: 1px solid var(--border);
    font-family: var(--font-body);
    width: min(var(--dr-w), calc(100vw - var(--space-7)));
    max-width: 100vw;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  :host([side='left']) dialog {
    inset: 0 auto 0 0;
    border-left: none;
    border-right: 1px solid var(--border);
    transform: translateX(-24px);
  }
  dialog[open] { opacity: 1; transform: translateX(0); }

  dialog::backdrop {
    background: var(--backdrop);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  dialog[open]::backdrop { opacity: 1; }

  /* Sentinels — keep raw. They are absolute, 1×1px, hidden — sx can't
   * reach `pointer-events: none` + `opacity: 0` together cleanly here. */
  .sentinel { position: fixed; width: 1px; height: 1px; pointer-events: none; opacity: 0; }

  /* Header — <row> already supplies `display: inline-flex`; the
   * padding, single-side border, position context, and flex-basis
   * stay raw. */
  .header {
    padding: var(--dr-hpy) var(--dr-px);
    padding-right: calc(var(--dr-px) + var(--space-7));
    border-bottom: 1px solid var(--border-subtle);
    flex: 0 0 auto; position: relative;
  }
  .header-content { flex: 1 1 0; min-width: 0; }
  .title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--foreground);
  }
  .description {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
    line-height: var(--leading-normal);
  }

  /* Body — flex-grow with overflow, plus a single muted-foreground
   * typography rule (multi-property typography stays raw). */
  .body {
    flex: 1 1 auto; min-height: 0;
    overflow-y: auto; overscroll-behavior: contain;
    padding: var(--dr-bpy) var(--dr-px);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--muted-foreground);
    scrollbar-width: thin;
  }

  /* Footer — <row> handles the flex; raw padding + single-side border
   * + the tone-muted background. */
  .footer {
    flex: 0 0 auto;
    padding: var(--dr-fpy) var(--dr-px);
    border-top: 1px solid var(--border-subtle);
    background: var(--tone-muted-border);
  }

  /* Close button position — the framework's <button> skin supplies
   * the visual; we just place the button in the header corner. The
   * `:host(...)` form is unused here because the close button lives
   * inside the dialog, not the host; one raw positioning rule is the
   * irreducible remainder. */
  .close {
    position: absolute;
    top: var(--space-3); inset-inline-end: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    dialog { transition: none; transform: none !important; opacity: 1; }
    dialog::backdrop { transition: none; }
  }
  @media (forced-colors: active) {
    dialog { border: 1px solid CanvasText; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-drawer.sui'
import { FocusReturn, acquireScrollLock, releaseScrollLock, focusableWithin } from '../overlay-focus'

let _seq = 0

export default controller<Scope>({
  mount(state, host) {
    const uid = ++_seq
    const headerId = `sui-drawer-header-${uid}`
    const bodyId = `sui-drawer-body-${uid}`

    const dialogEl = state.$signals.dialogEl() as HTMLDialogElement | null
    const closeBtn = state.$signals.closeBtn() as HTMLButtonElement | null
    const sentinelStart = state.$signals.sentinelStart() as HTMLElement | null
    const sentinelEnd = state.$signals.sentinelEnd() as HTMLElement | null
    const headerEl = state.$signals.headerEl() as HTMLElement | null
    const bodyEl = state.$signals.bodyEl() as HTMLElement | null

    if (!dialogEl) return

    if (headerEl) headerEl.id = headerId
    if (bodyEl) bodyEl.id = bodyId
    dialogEl.setAttribute('aria-labelledby', headerId)
    dialogEl.setAttribute('aria-describedby', bodyId)

    let hasScrollLock = false
    const focusReturn = new FocusReturn()

    function collectFocusables(): HTMLElement[] {
      const shadowFocusables = focusableWithin(dialogEl!).filter(
        el => !el.classList.contains('sentinel'),
      )
      const lightFocusables = focusableWithin(host)
      return [...lightFocusables, ...shadowFocusables]
    }

    function focusInitial() {
      const autofocus =
        host.querySelector<HTMLElement>('[autofocus]') ??
        dialogEl!.querySelector<HTMLElement>('[autofocus]')
      if (autofocus) { autofocus.focus(); return }
      const focusables = collectFocusables()
      const primary = focusables.find(el => el !== closeBtn) ?? focusables[0]
      if (primary) primary.focus()
      else dialogEl!.focus()
    }

    function doOpen() {
      focusReturn.save()
      try { dialogEl!.showModal() } catch { /* jsdom */ }
      if (!hasScrollLock) { acquireScrollLock(); hasScrollLock = true }
      queueMicrotask(() => focusInitial())
      host.dispatchEvent(new CustomEvent('sui-open', { bubbles: true, composed: true }))
    }

    function doClose() {
      if ((dialogEl as HTMLDialogElement).open) dialogEl!.close()
    }

    const onNativeClose = () => {
      if (state.$signals.open()) state.$signals.open.set(false)
      if (hasScrollLock) { releaseScrollLock(); hasScrollLock = false }
      focusReturn.restore()
      host.dispatchEvent(new CustomEvent('sui-close', { bubbles: true, composed: true }))
    }

    const onBackdropClick = (e: MouseEvent) => {
      if (!state.$signals.dismissible()) return
      if (e.target === dialogEl) state.$signals.open.set(false)
    }

    // Escape on a modal dialog fires `cancel` before the native close. A
    // non-dismissible drawer must veto it here — preventDefault on cancel is
    // the platform's only hook to keep Escape from closing the dialog.
    const onCancel = (e: Event) => {
      if (!state.$signals.dismissible()) e.preventDefault()
    }

    const onDismiss = () => {
      host.dispatchEvent(new CustomEvent('sui-dismiss', { bubbles: true, composed: true }))
      state.$signals.open.set(false)
    }

    const onSentinelStartFocus = () => {
      const items = collectFocusables()
      if (items.length) items[items.length - 1]!.focus()
    }
    const onSentinelEndFocus = () => {
      const items = collectFocusables()
      if (items.length) items[0]!.focus()
    }

    dialogEl.addEventListener('close', onNativeClose)
    dialogEl.addEventListener('cancel', onCancel)
    dialogEl.addEventListener('click', onBackdropClick)
    closeBtn?.addEventListener('click', onDismiss)
    sentinelStart?.addEventListener('focus', onSentinelStartFocus)
    sentinelEnd?.addEventListener('focus', onSentinelEndFocus)

    const stopOpenSync = effect(() => {
      const wantOpen = state.$signals.open()
      host.setAttribute('data-state', wantOpen ? 'open' : 'closed')
      if (wantOpen && !dialogEl.open) doOpen()
      else if (!wantOpen && dialogEl.open) doClose()
    })

    ;(host as HTMLElement & { show(): void; close(): void }).show = () => state.$signals.open.set(true)
    ;(host as HTMLElement & { close(): void }).close = () => state.$signals.open.set(false)

    return () => {
      if (hasScrollLock) releaseScrollLock()
      dialogEl.removeEventListener('close', onNativeClose)
      dialogEl.removeEventListener('cancel', onCancel)
      dialogEl.removeEventListener('click', onBackdropClick)
      closeBtn?.removeEventListener('click', onDismiss)
      sentinelStart?.removeEventListener('focus', onSentinelStartFocus)
      sentinelEnd?.removeEventListener('focus', onSentinelEndFocus)
      stopOpenSync()
    }
  },
})

</controller>
<dialog part="dialog" role="dialog" aria-modal="true"
  sx="bg:surface-1 fg:card-foreground shadow:xl border:border"
  bind:this={dialogEl}>
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelStart}></span>
  <row align="start" gap="2" class="header" part="header" bind:this={headerEl}>
    <column gap="1" class="header-content">
      <div class="title"><slot name="title"></slot></div>
      <div class="description"><slot name="description"></slot></div>
    </column>
    <button ghost xs class="close" part="close" type="button" aria-label="Close drawer" bind:this={closeBtn}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
        sx="w:icon-size-sm h:icon-size-sm">
        <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/>
      </svg>
    </button>
  </row>
  <div class="body" part="body" bind:this={bodyEl}>
    <slot></slot>
  </div>
  <row align="center" justify="end" gap="2" class="footer" part="footer">
    <slot name="footer"></slot>
  </row>
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelEnd}></span>
</dialog>
