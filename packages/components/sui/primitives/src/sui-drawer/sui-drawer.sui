<!--
  <sui-drawer> — SUI port of <ship-drawer>.
  Side-sheet panel built on the native <dialog> element. Slides in from
  the right (or left) edge instead of centering like sui-dialog.

  Why <dialog> not popover="manual"? <dialog> gives us showModal() modal
  semantics (focus trap, ::backdrop, ESC close) for free. popover="manual"
  would require re-implementing all of that.

  Prop / event / method parity vs <ship-drawer>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  side ('right'|'left')        side (union, 'right', ref)   ✓
  size ('sm'|'md'|'lg')        size (union, 'md', reflect)  ✓
  dismissible (bool, true)     dismissible (bool, true)     ✓ no reflect
  ────────────────────────────────────────────────────────────────────────
  Events: ship-open/close/dismiss → sui-open/close/dismiss              ✓
  Methods: show(), close()                                               ✓
  Slots: title, description, (default), footer                          ✓
  Parts: dialog, header, body, footer, close                            ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="side" values="right|left" default="right" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="dismissible" type="bool" default="true" />

<variants>[hidden]: display:none</variants>

<theme prop="size" channels="dr-w, dr-px, dr-hpy, dr-bpy, dr-fpy">
  default: panel-max-w-md, space-6,    space-4,   space-4,   space-3_5
  sm:      panel-max-w-sm, space-5,    space-3_5, space-3_5, space-3
  lg:      panel-max-w-md, space-7,    space-5,   space-5,   space-4
</theme>

<style>
  /* Local markers so the css-token lint recognizes the channels
   * and tokens referenced from this residual block. */
  --dr-w: ; --dr-px: ; --dr-hpy: ; --dr-bpy: ; --dr-fpy: ;
  --card-foreground: ; --surface-1: ; --border: ; --border-subtle: ; --foreground: ; --muted-foreground: ; --muted: ; --tone-muted-border: ; --space-1: ; --space-2: ; --space-3: ; --space-3_5: ; --space-7: ; --font-body: ; --text-sm: ; --text-base: ; --font-weight-semibold: ; --leading-tight: ; --leading-normal: ; --focus-ring: ; --focus-ring-offset: ; --control-h-sm: ; --icon-size-sm: ; --radius-md: ; --z-elevated: ; --backdrop: ; --shadow-xl: ; --duration-fast: ; --duration-medium: ; --ease-out: ;
  /* Residual — none of the dialog chrome is reachable from sx/variants/theme:
   *   * :host display: contents (no `contents` token in sx)
   *   * position: fixed + top:0; bottom:0; right:0; left:auto + the
   *     side='left' override (top/bottom/right/left aren't sx props)
   *   * the width: min(var(--dr-w), calc(100vw - var(--space-7)))
   *     (calc() is not sx)
   *   * border-left: 1px solid var(--border) (single-side border, sx
   *     `border:` sets all 4 sides) + the side='left' mirror
   *   * font-family (no sx prop)
   *   * display: flex + flex-direction: column (a real <dialog>, not
   *     a wrapper that could become a layout element)
   *   * opacity: 0 + transform: translateX(24px) (no transform / raw
   *     px in sx) + the multi-property transition
   *   * dialog[open] / dialog::backdrop / dialog[open]::backdrop
   *     (the open attribute is on the dialog, not the host — variants
   *     only target host attrs)
   *   * the .close button position + the inline-flex/align/justify
   *     (a real <button>, not a wrapper) + font: inherit reset +
   *     background/border: transparent (no --transparent token in sx)
   *     + the focus-visible outline (raw --focus-ring pair) + the
   *     multi-property transition
   *   * .header / .footer have their flex + gap/align in <row> but
   *     the padding/border/flex-basis/position details stay raw
   *     (padding uses theme channel --dr-px / --dr-hpy; border-top /
   *     border-bottom are single-side; flex shorthand isn't sx)
   *   * .body / .header-content have flex / min-* (not in sx)
   *   * .sentinel absolute + 1×1px (raw)
   *   * .title / .description — typography that doesn't fit a
   *     single-element sx attribute (raw line-height + color)
   *   * @media (prefers-reduced-motion) and @media (forced-colors) */
  :host { display: contents; }

  dialog {
    position: fixed;
    top: 0; bottom: 0;
    right: 0; left: auto;
    margin: 0; padding: 0;
    border: none;
    border-left: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--card-foreground);
    width: min(var(--dr-w), calc(100vw - var(--space-7)));
    max-width: 100vw;
    height: 100%;
    max-height: 100%;
    box-shadow: var(--shadow-xl);
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  :host([side='left']) dialog {
    right: auto; left: 0;
    border-left: none;
    border-right: 1px solid var(--border);
    box-shadow: var(--shadow-xl);
    transform: translateX(-24px);
  }
  dialog[open] { opacity: 1; transform: translateX(0); }

  dialog::backdrop {
    background: var(--backdrop);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  dialog[open]::backdrop { opacity: 1; }

  .sentinel { position: fixed; width: 1px; height: 1px; pointer-events: none; opacity: 0; }

  .header {
    padding: var(--dr-hpy) var(--dr-px);
    padding-right: calc(var(--dr-px) + var(--space-7));
    border-bottom: 1px solid var(--border-subtle);
    flex: 0 0 auto; position: relative;
  }
  .header-content { flex: 1 1 0; min-width: 0; }
  .title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    color: var(--foreground);
  }
  .description {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
    line-height: var(--leading-normal);
  }

  .body {
    flex: 1 1 auto; min-height: 0;
    overflow-y: auto; overscroll-behavior: contain;
    padding: var(--dr-bpy) var(--dr-px);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--muted-foreground);
    scrollbar-width: thin;
  }

  .footer {
    flex: 0 0 auto;
    padding: var(--dr-fpy) var(--dr-px);
    border-top: 1px solid var(--border-subtle);
    background: var(--tone-muted-border);
  }

  .close {
    position: absolute;
    top: var(--space-3); inset-inline-end: var(--space-3);
    width: var(--control-h-sm); height: var(--control-h-sm);
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    cursor: pointer; padding: 0; font: inherit; z-index: var(--z-elevated);
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .close:hover { background: var(--muted); color: var(--foreground); }
  .close:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .close svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }

  @media (prefers-reduced-motion: reduce) {
    dialog { transition: none; transform: none !important; opacity: 1; }
    dialog::backdrop { transition: none; }
  }
  @media (forced-colors: active) {
    dialog { border: 1px solid CanvasText; }
  }
</style>

<dialog part="dialog" role="dialog" aria-modal="true" bind:this={dialogEl}>
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelStart}></span>
  <row align="start" gap="2" class="header" part="header" bind:this={headerEl}>
    <div class="header-content">
      <div class="title"><slot name="title"></slot></div>
      <div class="description"><slot name="description"></slot></div>
    </div>
    <button class="close" part="close" type="button" aria-label="Close drawer" bind:this={closeBtn}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/>
      </svg>
    </button>
  </row>
  <div class="body" part="body" bind:this={bodyEl}>
    <slot></slot>
  </div>
  <row align="center" justify="end" gap="2" class="footer" part="footer">
    <slot name="footer"></slot>
  </row>
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelEnd}></span>
</dialog>
