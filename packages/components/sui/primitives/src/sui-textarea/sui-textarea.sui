<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="name" type="string" default="" />
<prop name="rows" type="number" default="4" />
<prop name="required" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|code" default="default" reflect />
<prop name="size" values="sm|md" default="md" reflect />
<prop name="resize" values="none|vertical|horizontal|both" default="vertical" />
<prop name="label" type="string" default="" />
<prop name="described-by" type="string" default="" />

<theme prop="tone" channels="tone, tone-fg, tone-border">
  default:     ring-color, foreground, ring-color
  primary:     primary, primary, primary
  info:        info, info, info
  success:     success, success, success
  warning:     warning, warning, warning
  destructive: destructive, destructive, destructive
  accent:      accent, accent, accent
  muted:       muted-foreground, muted-foreground, muted-foreground
</theme>

<theme prop="size" channels="ta-px, ta-py, ta-fs, ta-lh, ta-radius">
  sm: space-2_5, space-2,  text-sm,  leading-snug, radius-sm
  md: space-3,   space-2_5, text-base, leading-normal, radius-md
</theme>

<style>
  /* Local markers so the css-token lint recognizes the theme channels
   * and tokens referenced from this residual block. */
  --tone: ; --tone-fg: ; --tone-border: ; --ta-px: ; --ta-py: ; --ta-fs: ; --ta-lh: ; --ta-radius: ; --focus-ring: ; --focus-ring-offset: ; --font-body: ; --mono-font: ; --border: ; --border-subtle: ; --border-strong: ; --background: ; --muted-foreground: ; --muted: ; --foreground: ; --shadow-xs: ; --shadow-sm: ; --tracking-tight: ; --tracking-normal: ; --duration-fast: ; --ease-out: ; --ring-color: ; --tone-destructive-border: ; --destructive: ; --leading-normal-plus: ; --text-base: ;
  /* Residual: `:host` (host element, no sx), the textarea's font
   * (no sx prop), the multi-property transition, the :hover
   * elevation, the focus outline (canonical --focus-ring), the
   * placeholder color, the disabled/readonly state (opacity:0.6 is
   * a raw value), the variant=code mono-font + leading-normal-plus
   * + tab-size:2 (raw value, not a token), the prefers-reduced-
   * motion universal opt-out, and the @media (forced-colors)
   * CanvasText outline. */
  :host { display: block; width: 100%; }
  :host([hidden]) { display: none; }

  textarea {
    font-family: var(--font-body);
    /* De-translated from sx (radius:ta-radius px:ta-px py:ta-py text:ta-fs
       leading:ta-lh) — ad-hoc channels are not sx vocabulary. */
    border-radius: var(--ta-radius);
    padding-inline: var(--ta-px);
    padding-block: var(--ta-py);
    font-size: var(--ta-fs);
    line-height: var(--ta-lh);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled])) textarea:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  textarea:focus-visible, textarea:focus {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-color: var(--tone-border);
  }

  :host([invalid]) textarea,
  :host([invalid]) textarea:hover { border-color: var(--tone-destructive-border); }
  :host([invalid]) textarea:focus-visible,
  :host([invalid]) textarea:focus { border-color: var(--destructive); }

  textarea::placeholder { color: var(--muted-foreground); opacity: 1; }
  textarea:disabled {
    cursor: not-allowed;
    background: var(--muted);
    border-color: var(--border-subtle);
    color: var(--muted-foreground);
    box-shadow: none;
    opacity: 0.6;
  }
  textarea:read-only { cursor: default; }

  :host([variant='code']) textarea {
    font-family: var(--mono-font);
    font-size: var(--text-base);
    line-height: var(--leading-normal-plus);
    letter-spacing: var(--tracking-normal);
    tab-size: 2;
  }

  @media (forced-colors: active) {
    textarea:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<textarea
  part="textarea"
  placeholder={placeholder()}
  name={name()}
  rows={rows()}
  disabled={disabled()}
  required={required()}
  readonly={readonly()}
  aria-invalid={invalid() ? 'true' : 'false'}
  aria-required={required() ? 'true' : 'false'}
  aria-label={label()}
  aria-describedby={describedBy()}
  style:resize={resize()}
  bind:value={value}
  bind:this={textareaEl}
  sx="
    display:block
    w:full
    bg:background
    fg:foreground
    border:border
    tracking:tight
    shadow:xs
  "
></textarea>
