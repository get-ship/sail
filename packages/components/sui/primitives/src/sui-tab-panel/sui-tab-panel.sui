<!--
  <sui-tab-panel> — SUI port of <ship-tab-panel>.

  Companion panel element for <sui-tabs> / <sui-tab>. The parent
  <sui-tabs> controller queries `:scope > sui-tab-panel` and toggles
  the `active` attribute + `hidden` attribute based on the active
  tab name. This component owns the focus-visible ring and the
  fade-in animation that fires when the panel becomes active.

  Prop / event / method parity vs <ship-tab-panel>
  ──────────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ──────────────────────────────────────────────────────────────────────────────
  name (String, '', reflect)       name (string, '',         ✓ keyed against
                                     reflect)                  parent sui-tabs
                                                              active prop
  active (Boolean, false,          active (bool, false,      ✓ driven by parent
    reflect)                         reflect)                  sui-tabs controller
  ──────────────────────────────────────────────────────────────────────────────
  role=tabpanel (connectedCallback) ✓ controller mount        ✓
  tabindex=0 (connectedCallback)   ✓ controller mount        ✓
  id=ship-tabpanel-{name}          id=sui-tabpanel-{name}    matches sui-tabs
                                     (controller effect)       aria-controls
  aria-labelledby=ship-tab-{name}  aria-labelledby=sui-tab   matches sui-tab id
    -{name} (controller effect)
  ──────────────────────────────────────────────────────────────────────────────
  Slots: (default)                  (default)                 ✓
  ──────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ──────────────────────────────────────────────────────────────────────────────
  - The `:host { display: none }` and `:host([active]) { display: block }`
    pair DELETED. The framework's BASE_CSS sets `:host { display: block; }`
    by default and `:host([hidden]) { display: none !important; }` for the
    hidden attribute — and the parent <sui-tabs> controller sets/clears
    `hidden` reactively based on the active tab name (see
    sui-tabs.controller.ts). Display flow is fully framework-owned now.
  - The fade-in animation (opacity + translateY) is preserved on
    `:host([active])` in <style> — it's a real custom motion (not a token),
    and the @keyframes + the `prefers-reduced-motion: no-preference` guard
    have no sx/primitive equivalents.
  - The focus-visible ring (composed box-shadow with --ring-offset and
    --ring-width + --radius-md) is preserved in <style> — the
    global CONTROL_CONTRACTS focus rule uses `outline`, not the two-layer
    inset box-shadow this component paints. The visual treatment is
    component-specific (a glow that matches the panel's own surface, not
    an outline on the host's bounding box).
-->

<component>{
  props: {
    name: '',
    active: false,
  },
}</component>

<!--
  Residual: fade-in keyframe animation (no animation primitive in sx;
  controlled-motion @media guard) and focus-visible ring (composed
  box-shadow with explicit ring-offset, distinct from the framework's
  default outline-based focus indicator on controls).
-->
<style>
  @media (prefers-reduced-motion: no-preference) {
    :host([active]) {
      animation: sui-tab-panel-fade var(--duration-medium) var(--ease-out);
    }
  }
  @keyframes sui-tab-panel-fade {
    from { opacity: 0; transform: translateY(var(--space-1)); }
    to   { opacity: 1; transform: translateY(0); }
  }
  :host(:focus-visible) {
    outline: none;
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        var(--ring);
    border-radius: var(--radius-md);
  }
</style>

<slot></slot>
