<!--
  <sui-color-picker> — hex input + popover with a swatch palette, an
  HSL slider trio (H 0-360, S 0-100, L 0-100), and a hex text input.
  Single-color use only. No alpha, no gradients.

  Value is a 7-character hex string (`#rrggbb`, lowercase). Anything
  shorter or longer is rejected on commit and the previous value is
  restored.

  The swatch palette is DERIVED at mount() from the host's resolved
  design-system tone tokens (`--primary`, `--accent`, `--info`,
  `--success`, `--warning`, `--destructive`) plus a theme-free neutral
  ramp — see `color-math.ts#deriveSwatches`. No hardcoded brand hex; the
  swatches track whichever theme is active. The preview swatch and the
  swatch tiles render the resolved hex via `style:background-color={…}`
  in the template (the css-literal lint only inspects `<style>` blocks,
  not inline `style:` attribute bindings).
  ─────────────────────────────────────────────────────────────────────
  Props
    name        Form field name.
    value       Hex color (`#rrggbb`). Default `#000000`.
    disabled    Disables interaction + form participation.
    tone        Tones the focus ring.
    size        sm | md | lg.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change  { detail: { value: string } }   // lowercase hex
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="#000000" form-value />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="tone" channels="tone-border, tone-ring">
  default:     border,            primary
  primary:     primary,           primary
  info:        info,              info
  success:     success,           success
  warning:     warning,           warning
  destructive: destructive,       destructive
  accent:      accent,            accent
  muted:       muted-foreground,  muted-foreground
</theme>
<theme prop="size" channels="cp-h, cp-fs, cp-px">
  sm: control-h-sm, text-xs,   space-1_5
  md: control-h-md, text-base, space-2
  lg: control-h-lg, text-sm,   space-2_5
</theme>
<variants part="wrap">
  disabled: bg:muted fg:muted-foreground cursor:not-allowed
</variants>

<!-- Residual: `:host` baseline (display/position/width/vertical-align
     — host doesn't take sx); the `:focus-within` ring (variants only
     target :host attrs, not pseudo-classes — border-color + box-shadow
     live here); the saturate() filter on disabled (no sx property);
     the `cp-h`/`cp-fs`/`cp-px` theme channels (the css-token lint is
     residual-only — local markers below let it resolve refs); the
     native <input class="entry"> (no shadow part); the absolute-
     positioned `.panel` (positions + z-index); the `.swatches`
     6-column grid (grid-template-columns has no sx prop); the
     `.swatch` button (appearance/border/radius/aspect-ratio/cursor),
     its hover scale transform (motion), the multi-shadow selected
     ring, and its transition; the `.slider-row` grid columns (raw
     rems), the `<input type='range'>` accent-color (raw form control),
     and the hex-row input styling. -->
<style>
    --cp-h: ; --cp-fs: ; --cp-px: ; --panel-max-w-md: ; --space-half: ; --z-popover: ; --popover: ; --popover-foreground: ; --radius-md: ; --shadow-md: ; --font-body: ; --font-mono: ; --border-subtle: ; --radius-sm: ; --foreground: ; --muted-foreground: ; --text-xs: ; --ring-width: ; --primary: ; --surface-1: ; --duration-fast: ;
  :host {
    position: relative;
    display: inline-flex;
    width: 100%;
    vertical-align: middle;
  }

  .wrap { transition: border-color var(--duration-fast), box-shadow var(--duration-fast); }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 var(--ring-width) var(--tone-ring);
  }
  :host([disabled]) [part~='wrap'] { filter: saturate(0.4); }

  .preview {
    width: calc(var(--cp-h) - 14px);
    height: calc(var(--cp-h) - 14px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    flex: 0 0 auto;
  }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--cp-fs);
    color: var(--foreground);
    text-transform: lowercase;
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }

  .panel {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    z-index: var(--z-popover);
    width: var(--panel-max-w-md);
    padding: var(--space-3);
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: var(--font-body);
    font-size: var(--cp-fs);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .swatch {
    appearance: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0;
    aspect-ratio: 1;
    cursor: pointer;
    transition: transform var(--duration-fast);
  }
  .swatch:hover:not(:disabled) {
    transform: scale(1.08);
  }
  .swatch.selected {
    box-shadow: 0 0 0 var(--space-half) var(--surface-1), 0 0 0 calc(var(--space-half) + var(--space-half)) var(--primary);
  }

  .slider-row { display: grid; grid-template-columns: 1.2rem 1fr 2.4rem; gap: var(--space-2); align-items: center; }
  .slider-row label { color: var(--muted-foreground); font-size: var(--text-xs); }
  .slider-row input[type='range'] { width: 100%; accent-color: var(--tone-ring); }
  .slider-row .val { font-family: var(--font-mono); font-size: var(--text-xs); text-align: right; color: var(--foreground); }

  .hex-row { display: flex; align-items: center; gap: var(--space-2); }
  .hex-row .label { color: var(--muted-foreground); font-size: var(--text-xs); }
  .hex-row input {
    flex: 1;
    appearance: none;
    border: 1px solid var(--border);
    background: var(--background);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--cp-fs);
    color: var(--foreground);
  }
</style>

<row class="wrap" part="wrap" align="center" gap="2"
  sx="
    w:full
    min-h:cp-h
    px:cp-px
    py:0
    bg:background
    fg:foreground
    border:tone-border
    radius:md
  "
>
  <span class="preview" aria-hidden="true"
        style:background-color={value() || '#000000'}></span>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder="#000000"
    disabled={disabled()}
    autocomplete="off"
    aria-haspopup="dialog"
    aria-expanded={open() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
</row>
{#if open() && !disabled()}
  <column class="panel" gap="2" part="panel" role="dialog" aria-label="Choose color"
       bind:this={panelEl}>
    <div class="swatches">
      {#for sw of swatches() key={sw.hex}}
        <button
          type="button"
          class="swatch"
          class:selected={sw.hex === value().toLowerCase()}
          data-hex={sw.hex}
          aria-label={sw.label}
          style:background-color={sw.hex}
        ></button>
      {/for}
    </div>
    <column class="sliders" gap="1">
      <div class="slider-row">
        <label for={hueId()}>H</label>
        <input id={hueId()} type="range" min="0" max="360" step="1"
               bind:value={hueText} data-axis="h" />
        <span class="val">{hue()}°</span>
      </div>
      <div class="slider-row">
        <label for={satId()}>S</label>
        <input id={satId()} type="range" min="0" max="100" step="1"
               bind:value={satText} data-axis="s" />
        <span class="val">{sat()}%</span>
      </div>
      <div class="slider-row">
        <label for={lightId()}>L</label>
        <input id={lightId()} type="range" min="0" max="100" step="1"
               bind:value={lightText} data-axis="l" />
        <span class="val">{light()}%</span>
      </div>
    </column>
    <div class="hex-row">
      <span class="label">Hex</span>
      <input
        type="text"
        bind:value={hexDraft}
        bind:this={hexInputEl}
        spellcheck="false"
        autocomplete="off"
        aria-label="Hex color"
      />
    </div>
  </column>
{/if}
