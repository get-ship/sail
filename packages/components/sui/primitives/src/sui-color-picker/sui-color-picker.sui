<!--
  <sui-color-picker> — hex input + popover with a swatch palette, an
  HSL slider trio (H 0-360, S 0-100, L 0-100), and a hex text input.
  Single-color use only. No alpha, no gradients.

  Value is a 7-character hex string (`#rrggbb`, lowercase). Anything
  shorter or longer is rejected on commit and the previous value is
  restored.

  The swatch palette is DERIVED at mount() from the host's resolved
  design-system tone tokens (`--primary`, `--accent`, `--info`,
  `--success`, `--warning`, `--destructive`) plus a theme-free neutral
  ramp — see `color-math.ts#deriveSwatches`. No hardcoded brand hex; the
  swatches track whichever theme is active. The preview swatch and the
  swatch tiles render the resolved hex via `style:background-color={…}`
  in the template (the css-literal lint only inspects `<style>` blocks,
  not inline `style:` attribute bindings).
  ─────────────────────────────────────────────────────────────────────
  Props
    name        Form field name.
    value       Hex color (`#rrggbb`). Default `#000000`.
    disabled    Disables interaction + form participation.
    tone        Tones the focus ring.
    size        sm | md | lg.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change  { detail: { value: string } }   // lowercase hex
  ─────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone is a GLOBAL framework channel (contracts.css / suiTonesSheet):
    no per-component <theme prop="tone"> block. The wrap and the
    HSL <input type=range> accent-color read var(--tone-border) /
    var(--tone-ring) directly, filled for whichever of the 8 catalog
    tones the host's [tone] attribute names.
  - size is a GLOBAL framework channel: no per-component <theme
    prop="size"> block. --size-h / --size-px / --size-fs are filled
    for whichever size the host's [size] attribute names; the wrap
    consumes them via min-h:size-h and px:size-px.
  - The trigger entry is a bare framework-styled <input> — the input
    skin (font, background, border, focus ring) is the framework's
    L1 input contract, no .entry class to hand-author. Per the alert
    pilot's precedented control-skin trade, the hand-rolled font-
    mono override is kept in <style> (a closed-vocab exception, not
    a sx atom — the global input contract sets font-family to the
    body font, but the color-picker's hex is intentionally mono).
  - The popover panel is a plain div, not <sui-popover> — the picker
    owns its open/close behavior (input click, doc-pointer dismissal,
    Escape) and renders into the picker's own shadow tree; reusing
    <sui-popover> would require lifting those handlers out.
  - sx is closed-vocabulary; <style> keeps only what sx structurally
    cannot express: the native <input type=range> accent-color
    (a raw form control, not in the framework skin set), the
    `.swatches` 6-col grid (grid-template-columns has no sx prop),
    the `.swatch` button (appearance/border/radius/aspect-ratio/
    cursor + hover scale transform + the multi-shadow selected
    ring), the `.slider-row` grid (raw rem column widths — no sx
    story), the `text-transform: lowercase` (no sx prop), the
    panel's `position: absolute` + `top` + `left` (sx has
    `position:absolute` but no `top`/`left` props), the host-driven
    `:host([disabled]) .wrap { filter: saturate(0.4) }` saturate
    (compound host-attr → descendant selector — variants only
    target the class element itself), and the input's font-mono +
    min-width + flex (no `flex`/`min-width` in sx). See the
    residual-rationale comment in <style> below for the full list.
-->
<prop name="name" type="string" default="" />
<prop name="value" type="string" default="#000000" form-value />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<!--
  Residual <style>:
  - :host baseline (display:inline-flex / width:100% / vertical-align)
  - The host-driven disabled saturate (host-attr → descendant compound
    selector — variants only target the class element itself, not
    descendants of :host attrs)
  - entry input: text-transform:lowercase + font-family:mono
    (text-transform has no sx prop; font-family-override keeps the
    hex readable as code while the L1 contract sets the body font)
  - swatch button + selection ring: appearance, border, radius,
    aspect-ratio, cursor, the hover scale transform, the multi-
    shadow selected ring (a shape `ring:` can't produce — it emits
    the framework's 2-layer OUTER glow, never the inset halo +
    tone border the swatch palette needs)
  - slider-row grid: 3-col grid (label / range / value) with raw
    rem column widths + the .val mono font + the <input type=range>
    accent-color (raw form control)
  - hex-row: flex layout + label spacing (no sx)
-->
<!--
  --size-h/--size-px/--size-fs are the global size channels (adopted
  from the framework's SIZES_CSS into every shadow root via
  adoptSuiSheets). They're NOT in tokens.css, so the css-token lint
  doesn't recognize them — declare empty markers in this style block
  to satisfy the lint. Same pattern as sui-select.
-->
<style>
  --size-h: ; --size-px: ; --size-fs: ;
  :host {
    display: inline-flex;
    width: 100%;
    vertical-align: middle;
    /* The .panel is position:absolute; anchor it to the host, else it escapes
       to the nearest positioned ancestor (page) and renders off-screen. */
    position: relative;
  }
  :host([hidden]) { display: none; }
  :host([disabled]) .wrap { filter: saturate(0.4); }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font-family: var(--font-mono);
    text-transform: lowercase;
  }
  input.entry::placeholder { color: var(--muted-foreground); }

  .swatches {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-2);
  }
  .swatch {
    appearance: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0;
    aspect-ratio: 1;
    cursor: pointer;
    transition: transform var(--duration-fast);
  }
  .swatch:hover:not(:disabled) { transform: scale(1.08); }
  .swatch.selected {
    box-shadow:
      0 0 0 var(--space-1) var(--surface-1),
      0 0 0 calc(var(--space-1) + var(--space-1)) var(--primary);
  }

  .slider-row {
    display: grid;
    grid-template-columns: 1.2rem 1fr 2.4rem;
    gap: var(--space-2);
    align-items: center;
  }
  .slider-row label {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }
  .slider-row input[type='range'] {
    width: 100%;
    accent-color: var(--tone-ring);
  }
  .slider-row .val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: right;
    color: var(--foreground);
  }

  .hex-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hex-row .label {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }
  .hex-row input { flex: 1; }

  .preview {
    width: calc(var(--size-h) - 14px);
    height: calc(var(--size-h) - 14px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    flex: 0 0 auto;
  }

  .panel {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    font-family: var(--font-body);
  }
</style>


<controller>
import { controller, effect, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import {
  type Swatch,
  deriveSwatches,
  hexToRgb,
  hslToHex,
  isHex,
  normHex,
  rgbToHsl,
} from './color-math'
import type { Scope } from './sui-color-picker.sui'

let idSeq = 0

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const open = signal(false)
    const hue = signal(0)
    const sat = signal(0)
    const light = signal(0)
    const hueText = signal('0')
    const satText = signal('0')
    const lightText = signal('0')
    const hexDraft = signal('')
    const inputEl = ref<HTMLInputElement>(null)
    const panelEl = ref<HTMLDivElement>(null)
    const hexInputEl = ref<HTMLInputElement>(null)
    const id = ++idSeq
    const hueId = signal(`sui-color-picker-h-${id}`)
    const satId = signal(`sui-color-picker-s-${id}`)
    const lightId = signal(`sui-color-picker-l-${id}`)
    // Theme-derived at mount() from the host's computed tone tokens — never a
    // hardcoded palette. Seeded empty; populated once the host is connected.
    const swatches = signal<Swatch[]>([])
    return {
      open, hue, sat, light, hueText, satText, lightText, hexDraft,
      inputEl, panelEl, hexInputEl, hueId, satId, lightId, swatches,
    }
  },

  mount(state, host) {
    let suppress = false

    // Derive the swatch palette from the host's resolved design-system tone
    // tokens (+ a neutral ramp) now that the element is connected and the
    // cascade is in effect.
    state.swatches = deriveSwatches(host)

    const emit = (hex: string) => {
      host.dispatchEvent(
        new CustomEvent('sui-change', {
          detail: { value: hex },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const syncFromHex = (hex: string) => {
      const rgb = hexToRgb(hex)
      if (!rgb) return
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b)
      suppress = true
      state.hue = hsl.h
      state.sat = hsl.s
      state.light = hsl.l
      state.hueText = String(hsl.h)
      state.satText = String(hsl.s)
      state.lightText = String(hsl.l)
      state.hexDraft = hex
      suppress = false
    }

    const commitHex = (raw: string) => {
      const norm = normHex(raw)
      if (!norm) return false
      state.value = norm
      syncFromHex(norm)
      emit(norm)
      return true
    }

    // External value → internal HSL.
    const stopValueSync = effect(() => {
      const v = state.value
      if (suppress) return
      if (isHex(v as string)) syncFromHex(v as string)
    })

    // Initial seed.
    if (isHex(state.value as string)) syncFromHex(state.value as string)

    // Slider edits → value.
    const sliderEffect = effect(() => {
      const h = Number(state.hueText)
      const s = Number(state.satText)
      const l = Number(state.lightText)
      if (suppress) return
      if (!Number.isFinite(h) || !Number.isFinite(s) || !Number.isFinite(l)) return
      const hex = hslToHex(h, s, l)
      state.hue = Math.round(h)
      state.sat = Math.round(s)
      state.light = Math.round(l)
      if (hex !== (state.value as string).toLowerCase()) {
        suppress = true
        state.value = hex
        state.hexDraft = hex
        suppress = false
        emit(hex)
      }
    })

    const inputEl = state.inputEl as HTMLInputElement | null
    if (!inputEl) return

    const openPanel = () => {
      if (state.disabled || state.open) return
      state.open = true
    }
    const closePanel = () => {
      if (!state.open) return
      state.open = false
    }

    const onInputClick = () => openPanel()
    const onInputChange = () => {
      // User typed a hex in the trigger input.
      const v = inputEl.value.trim()
      if (v === '') return
      if (!commitHex(v)) inputEl.value = state.value as string
    }
    const onInputKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && state.open) {
        e.preventDefault()
        closePanel()
      } else if (e.key === 'ArrowDown' && !state.open) {
        e.preventDefault()
        openPanel()
      }
    }
    inputEl.addEventListener('click', onInputClick)
    inputEl.addEventListener('change', onInputChange)
    inputEl.addEventListener('keydown', onInputKeydown)

    const onShadowClick = (e: Event) => {
      const t = e.target as HTMLElement | null
      const sw = t?.closest?.('button.swatch[data-hex]') as HTMLElement | null
      if (sw) {
        const hex = (sw.dataset.hex ?? '').toLowerCase()
        if (isHex(hex)) commitHex(hex)
      }
    }
    const onHexInputChange = (e: Event) => {
      const t = e.target as HTMLInputElement | null
      if (!t || !t.matches('.hex-row input')) return
      if (!commitHex(t.value)) t.value = state.value as string
    }

    const onDocPointer = (e: Event) => {
      if (!state.open) return
      const path = e.composedPath()
      if (path.includes(host)) return
      closePanel()
    }

    host.shadowRoot?.addEventListener('click', onShadowClick)
    host.shadowRoot?.addEventListener('change', onHexInputChange)
    document.addEventListener('pointerdown', onDocPointer)

    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      open: openPanel,
      close: closePanel,
    })

    return () => {
      stopValueSync()
      sliderEffect()
      inputEl.removeEventListener('click', onInputClick)
      inputEl.removeEventListener('change', onInputChange)
      inputEl.removeEventListener('keydown', onInputKeydown)
      host.shadowRoot?.removeEventListener('click', onShadowClick)
      host.shadowRoot?.removeEventListener('change', onHexInputChange)
      document.removeEventListener('pointerdown', onDocPointer)
    }
  },
})

</controller>
<row class="wrap" part="wrap" align="center" gap="2"
  sx="min-h:size-h py:0 px:size-px bg:background fg:foreground border:tone-border radius:md">
  <span class="preview" part="preview" aria-hidden="true"
    style:background-color={value() || '#000000'}></span>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder="#000000"
    disabled={disabled()}
    autocomplete="off"
    aria-haspopup="dialog"
    aria-expanded={open() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
</row>
{#if open() && !disabled()}
  <column class="panel" part="panel" gap="2" role="dialog" aria-label="Choose color"
       bind:this={panelEl}
       sx="position:absolute z:popover w:panel-max-w-md p:3 bg:popover fg:popover-foreground border:border radius:md shadow:md text:size-fs">
    <div class="swatches" part="swatches">
      {#for sw of swatches() key={sw.hex}}
        <button
          type="button"
          class="swatch"
          class:selected={sw.hex === value().toLowerCase()}
          data-hex={sw.hex}
          aria-label={sw.label}
          style:background-color={sw.hex}
        ></button>
      {/for}
    </div>
    <column class="sliders" gap="1">
      <div class="slider-row">
        <label for={hueId()}>H</label>
        <input id={hueId()} type="range" min="0" max="360" step="1"
               bind:value={hueText} data-axis="h" />
        <span class="val">{hue()}°</span>
      </div>
      <div class="slider-row">
        <label for={satId()}>S</label>
        <input id={satId()} type="range" min="0" max="100" step="1"
               bind:value={satText} data-axis="s" />
        <span class="val">{sat()}%</span>
      </div>
      <div class="slider-row">
        <label for={lightId()}>L</label>
        <input id={lightId()} type="range" min="0" max="100" step="1"
               bind:value={lightText} data-axis="l" />
        <span class="val">{light()}%</span>
      </div>
    </column>
    <div class="hex-row">
      <span class="label">Hex</span>
      <input
        type="text"
        bind:value={hexDraft}
        bind:this={hexInputEl}
        spellcheck="false"
        autocomplete="off"
        aria-label="Hex color"
      />
    </div>
  </column>
{/if}
