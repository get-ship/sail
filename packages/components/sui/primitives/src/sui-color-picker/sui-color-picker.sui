<!--
  <sui-color-picker> — hex text entry + swatch grid + HSL sliders in a popover
  panel. `value` is a `#rrggbb` hex; tone drives the focus ring; size fills the
  control channels. Native range inputs take the tone through the framework's
  accent-color contract.
-->

<component>{
  props: {
    name: '',
    value: '#000000',
    disabled: false,
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    size: 'md' | 'sm' | 'lg',
  },
}</component>
<controller>
import { controller, effect, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import {
  type Swatch,
  deriveSwatches,
  hexToRgb,
  hslToHex,
  isHex,
  normHex,
  rgbToHsl,
} from './color-math'
import type { Scope } from './sui-color-picker.sui'

let idSeq = 0

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const open = signal(false)
    const hue = signal(0)
    const sat = signal(0)
    const light = signal(0)
    const hueText = signal('0')
    const satText = signal('0')
    const lightText = signal('0')
    const hexDraft = signal('')
    const inputEl = ref<HTMLInputElement>(null)
    const panelEl = ref<HTMLDivElement>(null)
    const hexInputEl = ref<HTMLInputElement>(null)
    const id = ++idSeq
    const hueId = signal(`sui-color-picker-h-${id}`)
    const satId = signal(`sui-color-picker-s-${id}`)
    const lightId = signal(`sui-color-picker-l-${id}`)
    // Theme-derived at mount() from the host's computed tone tokens — never a
    // hardcoded palette. Seeded empty; populated once the host is connected.
    const swatches = signal<Swatch[]>([])
    return {
      open, hue, sat, light, hueText, satText, lightText, hexDraft,
      inputEl, panelEl, hexInputEl, hueId, satId, lightId, swatches,
    }
  },

  mount(state, host) {
    let suppress = false

    // Derive the swatch palette from the host's resolved design-system tone
    // tokens (+ a neutral ramp) now that the element is connected and the
    // cascade is in effect.
    state.swatches = deriveSwatches(host)

    const emit = (hex: string) => {
      host.dispatchEvent(
        new CustomEvent('sui-change', {
          detail: { value: hex },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const syncFromHex = (hex: string) => {
      const rgb = hexToRgb(hex)
      if (!rgb) return
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b)
      suppress = true
      state.hue = hsl.h
      state.sat = hsl.s
      state.light = hsl.l
      state.hueText = String(hsl.h)
      state.satText = String(hsl.s)
      state.lightText = String(hsl.l)
      state.hexDraft = hex
      suppress = false
    }

    const commitHex = (raw: string) => {
      const norm = normHex(raw)
      if (!norm) return false
      state.value = norm
      syncFromHex(norm)
      emit(norm)
      return true
    }

    // External value → internal HSL.
    const stopValueSync = effect(() => {
      const v = state.value
      if (suppress) return
      if (isHex(v as string)) syncFromHex(v as string)
    })

    // Initial seed.
    if (isHex(state.value as string)) syncFromHex(state.value as string)

    // Slider edits → value.
    const sliderEffect = effect(() => {
      const h = Number(state.hueText)
      const s = Number(state.satText)
      const l = Number(state.lightText)
      if (suppress) return
      if (!Number.isFinite(h) || !Number.isFinite(s) || !Number.isFinite(l)) return
      const hex = hslToHex(h, s, l)
      state.hue = Math.round(h)
      state.sat = Math.round(s)
      state.light = Math.round(l)
      if (hex !== (state.value as string).toLowerCase()) {
        suppress = true
        state.value = hex
        state.hexDraft = hex
        suppress = false
        emit(hex)
      }
    })

    const inputEl = state.inputEl as HTMLInputElement | null
    if (!inputEl) return

    const openPanel = () => {
      if (state.disabled || state.open) return
      state.open = true
    }
    const closePanel = () => {
      if (!state.open) return
      state.open = false
    }

    const onInputClick = () => openPanel()
    const onInputChange = () => {
      // User typed a hex in the trigger input.
      const v = inputEl.value.trim()
      if (v === '') return
      if (!commitHex(v)) inputEl.value = state.value as string
    }
    const onInputKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && state.open) {
        e.preventDefault()
        closePanel()
      } else if (e.key === 'ArrowDown' && !state.open) {
        e.preventDefault()
        openPanel()
      }
    }
    inputEl.addEventListener('click', onInputClick)
    inputEl.addEventListener('change', onInputChange)
    inputEl.addEventListener('keydown', onInputKeydown)

    const onShadowClick = (e: Event) => {
      const t = e.target as HTMLElement | null
      const sw = t?.closest?.('button[data-hex]') as HTMLElement | null
      if (sw) {
        const hex = (sw.dataset.hex ?? '').toLowerCase()
        if (isHex(hex)) commitHex(hex)
      }
    }
    const onHexInputChange = (e: Event) => {
      const t = e.target as HTMLInputElement | null
      if (!t || !t.matches('input[type="text"]')) return
      if (!commitHex(t.value)) t.value = state.value as string
    }

    const onDocPointer = (e: Event) => {
      if (!state.open) return
      const path = e.composedPath()
      if (path.includes(host)) return
      closePanel()
    }

    ;(host.shadowRoot ?? host).addEventListener('click', onShadowClick)
    ;(host.shadowRoot ?? host).addEventListener('change', onHexInputChange)
    document.addEventListener('pointerdown', onDocPointer)

    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      open: openPanel,
      close: closePanel,
    })

    return () => {
      stopValueSync()
      sliderEffect()
      inputEl.removeEventListener('click', onInputClick)
      inputEl.removeEventListener('change', onInputChange)
      inputEl.removeEventListener('keydown', onInputKeydown)
      ;(host.shadowRoot ?? host).removeEventListener('click', onShadowClick)
      ;(host.shadowRoot ?? host).removeEventListener('change', onHexInputChange)
      document.removeEventListener('pointerdown', onDocPointer)
    }
  },
})

</controller>
<column gap="0" sx="relative w-full">
<row align="center" gap="2" sx="w-full min-h-size-h py-0 px-size-px bg-background text-foreground border border-tone-border rounded-md focus-within:ring-tone-ring">
  <span aria-hidden="true" style:background-color={value() || '#000000'} sx="w-4 h-4 min-w-4 rounded-sm border border-border-subtle"></span>
  <input type="text" flush sx="grow-1 min-w-0 font-mono lowercase" name={name()} placeholder="#000000" disabled={disabled()} autocomplete="off" aria-haspopup="dialog" aria-expanded={open() ? 'true' : 'false'} bind:value={value} bind:this={inputEl} />
</row>
{#if open() && !disabled()}
  <column gap="2" role="dialog" aria-label="Choose color" bind:this={panelEl} sx="absolute left-0 z-popover w-panel-max-w-md p-3 mt-1 bg-popover text-popover-foreground border border-border rounded-md shadow-md text-size-fs">
    <grid cols="6" gap="2">
      {#for sw of swatches() key={sw.hex}}
        <button
          type="button"
          aria-selected={sw.hex === value().toLowerCase() ? 'true' : 'false'}
          data-hex={sw.hex}
          aria-label={sw.label}
          style:background-color={sw.hex}
          sx="border border-border-subtle rounded-sm p-0 aspect-square cursor-pointer selected:ring-primary"
        ></button>
      {/for}
    </grid>
    <column gap="1">
      <row align="center" gap="2">
        <label for={hueId()} sx="w-4 text-muted-foreground">H</label>
        <input id={hueId()} type="range" min="0" max="360" step="1"
               bind:value={hueText} data-axis="h" sx="grow-1 min-w-0" />
        <span sx="w-8 text-end text-muted-foreground">{hue()}°</span>
      </row>
      <row align="center" gap="2">
        <label for={satId()} sx="w-4 text-muted-foreground">S</label>
        <input id={satId()} type="range" min="0" max="100" step="1"
               bind:value={satText} data-axis="s" sx="grow-1 min-w-0" />
        <span sx="w-8 text-end text-muted-foreground">{sat()}%</span>
      </row>
      <row align="center" gap="2">
        <label for={lightId()} sx="w-4 text-muted-foreground">L</label>
        <input id={lightId()} type="range" min="0" max="100" step="1"
               bind:value={lightText} data-axis="l" sx="grow-1 min-w-0" />
        <span sx="w-8 text-end text-muted-foreground">{light()}%</span>
      </row>
    </column>
    <row align="center" gap="2">
      <span sx="text-muted-foreground">Hex</span>
      <input
        type="text"
        bind:value={hexDraft}
        bind:this={hexInputEl}
        spellcheck="false"
        autocomplete="off"
        aria-label="Hex color"
        sx="grow-1 min-w-0 font-mono lowercase"
      />
    </row>
  </column>
{/if}
</column>
