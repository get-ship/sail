<!--
  <sui-color-picker> — hex input + popover with a swatch palette, an
  HSL slider trio (H 0-360, S 0-100, L 0-100), and a hex text input.
  Single-color use only. No alpha, no gradients.

  Value is a 7-character hex string (`#rrggbb`, lowercase). Anything
  shorter or longer is rejected on commit and the previous value is
  restored.

  The swatch palette is DERIVED at mount() from the host's resolved
  design-system tone tokens (`--primary`, `--accent`, `--info`,
  `--success`, `--warning`, `--destructive`) plus a theme-free neutral
  ramp — see `color-math.ts#deriveSwatches`. No hardcoded brand hex; the
  swatches track whichever theme is active. The preview swatch and the
  swatch tiles render the resolved hex via `style:background-color={…}`
  in the template (the css-literal lint only inspects `<style>` blocks,
  not inline `style:` attribute bindings).
  ─────────────────────────────────────────────────────────────────────
  Props
    name        Form field name.
    value       Hex color (`#rrggbb`). Default `#000000`.
    disabled    Disables interaction + form participation.
    tone        Tones the focus ring.
    size        sm | md | lg.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change  { detail: { value: string } }   // lowercase hex
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="#000000" form-value />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    position: relative;
    display: inline-flex;
    width: 100%;
    vertical-align: middle;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: 34px;
    --fs: 13px;
    --px: 8px;
  }
  :host([tone='primary'])     { --tone-border: var(--primary);          --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);              --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);           --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);           --tone-ring: var(--warning); }
  :host([tone='destructive']) { --tone-border: var(--destructive);       --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);            --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground);  --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: 28px; --fs: 12px; --px: 6px; }
  :host([size='md']) { --h: 34px; --fs: 13px; --px: 8px; }
  :host([size='lg']) { --h: 40px; --fs: 14px; --px: 10px; }

  .wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    background: var(--background);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 3px var(--tone-ring);
  }
  :host([disabled]) .wrap {
    background: var(--muted);
    color: var(--muted-foreground);
    filter: saturate(0.4);
    cursor: not-allowed;
  }

  .preview {
    width: calc(var(--h) - 14px);
    height: calc(var(--h) - 14px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    flex: 0 0 auto;
  }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--fs);
    color: var(--foreground);
    text-transform: lowercase;
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }

  .panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: var(--z-popover);
    width: 260px;
    padding: var(--space-3);
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: var(--font-body);
    font-size: var(--fs);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-2);
  }
  .swatch {
    appearance: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0;
    aspect-ratio: 1;
    cursor: pointer;
    transition: transform var(--duration-fast);
  }
  .swatch:hover:not(:disabled) {
    transform: scale(1.08);
  }
  .swatch.selected {
    box-shadow: 0 0 0 2px var(--surface-1), 0 0 0 4px var(--primary);
  }


  .slider-row { display: grid; grid-template-columns: 1.2rem 1fr 2.4rem; gap: var(--space-2); align-items: center; }
  .slider-row label { color: var(--muted-foreground); font-size: 0.75rem; }
  .slider-row input[type='range'] { width: 100%; accent-color: var(--tone-ring); }
  .slider-row .val { font-family: var(--font-mono); font-size: 0.75rem; text-align: right; color: var(--foreground); }

  .hex-row { display: flex; align-items: center; gap: var(--space-2); }
  .hex-row .label { color: var(--muted-foreground); font-size: 0.75rem; }
  .hex-row input {
    flex: 1;
    appearance: none;
    border: 1px solid var(--border);
    background: var(--background);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--fs);
    color: var(--foreground);
  }
</style>

<div class="wrap" part="wrap">
  <span class="preview" aria-hidden="true"
        style:background-color={value() || '#000000'}></span>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder="#000000"
    disabled={disabled()}
    autocomplete="off"
    aria-haspopup="dialog"
    aria-expanded={open() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
</div>
{#if open() && !disabled()}
  <column class="panel" gap="2" part="panel" role="dialog" aria-label="Choose color"
       bind:this={panelEl}>
    <div class="swatches">
      {#for sw of swatches() key={sw.hex}}
        <button
          type="button"
          class="swatch"
          class:selected={sw.hex === value().toLowerCase()}
          data-hex={sw.hex}
          aria-label={sw.label}
          style:background-color={sw.hex}
        ></button>
      {/for}
    </div>
    <column class="sliders" gap="1">
      <div class="slider-row">
        <label for={hueId()}>H</label>
        <input id={hueId()} type="range" min="0" max="360" step="1"
               bind:value={hueText} data-axis="h" />
        <span class="val">{hue()}°</span>
      </div>
      <div class="slider-row">
        <label for={satId()}>S</label>
        <input id={satId()} type="range" min="0" max="100" step="1"
               bind:value={satText} data-axis="s" />
        <span class="val">{sat()}%</span>
      </div>
      <div class="slider-row">
        <label for={lightId()}>L</label>
        <input id={lightId()} type="range" min="0" max="100" step="1"
               bind:value={lightText} data-axis="l" />
        <span class="val">{light()}%</span>
      </div>
    </column>
    <div class="hex-row">
      <span class="label">Hex</span>
      <input
        type="text"
        bind:value={hexDraft}
        bind:this={hexInputEl}
        spellcheck="false"
        autocomplete="off"
        aria-label="Hex color"
      />
    </div>
  </column>
{/if}
