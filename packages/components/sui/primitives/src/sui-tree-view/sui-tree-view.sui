<!--
  <sui-tree-view> — SUI port of <ship-tree-view>.
  Container for a recursive expandable hierarchy. Pairs with <sui-tree-item>.

  Prop parity vs <ship-tree-view>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                         SUI                         Notes
  ─────────────────────────────────────────────────────────────────────────────
  (no props)                  (no props)                  ✓
  ─────────────────────────────────────────────────────────────────────────────
  role=tree set via           controller sets on host     ✓
    connectedCallback
  ─────────────────────────────────────────────────────────────────────────────
  Slots: (default) sui-tree-item children
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - No props at all, so no tone/L1-control/closed-sx surface to touch here.
  - The old .sui-tree-view[hidden] { display: none; } raw selector becomes a real
    variants block (below), targeting the host's own [hidden] attribute —
    exactly what variants blocks are for. The typography + child <ul> reset
    stay raw (see the residual note below); nothing else in this file changed.
  - Anatomy (light DOM): host (role=tree) > ul > sui-tree-item (one per root
    node) when nodes() is non-empty, else a bare default slot.
-->

<variants>
  [hidden]: display:none
</variants>

<!-- Residual: the .sui-tree-view font/typography (no sx prop for font-family
     or font-size — and the .sui-tree-view-level typography only matters for
     inheritance since the host element itself doesn't render text);
     the `ul { list-style: none; margin: 0; padding: 0; }` reset for
     the child <ul> descendant (variants only target .sui-tree-view's own
     attrs). -->
<style>
  .sui-tree-view {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  ul { list-style: none; margin: 0; padding: 0; }
</style>


<controller>
import { controller, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-tree-view.sui'

export interface TreeNode {
  id: string
  label: string
  /** Optional per-node `<sui-icon>` name — lets a file tree show a glyph per
   *  file type. Rendered by `<sui-tree>` ahead of the label; falls back to the
   *  `node-icon` slot when unset. */
  icon?: string
  children?: TreeNode[]
}

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const nodes = signal<TreeNode[]>([])
    return { nodes }
  },

  mount(state, host) {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const initNodes = (host as any).nodes
    if (initNodes != null) state.nodes = initNodes

    Object.defineProperty(host, 'nodes', {
      configurable: true,
      get: () => state.nodes,
      set: (v: TreeNode[]) => { state.nodes = v },
    })

    if (!host.hasAttribute('role')) host.setAttribute('role', 'tree')
  },
})

</controller>
{#if nodes().length > 0}
<ul role="tree">
  {#for n of nodes() key={n.id}}
    <sui-tree-item prop:node={n}></sui-tree-item>
  {/for}
</ul>
{:else}
<slot></slot>
{/if}
