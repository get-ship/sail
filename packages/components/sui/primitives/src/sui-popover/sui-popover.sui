<!--
  <sui-popover> — a floating surface anchored to a trigger, backed by the
  native HTML popover API. `popover="auto"` gives the platform's top-layer
  render, light-dismiss, ESC, and focus-return; we contribute only the three
  things the platform leaves open — and each via the ONE shared implementation,
  not a hand-rolled copy:

    • open state  → usePopover() (the handle IS bindPopover: showPopover /
                    hidePopover <-> signal, toggle-sync). The `open` prop
                    bridges to it.
    • placement   → use:anchor={placement} (the family's single positioner:
                    getBoundingClientRect + fixed, with block/inline flip;
                    CSS position-area is a later progressive enhancement).
    • ARIA + event → aria-haspopup/controls/expanded on the trigger, and a
                    unified `sui-toggle` event.

  The surface chrome (glass backdrop-filter, the --shadow-lg drop shadow, the
  isolation stacking context, font-family) is the one thing the platform +
  skin don't cover, so it lives on `.surface`. Slots: `trigger`, default.
  Parts: `panel`, `surface`.
-->

<component>{
  props: {
    open: false,
    placement: ['top', 'top-end', 'bottom', 'bottom-end', 'left', 'left-end', 'right', 'right-end'],
  },
}</component>

<style>
  /* Channel markers — the css-token lint recognises these as touched. */
  --font-body: ; --text-base: ; --border: ; --muted-foreground: ;
  --surface-2: ; --background: ; --space-2: ;
  --panel-min-w-sm: ; --radius-lg: ; --shadow-lg: ;
  --popover: ; --popover-foreground: ; --card-backdrop-filter: ;

  :host { display: inline-flex; }
  :host([hidden]) { display: none; }

  /* Native popover defaults are aggressive (position:fixed, inset:0, big
     margins). Reset to a layout-neutral container; use:anchor sets the real
     position:fixed + top/left from the trigger rect. */
  .panel {
    position: fixed;
    margin: 0;
    border: 0;
    padding: 0;
    background: transparent;
    overflow: visible;
    inset: auto;
  }
  .panel::backdrop { background: transparent; }

  /* Surface chrome — the irreducible remainder the skin can't express as one
     preset: glass backdrop-filter (vendor-prefixed), the floating drop shadow,
     the isolation stacking context that clips the glass to the radius while
     letting the shadow paint outside, and font-family. The rest of the
     treatment (bg/fg/border/radius/padding/min-width/text) is on sx below. */
  .panel > .surface {
    backdrop-filter: var(--card-backdrop-filter);
    -webkit-backdrop-filter: var(--card-backdrop-filter);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
    font-family: var(--font-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel > .surface { transform: none; }
  }
</style>


<controller>
import { controller, effect, bindNativeEvent, slotted, usePopover } from '@ship/sui-runtime'
import type { Scope } from './sui-popover.sui'

// Per-instance panel id so multiple popovers each address their own trigger
// via the native popovertarget link (which use:anchor reads to position).
let seq = 0

export default controller<Scope>({
  mount(state, host) {
    const panelId = `sui-popover-panel-${++seq}`
    const panelEl = state.$signals.panelEl() as HTMLElement | null
    if (!panelEl) return
    panelEl.id = panelId

    // ── Trigger wiring ─────────────────────────────────────────────────
    // popovertarget hands the platform the open/close + keyboard activation;
    // we never add a manual click handler (that would double-toggle and steal
    // the browser's focus management). We only add the ARIA the popover
    // attribute doesn't infer.
    slotted(state.$signals.triggerSlot as () => HTMLSlotElement | null, (els) => {
      for (const el of els as HTMLElement[]) {
        el.setAttribute('popovertarget', panelId)
        el.setAttribute('aria-haspopup', 'dialog')
        el.setAttribute('aria-controls', panelId)
      }
    })
    const triggerEls = (): HTMLElement[] => {
      const slot = state.$signals.triggerSlot() as HTMLSlotElement | null
      return (slot?.assignedElements({ flatten: true }) ?? []) as HTMLElement[]
    }

    // ── Open state: the ONE implementation ─────────────────────────────
    // usePopover's handle IS bindPopover — attaching it wires native
    // showPopover/hidePopover <-> signal + the light-dismiss/toggle sync. No
    // hand-rolled effect. The `open` prop (public API, reflected) bridges to it.
    const pop = usePopover()
    const detach = pop(panelEl) as { destroy?: () => void }

    // prop.open → handle
    const stopIn = effect(() => {
      if (state.$signals.open()) pop.open()
      else pop.close()
    })
    // handle → prop (native light-dismiss / popovertarget / ESC / programmatic).
    // Write-back through the attribute so the reflected `open` prop stays
    // authoritative; guarded so it never fights stopIn.
    const stopOut = effect(() => {
      const o = pop.isOpen()
      const has = host.hasAttribute('open')
      if (o && !has) host.setAttribute('open', '')
      else if (!o && has) host.removeAttribute('open')
    })
    // aria-expanded on the trigger(s) follows the open state.
    const stopAria = effect(() => {
      const o = pop.isOpen()
      for (const el of triggerEls()) el.setAttribute('aria-expanded', o ? 'true' : 'false')
    })

    // Unified public event on real toggles (not the initial state).
    function onToggle(ev: Event) {
      host.emit!('sui-toggle', { open: (ev as ToggleEvent).newState === 'open' })
    }
    bindNativeEvent(panelEl, 'toggle', onToggle as EventListener)

    // ── Public methods — flip the reflected prop; the bridge drives native ──
    host.expose!({
      show: () => host.setAttribute('open', ''),
      hide: () => host.removeAttribute('open'),
      toggle: () =>
        host.hasAttribute('open')
          ? host.removeAttribute('open')
          : host.setAttribute('open', ''),
    })

    return () => {
      stopIn()
      stopOut()
      stopAria()
      detach.destroy?.()
    }
  },
})

</controller>
<!--
  Why `{#if open()}` + `transition:scale`? The native popover element
  (`.panel`) must stay mounted so the trigger's `popovertarget` keeps wiring
  it; what fades/scales on each toggle is the *.surface*. Slots inside re-enter
  the shadow tree on open so projection survives every toggle.

  Why the `<sui-portal>`? Native `popover="auto"` already escapes stacking via
  the top layer, so the panel needs no teleport — the portal only supplies a
  document-level `[data-sui-popover-open]` marker that page-level styles can
  target via `:has` without poking into shadow DOM.
-->

<slot name="trigger" bind:this={triggerSlot}></slot>
<div class="panel" part="panel" popover="auto" bind:this={panelEl}
  use:anchor={placement()} role="dialog" aria-modal="false">
  {#if open()}
    <div class="surface" part="surface" transition:scale={{ duration: 120 }}
      sx="min-w:panel-min-w-sm p:2 bg:popover fg:popover-foreground border:border radius:md text:base">
      <slot></slot>
    </div>
  {/if}
</div>
{#if open()}
  <sui-portal target="body">
    <div class="sui-popover-presence" aria-hidden="true" data-sui-popover-open></div>
  </sui-portal>
{/if}
