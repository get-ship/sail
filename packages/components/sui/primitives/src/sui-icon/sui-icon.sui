<!--
  <sui-icon> — SUI port of <ship-icon> plus app glyph support.
  Canonical inline SVG icon. With `name`, fetches one lucide icon from
  the daemon (`/_deck/icons/<name>.svg`). With `src`, fetches an arbitrary
  SVG URL (CDN escape hatch, e.g. simpleicons.org for brand marks). Names
  that 404 fall through to the default slot — provide raw SVG there for
  one-off glyphs.

  When `set="app"`, loads app identity glyphs (logo marks, brand) and
  wraps in a frame with variants: glyph (transparent), tile (light bg),
  solid (filled).

  Prop / event / method parity vs <ship-icon>
  ────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                      Notes
  ────────────────────────────────────────────────────────────────────────────
  name (String, '')               name (string, '', reflect) ✓ kebab-case id
  size ('sm'|'md'|'lg', 'md')    size (union, 'md', reflect) ✓ sm=12 md=16 lg=20
  tone (Tone, 'default')          tone (union, 'default',    ✓ drives --tone-fg
                                   reflect)                    via suiTonesSheet
  label (String, '')              label (string, '', reflect) ✓ → role=img +
                                                               aria-label; else
                                                               aria-hidden=true
  set (lucide|app, 'lucide')      set (union, 'lucide',      ✓ glyph set;
                                   reflect)                     app=branded
  variant (glyph|tile|solid)      variant (union, 'glyph',   ✓ app set only
    (app set only, 'glyph')        reflect)
  radius (sm|md|lg|full, '')      radius (string, '', reflect)✓ app set only
  ────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)                ✓
  ────────────────────────────────────────────────────────────────────────────
  slots: (default)                (default)                  ✓ SVG passthrough /
                                                               fallback
  ────────────────────────────────────────────────────────────────────────────
  parts: svg                      part="svg"                 ✓ the inner SVG
         (app set): frame, glyph   frame, glyph              ✓
  ────────────────────────────────────────────────────────────────────────────
  ARIA: host gets role=img +      controller sets same       ✓ parity
    aria-label when label set;     attrs on host
    aria-hidden=true otherwise
  ────────────────────────────────────────────────────────────────────────────
  Lucide registry is shared       ✓ import from ship-set     no copy
  alias map inlined               ✓ in controller            git→git-branch etc.
  App glyph mapping + app accents ✓ in controller            app-specific colors
  ────────────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" reflect />
<prop name="src" type="string" default="" />
<prop name="size" values="xs|sm|md|lg|xl" default="md" reflect />
<prop name="tone" values="default|info|success|warning|destructive|accent|muted|primary" default="default" reflect />
<prop name="label" type="string" default="" reflect />
<prop name="set" values="lucide|app" default="lucide" reflect />
<prop name="variant" values="glyph|tile|solid" default="glyph" reflect />
<prop name="radius" type="string" default="" reflect />
<prop name="spin" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -0.125em;
    /* default tone; suiTonesSheet (adopted by compiler) overrides per [tone] */
    --tone-fg: var(--foreground);
    color: var(--tone-fg);
  }
  :host([hidden]) { display: none; }

  /* lucide (default) hides the frame wrapper */
  :host:not([set='app']) .frame {
    all: unset;
    display: contents;
  }

  /* Size matrix — applies to the controller-injected SVG */
  svg.sui-icon-svg {
    display: block;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }
  :host([size='xs']) svg.sui-icon-svg { width: 10px; height: 10px; }
  :host([size='sm']) svg.sui-icon-svg { width: 14px; height: 14px; }
  :host([size='lg']) svg.sui-icon-svg { width: 20px; height: 20px; }
  :host([size='xl']) svg.sui-icon-svg { width: 24px; height: 24px; }

  /* Spin — opt-in rotation, gated on reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    :host([spin]) svg.sui-icon-svg,
    :host([spin]) ::slotted(svg) { animation: sui-icon-spin 0.8s linear infinite; }
  }
  @keyframes sui-icon-spin { to { transform: rotate(360deg); } }

  /* Slot passthrough: user-provided SVG fills the icon box */
  ::slotted(svg) { width: 100%; height: 100%; }

  /* App set: frame styling */
  :host([set='app']) {
    --app-accent: var(--foreground);
    --tile-size: 20px;
    --tile-radius: var(--radius-md);
    width: var(--tile-size);
    height: var(--tile-size);
    color: var(--app-accent);
  }

  :host([set='app'][name='dashboard'])   { --app-accent: var(--app-accent-dashboard); }
  :host([set='app'][name='pipelines'])   { --app-accent: var(--app-accent-pipelines); }
  :host([set='app'][name='agents'])      { --app-accent: var(--app-accent-agents); }
  :host([set='app'][name='skills'])      { --app-accent: var(--app-accent-skills); }
  :host([set='app'][name='git'])         { --app-accent: var(--app-accent-git); }
  :host([set='app'][name='collections']) { --app-accent: var(--app-accent-collections); }
  :host([set='app'][name='canvas'])      { --app-accent: var(--app-accent-canvas); }
  :host([set='app'][name='settings'])    { --app-accent: var(--app-accent-settings); }
  :host([set='app'][name='chat'])        { --app-accent: var(--app-accent-chat); }
  :host([set='app'][name='events'])      { --app-accent: var(--app-accent-events); }
  :host([set='app'][name='specs'])       { --app-accent: var(--app-accent-specs); }
  :host([set='app'][name='theme'])       { --app-accent: var(--app-accent-theme); }
  :host([set='app'][name='setup'])       { --app-accent: var(--app-accent-setup); }
  :host([set='app'][name='overview'])    { --app-accent: var(--app-accent-overview); }
  :host([set='app'][name='mesh'])        { --app-accent: var(--app-accent-mesh); }
  :host([set='app'][name='theme-studio']) { --app-accent: var(--app-accent-theme); }

  :host([set='app'][size='sm']) { --tile-size: 16px; --glyph-size: 12px; --tile-radius: var(--radius-sm); }
  :host([set='app'][size='md']) { --tile-size: 20px; --glyph-size: 14px; --tile-radius: var(--radius-md); }
  :host([set='app'][size='lg']) { --tile-size: 28px; --glyph-size: 18px; --tile-radius: var(--radius-lg); }

  :host([set='app'][radius='sm'])   { --tile-radius: var(--radius-sm); }
  :host([set='app'][radius='md'])   { --tile-radius: var(--radius-md); }
  :host([set='app'][radius='lg'])   { --tile-radius: var(--radius-lg); }
  :host([set='app'][radius='full']) { --tile-radius: var(--radius-full); }

  :host([set='app']) .frame {
    width: 100%;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--tile-radius);
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  :host([set='app']:not([variant])) .frame,
  :host([set='app'][variant='glyph']) .frame {
    background: transparent;
    color: var(--app-accent);
  }

  :host([set='app'][variant='tile']) .frame {
    position: relative;
    overflow: hidden;
  }
  /* Soft tint of the app accent — rendered as an underlay pseudo-element
   * so we don't have to write a color-mix in component CSS (the design
   * system owns that formula in tokens.css, not here). */
  :host([set='app'][variant='tile']) .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--app-accent);
    opacity: 0.16;
  }

  :host([set='app'][variant='solid']) .frame {
    background: var(--app-accent);
    color: var(--background);
    box-shadow: var(--shadow-xs);
  }

  :host([set='app']) svg.sui-icon-svg {
    width: var(--glyph-size);
    height: var(--glyph-size);
  }
  :host([set='app']) ::slotted(*) {
    width: var(--glyph-size);
    height: var(--glyph-size);
    display: block;
  }
</style>

<!--
  The icon SVG is created by the controller in mount() via
  document.createElementNS(SVG_NS, 'svg'). The sui-compiler emits
  document.createElement(tag), which yields HTMLUnknownElement for SVG
  tags — bindHtml's morph then wipes class/viewBox/etc. when reconciling.
  Creating the element directly in the controller is the only way to
  keep it in the proper SVG namespace and preserve attributes across
  reactive updates.

  For set="app", the SVG is created inside a frame div. For lucide,
  it's created directly in the slot.
-->
<span class="frame" part="frame">
  <slot></slot>
</span>
