<!--
  <sui-icon> — SUI port of <ship-icon> plus app glyph support.
  Canonical inline SVG icon. With `name`, fetches one lucide icon from
  the daemon (`/_deck/icons/<name>.svg`). With `src`, fetches an arbitrary
  SVG URL (CDN escape hatch, e.g. simpleicons.org for brand marks). Names
  that 404 fall through to the default slot — provide raw SVG there for
  one-off glyphs.

  When `set="app"`, loads app identity glyphs (logo marks, brand) and
  wraps in a frame with variants: glyph (transparent), tile (light bg),
  solid (filled).

  Prop / event / method parity vs <ship-icon>
  ────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                      Notes
  ────────────────────────────────────────────────────────────────────────────
  name (String, '')               name (string, '', reflect) ✓ kebab-case id
  size ('sm'|'md'|'lg', 'md')    size (union, 'md', reflect) ✓ sm=12 md=16 lg=20
  tone (Tone, 'default')          tone (union, 'default',    ✓ drives --tone-fg
                                   reflect)                    via suiTonesSheet
  label (String, '')              label (string, '', reflect) ✓ → role=img +
                                                               aria-label; else
                                                               aria-hidden=true
  set (lucide|app, 'lucide')      set (union, 'lucide',      ✓ glyph set;
                                   reflect)                     app=branded
  variant (glyph|tile|solid)      variant (union, 'glyph',   ✓ app set only
    (app set only, 'glyph')        reflect)
  radius (sm|md|lg|full, '')      radius (string, '', reflect)✓ app set only
  ────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)                ✓
  ────────────────────────────────────────────────────────────────────────────
  slots: (default)                (default)                  ✓ SVG passthrough /
                                                               fallback
  ────────────────────────────────────────────────────────────────────────────
  parts: svg                      part="svg"                 ✓ the inner SVG
         (app set): frame, glyph   frame, glyph              ✓
  ────────────────────────────────────────────────────────────────────────────
  ARIA: host gets role=img +      controller sets same       ✓ parity
    aria-label when label set;     attrs on host
    aria-hidden=true otherwise
  ────────────────────────────────────────────────────────────────────────────
  Lucide registry is shared       ✓ import from ship-set     no copy
  alias map inlined               ✓ in controller            git→git-branch etc.
  App glyph mapping + app accents ✓ in controller            app-specific colors
  ────────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    name: '',
    src: '',
    size: 'md' | 'xs' | 'sm' | 'lg' | 'xl',
    tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' | 'primary',
    label: '',
    set: 'lucide' | 'app',
    variant: 'glyph' | 'tile' | 'solid',
    radius: '',
    spin: false,
  },
}</component>
<variants class="svg">
  size=xs: w:icon-size-2xs h:icon-size-2xs
  size=sm: w:icon-size-sm h:icon-size-sm
  size=lg: w:icon-size-xl h:icon-size-xl
  size=xl: w:icon-size-2xl h:icon-size-2xl
</variants>
<style>
  .sui-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -0.125em;
    /* default tone; suiTonesSheet (adopted by compiler) overrides per [tone] */
    --tone-fg: var(--foreground);
    color: var(--tone-fg);
  }
  .sui-icon[hidden] { display: none; }

  /* lucide (default) hides the frame wrapper */
  .sui-icon:not([set='app']) .frame {
    all: unset;
    display: contents;
  }

  /* Size matrix — applies to the controller-injected SVG */
  svg.sui-icon-svg {
    display: block;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex: 0 0 auto;
  }

  /* Spin — opt-in rotation, gated on reduced-motion */
  @media (prefers-reduced-motion: no-preference) {
    .sui-icon[spin] svg.sui-icon-svg,
    .sui-icon[spin] ::slotted(svg) { animation: sui-icon-spin 0.8s linear infinite; }
  }
  @keyframes sui-icon-spin { to { transform: rotate(360deg); } }

  /* Slot passthrough: user-provided SVG fills the icon box */
  ::slotted(svg) { width: 100%; height: 100%; }

  /* App set: frame styling */
  .sui-icon[set='app'] {
    --app-accent: var(--foreground);
    --tile-size: var(--space-5);
    --tile-radius: var(--radius-md);
    width: var(--tile-size);
    height: var(--tile-size);
    color: var(--app-accent);
  }

  /* Per-app accent glyph tint (was <theme prop="name">). App-domain tokens
     live in the ship-app token layer, not the framework — so each falls back
     to --foreground where the token is absent (e.g. this catalog), which
     keeps a bare framework build identical to before. theme-studio aliases
     the theme accent, mirroring APP_ALIASES in the controller. */
  .sui-icon[set='app'][name='dashboard']    { --app-accent: var(--app-accent-dashboard, var(--foreground)); }
  .sui-icon[set='app'][name='pipelines']    { --app-accent: var(--app-accent-pipelines, var(--foreground)); }
  .sui-icon[set='app'][name='agents']       { --app-accent: var(--app-accent-agents, var(--foreground)); }
  .sui-icon[set='app'][name='skills']       { --app-accent: var(--app-accent-skills, var(--foreground)); }
  .sui-icon[set='app'][name='git']          { --app-accent: var(--app-accent-git, var(--foreground)); }
  .sui-icon[set='app'][name='collections']  { --app-accent: var(--app-accent-collections, var(--foreground)); }
  .sui-icon[set='app'][name='canvas']       { --app-accent: var(--app-accent-canvas, var(--foreground)); }
  .sui-icon[set='app'][name='settings']     { --app-accent: var(--app-accent-settings, var(--foreground)); }
  .sui-icon[set='app'][name='chat']         { --app-accent: var(--app-accent-chat, var(--foreground)); }
  .sui-icon[set='app'][name='events']       { --app-accent: var(--app-accent-events, var(--foreground)); }
  .sui-icon[set='app'][name='specs']        { --app-accent: var(--app-accent-specs, var(--foreground)); }
  .sui-icon[set='app'][name='theme']        { --app-accent: var(--app-accent-theme, var(--foreground)); }
  .sui-icon[set='app'][name='setup']        { --app-accent: var(--app-accent-setup, var(--foreground)); }
  .sui-icon[set='app'][name='overview']     { --app-accent: var(--app-accent-overview, var(--foreground)); }
  .sui-icon[set='app'][name='mesh']         { --app-accent: var(--app-accent-mesh, var(--foreground)); }
  .sui-icon[set='app'][name='theme-studio'] { --app-accent: var(--app-accent-theme, var(--foreground)); }

  .sui-icon[set='app'][size='sm'] { --tile-size: var(--icon-size-md); --glyph-size: var(--icon-size-xs); --tile-radius: var(--radius-sm); }
  .sui-icon[set='app'][size='md'] { --tile-size: var(--space-5); --glyph-size: var(--icon-size-sm); --tile-radius: var(--radius-md); }
  .sui-icon[set='app'][size='lg'] { --tile-size: var(--control-h-sm); --glyph-size: var(--icon-size-lg); --tile-radius: var(--radius-lg); }

  .sui-icon[set='app'][radius='sm']   { --tile-radius: var(--radius-sm); }
  .sui-icon[set='app'][radius='md']   { --tile-radius: var(--radius-md); }
  .sui-icon[set='app'][radius='lg']   { --tile-radius: var(--radius-lg); }
  .sui-icon[set='app'][radius='full'] { --tile-radius: var(--radius-full); }

  .sui-icon[set='app'] .frame {
    width: 100%;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--tile-radius);
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  .sui-icon[set='app']:not([variant]) .frame,
  .sui-icon[set='app'][variant='glyph'] .frame {
    background: transparent;
    color: var(--app-accent);
  }

  .sui-icon[set='app'][variant='tile'] .frame {
    position: relative;
    overflow: hidden;
  }
  /* Soft tint of the app accent — rendered as an underlay pseudo-element
   * so we don't have to write a color-mix in component CSS (the design
   * system owns that formula in tokens.css, not here). */
  .sui-icon[set='app'][variant='tile'] .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--app-accent);
    opacity: 0.16;
  }

  .sui-icon[set='app'][variant='solid'] .frame {
    background: var(--app-accent);
    color: var(--background);
    box-shadow: var(--shadow-xs);
  }

  .sui-icon[set='app'] svg.sui-icon-svg {
    width: var(--glyph-size);
    height: var(--glyph-size);
  }
  .sui-icon[set='app'] ::slotted(*) {
    width: var(--glyph-size);
    height: var(--glyph-size);
    display: block;
  }
</style>


<controller>
import { controller, effect, signal } from '@ship/sui-runtime'
import { fetchIcon, getCachedIcon } from './registry'
import type { Scope } from './sui-icon.sui'

const SVG_NS = 'http://www.w3.org/2000/svg'

type AppName =
  | 'dashboard' | 'pipelines' | 'agents' | 'skills' | 'git'
  | 'collections' | 'canvas' | 'settings' | 'chat' | 'events'
  | 'specs' | 'theme' | 'setup' | 'overview' | 'mesh'

const APP_GLYPH: Record<AppName, string> = {
  dashboard: 'layout-dashboard',
  pipelines: 'workflow',
  agents: 'bot',
  skills: 'sparkles',
  git: 'git-branch',
  collections: 'database',
  canvas: 'frame',
  settings: 'settings',
  chat: 'messages-square',
  events: 'radio',
  specs: 'file-text',
  theme: 'palette',
  setup: 'rocket',
  overview: 'compass',
  mesh: 'network',
}

const APP_ALIASES: Record<string, AppName> = {
  'theme-studio': 'theme',
}

const APP_NAMES = new Set([...Object.keys(APP_GLYPH), ...Object.keys(APP_ALIASES)])

// Bumped after each successful fetch so the render effect re-runs when an
// icon lands. Tests prime the cache synchronously and never observe a bump.
const fetchTick = signal(0)

/** Cache-or-fetch one URL. Used by the `src=` path; the `name=` path goes
 *  through `fetchIcon` which encapsulates the daemon's per-icon endpoint. */
const srcCache = new Map<string, string | null>()
const srcInflight = new Map<string, Promise<string | null>>()
function fetchSrc(url: string): Promise<string | null> {
  if (srcCache.has(url)) return Promise.resolve(srcCache.get(url) ?? null)
  const pending = srcInflight.get(url)
  if (pending) return pending
  const p = fetch(url)
    .then((r) => (r.ok ? r.text() : null))
    .catch(() => null)
    .then((svg) => {
      srcCache.set(url, svg)
      srcInflight.delete(url)
      return svg
    })
  srcInflight.set(url, p)
  return p
}

/** Parse one `<svg>` element from a standalone SVG document string. Returns
 *  the root or null when the input is malformed. */
function parseSvg(doc: Document, markup: string): SVGSVGElement | null {
  const parsed = new DOMParser().parseFromString(markup, 'image/svg+xml')
  const root = parsed.documentElement
  if (!(root instanceof SVGSVGElement)) return null
  return doc.adoptNode(root) as SVGSVGElement
}

export default controller<Scope>({
  mount(state, host) {
    const root = host.shadowRoot!
    let svgEl: SVGSVGElement | null = null
    let lastKey: string | null = null
    // Which key we've already kicked a fetch for. The render effect subscribes
    // to the GLOBAL `fetchTick`, so any icon's fetch re-runs EVERY icon's
    // effect — without this guard each still-pending icon re-attaches another
    // `.then(fetchTick.set)` on every re-run, and the single-flight promise
    // accumulates callbacks → one resolve fires N bumps → N re-runs → more
    // callbacks: a positive-feedback storm that OOMs an icon-heavy page
    // (the skills card grid: ~60 icons, 5GB in seconds). Kick at most once
    // per key; the bump on resolve re-runs the effect, which finds the cache
    // populated and renders.
    let pendingKey: string | null = null

    const stopAria = effect(() => {
      const label = state.$signals.label()
      if (label) {
        host.setAttribute('role', 'img')
        host.setAttribute('aria-label', label)
        host.removeAttribute('aria-hidden')
      } else {
        host.setAttribute('aria-hidden', 'true')
        host.removeAttribute('role')
        host.removeAttribute('aria-label')
      }
    })

    const stopRender = effect(() => {
      // Subscribe to the fetch tick so this effect re-runs when an icon lands.
      fetchTick()
      const src = state.$signals.src()
      const rawName = state.$signals.name()
      const set = state.$signals.set()
      const label = state.$signals.label()

      // For app set, resolve app name to glyph icon
      let resolvedName = rawName
      if (set === 'app') {
        const resolved = (APP_ALIASES[rawName] ?? rawName) as AppName
        const known = APP_NAMES.has(rawName)
        resolvedName = known ? APP_GLYPH[resolved] : 'dot'
      }

      const key = src ? `src:${src}` : resolvedName ? `name:${resolvedName}` : ''
      if (!key) {
        if (svgEl) {
          svgEl.remove()
          svgEl = null
        }
        lastKey = null
        return
      }
      // Resolve to fully-fetched SVG markup synchronously when cached, else
      // kick a fetch and bail (the effect will re-run on tick).
      let markup: string | null | undefined
      if (src) {
        markup = srcCache.get(src)
        if (markup === undefined) {
          if (pendingKey !== key) {
            pendingKey = key
            fetchSrc(src).then(() => { if (pendingKey === key) pendingKey = null; fetchTick.set(fetchTick() + 1) })
          }
          return
        }
      } else {
        markup = getCachedIcon(resolvedName)
        if (markup === undefined) {
          if (pendingKey !== key) {
            pendingKey = key
            fetchIcon(resolvedName).then(() => { if (pendingKey === key) pendingKey = null; fetchTick.set(fetchTick() + 1) })
          }
          return
        }
      }
      if (!markup) {
        // 404 or malformed — drop any prior render so the slot fallback shows.
        if (svgEl) {
          svgEl.remove()
          svgEl = null
        }
        lastKey = null
        return
      }
      if (key !== lastKey) {
        const parsed = parseSvg(host.ownerDocument, markup)
        if (!parsed) return
        // The daemon emits `stroke="currentColor"` so host CSS `color` flows
        // through; preserve the parsed attributes verbatim.
        parsed.setAttribute('part', 'svg')
        parsed.setAttribute('class', 'sui-icon-svg')

        // For app set, insert into the frame
        const insertParent = set === 'app' ? root.querySelector('.frame') : root
        if (insertParent) {
          if (svgEl) svgEl.replaceWith(parsed)
          else insertParent.insertBefore(parsed, insertParent.firstChild)
          svgEl = parsed
        }
        lastKey = key
      }
      if (svgEl) {
        if (label) svgEl.removeAttribute('aria-hidden')
        else svgEl.setAttribute('aria-hidden', 'true')
      }
    })

    return () => {
      stopAria()
      stopRender()
    }
  },
})

/** Test-only: bump the tick so primed-cache changes flow through the effect. */
export function _bumpForTests(): void {
  fetchTick.set(fetchTick() + 1)
}

// Reserved for SVG namespace usage in future programmatic builders.
void SVG_NS

</controller>
<!--
  The icon SVG is created by the controller in mount() via
  document.createElementNS(SVG_NS, 'svg'). The sui-compiler emits
  document.createElement(tag), which yields HTMLUnknownElement for SVG
  tags — bindHtml's morph then wipes class/viewBox/etc. when reconciling.
  Creating the element directly in the controller is the only way to
  keep it in the proper SVG namespace and preserve attributes across
  reactive updates.

  For set="app", the SVG is created inside a frame div. For lucide,
  it's created directly in the slot.
-->
<span class="frame">
  <slot></slot>
</span>
