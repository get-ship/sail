<!--
  <sui-radio-group> — SUI port of <ship-radio-group>.
  Manages selection across <sui-radio> children with roving tabindex and
  arrow-key navigation. Participates in forms via a light-DOM hidden input.

  Prop parity vs <ship-radio-group>
  ────────────────────────────────────────────────────────────────────────
  value (string, '')          ✓ reflect — selected radio value
  disabled (bool, false)      ✓ reflect — disables all radios
  tone (Tone, 'default')      ✓ reflect — propagated to radios
  size (sm|md|lg, 'md')       ✓ reflect — propagated to radios
  name (string, '')           ✓ — form field name
  label (string, '')          ✓ — aria-label for the group
  required (bool, false)      ✓ reflect — sets aria-required on host
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change → sui-change { detail: { value } }
  ────────────────────────────────────────────────────────────────────────
  Slots: (default) — sui-radio children
  ────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ────────────────────────────────────────────────────────────────────────
  - No tone channels or per-component `theme` blocks existed here (the
    group only sets a `tone` prop and propagates it to children; tone IS
    the global channel on each child, no per-component redeclaration
    was in scope). No change to the tone story on this component.
  - The `:host([hidden]) { display: none }` rule is dropped — framework
    BASE_CSS owns [hidden]. The `color: var(foreground)` is also
    owned by BASE_CSS (the framework host default). What stays in
    style is genuinely component-specific: a vertical flex column with
    a space-2 gap (a host-level layout; <column> is for INNER elements,
    the host has no <column> primitive, so this is a one-rule
    `style` override of the framework's block default) and a font-
    family declaration (no font-family prop in the sx vocabulary).
  - The `value` prop is declared via the legacy `prop` tag (not the
    `component` block): the block's string-default-literal arm does
    not add reflect (only unions / bools do), and the controller
    writes to this signal in onSelect / onNav — without reflect the
    host attribute wouldn't mirror the change and downstream tests
    (which query `el.getAttribute('value')` after a click) would fail.
    The other props ride the `component` block fine (unions + bool
    auto-add reflect; the read-only string props don't need it).
-->

<prop name="value" type="string" default="" reflect />
<component>{
  props: {
    disabled: false,
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    size: 'sm' | 'md' | 'lg',
    name: '',
    label: '',
    required: false,
  },
}</component>

<style>
  /* host layout: vertical flex stack (the inner <column> primitive is
     for element children, not the host; this is the one host-level
     layout this component needs). */
  :host {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-body);
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-radio-group.sui'

type RadioEl = HTMLElement & { focusInput?(): void }

export default controller<Scope>({
  mount(state, host) {

    if (!host.hasAttribute('role')) host.setAttribute('role', 'radiogroup')

    // Light-DOM hidden input for form participation.
    const hiddenInput = document.createElement('input')
    hiddenInput.type = 'hidden'
    host.appendChild(hiddenInput)

    const getRadios = (): RadioEl[] =>
      Array.from(host.querySelectorAll(':scope > sui-radio')) as RadioEl[]

    const enabledRadios = (): RadioEl[] =>
      getRadios().filter(r => !r.hasAttribute('disabled') && !(state.$signals.disabled() as boolean))

    const syncRadios = () => {
      const currentValue = state.$signals.value() as string
      const isGroupDisabled = state.$signals.disabled() as boolean
      const groupTone = state.$signals.tone() as string
      const groupSize = state.$signals.size() as string

      for (const radio of getRadios()) {
        radio.toggleAttribute('checked', radio.getAttribute('value') === currentValue)
        if (isGroupDisabled) radio.setAttribute('disabled', '')
        if (groupTone && !radio.hasAttribute('tone')) radio.setAttribute('tone', groupTone)
        if (groupSize && !radio.hasAttribute('size')) radio.setAttribute('size', groupSize)
      }

      hiddenInput.name = state.$signals.name() as string
      hiddenInput.value = currentValue
    }

    const stopSync = effect(() => {
      state.$signals.value()
      state.$signals.disabled()
      state.$signals.tone()
      state.$signals.size()
      syncRadios()
    })

    // Re-sync when radios are added/removed AFTER connect. The sync effect
    // only re-runs on prop-signal changes, so radios inserted later (dynamic
    // children, or a framework that sets attributes then projects children)
    // would never pick up the initial `value`→`checked` state without this.
    const mo = new MutationObserver(syncRadios)
    mo.observe(host, { childList: true })

    const stopLabel = effect(() => {
      const label = state.$signals.label() as string
      if (label) host.setAttribute('aria-label', label)
      else host.removeAttribute('aria-label')
    })

    const stopRequired = effect(() => {
      const required = state.$signals.required() as boolean
      if (required) host.setAttribute('aria-required', 'true')
      else host.removeAttribute('aria-required')
    })

    const onSelect = (e: Event) => {
      const ce = e as CustomEvent
      ce.stopPropagation()
      const newVal = ce.detail.value as string
      if (newVal === (state.$signals.value() as string)) return
      state.$signals.value.set(newVal)
      syncRadios()
      host.dispatchEvent(new CustomEvent('sui-change', {
        detail: { value: newVal },
        bubbles: true,
        composed: true,
      }))
    }

    const onNav = (e: Event) => {
      const ce = e as CustomEvent
      ce.stopPropagation()
      const enabled = enabledRadios()
      if (!enabled.length) return

      const current = (ce.composedPath() as Element[]).find(
        el => el.tagName?.toLowerCase() === 'sui-radio',
      ) as RadioEl | null
      const idx = current ? enabled.indexOf(current) : -1
      const next = ce.detail.direction === 'next'
        ? enabled[(idx + 1) % enabled.length]!
        : enabled[(idx - 1 + enabled.length) % enabled.length]!

      const nextVal = next.getAttribute('value') ?? ''
      state.$signals.value.set(nextVal)
      syncRadios()
      next.focusInput?.()

      host.dispatchEvent(new CustomEvent('sui-change', {
        detail: { value: nextVal },
        bubbles: true,
        composed: true,
      }))
    }

    host.addEventListener('sui-radio-select', onSelect)
    host.addEventListener('sui-radio-nav', onNav)

    return () => {
      stopSync()
      stopLabel()
      stopRequired()
      mo.disconnect()
      host.removeEventListener('sui-radio-select', onSelect)
      host.removeEventListener('sui-radio-nav', onNav)
      hiddenInput.remove()
    }
  },
})

</controller>
<slot></slot>
