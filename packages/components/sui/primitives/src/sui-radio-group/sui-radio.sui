<!--
  <sui-radio> — child element of <sui-radio-group>.
  Renders a native <input type="radio"> for a11y + keyboard access.
  Selection and navigation are managed by the parent group.

  Prop parity vs <ship-radio>
  ────────────────────────────────────────────────────────────────────────
  value (string, '')        ✓ reflect
  disabled (bool, false)    ✓ reflect
  checked (bool, false)     ✓ reflect — managed by group
  tone (Tone, 'default')    ✓ reflect — inherited from group
  size (sm|md|lg, 'md')     ✓ reflect — inherited from group
  ────────────────────────────────────────────────────────────────────────
  Internal events (composed, bubbles) — consumed by sui-radio-group:
    sui-radio-select  { value }
    sui-radio-nav     { direction: 'next'|'prev' }
  ────────────────────────────────────────────────────────────────────────
  Parts: circle, dot, input, label
  Slots: (default) — label content
-->

<prop name="value" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="checked" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);
    -webkit-tap-highlight-color: transparent;
    --tone: var(--primary);
  }
  :host([hidden]) { display: none; }

  :host(:not([tone])),
  :host([tone='default'])     { --tone: var(--primary); }
  :host([tone='primary'])     { --tone: var(--primary); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); }

  :host(:not([size])),
  :host([size='md']) { --rd-size: 16px; --rd-dot: 8px; }
  :host([size='sm']) { --rd-size: 14px; --rd-dot: 6px; }
  :host([size='lg']) { --rd-size: 20px; --rd-dot: 10px; }

  /* Selectable option card: bordered --card row with a custom dot. */
  label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  :host([disabled]) label { cursor: not-allowed; }
  :host(:not([disabled]):not([checked])) label:hover { border-color: var(--border-strong); }
  :host([checked]) label {
    border-color: var(--selected-border);
    background: var(--selected-bg);
  }

  .circle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--rd-size);
    height: var(--rd-size);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 50%;
    box-sizing: border-box;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  :host(:not([disabled]):not([checked])) label:hover .circle {
    border-color: var(--border-strong);
  }
  :host([checked]) .circle { border-color: var(--tone); }

  .dot {
    width: var(--rd-dot);
    height: var(--rd-dot);
    border-radius: 50%;
    background: var(--tone);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  :host([checked]) .dot { opacity: 1; transform: scale(1); }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: inherit;
    appearance: none;
    -webkit-appearance: none;
  }

  /* Canonical focus convention on the option card. */
  :host(:not([disabled])) label:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (forced-colors: active) {
    .circle { border-color: CanvasText; }
    :host([checked]) .dot { background: Highlight; }
    :host(:not([disabled])) label:has(input:focus-visible) {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
    }
  }

  :host([disabled]) { color: var(--muted-foreground); }
  :host([disabled]) .circle {
    background: var(--muted);
    border-color: var(--border);
    filter: saturate(0.6);
  }
  :host([disabled][checked]) .circle {
    border-color: var(--border);
  }
  :host([disabled][checked]) .dot {
    background: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }

  ::slotted(*) {
    font: inherit;
    color: inherit;
    line-height: var(--leading-tight);
  }
</style>

<label part="label">
  <span class="circle" part="circle">
    <input
      part="input"
      type="radio"
      bind:checked={checked}
      disabled={disabled()}
      aria-checked={checked() ? 'true' : 'false'}
      tabindex={checked() ? '0' : '-1'}
      bind:this={inputEl}
    />
    <span class="dot" part="dot" aria-hidden="true"></span>
  </span>
  <slot></slot>
</label>
