<!--
  <sui-radio> — child element of <sui-radio-group>.
  Renders a native <input type="radio"> for a11y + keyboard access.
  Selection and navigation are managed by the parent group.

  Prop parity vs <ship-radio>
  ────────────────────────────────────────────────────────────────────────
  value (string, '')        ✓ reflect
  disabled (bool, false)    ✓ reflect
  checked (bool, false)     ✓ reflect — managed by group
  tone (Tone, 'default')    ✓ reflect — inherited from group
  size (sm|md|lg, 'md')     ✓ reflect — inherited from group
  ────────────────────────────────────────────────────────────────────────
  Internal events (composed, bubbles) — consumed by sui-radio-group:
    sui-radio-select  { value }
    sui-radio-nav     { direction: 'next'|'prev' }
  ────────────────────────────────────────────────────────────────────────
  Parts: circle, dot, input, label
  Slots: (default) — label content
  ────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ────────────────────────────────────────────────────────────────────────
  - The `theme prop="tone" channels="radio-tone"` block DELETED. The tone IS
    framework channel now (suiTonesSheet); the radio reads --tone
    directly. The feat/next local --radio-tone channel duplicated the
    global --tone — no loss removing it.
  - The `theme prop="size" channels="radio-size, radio-dot"` block DELETED
    per-component channels are the "closed sx" back door the new surface
    forbids. The two local CSS vars (circle diameter, dot diameter) keep
    the same icon-size-N / space-N ladder, declared directly in style
    on :host per size. They're component-internal: a circle that's
    NOT one of the framework's `text` field sizes (icon-size-md is
    coincidentally the default, not a contract).
  - The `variants` block used `border:tone:radio-tone` and
    `bg:selected` etc. — `border:tone:radio-tone` was the per-component
    channel syntax. Re-authored as the global --tone (a plain
    `var(--tone)` in residual style, since the variants machinery
    doesn't read CSS vars — only the sx token vocabulary).
  - The dot's `background: var(--radio-tone)` becomes
    `var(--tone)` (same value, global channel). The circle's
    `border-color: var(--radio-tone)` becomes `var(--tone)`.
  - The framework's input type="radio" control skin (TOGGLE_CONTROLS_CSS)
    sets a visible radio look; this component's input is intentionally
    hidden (visual lives on the custom .circle + .dot). The
    `input { position: absolute; opacity: 0; ... }` rules have higher
    specificity than the framework's :where() contract and win ties;
    the framework's accent colors are still applied to the input (invisibly
    under opacity:0). No ad-hoc skinning required.
-->

<component>{
  props: {
    value: '',
    disabled: false,
    checked: false,
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    size: 'sm' | 'md' | 'lg',
  },
}</component>

<variants>
  [hidden]:   display:none
  [disabled]: cursor:not-allowed
</variants>

<variants part="label">
  [disabled]: cursor:not-allowed
</variants>

<!--
  Residual: option-card layout (display:flex + align-items:flex-start +
  padding + border-radius + cursor + user-select + box-shadow) — a
  complex compound control surface the layout keywords don't express;
  .circle geometry (width/height/position:relative/border-radius:50%
  + box-sizing); .dot geometry (width/height/border-radius:50%);
  multi-property transitions (motion); the :has() focus-within
  parent selector (no sx/variants story); forced-colors CanvasText
  / Highlight system colors; saturate(0.6) compound disabled
  filter; ::slotted descendant styling; per-size local CSS vars
  (the circle/dot diameter ladder, the per-tone --tone is
  already global); checked state on the custom .circle/.dot
  parts (the dot's transform:scale and opacity transition is
  a multi-property motion the variants don't express).
-->
<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);
    -webkit-tap-highlight-color: transparent;
  }

  /* size channel — local CSS vars (the circle/dot diameter ladder
     doesn't ride the global size prop, which is for L1 form controls;
     the radio's own circle/dot are component-specific). */
  :host(:not([size])), :host([size='md']) {
    --radio-size: var(--icon-size-md);
    --radio-dot: var(--space-2);
  }
  :host([size='sm']) {
    --radio-size: var(--icon-size-sm);
    --radio-dot: var(--space-1_5);
  }
  :host([size='lg']) {
    --radio-size: var(--icon-size-xl);
    --radio-dot: var(--space-2_5);
  }

  :host([disabled]) { color: var(--muted-foreground); }

  [part~='label'] {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled]):not([checked])) [part~='label']:hover {
    border-color: var(--border-strong);
  }
  :host([checked]) [part~='label'] {
    border-color: var(--selected-border);
    background: var(--selected-bg);
  }

  [part~='circle'] {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--radio-size);
    height: var(--radio-size);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 50%;
    box-sizing: border-box;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled]):not([checked])) [part~='label']:hover [part~='circle'] {
    border-color: var(--border-strong);
  }
  /* --tone is the global tone channel (set by the host's [tone] attribute
     via suiTonesSheet). The per-component radio-tone channel is gone. */
  :host([checked]) [part~='circle'] { border-color: var(--tone); }

  [part~='dot'] {
    width: var(--radio-dot);
    height: var(--radio-dot);
    border-radius: 50%;
    background: var(--tone);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  :host([checked]) [part~='dot'] { opacity: 1; transform: scale(1); }

  /* :has() parent selector for focus-visible — the framework's input
     focus ring targets the input itself; the visual is on the label
     wrapper (the .circle sits inside it). */
  :host(:not([disabled])) [part~='label']:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (forced-colors: active) {
    [part~='circle'] { border-color: CanvasText; }
    :host([checked]) [part~='dot'] { background: Highlight; }
    :host(:not([disabled])) [part~='label']:has(input:focus-visible) {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
    }
  }

  :host([disabled]) [part~='circle'] {
    background: var(--muted);
    border-color: var(--border);
    filter: saturate(0.6);
  }
  :host([disabled][checked]) [part~='circle'] { border-color: var(--border); }
  :host([disabled][checked]) [part~='dot'] { background: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }

  ::slotted(*) {
    font: inherit;
    color: inherit;
    line-height: var(--leading-tight);
  }
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: inherit;
    appearance: none;
    -webkit-appearance: none;
  }
</style>

<label part="label">
  <span class="circle" part="circle">
    <input
      part="input"
      type="radio"
      bind:checked={checked}
      disabled={disabled()}
      aria-checked={checked() ? 'true' : 'false'}
      tabindex={checked() ? '0' : '-1'}
      bind:this={inputEl}
    />
    <span class="dot" part="dot" aria-hidden="true"></span>
  </span>
  <slot></slot>
</label>
