<!--
  <sui-radio> — child element of <sui-radio-group>.
  Renders a native <input type="radio"> for a11y + keyboard access.
  Selection and navigation are managed by the parent group.

  Prop parity vs <ship-radio>
  ────────────────────────────────────────────────────────────────────────
  value (string, '')        ✓ reflect
  disabled (bool, false)    ✓ reflect
  checked (bool, false)     ✓ reflect — managed by group
  tone (Tone, 'default')    ✓ reflect — inherited from group
  size (sm|md|lg, 'md')     ✓ reflect — inherited from group
  ────────────────────────────────────────────────────────────────────────
  Internal events (composed, bubbles) — consumed by sui-radio-group:
    sui-radio-select  { value }
    sui-radio-nav     { direction: 'next'|'prev' }
  ────────────────────────────────────────────────────────────────────────
  Parts: circle, dot, input, label
  Slots: (default) — label content
-->

<prop name="value" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="checked" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="tone" channels="radio-tone">
  default:     primary
  primary:     primary
  info:        info
  success:     success
  warning:     warning
  destructive: destructive
  accent:      accent
  muted:       muted-foreground
</theme>
<theme prop="size" channels="radio-size, radio-dot">
  default: icon-size-md, space-2
  md:      icon-size-md, space-2
  sm:      icon-size-sm, space-1_5
  lg:      icon-size-xl, space-2_5
</theme>
<variants>
  [hidden]:  display:none
  checked:   border:selected border:tone:radio-tone bg:selected
  [disabled]: cursor:not-allowed opacity:75
</variants>
<variants part="label">
  hover: border:strong
  checked: border:selected border:tone:radio-tone bg:selected
  [disabled]: cursor:not-allowed
</variants>
<variants part="circle">
  checked: border:tone:radio-tone
</variants>
<variants part="dot">
  checked: opacity:100
</variants>

<!-- Residual: option-card layout (display:flex + align-items:flex-start +
     padding + border-radius + cursor + user-select + box-shadow) — a
     complex compound control surface the layout keywords don't express;
     .circle geometry (width/height/position:relative/border-radius:50%
     + box-sizing); .dot geometry (width/height/border-radius:50%);
     multi-property transitions (motion); the :has() focus-within
     parent selector (no sx/variants story); forced-colors CanvasText
     / Highlight system colors; saturate(0.6) compound disabled
     filter; ::slotted descendant styling. -->
<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);
    -webkit-tap-highlight-color: transparent;
  }
  :host {
    --radio-tone: var(--primary);
    --radio-size: var(--icon-size-md);
    --radio-dot: var(--space-2);
  }
  :host([disabled]) { color: var(--muted-foreground); }
  [part~='label'] {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled]):not([checked])) [part~='label']:hover { border-color: var(--border-strong); }
  :host([checked]) [part~='label'] {
    border-color: var(--selected-border);
    background: var(--selected-bg);
  }
  [part~='circle'] {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--radio-size);
    height: var(--radio-size);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 50%;
    box-sizing: border-box;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled]):not([checked])) [part~='label']:hover [part~='circle'] {
    border-color: var(--border-strong);
  }
  :host([checked]) [part~='circle'] { border-color: var(--radio-tone); }
  [part~='dot'] {
    width: var(--radio-dot);
    height: var(--radio-dot);
    border-radius: 50%;
    background: var(--radio-tone);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  :host([checked]) [part~='dot'] { opacity: 1; transform: scale(1); }
  :host(:not([disabled])) [part~='label']:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    [part~='circle'] { border-color: CanvasText; }
    :host([checked]) [part~='dot'] { background: Highlight; }
    :host(:not([disabled])) [part~='label']:has(input:focus-visible) {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
    }
  }
  :host([disabled]) [part~='circle'] {
    background: var(--muted);
    border-color: var(--border);
    filter: saturate(0.6);
  }
  :host([disabled][checked]) [part~='circle'] { border-color: var(--border); }
  :host([disabled][checked]) [part~='dot'] { background: var(--muted); }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
  ::slotted(*) {
    font: inherit;
    color: inherit;
    line-height: var(--leading-tight);
  }
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: inherit;
    appearance: none;
    -webkit-appearance: none;
  }
</style>

<label part="label">
  <span class="circle" part="circle">
    <input
      part="input"
      type="radio"
      bind:checked={checked}
      disabled={disabled()}
      aria-checked={checked() ? 'true' : 'false'}
      tabindex={checked() ? '0' : '-1'}
      bind:this={inputEl}
    />
    <span class="dot" part="dot" aria-hidden="true"></span>
  </span>
  <slot></slot>
</label>
