<!--
  <sui-hover-card> — SUI port of <ship-hover-card>.
  Hover-triggered rich content overlay. Richer than a tooltip: supports
  arbitrary slotted content. Uses native popover API (popover="auto") for
  top-layer rendering. Shows after show-delay, hides after hide-delay.
  Panel is positioned via getBoundingClientRect (anchor positioning fallback).

  Prop / event / method parity vs <ship-hover-card>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  placement (top|btm|l|r)      placement (union, ref)       ✓
  show-delay (300ms)           show-delay (number, 300)     ✓
  hide-delay (100ms)           hide-delay (number, 100)     ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-open/close      sui-open/close               ✓ renamed
  Methods: show(), hide()      show(), hide()               ✓
  Slots: trigger, (default)    trigger, (default)           ✓
  Parts: card                  panel                        ✓
  ────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ────────────────────────────────────────────────────────────────────────
  - No tone/size channels and no L1 controls here — this component has
    neither, so those two axes of the new surface don't apply.
  - `.panel`'s static surface (min/max width, padding, background, color,
    border, radius, text, leading) moved to closed-vocab sx. `<style>` keeps
    only what sx structurally cannot express: `inset`/margin reset, the
    compound two-layer box-shadow (a token shadow plus an inset highlight —
    sx's shadow: only lowers a single preset), the popover open/close
    opacity+transform transition, `::backdrop`, CSS Anchor Positioning
    (`@supports`, `position-try-*`, `anchor()`, `::slotted` anchor-name),
    prefers-reduced-motion, and forced-colors.
  - `:host { display: inline-flex }` moved to the host-sx directive below.
  - The two raw `8px` anchor-gap literals became `var(--space-2)` (exact
    same computed value, now token-backed); `translateY(-4px)` became
    `translateY(calc(-1 * var(--space-1)))` (same reasoning).
  - feat/next's 340px max-width isn't on the panel-max-w scale (sm=320,
    md=480); nudged to the nearest step, `panel-max-w-sm` (320px) — a
    20px difference, not a functional change.
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="placement" values="top|bottom|left|right" default="bottom" reflect />
<prop name="show-delay" type="number" default="300" />
<prop name="hide-delay" type="number" default="100" />

<host sx="display:inline-flex"></host>

<!--
  Residual style — anchor positioning, the popover transition/backdrop, the
  compound box-shadow (token + inset highlight, not sx-able as one preset),
  reduced-motion, and forced-colors.
-->
<style>
  .panel {
    inset: auto;
    margin: 0;
    box-shadow: var(--shadow-lg), inset 0 1px 0 var(--surface-1);
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-1)));
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: translateY(0);
  }
  .panel::backdrop { background: transparent; }

  /* CSS Anchor Positioning — same shape as sui-popover and
     sui-dropdown-menu. Controller sets `--sui-hc-anchor` to a unique
     per-instance name on the slotted trigger; CSS resolves placement
     against that anchor. `position-try-fallbacks` auto-flips when the
     chosen placement would clip the viewport. The controller's JS
     positionPanel is skipped when this branch is live. */
  @supports (anchor-name: --x) {
    ::slotted([slot='trigger']) {
      anchor-name: var(--sui-hc-anchor);
    }
    .panel {
      position: fixed;
      position-anchor: var(--sui-hc-anchor);
      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
      position-try-order: most-block-size;
    }
    :host(:not([placement])) .panel,
    :host([placement='bottom']) .panel {
      top: calc(anchor(bottom) + var(--space-2));
      justify-self: anchor-center;
    }
    :host([placement='top']) .panel {
      bottom: calc(anchor(top) + var(--space-2));
      justify-self: anchor-center;
    }
    :host([placement='left']) .panel {
      right: calc(anchor(left) + var(--space-2));
      align-self: anchor-center;
    }
    :host([placement='right']) .panel {
      left: calc(anchor(right) + var(--space-2));
      align-self: anchor-center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel { transition: none; transform: none !important; }
  }
  @media (forced-colors: active) {
    .panel { border: 1px solid CanvasText; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-hover-card.sui'

let _seq = 0

// Browsers without CSS Anchor Positioning fall back to JS rect math.
// Cached at module load — there's no platform path that toggles this
// at runtime, so re-checking per mount is wasted work.
const anchorSupported =
  typeof CSS !== 'undefined' &&
  typeof CSS.supports === 'function' &&
  CSS.supports('anchor-name', '--x')

type PopoverEl = HTMLElement & {
  showPopover?: () => void
  hidePopover?: () => void
}

type Placement = 'top' | 'bottom' | 'left' | 'right'

const GAP = 8

function positionPanel(trigger: HTMLElement, panel: HTMLElement, placement: Placement) {
  const r = trigger.getBoundingClientRect()
  panel.style.top = ''
  panel.style.left = ''
  panel.style.right = ''
  panel.style.bottom = ''
  switch (placement) {
    case 'top':
      panel.style.bottom = `${window.innerHeight - r.top + GAP}px`
      panel.style.left = `${r.left + r.width / 2}px`
      panel.style.transform = 'translateX(-50%)'
      break
    case 'left':
      panel.style.right = `${window.innerWidth - r.left + GAP}px`
      panel.style.top = `${r.top}px`
      break
    case 'right':
      panel.style.left = `${r.right + GAP}px`
      panel.style.top = `${r.top}px`
      break
    case 'bottom':
    default:
      panel.style.top = `${r.bottom + GAP}px`
      panel.style.left = `${r.left + r.width / 2}px`
      panel.style.transform = 'translateX(-50%)'
  }
}

export default controller<Scope>({
  mount(state, host) {
    const seq = ++_seq
    const cardId = `sui-hover-card-${seq}`
    const anchorName = `--sui-hc-${seq}`

    // Per-instance anchor name. CSS forwards it from the host to the
    // slotted trigger's anchor-name and the panel's position-anchor.
    host.style.setProperty('--sui-hc-anchor', anchorName)

    const triggerSlot = state.$signals.triggerSlot() as HTMLSlotElement | null
    const panelEl = state.$signals.panelEl() as PopoverEl | null

    if (!panelEl) return
    panelEl.id = cardId

    let showTimer: ReturnType<typeof setTimeout> | null = null
    let hideTimer: ReturnType<typeof setTimeout> | null = null

    function clearTimers() {
      if (showTimer) { clearTimeout(showTimer); showTimer = null }
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null }
    }

    function wireTrigger() {
      const els = triggerSlot?.assignedElements({ flatten: true }) as HTMLElement[] ?? []
      for (const el of els) {
        el.setAttribute('aria-describedby', cardId)
      }
    }

    function doShow() {
      clearTimers()
      const trigger = (triggerSlot?.assignedElements({ flatten: true }) as HTMLElement[])?.[0]
      // CSS Anchor Positioning owns placement when the browser supports
      // it. JS fallback only fires on older engines.
      if (trigger && panelEl && !anchorSupported) {
        positionPanel(trigger, panelEl as HTMLElement, (state.$signals.placement() || 'bottom') as Placement)
      }
      panelEl?.showPopover?.()
    }

    function doHide() {
      clearTimers()
      panelEl?.hidePopover?.()
    }

    ;(host as HTMLElement & { show(): void; hide(): void }).show = doShow
    ;(host as HTMLElement & { hide(): void }).hide = doHide

    const onToggle = (ev: Event) => {
      const te = ev as ToggleEvent
      const nowOpen = te.newState === 'open'
      if (nowOpen !== state.$signals.open()) state.$signals.open.set(nowOpen)
      host.setAttribute('data-state', nowOpen ? 'open' : 'closed')
      host.dispatchEvent(new CustomEvent(nowOpen ? 'sui-open' : 'sui-close', {
        bubbles: true, composed: true,
      }))
    }

    const onPointerEnter = () => {
      clearTimers()
      showTimer = setTimeout(() => doShow(), state.$signals.showDelay() ?? 300)
    }

    const onPointerLeave = () => {
      clearTimers()
      hideTimer = setTimeout(() => doHide(), state.$signals.hideDelay() ?? 100)
    }

    const onFocusIn = () => { clearTimers(); doShow() }
    const onFocusOut = () => {
      clearTimers()
      hideTimer = setTimeout(() => doHide(), state.$signals.hideDelay() ?? 100)
    }

    panelEl.addEventListener('toggle', onToggle)
    triggerSlot?.addEventListener('slotchange', wireTrigger)
    wireTrigger()

    host.addEventListener('pointerenter', onPointerEnter)
    host.addEventListener('pointerleave', onPointerLeave)
    host.addEventListener('focusin', onFocusIn)
    host.addEventListener('focusout', onFocusOut)

    const stopSync = effect(() => {
      host.setAttribute('data-state', state.$signals.open() ? 'open' : 'closed')
    })

    return () => {
      clearTimers()
      panelEl.removeEventListener('toggle', onToggle)
      triggerSlot?.removeEventListener('slotchange', wireTrigger)
      host.removeEventListener('pointerenter', onPointerEnter)
      host.removeEventListener('pointerleave', onPointerLeave)
      host.removeEventListener('focusin', onFocusIn)
      host.removeEventListener('focusout', onFocusOut)
      stopSync()
    }
  },
})

</controller>
<slot name="trigger" bind:this={triggerSlot}></slot>
<div class="panel" part="panel" popover="auto" bind:this={panelEl}
  sx="min-w:panel-min-w-md max-w:panel-max-w-sm p:4 bg:popover fg:popover-foreground border:border radius:xl text:base leading:normal">
  <slot></slot>
</div>
