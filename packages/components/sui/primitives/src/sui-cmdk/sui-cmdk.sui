<!--
  <sui-cmdk> — generic command palette (dialog + filterable list + keyboard nav).

  Composes <sui-dialog> for the modal shell (top-layer, focus trap, scroll
  lock, ::backdrop, ESC) — it does NOT reinvent any of that. On top of the
  dialog body it lays a search input pinned to the top and a scrollable,
  type-to-filter, keyboard-navigable listbox of items, optionally grouped.

  RUNTIME-FREE / SDK-FREE. Items + handlers arrive as data/events:
    • `prop:items` IDENTITY binding — a live `CmdkItem[]` from a parent
      controller (the primary runtime path; never serialized).
    • `items='[…JSON…]'` attribute — the SSR/declarative fallback (the
      compiler's <prop> vocab is string|bool|number, so structured data
      arrives as a JSON string parsed in the controller). Same name as the
      property, mirroring the sui-tree `tree`/`nodes` duality minus a second
      tag.
  The consuming app supplies the data and reacts to events — nothing here
  imports a client or a router.

  CmdkItem shape (all but id/label optional):
    { id, label, value?, icon?, hint?, group?, keywords?, disabled? }
  `value` defaults to `id`; `icon` is a <sui-icon> name; `keywords` widens
  the substring match beyond the visible label; `group` inserts a heading
  when it changes between consecutive items.

  Behaviour
  ─────────────────────────────────────────────────────────────────────────
  - Opening focuses the search input and highlights the first enabled item.
  - Typing filters case-insensitively over label + keywords; highlight
    resets to the first match.
  - ↑/↓ move the highlight (wrapping) over ENABLED items; Home/End jump to
    the first/last; Enter selects the highlight; Escape closes (the dialog's
    native cancel handles it). Clicking a row selects it.
  - Selecting emits `sui-cmdk-select {id, value}`, closes, and clears the
    query. Disabled rows render dimmed and are skipped by nav + click.
  ─────────────────────────────────────────────────────────────────────────
  Events (bubbling, composed):
    sui-cmdk-select {id, value}   a row was chosen
    sui-cmdk-input  {query}       the search query changed (async-search seam)
    sui-cmdk-open   {}            the palette opened
    sui-cmdk-close  {}            the palette closed
  Methods (host.expose): open(), close(), toggle()
  Parts: dialog, panel, search, input, list, group, item, item-icon,
         item-label, item-hint, empty
  ─────────────────────────────────────────────────────────────────────────
  ARIA: the input is role=combobox (aria-expanded, aria-controls,
        aria-activedescendant → the highlighted row's id); the list is
        role=listbox; rows are role=option with aria-selected on the
        highlight and aria-disabled on disabled rows.
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="placeholder" type="string" default="Type a command or search…" />
<prop name="label" type="string" default="Command palette" />
<prop name="empty-label" type="string" default="No results found." />
<prop name="size" values="sm|md|lg" default="md" reflect />

<!--
  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - cmdk has no tone/size of its own. The framework's global tone/size
    channels aren't relevant — this component never reads var(--tone)
    or var(--size-h). No <theme> block, no per-component tone/size
    redeclaration in :host.
  - Closes its dialog through the <sui-dialog> it composes. The dialog
    owns tone (its own prop), so cmdk's `size={size()}` is forwarded
    into the dialog's tone/size contract — and the dialog renders
    inside the same global channel system.
  - sx is the closed-vocab surface for everything reachable via a
    token + a layout keyword (column/row/gap/align/padding/radius/
    color/text). The <row>/<column> primitives in the template carry
    the flex/grid layout that feat/next authored by hand; the residual
    <style> below only keeps the selectors sx/variants cannot express
    (host baseline, downstream shadow part reset, native input reset,
    list scroll/overscroll, listbox <li> per-row styling with the
    class-selector + .hl + .disabled + .item-icon descendant compound).
  - The L1 <input> skin (text input baseline from contracts.css) is
    still inherited for font-family/color/focus-visible/disabled; the
    .entry reset zeros the surface the cmdk owns (border, padding,
    background, font-size) so the search bar is flush to its chrome.
-->

<!-- Residual: `:host { display:contents }` baseline (host doesn't
     take sx); `sui-dialog::part(body) { padding:0 }` — restyling a
     downstream shadow part can't reach via variants/sx; the
     `.cmdk` font-family (font: isn't an sx prop); `.search`
     border-bottom (no border-side sx prop) + flex:0 0 auto (no flex
     sx prop) — keeps the search bar a fixed-height strip; the
     native <input class="entry"> (input element, no shadow part);
     `.list` overflow-y/overscroll-behavior/scrollbar-width/min-
     height/flex raw values (no sx prop); `.group` text-transform +
     user-select (text-transform not in sx); `.item` user-select +
     scroll-margin + the .item.hl/.item.disabled class selectors
     (variants don't reach class selectors); `.item.hl .item-icon`
     descendant compound; `.item-icon { flex:0 0 auto }` raw; the
     `.item-label` text-overflow + white-space (text-overflow not
     in sx); `.item-hint` flex/margin-inline-start/font-family
     raw; `.empty` list-style/text-align raw. The `<li>` items
     inside `<ul>` are listbox rows so they keep the <li> element
     (cannot swap to <row>) — the .item .item.hl .item.disabled
     class rules therefore stay. -->
<style>
  :host { display: contents; }
  :host([hidden]) { display: none; }

  /* The dialog owns the chrome (top-layer, focus trap, ::backdrop). Zero its
     body padding via the documented part so the search bar sits flush to the
     panel edges and cmdk owns all interior spacing — no reaching into the
     dialog's private shadow vars. */
  sui-dialog::part(body) { padding: 0; }

  .cmdk { font-family: var(--font-body); }

  .search {
    border-bottom: 1px solid var(--border-subtle);
    flex: 0 0 auto;
  }
  .search-icon { flex: 0 0 auto; }

  .entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-normal);
  }
  .entry::placeholder { color: var(--muted-foreground); }

  .list {
    list-style: none;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 0;
    flex: 1 1 auto;
    scrollbar-width: thin;
  }

  .group {
    text-transform: uppercase;
    user-select: none;
  }

  .item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    user-select: none;
    scroll-margin: var(--space-2);
  }
  .item.hl { background: var(--selected-bg); }
  .item.disabled {
    color: var(--muted-foreground);
    cursor: default;
    opacity: 0.6;
  }
  .item-icon { flex: 0 0 auto; }
  .item.hl .item-icon { color: var(--foreground); }
  .item-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .item-hint {
    flex: 0 0 auto;
    margin-inline-start: auto;
    font-family: var(--font-mono);
  }

  .empty {
    list-style: none;
    text-align: center;
  }
</style>


<controller>
// <sui-cmdk> controller — generic command palette.
//
// Composes <sui-dialog> (modal shell + focus trap + scroll lock + ESC) and
// owns the search/filter/keyboard-nav layer on top of it. RUNTIME-FREE: data
// arrives via the `items` IDENTITY property (a live CmdkItem[]) or the `items`
// JSON attribute (SSR fallback), and selections leave as `sui-cmdk-*` events.
// No client, no router — the consuming app wires those.
//
// Templates declare, controllers do: the filtered/grouped render rows are
// derived here; mutations (highlight, select, open/close sync) + emission live
// in mount's listeners.

import { controller, signal, derived, effect, ref } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-cmdk.sui'
import { type CmdkItem, str, parseJsonItems } from './decode'

export type { CmdkItem } from './decode'

/** A normalized, filter-position-tagged item (concrete fields, no optionals). */
interface VisibleItem {
  id: string
  optId: string
  value: string
  label: string
  icon: string
  hint: string
  group: string
  disabled: boolean
}

/** A flat render row — uniform shape (heading rows zero the item fields) so the
 *  template never relies on discriminated-union narrowing. */
interface RenderRow {
  key: string
  isHeading: boolean
  heading: string
  id: string
  optId: string
  value: string
  label: string
  icon: string
  hint: string
  disabled: boolean
}

let _seq = 0

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const seq = ++_seq
    const itemsSig = signal<CmdkItem[]>([])
    const query = signal('')
    const highlight = signal(0)
    const listId = signal(`sui-cmdk-list-${seq}`)

    const dialogEl = ref<HTMLElement>(null)
    const inputEl = ref<HTMLInputElement>(null)
    const listEl = ref<HTMLUListElement>(null)

    // Filter case-insensitively over label + keywords, preserving order, and
    // tag each survivor with a stable per-instance option id.
    const visible = derived<VisibleItem[]>(() => {
      const q = query().trim().toLowerCase()
      const out: VisibleItem[] = []
      for (const it of itemsSig()) {
        const hay = q ? `${it.label} ${it.keywords ?? ''}`.toLowerCase() : ''
        if (q && !hay.includes(q)) continue
        out.push({
          id: it.id,
          optId: `sui-cmdk-opt-${seq}-${it.id}`,
          value: it.value != null ? it.value : it.id,
          label: it.label,
          icon: str(it.icon),
          hint: str(it.hint),
          group: str(it.group),
          disabled: it.disabled === true,
        })
      }
      return out
    })

    // The keyboard-navigable subset (enabled rows only); highlight indexes here.
    const navigable = derived<VisibleItem[]>(() => visible().filter((v) => !v.disabled))

    // Highlight clamped to the live navigable range (or 0 when empty), so a
    // shrinking filtered set can never strand the selection past the end.
    const safeHighlight = derived<number>(() => {
      const n = navigable().length
      if (n === 0) return 0
      const h = highlight()
      return h < 0 ? 0 : h >= n ? n - 1 : h
    })

    const highlightId = derived<string>(() => navigable()[safeHighlight()]?.id ?? '')
    const activeId = derived<string>(() => navigable()[safeHighlight()]?.optId ?? '')

    // Flatten to render rows, injecting a heading row whenever `group` changes.
    const rows = derived<RenderRow[]>(() => {
      const out: RenderRow[] = []
      let lastGroup: string | null = null
      for (const v of visible()) {
        if (v.group !== '' && v.group !== lastGroup) {
          out.push({
            key: `g:${v.group}`,
            isHeading: true,
            heading: v.group,
            id: '',
            optId: '',
            value: '',
            label: '',
            icon: '',
            hint: '',
            disabled: false,
          })
        }
        lastGroup = v.group
        out.push({
          key: `i:${v.id}`,
          isHeading: false,
          heading: '',
          id: v.id,
          optId: v.optId,
          value: v.value,
          label: v.label,
          icon: v.icon,
          hint: v.hint,
          disabled: v.disabled,
        })
      }
      return out
    })

    return {
      itemsSig, query, highlight, listId,
      dialogEl, inputEl, listEl,
      visible, navigable, safeHighlight, highlightId, activeId, rows,
    }
  },

  mount(state, host) {
    // ── `items` IDENTITY property + JSON-attribute SSR fallback ──────────────
    // A live CmdkItem[] assigned to the host `items` property (never a string).
    // Defined on the instance so it shadows nothing — `items` is intentionally
    // NOT a declared <prop>, so there is no compiler accessor to clash with.
    Object.defineProperty(host, 'items', {
      configurable: true,
      get: () => state.itemsSig,
      set: (v: CmdkItem[] | null) => {
        state.itemsSig = Array.isArray(v) ? v : []
        state.highlight = 0
      },
    })
    if (state.itemsSig.length === 0) {
      const raw = host.getAttribute('items') ?? ''
      const parsed = parseJsonItems(raw)
      if (parsed.length > 0) state.itemsSig = parsed
    }

    const scrollActiveIntoView = () => {
      const list = state.listEl as HTMLUListElement | null
      const id = state.activeId as string
      if (!list || !id) return
      // Match by id without a CSS selector — option ids derive from caller
      // data and `CSS.escape` is absent under jsdom, so a plain scan is the
      // robust path. scrollIntoView is optional (jsdom stubs it).
      let target: HTMLElement | null = null
      for (const li of Array.from(list.querySelectorAll('li.item'))) {
        if ((li as HTMLElement).id === id) {
          target = li as HTMLElement
          break
        }
      }
      target?.scrollIntoView?.({ block: 'nearest' })
    }

    // Reset query + highlight on each open; emit open/close. The dialog drives
    // its own native open via prop:open={open()}; here we react to the state.
    let wasOpen = false
    const stopOpenSync = effect(() => {
      const isOpen = state.open === true
      if (isOpen === wasOpen) return
      wasOpen = isOpen
      if (isOpen) {
        state.query = ''
        state.highlight = 0
        host.emit?.('sui-cmdk-open', {})
        // Focus is grabbed by the dialog's own focus trap (the input is its
        // first focusable); nudge the highlight into view once rows paint.
        queueMicrotask(scrollActiveIntoView)
      } else {
        host.emit?.('sui-cmdk-close', {})
      }
    })

    // The dialog closes itself on ESC / backdrop click; mirror that back into
    // our `open` prop so the two never drift.
    const dialog = state.dialogEl as HTMLElement | null
    const onDialogClose = () => {
      if (state.open) state.open = false
    }
    dialog?.addEventListener('sui-close', onDialogClose)

    const input = state.inputEl as HTMLInputElement | null

    const selectByItem = (item: VisibleItem | undefined) => {
      if (!item || item.disabled) return
      host.emit?.('sui-cmdk-select', { id: item.id, value: item.value })
      state.open = false
    }

    const onInput = () => {
      state.highlight = 0
      host.emit?.('sui-cmdk-input', { query: (state.query as string) ?? '' })
    }

    const moveHighlight = (delta: number) => {
      const list = state.navigable as VisibleItem[]
      const n = list.length
      if (n === 0) return
      const base = state.safeHighlight as number
      state.highlight = (base + delta + n) % n
      queueMicrotask(scrollActiveIntoView)
    }

    const onKeydown = (e: KeyboardEvent) => {
      const list = state.navigable as VisibleItem[]
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        moveHighlight(1)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        moveHighlight(-1)
      } else if (e.key === 'Home') {
        e.preventDefault()
        state.highlight = 0
        queueMicrotask(scrollActiveIntoView)
      } else if (e.key === 'End') {
        e.preventDefault()
        state.highlight = Math.max(0, list.length - 1)
        queueMicrotask(scrollActiveIntoView)
      } else if (e.key === 'Enter') {
        e.preventDefault()
        selectByItem(list[state.safeHighlight as number])
      }
      // Escape is intentionally untouched — the dialog's native `cancel`
      // handler closes the modal and fires `sui-close`.
    }

    input?.addEventListener('input', onInput)
    input?.addEventListener('keydown', onKeydown)

    // Pointer commit. mousedown (before any blur/focus shuffle) selects the row.
    const list = state.listEl as HTMLUListElement | null
    const onListMousedown = (e: MouseEvent) => {
      const li = (e.target as HTMLElement | null)?.closest?.('li.item[data-id]') as HTMLElement | null
      if (!li || li.getAttribute('aria-disabled') === 'true') return
      e.preventDefault()
      const id = li.dataset.id ?? ''
      const match = (state.visible as VisibleItem[]).find((v) => v.id === id)
      selectByItem(match)
    }
    list?.addEventListener('mousedown', onListMousedown)

    // `show()` (not `open()`) — `open` is a declared <prop>, so its accessor
    // owns that name; consumers open imperatively via `el.show()` or set
    // `el.open = true` directly.
    host.expose?.({
      show: () => {
        state.open = true
      },
      close: () => {
        state.open = false
      },
      toggle: () => {
        state.open = !state.open
      },
    })

    return () => {
      stopOpenSync()
      dialog?.removeEventListener('sui-close', onDialogClose)
      input?.removeEventListener('input', onInput)
      input?.removeEventListener('keydown', onKeydown)
      list?.removeEventListener('mousedown', onListMousedown)
    }
  },
})

</controller>
<sui-dialog
  part="dialog"
  size={size()}
  backdrop="blur"
  no-header
  no-footer
  no-close-button
  prop:open={open()}
  bind:this={dialogEl}
>
  <column class="cmdk" part="panel" gap="0"
    sx="min-h:0 fg:foreground">
    <row class="search" part="search" align="center" gap="2"
      sx="p:3 px:4">
      <sui-icon class="search-icon" name="search" size="sm"></sui-icon>
      <input
        class="entry"
        part="input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls={listId()}
        aria-activedescendant={activeId()}
        aria-label={label()}
        placeholder={placeholder()}
        bind:value={query}
        bind:this={inputEl}
      />
    </row>
    <ul
      class="list"
      part="list"
      sx="max-h:panel-vh-sm p:1"
      role="listbox"
      id={listId()}
      aria-label={label()}
      bind:this={listEl}
    >
      {#for row of rows() key={row.key}}
        {#if row.isHeading}
          <li class="group" part="group" role="presentation" sx="py:2 pb:1 text:xs weight:semibold tracking:wide fg:muted-foreground">{row.heading}</li>
        {:else}
          <li
            class="item"
            part="item"
            sx="p:2 radius:sm text:sm fg:foreground cursor:pointer"
            role="option"
            id={row.optId}
            data-id={row.id}
            data-value={row.value}
            class:hl={!row.disabled && row.id === highlightId()}
            class:disabled={row.disabled}
            aria-selected={!row.disabled && row.id === highlightId() ? 'true' : 'false'}
            aria-disabled={row.disabled ? 'true' : 'false'}
          >
            {#if row.icon !== ''}
              <sui-icon class="item-icon" part="item-icon" name={row.icon} size="sm" sx="fg:muted-foreground"></sui-icon>
            {/if}
            <span class="item-label" part="item-label" sx="overflow:hidden">{row.label}</span>
            {#if row.hint !== ''}
              <span class="item-hint" part="item-hint" sx="text:xs fg:muted-foreground">{row.hint}</span>
            {/if}
          </li>
        {/if}
      {/for}
      {#if rows().length === 0}
        <li class="empty" part="empty" role="presentation" sx="p:6 px:4 text:sm fg:muted-foreground">{emptyLabel()}</li>
      {/if}
    </ul>
  </column>
</sui-dialog>
