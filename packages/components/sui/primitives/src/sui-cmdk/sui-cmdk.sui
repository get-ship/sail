<!--
  <sui-cmdk> — generic command palette (dialog + filterable list + keyboard nav).

  Composes <sui-dialog> for the modal shell (top-layer, focus trap, scroll
  lock, ::backdrop, ESC) — it does NOT reinvent any of that. On top of the
  dialog body it lays a search input pinned to the top and a scrollable,
  type-to-filter, keyboard-navigable listbox of items, optionally grouped.

  RUNTIME-FREE / SDK-FREE. Items + handlers arrive as data/events:
    • `prop:items` IDENTITY binding — a live `CmdkItem[]` from a parent
      controller (the primary runtime path; never serialized).
    • `items='[…JSON…]'` attribute — the SSR/declarative fallback (the
      compiler's <prop> vocab is string|bool|number, so structured data
      arrives as a JSON string parsed in the controller). Same name as the
      property, mirroring the sui-tree `tree`/`nodes` duality minus a second
      tag.
  The consuming app supplies the data and reacts to events — nothing here
  imports a client or a router.

  CmdkItem shape (all but id/label optional):
    { id, label, value?, icon?, hint?, group?, keywords?, disabled? }
  `value` defaults to `id`; `icon` is a <sui-icon> name; `keywords` widens
  the substring match beyond the visible label; `group` inserts a heading
  when it changes between consecutive items.

  Behaviour
  ─────────────────────────────────────────────────────────────────────────
  - Opening focuses the search input and highlights the first enabled item.
  - Typing filters case-insensitively over label + keywords; highlight
    resets to the first match.
  - ↑/↓ move the highlight (wrapping) over ENABLED items; Home/End jump to
    the first/last; Enter selects the highlight; Escape closes (the dialog's
    native cancel handles it). Clicking a row selects it.
  - Selecting emits `sui-cmdk-select {id, value}`, closes, and clears the
    query. Disabled rows render dimmed and are skipped by nav + click.
  ─────────────────────────────────────────────────────────────────────────
  Events (bubbling, composed):
    sui-cmdk-select {id, value}   a row was chosen
    sui-cmdk-input  {query}       the search query changed (async-search seam)
    sui-cmdk-open   {}            the palette opened
    sui-cmdk-close  {}            the palette closed
  Methods (host.expose): open(), close(), toggle()
  Parts: dialog, panel, search, input, list, group, item, item-icon,
         item-label, item-hint, empty
  ─────────────────────────────────────────────────────────────────────────
  ARIA: the input is role=combobox (aria-expanded, aria-controls,
        aria-activedescendant → the highlighted row's id); the list is
        role=listbox; rows are role=option with aria-selected on the
        highlight and aria-disabled on disabled rows.
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="placeholder" type="string" default="Type a command or search…" />
<prop name="label" type="string" default="Command palette" />
<prop name="empty-label" type="string" default="No results found." />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host { display: contents; }
  :host([hidden]) { display: none; }

  /* The dialog owns the chrome (top-layer, focus trap, ::backdrop). Zero its
     body padding via the documented part so the search bar sits flush to the
     panel edges and cmdk owns all interior spacing — no reaching into the
     dialog's private shadow vars. */
  sui-dialog::part(body) { padding: 0; }

  .cmdk {
    display: flex;
    flex-direction: column;
    min-height: 0;
    font-family: var(--font-body);
    color: var(--foreground);
  }

  .search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
    flex: 0 0 auto;
  }
  .search-icon { flex: 0 0 auto; }
  .entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);
    line-height: var(--leading-normal);
  }
  .entry::placeholder { color: var(--muted-foreground); }

  .list {
    list-style: none;
    margin: 0;
    padding: var(--space-1);
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 0;
    flex: 1 1 auto;
    scrollbar-width: thin;
  }

  .group {
    text-transform: uppercase;
    user-select: none;
  }

  .item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    user-select: none;
    scroll-margin: var(--space-2);
  }
  .item.hl { background: var(--selected-bg); }
  .item.disabled {
    color: var(--muted-foreground);
    cursor: default;
    opacity: 0.6;
  }
  .item-icon { flex: 0 0 auto; }
  .item.hl .item-icon { color: var(--foreground); }
  .item-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .item-hint {
    flex: 0 0 auto;
    margin-inline-start: auto;
    font-family: var(--font-mono);
  }

  .empty {
    list-style: none;
    text-align: center;
  }
</style>

<sui-dialog
  part="dialog"
  size={size()}
  backdrop="blur"
  no-header
  no-footer
  no-close-button
  prop:open={open()}
  bind:this={dialogEl}
>
  <div class="cmdk" part="panel">
    <div class="search" part="search" sx="p:3 px:4">
      <sui-icon class="search-icon" name="search" size="sm"></sui-icon>
      <input
        class="entry"
        part="input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls={listId()}
        aria-activedescendant={activeId()}
        aria-label={label()}
        placeholder={placeholder()}
        bind:value={query}
        bind:this={inputEl}
      />
    </div>
    <ul
      class="list"
      part="list"
      sx="max-h:panel-vh-sm"
      role="listbox"
      id={listId()}
      aria-label={label()}
      bind:this={listEl}
    >
      {#for row of rows() key={row.key}}
        {#if row.isHeading}
          <li class="group" part="group" role="presentation" sx="py:2 pb:1 text:xs weight:semibold tracking:wide fg:muted-foreground">{row.heading}</li>
        {:else}
          <li
            class="item"
            part="item"
            sx="p:2 radius:sm text:sm fg:foreground cursor:pointer"
            role="option"
            id={row.optId}
            data-id={row.id}
            data-value={row.value}
            class:hl={!row.disabled && row.id === highlightId()}
            class:disabled={row.disabled}
            aria-selected={!row.disabled && row.id === highlightId() ? 'true' : 'false'}
            aria-disabled={row.disabled ? 'true' : 'false'}
          >
            {#if row.icon !== ''}
              <sui-icon class="item-icon" part="item-icon" name={row.icon} size="sm" sx="fg:muted-foreground"></sui-icon>
            {/if}
            <span class="item-label" part="item-label" sx="overflow:hidden">{row.label}</span>
            {#if row.hint !== ''}
              <span class="item-hint" part="item-hint" sx="text:xs fg:muted-foreground">{row.hint}</span>
            {/if}
          </li>
        {/if}
      {/for}
      {#if rows().length === 0}
        <li class="empty" part="empty" role="presentation" sx="p:6 px:4 text:sm fg:muted-foreground">{emptyLabel()}</li>
      {/if}
    </ul>
  </div>
</sui-dialog>
