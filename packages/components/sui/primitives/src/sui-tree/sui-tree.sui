<!--
  <sui-tree> — engine-backed, virtualized hierarchical tree (role=tree).

  Proves the SHARED-ENGINE REUSE law: a hierarchy is the Table engine's
  expansion model turned on, NOT a parallel engine. There is no createTree().
  The controller calls createTable({ getSubRows, getRowId, columns: [],
  initialState: { expanded } }), reads the flattened depth-first, expansion-
  respecting table.rows(), and renders it WINDOWED through createVirtualizer —
  one [role=treeitem] per VISIBLE node, indented by row.depth.

  The live Table<T> arrives via prop:tree IDENTITY binding (never a serialized
  object attribute); a `nodes` JSON attribute is the SSR/declarative fallback.

  Density is the platform axis (<html data-density>) — rows read the --density-*
  channel. There is NO density/dense prop.

  Events (host.emit): sui-toggle {id, expanded}, sui-expand-change {expanded},
  sui-select {id}, sui-node-select {selected, selectedIds}, sui-node-click
  {id, depth, index}.
-->

<prop name="nodes" type="string" default="" />
<prop name="label" type="string" default="" />
<prop name="selectable" values="none|single|multi" default="none" reflect />
<prop name="expand-on-select" type="bool" default="false" reflect />
<prop name="show-guides" type="bool" default="true" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="loading" type="bool" default="false" reflect />
<prop name="error" type="string" default="" />

<style>
  :host {
    display: block;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--density-text);
    color: var(--foreground);
    --sui-tree-indent: var(--density-row-px);
  }
  :host([hidden]) { display: none; }

  .viewport {
    position: relative;
    width: 100%;
    overflow-y: auto;
    max-height: 480px;
  }
  .spacer {
    position: relative;
    width: 100%;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--density-row-gap);
    padding: var(--density-row-py) var(--density-row-px);
    position: absolute;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm);
    cursor: pointer;
    outline: none;
    color: var(--foreground);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .row:hover { background: var(--hover-bg); }
  .row[data-selected] { background: var(--selected-bg); font-weight: var(--font-weight-medium); }
  .row[data-pending] {
    cursor: default;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .row[data-pending]:hover { background: transparent; }
  .row:focus-visible {
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring-color);
  }

  .caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--density-icon);
    height: var(--density-icon);
    color: var(--muted-foreground);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .row[data-expanded] .caret { transform: rotate(90deg); }
  .row:not([data-can-expand]) .caret { visibility: hidden; }

  .gutter { display: inline-flex; align-items: center; flex: none; }

  .label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .trailing { margin-inline-start: auto; color: var(--muted-foreground); font-size: var(--text-xs); }

  :host([show-guides]) .row::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--sui-tree-indent) * 0.5);
    border-inline-start: 1px dashed var(--border);
  }

  @media (forced-colors: active) {
    .row:focus-visible { outline: 2px solid CanvasText; outline-offset: -2px; }
  }
</style>

{#if error() !== ''}
<div class="tree-error" part="error" role="alert">
  <sui-error-state prop:message={error()}></sui-error-state>
</div>
{:else if isEmptyInitial()}
<div class="tree-empty" part="empty" role="status">
  <slot name="empty"><sui-empty-state></sui-empty-state></slot>
</div>
{:else if isEmptyFiltered()}
<div class="tree-empty" part="empty" role="status">
  <slot name="empty">
    <sui-empty-state>
      <button slot="action" type="button" data-action="clear-filters">Clear filters</button>
    </sui-empty-state>
  </slot>
</div>
{:else}
<div
  class="tree"
  part="tree"
  role="tree"
  aria-label={label() || null}
  aria-multiselectable={selectable() === 'multi' ? 'true' : null}
>
  <div class="viewport" part="viewport" bind:this={viewportEl}>
    <div class="spacer" part="spacer" style:height={`${totalSize()}px`}>
      {#for w of windowItems() key={w.key}}
        <div
          class="row"
          part="row"
          role="treeitem"
          data-node-id={w.id}
          aria-level={w.level}
          aria-posinset={w.posInSet}
          aria-setsize={w.setSize}
          aria-rowindex={w.index + 1}
          aria-expanded={w.canExpand ? (w.expanded ? 'true' : 'false') : null}
          aria-selected={selectable() !== 'none' ? (w.selected ? 'true' : 'false') : null}
          data-can-expand={w.canExpand ? 'true' : null}
          data-expanded={w.expanded ? 'true' : null}
          data-selected={w.selected ? 'true' : null}
          data-pending={w.pending ? 'true' : null}
          tabindex={w.id === activeRowId() ? '0' : '-1'}
          style:transform={`translateY(${w.start}px)`}
          style:padding-inline-start={`calc(var(--density-row-px) + ${w.indent}px)`}
        >
          <span class="caret" part="caret" aria-hidden="true">
            <sui-icon name="chevron-right" size="xs"></sui-icon>
          </span>
          {#if selectable() === 'multi'}
            <span class="gutter" part="gutter">
              <sui-checkbox
                size="sm"
                prop:checked={w.selected}
                prop:indeterminate={w.someSelected}
              ></sui-checkbox>
            </span>
          {/if}
          <slot name="node-icon"></slot>
          <span class="label" part="label">{w.label}</span>
          <span class="trailing"><slot name="node-trailing"></slot></span>
        </div>
      {/for}
    </div>
  </div>
</div>
{/if}
