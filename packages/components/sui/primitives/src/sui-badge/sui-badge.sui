<!--
  <sui-badge> — SUI port of <ship-badge>.
  Static status label. Small, non-interactive, tone-colored.

  Prop / event / method parity vs <ship-badge>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (String, 'muted')          tone (union, 'default',  ✓ default changed to
                                    reflect)               'default' — neutral
                                                           base in SUI catalog
  variant (null → soft,           variant (union,          ✓
    'solid'|'soft'|'outline')       'soft', reflect)
  size ('sm'|'md'|'lg', 'md')     size (union, 'md',      ✓ + all three sizes
                                    reflect)
  pill (Boolean, false)           pill (bool, reflect)    ✓
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)             ✓
  ─────────────────────────────────────────────────────────────────────────────
  slots: leading, default         slots: leading, default ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: badge, leading           parts: badge, leading   ✓ (inner span)
  ─────────────────────────────────────────────────────────────────────────────
  :has(::slotted(*)) hides empty  same pattern            ✓
    leading wrapper
  ─────────────────────────────────────────────────────────────────────────────
  Lit default tone is 'muted'     SUI default is 'default' SUI catalog default
  (uppercase + 0.04em tracking)   (same typographic       typography matches
                                    style)                 Lit
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="solid|soft|outline" default="soft" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<style>

  /* Tone-color mapping — defaults to the muted tone ramp so the base
   * .badge reads as a soft, low-key status label. Each tone variant
   * sets --tone + --tone-fg + --tone-contrast, and the .badge rules
   * read --tone-bg / --tone-border so we never hand-roll a color-mix
   * in the component CSS. */
  :host {
    display: inline-flex;
    vertical-align: middle;
    --tone: var(--muted-foreground);
    --tone-fg: var(--muted-foreground);
    --tone-contrast: var(--background);
    --tone-bg: var(--tone-muted-bg);
    --tone-border: var(--tone-muted-border);
    /* Size channel defaults */
    --bdg-h: 22px;
    --bdg-px: 8px;
    --bdg-fs: 10.5px;
    --bdg-gap: 4px;
    --bdg-icon: 10px;
    /* Shape channel */
    --bdg-radius: var(--radius-sm);
  }
  :host([hidden]) { display: none; }

  /* Size matrix */
  :host([size='sm']) { --bdg-h: 18px; --bdg-px: 6px;  --bdg-fs: 9.5px;  --bdg-gap: 3px; --bdg-icon: 8px; }
  :host([size='md']) { --bdg-h: 22px; --bdg-px: 8px;  --bdg-fs: 10.5px; --bdg-gap: 4px; --bdg-icon: 10px; }
  :host([size='lg']) { --bdg-h: 26px; --bdg-px: 10px; --bdg-fs: 11.5px; --bdg-gap: 5px; --bdg-icon: 12px; }

  /* Shape — square default, pill when opted-in */
  :host([pill]) { --bdg-radius: var(--radius-full); }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--bdg-gap);
    min-height: var(--bdg-h);
    padding: 0 var(--bdg-px);
    font-family: var(--font-body);
    font-size: var(--bdg-fs);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--bdg-radius);
    /* soft is the default — base .badge renders as soft */
    background: var(--tone-bg);
    border: 1px solid var(--tone-border);
    color: var(--tone-fg);
    white-space: nowrap;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }
  /* Variant matrix */
  :host([variant='soft']) .badge {
    background: var(--tone-bg);
    border-color: var(--tone-border);
    color: var(--tone-fg);
  }
  :host([variant='solid']) .badge {
    background: var(--tone);
    border-color: var(--tone);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 var(--hover-bg);
  }
  :host([variant='outline']) .badge {
    background: transparent;
    border-color: var(--tone-border);
    color: var(--tone-fg);
  }

  /* Leading slot wrapper — hidden when empty */
  .leading {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--bdg-icon);
    height: var(--bdg-icon);
    flex-shrink: 0;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }
  ::slotted([slot='leading']) {
    display: inline-flex;
    align-items: center;
    color: currentColor;
    width: 100%;
    height: 100%;
  }

  @media (forced-colors: active) {
    .badge { border-color: CanvasText; color: CanvasText; }
    :host([variant='solid']) .badge { background: Highlight; color: HighlightText; border-color: Highlight; }
  }
</style>

<span class="badge" part="badge">
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
</span>
