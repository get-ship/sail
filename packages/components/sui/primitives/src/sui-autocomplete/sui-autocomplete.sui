<!--
  <sui-autocomplete> — text input with a suggestion dropdown.
  Differs from <sui-combobox> in one fundamental way: the value is
  free-form text. Suggestions are hints — accepting one fills the
  input, but the user can also type and submit anything else.

  Suggestions come from light-DOM <option value="x">Label</option>
  children OR a `suggestions="…JSON…"` attribute (array of strings or
  `{ value, label }` records — parsed in the controller).

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Typing opens the dropdown and filters case-insensitively against
    the value field.
  - ↑ / ↓ move highlight. Enter accepts the highlighted suggestion (if
    any), otherwise commits the typed text as-is.
  - Escape closes without commit (value stays at last-emitted text).
  - Click on a suggestion accepts it.
  ─────────────────────────────────────────────────────────────────────
  ARIA: input role=combobox, aria-autocomplete=list, aria-expanded,
        aria-controls, aria-activedescendant.
  ─────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone/size are GLOBAL framework channels now (contracts.css). feat/next
    hand-rolled `.sui-autocomplete[tone='x'] { --tone-border: …; --tone-ring: … }`
    and `.sui-autocomplete[size='x'] { --h: …; --fs: …; --px: … }` directly in its
    own residual style block (no theme directive even there — an older
    pattern still, same as sui-combobox). Both are DELETED; this skin
    reads var(--tone-border)/var(--tone-ring) and var(--size-h)/
    var(--size-px)/var(--size-fs) straight off the framework sheets.
    autocomplete's 8 tone values are exactly the framework's 8 tones.
  - The focus-within ring keeps feat/next's single box-shadow-glow shape
    (not the framework's two-layer `ring:` sx composition — that reads as
    a different, offset-gap shape). The raw `3px` becomes
    `var(--ring-width)`, the framework's own token for this thickness —
    same substitution as sui-combobox (this component has no `[data-open]`
    ring; feat/next only glows on :focus-within here).
  - Disabled: feat/next's `opacity: 0.65` isn't reachable — sx's opacity
    scale is quartile-stepped (0/25/50/75/100), no arbitrary percentage —
    collapsed to `opacity:50`, the same "dimmed, inert" step sui-combobox
    uses (and what the framework's own control-contracts use for disabled
    native controls), rather than a hand-tuned in-between value.
  - The wrap's background is `surface-1` here (feat/next's own choice,
    distinct from combobox's `background` — preserved, not homogenized).
    The input, once nested in a shadow root, now inherits the framework's
    global field skin (border/padding/shadow/min-height); its own sx
    explicitly matches the wrap's `surface-1` (not the global default
    `background`) so no seam shows between input and wrap, and cancels
    border/shadow/padding so it doesn't draw a second box.

  LANG-GAP — plain `flex`, and the opt-check glyph opacity toggle
  ─────────────────────────────────────────────────────────────────────
  sx's `display` enum offers `inline-flex` but no plain `flex` — the
  option rows need a BLOCK-level flex row (inline-flex would shrink each
  row to its content width, breaking the full-width hit area) — stays
  hand-authored in the residual style, same gap as sui-combobox. The
  per-option check-glyph's hover/highlight opacity toggle (0 → 1) is a
  dynamic class (`class:hl`) driving a descendant selector
  (`.opt.hl .opt-check`) — no variants selector reaches a dynamically
  toggled class on a *different* element than the one the class lives
  on, so it stays a plain, token-free (0/1 are unitless, not tokenizable)
  residual rule, same shape as feat/next.
-->

<component>{
  props: {
    name: '',
    value: '',
    placeholder: '',
    suggestions: '',
    disabled: false,
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    size: 'md' | 'sm' | 'lg',
  },
}</component>
<host sx="position:relative display:inline-flex w:full"></host>

<variants class="wrap">
  [disabled]: bg:muted cursor:not-allowed opacity:50
</variants>

<style>
  .sui-autocomplete {
    flex-direction: column;
    vertical-align: middle;
  }
  .wrap,
  .opt,
  .opt-label {
    font-family: var(--font-body);
  }
  .wrap {
    align-items: center;
    gap: var(--space-2);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 var(--ring-width) var(--tone-ring);
  }
  .entry {
    flex: 1;
    min-width: 0;
    outline: 0;
  }
  .listbox {
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    list-style: none;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    user-select: none;
  }
  .opt-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .opt-check { opacity: 0; }
  .opt.hl { background: var(--selected-bg); }
  .opt.hl .opt-check { opacity: 1; }
</style>


<controller>
import { controller, derived, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-autocomplete.sui'

interface Suggestion { value: string; label: string }
interface FilteredSuggestion extends Suggestion { id: string; idx: number }

let listIdSeq = 0

const parseJsonSuggestions = (raw: string): Suggestion[] => {
  if (!raw) return []
  try {
    const parsed = JSON.parse(raw) as unknown
    if (!Array.isArray(parsed)) return []
    return parsed
      .map((entry) => {
        if (typeof entry === 'string') return { value: entry, label: entry }
        if (entry && typeof entry === 'object') {
          const o = entry as { value?: unknown; label?: unknown }
          const value = o.value != null ? String(o.value) : ''
          const label = o.label != null ? String(o.label) : value
          return value ? { value, label } : null
        }
        return null
      })
      .filter((s): s is Suggestion => s !== null)
  } catch {
    return []
  }
}

const readLightSuggestions = (host: HTMLElement): Suggestion[] => {
  const els = Array.from(host.querySelectorAll(':scope > option')) as HTMLOptionElement[]
  return els.map((el) => ({
    value: el.value || el.textContent?.trim() || '',
    label: el.textContent?.trim() || el.value || '',
  })).filter((s) => s.value !== '')
}

export default controller({
  scope: ({ suggestions, value }: ViewScope<Scope>) => {
    const open = signal(false)
    const highlight = signal(0)
    const slotSuggestions = signal<Suggestion[]>([])
    const inputEl = ref<HTMLInputElement>(null)
    const listEl = ref<HTMLUListElement>(null)
    const suggestionsSlot = ref<HTMLSlotElement>(null)
    const listId = signal(`sui-autocomplete-list-${++listIdSeq}`)

    const parsedSuggestions = derived<Suggestion[]>(() => {
      const fromAttr = parseJsonSuggestions(suggestions())
      if (fromAttr.length > 0) return fromAttr
      return slotSuggestions()
    })
    const filtered = derived<FilteredSuggestion[]>(() => {
      const q = value().trim().toLowerCase()
      const all = parsedSuggestions()
      const matched = q
        ? all.filter((s) => s.value.toLowerCase().includes(q) || s.label.toLowerCase().includes(q))
        : all
      return matched.map((s, idx) => ({
        ...s,
        idx,
        id: `sui-autocomplete-opt-${idx}`,
      }))
    })
    const activeId = derived<string>(() => {
      if (!open()) return ''
      const list = filtered()
      const h = highlight()
      return list[h]?.id ?? ''
    })

    return {
      open, highlight, slotSuggestions,
      inputEl, listEl, suggestionsSlot, listId,
      parsedSuggestions, filtered, activeId,
    }
  },

  mount(state, host) {
    let lastEmitted: string | null = null

    const refreshSlotSuggestions = () => {
      state.slotSuggestions = readLightSuggestions(host)
    }
    refreshSlotSuggestions()
    const slot = state.suggestionsSlot as HTMLSlotElement | null
    slot?.addEventListener('slotchange', refreshSlotSuggestions)

    const inputEl = state.inputEl as HTMLInputElement | null
    if (!inputEl) return

    const openList = () => {
      if (state.disabled) return
      if (!state.open) {
        state.open = true
        state.highlight = 0
      }
    }

    const closeList = () => {
      if (!state.open) return
      state.open = false
    }

    const commit = (text: string, label?: string) => {
      state.value = text
      state.open = false
      if (lastEmitted !== text) {
        lastEmitted = text
        host.dispatchEvent(
          new CustomEvent('sui-change', {
            detail: { value: text, label: label ?? text },
            bubbles: true,
            composed: true,
          }),
        )
      }
    }

    const onFocus = () => openList()
    const onClick = () => openList()
    const onInput = () => {
      if (!state.open) state.open = true
      state.highlight = 0
    }
    const onKeydown = (e: KeyboardEvent) => {
      const list = state.filtered as FilteredSuggestion[]
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        if (!state.open) { openList(); return }
        if (list.length === 0) return
        state.highlight = (state.highlight + 1) % list.length
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        if (!state.open) { openList(); return }
        if (list.length === 0) return
        const h = state.highlight
        state.highlight = h <= 0 ? list.length - 1 : h - 1
      } else if (e.key === 'Enter') {
        e.preventDefault()
        if (state.open && list.length > 0) {
          const sel = list[state.highlight]
          if (sel) { commit(sel.value, sel.label); return }
        }
        commit(state.value as string)
      } else if (e.key === 'Escape') {
        if (!state.open) return
        e.preventDefault()
        closeList()
      } else if (e.key === 'Tab') {
        closeList()
      }
    }
    const onBlur = (e: FocusEvent) => {
      const next = e.relatedTarget as Node | null
      if (next && host.shadowRoot?.contains(next)) return
      setTimeout(() => closeList(), 0)
    }

    inputEl.addEventListener('focus', onFocus)
    inputEl.addEventListener('click', onClick)
    inputEl.addEventListener('input', onInput)
    inputEl.addEventListener('keydown', onKeydown)
    inputEl.addEventListener('blur', onBlur)

    const onShadowMousedown = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null
      const li = target?.closest?.('li.opt[data-value]') as HTMLElement | null
      if (!li) return
      e.preventDefault()
      const value = li.dataset.value ?? ''
      const list = state.filtered as FilteredSuggestion[]
      const match = list.find((s) => s.value === value)
      commit(value, match?.label)
    }
    host.shadowRoot?.addEventListener('mousedown', onShadowMousedown as EventListener)

    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      open: openList,
      close: () => closeList(),
    })

    return () => {
      slot?.removeEventListener('slotchange', refreshSlotSuggestions)
      inputEl.removeEventListener('focus', onFocus)
      inputEl.removeEventListener('click', onClick)
      inputEl.removeEventListener('input', onInput)
      inputEl.removeEventListener('keydown', onKeydown)
      inputEl.removeEventListener('blur', onBlur)
      host.shadowRoot?.removeEventListener('mousedown', onShadowMousedown as EventListener)
    }
  },
})

</controller>
<div class="wrap" sx="display:inline-flex w:full min-h:size-h px:size-px bg:surface-1 border:tone-border radius:md shadow:xs">
  <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" sx="w:icon-size-sm h:icon-size-sm fg:muted-foreground">
    <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
  </svg>
  <input class="entry input" type="text" name={name()} placeholder={placeholder()} disabled={disabled()} autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded={open() && filtered().length> 0 ? 'true' : 'false'}
    aria-controls={listId()}
    aria-activedescendant={activeId()}
    bind:value={value}
    bind:this={inputEl}
    sx="text:size-fs fg:foreground bg:surface-1 border:none shadow:none p:0"
  />
</div>
{#if open() && filtered().length > 0 && !disabled()}
  <ul class="listbox" role="listbox" id={listId()} bind:this={listEl} sx="position:absolute m:0 p:1 max-h:panel-max-h-sm overflow-y:auto bg:popover fg:popover-foreground border:border radius:md shadow:md z:popover">
    {#for s of filtered() key={s.id}}
      <li
        class="opt"
        class:hl={s.idx === highlight()}
        role="option"
        id={s.id}
        data-value={s.value}
        aria-selected={s.idx === highlight() ? 'true' : 'false'}
        sx="p:2 radius:sm text:size-fs fg:foreground"
      ><span class="opt-label">{s.label}</span><svg class="opt-check" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" focusable="false" sx="w:icon-size-sm h:icon-size-sm fg:tone-ring"><path d="M20 6L9 17l-5-5"/></svg></li>
    {/for}
  </ul>
{/if}
<span hidden><slot bind:this={suggestionsSlot}></slot></span>
