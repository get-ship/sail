<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="suggestions" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="tone" channels="tone-border, tone-ring">
  default:     border,           primary
  primary:     primary,          primary
  info:        info,             info
  success:     success,          success
  warning:     warning,          warning
  destructive: destructive,      destructive
  accent:      accent,           accent
  muted:       muted-foreground, muted-foreground
</theme>

<theme prop="size" channels="h, fs, px">
  sm: control-h-sm, text-sm,  space-2
  md: control-h-md, text-base, space-2_5
  lg: control-h-lg, text-md,  space-3
</theme>

<style>
  /* Local markers so the css-token lint recognizes the theme channels
   * and tokens referenced from this residual block. */
  --tone-border: ; --tone-ring: ; --h: ; --fs: ; --px: ; --focus-ring: ; --focus-ring-offset: ; --ring-width: ; --font-body: ; --border: ; --surface-1: ; --popover: ; --popover-foreground: ; --muted-foreground: ; --muted: ; --foreground: ; --selected-bg: ; --radius-md: ; --radius-sm: ; --shadow-xs: ; --shadow-md: ; --icon-size-sm: ; --space-1: ; --space-2: ; --space-2_5: ; --space-3: ; --panel-max-h-sm: ; --z-popover: ; --duration-fast: ; --ease-out: ;
  /* Residual: `:host` (host element, no sx), the .wrap's
   * multi-property transition + focus-within ring (a single box-shadow
   * on focus-within — the no-tone default case uses --tone-ring
   * resolved to var(--primary)), the disabled state (cursor +
   * opacity:0.65 is a raw value, not a token), the input's
   * font-family + placeholder color (no sx prop for font-family),
   * the focus-visible outline (the canonical --focus-ring token),
   * the absolute-positioned .listbox popover, the .opt/.opt-label
   * option layout, the highlight selected background, the
   * per-option check icon opacity (raw 0/1 — no sx prop for opacity
   * in this exact form), and the search-icon color. */
  :host { position: relative; display: inline-flex; flex-direction: column; width: 100%; vertical-align: middle; }
  :host([hidden]) { display: none; }

  .wrap {
    display: inline-flex; align-items: center;
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 var(--ring-width) var(--tone-ring);
  }
  :host([disabled]) .wrap {
    background: var(--muted);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .search-icon {
    flex: none;
    width: var(--icon-size-sm); height: var(--icon-size-sm);
    color: var(--muted-foreground);
  }

  input.entry {
    flex: 1; min-width: 0;
    border: 0; outline: 0; background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }
  input.entry:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .listbox {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0; right: 0;
    max-height: var(--panel-max-h-sm);
    overflow-y: auto;
    margin: 0; padding: var(--space-1);
    list-style: none;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: var(--z-popover);
  }
  .opt {
    display: flex; align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
    cursor: pointer;
    user-select: none;
  }
  .opt .opt-label {
    flex: 1; min-width: 0;
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  }
  .opt .opt-check {
    flex: none;
    width: var(--icon-size-sm); height: var(--icon-size-sm);
    color: var(--tone-ring);
    opacity: 0;
  }
  .opt.hl { background: var(--selected-bg); }
  .opt.hl .opt-check { opacity: 1; }
</style>

<!-- De-translated: min-h:h / px:px removed — the residual .wrap rule already
     declares min-height/padding via var(--h)/var(--px); ad-hoc channels are
     not sx vocabulary. -->
<row class="wrap" part="wrap" gap="2" align="center"
  sx="
    w:full
    py:0
    bg:surface-1
    border:tone-border
    radius:md
    shadow:xs
  "
>
  <svg class="search-icon" part="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
  </svg>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded={open() && filtered().length > 0 ? 'true' : 'false'}
    aria-controls={listId()}
    aria-activedescendant={activeId()}
    bind:value={value}
    bind:this={inputEl}
  />
</row>
{#if open() && filtered().length > 0 && !disabled()}
  <ul class="listbox" part="listbox" role="listbox" id={listId()}
      bind:this={listEl}>
    {#for s of filtered() key={s.id}}
      <li
        class="opt"
        class:hl={s.idx === highlight()}
        role="option"
        id={s.id}
        data-value={s.value}
        aria-selected={s.idx === highlight() ? 'true' : 'false'}
      ><span class="opt-label">{s.label}</span><svg class="opt-check" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" focusable="false"><path d="M20 6L9 17l-5-5"/></svg></li>
    {/for}
  </ul>
{/if}
<span hidden><slot bind:this={suggestionsSlot}></slot></span>
