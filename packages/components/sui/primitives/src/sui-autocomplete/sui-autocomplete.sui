<!--
  <sui-autocomplete> — text input with a suggestion dropdown.
  Differs from <sui-combobox> in one fundamental way: the value is
  free-form text. Suggestions are hints — accepting one fills the
  input, but the user can also type and submit anything else.

  Suggestions come from light-DOM <option value="x">Label</option>
  children OR a `suggestions="…JSON…"` attribute (array of strings or
  `{ value, label }` records — parsed in the controller).

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Typing opens the dropdown and filters case-insensitively against
    the value field.
  - ↑ / ↓ move highlight. Enter accepts the highlighted suggestion (if
    any), otherwise commits the typed text as-is.
  - Escape closes without commit (value stays at last-emitted text).
  - Click on a suggestion accepts it.
  ─────────────────────────────────────────────────────────────────────
  ARIA: input role=combobox, aria-autocomplete=list, aria-expanded,
        aria-controls, aria-activedescendant.
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="suggestions" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    width: 100%;
    vertical-align: middle;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: 34px;
    --fs: 13px;
    --px: 10px;
  }
  :host([tone='primary'])     { --tone-border: var(--primary);          --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);              --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);           --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);           --tone-ring: var(--warning); }
  :host([tone='destructive']) { --tone-border: var(--destructive);       --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);            --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground);  --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: 28px; --fs: 12px; --px: 8px; }
  :host([size='md']) { --h: 34px; --fs: 13px; --px: 10px; }
  :host([size='lg']) { --h: 40px; --fs: 14px; --px: 12px; }

  .wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    background: var(--surface-1);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 3px var(--tone-ring);
  }
  :host([disabled]) .wrap {
    background: var(--muted);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .search-icon {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--muted-foreground);
  }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }
  /* Per repo convention (sui-input/sui-combobox): the wrap carries a
     :focus-within tint; the input itself consumes the canonical
     --focus-ring token on :focus-visible. */
  input.entry:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .listbox {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 240px;
    overflow-y: auto;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: var(--z-popover);
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
    cursor: pointer;
    user-select: none;
  }
  .opt .opt-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .opt .opt-check {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--tone-ring);
    opacity: 0;
  }
  .opt.hl {
    background: var(--selected-bg);
  }
  .opt.hl .opt-check { opacity: 1; }
</style>

<div class="wrap" part="wrap">
  <svg class="search-icon" part="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
  </svg>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded={open() && filtered().length > 0 ? 'true' : 'false'}
    aria-controls={listId()}
    aria-activedescendant={activeId()}
    bind:value={value}
    bind:this={inputEl}
  />
</div>
{#if open() && filtered().length > 0 && !disabled()}
  <ul class="listbox" part="listbox" role="listbox" id={listId()}
      bind:this={listEl}>
    {#for s of filtered() key={s.id}}
      <li
        class="opt"
        class:hl={s.idx === highlight()}
        role="option"
        id={s.id}
        data-value={s.value}
        aria-selected={s.idx === highlight() ? 'true' : 'false'}
      ><span class="opt-label">{s.label}</span><svg class="opt-check" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" focusable="false"><path d="M20 6L9 17l-5-5"/></svg></li>
    {/for}
  </ul>
{/if}
<span hidden><slot bind:this={suggestionsSlot}></slot></span>
