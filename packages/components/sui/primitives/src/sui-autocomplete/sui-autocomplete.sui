<!--
  <sui-autocomplete> — text input with a suggestion dropdown.
  Differs from <sui-combobox> in one fundamental way: the value is
  free-form text. Suggestions are hints — accepting one fills the
  input, but the user can also type and submit anything else.

  Suggestions come from light-DOM <option value="x">Label</option>
  children OR a `suggestions="…JSON…"` attribute (array of strings or
  `{ value, label }` records — parsed in the controller).

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Typing opens the dropdown and filters case-insensitively against
    the value field.
  - ↑ / ↓ move highlight. Enter accepts the highlighted suggestion (if
    any), otherwise commits the typed text as-is.
  - Escape closes without commit (value stays at last-emitted text).
  - Click on a suggestion accepts it.
  ─────────────────────────────────────────────────────────────────────
  ARIA: input role=combobox, aria-autocomplete=list, aria-expanded,
        aria-controls, aria-activedescendant.
  ─────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone/size are GLOBAL framework channels now (contracts.css). feat/next
    hand-rolled `:host([tone='x']) { --tone-border: …; --tone-ring: … }`
    and `:host([size='x']) { --h: …; --fs: …; --px: … }` directly in its
    own residual style block (no theme directive even there — an older
    pattern still, same as sui-combobox). Both are DELETED; this skin
    reads var(--tone-border)/var(--tone-ring) and var(--size-h)/
    var(--size-px)/var(--size-fs) straight off the framework sheets.
    autocomplete's 8 tone values are exactly the framework's 8 tones.
  - The focus-within ring keeps feat/next's single box-shadow-glow shape
    (not the framework's two-layer `ring:` sx composition — that reads as
    a different, offset-gap shape). The raw `3px` becomes
    `var(--ring-width)`, the framework's own token for this thickness —
    same substitution as sui-combobox (this component has no `[data-open]`
    ring; feat/next only glows on :focus-within here).
  - Disabled: feat/next's `opacity: 0.65` isn't reachable — sx's opacity
    scale is quartile-stepped (0/25/50/75/100), no arbitrary percentage —
    collapsed to `opacity:50`, the same "dimmed, inert" step sui-combobox
    uses (and what the framework's own control-contracts use for disabled
    native controls), rather than a hand-tuned in-between value.
  - The wrap's background is `surface-1` here (feat/next's own choice,
    distinct from combobox's `background` — preserved, not homogenized).
    The input, once nested in a shadow root, now inherits the framework's
    global field skin (border/padding/shadow/min-height); its own sx
    explicitly matches the wrap's `surface-1` (not the global default
    `background`) so no seam shows between input and wrap, and cancels
    border/shadow/padding so it doesn't draw a second box.

  LANG-GAP — plain `flex`, and the opt-check glyph opacity toggle
  ─────────────────────────────────────────────────────────────────────
  sx's `display` enum offers `inline-flex` but no plain `flex` — the
  option rows need a BLOCK-level flex row (inline-flex would shrink each
  row to its content width, breaking the full-width hit area) — stays
  hand-authored in the residual style, same gap as sui-combobox. The
  per-option check-glyph's hover/highlight opacity toggle (0 → 1) is a
  dynamic class (`class:hl`) driving a descendant selector
  (`.opt.hl .opt-check`) — no variants selector reaches a dynamically
  toggled class on a *different* element than the one the class lives
  on, so it stays a plain, token-free (0/1 are unitless, not tokenizable)
  residual rule, same shape as feat/next.
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="suggestions" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<host sx="position:relative display:inline-flex w:full"></host>

<variants part="wrap">
  [disabled]: bg:muted cursor:not-allowed opacity:50
</variants>

<style>
  :host {
    flex-direction: column;
    vertical-align: middle;
  }
  .wrap,
  .opt,
  .opt-label {
    font-family: var(--font-body);
  }
  .wrap {
    align-items: center;
    gap: var(--space-2);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 var(--ring-width) var(--tone-ring);
  }
  .entry {
    flex: 1;
    min-width: 0;
    outline: 0;
  }
  .listbox {
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    list-style: none;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    user-select: none;
  }
  .opt-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .opt-check { opacity: 0; }
  .opt.hl { background: var(--selected-bg); }
  .opt.hl .opt-check { opacity: 1; }
</style>

<div class="wrap" part="wrap"
  sx="display:inline-flex w:full min-h:size-h px:size-px bg:surface-1 border:tone-border radius:md shadow:xs">
  <svg class="search-icon" part="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
    sx="w:icon-size-sm h:icon-size-sm fg:muted-foreground">
    <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
  </svg>
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded={open() && filtered().length > 0 ? 'true' : 'false'}
    aria-controls={listId()}
    aria-activedescendant={activeId()}
    bind:value={value}
    bind:this={inputEl}
    sx="text:size-fs fg:foreground bg:surface-1 border:none shadow:none p:0"
  />
</div>
{#if open() && filtered().length > 0 && !disabled()}
  <ul class="listbox" part="listbox" role="listbox" id={listId()}
      bind:this={listEl}
      sx="position:absolute m:0 p:1 max-h:panel-max-h-sm overflow-y:auto bg:popover fg:popover-foreground border:border radius:md shadow:md z:popover">
    {#for s of filtered() key={s.id}}
      <li
        class="opt"
        class:hl={s.idx === highlight()}
        role="option"
        id={s.id}
        data-value={s.value}
        aria-selected={s.idx === highlight() ? 'true' : 'false'}
        sx="p:2 radius:sm text:size-fs fg:foreground"
      ><span class="opt-label">{s.label}</span><svg class="opt-check" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" focusable="false" sx="w:icon-size-sm h:icon-size-sm fg:tone-ring"><path d="M20 6L9 17l-5-5"/></svg></li>
    {/for}
  </ul>
{/if}
<span hidden><slot bind:this={suggestionsSlot}></slot></span>
