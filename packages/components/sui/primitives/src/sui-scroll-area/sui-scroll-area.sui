<!--
  <sui-scroll-area> — SUI port of <ship-scroll-area>.
  Scrollable viewport with overlay scrollbars that fade in on hover/scroll.

  Prop / slot / part parity vs <ship-scroll-area>
  ────────────────────────────────────────────────────────────────────────
  Lit                     SUI                     Notes
  ────────────────────────────────────────────────────────────────────────
  orientation (vert|      orientation (union,      ✓ vertical default
    horiz|both, 'vert')     'vertical', reflect)
  size (sm|md|lg, 'md')   size (union, 'md',       ✓ --sb-size channel
                            reflect)
  ────────────────────────────────────────────────────────────────────────
  slots: (default)         (default)               ✓ content projection
  ────────────────────────────────────────────────────────────────────────
  parts: viewport          viewport                ✓
         scrollbar-v        scrollbar-v             ✓
         scrollbar-h        scrollbar-h             ✓
  ────────────────────────────────────────────────────────────────────────
  NEW SURFACE: component + variants blocks for orientation/size;
    per-size --sb-size fill in <style> (gate forbids the legacy
    theme block); per-orientation overflow + scrollbar visibility
    via part-targeted variants blocks.
    .sui-scroll-area:not([orientation]) rule for the default vertical case
    (variants only match EXPLICIT attrs) and to hide the horizontal
    scrollbar in default mode. Restored the .scrollbar-h block
    the pre-port spike lost (visual regression).
-->

<component>{
  props: {
    orientation: 'vertical' | 'horizontal' | 'both',
    size: 'md' | 'sm' | 'lg',
  },
}</component>

<variants class="viewport">
  (orientation=vertical): overflow-y:auto
  (orientation=horizontal): overflow-x:auto
  (orientation=both): overflow:auto
</variants>
<variants class="scrollbar-v">
  (orientation=horizontal): display:none
</variants>
<variants class="scrollbar-h">
  (orientation=vertical): display:none
</variants>

<style>
  .sui-scroll-area {
    display: block;
    position: relative;
    overflow: hidden;
  }

  /* Per-size scrollbar width. The pre-port spike used a <theme prop="size">
     block to fill --sb-size — gate-forbidden, so explicit per-attribute
     rules now. Token values match the catalog scale (sm=space-1_5,
     md=space-2, lg=space-2_5); feat/next used raw 6/8/10px equivalents. */
  .sui-scroll-area:not([size]), .sui-scroll-area[size='md'] { --sb-size: var(--space-2); }
  .sui-scroll-area[size='sm'] { --sb-size: var(--space-1_5); }
  .sui-scroll-area[size='lg'] { --sb-size: var(--space-2_5); }

  .viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .viewport::-webkit-scrollbar { display: none; }

  /* The default (no [orientation] attr set) acts as vertical. Variants
     above cover the EXPLICIT cases; this rule covers the unset case
     the variants table can't reach. */
  .sui-scroll-area:not([orientation]) .viewport { overflow-y: auto; }
  .sui-scroll-area:not([orientation]) .scrollbar-h { display: none; }

  /* Overlay scrollbar tracks — absolute-positioned, opacity-fade on hover/scroll */
  .scrollbar {
    position: absolute;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
    z-index: var(--z-elevated);
  }
  .sui-scroll-area:hover .scrollbar,
  .sui-scroll-area:focus-within .scrollbar,
  .scrollbar.active { opacity: 1; }

  .scrollbar-v {
    top: 0; right: var(--space-half); bottom: 0;
    width: var(--sb-size);
  }
  .scrollbar-h {
    left: 0; right: 0; bottom: var(--space-half);
    height: var(--sb-size);
  }

  .thumb {
    position: absolute;
    border-radius: var(--radius-full);
    background: var(--scrollbar-thumb);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .thumb:hover {
    background: var(--scrollbar-thumb-hover);
  }
  .scrollbar-v .thumb {
    width: 100%;
    min-height: var(--icon-size-2xl);
  }
  .scrollbar-h .thumb {
    height: 100%;
    min-width: var(--icon-size-2xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .scrollbar { transition: none; }
    .thumb { transition: none; }
  }

  @media (forced-colors: active) {
    .thumb { background: CanvasText; }
  }
</style>


<controller>
import { controller } from '@ship/sui-runtime'
import type { Scope } from './sui-scroll-area.sui'

export default controller<Scope>({
  mount(state, host) {
    let scrollTimer: ReturnType<typeof setTimeout> | null = null

    const updateThumbs = () => {
      const vp = state.$signals.viewportEl() as HTMLElement | null
      if (!vp) return

      const orientation = state.$signals.orientation()
      const showV = orientation === 'vertical' || orientation === 'both'
      const showH = orientation === 'horizontal' || orientation === 'both'
      const vThumb = state.$signals.vThumb() as HTMLElement | null
      const hThumb = state.$signals.hThumb() as HTMLElement | null

      if (showV && vThumb) {
        const ratio = vp.clientHeight / vp.scrollHeight
        if (ratio < 1) {
          const thumbH = Math.max(24, ratio * vp.clientHeight)
          const scrollRatio = vp.scrollTop / (vp.scrollHeight - vp.clientHeight)
          const thumbTop = scrollRatio * (vp.clientHeight - thumbH)
          vThumb.style.height = `${thumbH}px`
          vThumb.style.top = `${thumbTop}px`
          vThumb.style.display = ''
        } else {
          vThumb.style.display = 'none'
        }
      }

      if (showH && hThumb) {
        const ratio = vp.clientWidth / vp.scrollWidth
        if (ratio < 1) {
          const thumbW = Math.max(24, ratio * vp.clientWidth)
          const scrollRatio = vp.scrollLeft / (vp.scrollWidth - vp.clientWidth)
          const thumbLeft = scrollRatio * (vp.clientWidth - thumbW)
          hThumb.style.width = `${thumbW}px`
          hThumb.style.left = `${thumbLeft}px`
          hThumb.style.display = ''
        } else {
          hThumb.style.display = 'none'
        }
      }
    }

    const onScroll = () => {
      updateThumbs()
      const vBar = state.$signals.vScrollbar() as HTMLElement | null
      const hBar = state.$signals.hScrollbar() as HTMLElement | null
      vBar?.classList.add('active')
      hBar?.classList.add('active')
      if (scrollTimer) clearTimeout(scrollTimer)
      scrollTimer = setTimeout(() => {
        vBar?.classList.remove('active')
        hBar?.classList.remove('active')
      }, 1200)
    }

    const vp = state.$signals.viewportEl() as HTMLElement | null
    if (vp) {
      vp.addEventListener('scroll', onScroll, { passive: true })
    }
    updateThumbs()

    return () => {
      if (scrollTimer) clearTimeout(scrollTimer)
      if (vp) vp.removeEventListener('scroll', onScroll)
    }
  },
})

</controller>
<div class="viewport" tabindex="0" bind:this={viewportEl}>
  <slot></slot>
</div>
<div class="scrollbar scrollbar-v" aria-hidden="true" bind:this={vScrollbar}>
  <div class="thumb" bind:this={vThumb}></div>
</div>
<div class="scrollbar scrollbar-h" aria-hidden="true" bind:this={hScrollbar}>
  <div class="thumb" bind:this={hThumb}></div>
</div>
