<!--
  <sui-scroll-area> — SUI port of <ship-scroll-area>.
  Scrollable viewport with overlay scrollbars that fade in on hover/scroll.

  Prop / slot / part parity vs <ship-scroll-area>
  ────────────────────────────────────────────────────────────────────────
  Lit                     SUI                     Notes
  ────────────────────────────────────────────────────────────────────────
  orientation (vert|      orientation (union,      ✓ vertical default
    horiz|both, 'vert')     'vertical', reflect)
  size (sm|md|lg, 'md')   size (union, 'md',       ✓ --sb-size channel
                            reflect)
  ────────────────────────────────────────────────────────────────────────
  slots: (default)         (default)               ✓ content projection
  ────────────────────────────────────────────────────────────────────────
  parts: viewport          viewport                ✓
         scrollbar-v        scrollbar-v             ✓
         scrollbar-h        scrollbar-h             ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="orientation" values="vertical|horizontal|both" default="vertical" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="size" channels="sb-size">
  default: space-2
  sm:      space-1_5
  md:      space-2
  lg:      space-2_5
</theme>
<variants part="viewport">
  (orientation=vertical): overflow-y:auto
  (orientation=horizontal): overflow-x:auto
  (orientation=both): overflow:auto
</variants>
<variants part="scrollbar-v">
  (orientation=horizontal): display:none
</variants>
<variants part="scrollbar-h">
  (orientation=vertical): display:none
</variants>

<style>
  :host {
    display: block;
    position: relative;
    overflow: hidden;
    /* sb- prefix local — the <theme prop="size"> block overrides per
     * size; declared here so the css_token lint resolves the
     * reference in .scrollbar-v (the lint does not see <theme>
     * blocks). */
    --sb-size: var(--space-2);
  }

  .viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .viewport::-webkit-scrollbar { display: none; }

  :host([orientation='both']) .viewport { overflow: auto; }

  /* Overlay scrollbar tracks — absolute-positioned, opacity-fade on hover/scroll */
  .scrollbar {
    position: absolute;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
    z-index: var(--z-elevated);
  }
  :host(:hover) .scrollbar,
  :host(:focus-within) .scrollbar,
  .scrollbar.active { opacity: 1; }

  .scrollbar-v {
    top: 0; right: var(--space-half); bottom: 0;
    width: var(--sb-size);
  }



  .thumb {
    position: absolute;
    border-radius: var(--radius-full);
    background: var(--scrollbar-thumb);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .thumb:hover {
    background: var(--scrollbar-thumb-hover);
  }
  .scrollbar-v .thumb {
    width: 100%;
    min-height: var(--icon-size-2xl);
  }
  .scrollbar-h .thumb {
    height: 100%;
    min-width: var(--icon-size-2xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .scrollbar { transition: none; }
    .thumb { transition: none; }
  }

  @media (forced-colors: active) {
    .thumb { background: CanvasText; }
  }
</style>

<div class="viewport" part="viewport" tabindex="0" bind:this={viewportEl}>
  <slot></slot>
</div>
<div class="scrollbar scrollbar-v" part="scrollbar-v" aria-hidden="true" bind:this={vScrollbar}>
  <div class="thumb" bind:this={vThumb}></div>
</div>
<div class="scrollbar scrollbar-h" part="scrollbar-h" aria-hidden="true" bind:this={hScrollbar}>
  <div class="thumb" bind:this={hThumb}></div>
</div>
