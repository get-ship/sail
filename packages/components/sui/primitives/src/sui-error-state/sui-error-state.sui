<!--
  <sui-error-state> — SUI port of <ship-error-state>.
  Sibling of <sui-empty-state> for "something broke" paths.
  Destructive tone halo, collapsible technical details, auto-focused retry.

  Prop parity vs <ship-error-state>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  title (string, '')           title (string, '')       ✓ fallback in template
  body (string, '')            body (string, '')        ✓
  size ('sm'|'md'|'lg', 'md') size (sm|md|lg, 'md',    ✓
                                 reflect)
  variant ('default'|'inline') variant (default|inline, ✓
                                 'default', reflect)
  icon (string, 'alert-circle') icon (string,           ✓ rendered via sui-icon
                                  'alert-circle')
  ─────────────────────────────────────────────────────────────────────────────
  Details toggle visibility    controller sets          ✓ data-has-details on
    driven by slot content       data-has-details         host; CSS targets it
  Details open/close           controller sets          ✓ data-details-open on
                                 data-details-open        host; CSS targets it
  ─────────────────────────────────────────────────────────────────────────────
  slots: title, (default),     title, (default),        ✓
         details, action         details, action
  ─────────────────────────────────────────────────────────────────────────────
  parts: box, icon, title,     box, icon, title,        ✓
         desc, actions           desc, actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" on box div      same                     ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="title" type="string" default="" />
<prop name="body" type="string" default="" />
<prop name="code" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="default|inline" default="default" reflect />
<prop name="icon" type="string" default="alert-circle" />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    --tone-fg: var(--destructive);
    --es-pad-y: var(--space-9);
    --es-pad-x: var(--space-4);
    --es-gap: var(--space-3);
    --es-icon: var(--icon-size-md);
    --es-tile: var(--text-4xl); /* closest to 48px */
    --es-title-fs: var(--text-md);
    --es-desc-fs: var(--text-sm);
  }
  :host([hidden]) { display: none; }

  :host([size='sm']) {
    --es-pad-y: var(--space-7);
    --es-pad-x: var(--space-4);
    --es-gap: var(--space-2);
    --es-icon: var(--icon-size-sm); --es-tile: var(--control-h-md);
    --es-title-fs: var(--text-base);
  }
  :host([size='lg']) {
    --es-pad-y: var(--text-4xl); /* 96 falls between text-4xl 36 and nothing — closest available */
    --es-pad-x: var(--space-6);
    --es-gap: var(--space-4);
    --es-icon: var(--icon-size-3xl); --es-tile: var(--control-h-lg);
    --es-title-fs: var(--text-lg);
    --es-desc-fs: var(--text-base);
  }

  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--es-gap);
    padding: var(--es-pad-y) var(--es-pad-x);
    text-align: center;
    background: var(--tone-muted-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  :host([variant='inline']) .box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: start;
    background: var(--tone-destructive-bg);
    border: 1px solid var(--tone-destructive-border);
    border-radius: var(--radius-md);
    box-shadow: none;
    padding: var(--space-3) var(--space-4);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--es-tile);
    height: var(--es-tile);
    border-radius: var(--radius-lg);
    background: var(--tone-destructive-bg);
    color: var(--destructive);
    line-height: var(--leading-none);
    box-shadow: inset 0 0 0 1px var(--tone-destructive-ring);
  }
  :host([variant='inline']) .icon {
    width: var(--es-icon);
    height: var(--es-icon);
    background: transparent;
    box-shadow: none;
  }

  .copy {
    min-width: 0;
  }

  .title {
    font-family: var(--heading-font);
    font-size: var(--es-title-fs);
    font-weight: var(--heading-weight);
    color: var(--foreground);
    line-height: var(--leading-tight);
  }

  .desc {
    font-size: var(--es-desc-fs);
    max-width: var(--panel-ch-w-md);
    line-height: var(--leading-normal-plus);
    color: var(--muted-foreground);
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: var(--muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    margin-top: var(--space-1);
  }
  .code:empty { display: none; }

  /* details-toggle: hidden until controller detects slot content */
  .details-toggle {
    display: none;
    appearance: none;
    background: transparent;
    border: 0;
    font: inherit;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-top: var(--space-1);
  }
  :host([data-has-details]) .details-toggle { display: inline-block; }
  .details-toggle:hover { color: var(--foreground); background: var(--muted); }

  /* details panel: always in DOM for slotchange detection, shown when open */
  .details {
    display: none;
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--tone-destructive-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    white-space: pre-wrap;
    word-break: break-word;
    max-width: 60ch;
    text-align: start;
  }
  :host([data-has-details][data-details-open]) .details { display: block; }

  .actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }
  :host([variant='inline']) .actions {
    margin-top: 0;
    margin-inline-start: auto;
    justify-content: flex-end;
  }

  @media (forced-colors: active) {
    .box { border-color: CanvasText; }
    .icon { background: Canvas; color: CanvasText; }
  }
</style>

<div class="box" part="box" role="alert">
  <div class="icon" part="icon" aria-hidden="true">
    <sui-icon name={icon()} size="md"></sui-icon>
  </div>

  <column class="copy" gap="1" align={variant() === 'inline' ? 'start' : 'center'}>
    <div class="title" part="title">
      <slot name="title">{title() || 'Something went wrong'}</slot>
    </div>
    <div class="desc" part="desc">
      <slot>{body()}</slot>
    </div>
    <div class="code" part="code">{code()}</div>
    <button class="details-toggle" part="details-toggle" bind:this={detailsToggleBtn} type="button"></button>
    <div class="details" bind:this={detailsPanel}>
      <slot name="details" bind:this={detailsSlot}></slot>
    </div>
  </column>

  <div class="actions" part="actions">
    <slot name="action" bind:this={actionSlot}></slot>
  </div>
</div>
