<!--
  <sui-error-state> — SUI port of <ship-error-state>.
  Sibling of <sui-empty-state> for "something broke" paths.
  Destructive tone halo, collapsible technical details, auto-focused retry.

  Prop parity vs <ship-error-state>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  title (string, '')           title (string, '')       ✓ fallback in template
  body (string, '')            body (string, '')        ✓
  size ('sm'|'md'|'lg', 'md') size (sm|md|lg, 'md',    ✓
                                 reflect)
  variant ('default'|'inline') variant (default|inline, ✓
                                 'default', reflect)
  icon (string, 'alert-circle') icon (string,           ✓ rendered via sui-icon
                                  'alert-circle')
  ─────────────────────────────────────────────────────────────────────────────
  Details toggle visibility    controller sets          ✓ data-has-details on
    driven by slot content       data-has-details         host; CSS targets it
  Details open/close           controller sets          ✓ data-details-open on
                                 data-details-open        host; CSS targets it
  ─────────────────────────────────────────────────────────────────────────────
  slots: title, (default),     title, (default),        ✓
         details, action         details, action
  ─────────────────────────────────────────────────────────────────────────────
  parts: box, icon, title,     box, icon, title,        ✓
         desc, actions           desc, actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" on box div      same                     ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="title" type="string" default="" />
<prop name="body" type="string" default="" />
<prop name="code" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="default|inline" default="default" reflect />
<prop name="icon" type="string" default="alert-circle" />

<theme prop="tone" channels="tone-fg, tone-bg, tone-border, tone-ring">
  default: destructive, tone-destructive-bg, tone-destructive-border, tone-destructive-ring
</theme>

<variants part="box">
  [variant='inline']: radius:md shadow:none p:3 px:4
  size=sm: py:7 px:4
  size=lg: py:9 px:6
</variants>

<variants part="icon">
  [variant='inline']: w:icon-size-sm h:icon-size-sm
  size=sm: w:control-h-md h:control-h-md
  size=md: w:icon-size-md h:icon-size-md
  size=lg: w:control-h-lg h:control-h-lg
</variants>

<variants part="title">
  size=sm: text:base
  size=md: text:md
  size=lg: text:lg
</variants>

<variants part="desc">
  size=lg: text:base
</variants>

<variants part="actions">
  [variant='inline']: mt:0
</variants>

<variants part="details-toggle">
  [data-has-details]: display:inline-block
</variants>

<variants part="details">
  [data-has-details][data-details-open]: display:block
</variants>

<!--
  Residual <style> — truly unavoidable bits:
  - :host font-family + tone channel CSS var (--tone-fg)
  - :host(:not([size])) md default CSS vars (--es-pad-y, --es-icon, etc.) consumed by .box/.icon
  - :host([size='sm'|'lg']) --es-* vars (since variants body is sx-style, can't set --vars)
  - .box flex-direction: column (default) + :host([variant='inline']) .box flex-direction: row
  - .icon line-height: var(--leading-none) (not in sx)
  - .icon box-shadow: inset ring (raw)
  - :host([variant='inline']) .icon background:transparent + box-shadow:none
  - .code font-family: var(--font-mono) (not sx-able)
  - .code :empty display:none (pseudo-class)
  - .details font-family: var(--font-mono) (not sx-able)
  - .details white-space: pre-wrap + word-break: break-word + max-width: 60ch (not sx-able)
  - forced-colors media (CanvasText system color)
-->
<style>
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--es-gap, var(--space-3));
    text-align: center;
    background: var(--tone-muted-bg);
    border: 1px solid var(--border);
  }
  :host([size='sm']) {
    --es-pad-y: var(--space-7);
    --es-pad-x: var(--space-4);
    --es-gap: var(--space-2);
    --es-title-fs: var(--text-base);
  }
  :host([size='lg']) {
    --es-pad-y: var(--text-4xl);
    --es-pad-x: var(--space-6);
    --es-gap: var(--space-4);
    --es-title-fs: var(--text-lg);
    --es-desc-fs: var(--text-base);
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: var(--leading-none);
    box-shadow: inset 0 0 0 1px var(--tone-destructive-ring);
  }
  :host([variant='inline']) .box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background: var(--tone-destructive-bg);
    border: 1px solid var(--tone-destructive-border);
  }
  :host([variant='inline']) .icon {
    background: transparent;
    box-shadow: none;
  }
  .copy {
    min-width: 0;
  }
  .title {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    line-height: var(--leading-tight);
  }
  .desc {
    max-width: var(--panel-ch-w-md);
    line-height: var(--leading-normal-plus);
  }
  .code {
    font-family: var(--font-mono);
    background: var(--muted);
    border: 1px solid var(--border-subtle);
    margin-top: var(--space-1);
  }
  .code:empty { display: none; }
  .details-toggle {
    background: transparent;
    border: 0;
    font: inherit;
    cursor: pointer;
    margin-top: var(--space-1);
  }
  .details-toggle:hover { color: var(--foreground); background: var(--muted); }
  .details {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    white-space: pre-wrap;
    word-break: break-word;
    max-width: 60ch;
    text-align: start;
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }
  :host([variant='inline']) .actions {
    margin-top: 0;
    margin-inline-start: auto;
    justify-content: flex-end;
  }
  @media (forced-colors: active) {
    .box { border-color: CanvasText; }
    .icon { background: Canvas; color: CanvasText; }
  }
</style>

<div class="box" part="box" role="alert"
  sx="py:9 px:4 radius:lg shadow:xs bg:tone-muted-bg border:border">
  <div class="icon" part="icon" aria-hidden="true"
    sx="w:icon-size-md h:icon-size-md radius:lg bg:tone-destructive-bg fg:destructive">
    <sui-icon name={icon()} size="md"></sui-icon>
  </div>

  <column class="copy" gap="1" align={variant() === 'inline' ? 'start' : 'center'}
    sx="min-w:0">
    <div class="title" part="title"
      sx="text:md weight:semibold fg:foreground">
      <slot name="title">{title() || 'Something went wrong'}</slot>
    </div>
    <div class="desc" part="desc"
      sx="text:sm max-w:panel-ch-w-md fg:muted-foreground">
      <slot>{body()}</slot>
    </div>
    <div class="code" part="code"
      sx="text:xs fg:muted-foreground p:1 px:2 radius:sm">
      {code()}
    </div>
    <button class="details-toggle" part="details-toggle" bind:this={detailsToggleBtn} type="button"
      sx="text:xs fg:muted-foreground p:1 px:2 radius:sm">
    </button>
    <div class="details" part="details" bind:this={detailsPanel}
      sx="p:2 px:3 radius:sm bg:tone-destructive-bg text:xs fg:muted-foreground">
      <slot name="details" bind:this={detailsSlot}></slot>
    </div>
  </column>

  <div class="actions" part="actions" sx="mt:1">
    <slot name="action" bind:this={actionSlot}></slot>
  </div>
</div>
