<!--
  <sui-file-upload> — SUI port of <ship-file-upload>.
  Drag-and-drop file upload zone with removable file list.

  Prop / event / parts parity vs <ship-file-upload>
  ────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ────────────────────────────────────────────────────────────────────────
  accept (String, '')              accept (string, '')       ✓
  multiple (Boolean, false)        multiple (bool, false)    ✓
  maxSize (Number, 10485760,       max-size (number,         ✓
    attribute 'max-size')            10485760)
  disabled (Boolean, false,        disabled (bool, false,    ✓
    reflect)                         reflect)
  tone (Tone, undefined,           tone (union, 'default',   ✓ tints drop ring
    reflect)                         reflect)
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change              sui-change                ✓ renamed
    { detail: { files: File[] } }    { detail: { files } }     payload preserved
  ────────────────────────────────────────────────────────────────────────
  Parts: (none in Lit)             dropzone, input, error,   new — surface
                                     file-list, file-item,     internal nodes for
                                     remove                    consumer styling
  ────────────────────────────────────────────────────────────────────────
  formAssociated / internals     N/A — Lit version does not surface internals.
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="accept" type="string" default="" />
<prop name="multiple" type="bool" default="false" />
<prop name="max-size" type="number" default="10485760" />
<prop name="disabled" type="bool" default="false" reflect />
<!--
  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone is a GLOBAL framework channel now (contracts.css / suiTonesSheet).
    No <theme> block, no per-component :host([tone='…']) redeclaration.
    The tone prop still reflects on the host (so the catalog contract
    is intact) and the dropzone's `over` variant reads var(--tone-ring)
    / var(--tone-bg) directly — the framework fills them from whichever
    tone the host's [tone] attribute names.
  - The .remove dismiss button is a framework `<button ghost sm>` — no
    hand-styled color/hover/focus/padding/background. The framework's
    L1 control skin (adoptSuiSheets now carries the button contracts)
    supplies them. The .remove class is kept for the test selector
    (anatomy is class-based, see <parity-gate>).
  - sx is closed-vocab (tokens + tone-* channels only). The dropzone
    geometry, padding, border, color, file-item row layout, file-doc
    icon, file-name/file-size, and error all live in sx; <style> keeps
    only what sx/variants cannot express (dashed border + multi-prop
    transition + saturate filter / pointer-events for the compound
    :host([disabled]) + the host font defaults + the file-list top
    margin that lives on a class and is target-able through a single
    class rule + the dropzone focus ring that pairs an outline with
    the variant tint).
  - <row>/<column> primitives replace the hand-rolled flex/grid in
    feat/next's <sui-stack> containers.
  - L1 <input type="file"> is hidden via the existing input[type='file']
    rule (no L1 file-input control in the framework).
-->
<variants>
  [hidden]:  display:none
  [disabled]: opacity:75 cursor:not-allowed
</variants>
<variants part="dropzone">
  over: border:tone-ring bg:tone-bg
</variants>

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  :host([disabled]) {
    color: var(--muted-foreground);
    filter: saturate(0.6);
    pointer-events: none;
  }
  [part~='dropzone'] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border: var(--space-1_25) dashed var(--border);
    border-radius: var(--radius-lg);
    background: transparent;
    cursor: pointer;
    color: var(--muted-foreground);
    user-select: none;
    text-align: center;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  [part~='dropzone']:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  [part~='dropzone']:not(.over) { border-style: dashed; }
  [part~='dropzone'].over {
    border-style: dashed;
    border-color: var(--tone-ring);
    background: var(--tone-bg);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-lg);
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: 1;
    flex: none;
    transition: background-color var(--duration-fast), color var(--duration-fast);
  }
  [part~='dropzone'].over .icon {
    background: var(--selected-bg);
    color: var(--tone-ring);
  }
  input[type='file'] { display: none; }
  .file-list { margin-top: var(--space-2); }
  .file-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    color: var(--foreground);
  }
  .file-doc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-md);
    height: var(--control-h-md);
    border-radius: var(--radius-md);
    background: var(--tone-info-bg);
    color: var(--tone-info-fg);
    flex: none;
  }
  .file-meta { flex: 1; min-width: 0; }
  .file-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--foreground);
  }
  .file-size {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .error {
    color: var(--destructive);
    margin-top: var(--space-1);
    padding: 0 var(--space-1);
  }
  @media (prefers-reduced-motion: reduce) {
    [part~='dropzone'] { transition: none; }
  }
</style>

<div
  class="dropzone"
  class:over={over()}
  part="dropzone"
  role="button"
  tabindex={disabled() ? '-1' : '0'}
  aria-label={accept() ? 'Upload files (' + accept() + ')' : 'Upload files'}
  aria-disabled={disabled() ? 'true' : 'false'}
  bind:this={dropzoneEl}
>
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
  </span>
  <span>Drag &amp; drop or <span style="color:var(--primary);text-decoration:underline;text-underline-offset:2px">browse</span></span>
</div>
<input
  type="file"
  part="input"
  accept={accept()}
  multiple={multiple()}
  aria-hidden="true"
  tabindex="-1"
  bind:this={inputEl}
/>
{#if errorMsg()}
  <div class="error" role="alert" part="error" sx="text:sm fg:destructive">{errorMsg()}</div>
{/if}
{#if displayFiles().length > 0}
  <column class="file-list" part="file-list" gap="1" aria-live="polite" bind:this={fileListEl}>
    {#for f of displayFiles() key={f.key}}
      <div class="file-item" part="file-item">
        <span class="file-doc-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:17px;height:17px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2 2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <column class="file-meta" part="file-meta" gap="1">
          <span class="file-name">{f.name}</span>
          <span class="file-size">{f.sizeStr}</span>
        </column>
        <button
          ghost
          sm
          class="remove"
          part="remove"
          type="button"
          data-idx={f.idx}
          aria-label={'Remove ' + f.name}
        >×</button>
      </div>
    {/for}
  </column>
{/if}
