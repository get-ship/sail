<!--
  <sui-file-upload> — SUI port of <ship-file-upload>.
  Drag-and-drop file upload zone with removable file list.

  Prop / event / parts parity vs <ship-file-upload>
  ────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ────────────────────────────────────────────────────────────────────────
  accept (String, '')              accept (string, '')       ✓
  multiple (Boolean, false)        multiple (bool, false)    ✓
  maxSize (Number, 10485760,       max-size (number,         ✓
    attribute 'max-size')            10485760)
  disabled (Boolean, false,        disabled (bool, false,    ✓
    reflect)                         reflect)
  tone (Tone, undefined,           tone (union, 'default',   ✓ tints drop ring
    reflect)                         reflect)
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change              sui-change                ✓ renamed
    { detail: { files: File[] } }    { detail: { files } }     payload preserved
  ────────────────────────────────────────────────────────────────────────
  Parts: (none in Lit)             dropzone, input, error,   new — surface
                                     file-list, file-item,     internal nodes for
                                     remove                    consumer styling
  ────────────────────────────────────────────────────────────────────────
  formAssociated / internals     N/A — Lit version does not surface internals.
  ────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    accept: '',
    multiple: false,
    'max-size': 10485760,
    disabled: false,
  },
}</component>
<!--
  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone is a GLOBAL framework channel now (contracts.css / suiTonesSheet).
    No <theme> block, no per-component .sui-file-upload[tone='…'] redeclaration.
    The tone prop still reflects on the host (so the catalog contract
    is intact) and the dropzone's `over` variant reads var(--tone-ring)
    / var(--tone-bg) directly — the framework fills them from whichever
    tone the host's [tone] attribute names.
  - The .remove dismiss button is a framework `<button ghost sm>` — no
    hand-styled color/hover/focus/padding/background. The framework's
    L1 control skin (adoptSuiSheets now carries the button contracts)
    supplies them. The .remove class is kept for the test selector
    (anatomy is class-based, see <parity-gate>).
  - sx is closed-vocab (tokens + tone-* channels only). The dropzone
    geometry, padding, border, color, file-item row layout, file-doc
    icon, file-name/file-size, and error all live in sx; <style> keeps
    only what sx/variants cannot express (dashed border + multi-prop
    transition + saturate filter / pointer-events for the compound
    .sui-file-upload[disabled] + the host font defaults + the file-list top
    margin that lives on a class and is target-able through a single
    class rule + the dropzone focus ring that pairs an outline with
    the variant tint).
  - <row>/<column> primitives replace the hand-rolled flex/grid in
    feat/next's <sui-stack> containers.
  - L1 <input type="file"> is hidden via the existing input[type='file']
    rule (no L1 file-input control in the framework).
-->
<variants>
  [hidden]:  display:none
  [disabled]: opacity:75 cursor:not-allowed
</variants>
<variants class="dropzone">
  over: border:tone-ring bg:tone-bg
</variants>

<style>
  .sui-file-upload {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  .sui-file-upload[disabled] {
    color: var(--muted-foreground);
    filter: saturate(0.6);
    pointer-events: none;
  }
  [part~='dropzone'] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border: var(--space-1_25) dashed var(--border);
    border-radius: var(--radius-lg);
    background: transparent;
    cursor: pointer;
    color: var(--muted-foreground);
    user-select: none;
    text-align: center;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  [part~='dropzone']:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  [part~='dropzone']:not(.over) { border-style: dashed; }
  [part~='dropzone'].over {
    border-style: dashed;
    border-color: var(--tone-ring);
    background: var(--tone-bg);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-lg);
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: 1;
    flex: none;
    transition: background-color var(--duration-fast), color var(--duration-fast);
  }
  [part~='dropzone'].over .icon {
    background: var(--selected-bg);
    color: var(--tone-ring);
  }
  input[type='file'] { display: none; }
  .file-list { margin-top: var(--space-2); }
  .file-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    color: var(--foreground);
  }
  .file-doc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-md);
    height: var(--control-h-md);
    border-radius: var(--radius-md);
    background: var(--tone-info-bg);
    color: var(--tone-info-fg);
    flex: none;
  }
  .file-meta { flex: 1; min-width: 0; }
  .file-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--foreground);
  }
  .file-size {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .error {
    color: var(--destructive);
    margin-top: var(--space-1);
    padding: 0 var(--space-1);
  }
  @media (prefers-reduced-motion: reduce) {
    [part~='dropzone'] { transition: none; }
  }
</style>


<controller>
import { controller, derived, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-file-upload.sui'

function fmtSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`
  if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`
  return `${(bytes / 1048576).toFixed(1)} MB`
}

interface DisplayFile {
  file: File
  idx: number
  key: string
  name: string
  sizeStr: string
}

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const files = signal<File[]>([])
    const over = signal(false)
    const errorMsg = signal('')
    const dropzoneEl = ref<HTMLDivElement>(null)
    const inputEl = ref<HTMLInputElement>(null)
    const fileListEl = ref<HTMLDivElement>(null)
    const displayFiles = derived<DisplayFile[]>(() =>
      files().map((file, idx) => ({
        file,
        idx,
        key: `${idx}:${file.name}:${file.size}`,
        name: file.name,
        sizeStr: fmtSize(file.size),
      })),
    )
    return { files, over, errorMsg, displayFiles, dropzoneEl, inputEl, fileListEl }
  },

  mount(state, host) {
    const matchesAccept = (file: File): boolean => {
      const tokens = (state.accept as string)
        .split(',')
        .map((t: string) => t.trim().toLowerCase())
        .filter(Boolean)
      if (tokens.length === 0) return true
      const ext = '.' + (file.name.split('.').pop() || '').toLowerCase()
      const type = file.type.toLowerCase()
      return tokens.some((t: string) => {
        if (t.startsWith('.')) return ext === t
        if (t.endsWith('/*')) return type.startsWith(t.slice(0, -1))
        return type === t
      })
    }

    const emitChange = (list: File[]) => {
      host.dispatchEvent(
        new CustomEvent('sui-change', {
          detail: { files: [...list] },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const addFiles = (incoming: File[]) => {
      state.errorMsg = ''
      const valid: File[] = []
      for (const f of incoming) {
        if (f.size > (state.maxSize as number)) {
          state.errorMsg = `\"${f.name}\" exceeds max size (${fmtSize(state.maxSize as number)}).`
          continue
        }
        if (state.accept && !matchesAccept(f)) {
          state.errorMsg = `"${f.name}" is not an accepted file type.`
          continue
        }
        valid.push(f)
      }
      const cur = state.files
      const next = state.multiple ? [...cur, ...valid] : valid.slice(0, 1)
      state.files = next
      emitChange(next)
    }

    const removeAt = (idx: number) => {
      const cur = state.files
      if (idx < 0 || idx >= cur.length) return
      const next = cur.filter((_: File, i: number) => i !== idx)
      state.files = next
      state.errorMsg = ''
      emitChange(next)
    }

    const openPicker = () => {
      if (state.disabled) return
      ;(state.inputEl as HTMLInputElement | null)?.click()
    }

    const onClick = () => openPicker()
    const onKey = (e: KeyboardEvent) => {
      if (state.disabled) return
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        openPicker()
      }
    }
    const onDragOver = (e: DragEvent) => {
      if (state.disabled) return
      e.preventDefault()
      state.over = true
    }
    const onDragLeave = () => { state.over = false }
    const onDrop = (e: DragEvent) => {
      if (state.disabled) return
      e.preventDefault()
      state.over = false
      const list = e.dataTransfer?.files
      if (list && list.length) addFiles(Array.from(list))
    }
    const onInputChange = (e: Event) => {
      const inp = e.target as HTMLInputElement
      if (inp.files && inp.files.length) addFiles(Array.from(inp.files))
      inp.value = ''
    }

    const dropzoneEl = state.dropzoneEl as HTMLDivElement | null
    const inputEl = state.inputEl as HTMLInputElement | null

    dropzoneEl?.addEventListener('click', onClick)
    dropzoneEl?.addEventListener('keydown', onKey)
    dropzoneEl?.addEventListener('dragover', onDragOver)
    dropzoneEl?.addEventListener('dragleave', onDragLeave)
    dropzoneEl?.addEventListener('drop', onDrop)
    inputEl?.addEventListener('change', onInputChange)

    // Event delegation for the dynamic .remove buttons inside the file list.
    const onShadowClick = (e: Event) => {
      const target = e.target as HTMLElement | null
      const btn = target?.closest?.('button.remove') as HTMLElement | null
      if (!btn || !host.shadowRoot?.contains(btn)) return
      const idx = Number(btn.dataset.idx)
      if (Number.isInteger(idx)) removeAt(idx)
    }
    host.shadowRoot?.addEventListener('click', onShadowClick)

    return () => {
      dropzoneEl?.removeEventListener('click', onClick)
      dropzoneEl?.removeEventListener('keydown', onKey)
      dropzoneEl?.removeEventListener('dragover', onDragOver)
      dropzoneEl?.removeEventListener('dragleave', onDragLeave)
      dropzoneEl?.removeEventListener('drop', onDrop)
      inputEl?.removeEventListener('change', onInputChange)
      host.shadowRoot?.removeEventListener('click', onShadowClick)
    }
  },
})

</controller>
<div class="dropzone" class:over={over()} role="button" tabindex={disabled() ? '-1' : '0'} aria-label={accept() ? 'Upload files (' + accept() + ')' : 'Upload files'} aria-disabled={disabled() ? 'true' : 'false'} bind:this={dropzoneEl}>
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
  </span>
  <span>Drag &amp; drop or <span style="color:var(--primary);text-decoration:underline;text-underline-offset:2px">browse</span></span>
</div>
<input class="input" type="file" accept={accept()} multiple={multiple()} aria-hidden="true" tabindex="-1" bind:this={inputEl} />
{#if errorMsg()}
  <div class="error" role="alert" sx="text:sm fg:destructive">{errorMsg()}</div>
{/if}
{#if displayFiles().length > 0}
  <column class="file-list" gap="1" aria-live="polite" bind:this={fileListEl}>
    {#for f of displayFiles() key={f.key}}
      <div class="file-item">
        <span class="file-doc-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:17px;height:17px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2 2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <column class="file-meta" gap="1">
          <span class="file-name">{f.name}</span>
          <span class="file-size">{f.sizeStr}</span>
        </column>
        <button ghost sm class="remove" type="button" data-idx={f.idx} aria-label={'Remove ' + f.name}>×</button>
      </div>
    {/for}
  </column>
{/if}
