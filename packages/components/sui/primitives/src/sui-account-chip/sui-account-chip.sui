<!--
  <sui-account-chip> — signed-in identity display for the nav-top
  chrome strip. Shows the account avatar (initials fallback) and
  display name. No popover, no menu — the chip is the *display
  surface*; actions (sign-in, sign-out, settings) live in
  <sui-account-menu>, which slots the chip into its trigger
  when a popover is wanted.

  Generic + SDK-free: identity is plain props (`name`, `image`) — the
  consuming app owns the `ship.account.state()` subscription and feeds
  the chip. Initials fall back from the name when no image is given.

  Prop / event surface
  ───────────────────────────────────────────────────────────────────
  name  (string, '')   display name; initials derive from it.
  image (string, '')   avatar image URL; falls back to initials.
  size  (enum, 'sm')   sm | md  — avatar diameter.
  hide-name  (bool, false)  when true, only the avatar renders
                              (useful in narrow chrome strips).
  ───────────────────────────────────────────────────────────────────
  Slots: (none)
  Parts: root, avatar, initials, name
  ───────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="image" type="string" default="" />
<prop name="size" values="sm|md" default="sm" reflect />
<prop name="hide-name" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }
  :host([hidden]) { display: none; }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--muted-foreground);
    color: var(--background);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    flex-shrink: 0;
    overflow: hidden;
    line-height: 1;
  }
  :host([size="md"]) .avatar { width: 28px; height: 28px; font-size: var(--text-xs); }
  :host([size="md"]) { font-size: var(--text-base); }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .name {
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
  }
  :host([hide-name]) .name { display: none; }
</style>

<span class="avatar" part="avatar" aria-hidden="true">
  {#if image() !== ''}
    <img src={image()} alt="" />
  {:else}
    {initials()}
  {/if}
</span>
<span class="name" part="name">{name()}</span>
