<prop name="name" type="string" default="" />
<prop name="image" type="string" default="" />
<prop name="size" values="sm|md" default="sm" reflect />
<prop name="hide-name" type="bool" default="false" reflect />

<host sx="display:inline-flex" />
<variants>
  [size=md]:    text:base
  [hidden]:     display:none
</variants>
<variants part="avatar">
  [size=md]: w:control-h-sm h:control-h-sm text:xs
</variants>
<variants part="name">
  [hide-name]: display:none
</variants>

<style>
  /* Local markers so the css-token lint recognizes the tokens
   * referenced from this residual block. */
  --font-body: ; --foreground: ; --background: ; --muted-foreground: ; --icon-size-2xl: ; --control-h-sm: ; --text-sm: ; --text-base: ; --text-xs: ; --font-weight-medium: ; --font-weight-semibold: ; --space-2: ; --panel-min-w-sm: ;
  /* Residual:
   *   * :host align-items + gap (host directive's sx is surface-only
   *     — no layout), font-family (no sx prop), font-size (default
   *     text-sm — the [size=md] override comes from <variants>),
   *     user-select (-webkit-user-select fallback too), box-sizing
   *   * the avatar's flex-shrink: 0 (not in sx)
   *   * the avatar img cover-fit + 100% size
   *   * the .name white-space:nowrap + overflow:hidden + text-overflow:ellipsis
   *     (no sx props; sx can't express text-overflow or text clipping) */
  :host {
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }

  [part='avatar'] {
    flex-shrink: 0;
  }

  [part='avatar'] img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  [part='name'] {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<row
  part="avatar"
  aria-hidden="true"
  align="center"
  justify="center"
  sx="w:icon-size-2xl h:icon-size-2xl radius:full bg:muted-foreground fg:background text:xs weight:semibold overflow:hidden leading:none"
>
  {#if image() !== ''}
    <img src={image()} alt="" />
  {:else}
    {initials()}
  {/if}
</row>
<span part="name" sx="fg:foreground weight:medium max-w:panel-min-w-sm">{name()}</span>
