<prop name="href" type="string" default="" />
<prop name="external" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|underline|subtle" default="default" reflect />
<prop name="target" type="string" default="" />
<prop name="rel" type="string" default="" />

<theme prop="tone" channels="link-fg, link-underline">
  default:     primary,          tone-primary-border
  primary:     primary,          tone-primary-border
  info:        info,             tone-info-border
  success:     success,          tone-success-border
  warning:     warning,          tone-warning-border
  destructive: destructive,      tone-destructive-border
  accent:      accent,           tone-accent-border
  muted:       muted-foreground, tone-muted-border
</theme>

<style>
  /* Local markers so the css-token lint recognizes the channels and
   * tokens referenced from this residual block. */
  --link-fg: ; --link-underline: ; --font-body: ; --ring-offset: ; --ring-width: ; --ring-color: ; --space-1: ; --radius-sm: ; --duration-fast: ;
  /* Residual: `:host` (host element, no sx), the anchor's
   * text-decoration-color/thickness/offset (no sx prop), the
   * :hover decoration-color change, the per-variant :host
   * text-decoration-color override, the focus-visible outline
   * (canonical --ring-width + --ring-color pair), the .ext
   * external-link glyph positioning (raw 0.85em + vertical-align
   * in em, not tokens), and the .sr-only absolute-clip helper. */
  :host { display: inline; font-family: var(--font-body); }

  a {
    display: inline;
    border-radius: var(--radius-sm);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--ring-offset);
    text-decoration-color: var(--link-underline);
    transition:
      color var(--duration-fast),
      text-decoration-color var(--duration-fast),
      text-underline-offset var(--duration-fast);
  }
  a:hover {
    text-decoration-color: var(--link-fg);
    text-underline-offset: var(--ring-width);
  }
  :host([variant='underline']) a { text-decoration-color: var(--link-underline); }
  :host([variant='underline']) a:hover { text-decoration-color: var(--link-fg); }
  :host([variant='subtle']) a { text-decoration-color: transparent; }
  :host([variant='subtle']) a:hover {
    color: var(--link-fg);
    text-decoration-color: var(--link-underline);
  }
  a:focus-visible {
    outline: var(--ring-width) solid var(--ring-color);
    outline-offset: var(--ring-offset);
  }
  .ext {
    display: inline-block;
    margin-inline-start: var(--space-1);
    font-size: 0.85em;
    opacity: 0.65;
    vertical-align: -0.05em;
  }
  .ext svg { width: 0.85em; height: 0.85em; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<a part="link"
   href={href()}
   target={external() ? '_blank' : target()}
   rel={external() ? 'noopener noreferrer' : rel()}
   sx="fg:link-fg"
>
  <slot></slot>
  {#if external()}
    <span class="sr-only">(opens in new tab)</span>
    <span class="ext" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
      </svg>
    </span>
  {/if}
</a>
