<!--
  <sui-context-menu> — SUI port of <ship-context-menu>.
  Right-click triggered overlay menu. Uses the native popover API
  (popover="auto") for top-layer rendering and light-dismiss.
  The panel is positioned at the cursor coordinates, not anchored.

  Prop / event / method parity vs <ship-context-menu>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-select          sui-select { detail:{value}} ✓ renamed
          ship-open/close      sui-open/close               ✓ renamed
  Methods: show(x,y), close()  show(x,y), close()          ✓
  Slots: trigger, (default)    trigger, (default)           ✓
  Parts: menu                  panel                        ✓
  ────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    open: false,
  },
}</component>
<style>
  .sui-context-menu { display: contents; }
  .sui-context-menu[hidden] { display: none; }

  /* The <column> primitive absorbs display:flex + flex-direction:column
     (the lowered .sui-col class). The remaining .panel rules are raw
     values no construct reaches: inset:auto (popover default override),
     margin:0 (slot default reset), min-width (no sx prop), font-family
     (no sx font: prop), opacity/transform + multi-prop transition
     (motion), the :popover-open pseudo, ::backdrop transparent. */
  .panel {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: var(--panel-min-w-md);
    font-family: var(--font-body);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: scale(1);
  }
  .panel::backdrop { background: transparent; }

  /* ::slotted descendants — buttons, role=menuitems, hr separators, and
     data-section labels — are authored in the consumer's slot. They use
     pseudo-class / attribute-selector styling that variants/sx can't
     express. The transparent raw keyword and multi-prop transitions
     further anchor this as residual. */
  ::slotted(button), ::slotted([role='menuitem']) {
    display: flex; align-items: center; gap: var(--space-2);
    text-align: start;
    background: transparent; border: 0;
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit; font: inherit;
    cursor: pointer; width: 100%;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  ::slotted(button:hover), ::slotted([role='menuitem']:hover),
  ::slotted(button:focus-visible), ::slotted([role='menuitem']:focus-visible) {
    background: var(--muted);
    outline: none;
  }
  ::slotted(button[data-tone='destructive']) { color: var(--destructive); }
  ::slotted(button[data-tone='destructive']:hover) { background: var(--tone-destructive-bg); }
  ::slotted(hr) { height: 1px; border: 0; background: var(--border-subtle); margin: var(--space-1) var(--space-1); }
  ::slotted([data-section]) { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--muted-foreground); padding: var(--space-2) var(--space-2) var(--space-1); }

  @media (prefers-reduced-motion: reduce) {
    .panel { transition: none; transform: none !important; }
  }
  @media (forced-colors: active) {
    .panel { border: 1px solid CanvasText; }
  }
</style>


<controller>
import { controller, effect, bindNativeEvent, usePopover } from '@ship/sui-runtime'
import type { Scope } from './sui-context-menu.sui'

let _seq = 0

type PopoverEl = HTMLElement & {
  showPopover?: () => void
  hidePopover?: () => void
}

export default controller<Scope>({
  mount(state, host) {
    const panelId = `sui-context-menu-panel-${++_seq}`

    const triggerSlot = state.$signals.triggerSlot() as HTMLSlotElement | null
    const panelEl = state.$signals.panelEl() as PopoverEl | null

    if (!panelEl) return
    panelEl.id = panelId

    // ── Typeahead state ──────────────────────────────────────────────────
    let typeaheadBuf = ''
    let typeaheadTimer: ReturnType<typeof setTimeout> | null = null

    function pushTypeahead(key: string): number {
      if (typeaheadTimer) clearTimeout(typeaheadTimer)
      typeaheadBuf += key.toLowerCase()
      typeaheadTimer = setTimeout(() => { typeaheadBuf = '' }, 350)
      const items = getItems()
      const i = items.indexOf(document.activeElement as HTMLElement)
      for (let j = 0; j < items.length; j++) {
        const idx = (i + 1 + j) % items.length
        const label = (items[idx]!.textContent ?? '').trim().toLowerCase()
        if (label.startsWith(typeaheadBuf)) return idx
      }
      return -1
    }

    // ── Item management ──────────────────────────────────────────────────
    function getItems(): HTMLElement[] {
      return Array.from(
        host.querySelectorAll<HTMLElement>('[role="menuitem"], button[data-value], [data-value]'),
      ).filter(el => !el.hasAttribute('disabled'))
    }

    function focusItem(index: number) {
      const items = getItems()
      if (!items.length) return
      const i = ((index % items.length) + items.length) % items.length
      for (const it of items) it.setAttribute('tabindex', '-1')
      items[i]!.setAttribute('tabindex', '0')
      items[i]!.focus()
    }

    function currentIndex(): number {
      return getItems().indexOf(document.activeElement as HTMLElement)
    }

    function setupItems() {
      getItems().forEach((el, idx) => {
        if (!el.hasAttribute('role')) el.setAttribute('role', 'menuitem')
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', idx === 0 ? '0' : '-1')
      })
    }

    // ── Open state: the ONE implementation ─────────────────────────────────
    // usePopover's handle IS bindPopover (native showPopover/hidePopover <->
    // signal + light-dismiss sync). This menu positions at the CURSOR, not a
    // trigger, so it keeps pointer coords (use:anchor is for trigger-anchored
    // popovers). The `open` prop bridges to the handle.
    const pop = usePopover()
    const detach = pop(panelEl) as { destroy?: () => void }

    // ── Public API ───────────────────────────────────────────────────────
    function doShow(x: number, y: number) {
      if (panelEl) {
        panelEl.style.top = `${y}px`
        panelEl.style.left = `${x}px`
      }
      host.setAttribute('open', '')
    }

    function doClose() {
      host.removeAttribute('open')
    }

    host.expose!({ show: doShow as never, close: doClose })

    // ── Events ───────────────────────────────────────────────────────────
    const onContextMenu = (e: MouseEvent) => {
      e.preventDefault()
      doShow(e.clientX, e.clientY)
    }

    // open prop → handle
    const stopIn = effect(() => {
      if (state.$signals.open()) pop.open()
      else pop.close()
    })

    // real toggles (native show/hide/light-dismiss) → prop sync + menu reactions
    const onToggle = (ev: Event) => {
      const nowOpen = (ev as ToggleEvent).newState === 'open'
      const has = host.hasAttribute('open')
      if (nowOpen && !has) host.setAttribute('open', '')
      else if (!nowOpen && has) host.removeAttribute('open')
      if (nowOpen) {
        host.emit!('sui-open')
        queueMicrotask(() => { setupItems(); focusItem(0) })
      } else {
        host.emit!('sui-close')
      }
    }

    const onItemClick = (e: Event) => {
      const target = (e.target as HTMLElement).closest('[data-value]') as HTMLElement | null
      if (!target) return
      host.emit!('sui-select', { value: target.dataset.value ?? '' })
      doClose()
    }

    const onKeydown = (e: KeyboardEvent) => {
      if (!state.$signals.open()) return
      const items = getItems()
      if (!items.length) return
      const i = currentIndex()
      if (e.key === 'ArrowDown') { e.preventDefault(); focusItem(i + 1) }
      else if (e.key === 'ArrowUp') { e.preventDefault(); focusItem(i - 1) }
      else if (e.key === 'Home') { e.preventDefault(); focusItem(0) }
      else if (e.key === 'End') { e.preventDefault(); focusItem(items.length - 1) }
      else if (e.key === 'Escape') { e.preventDefault(); doClose() }
      else if (e.key === 'Tab') { doClose() }
      else if ((e.key === 'Enter' || e.key === ' ') && i >= 0) { e.preventDefault(); items[i]!.click() }
      else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
        const next = pushTypeahead(e.key)
        if (next >= 0) { e.preventDefault(); focusItem(next) }
      }
    }

    const wireTrigger = () => {
      const els = triggerSlot?.assignedElements({ flatten: true }) as HTMLElement[] ?? []
      for (const el of els) {
        el.addEventListener('contextmenu', onContextMenu)
      }
    }

    if (triggerSlot) bindNativeEvent(triggerSlot, 'slotchange', wireTrigger)
    wireTrigger()
    bindNativeEvent(panelEl, 'toggle', onToggle as EventListener)
    bindNativeEvent(panelEl, 'click', onItemClick)
    bindNativeEvent(host, 'keydown', onKeydown as EventListener)

    const stopSync = effect(() => {
      host.setAttribute('data-state', state.$signals.open() ? 'open' : 'closed')
    })

    return () => {
      const els = triggerSlot?.assignedElements({ flatten: true }) as HTMLElement[] ?? []
      for (const el of els) el.removeEventListener('contextmenu', onContextMenu)
      if (typeaheadTimer) clearTimeout(typeaheadTimer)
      stopIn()
      stopSync()
      detach.destroy?.()
    }
  },
})

</controller>
<slot name="trigger" bind:this={triggerSlot}></slot>
<column class="panel" gap="0" popover="auto" role="menu" aria-label="Context menu" bind:this={panelEl} sx="p:1 bg:popover fg:popover-foreground border:border radius:md shadow:lg text:sm">
  <slot bind:this={itemSlot}></slot>
</column>
