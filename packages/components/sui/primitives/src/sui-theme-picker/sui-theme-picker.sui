<!--
  <sui-theme-picker> — port of the shell theme picker (apps/shell/src/main.ts
  mountThemePicker + apps/shell/src/chrome/ship-nav-top.ts:150-161).

  Trigger button (palette dot + current theme label) toggles a panel
  rendered via the native popover API. The panel hosts a grouped list of
  mini-preview cards. Each card scopes that theme's tokens via
  [data-theme-preview="<id>"] so the preview shows the actual surface,
  font, primary/accent — not a static swatch. Selecting a card calls
  applyTheme + persistTheme, dispatches `sui-theme-change`, closes the
  panel.

  Listens to `ship:theme:change` on document (the canonical event
  applyTheme dispatches) so external theme changes (devtools, settings,
  programmatic) repaint the trigger and the card selection.

  Prop / event surface
  ────────────────────────────────────────────────────────────────────────
  Props:
    placement (union, 'bottom-end', reflect)  panel placement
    label-style (union, 'text'|'compact', 'compact', reflect)
                                              compact (default) = palette
                                              icon only, no label/caret —
                                              the shell + marketing site
                                              both use this
    persist (bool, true, reflect)             write-through to localStorage
                                              via the host theme transport
    tokens-href (string, '/view-tokens.css')  where the host serves the
                                              [data-theme-preview] stylesheet
                                              injected into the shadow root
  ────────────────────────────────────────────────────────────────────────
  Events: sui-theme-change   { detail: { id, dark } }   bubbles, composed
  Slots: (none — fully self-contained)
  Parts: trigger, dot, label, panel, grid
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="placement" values="top|top-end|bottom|bottom-end|left|left-end|right|right-end" default="bottom-end" reflect />
<prop name="label-style" values="text|compact" default="compact" reflect />
<prop name="persist" type="bool" default="true" reflect />
<!-- `app` (default) is the shell: trigger shows the active theme's accent
     swatch and the footer routes to /theme-studio. `marketing` is the static
     site: the trigger inherits surrounding text color (legible on the
     translucent menubar) and the Customize footer is hidden because the static
     site has no /theme-studio route. -->
<prop name="surface" values="app|marketing" default="app" reflect />
<!-- Ship-free seam: the host names where the preview stylesheet
     ([data-theme-preview] rules) is served; injected into the shadow root so
     previews reach shadow children. Default is origin-relative. -->
<prop name="tokens-href" type="string" default="/view-tokens.css" />
<!-- `scope` isolates the picker's theme application to the host element's
     subtree (a catalog preview, an isolated panel). Empty (default) preserves
     the document-level behavior the shell + marketing site depend on;
     a non-empty value disables `applyTheme(documentElement)` on mount and
     routes any selection to the host's own `data-theme` + `.dark` class so
     the document root is never mutated. -->
<prop name="scope" type="string" default="" />

<!--
  Theme channel: --tp-trigger-gap drives the inner gap of the trigger, and
  --tp-trigger-px / --tp-trigger-py drive the trigger's horizontal and vertical
  padding. `compact` collapses the trigger to a single icon (no inner gap,
  symmetric padding). `text` adds the label + caret with the canonical 6/8 px
  rhythm. `default` and `compact` land on the same values because the runtime's
  reflect=true only writes the attribute when the prop actually changes — an
  unset prop leaves the host attribute absent, so the bare `:host` rule has to
  already be the compact values.
-->
<theme prop="label-style" channels="tp-trigger-gap, tp-trigger-px, tp-trigger-py">
  default: 0,         space-1, space-1
  compact: 0,         space-1, space-1
  text:    space-1_5, space-2, space-1
</theme>

<!--
  Residual <style> — the bulk of this component's surface styling:
  - :host bare baseline + the .trigger surface (transition / appearance /
    background:transparent / border:1px solid transparent / font:inherit /
    display:inline-flex + align-items — gap is a flex prop, no sx).
  - .trigger :hover / :focus-visible :hover stays in residual because the
    focus ring uses a single-layer box-shadow (raw --ring-width+--ring);
    sx `ring:` is the 2-layer offset ring, different geometry.
  - .label :white-space / text-overflow:ellipsis (no sx).
  - .label / .caret display:none under :not(text) — variants don't support
    :not() selectors, so the :host(:not([label-style='text'])) .label /
    .caret / .trigger rules stay inline.
  - .panel popover surface: position:fixed + inset:auto + multi-prop
    transition + transform/opacity motion; .panel:popover-open state;
    .panel::backdrop (pseudo).
  - .grid raw width:332px + gap:10px (not in spacing tokens) + scrollbar
    + overflow-y — flex→column is also a layout primitive, but the raw
    gap doesn't fit the 0–8 scale.
  - .customize appearance / background:transparent / text-align / font /
    border-top:1px (directional, no sx) + transition + the single-layer
    focus-visible ring.
  - .card descendant `display:flex` (layout primitive, but the gap is
    space-1_5 which IS in the 0–8 scale → can move to <column gap="1_5">).
  - .radio raw 12px dimensions + border:var(--space-1_25) (raw thickness,
    not a token) + flex-shrink (no sx).
  - .tc-* preview tile rules: raw 132px / inset 2px / 7px / 6px / 5px / etc.
    dimension values (no tokens), color-mix() backgrounds, backdrop-filter /
    -webkit-backdrop-filter, isolation, ::after pseudo on .radio, scrollbar
    state, the prefers-reduced-motion @media queries that turn transitions
    off and hide .tc-overlay, .card[aria-selected='true'] .radio descendant
    rule (variants don't reach descendants), .tc-chip-accent uses color-mix
    (--accent tinting — explicitly skipped by the tone-ramp migration).
  - Surface prop variants: no surface-driven CSS — marketing just sets the
    icon's `style:color` (handled in JS via the triggerIconColor() binding),
    so no `<theme prop="surface">` block needed.
-->
<style>
  /* Local markers — the css-token lint only sees tokens.css + declarations
   * in this block; the <theme> channels and tokens referenced from this
   * residual style must be declared as bare variables so the lint recognizes
   * them. */
  --tp-trigger-gap: ; --tp-trigger-px: ; --tp-trigger-py: ; --panel-vh-md: ; --space-half: ;
  :host {
    position: relative;
    display: inline-flex;
  }
  :host([hidden]) { display: none; }

  .trigger {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: var(--tp-trigger-gap);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .trigger:hover {
    background: var(--hover-bg);
  }
  .trigger:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--ring-width) var(--ring);
  }

  .dot {
    width: var(--space-2_5); height: var(--space-2_5);
    border-radius: var(--radius-full);
    background: var(--primary);
    box-shadow: 0 0 0 1px var(--border-subtle);
    flex: 0 0 auto;
  }

  .label {
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  :host(:not([label-style='text'])) .label { display: none; }
  :host(:not([label-style='text'])) .caret { display: none; }

  .caret {
    flex: 0 0 auto;
  }

  .panel {
    position: fixed;
    inset: auto;
    margin: 0;
    border: 0;
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-1))) scale(0.97);
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .panel::backdrop { background: transparent; }

  .grid {
    gap: 10px;
    width: 332px;
    max-height: min(var(--panel-vh-md), 720px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .customize {
    appearance: none;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--border);
    text-align: left;
    font: inherit;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .customize:hover {
    background: var(--hover-bg);
  }
  .customize:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring);
  }
  .customize-meta {
    flex: 1;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }
  .customize-chev {
    color: var(--muted-foreground);
    flex: 0 0 auto;
  }

  .group { display: flex; flex-direction: column; gap: var(--space-half); }
  .group-h {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--muted-foreground);
    padding: 0 var(--space-2) var(--space-half);
    opacity: 0.7;
  }
  .group-rows { display: flex; flex-direction: column; gap: var(--space-1); }

  .card {
    appearance: none;
    background: transparent;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1_5);
    text-align: left;
    font: inherit;
    outline: none;
    transition:
      background var(--duration-fast) var(--ease-out);
  }
  .card:focus-visible {
    background: var(--hover-bg);
    box-shadow: 0 0 0 var(--ring-width) var(--ring);
  }
  .card[aria-selected='true'] {
    background: var(--selected-bg);
  }

  .row { display: flex; align-items: center; gap: var(--space-2); }

  .name {
    flex: 1;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .radio {
    width: 12px; height: 12px;
    border: var(--space-1_25) solid var(--border-strong);
    background: transparent;
    position: relative;
    flex-shrink: 0;
  }
  .card[aria-selected='true'] .radio { border-color: var(--primary); }
  .card[aria-selected='true'] .radio::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: var(--radius-full);
    background: var(--primary);
  }

  .tc-bg {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 132px;
    border-radius: 8px;
    overflow: hidden;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, currentColor 14%, transparent);
  }
  .tc-overlay {
    position: absolute; inset: 0;
    pointer-events: none;
    background: var(--surface-overlay);
    mix-blend-mode: var(--surface-overlay-blend);
    opacity: var(--surface-overlay-opacity);
  }
  @media (prefers-reduced-motion: reduce) {
    .tc-overlay { display: none; }
    .panel { transition: none; transform: none !important; }
  }
  .tc-card {
    position: relative;
    z-index: 2;
    display: flex; flex-direction: column; gap: 7px;
    width: calc(100% - 24px);
    padding: 10px var(--space-3) 11px;
    box-shadow: var(--shadow-card-rest);
    backdrop-filter: var(--card-backdrop-filter);
    -webkit-backdrop-filter: var(--card-backdrop-filter);
    overflow: clip;
    isolation: isolate;
  }
  .tc-card-head { display: flex; flex-direction: column; gap: 2px; }
  .tc-eyebrow {
    font-family: var(--label-font);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-tracking);
    font-size: 8px; line-height: 1;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .tc-heading {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    font-size: var(--text-base); line-height: 1.05;
    color: var(--card-foreground);
  }
  .tc-typo {
    display: flex; align-items: baseline; gap: 6px;
    font-family: var(--body-font);
    font-size: 9.5px; line-height: 1;
    color: var(--muted-foreground);
  }
  .tc-body { color: var(--card-foreground); opacity: 0.85; }
  .tc-mono {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 1px var(--space-1);
    border-radius: 3px;
    background: var(--hover-bg);
    color: var(--muted-foreground);
  }
  .tc-controls { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
  .tc-cta {
    display: inline-flex; align-items: center;
    font-weight: 500; font-size: 9.5px; line-height: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .tc-ghost {
    display: inline-flex; align-items: center;
    font-weight: 500; font-size: 9.5px; line-height: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
    border: 1px solid var(--border);
  }
  .tc-chip {
    display: inline-flex; align-items: center;
    font-weight: 600; font-size: 8.5px; line-height: 1;
    padding: 3px 6px;
    border-radius: var(--radius-full);
  }
  .tc-chip-accent {
    background: color-mix(in oklch, var(--accent) 18%, transparent);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--accent) 30%, transparent);
  }
  .tc-chip-muted {
    background: var(--hover-bg);
    color: var(--muted-foreground);
  }
</style>

<button class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  aria-label="Choose theme"
  aria-haspopup="dialog"
  aria-expanded={panelOpen() ? 'true' : 'false'}
  sx="radius:sm py:tp-trigger-py px:tp-trigger-px text:base fg:foreground cursor:pointer"
  on:click={() => togglePanel()}>
  <sui-icon class="tp-icon" part="dot" name="palette" size="lg" style:color={triggerIconColor()} aria-hidden="true"></sui-icon>
  <span class="label" part="label"
    sx="weight:medium overflow:hidden max-w:panel-ch-w-md">{triggerLabel()}</span>
  <svg class="caret" part="caret" viewBox="0 0 10 6" aria-hidden="true" sx="w:2_5 h:1_5 fg:muted-foreground">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<div class="panel" part="panel" popover="auto" bind:this={panelEl}
  sx="p:1 bg:popover fg:popover-foreground border:border radius:md shadow:lg">
  <column class="grid" part="grid" role="listbox" aria-label="Theme" sx="max-h:panel-vh-md">
    {#for g of groups() key={g.label}}
      <section class="group" aria-label={g.label}>
        <div class="group-h">{g.label}</div>
        <div class="group-rows">
          {#for t of g.themes key={t.id}}
            <button class="card" part="card" role="option" type="button"
              data-theme-card={t.id}
              aria-label={t.label}
              aria-selected={activeTheme() === t.id ? 'true' : 'false'}
              tabindex={activeTheme() === t.id ? '0' : '-1'}
              sx="radius:lg p:1_5 cursor:pointer hover:bg:hover-bg"
              on:click={() => selectTheme(t.id)}>
              <span class="tc-bg" data-theme-preview={t.id} aria-hidden="true">
                <span class="tc-overlay" sx="z:elevated"></span>
                <span class="tc-card" sx="position:relative bg:card fg:card-foreground border:border radius:md">
                  <span class="tc-card-head">
                    <span class="tc-eyebrow">THEME</span>
                    <span class="tc-heading">{t.label}</span>
                  </span>
                  <span class="tc-typo">
                    <span class="tc-body">The quick brown fox</span>
                    <span class="tc-mono">{'{ build: ok }'}</span>
                  </span>
                  <span class="tc-controls">
                    <span class="tc-cta">Action</span>
                    <span class="tc-ghost">Cancel</span>
                    <span class="tc-chip tc-chip-accent">New</span>
                    <span class="tc-chip tc-chip-muted">Idle</span>
                  </span>
                </span>
              </span>
              <row class="row" align="center" gap="2" sx="px:1">
                <span class="name">{t.label}</span>
                <span class="radio" aria-hidden="true" sx="radius:full"></span>
              </row>
            </button>
          {/for}
        </div>
      </section>
    {/for}
    {#if showCustomize()}
      <button class="customize" type="button" data-theme-customize
        sx="cursor:pointer text:xs fg:foreground mt:1 py:2_5 px:3"
        on:click={openCustomize}>
        <row align="center" gap="2">
          <span>Customize…</span>
          <span class="customize-meta">Per-token editor</span>
          <svg class="customize-chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M3 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </row>
      </button>
    {/if}
  </column>
</div>
