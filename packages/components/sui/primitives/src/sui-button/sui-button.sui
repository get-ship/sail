  <prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
  <prop name="variant" values="solid|soft|outline|ghost|default" default="default" reflect />
  <prop name="size" values="xs|sm|md|lg" default="md" reflect />
  <prop name="type" values="button|submit|reset" default="button" reflect />
  <prop name="disabled" type="bool" default="false" reflect />
  <prop name="loading" type="bool" default="false" reflect />
  <prop name="label" type="string" default="" />
  <prop name="pressed" values="true|false|mixed" default="false" reflect />
  <prop name="expanded" type="string" default="" reflect />

  <theme prop="size" channels="btn-h, btn-px, btn-fs, btn-fw, btn-gap">
    xs: control-h-2xs, space-2,  text-xs,  font-weight-medium, space-1
    sm: control-h-sm,  space-2_5, text-sm,  font-weight-medium, space-1_5
    md: control-h-md,  space-3,  text-base, font-weight-medium, space-2
    lg: control-h-lg,  space-4,  text-md,  font-weight-medium, space-2
  </theme>

  <variants part="button">
    variant=default:  bg:background border:border fg:foreground shadow:xs
  </variants>

  <style>
    /* Residual: raw `transparent` keyword (sx is token-only, no
     * --transparent token), transforms (raw px/scale), multi-property
     * transition, focus outline, disabled state (saturate(.6) is raw),
     * spinner keyframes + positioning, icon-only shape, ::slotted —
     * none reducible to sx/variants/theme. The `--xxx: ;` lines are
     * local-marker declarations so the css-token lint recognizes the
     * theme channels + focus tokens referenced from this block. */
    --btn-h: ; --btn-gap: ; --icon-size-sm: ; --focus-ring: ; --focus-ring-offset: ; --tone: ; --tone-fg: ; --tone-bg: ; --tone-border: ; --tone-ring: ; --tone-contrast: ; --border-strong: ; --muted: ; --muted-foreground: ;
    :host { display: inline-flex; vertical-align: middle; }
    [part='button'] { background: transparent; border: 1px solid transparent; isolation: isolate; font-family: var(--font-body); line-height: 1; letter-spacing: -0.005em; user-select: none; white-space: nowrap; }
    :host([variant='solid']) [part='button'] { background: var(--tone); border-color: var(--tone); color: var(--tone-contrast); box-shadow: var(--shadow-xs); }
    :host([variant='solid']:not([disabled])) [part='button']:hover { background: var(--hover-bg); box-shadow: var(--shadow-sm); }
    :host([variant='soft']) [part='button'] { background: var(--tone-bg); border-color: var(--tone-border); color: var(--tone-fg); }
    :host([variant='soft']:not([disabled])) [part='button']:hover { background: var(--tone-ring); }
    :host([variant='outline']) [part='button'] { background: transparent; border-color: var(--tone); color: var(--tone-fg); }
    :host([variant='outline']:not([disabled])) [part='button']:hover { background: var(--hover-bg); }
    :host([variant='default']:not([disabled])) [part='button']:hover { background: var(--muted); border-color: var(--border-strong); }

    :host([variant='ghost']:not([disabled])) [part='button']:hover { background: var(--hover-bg); }

    [part='button'] { transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    }
    [part='button']:hover:not(:disabled) { transform: translateY(-1px); }
    :host(:not([disabled]):not([loading])) [part='button']:active:not(:disabled) { transform: translateY(1px) scale(0.98); }
    @media (prefers-reduced-motion: reduce) {
      [part='button'] { transition: none; }
      [part='button']:hover:not(:disabled), [part='button']:active:not(:disabled) { transform: none !important; }
    }
    [part='button']:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
    [part='button']:disabled { cursor: not-allowed; color: var(--muted-foreground); background: var(--muted); border-color: var(--border); box-shadow: none; transform: none; filter: saturate(0.6); }
    :host([variant='ghost']) [part='button']:disabled, :host([variant='outline']) [part='button']:disabled { background: transparent; }
    :host([loading]) [part='button'] { cursor: progress; }
    :host([loading]) [part='button'] .content { opacity: 0; }
    :host([data-icon-only]) [part='button'] { padding-inline: 0; width: var(--btn-h); min-width: var(--btn-h); }

    .spinner-wrap { position: absolute; inset: 0; display: inline-flex; align-items: center; justify-content: center; pointer-events: none; }
    .spinner { width: var(--icon-size-sm); height: var(--icon-size-sm); border: 1.5px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: sui-button-spin 0.7s linear infinite; }
    @keyframes sui-button-spin { to { transform: rotate(360deg); } }


    .content { gap: var(--btn-gap); transition: opacity var(--duration-fast) var(--ease-out); }
    ::slotted([slot='trailing']) {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
    }
  </style>

<button
  part="button"
  type={type()}
  disabled={disabled() || loading()}
  motion:hover={{ scale: 'spring:snappy' }}
  aria-busy={loading() ? 'true' : 'false'}
  aria-disabled={(disabled() || loading()) ? 'true' : 'false'}
  aria-label={label()}
  aria-pressed={pressed()}
  aria-expanded={expanded()}
  sx="
    display:inline-flex
    fg:foreground
    border:none
    radius:md
    cursor:pointer
    position:relative
    min-h:btn-h
    px:btn-px
    text:btn-fs
    py:0
    weight:btn-fw
  "
>
  <row class="content" align="center" justify="center">
    <slot name="leading"></slot>
    <slot reflect-empty="data-icon-only"></slot>
    <slot name="trailing"></slot>
  </row>
  {#if loading()}
    <span class="spinner-wrap" aria-hidden="true"><span class="spinner"></span></span>
  {/if}
</button>
