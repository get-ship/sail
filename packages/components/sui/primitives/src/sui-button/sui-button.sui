  <prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
  <prop name="variant" values="solid|soft|outline|ghost|default" default="default" reflect />
  <prop name="size" values="xs|sm|md|lg" default="md" reflect />
  <prop name="type" values="button|submit|reset" default="button" reflect />
  <prop name="disabled" type="bool" default="false" reflect />
  <prop name="loading" type="bool" default="false" reflect />
  <prop name="label" type="string" default="" />
  <prop name="pressed" values="true|false|mixed" default="false" reflect />
  <prop name="expanded" type="string" default="" reflect />

  <style>
    :host {
      display: inline-flex;
      vertical-align: middle;
      --tone: var(--foreground);
      --tone-fg: var(--foreground);
      --tone-contrast: var(--background);
      --tone-bg: var(--hover-bg);
      --tone-border: var(--border);
      --tone-ring: var(--ring);
      --btn-h: var(--control-h-md);
      --btn-px: var(--space-3);
      --btn-fs: var(--text-base);
      --btn-fw: var(--font-weight-medium);
      --btn-gap: var(--space-2);
    }
    :host([tone='primary'])     { --tone: var(--primary);     --tone-fg: var(--primary);     --tone-bg: var(--tone-primary-bg);     --tone-border: var(--tone-primary-border);     --tone-ring: var(--tone-primary-ring); }
    :host([tone='info'])        { --tone: var(--info);        --tone-fg: var(--info);        --tone-bg: var(--tone-info-bg);        --tone-border: var(--tone-info-border);        --tone-ring: var(--tone-info-ring); }
    :host([tone='success'])     { --tone: var(--success);     --tone-fg: var(--tone-success-fg); --tone-bg: var(--tone-success-bg);  --tone-border: var(--tone-success-border);  --tone-ring: var(--tone-success-ring); }
    :host([tone='warning'])     { --tone: var(--warning);     --tone-fg: var(--tone-warning-fg); --tone-bg: var(--tone-warning-bg);  --tone-border: var(--tone-warning-border);  --tone-ring: var(--tone-warning-ring); }
    :host([tone='destructive']) { --tone: var(--destructive); --tone-fg: var(--destructive); --tone-bg: var(--tone-destructive-bg); --tone-border: var(--tone-destructive-border); --tone-ring: var(--tone-destructive-ring); }
    :host([tone='accent'])      { --tone: var(--accent);      --tone-fg: var(--accent);      --tone-bg: var(--tone-accent-bg);      --tone-border: var(--tone-accent-border);      --tone-ring: var(--tone-accent-ring); }
    :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); --tone-bg: var(--tone-muted-bg); --tone-border: var(--tone-muted-border); --tone-ring: var(--tone-muted-ring); }
    :host([hidden]) { display: none; }

    /* Size matrix */
    :host([size='xs']) { --btn-h: var(--control-h-2xs); --btn-fs: var(--text-xs); --btn-px: var(--space-2);  --btn-gap: var(--space-1); }
    :host([size='sm']) { --btn-h: var(--control-h-sm); --btn-fs: var(--text-sm); --btn-px: var(--space-2_5); --btn-gap: var(--space-1_5); }
    :host([size='md']) { --btn-h: var(--control-h-md); --btn-fs: var(--text-base); --btn-px: var(--space-3); --btn-gap: var(--space-2); }
    :host([size='lg']) { --btn-h: var(--control-h-lg); --btn-fs: var(--text-md); --btn-px: var(--space-4); --btn-gap: var(--space-2); }

    button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--btn-gap);
      min-height: var(--btn-h);
      padding: 0 var(--btn-px);
      font-family: var(--font-body);
      font-weight: var(--btn-fw);
      font-size: var(--btn-fs);
      line-height: 1;
      letter-spacing: -0.005em;
      border-radius: var(--radius-md);
      border: 1px solid transparent;
      background: transparent;
      color: var(--foreground);
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
      isolation: isolate;
      position: relative;
      transition:
        background-color var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out),
        box-shadow var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--ease-out);
    }

    /* Default (no variant attr) — neutral bordered button. */
    :host(:not([variant])) button,
    :host([variant='default']) button {
      background: var(--background);
      border-color: var(--border);
      color: var(--foreground);
      box-shadow: var(--shadow-xs);
    }
    :host(:not([variant])) button:hover:not(:disabled),
    :host([variant='default']) button:hover:not(:disabled) {
      background: var(--muted);
      border-color: var(--border-strong);
      transform: translateY(-1px);
    }

    /* Solid */
    :host([variant='solid']) button {
      background: var(--tone);
      border-color: var(--tone);
      color: var(--tone-contrast);
      box-shadow: var(--shadow-xs);
    }
    :host([variant='solid']) button:hover:not(:disabled) {
      background: var(--hover-bg);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    /* Soft */
    :host([variant='soft']) button {
      background: var(--tone-bg);
      border-color: var(--tone-border);
      color: var(--tone-fg);
    }
    :host([variant='soft']) button:hover:not(:disabled) {
      background: var(--tone-ring);
    }

    /* Outline */
    :host([variant='outline']) button {
      background: transparent;
      border-color: var(--tone);
      color: var(--tone-fg);
    }
    :host([variant='outline']) button:hover:not(:disabled) {
      background: var(--hover-bg);
    }

    /* Ghost */
    :host([variant='ghost']) button {
      background: transparent;
      border-color: transparent;
      color: var(--tone-fg);
    }
    :host([variant='ghost']) button:hover:not(:disabled) {
      background: var(--hover-bg);
    }
    /* Default-tone ghost hover lightens because `--tone` resolves to
     * `--foreground` — 12% foreground reads heavy on light themes. */
    :host([variant='ghost']:not([tone])) button:hover:not(:disabled),
    :host([variant='ghost'][tone='default']) button:hover:not(:disabled) {
      background: var(--hover-bg);
    }

    /* Active press — feels clicked across all variants. */
    :host(:not([disabled]):not([loading])) button:active:not(:disabled) {
      transform: translateY(1px) scale(0.98);
    }
    @media (prefers-reduced-motion: reduce) {
      button { transition: none; }
      button:active { transform: none !important; }
    }

    /* Focus ring — consume the system token. Outline (not stacked
     * box-shadow) so `forced-colors: active` still draws a system
     * ring and the ring isn't clipped by neighbouring shadows. */
    button:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-ring-offset);
    }

    /* Disabled */
    button:disabled {
      cursor: not-allowed;
      color: var(--muted-foreground);
      background: var(--muted);
      border-color: var(--border);
      box-shadow: none;
      transform: none;
      filter: saturate(0.6);
    }
    :host([variant='ghost']) button:disabled,
    :host([variant='outline']) button:disabled {
      background: transparent;
    }

    /* Loading state — fade the label, overlay a spinner. */
    :host([loading]) button { cursor: progress; }
    :host([loading]) .content { opacity: 0; }
    .content {
      display: inline-flex;
      align-items: center;
      gap: var(--btn-gap);
      transition: opacity var(--duration-fast) var(--ease-out);
    }
    .spinner-wrap {
      position: absolute;
      inset: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .spinner {
      width: var(--icon-size-sm);
      height: var(--icon-size-sm);
      border: 1.5px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: sui-button-spin 0.7s linear infinite;
    }
    @keyframes sui-button-spin { to { transform: rotate(360deg); } }

    /* Icon-only — collapse padding to a square when default slot is empty. */
    :host([data-icon-only]) button {
      padding-inline: 0;
      width: var(--btn-h);
      min-width: var(--btn-h);
    }

    ::slotted([slot='leading']),
    ::slotted([slot='trailing']) {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
    }
  </style>

<button
  part="button"
  type={type()}
  disabled={disabled() || loading()}
  aria-busy={loading() ? 'true' : 'false'}
  aria-disabled={(disabled() || loading()) ? 'true' : 'false'}
  aria-label={label()}
  aria-pressed={pressed()}
  aria-expanded={expanded()}
>
  <span class="content">
    <slot name="leading"></slot>
    <slot reflect-empty="data-icon-only"></slot>
    <slot name="trailing"></slot>
  </span>
  {#if loading()}
    <span class="spinner-wrap" aria-hidden="true"><span class="spinner"></span></span>
  {/if}
</button>
