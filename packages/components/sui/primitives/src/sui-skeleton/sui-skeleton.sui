<!--
  <sui-skeleton> — SUI port of <ship-skeleton>.
  Shimmer placeholder for loading states.

  Prop / event / method parity vs <ship-skeleton>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  variant ('text'|'circle'|        shape ('text'|'line'|    renamed — 'shape'
    'rect', 'text')                  'block'|'circle',      avoids collision
                                     'text', reflect)       with Lit variant
                                                           convention; 'line'
                                                           and 'block' replace
                                                           'text' and 'rect'
                                                           with clearer names
  width (String, '')              OMITTED                 SUI uses size instead
                                                          of arbitrary CSS
                                                          values — constrained
                                                          dimensions match
                                                          common use cases
  height (String, '')             OMITTED                 same reason
  lines (Number, 1)               OMITTED                 multi-line not
                                                          supported; compose
                                                          multiple skeletons
  animated (Boolean, true)        OMITTED                 prefers-reduced-motion
                                                          media query handles it;
                                                          SUI favors CSS over prop
  ─────────────────────────────────────────────────────────────────────────────
  size                            size ('sm'|'md'|'lg',   SUI addition —
    (not in Lit)                    reflect)               constrains height/
                                                           diameter via channel
  ─────────────────────────────────────────────────────────────────────────────
  connectedCallback sets          role/aria attrs on       SUI shadow templates
    role="status" aria-live        inner .sk element       cannot set host
    aria-busy aria-label on host                           attributes without
                                                           a controller; inner
                                                           element is reachable
  ─────────────────────────────────────────────────────────────────────────────
  parts: bar                      part="sk"               renamed
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - This component never declared a `tone` prop and never had a per-component
    <theme> block, so the "tones are GLOBAL" pivot is a no-op here. The
    shimmer gradient reads --muted and --tone-muted-bg; the latter is now
    a global channel set by suiTonesSheet on whatever ancestor sets the
    `tone` attribute (or, with no tone set, on `:host` itself via the
    `default` channel — a neutral muted wash). Behavior preserved.
  - `display: block` and `[hidden]` dropped from :host — framework-owned
    now (BASE_CSS). The host keeps `display: inline-block` and
    `vertical-align: middle` (genuinely non-default — fits a body-text
    inline placeholder).
  - The conditional `display: block` for shape=block moves to <variants>
    (where it belongs — declarative, not residual).
  - The shape/size channel ladder is wholly on <variants part="sk"> —
    radii, widths, heights — all closed-vocab sx pairs.
  - <style> keeps the genuinely off-vocabulary work: the multi-stop
    linear-gradient shimmer (no `bg:linear-gradient()` sx), the @keyframes
    (no animation primitive), the reduce-motion kill switch (motion is
    owned by the framework's global rule, but the @keyframes itself is
    unconditionally animation-driven — the local rule is belt-and-suspenders
    for the specific case the framework's global rule doesn't catch when
    the component is in a shadow root), and the circle-large 48×48
    (no exact 48px token — 40px is --space-8, 36px is --text-4xl, neither
    is the feat/next 48px). LANG-GAP noted below.
  - 48px circle-large is the one raw-value declaration in the skin. It is
    NOT route-around material: the surface has no channel for it, and the
    old spike's `var(--text-4xl)` (=36px) was silently wrong — the feat/next
    baseline is 48px, and the test table checks the part=sk element exists
    but does not assert the dimension, so a 48px raw value in <style> is
    the faithful choice.

  LANG-GAP — circle-large dimension
  ─────────────────────────────────────────────────────────────────────────────
  No 48px token exists (the size scale tops out at --space-9 = 36px and
  --text-4xl = 36px; --control-h-xl = 44px; --space-8 = 40px). The
  component-local channel `--sk-circle-lg: 48px` would be the local-var
  pattern, but with only one consumer and one value, a one-line raw
  declaration in <style> is the boring choice. If a third consumer
  appears, hoist to a shared token; not a L2 framework change.
-->

<component>{
  props: {
    shape: 'text' | 'line' | 'block' | 'circle',
    size: 'sm' | 'md' | 'lg',
  },
}</component>

<variants>
  shape=block: display:block
</variants>

<variants part="sk">
  shape=circle:                 radius:full
  shape=text:                   w:full
  shape=line:                   w:full
  (shape=text, size=sm):        h:2
  (shape=text, size=md):        h:3
  (shape=text, size=lg):        h:4
  (shape=line, size=sm):        h:2
  (shape=line, size=md):        h:3
  (shape=line, size=lg):        h:4
  shape=block:                  w:full
  (shape=circle, size=sm):      w:icon-size-2xl h:icon-size-2xl
  (shape=circle, size=md):      w:7 h:7
</variants>

<!--
  Residual: host baseline (display:inline-block — a real override of the
  framework's :host { display: block } default); the multi-stop shimmer
  gradient (no `bg:linear-gradient()` sx); the @keyframes; the
  reduce-motion kill switch (the global BASE_CSS rule covers most cases
  but the keyframe specifically targets `.sk` here, so the local
  media query is the targeted kill); the circle-large 48×48
  (LANG-GAP above); the block min-height (80px — no matching token,
  off-scale by design).
-->
<style>
  :host { display: inline-block; vertical-align: middle; }

  .sk {
    display: block;
    background: linear-gradient(
      90deg,
      var(--muted) 0%,
      var(--tone-muted-bg) 50%,
      var(--muted) 100%
    );
    background-size: 200% 100%;
    animation: sui-skeleton-shimmer 1.5s ease-in-out infinite;
    border-radius: var(--radius-sm);
  }
  :host([shape='block']) .sk { min-height: 80px; }
  :host([shape='circle'][size='lg']) .sk { width: 48px; height: 48px; }

  @keyframes sui-skeleton-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk { animation: none; }
  }
</style>

<span
  class="sk"
  part="sk"
  role="status"
  aria-label="Loading"
  aria-live="polite"
  aria-busy="true"
></span>
