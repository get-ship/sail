<!--
  <sui-center> — box that centers its child on BOTH axes.

  The host element IS the grid (`display: grid; place-items: center;
  place-content: center`). The slot is a single child of the host that
  flows into the centered grid cell. A `gap` prop (0..8) sets
  var(--center-gap) on the host for when the consumer projects more
  than one child via a wrapper inside the slot.

  The `:host` and per-gap rules are layout (display:grid + place-items
  + gap) — layout primitives' job (the `<center>` keyword lowers a
  child to a centered div, but the host element itself is a custom
  element, not a layout element, so its layout stays in the
  residual block).
-->

<prop name="gap" values="0|1|2|3|4|5|6|7|8" default="0" reflect />

<style>
  /* Residual: `:host` (host element, no sx) is the grid itself, so
   * the display:grid + place-items + place-content + width:100% +
   * --center-gap:0 setup is the host chrome. The per-gap rules are
   * the host's --center-gap channel fill — sx can't read the
   * `gap` prop on the host, and the gap token is a literal that
   * fits the per-value :host selectors more naturally than a
   * <theme>. */
  :host {
    display: grid;
    place-items: center;
    place-content: center;
    gap: var(--center-gap);
    width: 100%;
    --center-gap: 0;
  }
  :host([hidden]) { display: none; }
  :host([gap='0']) { --center-gap: 0; }
  :host([gap='1']) { --center-gap: var(--space-1); }
  :host([gap='2']) { --center-gap: var(--space-2); }
  :host([gap='3']) { --center-gap: var(--space-3); }
  :host([gap='4']) { --center-gap: var(--space-4); }
  :host([gap='5']) { --center-gap: var(--space-5); }
  :host([gap='6']) { --center-gap: var(--space-6); }
  :host([gap='7']) { --center-gap: var(--space-7); }
  :host([gap='8']) { --center-gap: var(--space-8); }
</style>

<slot></slot>
