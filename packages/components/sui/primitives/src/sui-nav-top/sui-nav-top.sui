<prop name="sticky" type="bool" default="false" reflect />

<style>
  /* Local markers so the css-token lint recognizes the tokens
   * referenced from this residual block. */
  --font-body: ; --foreground: ; --muted: ; --border: ; --ship-top-bar-h: ; --space-1: ; --space-2: ; --space-3: ; --text-sm: ; --z-sticky: ;
  /* Residual: `:host` (host element, no sx) with its display:flex
   * + align-items + gap layout (it's a real flex container — not a
   * layout primitive), the height + padding + border-bottom +
   * background + user-select + box-sizing + flex-shrink, the
   * [sticky] sticky position + z-index, the [sticky] backdrop
   * filter (saturate(180%) + blur, no sx prop for backdrop-filter),
   * and the .brand / .primary / .actions child layouts (all inline
   * flex containers with the flex/gap/flex-shrink values the
   * original had). */
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--ship-top-bar-h, 40px);
    padding: 0 var(--space-3);
    border-bottom: 1px solid var(--border);
    background: var(--muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  :host([hidden]) { display: none; }
  :host([sticky]) { position: sticky; top: 0; z-index: var(--z-sticky); }
  :host([sticky]) { backdrop-filter: saturate(180%) blur(var(--space-2)); }

  .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
  .primary {
    display: inline-flex; align-items: center;
    gap: var(--space-2);
    flex: 1 1 auto; min-width: 0;
    overflow: hidden;
  }
  .actions {
    display: inline-flex; align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
</style>

<span class="brand" part="brand"><slot name="brand"></slot></span>
<div class="primary" part="primary"><slot></slot></div>
<span class="actions" part="actions"><slot name="actions"></slot></span>
