<prop name="sticky" type="bool" default="false" reflect />

<!--
  Residual <style> — sui-nav-top is largely irreducible. The host is a
  flex bar that wants display:flex + align-items:center + gap + explicit
  pixel height + border-bottom + background + font-family + user-select
  + box-sizing + flex-shrink; only display + bg + fg are reachable
  from sx via the new host-sx directive — the rest stay. The [sticky]
  variant adds position:sticky + top + z-index + backdrop-filter, none
  of which are sx surface props. The .brand / .primary / .actions
  child zones use raw flex shorthand (flex 1 1 auto, flex-shrink 0,
  min-width 0, overflow hidden) that has no sx equivalent.

  Lifted to host-sx: display:flex + bg:muted + fg:foreground. The
  rest stays as :host residual.

  Local token markers are kept so the css-token lint recognizes the
  tokens referenced from this block.
-->
<host sx="bg:muted fg:foreground" />

<style>
  --font-body: ; --foreground: ; --muted: ; --border: ; --ship-top-bar-h: ; --space-1: ; --space-2: ; --space-3: ; --text-sm: ; --z-sticky: ;
  /* Residual: `:host` flex layout (align-items + gap), height +
   * padding + border-bottom + user-select + box-sizing + flex-shrink
   * (none in sx), the [sticky] sticky position + z-index, the [sticky]
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--ship-top-bar-h, 40px);
    padding: 0 var(--space-3);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    user-select: none;
  }
  :host([hidden]) { display: none; }
  :host([sticky]) { position: sticky; top: 0; z-index: var(--z-sticky); }
  :host([sticky]) { backdrop-filter: saturate(180%) blur(var(--space-2)); }

  .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
  .primary {
    display: inline-flex; align-items: center;
    gap: var(--space-2);
    flex: 1 1 auto; min-width: 0;
    overflow: hidden;
  }
  .actions {
    display: inline-flex; align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
</style>

<span class="brand" part="brand"><slot name="brand"></slot></span>
<div class="primary" part="primary"><slot></slot></div>
<span class="actions" part="actions"><slot name="actions"></slot></span>
