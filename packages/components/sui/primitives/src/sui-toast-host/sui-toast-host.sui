<!--
  <sui-toast-host> — SUI port of <ship-toast-host>.

  Event-driven toast surface. Wraps a <sui-toast-container> and listens
  for `ship:notify` (the contract emitted by `window.ship.notify()`).
  Each event is forwarded to the container's programmatic `show()` API,
  mapping the notify detail shape (`message` / `description` / `tone` /
  `duration` / `actionHtml`) onto the toast-container show shape
  (`title` / `description` / `tone` / `duration` / `actionHtml`).

  Listener target: the closest `<sui-shell>` or `<ship-shell>` ancestor.
  If none is present (test harnesses, standalone use), falls back to
  `document.body` so dispatches that bubble to the document still land.

  Prop / event / method parity vs <ship-toast-host>
  ──────────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ──────────────────────────────────────────────────────────────────────────────
  position (string, 'bottom-right') position (union,         ✓ forwarded onto the
                                     'bottom-right',           inner toast container
                                     reflect)
  ──────────────────────────────────────────────────────────────────────────────
  ship:notify listener on closest   ship:notify listener on  ✓ also matches
    ship-shell                        closest sui-shell |       sui-shell when a
                                     ship-shell, else body     future port lands
  ──────────────────────────────────────────────────────────────────────────────
  Inner: <ship-toast-container>     Inner: <sui-toast-       ✓ swapped to sui port
                                     container>
  ──────────────────────────────────────────────────────────────────────────────
  notify detail → show opts:
    message     → title             ✓                         same mapping
    description → description       ✓                         same mapping
    tone        → tone              ✓                         info|success|
                                                              warning|destructive
    duration    → duration          ✓                         0 = sticky
    actionHtml  → actionHtml        ✓                         same mapping
  ──────────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    position: 'bottom-right' | 'top-left' | 'top-center' | 'top-right' | 'bottom-left' | 'bottom-center',
  },
}</component>
<variants>
  [hidden]: display:none
</variants>

<!-- Residual: the .sui-toast-host { display: contents } declaration — a passthrough
     display value the layout keywords don't express (it's a CSS
     keyword that makes the element's box disappear from layout flow
     while its children participate normally). Sx has no `contents`
     keyword and the varianted [hidden] doesn't cover it. -->
<style>
  .sui-toast-host { display: contents; }
</style>


<controller>
import { controller } from '@ship/sui-runtime'
import type { Scope } from './sui-toast-host.sui'

type NotifyTone = 'info' | 'success' | 'warning' | 'destructive'

interface NotifyDetail {
  message?: string
  description?: string
  tone?: NotifyTone
  duration?: number
  actionHtml?: string
}

interface ToastContainerLike extends HTMLElement {
  show(opts: {
    tone?: string
    duration?: number
    title?: string
    description?: string
    actionHtml?: string
  }): HTMLElement
}

export default controller<Scope>({
  mount(state, host) {

    const onNotify = (e: Event): void => {
      const detail = ((e as CustomEvent).detail ?? {}) as NotifyDetail
      const container = state.$signals.containerEl() as ToastContainerLike | null
      if (!container || typeof container.show !== 'function') return
      // exactOptionalPropertyTypes: omit keys whose value is undefined
      // so the object type matches `{ tone?: string; ... }` (no
      // `tone: undefined`).
      const opts: { tone?: string; duration?: number; title?: string; description?: string; actionHtml?: string } = {}
      if (detail.tone !== undefined) opts.tone = detail.tone as string
      if (detail.duration !== undefined) opts.duration = detail.duration
      if (detail.message !== undefined) opts.title = detail.message as string
      if (detail.description !== undefined) opts.description = detail.description as string
      if (detail.actionHtml !== undefined) opts.actionHtml = detail.actionHtml as string
      container.show(opts)
    }

    const target: EventTarget =
      host.closest('sui-shell, ship-shell') ??
      host.ownerDocument?.body ??
      host
    target.addEventListener('ship:notify', onNotify)

    return () => {
      target.removeEventListener('ship:notify', onNotify)
    }
  },
})

</controller>
<sui-toast-container position={position()} bind:this={containerEl}></sui-toast-container>
