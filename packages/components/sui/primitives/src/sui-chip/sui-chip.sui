<!--
  <sui-chip> — SUI port of <ship-chip>.
  Interactive filter/selection pill. Host IS the interactive surface:
  role=button + keyboard activation via paired controller.

  Prop / event / method parity vs <ship-chip>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'muted')         tone (union, 'muted',    ✓ default changed from
                                 reflect)                muted for SUI catalog
                                                         consistency
  variant (null|'solid'|       variant (solid|soft|     ✓ SUI adds ghost;
    'soft'|'outline')            outline|ghost, 'soft',  'soft' is the explicit
                                 reflect)                 default (Lit uses null)
  size ('sm'|'md'|'lg',        size (sm|md|lg, 'sm',   ✓ sm is Ship filter-
    'md')                        reflect)                rail default
  selected (Boolean, false)    selected (bool, false,   ✓ aria-pressed managed
                                 reflect)                by controller
  removable (Boolean, false)   removable (bool, false,  ✓ × button rendered;
                                 reflect)                ship-remove dispatched
                                                         by controller
  disabled (Boolean, false)    disabled (bool, false,   ✓ aria-disabled +
                                 reflect)                tabindex managed by
                                                         controller
  ─────────────────────────────────────────────────────────────────────────────
  Events: ship-remove          ship-remove              ✓ dispatched by
    (bubbles, composed)          (bubbles, composed)      controller on × click
                                                         or Backspace/Delete
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space →      ✓ controller handles     ✓
    host.click(); Backspace/
    Delete → ship-remove
  role=button, tabindex=0      ✓ controller sets on     ✓
    set on host                  mount
  aria-pressed, aria-disabled  ✓ controller syncs       ✓
    set reactively               reactively
  ─────────────────────────────────────────────────────────────────────────────
  slots: leading, default      slots: leading, default  ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: chip, leading, remove parts: chip, leading,    ✓
                                 remove
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="solid|soft|outline|ghost" default="soft" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="selected" type="bool" default="false" reflect />
<prop name="removable" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    -webkit-tap-highlight-color: transparent;
    /* chip- size channels: md is the base (default size); sm/lg override
     * below via :host([size]) rules. radius is constant across sizes. */
    --chip-h: var(--control-h-xs);
    --chip-px: var(--space-2_5);
    --chip-fs: var(--text-sm);
    --chip-gap: var(--space-1_5);
    --chip-icon: var(--icon-size-xs);
    --chip-remove: var(--icon-size-md);
    --chip-radius: var(--radius-full);
    --chip-remove-ml: var(--space-1);
    --chip-remove-mr: calc(var(--space-1) * -1);
    /* tone- channels: this base :host is the `default` tone row; the
     * per-tone overrides live in the :host([tone]) rules below (was a
     * <theme prop="tone"> block). The chip carries a rich 10-channel
     * tone vocabulary — solid fill, soft fill, outline, ghost, hover,
     * contrast — that the global framework tone channel doesn't cover,
     * so it owns them locally. */
    --tone-fg: var(--foreground);
    --tone-bg: var(--tone-default-bg);
    --tone-border: var(--tone-default-border);
    --tone-bg-hover: var(--tone-default-bg);
    --tone-border-hover: var(--tone-default-border);
    --tone-bg-solid: var(--foreground);
    --tone-outline-border: var(--border-strong);
    --tone-outline-bg-hover: var(--hover-bg);
    --tone-ghost-bg-hover: var(--hover-bg);
    --tone-contrast: var(--background);
  }
  :host([hidden]) { display: none; }

  /* Size overrides (md is the base above). */
  :host([size='sm']) {
    --chip-h: var(--control-h-2xs); --chip-px: var(--space-2);   --chip-fs: var(--text-xs);
    --chip-gap: var(--space-1);     --chip-icon: var(--icon-size-2xs); --chip-remove: var(--icon-size-sm);
  }
  :host([size='lg']) {
    --chip-h: var(--control-h-md);  --chip-px: var(--space-3);   --chip-fs: var(--text-base);
    --chip-gap: var(--space-1_5);   --chip-icon: var(--icon-size-sm);  --chip-remove: var(--icon-size-lg);
  }

  /* Tone overrides (default is the base above). Channel order:
     fg, bg, border, bg-hover, border-hover, bg-solid, outline-border,
     outline-bg-hover, ghost-bg-hover, contrast. */
  :host([tone='primary']) {
    --tone-fg: var(--primary); --tone-bg: var(--tone-primary-bg); --tone-border: var(--tone-primary-border);
    --tone-bg-hover: var(--tone-primary-border); --tone-border-hover: var(--tone-primary-border);
    --tone-bg-solid: var(--primary); --tone-outline-border: var(--tone-primary-border);
    --tone-outline-bg-hover: var(--tone-primary-bg); --tone-ghost-bg-hover: var(--tone-primary-bg);
    --tone-contrast: var(--primary-foreground);
  }
  :host([tone='info']) {
    --tone-fg: var(--info); --tone-bg: var(--tone-info-bg); --tone-border: var(--tone-info-border);
    --tone-bg-hover: var(--tone-info-border); --tone-border-hover: var(--tone-info-border);
    --tone-bg-solid: var(--info); --tone-outline-border: var(--tone-info-border);
    --tone-outline-bg-hover: var(--tone-info-bg); --tone-ghost-bg-hover: var(--tone-info-bg);
    --tone-contrast: var(--info-foreground);
  }
  :host([tone='success']) {
    --tone-fg: var(--success); --tone-bg: var(--tone-success-bg); --tone-border: var(--tone-success-border);
    --tone-bg-hover: var(--tone-success-border); --tone-border-hover: var(--tone-success-border);
    --tone-bg-solid: var(--success); --tone-outline-border: var(--tone-success-border);
    --tone-outline-bg-hover: var(--tone-success-bg); --tone-ghost-bg-hover: var(--tone-success-bg);
    --tone-contrast: var(--success-foreground);
  }
  :host([tone='warning']) {
    --tone-fg: var(--warning); --tone-bg: var(--tone-warning-bg); --tone-border: var(--tone-warning-border);
    --tone-bg-hover: var(--tone-warning-border); --tone-border-hover: var(--tone-warning-border);
    --tone-bg-solid: var(--warning); --tone-outline-border: var(--tone-warning-border);
    --tone-outline-bg-hover: var(--tone-warning-bg); --tone-ghost-bg-hover: var(--tone-warning-bg);
    --tone-contrast: var(--warning-foreground);
  }
  :host([tone='destructive']) {
    --tone-fg: var(--destructive); --tone-bg: var(--tone-destructive-bg); --tone-border: var(--tone-destructive-border);
    --tone-bg-hover: var(--tone-destructive-border); --tone-border-hover: var(--tone-destructive-border);
    --tone-bg-solid: var(--destructive); --tone-outline-border: var(--tone-destructive-border);
    --tone-outline-bg-hover: var(--tone-destructive-bg); --tone-ghost-bg-hover: var(--tone-destructive-bg);
    --tone-contrast: var(--destructive-foreground);
  }
  :host([tone='muted']) {
    --tone-fg: var(--muted-foreground); --tone-bg: var(--tone-muted-bg); --tone-border: var(--tone-muted-border);
    --tone-bg-hover: var(--tone-muted-bg); --tone-border-hover: var(--tone-muted-border);
    --tone-bg-solid: var(--muted); --tone-outline-border: var(--border-strong);
    --tone-outline-bg-hover: var(--tone-muted-bg); --tone-ghost-bg-hover: var(--tone-muted-bg);
    --tone-contrast: var(--background);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--chip-gap);
    min-height: var(--chip-h);
    padding: 0 var(--chip-px);
    font-family: var(--font-body);
    font-size: var(--chip-fs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    color: var(--tone-fg);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--chip-radius);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  :host(:not([variant])) .chip,
  :host([variant='soft']) .chip {
    background: var(--tone-bg);
    border-color: var(--tone-border);
  }
  :host([variant='soft']:not([disabled])) .chip:hover {
    background: var(--tone-bg-hover);
    border-color: var(--tone-border-hover);
  }
  :host([variant='outline']) .chip {
    background: transparent;
    border-color: var(--tone-outline-border);
  }
  :host([variant='outline']:not([disabled])) .chip:hover {
    background: var(--tone-outline-bg-hover);
  }
  :host([variant='solid']) .chip {
    background: var(--tone-bg-solid);
    border-color: var(--tone-border);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 var(--hover-bg);
  }
  :host([variant='ghost']) .chip {
    background: transparent;
    border-color: transparent;
  }
  :host([variant='ghost']:not([disabled])) .chip:hover {
    background: var(--tone-ghost-bg-hover);
  }

  :host([selected]) .chip {
    background: var(--tone-bg-solid);
    border-color: var(--tone-border);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 var(--hover-bg);
    font-weight: var(--font-weight-semibold);
  }
  :host([selected]:not([disabled])) .chip:hover {
    background: var(--tone-bg-hover);
  }
  /* Selected without a tone (or with the catalog "muted" tone — the
   * unbranded baseline) inherits the brand. Material's filter chips
   * fill primary, shadcn's go with primary, GitHub uses accent — Ship
   * leans on the same convention so a row of selected filters reads
   * as branded emphasis, not monochrome ink. Authors who want the old
   * raw-foreground fill set tone='default' explicitly. */
  :host([selected]:not([tone])) .chip,
  :host([selected][tone='muted']) .chip {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }
  :host([selected][tone='default']) .chip {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }

  /* Keyboard-only focus ring — host carries focus (role=button,
   * tabindex=0 from controller). Consume the canonical --focus-ring
   * token; the old stacked outline+box-shadow halo was tone-tinted
   * and visibly snapped against the button/input rings during tab
   * sequences. */
  :host(:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--chip-radius);
  }
  :host([disabled]:focus-visible) { outline: none; }

  :host([disabled]) .chip {
    cursor: not-allowed;
    background: var(--muted);
    border-color: var(--border-subtle);
    color: var(--muted-foreground);
    filter: saturate(0.65);
    box-shadow: none;
  }

  .leading {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--chip-icon);
    height: var(--chip-icon);
    flex-shrink: 0;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }
  ::slotted([slot='leading']) {
    display: inline-flex;
    align-items: center;
    color: currentColor;
    width: 100%;
    height: 100%;
  }

  .remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--chip-remove);
    height: var(--chip-remove);
    margin-inline: var(--chip-remove-ml) var(--chip-remove-mr);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .remove svg {
    width: 70%;
    height: 70%;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .remove:hover:not(:disabled) {
    background: var(--hover-bg);
  }
  :host([disabled]) .remove { cursor: not-allowed; }

  @media (forced-colors: active) {
    .chip { border-color: CanvasText; color: CanvasText; }
    :host([selected]) .chip { background: Highlight; color: HighlightText; border-color: Highlight; }
    :host(:focus-visible) .chip { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-chip.sui'

export default controller<Scope>({
  mount(state, host: HTMLElement) {

    if (!host.hasAttribute('role')) host.setAttribute('role', 'button')
    if (!host.hasAttribute('tabindex') && !state.disabled) {
      host.setAttribute('tabindex', '0')
    }

    const stopSync = effect(() => {
      const sel = state.selected
      const dis = state.disabled
      host.setAttribute('aria-pressed', sel ? 'true' : 'false')
      if (dis) {
        host.setAttribute('aria-disabled', 'true')
        if (host.getAttribute('tabindex') !== '-1') host.setAttribute('tabindex', '-1')
      } else {
        host.removeAttribute('aria-disabled')
        if (host.getAttribute('tabindex') === '-1') host.setAttribute('tabindex', '0')
      }
    })

    const onKeydown = (e: KeyboardEvent) => {
      if (state.disabled) return
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        host.click()
      } else if (state.removable && (e.key === 'Backspace' || e.key === 'Delete')) {
        e.preventDefault()
        host.dispatchEvent(new CustomEvent('ship-remove', { detail: {}, bubbles: true, composed: true }))
      }
    }
    host.addEventListener('keydown', onKeydown)

    const stopRemoveBtn = effect(() => {
      const btn = state.removeBtn as HTMLElement | null
      if (!btn) return
      const onClick = (e: MouseEvent) => {
        e.stopPropagation()
        if (state.disabled) return
        host.dispatchEvent(new CustomEvent('ship-remove', { detail: {}, bubbles: true, composed: true }))
      }
      btn.addEventListener('click', onClick)
      return () => btn.removeEventListener('click', onClick)
    })

    return () => {
      stopSync()
      host.removeEventListener('keydown', onKeydown)
      stopRemoveBtn()
    }
  },
})

</controller>
<span class="chip" part="chip">
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
  {#if removable()}
    <button class="remove" part="remove" type="button"
            aria-label="Remove" tabindex="-1"
            bind:this={removeBtn}>
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 2 L8 8 M8 2 L2 8" />
      </svg>
    </button>
  {/if}
</span>
