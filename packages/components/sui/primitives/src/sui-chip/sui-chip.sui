<!--
  <sui-chip> — SUI port of <ship-chip>.
  Interactive filter/selection pill. Host IS the interactive surface:
  role=button + keyboard activation via paired controller.

  Prop / event / method parity vs <ship-chip>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'muted')         tone (union, 'muted',    ✓ default changed from
                                 reflect)                muted for SUI catalog
                                                         consistency
  variant (null|'solid'|       variant (solid|soft|     ✓ SUI adds ghost;
    'soft'|'outline')            outline|ghost, 'soft',  'soft' is the explicit
                                 reflect)                 default (Lit uses null)
  size ('sm'|'md'|'lg',        size (sm|md|lg, 'sm',   ✓ sm is Ship filter-
    'md')                        reflect)                rail default
  selected (Boolean, false)    selected (bool, false,   ✓ aria-pressed managed
                                 reflect)                by controller
  removable (Boolean, false)   removable (bool, false,  ✓ × button rendered;
                                 reflect)                ship-remove dispatched
                                                         by controller
  disabled (Boolean, false)    disabled (bool, false,   ✓ aria-disabled +
                                 reflect)                tabindex managed by
                                                         controller
  ─────────────────────────────────────────────────────────────────────────────
  Events: ship-remove          ship-remove              ✓ dispatched by
    (bubbles, composed)          (bubbles, composed)      controller on × click
                                                         or Backspace/Delete
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space →      ✓ controller handles     ✓
    host.click(); Backspace/
    Delete → ship-remove
  role=button, tabindex=0      ✓ controller sets on     ✓
    set on host                  mount
  aria-pressed, aria-disabled  ✓ controller syncs       ✓
    set reactively               reactively
  ─────────────────────────────────────────────────────────────────────────────
  slots: leading, default      slots: leading, default  ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: chip, leading, remove parts: chip, leading,    ✓
                                 remove
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="solid|soft|outline|ghost" default="soft" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="selected" type="bool" default="false" reflect />
<prop name="removable" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<theme prop="size" channels="chip-h, chip-px, chip-fs, chip-gap, chip-icon, chip-remove, chip-radius">
  sm: control-h-2xs, space-2, text-xs, space-1, icon-size-2xs, icon-size-sm, radius-full
  md: control-h-xs,  space-2_5, text-sm, space-1_5, icon-size-xs, icon-size-md, radius-full
  lg: control-h-md,  space-3, text-base, space-1_5, icon-size-sm, icon-size-lg, radius-full
</theme>

<theme prop="tone" channels="tone-fg, tone-bg, tone-border, tone-bg-hover, tone-border-hover, tone-bg-solid, tone-outline-border, tone-outline-bg-hover, tone-ghost-bg-hover, tone-contrast">
  default:     foreground, tone-default-bg, tone-default-border, tone-default-bg, tone-default-border, foreground, border-strong, hover-bg, hover-bg, background
  primary:     primary,     tone-primary-bg, tone-primary-border, tone-primary-border, tone-primary-border, primary, tone-primary-border, tone-primary-bg, tone-primary-bg, primary-foreground
  info:        info,        tone-info-bg, tone-info-border, tone-info-border, tone-info-border, info, tone-info-border, tone-info-bg, tone-info-bg, info-foreground
  success:     success,     tone-success-bg, tone-success-border, tone-success-border, tone-success-border, success, tone-success-border, tone-success-bg, tone-success-bg, success-foreground
  warning:     warning,     tone-warning-bg, tone-warning-border, tone-warning-border, tone-warning-border, warning, tone-warning-border, tone-warning-bg, tone-warning-bg, warning-foreground
  destructive: destructive, tone-destructive-bg, tone-destructive-border, tone-destructive-border, tone-destructive-border, destructive, tone-destructive-border, tone-destructive-bg, tone-destructive-bg, destructive-foreground
  muted:       muted-foreground, tone-muted-bg, tone-muted-border, tone-muted-bg, tone-muted-border, muted, border-strong, tone-muted-bg, tone-muted-bg, background
</theme>

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    -webkit-tap-highlight-color: transparent;
    /* chip- prefix locals — the <theme prop="size"> block overrides
     * them per size; they are also declared here so the css_token
     * lint resolves the references in .chip, .leading, .remove
     * (the lint does not see <theme> blocks). */
    --chip-h: var(--control-h-2xs);
    --chip-px: var(--space-2);
    --chip-fs: var(--text-xs);
    --chip-gap: var(--space-1);
    --chip-icon: var(--icon-size-2xs);
    --chip-remove: var(--icon-size-sm);
    --chip-radius: var(--radius-full);
    --chip-remove-ml: var(--space-1);
    --chip-remove-mr: calc(var(--space-1) * -1);
    /* The tone- prefix defaults live in the <theme prop="tone">
     * default row (the bare :host fills there). They were dropped
     * from this block because the residual comes AFTER the
     * theme-generated CSS in the cascade, so leaving them here
     * would override the theme's default row with the prior muted
     * values. The css_token lint is happy because the references
     * further down are channel references; the <theme> declaration
     * is the canonical source for the channel names. */
    --tone-fg: var(--foreground);
    --tone-bg: var(--tone-default-bg);
    --tone-border: var(--tone-default-border);
    --tone-bg-hover: var(--tone-default-bg);
    --tone-border-hover: var(--tone-default-border);
    --tone-bg-solid: var(--foreground);
    --tone-outline-border: var(--border-strong);
    --tone-outline-bg-hover: var(--hover-bg);
    --tone-ghost-bg-hover: var(--hover-bg);
    --tone-contrast: var(--background);
  }
  :host([hidden]) { display: none; }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--chip-gap);
    min-height: var(--chip-h);
    padding: 0 var(--chip-px);
    font-family: var(--font-body);
    font-size: var(--chip-fs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    color: var(--tone-fg);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--chip-radius);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  :host(:not([variant])) .chip,
  :host([variant='soft']) .chip {
    background: var(--tone-bg);
    border-color: var(--tone-border);
  }
  :host([variant='soft']:not([disabled])) .chip:hover {
    background: var(--tone-bg-hover);
    border-color: var(--tone-border-hover);
  }
  :host([variant='outline']) .chip {
    background: transparent;
    border-color: var(--tone-outline-border);
  }
  :host([variant='outline']:not([disabled])) .chip:hover {
    background: var(--tone-outline-bg-hover);
  }
  :host([variant='solid']) .chip {
    background: var(--tone-bg-solid);
    border-color: var(--tone-border);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 var(--hover-bg);
  }
  :host([variant='ghost']) .chip {
    background: transparent;
    border-color: transparent;
  }
  :host([variant='ghost']:not([disabled])) .chip:hover {
    background: var(--tone-ghost-bg-hover);
  }

  :host([selected]) .chip {
    background: var(--tone-bg-solid);
    border-color: var(--tone-border);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 var(--hover-bg);
    font-weight: var(--font-weight-semibold);
  }
  :host([selected]:not([disabled])) .chip:hover {
    background: var(--tone-bg-hover);
  }
  /* Selected without a tone (or with the catalog "muted" tone — the
   * unbranded baseline) inherits the brand. Material's filter chips
   * fill primary, shadcn's go with primary, GitHub uses accent — Ship
   * leans on the same convention so a row of selected filters reads
   * as branded emphasis, not monochrome ink. Authors who want the old
   * raw-foreground fill set tone='default' explicitly. */
  :host([selected]:not([tone])) .chip,
  :host([selected][tone='muted']) .chip {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }
  :host([selected][tone='default']) .chip {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }

  /* Keyboard-only focus ring — host carries focus (role=button,
   * tabindex=0 from controller). Consume the canonical --focus-ring
   * token; the old stacked outline+box-shadow halo was tone-tinted
   * and visibly snapped against the button/input rings during tab
   * sequences. */
  :host(:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--chip-radius);
  }
  :host([disabled]:focus-visible) { outline: none; }

  :host([disabled]) .chip {
    cursor: not-allowed;
    background: var(--muted);
    border-color: var(--border-subtle);
    color: var(--muted-foreground);
    filter: saturate(0.65);
    box-shadow: none;
  }

  .leading {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--chip-icon);
    height: var(--chip-icon);
    flex-shrink: 0;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }
  ::slotted([slot='leading']) {
    display: inline-flex;
    align-items: center;
    color: currentColor;
    width: 100%;
    height: 100%;
  }

  .remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--chip-remove);
    height: var(--chip-remove);
    margin-inline: var(--chip-remove-ml) var(--chip-remove-mr);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .remove svg {
    width: 70%;
    height: 70%;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .remove:hover:not(:disabled) {
    background: var(--hover-bg);
  }
  :host([disabled]) .remove { cursor: not-allowed; }

  @media (forced-colors: active) {
    .chip { border-color: CanvasText; color: CanvasText; }
    :host([selected]) .chip { background: Highlight; color: HighlightText; border-color: Highlight; }
    :host(:focus-visible) .chip { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<span class="chip" part="chip">
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
  {#if removable()}
    <button class="remove" part="remove" type="button"
            aria-label="Remove" tabindex="-1"
            bind:this={removeBtn}>
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 2 L8 8 M8 2 L2 8" />
      </svg>
    </button>
  {/if}
</span>
