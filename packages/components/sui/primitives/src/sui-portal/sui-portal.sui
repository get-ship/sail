<!--
  <sui-portal> — teleport its slotted children into a different DOM
  location for stacking-context escape (modals, dropdowns, popovers,
  toasts). Same model as React's createPortal: the portal element
  remains the logical parent for reactivity and event bubbling, while
  the physical nodes live under `target`.

  Surface:
    - target (string, default "body") — CSS selector resolved against
      `document`. Common: "body", "#modal-root", "[data-portal-root]".
    - Default slot — children get teleported on mount and on every
      slotchange. Removed from `target` on unmount.

  Behavior:
    - Missing target → console.warn, children stay in light DOM
      (graceful degradation, no throw).
    - target attribute change → previously moved nodes are migrated
      from the old target to the new one.
    - Events from moved children bubble through the portal's original
      DOM ancestry, not the target's — listen on the portal (or any
      light-DOM ancestor) to catch them.
    - Multiple portals to the same target append in registration order.
      Z-index management is the author's responsibility.
-->

<prop name="target" type="string" default="body" />

<!--
  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - portal has no tone/size. No <theme> block, no per-component
    :host([tone='…']) or :host([size='…']) redeclaration. The
    framework's global tone/size channels are irrelevant — the
    portal element renders nothing in its own box.
  - The :host display:none is the only surface authoring, and it
    stays in <style> because sx/theme/variants can't reach a bare
    :host display rule. The comment block in <style> above the
    rule already documents the irreducible case.
  - The teleportation is in the controller (mount/cleanup), not in
    the template — this is a behavioral primitive, not a styled one.
    Test selectors assert parent-of teleported nodes (document.body,
    a custom sink) and the light-DOM parent's querySelector returning
    null post-teleport; no class- or part-based anatomy to migrate.
  - No L1 controls involved (the slot is content-only; the host
    has no chrome).
-->


<style>
  /* Host is invisible — slotted children are physically teleported under
     `target`; rendering them in the host's own box would double-render in
     the original location. Bare `:host { display: none }` cannot be
     expressed via the sx/theme/variants constructs (those emit a class on
     a real element or a `:host([prop])` channel). */
  :host { display: none; }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-portal.sui'

export default controller<Scope>({
  mount(state, host) {

    const movedNodes: Node[] = []
    let currentTarget: Element | null = null

    const resolveTarget = (): Element | null => {
      const selector = state.$signals.target() || 'body'
      const el = document.querySelector(selector)
      if (!el) {
        console.warn(`[sui-portal] target "${selector}" not found in document`)
        return null
      }
      return el
    }

    const teleportFromHost = (target: Element) => {
      // Pull every light-DOM child of the portal element into the target.
      // appendChild moves the node (no clone), so it leaves the host's
      // light DOM in the same tick — slotchange will fire async, but the
      // listener is idempotent and only acts on nodes we haven't moved.
      const slot = state.$signals.portalSlot() as HTMLSlotElement | null
      const sources = slot ? slot.assignedNodes() : Array.from(host.childNodes)
      for (const node of sources) {
        target.appendChild(node)
        if (!movedNodes.includes(node)) movedNodes.push(node)
      }
    }

    const retargetAll = (next: Element) => {
      for (const node of movedNodes) next.appendChild(node)
    }

    const removeAll = () => {
      for (const node of movedNodes) {
        if (node.parentNode) node.parentNode.removeChild(node)
      }
      movedNodes.length = 0
    }

    const stopTargetEffect = effect(() => {
      const next = resolveTarget()
      if (!next) {
        currentTarget = null
        return
      }
      if (currentTarget === null) {
        teleportFromHost(next)
      } else if (currentTarget !== next) {
        retargetAll(next)
      }
      currentTarget = next
    })

    const slot = state.$signals.portalSlot() as HTMLSlotElement | null
    const onSlotChange = () => {
      if (!currentTarget || !slot) return
      // Any newly slotted nodes (post-mount appends to host's light DOM)
      // get pulled into the current target. Already-moved nodes have
      // left light DOM and won't show up in assignedNodes() again.
      for (const node of slot.assignedNodes()) {
        if (!movedNodes.includes(node)) {
          currentTarget.appendChild(node)
          movedNodes.push(node)
        }
      }
    }
    if (slot) slot.addEventListener('slotchange', onSlotChange)

    return () => {
      stopTargetEffect()
      if (slot) slot.removeEventListener('slotchange', onSlotChange)
      removeAll()
    }
  },
})

</controller>
<slot bind:this={portalSlot}></slot>
