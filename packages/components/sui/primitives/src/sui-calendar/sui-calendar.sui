<!--
  <sui-calendar> — month / week / day calendar surface (Slice 2, the VIEW).
  Pure-framework component over the COMMITTED headless engine
  (`./engine/createCalendar`), which owns all reactive state + view-model
  (monthCells / dayColumns / timeSlots / agenda / selection / navigation). The
  engine arrives via `prop:calendar` IDENTITY; `events`/`focus-date` (type=string)
  are the SSR/declarative fallback (JSON.parse in the controller — `type="json"`
  does NOT compile). All emits go through host.emit! (see controller).

  A11y: month grid is a FIXED 6×7 role=grid/row/gridcell tree (never virtualized
  → NO windowed-count ARIA); event chips are role=button DESCENDANTS inside a
  gridcell; today → aria-current="date". Density: NO density/dense prop — rows
  read the --density-* channel off <html data-density>.

  Range selection (range-mode date|datetime): pointer drag across month-grid day
  cells, or Shift+Arrow from the focus anchor, sets the engine `range` signal and
  emits sui-range-change. Drag-to-create (empty time slot → sui-event-create-intent)
  and drag-to-move (timed chip → sui-event-move) ride a background slot grid that
  carries data-iso + data-minutes so the pointer→time map is element-addressed.
  The virtualized agenda remains an explicit GAP.
-->

<prop name="view" values="month|week|day" default="month" reflect />
<prop name="events" type="string" default="" />
<prop name="focus-date" type="string" default="" />
<prop name="week-starts-on" type="number" default="0" />
<prop name="slot-minutes" type="number" default="30" />
<prop name="day-start-hour" type="number" default="0" reflect />
<prop name="day-end-hour" type="number" default="24" reflect />
<prop name="range-mode" values="none|date|datetime" default="none" reflect />
<prop name="editable" type="bool" default="false" reflect />
<prop name="label" type="string" default="" />

<variants>
  view=month: display:block
  view=week:  display:grid
  view=day:   display:grid
  [hidden]:   display:none
</variants>
<variants part="grid">
  view=month: display:block
</variants>
<variants part="time-grid">
  view=week: display:grid
  view=day:  display:grid
</variants>

<!-- Residual style (small) — see commit body. The HTML comment above does
     NOT use the literal `<style>` tag, so the css-token lint's
     scan_style_blocks doesn't pick this comment up as a style block. -->
<style>
/* Residual (small): file-local sub-scale CSS custom properties on host;
   fixed 7-column grid for the month view; descendant aria-selected rules;
   chip ::before dot; border-bottom/right hairlines; flex on title and
   slot-layer/slot-bg; text-align on dow/empty. */
  :host {
    --cal-gap-xs: var(--space-half);
    --cal-chip-py: var(--space-half);
    --cal-chip-px: var(--space-1_5);
  }
  .dow-row,
  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .day-cols { display: grid; }
  .chip[aria-selected='true'],
  .timed-chip[aria-selected='true'] {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }
  .timed-chip[aria-selected='true'] { outline-offset: -1px; }
  .chip::before {
    content: '';
    position: absolute;
    left: var(--space-half);
    top: 50%;
    transform: translateY(-50%);
    width: var(--space-half);
    min-height: 12px;
    border-radius: var(--radius-sm);
    background: var(--primary);
  }
  .chip.allday::before { background: var(--accent); }
  .toolbar { border-bottom: 1px solid var(--border); }
  .time-axis,
  .cell,
  .day-col { border-right: 1px solid var(--border); }
  .cell,
  .dow,
  .slot,
  .slot-bg { border-bottom: 1px solid var(--border); }
  .dow,
  .empty { text-align: center; }
  .title { flex: 1; }
  .slot-layer { inset: 0; }
  .slot-bg { flex: 1 0 var(--control-h-md); }
  .timegrid { grid-template-columns: auto 1fr; }
  .tb {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font: inherit;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .tb:hover { background: var(--hover-bg); }
  .tb[aria-pressed='true'] {
    background: var(--selected-bg);
    font-weight: var(--font-weight-semibold);
  }
  .cell.out { color: var(--muted-foreground); background: var(--muted); }
  .cell.weekend { background: var(--tone-muted-bg); }
  .cell.in-range { background: var(--selected-bg); }
  .cell .daynum {
    font-size: var(--density-text);
    align-self: flex-start;
    min-width: var(--control-h-2xs);
    height: var(--control-h-2xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
  }
  .cell.today .daynum {
    box-shadow: inset 0 0 0 var(--space-half) var(--primary);
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
  }
  .chip {
    position: relative;
    appearance: none;
    border: 0;
    text-align: start;
    cursor: pointer;
    font: inherit;
    font-size: var(--density-text);
    color: var(--foreground);
    background: var(--tone-primary-bg);
    border-radius: var(--radius-sm);
    padding: var(--cal-chip-py) var(--cal-chip-px);
    padding-left: calc(var(--cal-chip-px) + var(--space-2));
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .chip.allday { background: var(--tone-accent-bg); }
  .overflow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    padding: 0 var(--space-1);
  }
  .day-col.today { background: var(--selected-bg); }
  .allday-zone:empty { display: none; }
  .timed-chip {
    position: absolute;
    left: var(--cal-gap-xs);
    right: var(--cal-gap-xs);
    cursor: pointer;
    border: 0;
    text-align: start;
    font: inherit;
    font-size: var(--density-text);
    color: var(--tone-primary-fg);
    background: var(--tone-primary-bg);
    border-radius: var(--radius-sm);
    padding: var(--cal-chip-py) var(--space-1);
    overflow: hidden;
  }
</style>

<div class="cal" part="wrap"
     sx="display:block bg:background fg:foreground border:border radius:lg shadow:xs overflow:hidden"
>
  <row class="toolbar" part="toolbar" align="center" gap="3"
       sx="py:2 px:3"
  >
    <row class="nav-group" part="nav-group" gap="1" align="center">
      <button type="button" class="tb" data-nav="prev" aria-label="Previous">‹</button>
      <button type="button" class="tb" data-nav="today">Today</button>
      <button type="button" class="tb" data-nav="next" aria-label="Next">›</button>
    </row>
    <span class="title" part="title" sx="weight:semibold">{title()}</span>
    <row class="view-switch" part="view-switch" role="group" aria-label="Calendar view" gap="1" align="center">
      <button type="button" class="tb" data-view="month" aria-pressed={isMonth() ? 'true' : 'false'}>Month</button>
      <button type="button" class="tb" data-view="week" aria-pressed={isWeek() ? 'true' : 'false'}>Week</button>
      <button type="button" class="tb" data-view="day" aria-pressed={isDay() ? 'true' : 'false'}>Day</button>
    </row>
  </row>

  {#if isEmpty()}
    <div class="empty" part="empty" role="status" sx="p:6 px:3 fg:muted-foreground">
      <slot name="empty">No events</slot>
    </div>
  {/if}

  <div class="grid" part="grid" role="grid" aria-label={label() || 'Calendar month'}
       sx="display:none"
  >
    <div class="dow-row" role="presentation">
      {#for d of weekdays() key={d.key}}
        <span class="dow" part="dow" role="columnheader" sx="p:2 fg:muted-foreground weight:medium text:base">{d.label}</span>
      {/for}
    </div>
    {#for wk of weekRows() key={wk.key}}
      <div class="week" role="row">
        {#for cr of wk.cells key={cr.key}}
          <column
            class="cell"
            role="gridcell"
            data-iso={cr.cell.iso}
            tabindex={cr.cell.iso === focusedIso() ? '0' : '-1'}
            class:out={!cr.cell.inMonth}
            class:today={cr.cell.today}
            class:weekend={cr.cell.isWeekend}
            class:in-range={cr.inRange}
            aria-current={cr.cell.today ? 'date' : null}
            aria-label={cr.cell.iso}
            gap="1"
            sx="min-h:9 py:2 px:3"
          >
            <span class="daynum">{cr.cell.day}</span>
            {#for ev of cr.cell.events key={ev.id}}
              <button
                type="button"
                class="chip"
                data-event-id={ev.id}
                class:allday={ev.allDay}
                aria-selected={selectedIds().includes(ev.id) ? 'true' : 'false'}
                title={ev.title}
              >{ev.title}</button>
            {/for}
            {#if cr.cell.overflowCount > 0}
              <span class="overflow">+{cr.cell.overflowCount} more</span>
            {/if}
          </column>
        {/for}
      </div>
    {/for}
  </div>

  <div class="timegrid" part="time-grid" role="grid" aria-label={label() || 'Calendar time grid'}
       sx="display:none"
  >
    <column class="time-axis" part="time-axis" role="rowgroup" gap="0">
      {#for slot of timeSlots() key={slot.key}}
        <div class="slot" data-slot={slot.minutes} role="rowheader" sx="h:control-h-md p:0 px:3 text:base fg:muted-foreground">{slot.label}</div>
      {/for}
    </column>
    <div class="day-cols" part="day-col">
      {#for dc of dayColumns() key={dc.key}}
        <div class="day-col" class:today={dc.col.today} data-iso={dc.col.iso} sx="position:relative min-h:9">
          <column class="slot-layer" part="slot-layer" gap="0" sx="position:absolute">
            {#for slot of timeSlots() key={slot.key}}
              <div class="slot-bg" data-iso={dc.col.iso} data-minutes={slot.minutes} sx="cursor:cell hover:bg:hover-bg"></div>
            {/for}
          </column>
          <column class="allday-zone" gap="1" sx="position:relative z:elevated p:1">
            {#for ev of dc.col.allDayEvents key={ev.id}}
              <button
                type="button"
                class="chip allday"
                data-event-id={ev.id}
                aria-selected={selectedIds().includes(ev.id) ? 'true' : 'false'}
                title={ev.title}
              >{ev.title}</button>
            {/for}
          </column>
          {#for pe of dc.col.laidOut key={pe.event.id}}
            <button
              type="button"
              class="timed-chip"
              data-event-id={pe.event.id}
              aria-selected={selectedIds().includes(pe.event.id) ? 'true' : 'false'}
              style:top={`${pe.topPct}%`}
              style:height={`${pe.heightPct}%`}
              style:left={`${(pe.laneIndex / pe.laneCount) * 100}%`}
              style:width={`${(1 / pe.laneCount) * 100}%`}
              title={pe.event.title}
            >{pe.event.title}</button>
          {/for}
        </div>
      {/for}
    </div>
  </div>
</div>
