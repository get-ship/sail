<!--
  <sui-calendar> — month / week / day calendar surface (Slice 2, the VIEW).
  Pure-framework component over the COMMITTED headless engine
  (`./engine/createCalendar`), which owns all reactive state + view-model
  (monthCells / dayColumns / timeSlots / agenda / selection / navigation). The
  engine arrives via `prop:calendar` IDENTITY; `events`/`focus-date` (type=string)
  are the SSR/declarative fallback (JSON.parse in the controller — `type="json"`
  does NOT compile). All emits go through host.emit! (see controller).

  A11y: month grid is a FIXED 6×7 role=grid/row/gridcell tree (never virtualized
  → NO windowed-count ARIA); event chips are role=button DESCENDANTS inside a
  gridcell; today → aria-current="date". Density: NO density/dense prop — rows
  read the --density-* channel off <html data-density>.

  Range selection (range-mode date|datetime): pointer drag across month-grid day
  cells, or Shift+Arrow from the focus anchor, sets the engine `range` signal and
  emits sui-range-change. Drag-to-create (empty time slot → sui-event-create-intent)
  and drag-to-move (timed chip → sui-event-move) ride a background slot grid that
  carries data-iso + data-minutes so the pointer→time map is element-addressed.
  The virtualized agenda remains an explicit GAP.
-->

<component>{
  props: {
    view: 'month' | 'week' | 'day',
    events: '',
    'focus-date': '',
    'week-starts-on': 0,
    'slot-minutes': 30,
    'day-start-hour': 0,
    'day-end-hour': 24,
    'range-mode': 'none' | 'date' | 'datetime',
    editable: false,
    label: '',
  },
}</component>
<!-- Residual style (small) — see commit body. The HTML comment above does
     NOT use the literal `<style>` tag, so the css-token lint's
     scan_style_blocks doesn't pick this comment up as a style block. -->
<style>
/* Residual: file-local sub-scale CSS custom properties on host; fixed
   7-column grid for the month view; descendant aria-selected rules; chip
   ::before dot; border-bottom/right hairlines; flex on title and
   slot-layer/slot-bg; text-align on dow/empty; the density-reactive row
   rhythm (toolbar/dow/cell/slot/empty padding + gap + font-size read
   --density-* — sx's p/px/py/text families only reach the fixed --space-N /
   --text-N scales, not the density channel, so these stay raw `var()`
   references here); the month-cell (84px) and day-column (864px) min-heights
   — bespoke calendar-grid measurements, not on the --space-N scale (min-height
   isn't lint-policed the way padding/margin/gap are), so kept as literal px,
   matching feat/next exactly. */
  .sui-calendar {
    --cal-gap-xs: var(--space-half);
    --cal-chip-py: var(--space-half);
    --cal-chip-px: var(--space-1_5);
  }
  /* Container base font — density-reactive, sx has no `text:density-text`
     token (the `text:` family is the fixed xs..4xl scale only). */
  .cal { font-family: var(--font-body); font-size: var(--density-text); }
  .dow-row,
  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .day-cols { display: grid; }
  .chip[aria-selected='true'],
  .timed-chip[aria-selected='true'] {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }
  .timed-chip[aria-selected='true'] { outline-offset: -1px; }
  .chip::before {
    content: '';
    position: absolute;
    left: var(--space-half);
    top: 50%;
    transform: translateY(-50%);
    width: var(--space-half);
    height: 60%;
    min-height: 12px;
    border-radius: var(--radius-sm);
    background: var(--primary);
  }
  .chip.allday::before { background: var(--accent); }
  /* Density-reactive row rhythm — sx's `p`/`px`/`py` family maps only to the
     fixed --space-N scale, not the --density-* channel, so these stay here. */
  .toolbar {
    gap: var(--density-row-gap);
    padding: var(--density-row-py) var(--density-row-px);
    border-bottom: 1px solid var(--border);
  }
  .dow {
    padding: var(--density-row-py) 0;
    font-size: var(--density-text);
  }
  .cell {
    padding: var(--density-row-py) var(--density-row-px);
    min-height: 84px;
  }
  .slot {
    padding: 0 var(--density-row-px);
    font-size: var(--density-text);
  }
  .empty {
    padding: calc(var(--density-row-py) * 4) var(--density-row-px);
  }
  .day-col { min-height: 864px; }
  .time-axis,
  .cell,
  .day-col { border-right: 1px solid var(--border); }
  .cell,
  .dow,
  .slot,
  .slot-bg { border-bottom: 1px solid var(--border); }
  .dow,
  .empty { text-align: center; }
  .title { flex: 1; }
  .slot-layer { inset: 0; }
  .slot-bg { flex: 1 0 var(--control-h-md); }
  .timegrid { grid-template-columns: auto 1fr; }
  .tb {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font: inherit;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .tb:hover { background: var(--hover-bg); }
  .tb[aria-pressed='true'] {
    background: var(--selected-bg);
    font-weight: var(--font-weight-semibold);
  }
  .cell.out { color: var(--muted-foreground); background: var(--muted); }
  .cell.weekend { background: var(--tone-muted-bg); }
  .cell.in-range { background: var(--selected-bg); }
  .cell .daynum {
    font-size: var(--density-text);
    align-self: flex-start;
    min-width: var(--control-h-2xs);
    height: var(--control-h-2xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
  }
  .cell.today .daynum {
    box-shadow: inset 0 0 0 var(--space-half) var(--primary);
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
  }
  .chip {
    position: relative;
    appearance: none;
    border: 0;
    text-align: start;
    cursor: pointer;
    font: inherit;
    font-size: var(--density-text);
    color: var(--foreground);
    background: var(--tone-primary-bg);
    border-radius: var(--radius-sm);
    padding: var(--cal-chip-py) var(--cal-chip-px);
    padding-left: calc(var(--cal-chip-px) + var(--space-2));
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .chip.allday { background: var(--tone-accent-bg); }
  .overflow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    padding: 0 var(--space-1);
  }
  .day-col.today { background: var(--selected-bg); }
  .allday-zone:empty { display: none; }
  .timed-chip {
    position: absolute;
    left: var(--cal-gap-xs);
    right: var(--cal-gap-xs);
    cursor: pointer;
    border: 0;
    text-align: start;
    font: inherit;
    font-size: var(--density-text);
    color: var(--tone-primary-fg);
    background: var(--tone-primary-bg);
    border-radius: var(--radius-sm);
    padding: var(--cal-chip-py) var(--space-1);
    overflow: hidden;
  }
  .sui-calendar[hidden] { display: none; }
  .sui-calendar[view='month'] .grid { display: block; }
  .sui-calendar[view='week'] .time-grid { display: grid; }
  .sui-calendar[view='day'] .time-grid { display: grid; }
</style>


<controller>
// <sui-calendar> controller — Slice 2 (the VIEW). Glue-only / tier-2.
//
// The headless engine (`./engine/createCalendar`) owns ALL reactive state +
// view-model derivation (month/week/day, agenda, selection, navigation). This
// controller is the thin seam: it routes the live `Calendar` in via the
// `prop:calendar` IDENTITY path (a JS reference, never a stringified attribute),
// falls back to building an engine from the `events` `type="string"` SSR prop
// (sui-combobox JSON.parse pattern), re-exposes the engine's `Derived` surfaces
// as scope signals the template reads, and emits `sui-*` events via the runtime
// `host.emit!` helper (NOT open-coded `dispatchEvent`).
//
// Cardinals honored: mutations only in on:* / mount; no fetch / ship.* / <data>
// (engine purity asserted by engine/purity.test.ts). Range selection +
// drag-to-create/move ride the engine's range/intent mutators; the DOM bridge
// (pointer drag + Shift+Arrow → engine + sui-* emits) lives in `./sui-calendar.interactions`.

import { controller, derived, effect, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import { createCalendar } from './engine'
import type { Calendar, CalendarEvent, DateRange, MonthCell, ViewMode } from './engine'
import { wireCalendarInteractions } from './sui-calendar.interactions'
import type { Scope } from './sui-calendar.sui'

const EMPTY: CalendarEvent[] = []
const DOW_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

/** SSR/declarative fallback decoder: parse the `events` JSON-string prop.
 *  Bad JSON degrades to an empty list (never throws into the render). */
function parseJsonEvents(raw: string): CalendarEvent[] {
  const s = raw.trim()
  if (!s) return EMPTY
  try {
    const parsed = JSON.parse(s)
    return Array.isArray(parsed) ? (parsed as CalendarEvent[]) : EMPTY
  } catch {
    return EMPTY
  }
}

/** Weekday header labels rotated to honor `weekStartsOn`. */
function weekdayLabels(weekStartsOn: number): { key: string; label: string }[] {
  const out: { key: string; label: string }[] = []
  for (let i = 0; i < 7; i++) {
    const idx = (weekStartsOn + i) % 7
    out.push({ key: `dow-${idx}`, label: DOW_LABELS[idx]! })
  }
  return out
}

export default controller({
  scope: (ctx: ViewScope<Scope>) => {
    const { events, focusDate, weekStartsOn, slotMinutes, dayStartHour, dayEndHour, rangeMode } = ctx
    // The live engine. `prop:calendar` identity (set in mount) supersedes; until
    // then we seed from the SSR `events` string + the focus-date attr so a
    // declarative (no-parent-controller) mount still renders.
    const engine = signal<Calendar | null>(null)

    // exactOptionalPropertyTypes: omit initialDate when empty rather than
    // passing `undefined` to the optional field.
    const initialDate = focusDate()
    const fallback = createCalendar({
      events: derived(() => parseJsonEvents(events())),
      ...(initialDate ? { initialDate } : {}),
      weekStartsOn: (weekStartsOn() || 0) as 0,
      slotMinutes: slotMinutes() || 30,
      dayStartHour: dayStartHour() ?? 0,
      dayEndHour: dayEndHour() ?? 24,
      rangeMode: (rangeMode() || 'none') as 'none',
    })

    /** The active engine — the prop:calendar identity if present, else fallback. */
    const cal = derived<Calendar>(() => engine() ?? fallback)

    // Re-expose the engine view-model as scope deriveds the template reads.
    const view = derived<ViewMode>(() => cal().view())
    const title = derived(() => cal().title())
    const monthCells = derived(() => cal().monthCells())
    // Each cell carries a content-sensitive key so a keyed {#for} re-renders the
    // cell (and its inner event {#for}) when the engine swaps in / events change —
    // a stable `iso`-only key would let the runtime reuse the row DOM and skip
    // the inner loop (the nested-for-over-a-plain-array reuse trap).
    // A cell is in-range when the range (day part) covers its day. The cell key
    // is content-sensitive but EXCLUDES the range, so `in-range` re-binds on the
    // REUSED cell as the range changes (a re-key would detach drag nodes mid-drag).
    const inRangeIso = (iso: string, r: DateRange | null): boolean =>
      r != null && iso >= r.start.slice(0, 10) && iso <= r.end.slice(0, 10)
    type CellRow = { key: string; iso: string; cell: MonthCell; inRange: boolean }
    const weekRows = derived<{ key: string; cells: CellRow[] }[]>(() => {
      const cells = cal().monthCells()
      const sel = cal().selectedEventIds()
      const range = cal().range()
      const sig = (c: MonthCell): string =>
        `${c.iso}|${c.today ? 't' : ''}|${c.events.map((e) => e.id).join(',')}|${c.overflowCount}|${sel.join(',')}`
      const rows: { key: string; cells: CellRow[] }[] = []
      for (let row = 0; row < 6; row++) {
        const slice = cells.slice(row * 7, row * 7 + 7)
        const cellRows = slice.map((c) => ({
          key: sig(c),
          iso: c.iso,
          cell: c,
          inRange: inRangeIso(c.iso, range),
        }))
        rows.push({ key: cellRows.map((cr) => cr.key).join('::'), cells: cellRows })
      }
      return rows
    })
    const weekdays = derived(() => weekdayLabels(weekStartsOn() || 0))
    // Day columns with a content-sensitive key (same reuse-trap guard as the
    // month grid): the laid-out timed events change when the engine swaps.
    const dayColumns = derived(() => {
      const sel = cal().selectedEventIds()
      return cal()
        .dayColumns()
        .map((col) => ({
          key: `${col.iso}|${col.laidOut.map((p) => p.event.id).join(',')}|${col.allDayEvents.map((e) => e.id).join(',')}|${sel.join(',')}`,
          col,
        }))
    })
    const timeSlots = derived(() => cal().timeSlots())
    const agenda = derived(() => cal().agenda())
    const isEmpty = derived(() => cal().isEmpty())
    const selectedIds = derived(() => cal().selectedEventIds())
    // view-mode branch flags the template reads (CSS also branches via the
    // reflected `view` host attribute synced in mount).
    const isMonth = derived(() => view() === 'month')
    const isWeek = derived(() => view() === 'week')
    const isDay = derived(() => view() === 'day')
    // The keyboard focus anchor — drives the month grid's roving tabindex
    // (focused cell tabindex=0, all others -1) so the grid is reachable + operable.
    const focusedIso = derived(() => cal().focusDate())

    return {
      engine,
      cal,
      view,
      title,
      monthCells,
      weekRows,
      weekdays,
      dayColumns,
      timeSlots,
      agenda,
      isEmpty,
      selectedIds,
      isMonth,
      isWeek,
      isDay,
      focusedIso,
    }
  },

  mount(state, host) {
    // prop:calendar identity — a live `Calendar` reference (the engine path),
    // routed into the scope signal so every derived re-resolves onto it.
    Object.defineProperty(host, 'calendar', {
      configurable: true,
      get: () => state.$signals.engine(),
      set: (c: Calendar | null) => {
        state.engine = c
      },
    })

    // Keep the reflected `view` attribute synced to the engine view so the
    // host CSS layout branches follow programmatic setView() too.
    const stopView = effect(() => {
      const v = state.$signals.view()
      if (host.getAttribute('view') !== v) host.setAttribute('view', v)
    })

    const active = (): Calendar => state.$signals.cal()

    // Deduped emit (sui-combobox lastEmitted pattern) over host.emit!. When
    // prop:calendar swaps the engine identity we re-seed from the NEW engine
    // (no emit) instead of diffing its view/date against the prior engine's —
    // otherwise the stale closure fires a spurious sui-view/date-change.
    let lastEngine: Calendar | null = null
    let lastView: ViewMode | null = null
    let lastDate: string | null = null
    const stopEmit = effect(() => {
      const cal = active()
      const v = cal.view()
      const d = cal.focusDate()
      if (cal === lastEngine) {
        if (lastView !== null && v !== lastView) host.emit!('sui-view-change', { view: v })
        if (lastDate !== null && d !== lastDate) host.emit!('sui-date-change', { date: d })
      }
      lastEngine = cal
      lastView = v
      lastDate = d
    })

    const onShadowClick = (e: Event) => {
      const t = e.target as HTMLElement | null
      if (!t) return
      const cal = active()

      const viewBtn = t.closest?.('[data-view]') as HTMLElement | null
      if (viewBtn) {
        cal.setView(viewBtn.dataset.view as ViewMode)
        return
      }
      const navBtn = t.closest?.('[data-nav]') as HTMLElement | null
      if (navBtn) {
        const act = navBtn.dataset.nav
        if (act === 'next') cal.next()
        else if (act === 'prev') cal.prev()
        else if (act === 'today') cal.today()
        return
      }
      const chip = t.closest?.('[data-event-id]') as HTMLElement | null
      if (chip) {
        const id = chip.dataset.eventId!
        cal.selectEvent(id, { additive: (e as MouseEvent).metaKey })
        host.emit!('sui-event-click', { id })
        host.emit!('sui-event-select', {
          id,
          selected: cal.selectedEventIds().includes(id),
          selectedIds: cal.selectedEventIds(),
        })
        return
      }
      const dayCell = t.closest?.('[role=gridcell][data-iso]') as HTMLElement | null
      if (dayCell) cal.goToDate(dayCell.dataset.iso!)
    }

    // Month-grid keyboard operability — the grid advertises role=grid/gridcell
    // with a roving tabindex, so the focused day cell must respond to arrow /
    // Home / End / PageUp-Down / Enter-Space. All moves route through the engine
    // (which owns the date math); DOM focus follows the new focus anchor.
    const onShadowKey = (e: KeyboardEvent) => {
      const cell = (e.target as HTMLElement | null)?.closest?.(
        '[role=gridcell][data-iso]',
      ) as HTMLElement | null
      if (!cell) return
      // Shift+Arrow is range extension — owned by the interactions wiring (which
      // moves focus AND extends the range as one move). Skip it here so focus is
      // not moved twice.
      if (e.shiftKey) return
      const cal = active()
      switch (e.key) {
        case 'ArrowRight': cal.moveFocus(1); break
        case 'ArrowLeft': cal.moveFocus(-1); break
        case 'ArrowDown': cal.moveFocus(7); break
        case 'ArrowUp': cal.moveFocus(-7); break
        case 'Home': cal.focusWeekEdge(false); break
        case 'End': cal.focusWeekEdge(true); break
        case 'PageDown': cal.next(); break
        case 'PageUp': cal.prev(); break
        case 'Enter':
        case ' ':
          cal.goToDate(cell.dataset.iso!)
          break
        default:
          return
      }
      e.preventDefault()
      // Move DOM focus onto the newly-anchored cell after the grid re-renders.
      const iso = active().focusDate()
      queueMicrotask(() => {
        const next = host.shadowRoot?.querySelector(
          `[role=gridcell][data-iso="${iso}"]`,
        ) as HTMLElement | null
        next?.focus()
      })
    }

    (host.shadowRoot ?? host).addEventListener('click', onShadowClick)
    (host.shadowRoot ?? host).addEventListener('keydown', onShadowKey as EventListener)

    // Range selection (month drag + Shift+Arrow) + drag-to-create/move (time-
    // grid slot drag). The DOM↔engine bridge lives in the interactions module;
    // it reads the engine fresh per event and emits sui-range-change /
    // sui-event-create-intent / sui-event-move, auto-cleaning against the mount
    // scope. The slot span is the step between consecutive slots (the engine
    // builds them by stepping `slotMinutes`, so the gap recovers it).
    const slotSpan = (): number => {
      const s = active().timeSlots()
      return s.length > 1 ? s[1]!.minutes - s[0]!.minutes : 30
    }
    wireCalendarInteractions(host, { calOf: active, slotMinutes: slotSpan })

    host.expose!({
      next: () => active().next(),
      prev: () => active().prev(),
      today: () => active().today(),
      setView: (v: ViewMode) => active().setView(v),
    })

    return () => {
      stopView()
      stopEmit()
      (host.shadowRoot ?? host).removeEventListener('click', onShadowClick)
      (host.shadowRoot ?? host).removeEventListener('keydown', onShadowKey as EventListener)
      delete (host as { calendar?: unknown }).calendar
    }
  },
})

</controller>
<div class="cal wrap" sx="display:block bg:background fg:foreground border:border radius:lg shadow:xs overflow:hidden">
  <row class="toolbar" align="center">
    <row class="nav-group" gap="1" align="center">
      <button type="button" class="tb" data-nav="prev" aria-label="Previous">‹</button>
      <button type="button" class="tb" data-nav="today">Today</button>
      <button type="button" class="tb" data-nav="next" aria-label="Next">›</button>
    </row>
    <span class="title" sx="weight:semibold">{title()}</span>
    <row class="view-switch" role="group" aria-label="Calendar view" gap="1" align="center">
      <button type="button" class="tb" data-view="month" aria-pressed={isMonth() ? 'true' : 'false'}>Month</button>
      <button type="button" class="tb" data-view="week" aria-pressed={isWeek() ? 'true' : 'false'}>Week</button>
      <button type="button" class="tb" data-view="day" aria-pressed={isDay() ? 'true' : 'false'}>Day</button>
    </row>
  </row>

  {#if isEmpty()}
    <div class="empty" role="status" sx="fg:muted-foreground">
      <slot name="empty">No events</slot>
    </div>
  {/if}

  <div class="grid" role="grid" aria-label={label() || 'Calendar month'} sx="display:none">
    <div class="dow-row" role="presentation">
      {#for d of weekdays() key={d.key}}
        <span class="dow" role="columnheader" sx="fg:muted-foreground weight:medium">{d.label}</span>
      {/for}
    </div>
    {#for wk of weekRows() key={wk.key}}
      <div class="week" role="row">
        {#for cr of wk.cells key={cr.key}}
          <column
            class="cell"
            role="gridcell"
            data-iso={cr.cell.iso}
            tabindex={cr.cell.iso === focusedIso() ? '0' : '-1'}
            class:out={!cr.cell.inMonth}
            class:today={cr.cell.today}
            class:weekend={cr.cell.isWeekend}
            class:in-range={cr.inRange}
            aria-current={cr.cell.today ? 'date' : null}
            aria-label={cr.cell.iso}
            gap="1"
          >
            <span class="daynum">{cr.cell.day}</span>
            {#for ev of cr.cell.events key={ev.id}}
              <button
                type="button"
                class="chip"
                data-event-id={ev.id}
                class:allday={ev.allDay}
                aria-selected={selectedIds().includes(ev.id) ? 'true' : 'false'}
                title={ev.title}
              >{ev.title}</button>
            {/for}
            {#if cr.cell.overflowCount > 0}
              <span class="overflow">+{cr.cell.overflowCount} more</span>
            {/if}
          </column>
        {/for}
      </div>
    {/for}
  </div>

  <div class="timegrid time-grid" role="grid" aria-label={label() || 'Calendar time grid'} sx="display:none">
    <column class="time-axis" role="rowgroup" gap="0">
      {#for slot of timeSlots() key={slot.key}}
        <div class="slot" data-slot={slot.minutes} role="rowheader" sx="h:control-h-md fg:muted-foreground">{slot.label}</div>
      {/for}
    </column>
    <div class="day-cols day-col">
      {#for dc of dayColumns() key={dc.key}}
        <div class="day-col" class:today={dc.col.today} data-iso={dc.col.iso} sx="position:relative">
          <column class="slot-layer" gap="0" sx="position:absolute">
            {#for slot of timeSlots() key={slot.key}}
              <div class="slot-bg" data-iso={dc.col.iso} data-minutes={slot.minutes} sx="cursor:cell hover:bg:hover-bg"></div>
            {/for}
          </column>
          <column class="allday-zone" gap="1" sx="position:relative z:elevated p:half">
            {#for ev of dc.col.allDayEvents key={ev.id}}
              <button
                type="button"
                class="chip allday"
                data-event-id={ev.id}
                aria-selected={selectedIds().includes(ev.id) ? 'true' : 'false'}
                title={ev.title}
              >{ev.title}</button>
            {/for}
          </column>
          {#for pe of dc.col.laidOut key={pe.event.id}}
            <button
              type="button"
              class="timed-chip"
              data-event-id={pe.event.id}
              aria-selected={selectedIds().includes(pe.event.id) ? 'true' : 'false'}
              style:top={`${pe.topPct}%`}
              style:height={`${pe.heightPct}%`}
              style:left={`${(pe.laneIndex / pe.laneCount) * 100}%`}
              style:width={`${(1 / pe.laneCount) * 100}%`}
              title={pe.event.title}
            >{pe.event.title}</button>
          {/for}
        </div>
      {/for}
    </div>
  </div>
</div>
