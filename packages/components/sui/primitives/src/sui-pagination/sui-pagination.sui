<!--
  <sui-pagination> — the data-grid footer pager.

  first / prev / numbered page buttons / next / last + an "N–M of T" range label,
  and an optional page-size <sui-select>. Composes bare <button>s (edges +
  numbers) and <sui-select> (page size) — no bespoke button/select chrome.

  CONTROLLED + presentational: the component never owns the page. It reflects the
  `page` / `page-size` / `total` props it is handed and EMITS the requested
  transition; the consumer applies it and feeds new props back. One event:

    sui-page-change { page: number, pageSize: number }   (bubbles + composed)

  Edge rules: first/prev disabled on page 1; next/last disabled on the final
  page; a single-page set disables all four. A page-size change always resets to
  page 1 so the viewer is never stranded past the new last page.

  Structured input (the page-size option list) follows the sui-combobox pattern:
  a `page-size-options` string prop ("10,25,50,100") parsed in the controller —
  consumers that hold a live array bind it as the host `pageSizeOptions` property
  (prop:* identity), which the controller mirrors into the same parsed list.

  Parts: nav, edges, range, first, prev, pages, page, next, last, size.

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - `<sui-cluster>` (removed from this surface) → the built-in `<row>` keyword
    for the nav toolbar + the edges/pages groups. `<row>` lowers to
    `display:flex; flex-wrap:wrap` + gap/align — the same wrapping-cluster
    behavior the baseline's sui-cluster gave, so no visual loss. The `.edges`/
    `.pages` hand-CSS (display:inline-flex + gap) is now expressed via the
    row's own `gap`/`align` attributes instead of a residual <style> rule.
  - The page-size `<label class="size">` wrapper → `<row class="size">`. A
    bare `<label>` tag is an L1 stdlib element on this surface (see
    crates/sui/compiler/stdlib/label.sui) — using one here would splice in
    the framework's own label skin (bold weight, `--foreground` color,
    pointer cursor) tag-wide, which visually fights this control's intended
    muted, non-bold treatment. No functional loss: the accessible name for
    the page-size control is carried directly by `<sui-select label={…}>`
    (rendered as `aria-label` on the inner native `<select>`), so the
    implicit label-for association `<label>` would have given was
    redundant, not load-bearing.
  - `.range`/`.size` foreground color moved from residual <style> into
    `sx="fg:muted-foreground"` on the element (closed-sx can express a
    plain token color; only non-sx properties — font-family, white-space,
    user-select, font-variant-numeric, the forced-colors system color —
    stay in the residual block).
  - Props are left as plain `<prop>` tags (not the `<component>{props:{…}}}`
    sugar): `page`/`total`/`page-size` need `reflect` preserved from the
    baseline, and the sugar's number-literal-default expansion
    (`expand_props` in preprocess.rs) does not emit `reflect` for a typed
    number default — only bool/union/tone/size get it automatically. Raw
    `<prop>` tags are the same underlying mechanism the sugar desugars to,
    so this keeps full fidelity without inventing a workaround.
  - No LANG-GAP: every prop/slot/event/ARIA rule from the baseline is fully
    expressible on this surface.
  - `<sui-button>` dissolved to bare `<button>` (dissolve-gate pass): the L1
    button contract (tone/variant/size attrs) already covers ghost/soft +
    size=sm; no visual change, one less registration.
-->

<component>{
  props: {
    page: 1,
    total: 0,
    'page-size': 10,
    'page-size-options': '',
    label: 'Pagination',
    'size-label': 'Rows per page',
  },
}</component>
<style>
  /* Residual: `font-family: var(--font-body)` (no `font-family` prop in sx),
     `flex: 1 1 auto` on .spacer (no `flex` prop), the
     `button[aria-current='page']` child selector, and text properties the sx
     vocabulary doesn't expose (`white-space`, `user-select`,
     `font-variant-numeric`). The forced-colors `CanvasText` system color is
     also residual — not a token. */
  .sui-pagination {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .sui-pagination[hidden] { display: none; }
  .spacer { flex: 1 1 auto; }
  .range {
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    font-variant-numeric: tabular-nums;
  }
  .size { white-space: nowrap; }
  button[aria-current='page'] { pointer-events: none; }
  @media (forced-colors: active) {
    .range { color: CanvasText; }
  }
</style>


<controller>
import { controller, derived, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-pagination.sui'

/** A numbered page button's view model (the `{#for}` row). */
interface PageView {
  page: number
  current: boolean
  label: string
}

/** Parse the `page-size-options` string ("10,25,50,100") into a deduped,
 *  positive-integer list, order preserved. Non-numeric chunks are dropped. */
function parseSizes(raw: string): number[] {
  const out: number[] = []
  for (const chunk of raw.split(',')) {
    const n = Number(chunk.trim())
    if (Number.isInteger(n) && n > 0 && !out.includes(n)) out.push(n)
  }
  return out
}

/** Total page count — never below 1 so an empty set still reports "page 1 of 1"
 *  and the edge controls collapse to a single disabled page. */
function pageCountOf(total: number, pageSize: number): number {
  if (pageSize <= 0 || total <= 0) return 1
  return Math.max(1, Math.ceil(total / pageSize))
}

export default controller({
  scope: ({ page, total, pageSize, pageSizeOptions }: ViewScope<Scope>) => {
    const navEl = ref<HTMLElement>(null)
    const sizeSelectEl = ref<HTMLElement>(null)

    // prop:* identity seam — a live array assigned to the host `pageSizeOptions`
    // property wins over the parsed `page-size-options` string (the structured
    // input path). Null until a consumer assigns it.
    const optionsIdentity = signal<number[] | null>(null)

    const pageCount = derived<number>(() => pageCountOf(total(), pageSize()))
    const current = derived<number>(() => {
      const p = Math.trunc(page())
      const max = pageCount()
      if (p < 1) return 1
      if (p > max) return max
      return p
    })

    const atStart = derived<boolean>(() => current() <= 1)
    const atEnd = derived<boolean>(() => current() >= pageCount())

    const rangeLabel = derived<string>(() => {
      const t = total()
      if (t <= 0) return '0 of 0'
      const ps = pageSize() > 0 ? pageSize() : t
      const start = (current() - 1) * ps + 1
      const end = Math.min(current() * ps, t)
      return `${start}–${end} of ${t}`
    })

    const pageNumbers = derived<PageView[]>(() => {
      const max = pageCount()
      const cur = current()
      const out: PageView[] = []
      for (let p = 1; p <= max; p++) {
        out.push({ page: p, current: p === cur, label: `Page ${p}` })
      }
      return out
    })

    const sizeOptions = derived<number[]>(() => {
      const identity = optionsIdentity()
      if (identity && identity.length > 0) return identity
      return parseSizes(pageSizeOptions())
    })

    const pageSizeStr = derived<string>(() => String(pageSize()))

    return {
      navEl,
      sizeSelectEl,
      optionsIdentity,
      pageCount,
      current,
      atStart,
      atEnd,
      rangeLabel,
      pageNumbers,
      sizeOptions,
      pageSizeStr,
    }
  },

  mount(state, host) {
    const emitPage = (next: number): void => {
      const clamped = Math.max(1, Math.min(next, state.pageCount))
      host.emit!('sui-page-change', { page: clamped, pageSize: state.pageSize })
    }

    // prop:* identity — a live `pageSizeOptions` array assigned to the host
    // routes into the scope signal so the size <sui-select> reacts and wins over
    // the declarative `page-size-options` string (the SSR/fallback path the
    // `sizeOptions` derived parses when no identity array is set).
    Object.defineProperty(host, 'pageSizeOptions', {
      configurable: true,
      get: () => state.optionsIdentity,
      set: (v: unknown) => {
        state.optionsIdentity = Array.isArray(v)
          ? v.map((n) => Number(n)).filter((n) => Number.isInteger(n) && n > 0)
          : null
      },
    })

    // ── Delegated navigation ────────────────────────────────────────────────
    // One listener on the <nav> covers the edge controls AND the numbered page
    // buttons. A disabled <button> swallows its own click, so no edge guard is
    // needed here — but a defensive bounds check keeps the contract honest if
    // a host overrides disabled CSS.
    const onClick = (e: Event): void => {
      const target = e.target as HTMLElement
      const numbered = target.closest('[data-page]')
      if (numbered) {
        const n = Number(numbered.getAttribute('data-page'))
        if (Number.isInteger(n)) emitPage(n)
        return
      }
      const edge = target.closest('[data-page-action]')
      if (!edge) return
      switch (edge.getAttribute('data-page-action')) {
        case 'first':
          if (state.current > 1) emitPage(1)
          break
        case 'prev':
          if (state.current > 1) emitPage(state.current - 1)
          break
        case 'next':
          if (state.current < state.pageCount) emitPage(state.current + 1)
          break
        case 'last':
          if (state.current < state.pageCount) emitPage(state.pageCount)
          break
      }
    }

    // ── Page-size change ────────────────────────────────────────────────────
    // The composed <sui-select> emits `sui-change { value }`. A size change
    // resets to page 1 so the viewer never lands past the new last page.
    const onSizeChange = (e: Event): void => {
      const detail = (e as CustomEvent<{ value?: string }>).detail
      const next = Number(detail?.value)
      if (!Number.isInteger(next) || next <= 0) return
      host.emit!('sui-page-change', { page: 1, pageSize: next })
    }

    const nav = state.navEl as HTMLElement | null
    nav?.addEventListener('click', onClick)
    nav?.addEventListener('sui-change', onSizeChange as EventListener)

    return () => {
      nav?.removeEventListener('click', onClick)
      nav?.removeEventListener('sui-change', onSizeChange as EventListener)
    }
  },
})

</controller>
<row class="nav" gap="3" align="center" aria-label={label()} bind:this={navEl}>
  <row class="edges" gap="1" align="center">
    <button class="first" ghost sm data-page-action="first" aria-label="First page" disabled={atStart()}>
      <sui-icon name="chevrons-left" size="sm" aria-hidden="true"></sui-icon>
    </button>
    <button class="prev" ghost sm data-page-action="prev" aria-label="Previous page" disabled={atStart()}>
      <sui-icon name="chevron-left" size="sm" aria-hidden="true"></sui-icon>
    </button>
  </row>

  <row class="pages" gap="1" align="center">
    {#for p of pageNumbers() key={p.page}}
      <button class="page" sm variant={p.current ? 'soft' : 'ghost'} tone={p.current ? 'primary' : 'default'} data-page={p.page} aria-current={p.current ? 'page' : null} aria-label={p.label}>{p.page}</button>
    {/for}
  </row>

  <row class="edges" gap="1" align="center">
    <button class="next" ghost sm data-page-action="next" aria-label="Next page" disabled={atEnd()}>
      <sui-icon name="chevron-right" size="sm" aria-hidden="true"></sui-icon>
    </button>
    <button class="last" ghost sm data-page-action="last" aria-label="Last page" disabled={atEnd()}>
      <sui-icon name="chevrons-right" size="sm" aria-hidden="true"></sui-icon>
    </button>
  </row>

  <span class="spacer"></span>

  <span class="range" role="status" aria-live="polite" sx="fg:muted-foreground">{rangeLabel()}</span>

  {#if sizeOptions().length > 0}
    <row class="size" gap="2" align="center" sx="fg:muted-foreground">
      <span>{sizeLabel()}</span>
      <sui-select size="sm" label={sizeLabel()} prop:value={pageSizeStr()} bind:this={sizeSelectEl}>
        {#for opt of sizeOptions() key={opt}}
          <option value={opt}>{opt}</option>
        {/for}
      </sui-select>
    </row>
  {/if}
</row>
