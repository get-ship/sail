<!--
  <sui-pagination> — the data-grid footer pager.

  first / prev / numbered page buttons / next / last + an "N–M of T" range label,
  and an optional page-size <sui-select>. Composes <sui-button> (edges + numbers)
  and <sui-select> (page size) — no bespoke button/select chrome.

  CONTROLLED + presentational: the component never owns the page. It reflects the
  `page` / `page-size` / `total` props it is handed and EMITS the requested
  transition; the consumer applies it and feeds new props back. One event:

    sui-page-change { page: number, pageSize: number }   (bubbles + composed)

  Edge rules: first/prev disabled on page 1; next/last disabled on the final
  page; a single-page set disables all four. A page-size change always resets to
  page 1 so the viewer is never stranded past the new last page.

  Structured input (the page-size option list) follows the sui-combobox pattern:
  a `page-size-options` string prop ("10,25,50,100") parsed in the controller —
  consumers that hold a live array bind it as the host `pageSizeOptions` property
  (prop:* identity), which the controller mirrors into the same parsed list.

  Parts: nav, edges, range, first, prev, pages, page, next, last, size.

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - `<sui-cluster>` (removed from this surface) → the built-in `<row>` keyword
    for the nav toolbar + the edges/pages groups. `<row>` lowers to
    `display:flex; flex-wrap:wrap` + gap/align — the same wrapping-cluster
    behavior the baseline's sui-cluster gave, so no visual loss. The `.edges`/
    `.pages` hand-CSS (display:inline-flex + gap) is now expressed via the
    row's own `gap`/`align` attributes instead of a residual <style> rule.
  - The page-size `<label class="size">` wrapper → `<row class="size">`. A
    bare `<label>` tag is an L1 stdlib element on this surface (see
    crates/sui/compiler/stdlib/label.sui) — using one here would splice in
    the framework's own label skin (bold weight, `--foreground` color,
    pointer cursor) tag-wide, which visually fights this control's intended
    muted, non-bold treatment. No functional loss: the accessible name for
    the page-size control is carried directly by `<sui-select label={…}>`
    (rendered as `aria-label` on the inner native `<select>`), so the
    implicit label-for association `<label>` would have given was
    redundant, not load-bearing.
  - `.range`/`.size` foreground color moved from residual <style> into
    `sx="fg:muted-foreground"` on the element (closed-sx can express a
    plain token color; only non-sx properties — font-family, white-space,
    user-select, font-variant-numeric, the forced-colors system color —
    stay in the residual block).
  - Props are left as plain `<prop>` tags (not the `<component>{props:{…}}}`
    sugar): `page`/`total`/`page-size` need `reflect` preserved from the
    baseline, and the sugar's number-literal-default expansion
    (`expand_props` in preprocess.rs) does not emit `reflect` for a typed
    number default — only bool/union/tone/size get it automatically. Raw
    `<prop>` tags are the same underlying mechanism the sugar desugars to,
    so this keeps full fidelity without inventing a workaround.
  - No LANG-GAP: every prop/slot/event/ARIA rule from the baseline is fully
    expressible on this surface.
-->

<prop name="page" type="number" default="1" reflect />
<prop name="total" type="number" default="0" reflect />
<prop name="page-size" type="number" default="10" reflect />
<prop name="page-size-options" type="string" default="" />
<prop name="label" type="string" default="Pagination" />
<prop name="size-label" type="string" default="Rows per page" />

<style>
  /* Residual: `font-family: var(--font-body)` (no `font-family` prop in sx),
     `flex: 1 1 auto` on .spacer (no `flex` prop), the
     `sui-button[aria-current='page']` child-component selector, and text
     properties the sx vocabulary doesn't expose (`white-space`, `user-select`,
     `font-variant-numeric`). The forced-colors `CanvasText` system color is
     also residual — not a token. */
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }
  .spacer { flex: 1 1 auto; }
  .range {
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    font-variant-numeric: tabular-nums;
  }
  .size { white-space: nowrap; }
  sui-button[aria-current='page'] { pointer-events: none; }
  @media (forced-colors: active) {
    .range { color: CanvasText; }
  }
</style>

<row class="nav" part="nav" gap="3" align="center" aria-label={label()} bind:this={navEl}>
  <row class="edges" part="edges" gap="1" align="center">
    <sui-button
      part="first"
      variant="ghost"
      size="sm"
      data-page-action="first"
      label="First page"
      prop:disabled={atStart()}
    >
      <sui-icon name="chevrons-left" size="sm" aria-hidden="true"></sui-icon>
    </sui-button>
    <sui-button
      part="prev"
      variant="ghost"
      size="sm"
      data-page-action="prev"
      label="Previous page"
      prop:disabled={atStart()}
    >
      <sui-icon name="chevron-left" size="sm" aria-hidden="true"></sui-icon>
    </sui-button>
  </row>

  <row class="pages" part="pages" gap="1" align="center">
    {#for p of pageNumbers() key={p.page}}
      <sui-button
        part="page"
        variant={p.current ? 'soft' : 'ghost'}
        tone={p.current ? 'primary' : 'default'}
        size="sm"
        data-page={p.page}
        aria-current={p.current ? 'page' : null}
        aria-label={p.label}
      >{p.page}</sui-button>
    {/for}
  </row>

  <row class="edges" part="edges" gap="1" align="center">
    <sui-button
      part="next"
      variant="ghost"
      size="sm"
      data-page-action="next"
      label="Next page"
      prop:disabled={atEnd()}
    >
      <sui-icon name="chevron-right" size="sm" aria-hidden="true"></sui-icon>
    </sui-button>
    <sui-button
      part="last"
      variant="ghost"
      size="sm"
      data-page-action="last"
      label="Last page"
      prop:disabled={atEnd()}
    >
      <sui-icon name="chevrons-right" size="sm" aria-hidden="true"></sui-icon>
    </sui-button>
  </row>

  <span class="spacer" part="spacer"></span>

  <span class="range" part="range" role="status" aria-live="polite"
    sx="fg:muted-foreground">{rangeLabel()}</span>

  {#if sizeOptions().length > 0}
    <row class="size" part="size" gap="2" align="center"
      sx="fg:muted-foreground">
      <span>{sizeLabel()}</span>
      <sui-select size="sm" label={sizeLabel()} prop:value={pageSizeStr()} bind:this={sizeSelectEl}>
        {#for opt of sizeOptions() key={opt}}
          <option value={opt}>{opt}</option>
        {/for}
      </sui-select>
    </row>
  {/if}
</row>
