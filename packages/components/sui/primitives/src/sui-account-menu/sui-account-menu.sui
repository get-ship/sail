<!--
  <sui-account-menu> — generic account affordance for a chrome strip.
  Trigger shows the identity (avatar + name) or "Sign in"; clicking opens a
  native-popover panel with plan info + actions.

  RUNTIME-FREE / SDK-FREE. The original @ship/chrome version subscribed to
  `ship.account.state()` via <data> and called `navigate()` + `@ship/sdk-client`
  helpers directly. Here ALL of that is parameterized out: the identity arrives
  as plain props and every action leaves as an event. The consuming app wires
  the subscription, the router, and the SDK calls.

  Prop surface (the app maps its live account state onto these)
  ────────────────────────────────────────────────────────────────────────
    status (signed-out|signed-in|pending, 'signed-out', reflect)
    name / email / image / plan (string)   identity display fields
    provider (string)                       e.g. "Ship Cloud" — folded into
                                            the sign-in label + connect hint
    busy (bool)                             disables the in-flight action
    error (string)                          surfaces an error line
    placement (union, 'bottom-end', reflect)
    label-style (text|compact, 'text', reflect)  compact = avatar + caret only
  ────────────────────────────────────────────────────────────────────────
  Events (bubbling, composed) — the app does the actual work:
    sui-account-signin {}     sui-account-signout {}
    sui-account-settings {}   sui-account-billing {}
    sui-account-menu-ready {} (once after mount)
  Parts: trigger, avatar, name, panel
-->

<prop name="status" values="signed-out|signed-in|pending" default="signed-out" reflect />
<prop name="name" type="string" default="" />
<prop name="email" type="string" default="" />
<prop name="image" type="string" default="" />
<prop name="plan" type="string" default="" />
<prop name="provider" type="string" default="" />
<prop name="busy" type="bool" default="false" />
<prop name="error" type="string" default="" />
<prop name="placement" values="top|top-end|bottom|bottom-end|left|left-end|right|right-end" default="bottom-end" reflect />
<prop name="label-style" values="text|compact" default="text" reflect />



<!--
  Residual <style> — truly unavoidable bits:
  - :host position: relative + display: inline-flex
  - .trigger background:transparent + border:1px solid transparent + multi-prop transition
  - .trigger :focus-visible box-shadow (raw)
  - .avatar + .avatar-fallback box-shadow ring (raw)
  - .avatar-fallback.signed-out class rule (variants part selectors don't reach class)
  - .panel position:fixed + inset + width + multi-prop transition + transform
  - .panel::backdrop background
  - .panel popover-open transform
  - .panel reduced-motion override (transition: none + transform: none !important)
  - .id-block border-bottom
  - .id-block .avatar / .avatar-fallback flex:0 0 auto
  - .name white-space:nowrap + overflow:hidden + text-overflow:ellipsis (not sx-able)
  - .id-name, .id-email white-space:nowrap + overflow:hidden + text-overflow:ellipsis
  - .plan text-transform: uppercase (not in sx)
  - .action background:transparent + border:0 + text-align:left + font:inherit + transition
  - .action :focus-visible box-shadow inset
  - .action.danger color: destructive (class selector)
  - .action[disabled] opacity:50 cursor:default (attribute selector)
  - .action .meta margin-left:auto + color:muted-foreground
  - .divider height:1px + margin + background
  - :host([label-style='compact']) .name display:none (host data-driven)
-->
<style>
  :host {
    position: relative;
    display: inline-flex;
  }
  .trigger {
    background: transparent;
    border: 1px solid transparent;
    padding: var(--space-half) var(--space-1_5) var(--space-half) var(--space-half);
    font: inherit;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .trigger:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--ring-width) var(--ring);
  }
  :host([label-style='compact']) .name { display: none; }
  .avatar, .avatar-fallback {
    flex: 0 0 auto;
    box-shadow: 0 0 0 1px var(--border-subtle);
  }
  .avatar-fallback.signed-out { background: var(--hover-bg); color: var(--muted-foreground); }
  .name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .id-block {
    border-bottom: 1px solid var(--border);
  }
  .id-block .avatar,
  .id-block .avatar-fallback { flex: 0 0 auto; }
  .panel {
    position: fixed;
    inset: auto;
    margin: 0;
    border: 0;
    padding: 0;
    width: var(--panel-max-w-sm);
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-1))) scale(0.97);
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .panel::backdrop { background: transparent; }
  @media (prefers-reduced-motion: reduce) {
    .panel { transition: none; transform: none !important; }
  }
  .id-block {
    border-bottom: 1px solid var(--border);
  }
  .id-name, .id-email {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .plan {
    text-transform: uppercase;
  }
  .action {
    background: transparent;
    border: 0;
    text-align: left;
    font: inherit;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .action.danger { color: var(--destructive); }
  .action[disabled] { opacity: 0.5; cursor: default; }
  .action:focus-visible {
    outline: none;
    background: var(--hover-bg);
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring);
  }
  .action .meta {
    color: var(--muted-foreground);
    margin-left: auto;
  }
  .divider {
    height: 1px;
    margin: var(--space-1) 0;
    background: var(--border);
  }
</style>

<row class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  align="center" gap="2"
  on:click={() => togglePanel()}
  aria-haspopup="dialog"
  aria-expanded={panelOpen() ? 'true' : 'false'}
  aria-label={triggerAria()}
  title={triggerAria()}
  sx="p:1_5 radius:sm text:sm fg:foreground cursor:pointer max-w:panel-min-w-lg hover:bg:hover-bg">
  {#if status() === 'signed-in' && image() !== ''}
    <img class="avatar" part="avatar" src={image()} alt=""
      sx="w:control-h-2xs h:control-h-2xs radius:full" />
  {:else if status() === 'signed-in'}
    <row class="avatar-fallback" part="avatar" aria-hidden="true" align="center" gap="0" justify="center"
      sx="w:control-h-2xs h:control-h-2xs radius:full overflow:hidden bg:tone-primary-bg fg:primary text:xs weight:semibold tracking:wide">{initials()}</row>
  {:else}
    <row class="avatar-fallback signed-out" part="avatar" aria-hidden="true" align="center" gap="0" justify="center"
      sx="w:control-h-2xs h:control-h-2xs radius:full overflow:hidden bg:hover-bg fg:muted-foreground text:xs weight:semibold tracking:wide">
      <sui-icon name="user" size="sm"></sui-icon>
    </row>
  {/if}
  <span class="name" part="name"
    sx="weight:medium max-w:panel-ch-w-md leading:none">{triggerLabel()}</span>
  <svg class="caret" viewBox="0 0 10 6" aria-hidden="true"
    sx="w:icon-size-sm h:icon-size-xs fg:muted-foreground">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</row>

<div class="panel" part="panel" popover="auto" bind:this={panelEl} role="menu" aria-label="Account"
  sx="w:panel-max-w-sm bg:popover fg:popover-foreground border:border radius:md shadow:lg">
  {#if status() === 'signed-in'}
    <row class="id-block" align="center" gap="2"
      sx="p:3 px:3_5">

      {#if image() !== ''}
        <img class="avatar" src={image()} alt=""
          sx="w:control-h-md h:control-h-md radius:full" />
      {:else}
        <row class="avatar-fallback" aria-hidden="true" align="center" gap="0" justify="center"
          sx="w:control-h-md h:control-h-md radius:full overflow:hidden bg:tone-primary-bg fg:primary text:base weight:semibold tracking:wide">{initials()}</row>
      {/if}
      <column class="id-stack" gap="0" sx="min-w:0">
        <span class="id-name"
          sx="weight:semibold text:base fg:popover-foreground">{name() !== '' ? name() : 'Account'}</span>
        {#if email() !== ''}
          <span class="id-email"
            sx="fg:muted-foreground text:xs">{email()}</span>
        {/if}
      </column>
      {#if plan() !== ''}
        <span class="plan"
          sx="text:xs fg:muted-foreground p:1_5 radius:full bg:hover-bg">{plan()}</span>
      {/if}
    </row>
  {:else}
    <row class="id-block" align="center" gap="2"
      sx="p:3 px:3_5">
      <row class="avatar-fallback signed-out" aria-hidden="true" align="center" gap="0" justify="center"
        sx="w:control-h-md h:control-h-md radius:full overflow:hidden bg:hover-bg fg:muted-foreground text:base weight:semibold tracking:wide">
        <sui-icon name="user" size="sm"></sui-icon>
      </row>
      <column class="id-stack" gap="0" sx="min-w:0">
        <span class="id-name"
          sx="weight:semibold text:base fg:popover-foreground">Not signed in</span>
        <span class="id-email"
          sx="fg:muted-foreground text:xs">{disconnectedHint()}</span>
      </column>
    </row>
  {/if}

  <column class="actions" gap="0" role="none" sx="p:1">
    {#if status() === 'signed-in'}
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center"
        on:click={() => onSettings()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground hover:bg:hover-bg">
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </row>
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center"
        on:click={() => onBilling()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground hover:bg:hover-bg">
        <sui-icon name="credit-card" size="sm"></sui-icon>
        <span>Billing</span>
        <sui-icon class="meta" name="external-link" size="sm" sx="text:xs"></sui-icon>
      </row>
      <div class="divider" role="separator" sx="m:1"></div>
      <row class="action danger" part="action" type="button" role="menuitem" gap="2" align="center"
        disabled={busy()}
        on:click={() => onSignOut()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:destructive hover:bg:hover-bg">
        <sui-icon name="log-out" size="sm"></sui-icon>
        <span>Sign out</span>
      </row>
    {:else if status() === 'pending'}
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center" disabled
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground opacity:50">
        <sui-icon name="loader" size="sm"></sui-icon>
        <span>Completing sign-in…</span>
      </row>
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center"
        on:click={() => onSettings()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground hover:bg:hover-bg">
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </row>
    {:else}
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center"
        disabled={busy()}
        on:click={() => onSignIn()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground hover:bg:hover-bg">
        <sui-icon name="log-in" size="sm"></sui-icon>
        <span>{signInLabel()}</span>
      </row>
      <row class="action" part="action" type="button" role="menuitem" gap="2" align="center"
        on:click={() => onSettings()}
        sx="p:2 px:2_5 radius:sm cursor:pointer text:sm fg:foreground hover:bg:hover-bg">
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </row>
    {/if}
  </column>

  {#if error() !== ''}
    <div class="status-line err" role="status"
      sx="p:2 px:3_5 pb:3 text:xs fg:destructive">{error()}</div>
  {/if}
</div>
