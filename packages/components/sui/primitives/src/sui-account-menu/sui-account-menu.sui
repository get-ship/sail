<!--
  <sui-account-menu> — generic account affordance for a chrome strip.
  Trigger shows the identity (avatar + name) or "Sign in"; clicking opens a
  native-popover panel with plan info + actions.

  RUNTIME-FREE / SDK-FREE. The original @ship/chrome version subscribed to
  `ship.account.state()` via <data> and called `navigate()` + `@ship/sdk-client`
  helpers directly. Here ALL of that is parameterized out: the identity arrives
  as plain props and every action leaves as an event. The consuming app wires
  the subscription, the router, and the SDK calls.

  Prop surface (the app maps its live account state onto these)
  ────────────────────────────────────────────────────────────────────────
    status (signed-out|signed-in|pending, 'signed-out', reflect)
    name / email / image / plan (string)   identity display fields
    provider (string)                       e.g. "Ship Cloud" — folded into
                                            the sign-in label + connect hint
    busy (bool)                             disables the in-flight action
    error (string)                          surfaces an error line
    placement (union, 'bottom-end', reflect)
    label-style (text|compact, 'text', reflect)  compact = avatar + caret only
  ────────────────────────────────────────────────────────────────────────
  Events (bubbling, composed) — the app does the actual work:
    sui-account-signin {}     sui-account-signout {}
    sui-account-settings {}   sui-account-billing {}
    sui-account-menu-ready {} (once after mount)
  Parts: trigger, avatar, name, panel
-->

<prop name="status" values="signed-out|signed-in|pending" default="signed-out" reflect />
<prop name="name" type="string" default="" />
<prop name="email" type="string" default="" />
<prop name="image" type="string" default="" />
<prop name="plan" type="string" default="" />
<prop name="provider" type="string" default="" />
<prop name="busy" type="bool" default="false" />
<prop name="error" type="string" default="" />
<prop name="placement" values="top|top-end|bottom|bottom-end|left|left-end|right|right-end" default="bottom-end" reflect />
<prop name="label-style" values="text|compact" default="text" reflect />

<style>
:host {
  position: relative;
  display: inline-flex;
}
:host([hidden]) { display: none; }

.trigger {
  appearance: none;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  padding: 3px 6px 3px 3px;
  font: inherit;
  font-size: var(--text-sm);
  color: var(--foreground);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 220px;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}
.trigger:hover { background: var(--hover-bg); }
.trigger:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--ring);
}

.avatar, .avatar-fallback {
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 0 0 1px var(--border-subtle);
}
.avatar { object-fit: cover; }
.avatar-fallback {
  background: var(--tone-primary-bg);
  color: var(--primary);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.avatar-fallback.signed-out {
  background: var(--hover-bg);
  color: var(--muted-foreground);
}

.name {
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 14ch;
  line-height: 1;
}

:host([label-style='compact']) .name { display: none; }

.caret {
  width: 10px; height: 6px;
  flex: 0 0 auto;
  color: var(--muted-foreground);
}

.panel {
  position: fixed;
  inset: auto;
  margin: 0;
  border: 0;
  padding: 0;
  width: 280px;
  background: var(--popover);
  color: var(--popover-foreground);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  opacity: 0;
  transform: translateY(-4px) scale(0.97);
  transition:
    opacity var(--duration-medium) var(--ease-out),
    transform var(--duration-medium) var(--ease-out);
}
.panel:popover-open {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.panel::backdrop { background: transparent; }
@media (prefers-reduced-motion: reduce) {
  .panel { transition: none; transform: none !important; }
}

.id-block {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: var(--space-3) 14px;
  border-bottom: 1px solid var(--border);
}
.id-block .avatar,
.id-block .avatar-fallback {
  width: 36px;
  height: 36px;
  font-size: var(--text-base);
}
.id-stack {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.id-name {
  font-weight: 600;
  font-size: var(--text-base);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.id-email {
  color: var(--muted-foreground);
  font-size: 11.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.plan {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted-foreground);
  padding: 2px 6px;
  border-radius: var(--radius-full);
  background: var(--hover-bg);
  flex: 0 0 auto;
}

.actions { display: flex; flex-direction: column; padding: var(--space-1); }
.action {
  appearance: none;
  background: transparent;
  border: 0;
  border-radius: var(--radius-sm);
  padding: var(--space-2) 10px;
  cursor: pointer;
  text-align: left;
  font: inherit;
  font-size: 12.5px;
  color: var(--foreground);
  display: flex;
  align-items: center;
  gap: 10px;
  transition: background var(--duration-fast) var(--ease-out);
}
.action:hover { background: var(--hover-bg); }
.action:focus-visible {
  outline: none;
  background: var(--hover-bg);
  box-shadow: inset 0 0 0 2px var(--ring);
}
.action.danger { color: var(--destructive); }
.action[disabled] { opacity: 0.5; cursor: default; }
.action .meta { margin-left: auto; color: var(--muted-foreground); font-size: var(--text-xs); }
.divider {
  height: 1px;
  margin: var(--space-1) 0;
  background: var(--border);
}
.status-line {
  padding: var(--space-2) 14px var(--space-3);
  font-size: 11.5px;
  color: var(--muted-foreground);
}
.status-line.err { color: var(--destructive); }
</style>

<button class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  aria-haspopup="dialog"
  aria-expanded={panelOpen() ? 'true' : 'false'}
  aria-label={triggerAria()}
  title={triggerAria()}
  on:click={() => togglePanel()}>
  {#if status() === 'signed-in' && image() !== ''}
    <img class="avatar" part="avatar" src={image()} alt="" />
  {:else if status() === 'signed-in'}
    <span class="avatar-fallback" part="avatar" aria-hidden="true">{initials()}</span>
  {:else}
    <span class="avatar-fallback signed-out" part="avatar" aria-hidden="true">
      <sui-icon name="user" size="sm"></sui-icon>
    </span>
  {/if}
  <span class="name" part="name">{triggerLabel()}</span>
  <svg class="caret" viewBox="0 0 10 6" aria-hidden="true">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<div class="panel" part="panel" popover="auto" bind:this={panelEl} role="menu" aria-label="Account">
  {#if status() === 'signed-in'}
    <div class="id-block">
      {#if image() !== ''}
        <img class="avatar" src={image()} alt="" />
      {:else}
        <span class="avatar-fallback" aria-hidden="true">{initials()}</span>
      {/if}
      <div class="id-stack">
        <span class="id-name">{name() !== '' ? name() : 'Account'}</span>
        {#if email() !== ''}
          <span class="id-email">{email()}</span>
        {/if}
      </div>
      {#if plan() !== ''}
        <span class="plan">{plan()}</span>
      {/if}
    </div>
  {:else}
    <div class="id-block">
      <span class="avatar-fallback signed-out" aria-hidden="true">
        <sui-icon name="user" size="sm"></sui-icon>
      </span>
      <div class="id-stack">
        <span class="id-name">Not signed in</span>
        <span class="id-email">{disconnectedHint()}</span>
      </div>
    </div>
  {/if}

  <div class="actions" role="none">
    {#if status() === 'signed-in'}
      <button class="action" type="button" role="menuitem" on:click={() => onSettings()}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
      <button class="action" type="button" role="menuitem" on:click={() => onBilling()}>
        <sui-icon name="credit-card" size="sm"></sui-icon>
        <span>Billing</span>
        <sui-icon class="meta" name="external-link" size="sm"></sui-icon>
      </button>
      <div class="divider" role="separator"></div>
      <button class="action danger" type="button" role="menuitem"
        disabled={busy()}
        on:click={() => onSignOut()}>
        <sui-icon name="log-out" size="sm"></sui-icon>
        <span>Sign out</span>
      </button>
    {:else if status() === 'pending'}
      <button class="action" type="button" role="menuitem" disabled>
        <sui-icon name="loader" size="sm"></sui-icon>
        <span>Completing sign-in…</span>
      </button>
      <button class="action" type="button" role="menuitem" on:click={() => onSettings()}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
    {:else}
      <button class="action" type="button" role="menuitem"
        disabled={busy()}
        on:click={() => onSignIn()}>
        <sui-icon name="log-in" size="sm"></sui-icon>
        <span>{signInLabel()}</span>
      </button>
      <button class="action" type="button" role="menuitem" on:click={() => onSettings()}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
    {/if}
  </div>

  {#if error() !== ''}
    <div class="status-line err" role="status">{error()}</div>
  {/if}
</div>
