<!--
  <sui-cluster> — horizontal flex group that wraps. The lateral
  counterpart to <sui-stack>.

  Use when you have a row of items (chips, action buttons, breadcrumb
  segments) that may exceed the available width and should wrap onto
  the next line with the same gap between rows. The default vertical
  alignment is `center` because most clusters are mixed-height items
  (icon + label, badge + text).

  Prop / event / slot
  ─────────────────────────────────────────────────────────────────────
  gap     (enum, '3')   1..8 → var(--space-N). 0 = no gap.
  align   (enum, 'center')  start|center|end|baseline — align-items.
                            Not reflected: `align` is a legacy HTML
                            presentational attribute; reflection would
                            write it onto the host and browsers may apply
                            text-align as an inherited presentation hint.
                            Use markup `align="…"` or template binding.
  justify (enum, 'start') start|center|end|between|around — justify.
  ─────────────────────────────────────────────────────────────────────
  (no events)
  ─────────────────────────────────────────────────────────────────────
  slots: (default)
  parts: (none)
-->

<prop name="gap" values="0|1|2|3|4|5|6|7|8" default="3" reflect />
<prop name="align" values="start|center|end|baseline" default="center" />
<prop name="justify" values="start|center|end|between|around" default="start" reflect />
<prop name="direction" values="row|column" default="row" reflect />

<style>
  :host {
    display: block;
    /* min-width:0 so a cluster nested in a flex/grid parent can shrink instead
       of forcing the parent wider — overflow is structurally impossible. */
    min-width: 0;
    --cluster-gap: var(--space-3);
  }
  :host([hidden]) { display: none; }

  :host([gap='0']) { --cluster-gap: 0; }
  :host([gap='1']) { --cluster-gap: var(--space-1); }
  :host([gap='2']) { --cluster-gap: var(--space-2); }
  :host([gap='3']) { --cluster-gap: var(--space-3); }
  :host([gap='4']) { --cluster-gap: var(--space-4); }
  :host([gap='5']) { --cluster-gap: var(--space-5); }
  :host([gap='6']) { --cluster-gap: var(--space-6); }
  :host([gap='7']) { --cluster-gap: var(--space-7); }
  :host([gap='8']) { --cluster-gap: var(--space-8); }

  .cluster {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cluster-gap);
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }
  /* direction="column" makes it a wrapping vertical group (rare, but symmetric
     with the row default); row is the default. */
  :host([direction='column']) .cluster { flex-direction: column; align-items: flex-start; }
  /* Slotted children default to min-width:0 so long labels/paths/dates wrap or
     ellipsize inside the cluster instead of overflowing (the missions title,
     claim meta, etc. — fixed structurally, not per-page). */
  .cluster ::slotted(*) { min-width: 0; }
  :host([align='start'])    .cluster { align-items: flex-start; }
  :host([align='center'])   .cluster { align-items: center; }
  :host([align='end'])      .cluster { align-items: flex-end; }
  :host([align='baseline']) .cluster { align-items: baseline; }

  :host([justify='start'])   .cluster { justify-content: flex-start; }
  :host([justify='center'])  .cluster { justify-content: center; }
  :host([justify='end'])     .cluster { justify-content: flex-end; }
  :host([justify='between']) .cluster { justify-content: space-between; }
  :host([justify='around'])  .cluster { justify-content: space-around; }
</style>

<div class="cluster"><slot></slot></div>
