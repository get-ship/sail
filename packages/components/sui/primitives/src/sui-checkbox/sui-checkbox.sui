<!--
  <sui-checkbox> — SUI port of <ship-checkbox>.
  Wraps a native <input type="checkbox"> for form participation and
  keyboard access. Controller handles indeterminate sync, event dispatch.

  Prop / event / method parity vs <ship-checkbox>
  ────────────────────────────────────────────────────────────────────────
  Lit                            SUI                       Notes
  ────────────────────────────────────────────────────────────────────────
  checked (Boolean, false)       checked (bool, false,     ✓ two-way via bind:checked
                                   reflect)
  indeterminate (Boolean, false) indeterminate (bool,      ✓ native prop synced in
                                   false, reflect)           controller; CSS drives
                                                             glyph visibility
  disabled (Boolean, false)      disabled (bool, false,    ✓
                                   reflect)
  required (Boolean, false)      required (bool, false,    ✓
                                   reflect)
  invalid (Boolean, false)       invalid (bool, false,     ✓ destructive border override
                                   reflect)
  tone (Tone)                    tone (union, 'default',   ✓ tints fill and focus ring
                                   reflect)
  size (Size, 'md')              size (sm|md|lg, 'md',     ✓ 14/16/18px square
                                   reflect)
  name (String, '')              name (string)             ✓
  value (String, 'on')           value (string, 'on')      ✓
  label (String, '')             label (string)            ✓ → aria-label on input
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change            sui-change                ✓ renamed; detail.checked
    { detail: { checked } }        { detail: { checked,      + value added
                                     value } }
  ────────────────────────────────────────────────────────────────────────
  Slots: (default)               (default)                 ✓ label content
  Parts: input, box, label       input, box, label         ✓
  ────────────────────────────────────────────────────────────────────────
  formAssociated / internals     NATIVE                    `form-value` on checked,
                                                           `form-disabled` on disabled
                                                           wire ElementInternals.
                                                           setFormValue emits the
                                                           stringified bool ('true'/
                                                           'false') — host scripts
                                                           that need HTML-checkbox
                                                           semantics (value-only
                                                           when checked) should call
                                                           internals.setFormValue
                                                           themselves.
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="checked" type="bool" default="false" reflect form-value />
<prop name="indeterminate" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="required" type="bool" default="false" reflect />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="name" type="string" default="" />
<prop name="value" type="string" default="on" />
<prop name="label" type="string" default="" />

<!-- Theme channels:
       - `tone` is the fill the checked/indeterminate box paints with.
       - `tone-on-fg` is the contrasting ink the glyph draws in.
     The same names live as :host custom props (--tone, --tone-on-fg) so
     the residual <style> can still reference them. The theme
     directive emits
     var(--<name>) per channel; static-token fills become var(--foreground)
     etc. The `default` and `primary` rows collapse to the same tokens
     because the original CSS gave them identical values. -->
<theme prop="tone" channels="tone, tone-on-fg">
  default:     primary,          primary-foreground
  primary:     primary,          primary-foreground
  info:        info,             info-foreground
  success:     success,          success-foreground
  warning:     warning,          warning-foreground
  destructive: destructive,      destructive-foreground
  accent:      accent,           accent-foreground
  muted:       muted-foreground, background
</theme>

<!-- Size drives the box dimensions and corner radius, both consumed as
     sx channels (w:/h:/radius:). The `--cb-stroke` raw-pixel value
     is NOT a channel because theme directives emit var(--<name>) and
     `2px` / `1.75px` / `2.25px` aren't token names; it stays in the
     residual <style> as per-size :host declarations. -->
<theme prop="size" channels="cb-size, cb-radius">
  default: icon-size-md, radius-sm
  sm:      icon-size-sm, radius-sm
  md:      icon-size-md, radius-sm
  lg:      icon-size-lg, radius-sm
</theme>

<!-- The disabled state flips the host's own ink to muted-foreground
     (the [disabled] box filter saturate(.6) and the disabled
     <label> cursor are on their own selectors below). The [hidden]
     host display:none is provided by the runtime's BASE_CSS, so
     declaring it here would be deduped at emit. -->
<variants>
  disabled: fg:muted-foreground
</variants>

<!-- Label cursor flips to not-allowed when the host is disabled. -->
<variants part="label">
  disabled: cursor:not-allowed
</variants>

<!-- Box visual state per host attr. The static-token parts (border
     color, background, shadow) are reachable through a variants block; the
     theme-driven `bg: var(--tone)` for checked/indeterminate isn't
     (variants only lower static sx values, never theme channels) and
     is patched in by a single residual rule below. The two
     (disabled, [checked]) / (disabled, [indeterminate]) compounds
     override the fill for the muted-checked case (disabled should
     mute even when checked/indeterminate). The `[hidden]` host rule
     above already hides the host; the box part does not need to
     repeat it. -->
<variants part="box">
  invalid:                       border:destructive
  disabled:                      bg:muted border:border shadow:none
  [checked],[indeterminate]:     border:selected-border shadow:xs
  ([disabled], [checked]):       bg:muted border:border
  ([disabled], [indeterminate]): bg:muted border:border
</variants>
<!-- Mixed-bar visibility. The check glyph's visibility can't be
     expressed in a variants block because it requires `:not([indeterminate])`
     (which the variant selector grammar doesn't accept); the matching
     rule for the check part is in the residual <style> instead. -->
<variants part="mixed">
  [indeterminate]: opacity:100
</variants>

<!-- Host baseline: surface-only sx props. Vertical-align, font-family,
     gap, align-items, -webkit-tap-highlight-color stay in the residual
     style block (the host isn't a real element, so no layout primitive
     lowers into it; sx has no vertical-align/font-family/align-items
     tokens). -->
<host sx="display:inline-flex fg:foreground text:base"></host>

<style>
  /* Local markers so the css-token lint recognizes the theme channels
   * + tokens referenced from this residual block. */
  --cb-stroke: ; --cb-size: ; --cb-radius: ; --tone: ; --tone-on-fg: ; --foreground: ; --text-base: ; --font-body: ; --space-2: ; --border-strong: ; --shadow-xs: ; --shadow-sm: ; --destructive: ; --selected-border: ; --muted: ; --muted-foreground: ; --border: ; --duration-fast: ; --ease-out: ; --focus-ring: ; --focus-ring-offset: ; --leading-tight: ; --radius-sm: ; --icon-size-md: ; --icon-size-sm: ; --icon-size-lg: ; --surface-1: ;

  /* Residual (the unavoidable bits):
     1. Host baseline (vertical-align, font-family, -webkit-tap-highlight-color,
        align-items, gap) — the host isn't an element sx lowers into.
     2. `--cb-stroke` per size — raw px values, not tokens; theme
        directives emit var(--<name>) so 2px / 1.75px / 2.25px can't be
        channel fills.
     3. <label> hand-rolled flex (display:inline-flex, align-items, gap) +
        user-select — the <label> is a form-control element with click-to-
        toggle semantics; the row keyword lowers to a div and would break
        the a11y label association. cursor:pointer goes through sx on the
        element.
     4. .box's flex-shrink + box-sizing + multi-prop transition — sx has
        no flex-shrink / box-sizing / transition; display:inline-block +
        position:relative + the surface props go through sx on the
        element. (The original .box had align-items/justify-content for a
        flex center that was dead — the .glyph children are absolutely
        positioned, so the flex centering had no effect; dropped.)
     5. Checked/indeterminate fill — the `bg: var(--tone)` rule needs the
        theme channel, which a variants block can't lower (variants only
        see static sx values). One small residual rule, kept adjacent
        to the box variants block it complements.
     6. `label:hover .box` ancestor-state → descendant selector — sx has
        no `group-` family for this (the parent-attr negation
        :not([disabled]):not([checked]):not([indeterminate]) isn't
        expressible in the variant grammar either).
     7. .glyph inset + display + align/justify + transform + transition
        + pointer-events — no inset/transform/transition/pointer-events
        in sx; `position:absolute`, `fg:tone-on-fg`, `opacity:0` go
        through sx on the element.
     8. Check glyph visibility — `:host([checked]:not([indeterminate]))`
        can't be a variants selector; mixed's transform:scale(1) reset
        (the transform itself isn't reachable through sx).
     9. .glyph.check::before / .glyph.mixed::before pseudo-elements —
        sx doesn't reach pseudo-elements; the --cb-stroke raw value they
        read also lives here.
     10. Native <input> — visually hidden but preserved for a11y +
         form submission; position/inset/width/height/etc. are all
         non-sx.
     11. `label:has(input:focus-visible) .box` — sx has no :has support;
         the same shape applies to the invalid variant.
     12. @media (forced-colors) — system CanvasText / Highlight /
         HighlightText colors aren't tokens; the original three rules
         and the focus-outline override stay.
     13. @media (prefers-reduced-motion) — covers all transitions and
         animations globally, not per-element.
     14. :host([disabled]) .box { filter: saturate(0.6) } — filter isn't
         in sx; the color side of disabled moved into a variants block
         (fg:muted-foreground).
     15. ::slotted(*) — font: inherit + color: inherit + line-height for
         light-DOM slotted label text. */

  :host {
    align-items: center;
    gap: var(--space-2);
    vertical-align: middle;
    font-family: var(--font-body);
    -webkit-tap-highlight-color: transparent;
  }

  :host(:not([size])),
  :host([size='md']) { --cb-stroke: 2px; }
  :host([size='sm']) { --cb-stroke: 1.75px; }
  :host([size='lg']) { --cb-stroke: 2.25px; }

  label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    user-select: none;
    -webkit-user-select: none;
  }

  .box {
    flex-shrink: 0;
    box-sizing: border-box;
    /* De-translated from sx (w:cb-size h:cb-size radius:cb-radius) — ad-hoc
       theme channels are not sx vocabulary; the channel-driven dimensions
       live here with the rest of the box's irreducible styling. */
    width: var(--cb-size);
    height: var(--cb-size);
    border-radius: var(--cb-radius);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  /* The theme-driven fill — the only piece the box variants block
     can't own because variants only lower static sx, never channels. */
  :host([checked]) .box,
  :host([indeterminate]) .box {
    background: var(--tone);
  }

  :host(:not([disabled]):not([checked]):not([indeterminate])) label:hover .box {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  :host([invalid]:not([disabled])) label:hover .box {
    border-color: var(--destructive);
  }
  :host([checked]:not([disabled])) label:hover .box,
  :host([indeterminate]:not([disabled])) label:hover .box {
    box-shadow: var(--shadow-sm);
  }

  .glyph {
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* De-translated from sx (fg:tone-on-fg) — a per-component theme channel,
       not sx vocabulary. The glyph ink follows the tone's on-color. */
    color: var(--tone-on-fg);
    transform: scale(0.6);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }
  /* Check glyph visibility — `:not([indeterminate])` isn't a variants
     selector grammar. The transform:scale(1) reset pairs with the
     mixed's, since the variants rule for part='mixed' only sets opacity. */
  :host([checked]:not([indeterminate])) [part='check'] {
    opacity: 1;
    transform: scale(1);
  }
  :host([indeterminate]) [part='mixed'] {
    transform: scale(1);
  }

  /* Check mark: rotated L-shape via borders. */
  .glyph.check::before {
    content: '';
    display: block;
    width: 45%;
    height: 28%;
    border-left: var(--cb-stroke) solid currentColor;
    border-bottom: var(--cb-stroke) solid currentColor;
    transform: rotate(-45deg) translate(0, -15%);
  }
  /* Indeterminate bar. */
  .glyph.mixed::before {
    content: '';
    display: block;
    width: 60%;
    height: var(--cb-stroke);
    background: currentColor;
    border-radius: var(--radius-sm);
  }

  /* Native input — visually hidden but preserved for a11y + form submission. */
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: inherit;
    appearance: none;
    -webkit-appearance: none;
  }

  :host(:not([disabled])) label:has(input:focus-visible) .box {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  :host([invalid]:not([disabled])) label:has(input:focus-visible) .box {
    --ring-color: var(--destructive);
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (forced-colors: active) {
    .box { border-color: CanvasText; }
    :host([checked]) .box,
    :host([indeterminate]) .box { background: Highlight; }
    .glyph { color: HighlightText; }
    :host(:not([disabled])) label:has(input:focus-visible) .box {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }

  :host([disabled]) .box {
    filter: saturate(0.6);
  }

  ::slotted(*) {
    font: inherit;
    color: inherit;
    line-height: var(--leading-tight);
  }
</style>

<label part="label" sx="cursor:pointer">
  <span class="box" part="box"
    sx="position:relative display:inline-block bg:surface-1 border:strong shadow:xs">
    <input
      part="input"
      type="checkbox"
      bind:checked={checked}
      disabled={disabled()}
      required={required()}
      name={name()}
      value={value()}
      aria-checked={indeterminate() ? 'mixed' : (checked() ? 'true' : 'false')}
      aria-invalid={invalid() ? 'true' : 'false'}
      aria-label={label() || name() || 'checkbox'}
      bind:this={inputEl}
    />
    <span class="glyph check" part="check" aria-hidden="true"
      sx="position:absolute opacity:0"></span>
    <span class="glyph mixed" part="mixed" aria-hidden="true"
      sx="position:absolute opacity:0"></span>
  </span>
  <slot></slot>
</label>
