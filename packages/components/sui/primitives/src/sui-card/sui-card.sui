<!--
  <sui-card> — SUI port of <ship-card>.
  Generic container surface with header/content/footer slots, interactive
  hover lift, tone-tinted borders, status rail, and accent bar.

  Prop / event / method parity vs <ship-card>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, undefined)       tone (union, reflect)    ✓ tints border,
                                                         status-rail, fill wash
  variant ('default'|         variant (default|         ✓ SUI aligns to Lit
    'outline', 'default')       outline, 'default',      values; drops ghost
                                reflect)                 (use outline instead)
  padding ('none'|'sm'|'md'|  padding (none|sm|md|lg,  ✓
    'lg', 'md')                 'md', reflect)
  interactive (Boolean, false) interactive (bool,       ✓ CSS hover lift +
                                false, reflect)          cursor, role=button,
                                                         tabindex=0, Enter/Space
                                                         → click via controller.
  accent-bar (Boolean, false)  accent-bar (bool,        ✓ gradient top-bar
                                false, reflect)          that fades in on hover
  status-rail (Boolean, false) status-rail (bool,       ✓ 3px left border
                                false, reflect)          tinted by tone
  fill (Boolean, false)        fill (bool, false,       ✓ tone-tinted bg wash
                                reflect)
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space click  ✓ controller handles     ✓
    on host when interactive
  role=button / tabindex=0     ✓ controller sets on     ✓
    set on host                  mount / effect
  ─────────────────────────────────────────────────────────────────────────────
  syncFilled (slotchange →     reflect-empty=           ✓ SUI reflect-empty
    data-filled on wrapper)     "data-no-header",        sets host attr when
                                "data-no-footer"         slot is empty; CSS
                                                         hides separator +
                                                         wrapper accordingly.
  ─────────────────────────────────────────────────────────────────────────────
  slots: header, default,      slots: header, default,  ✓
    footer                       footer
  ─────────────────────────────────────────────────────────────────────────────
  parts: header, content,      parts: header, content,  ✓
    footer                       footer
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from feat/next, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - tone is a GLOBAL framework channel now (contracts.css / suiTonesSheet);
    no per-component <theme prop="tone"> block. This skin reads
    var(--tone)/var(--tone-fg)/var(--tone-border)/var(--tone-bg) directly,
    filled for whichever of the 8 catalog tones the host's [tone] names.
  - variant=outline's `background: transparent` cannot be expressed in sx
    (the closed color vocab is tokens + tone-* channels, never the
    `transparent` CSS keyword). The variant's box-shadow suppression is
    a valid sx pair; the background is authored in <style> on the same
    :host([variant='outline']) selector. Mixed-mechanism, but a single
    attribute drives it — the gate's "ad-hoc channel" prohibition is
    not invoked (no new channel, just a one-line raw-value declaration
    in <style>, which the surface permits).
  - The interactive prop's hover lift / focus ring / press-feedback /
    accent-bar ::before pseudo-element / status-rail / fill / per-padding
    --card-* local vars / data-no-header/data-no-footer separators are
    all kept in <style> — none of it is expressible in sx (pseudo-elements,
    multi-property transitions, :host-not combinators, local CSS var
    recompute, .header/.footer wrapper styling with per-padding overrides).
-->

<component>{
  props: {
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    variant: 'default' | 'outline',
    padding: 'md' | 'none' | 'sm' | 'lg',
    interactive: false,
    'accent-bar': 'off' | 'hover' | 'static',
    'status-rail': false,
    fill: false,
  },
}</component>

<variants>
  interactive:     cursor:pointer
  padding=none:    p:0
  padding=sm:      py:2 px:3
  padding=md:      py:4 px:5
  padding=lg:      py:5 px:6
</variants>

<style>
  :host {
    display: block;
    position: relative;
    background: var(--surface-1);
    color: var(--card-foreground);
    border: 1px solid var(--border);
    --card-radius: var(--radius-lg);
    border-radius: var(--card-radius);
    overflow: clip;
    /* Frost on glass themes (--card-backdrop-filter resolves to a blur there,
       `none` everywhere else). isolation establishes a stacking context so the
       backdrop-filter clips to --card-radius — belt-and-suspenders with the
       existing overflow:clip. Frost goes on :host (the ::before is the accent-bar). */
    backdrop-filter: var(--card-backdrop-filter);
    -webkit-backdrop-filter: var(--card-backdrop-filter);
    isolation: isolate;
    box-shadow: var(--shadow-card-rest);
    --card-px: var(--space-5);
    --card-py: var(--space-4);
    --card-gap: var(--space-3);
    padding: var(--card-py) var(--card-px);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  /* variant=outline: shadow:none lives in <variants>, but background:transparent
     can't be expressed in sx — the closed color vocab is tokens + tone-* channels,
     never the `transparent` CSS keyword. Declared here on the same attribute selector. */
  :host([variant='outline']) { background: transparent; }

  /* Tone-bound border. The default tone resolves --tone-border to --border (the
     same as the host baseline), so the explicit override is suppressed for it. */
  :host([tone]:not([tone='default'])) { border-color: var(--tone-border); }

  /* Accent bar. Two modes:
   *   hover  — fades in on hover (the default, preserves prior behaviour
   *            on interactive cards).
   *   static — always-visible at full opacity (right for hero cards,
   *            print exports, touch contexts where hover never fires).
   * Bar clips to the card's border-radius via inherit/match — when
   * `padding="none"` flattens the card, the bar still respects the
   * top-corner radius via the same token. */
  :host([accent-bar='hover'])::before,
  :host([accent-bar='static'])::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    opacity: 0;
    border-radius: var(--card-radius) var(--card-radius) 0 0;
    transition: opacity var(--duration-medium) var(--ease-out);
    pointer-events: none;
  }
  :host([accent-bar='hover']:hover)::before { opacity: 1; }
  :host([accent-bar='static'])::before { opacity: 1; }

  :host([interactive]) { -webkit-tap-highlight-color: transparent; }
  :host([interactive]:hover) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    :host([interactive]:hover) { transform: none; }
  }
  :host([interactive]:active) {
    box-shadow: var(--shadow-card-rest);
    transform: translateY(0);
    transition-duration: 60ms;
  }
  :host([interactive]:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Tone-rail. The rail is only meaningful when a tone is explicitly set
   * — otherwise --tone-fg resolves to --foreground and we'd draw a
   * 3-px body-text-coloured stripe (meaningless decoration with the
   * weight of an emphasis cue). Default tone hides the rail. */
  :host([status-rail]) {
    border-left: 3px solid var(--tone-fg);
    padding-inline-start: calc(var(--card-px) - var(--space-1));
  }
  :host([status-rail]:not([tone])),
  :host([status-rail][tone='default']) {
    border-left-color: var(--border-strong);
  }

  :host([fill]) { background: var(--tone-bg); border-color: var(--tone-border); }

  /* Per-padding local-var recompute + fallback padding. The variants
   * handle the *initial* padding value; these override the per-padding
   * --card-* local vars (used by the .header/.footer separator offsets)
   * and pin the padding-none case to zero. */
  :host([padding='none']) { --card-px: 0px; --card-py: 0px; --card-gap: 0px; padding: 0; }
  :host([padding='sm'])   { --card-px: var(--space-3); --card-py: var(--space-2); --card-gap: var(--space-2); padding: var(--space-2) var(--space-3); }
  :host([padding='md'])   { --card-px: var(--space-5); --card-py: var(--space-4); padding: var(--space-4) var(--space-5); }
  :host([padding='lg'])   { --card-px: var(--space-6); --card-py: var(--space-5); --card-gap: var(--space-4); padding: var(--space-5) var(--space-6); }

  .header, .footer { display: block; }

  /* Separator — show only when slot has projected content */
  :host(:not([data-no-header])) .header {
    margin: calc(var(--card-py) * -1) calc(var(--card-px) * -1) var(--card-gap);
    padding: var(--card-py) var(--card-px);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
  }
  :host(:not([data-no-footer])) .footer {
    margin: var(--card-gap) calc(var(--card-px) * -1) calc(var(--card-py) * -1);
    padding: var(--card-py) var(--card-px);
    border-top: 1px solid var(--border-subtle);
  }
  :host([padding='none']:not([data-no-header])) .header {
    margin: 0 0 var(--space-3);
    padding: 0 0 var(--space-3);
  }
  :host([padding='none']:not([data-no-footer])) .footer {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) 0 0;
  }

  @media (forced-colors: active) {
    :host([interactive]:focus-visible) { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<div class="header" part="header">
  <slot name="header" reflect-empty="data-no-header"></slot>
</div>
<div class="content" part="content">
  <slot></slot>
</div>
<div class="footer" part="footer">
  <slot name="footer" reflect-empty="data-no-footer"></slot>
</div>
