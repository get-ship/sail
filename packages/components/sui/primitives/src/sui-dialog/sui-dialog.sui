<!--
  <sui-dialog> — SUI port of <ship-dialog>.
  Modal dialog on the native <dialog> element. showModal() puts it in the
  top layer; the browser handles ::backdrop, ESC key, and focus return.

  Prop / event / method parity vs <ship-dialog>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  size (sm|md|lg|full, 'md')   size (union, 'md', reflect)  ✓
  backdrop (dflt|blur|solid)   backdrop (union, reflect)    ✓
  dismissible (bool, true)     dismissible (bool, true)     ✓ no reflect — JS only
  no-close-button (bool)       no-close-button (bool, ref)  ✓
  no-header / no-footer        no-header / no-footer        ✓
  role-override (dlg|alertdlg) role-override (union, ref)   ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-open/close/dismiss → sui-open/close/dismiss              ✓
  Methods: show(), showModal(), close()                                  ✓
  Slots: header, (default), footer                                       ✓
  Parts: dialog, header, body, footer, close                             ✓
  Focus trap: sentinel divs + collectFocusables across shadow+light DOM  ✓
  Scroll lock: acquireScrollLock / releaseScrollLock                     ✓
  ────────────────────────────────────────────────────────────────────────
-->
<!--
  NEW SURFACE (re-port from feat/next baseline, parity-gate pass).
  Highlighted in the inline NOTE blocks above each section. Size
  contract is global now, the legacy per-host dlg-* channels are
  gone, the close button is a bare framework control and only the
  irreducible positioning remains in <style>.
-->
<prop name="open" type="bool" default="false" reflect />
<prop name="size" values="sm|md|lg|full" default="md" reflect />
<prop name="backdrop" values="default|blur|solid" default="default" reflect />
<prop name="dismissible" type="bool" default="true" />
<prop name="no-close-button" type="bool" default="false" reflect />
<prop name="no-header" type="bool" default="false" reflect />
<prop name="no-footer" type="bool" default="false" reflect />
<prop name="role-override" values="dialog|alertdialog" default="dialog" reflect />

<variants part="dialog">
  size=sm: max-w:panel-max-w-sm px:5
  size=md: max-w:panel-max-w-md px:6
  size=lg: max-w:panel-max-w-lg px:7
  size=full: max-w:panel-vh-lg px:7
</variants>

<variants part="header">
  [no-header]: display:none
</variants>

<variants part="footer">
  [no-footer]: display:none
</variants>

<variants part="close">
  [no-close-button]: display:none
</variants>

<!--
  Residual <style> — bits the closed-vocabulary contract cannot
  express:
  - :host display: contents (no contents token in sx; the dialog
    mounts in-place so the sibling sui-portal marker can escape the
    dialog's shadow tree without re-parenting the panel)
  - dialog:not([open]) display: none (must override the browser
    default; a bare `display: flex` selector left a closed dialog
    painting a 2px artifact at viewport center)
  - dialog[open] position: fixed + inset: 0 + margin: auto (top-
    layer centering math, not sx-able) + padding: 0 (reset) +
    border + bg + color + width + max-height + box-shadow +
    font-family + display: flex + flex-direction: column + the
    :host([size='full']) max-height override
  - dialog::backdrop background + opacity + multi-prop transition
    (pseudo + multi-prop; sx has no transition shorthand)
  - :host([backdrop='blur'|'solid']) dialog::backdrop overrides
    (vendor-prefixed backdrop-filter + solid background; both
    bound to the global backdrop / background tokens, not raw)
  - .sentinel (1x1 fixed pointer-events: none opacity: 0) — raw
    pxs, the focus trap anchor, not sx-expressible
  - .header / .body / .footer per-size padding — sx variants can't
    target the host's [size] on a different element than the part
    itself, so :host() padding selectors stay. The close-button
    cutout (padding-right = horizontal-padding + space-7) is an
    irreducible calc(). The single-side borders and flex shorthand
    on these panels are also outside sx.
  - .close absolute positioning + the focus-visible ring + svg
    sizing — top/inset-inline-end have no sx equivalent. Skin +
    hover + focus wash come from the global L1 button skin
    (adoptSuiSheets in packages/sui/runtime/src/styles/index.ts
    now carries the control skins into every shadow root; the gap
    the alert pilot surfaced is closed), so this is positioning +
    the framework's ring, nothing more.
  - @media (prefers-reduced-motion) and @media (forced-colors) —
    both raw-CSS condition prefixes; sx's motion-reduce:/forced-
    colors: prefixes live in the variant + sx grammars but can't
    reach these bare selectors from inside the shadow tree.
  dialog:not([open]) { display: none; }
  dialog[open] {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    color: var(--card-foreground);
    width: calc(100vw - var(--space-7));
    max-height: min(calc(100vh - var(--space-7)), var(--panel-vh-md));
    box-shadow: var(--shadow-xl);
    font-family: var(--font-body);
    overflow: visible;
    display: flex;
    flex-direction: column;
  }
  :host([size='full']) dialog[open] { max-height: var(--panel-vh-lg); }
  .dialog-content { display: contents; }
  dialog::backdrop {
    background: var(--backdrop);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  dialog[open]::backdrop { opacity: 1; }
  :host([backdrop='blur']) dialog::backdrop {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  :host([backdrop='solid']) dialog::backdrop { background: var(--background); }
  .sentinel { position: fixed; width: 1px; height: 1px; pointer-events: none; opacity: 0; }
  .header {
    padding: var(--space-4_5) var(--space-6);
    padding-right: calc(var(--space-6) + var(--space-7));
    flex: 0 0 auto;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    border-bottom: 1px solid var(--border-subtle);
  }
  :host([size='sm']) .header { padding: var(--space-4) var(--space-5); padding-right: calc(var(--space-5) + var(--space-7)); }
  :host([size='lg']) .header,
  :host([size='full']) .header { padding: var(--space-5) var(--space-7); padding-right: calc(var(--space-7) + var(--space-7)); }
  .body {
    padding: var(--space-4) var(--space-6);
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    scrollbar-width: thin;
  }
  :host([size='sm']) .body { padding: var(--space-3_5) var(--space-5); }
  :host([size='lg']) .body,
  :host([size='full']) .body { padding: var(--space-5) var(--space-7); }
  .footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--border-subtle);
    background: var(--tone-muted-border);
    flex: 0 0 auto;
  }
  :host([size='sm']) .footer { padding: var(--space-3_5) var(--space-5); }
  :host([size='lg']) .footer,
  :host([size='full']) .footer { padding: var(--space-4_5) var(--space-7); }
  /* The close button is a framework <button ghost xs class="close"> —
     skin + hover + focus are owned by the L1 button skin (see
     suiControlsSheet in packages/sui/runtime/src/styles/index.ts, which
     adoptSuiSheets() now carries into every shadow root). Only the
     absolute positioning + the host focus ring remain here, because
     neither is reachable from sx or from the global skin. */
  .close {
    position: absolute;
    top: var(--space-3);
    inset-inline-end: var(--space-3);
    font: inherit;
    padding: 0;
    cursor: pointer;
  }
  .close:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .close svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }
  @media (prefers-reduced-motion: reduce) {
    dialog::backdrop { transition: none; }
  }
  @media (forced-colors: active) {
    dialog { border: 1px solid CanvasText; }
  }
</style>

<!--
  Why the open-conditional plus transition:fade wraps CONTENT (and
  not the native dialog element): the dialog must stay mounted so
  showModal() / .close() keep driving the top-layer and the
  ::backdrop paint; what fades is the content. The slot elements
  live inside the conditional branch, so they re-enter the shadow
  tree on every open and projection survives without juggling.

  Why sui-portal below: native showModal() already escapes parent
  stacking context via the browser top layer — the dialog does not
  NEED to teleport its panel. The portal supplies a document-level
  data-sui-dialog-open marker for page-level has() targets (global
  scroll lock, page chrome dimming) without poking into shadow
  DOM.
-->

<dialog part="dialog" bind:this={dialogEl}
  sx="radius:xl bg:surface-1 fg:card-foreground border:border shadow:xl">
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelStart}></span>
  <button ghost xs class="close" part="close" type="button" aria-label="Close dialog" bind:this={closeBtn}>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
      sx="w:icon-size-sm h:icon-size-sm">
      <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/>
    </svg>
  </button>
  {#if open()}
    <div class="dialog-content" transition:fade={{ duration: 150 }}>
      <div class="header" part="header" bind:this={headerEl}
        sx="text:lg weight:semibold fg:foreground">
        <slot name="header"></slot>
      </div>
      <div class="body" part="body" bind:this={bodyEl}
        sx="text:base leading:normal">
        <slot></slot>
      </div>
      <row class="footer" part="footer" gap="2" align="center"
        sx="bg:tone-muted-border">
        <slot name="footer"></slot>
      </row>
    </div>
  {/if}
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelEnd}></span>


</dialog>
{#if open()}
  <sui-portal target="body">
    <div class="sui-dialog-presence" aria-hidden="true" data-sui-dialog-open></div>
  </sui-portal>
{/if}
