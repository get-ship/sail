<!--
  <sui-dialog> — SUI port of <ship-dialog>.
  Modal dialog on the native <dialog> element. showModal() puts it in the
  top layer; the browser handles ::backdrop, ESC key, and focus return.

  Prop / event / method parity vs <ship-dialog>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  size (sm|md|lg|full, 'md')   size (union, 'md', reflect)  ✓
  backdrop (dflt|blur|solid)   backdrop (union, reflect)    ✓
  dismissible (bool, true)     dismissible (bool, true)     ✓ no reflect — JS only
  no-close-button (bool)       no-close-button (bool, ref)  ✓
  no-header / no-footer        no-header / no-footer        ✓
  role-override (dlg|alertdlg) role-override (union, ref)   ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-open/close/dismiss → sui-open/close/dismiss              ✓
  Methods: show(), showModal(), close()                                  ✓
  Slots: header, (default), footer                                       ✓
  Parts: dialog, header, body, footer, close                             ✓
  Focus trap: sentinel divs + collectFocusables across shadow+light DOM  ✓
  Scroll lock: acquireScrollLock / releaseScrollLock                     ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="size" values="sm|md|lg|full" default="md" reflect />
<prop name="backdrop" values="default|blur|solid" default="default" reflect />
<prop name="dismissible" type="bool" default="true" />
<prop name="no-close-button" type="bool" default="false" reflect />
<prop name="no-header" type="bool" default="false" reflect />
<prop name="no-footer" type="bool" default="false" reflect />
<prop name="role-override" values="dialog|alertdialog" default="dialog" reflect />

<style>
  :host { display: contents; }
  :host([hidden]) { display: none; }

  :host(:not([size])), :host([size='md']) { --dlg-max-w: var(--panel-max-w-md); --dlg-px: var(--space-6); --dlg-hpy: var(--space-4_5); --dlg-bpy: var(--space-4); --dlg-fpy: var(--space-4); }
  :host([size='sm']) { --dlg-max-w: var(--panel-max-w-sm); --dlg-px: var(--space-5); --dlg-hpy: var(--space-4); --dlg-bpy: var(--space-3_5); --dlg-fpy: var(--space-3_5); }
  :host([size='lg']) { --dlg-max-w: var(--panel-max-w-lg); --dlg-px: var(--space-7); --dlg-hpy: var(--space-5); --dlg-bpy: var(--space-5); --dlg-fpy: var(--space-4_5); }
  :host([size='full']) { --dlg-max-w: 90vw; --dlg-px: var(--space-7); --dlg-hpy: var(--space-5); --dlg-bpy: var(--space-5); --dlg-fpy: var(--space-4_5); }

  /* `dialog:not([open])` MUST stay display:none — overriding to
     display:flex on the bare selector caused a closed dialog to paint
     a 2px artifact at viewport center, visible as a faint horizontal
     line across every view that mounted a sui-dialog. Qualifying with
     `[open]` keeps the closed dialog hidden per browser default. */
  dialog:not([open]) { display: none; }
  dialog[open] {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    color: var(--card-foreground);
    width: calc(100vw - var(--space-7));
    max-width: var(--dlg-max-w);
    max-height: min(calc(100vh - var(--space-7)), var(--panel-vh-md));
    box-shadow: var(--shadow-xl);
    font-family: var(--font-body);
    overflow: visible;
    display: flex;
    flex-direction: column;
  }
  :host([size='full']) dialog[open] { max-height: var(--panel-vh-lg); }

  /* Open/close polish is driven by the `transition:fade` directive on
     the content wrapper (Web Animations API) and by the native
     ::backdrop fade below — no CSS transition on `dialog` itself. */
  .dialog-content {
    display: contents;
  }

  dialog::backdrop {
    background: var(--backdrop);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  dialog[open]::backdrop { opacity: 1; }
  :host([backdrop='blur']) dialog::backdrop { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  :host([backdrop='solid']) dialog::backdrop { background: var(--background); }

  .sentinel { position: fixed; width: 1px; height: 1px; pointer-events: none; opacity: 0; }

  .header {
    padding: var(--dlg-hpy) var(--dlg-px);
    padding-right: calc(var(--dlg-px) + var(--space-7));
    flex: 0 0 auto;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    border-bottom: 1px solid var(--border-subtle);
  }
  :host([no-header]) .header { display: none; }

  .body {
    padding: var(--dlg-bpy) var(--dlg-px);
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    scrollbar-width: thin;
  }

  .footer {
    padding: var(--dlg-fpy) var(--dlg-px);
    border-top: 1px solid var(--border-subtle);
    background: var(--tone-muted-border);
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
    align-items: center;
    flex: 0 0 auto;
  }
  :host([no-footer]) .footer { display: none; }

  .close {
    position: absolute;
    top: var(--space-3);
    inset-inline-end: var(--space-3);
    width: var(--control-h-sm); height: var(--control-h-sm);
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    cursor: pointer; padding: 0; font: inherit; z-index: var(--z-elevated);
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .close:hover { background: var(--muted); color: var(--foreground); }
  .close:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .close svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }
  :host([no-close-button]) .close { display: none; }

  @media (prefers-reduced-motion: reduce) {
    dialog::backdrop { transition: none; }
  }
  @media (forced-colors: active) {
    dialog { border: 1px solid CanvasText; }
  }
</style>

<!--
  Why the `{#if open()}` + `transition:fade` here (and not on the
  native dialog itself)? The dialog element must stay mounted so
  showModal()/.close() drive top-layer + ::backdrop; what fades is
  the *content*. The `<slot>` elements live inside the #if branch,
  so they re-enter the shadow tree on every open and projection
  survives without juggling.

  Why the `<sui-portal>` below? Native showModal() already escapes
  parent stacking context via the browser top layer — sui-dialog
  doesn't NEED to teleport its panel. The portal supplies a
  document-level `[data-sui-dialog-open]` marker that page-level
  styles (global scroll lock, chrome dimming, etc.) can target via
  `:has` selectors without poking into shadow DOM.
-->

<dialog part="dialog" bind:this={dialogEl}>
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelStart}></span>
  <button class="close" part="close" type="button" aria-label="Close dialog" bind:this={closeBtn}>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/>
    </svg>
  </button>
  {#if open()}
    <div class="dialog-content" transition:fade={{ duration: 150 }}>
      <div class="header" part="header" bind:this={headerEl}>
        <slot name="header"></slot>
      </div>
      <div class="body" part="body" bind:this={bodyEl}>
        <slot></slot>
      </div>
      <div class="footer" part="footer">
        <slot name="footer"></slot>
      </div>
    </div>
  {/if}
  <span tabindex="0" class="sentinel" aria-hidden="true" bind:this={sentinelEnd}></span>
</dialog>
{#if open()}
  <sui-portal target="body">
    <div class="sui-dialog-presence" aria-hidden="true" data-sui-dialog-open></div>
  </sui-portal>
{/if}
