<!--
  <sui-sheet> — Ship's cell-addressed spreadsheet primitive.

  Distinct from <sui-table> (a typed-record data-grid): a sheet renders an
  addressable 2-D CELL SPACE (A1 addressing, range selection, frozen bands,
  per-cell formats). The headless `createSheet()` engine arrives via
  `prop:sheet={sheet}` IDENTITY binding (never a serialized object attribute);
  the windowed center band renders the engine's `getCellAt(r,c)` cells through
  TWO createVirtualizer instances (rows + columns) over one viewport — the
  Backbone #2 two-axis stress. `workbook` is the SSR/declarative string fallback
  parsed in the controller.

  Frozen rows/cols render as sibling sticky quadrants OUTSIDE the windows. Cells
  are row/cell-shaped → they read the `--density-*` channel directly; there is NO
  density/dense prop (density is the platform `<html data-density>` axis).

  Events (host.emit): sui-cell-commit {a1, before, after}, sui-cells-change
  {edits}, sui-selection-change {active, ranges}, sui-active-sheet-change
  {sheetId}, sui-cell-activate {a1, row, col}.

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ────────────────────────────────────────────────────────────────────────
  - `size` is a declared union but the cells read `--density-row-py/-px`
    (the platform `<html data-density>` axis) — it does NOT route through
    the global size channels. The prop stays in `props:` for API
    completeness; styling stays density-driven, like the baseline.
  - The grid surface (background / border / radius / shadow) and the
    header-quadrant surfaces move onto `sx=`. The grid template (rows +
    columns), the absolute-positioned cells, the cell editor overlay, and
    the fill-handle stay raw — sx has no grid-template, no
    position:absolute + box-sizing composition that fits this layout,
    and the editor needs single-side box-shadows with raw values.
  - The `<variants part="cell" show-gridlines: …>` block is GONE — the
    show-gridlines cell borders live as a plain :host([show-gridlines])
    rule in <style>. The conditional is on the host attribute, not on
    a per-element part, so a host-scoped rule is the natural home.
  - The cell editor remains a hand-styled `<input class="cell-editor">`.
    The framework's L1 <input> skin sets border-radius: var(--radius-md)
    and a non-density padding, both of which would break the cell
    editor's flat-over-the-cell visual contract — see LANG-GAP below.
  - LANG-GAP: a bare `<input>` cannot paint as a flat cell overlay.
    The editor's `border: var(--ring-width) solid var(--ring-color);
    border-radius: 0; padding: var(--density-row-py) var(--density-row-px)`
    overrides the framework input skin (rounded box, non-density
    padding). Reported, not routed around — switching to a bare
    `<input>` would visually desync the editor from the cell beneath.
  - LANG-GAP (closed): this WAS the same gap that blocked the alert
    pilot's `<button ghost xs>` — and is now fixed by the
    shadow-adopt-control-skins work. The cell editor is NOT a
    button/checkbox-style control, so the fix doesn't apply to it; the
    editor remains bespoke.
-->

<component>{
  props: {
    workbook: '',
    label: '',
    readonly: false,
    'show-headers': true,
    'show-gridlines': true,
    'show-formula-bar': true,
    'selection-mode': 'range',
    size: 'md',
  },
}</component>

<style>
  /* Channel markers — surface and density. The css-token lint recognises
   * these as touched variables. */
  --sheet-radius: ;
  --sheet-header-w: ;
  --surface-1: ; --surface-2: ; --border: ; --divider: ;
  --shadow-xs: ; --shadow-xl: ; --z-elevated: ; --z-dropdown: ;
  --density-text: ; --density-row-py: ; --density-row-px: ;
  --foreground: ; --muted-foreground: ; --primary: ;
  --selected-bg: ; --ring-color: ; --ring-width: ;
  --text-xs: ; --font-weight-medium: ; --space-1: ; --space-2: ; --space-8: ;
  --panel-max-h-md: ; --card: ; --text-base: ; --font-body: ;

  /* The host is a block-level surface that owns the density channel. */
  :host {
    display: block;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--density-text);
    color: var(--foreground);
    --sheet-radius: var(--radius-lg);
    --sheet-header-w: var(--space-8);
  }
  :host([hidden]) { display: none; }

  /* Grid — the 2×2 quadrant surface. Background, border, radius, and
   * shadow are sx; the grid-template + overflow + position context
   * stay raw (sx has no grid-template, no position:relative). */
  .grid {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: var(--sheet-header-w) 1fr;
    grid-template-rows: var(--sheet-header-w) 1fr;
  }

  /* Quadrants — background, border, layout. The borders are
   * single-side, so the visual stays in <style>; the surface (bg,
   * divider color) moves to sx. */
  .corner {
    grid-row: 1;
    grid-column: 1;
    border-right: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
  }
  .col-headers {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    overflow: hidden;
    border-bottom: 1px solid var(--divider);
  }
  .row-headers {
    grid-row: 2;
    grid-column: 1;
    position: relative;
    overflow: hidden;
    border-right: 1px solid var(--divider);
  }
  .viewport {
    grid-row: 2;
    grid-column: 2;
    position: relative;
    overflow: auto;
    max-height: var(--panel-max-h-md);
  }

  /* Header / row-header typography — multi-property, raw. */
  .col-head,
  .row-head {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    user-select: none;
  }
  .col-head {
    flex: 0 0 auto;
    padding: var(--space-1) var(--density-row-px);
    border-right: 1px solid var(--divider);
  }
  .row-head {
    position: absolute;
    left: 0;
    right: 0;
    border-bottom: 1px solid var(--divider);
  }

  .spacer { position: relative; }

  /* Cells — absolute, padded via density. Multi-property typography +
   * box-sizing + per-cell state (data-active, data-selected) stay raw. */
  .cell {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: var(--density-row-py) var(--density-row-px);
    border-right: 1px solid transparent;
    border-bottom: 1px solid transparent;
    color: var(--foreground);
    overflow: hidden;
    white-space: nowrap;
  }
  :host([show-gridlines]) .cell {
    border-right-color: var(--divider);
    border-bottom-color: var(--divider);
  }
  .cell[data-active] {
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring-color);
  }
  .cell[data-selected] { background: var(--selected-bg); box-shadow: inset 0 0 0 var(--ring-width) var(--primary); position: relative; z-index: var(--z-elevated); }
  .cell.align-end { justify-content: flex-end; }
  .cell.align-center { justify-content: center; }

  /* The in-place cell editor — an absolutely-positioned input overlaying
   * the active cell while `editing != null`. Hand-styled (see LANG-GAP
   * above: a bare framework <input> would paint rounded with
   * non-density padding, breaking the cell overlay contract). */
  .cell-editor {
    position: absolute;
    box-sizing: border-box;
    z-index: var(--z-elevated);
    padding: var(--density-row-py) var(--density-row-px);
    border: var(--ring-width) solid var(--ring-color);
    border-radius: 0;
    background: var(--surface-1);
    color: var(--foreground);
    font: inherit;
    outline: none;
  }

  /* The fill handle — a small square at the bottom-right of the active
   * selection that drags to extend a series. */
  .fill-handle {
    position: absolute;
    box-sizing: border-box;
    z-index: var(--z-dropdown);
    width: var(--space-2);
    height: var(--space-2);
    margin: calc(var(--space-2) / -2) 0 0 calc(var(--space-2) / -2);
    background: var(--ring-color);
    border: 1px solid var(--card);
    cursor: crosshair;
  }

  .viewport:focus-visible { outline: none; }

  @media (forced-colors: active) {
    .grid { border-color: CanvasText; }
    .cell, .col-head, .row-head { border-color: CanvasText; }
  }
</style>

<div
  class="grid"
  part="grid"
  role="grid"
  tabindex="0"
  bind:this={gridEl}
  sx="bg:surface-1 border:border radius:lg shadow:xs"
  aria-label={label() || null}
  aria-rowcount={rowCount()}
  aria-colcount={colCount()}
  aria-multiselectable={selectionMode() === 'multi' ? 'true' : null}
>
  <div class="corner" part="corner" sx="bg:surface-2" role="presentation"></div>

  <div class="col-headers" part="col-headers" sx="bg:surface-2" role="rowgroup">
    {#if showHeaders()}
      {#for h of cols() key={h.index}}
        <div
          class="col-head"
          role="columnheader"
          aria-colindex={h.index + 1}
          data-col={h.index}
          style:width={`${h.width}px`}
        >{h.label}</div>
      {/for}
    {/if}
  </div>

  <div class="row-headers" part="row-headers" sx="bg:surface-2" role="rowgroup">
    {#if showHeaders()}
      {#for r of rows() key={r.index}}
        <div
          class="row-head"
          role="rowheader"
          aria-rowindex={r.index + 1}
          data-row={r.index}
          style:top={`${r.top}px`}
          style:height={`${r.height}px`}
        >{r.label}</div>
      {/for}
    {/if}
  </div>

  <div class="viewport" part="viewport" role="rowgroup" bind:this={viewportEl}>
    <div class="spacer" style:height={`${totalHeight()}px`} style:width={`${totalWidth()}px`}>
      {#for c of cells() key={c.key}}
        <div
          class="cell"
          part="cell"
          role="gridcell"
          data-a1={c.a1}
          aria-rowindex={c.row + 1}
          aria-colindex={c.col + 1}
          aria-selected={c.cell().isInSelection ? 'true' : null}
          data-active={c.cell().isActive ? true : null}
          data-selected={c.cell().isInSelection ? true : null}
          class:align-end={c.cell().format.align === 'end'}
          class:align-center={c.cell().format.align === 'center'}
          style:top={`${c.top}px`}
          style:left={`${c.left}px`}
          style:width={`${c.width}px`}
          style:height={`${c.height}px`}
        >{c.cell().display}</div>
      {/for}

      {#if editor()}
        <input
          class="cell-editor"
          part="cell-editor"
          aria-label="Cell editor"
          bind:this={editorEl}
          style:top={`${editor().top}px`}
          style:left={`${editor().left}px`}
          style:width={`${editor().width}px`}
          style:height={`${editor().height}px`}
        />
      {/if}

      {#if fillHandle()}
        <div
          class="fill-handle"
          part="fill-handle"
          role="presentation"
          style:top={`${fillHandle().top}px`}
          style:left={`${fillHandle().left}px`}
        ></div>
      {/if}
    </div>
  </div>
</div>
