<!--
  <sui-sheet> — Ship's cell-addressed spreadsheet primitive.

  Distinct from <sui-table> (a typed-record data-grid): a sheet renders an
  addressable 2-D CELL SPACE (A1 addressing, range selection, frozen bands,
  per-cell formats). The headless `createSheet()` engine arrives via
  `prop:sheet={sheet}` IDENTITY binding (never a serialized object attribute);
  the windowed center band renders the engine's `getCellAt(r,c)` cells through
  TWO createVirtualizer instances (rows + columns) over one viewport — the
  Backbone #2 two-axis stress. `workbook` is the SSR/declarative string fallback
  parsed in the controller.

  Frozen rows/cols render as sibling sticky quadrants OUTSIDE the windows. Cells
  are row/cell-shaped → they read the `--density-*` channel directly; there is NO
  density/dense prop (density is the platform `<html data-density>` axis).

  Events (host.emit): sui-cell-commit {a1, before, after}, sui-cells-change
  {edits}, sui-selection-change {active, ranges}, sui-active-sheet-change
  {sheetId}, sui-cell-activate {a1, row, col}.
-->

<prop name="workbook" type="string" default="" />
<prop name="label" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="show-headers" type="bool" default="true" reflect />
<prop name="show-gridlines" type="bool" default="true" reflect />
<prop name="show-formula-bar" type="bool" default="true" reflect />
<prop name="selection-mode" values="cell|range|multi" default="range" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: block;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--density-text);
    color: var(--foreground);
    --sheet-radius: var(--radius-lg);
    --sheet-header-w: var(--space-8);
  }
  :host([hidden]) { display: none; }

  .grid {
    position: relative;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--sheet-radius);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    display: grid;
    grid-template-columns: var(--sheet-header-w) 1fr;
    grid-template-rows: var(--sheet-header-w) 1fr;
  }

  .corner {
    grid-row: 1;
    grid-column: 1;
    border-right: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
    background: var(--surface-2);
  }
  .col-headers {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    overflow: hidden;
    border-bottom: 1px solid var(--divider);
    background: var(--surface-2);
  }
  .row-headers {
    grid-row: 2;
    grid-column: 1;
    position: relative;
    overflow: hidden;
    border-right: 1px solid var(--divider);
    background: var(--surface-2);
  }
  .viewport {
    grid-row: 2;
    grid-column: 2;
    position: relative;
    overflow: auto;
    max-height: 480px;
  }

  .col-head,
  .row-head {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    user-select: none;
  }
  .col-head {
    flex: 0 0 auto;
    padding: var(--space-1) var(--density-row-px);
    border-right: 1px solid var(--divider);
  }
  .row-head {
    position: absolute;
    left: 0;
    right: 0;
    border-bottom: 1px solid var(--divider);
  }

  .spacer { position: relative; }

  .cell {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: var(--density-row-py) var(--density-row-px);
    border-right: 1px solid transparent;
    border-bottom: 1px solid transparent;
    color: var(--foreground);
    overflow: hidden;
    white-space: nowrap;
  }
  :host([show-gridlines]) .cell {
    border-right-color: var(--divider);
    border-bottom-color: var(--divider);
  }
  .cell[data-active] {
    box-shadow: inset 0 0 0 var(--ring-width) var(--ring-color);
  }
  .cell[data-selected] { background: var(--selected-bg); box-shadow: inset 0 0 0 2px var(--primary); position: relative; z-index: var(--z-elevated); }
  .cell.align-end { justify-content: flex-end; }
  .cell.align-center { justify-content: center; }

  /* The in-place cell editor — an absolutely-positioned input overlaying the
     active cell while `editing != null`. */
  .cell-editor {
    position: absolute;
    box-sizing: border-box;
    z-index: var(--z-elevated);
    padding: var(--density-row-py) var(--density-row-px);
    border: var(--ring-width) solid var(--ring-color);
    border-radius: 0;
    background: var(--surface-1);
    color: var(--foreground);
    font: inherit;
    outline: none;
  }

  /* The fill handle — a small square at the bottom-right of the active
     selection that drags to extend a series. */
  .fill-handle {
    position: absolute;
    box-sizing: border-box;
    z-index: var(--z-dropdown);
    width: var(--space-2);
    height: var(--space-2);
    margin: calc(var(--space-2) / -2) 0 0 calc(var(--space-2) / -2);
    background: var(--ring-color);
    border: 1px solid var(--card);
    cursor: crosshair;
  }

  .viewport:focus-visible { outline: none; }

  @media (forced-colors: active) {
    .grid { border-color: CanvasText; }
    .cell, .col-head, .row-head { border-color: CanvasText; }
  }
</style>

<div
  class="grid"
  part="grid"
  role="grid"
  tabindex="0"
  bind:this={gridEl}
  aria-label={label() || null}
  aria-rowcount={rowCount()}
  aria-colcount={colCount()}
  aria-multiselectable={selectionMode() === 'multi' ? 'true' : null}
>
  <div class="corner" part="corner" role="presentation"></div>

  <div class="col-headers" part="col-headers" role="rowgroup">
    {#if showHeaders()}
      {#for h of cols() key={h.index}}
        <div
          class="col-head"
          role="columnheader"
          aria-colindex={h.index + 1}
          data-col={h.index}
          style:width={`${h.width}px`}
        >{h.label}</div>
      {/for}
    {/if}
  </div>

  <div class="row-headers" part="row-headers" role="rowgroup">
    {#if showHeaders()}
      {#for r of rows() key={r.index}}
        <div
          class="row-head"
          role="rowheader"
          aria-rowindex={r.index + 1}
          data-row={r.index}
          style:top={`${r.top}px`}
          style:height={`${r.height}px`}
        >{r.label}</div>
      {/for}
    {/if}
  </div>

  <div class="viewport" part="viewport" role="rowgroup" bind:this={viewportEl}>
    <div class="spacer" style:height={`${totalHeight()}px`} style:width={`${totalWidth()}px`}>
      {#for c of cells() key={c.key}}
        <div
          class="cell"
          part="cell"
          role="gridcell"
          data-a1={c.a1}
          aria-rowindex={c.row + 1}
          aria-colindex={c.col + 1}
          aria-selected={c.cell().isInSelection ? 'true' : null}
          data-active={c.cell().isActive ? true : null}
          data-selected={c.cell().isInSelection ? true : null}
          class:align-end={c.cell().format.align === 'end'}
          class:align-center={c.cell().format.align === 'center'}
          style:top={`${c.top}px`}
          style:left={`${c.left}px`}
          style:width={`${c.width}px`}
          style:height={`${c.height}px`}
        >{c.cell().display}</div>
      {/for}

      {#if editor()}
        <input
          class="cell-editor"
          part="cell-editor"
          aria-label="Cell editor"
          bind:this={editorEl}
          style:top={`${editor().top}px`}
          style:left={`${editor().left}px`}
          style:width={`${editor().width}px`}
          style:height={`${editor().height}px`}
        />
      {/if}

      {#if fillHandle()}
        <div
          class="fill-handle"
          part="fill-handle"
          role="presentation"
          style:top={`${fillHandle().top}px`}
          style:left={`${fillHandle().left}px`}
        ></div>
      {/if}
    </div>
  </div>
</div>
