<!--
  <sui-json-view> — JSON tree. `data` is a JSON string; `depth` auto-opens
  levels below it; `expanded` opens everything. Branch rows toggle on
  click/Enter/Space and carry aria-expanded; the host is role=tree and rows
  are role=treeitem with aria-level. Invalid JSON renders a role=alert row.
  Level guides are per-level gutter spans with a subtle inline-start border.
-->

<scope>
  props: {
    data = ''
    expanded = false
    depth = 1
  }
</scope>

<controller>
import { controller, derived, signal } from '@ship/sui-runtime'
import type { Scope } from './sui-json-view.sui'

type JsonValue = null | boolean | number | string | JsonValue[] | { [k: string]: JsonValue }

interface Pad {
  i: number
}

interface Row {
  k: string
  path: string
  kind: 'branch' | 'close' | 'str' | 'num' | 'bool' | 'null' | 'empty'
  level: number
  ariaLevel: string
  pads: Pad[]
  label: string
  text: string
  open: boolean
  openBracket: string
  closeBracket: string
  meta: string
}

export default controller<Scope>({
  setup: ({ data, expanded, depth }: Scope) => {
    // Per-path user toggles win over the depth/expanded defaults.
    const overrides = signal<Record<string, boolean>>({})

    const parseError = derived((): string => {
      const d = data()
      if (!d) return ''
      try {
        JSON.parse(d)
        return ''
      } catch (e) {
        return (e as Error).message
      }
    })

    const rows = derived((): Row[] => {
      const d = data()
      if (!d || parseError() !== '') return []
      const parsed = JSON.parse(d) as JsonValue
      const out: Row[] = []
      const ov = overrides()
      const exp = expanded()
      const dep = depth()

      const pads = (level: number): Pad[] =>
        Array.from({ length: level }, (_, i) => ({ i }))

      const walk = (v: JsonValue, label: string, level: number, path: string): void => {
        const base = { path, level, ariaLevel: String(level + 1), pads: pads(level), label, meta: '', open: false, openBracket: '', closeBracket: '' }
        if (v === null) {
          out.push({ ...base, k: `${path}:null`, kind: 'null', text: 'null' })
          return
        }
        if (typeof v === 'string') {
          out.push({ ...base, k: `${path}:str:${v}`, kind: 'str', text: `"${v}"` })
          return
        }
        if (typeof v === 'number') {
          out.push({ ...base, k: `${path}:num:${v}`, kind: 'num', text: String(v) })
          return
        }
        if (typeof v === 'boolean') {
          out.push({ ...base, k: `${path}:bool:${v}`, kind: 'bool', text: String(v) })
          return
        }
        const isArr = Array.isArray(v)
        const entries: Array<[string, JsonValue]> = isArr
          ? (v as JsonValue[]).map((x, i) => [String(i), x])
          : Object.entries(v as Record<string, JsonValue>)
        const openBracket = isArr ? '[' : '{'
        const closeBracket = isArr ? ']' : '}'
        if (entries.length === 0) {
          out.push({ ...base, k: `${path}:empty`, kind: 'empty', text: `${openBracket}${closeBracket}` })
          return
        }
        const open = ov[path] ?? (exp || level < dep)
        out.push({
          ...base,
          k: `${path}:branch:${open}`,
          kind: 'branch',
          text: '',
          open,
          openBracket,
          closeBracket,
          meta: `${entries.length} ${isArr ? 'items' : 'keys'}`,
        })
        if (open) {
          for (const [k, val] of entries) {
            walk(val, isArr ? '' : k, level + 1, `${path}.${k}`)
          }
          out.push({ ...base, k: `${path}:close`, kind: 'close', text: closeBracket })
        }
      }

      walk(parsed, '', 0, '$')
      return out
    })

    const toggle = (path: string, open: boolean): void => {
      overrides.set((cur) => ({ ...cur, [path]: !open }))
    }

    return { rows, parseError, toggle }
  },
  mount(_state, host) {
    if (!host.hasAttribute('role')) host.setAttribute('role', 'tree')
    if (!host.hasAttribute('aria-label')) host.setAttribute('aria-label', 'JSON tree')
  },
})
</controller>

<column gap="0" sx="font-mono text-sm leading-normal-plus">
  {#if parseError() !== ''}
    <span role="alert" sx="text-destructive">Invalid JSON: {parseError()}</span>
  {/if}
  {#for row of rows() key={row.k}}
    {#match row.kind}
      {:case 'branch'}
        <row role="treeitem" aria-level={row.ariaLevel} aria-expanded={row.open ? 'true' : 'false'} tabindex="0" gap="0" align="center"
             on:click={() => toggle(row.path, row.open)}
             on:keydown|key:Enter={() => toggle(row.path, row.open)}
             sx="group rounded-sm cursor-pointer hover:bg-hover-bg">
          {#for pad of row.pads key={pad.i}}
            <span sx="w-3 border-l border-l-border-subtle"></span>
          {/for}
          <span aria-hidden="true" sx="text-muted-foreground text-xs px-1 group-expanded:rotate-90">▶</span>
          {#if row.label !== ''}
            <span sx="font-medium">"{row.label}"</span><span sx="text-muted-foreground">:&nbsp;</span>
          {/if}
          <span sx="text-muted-foreground">{row.openBracket}</span>
          <span sx="text-muted-foreground text-xs bg-muted rounded-full px-1 ml-1">{row.meta}</span>
          {#if !row.open}
            <span sx="text-muted-foreground">…{row.closeBracket}</span>
          {/if}
        </row>
      {:case 'close'}
        <row gap="0" align="center">
          {#for pad of row.pads key={pad.i}}
            <span sx="w-3 border-l border-l-border-subtle"></span>
          {/for}
          <span sx="text-muted-foreground px-1">{row.text}</span>
        </row>
      {:default}
        <row role="treeitem" aria-level={row.ariaLevel} gap="0" align="center" sx="rounded-sm hover:bg-hover-bg">
          {#for pad of row.pads key={pad.i}}
            <span sx="w-3 border-l border-l-border-subtle"></span>
          {/for}
          {#if row.label !== ''}
            <span sx="font-medium px-1">"{row.label}"</span><span sx="text-muted-foreground">:&nbsp;</span>
          {/if}
          {#match row.kind}
            {:case 'str'} <span sx="text-success">{row.text}</span>
            {:case 'num'} <span sx="text-info">{row.text}</span>
            {:case 'bool'} <span sx="text-accent font-medium">{row.text}</span>
            {:case 'null'} <span sx="text-muted-foreground">{row.text}</span>
            {:default} <span sx="text-muted-foreground">{row.text}</span>
          {/match}
        </row>
    {/match}
  {/for}
</column>
