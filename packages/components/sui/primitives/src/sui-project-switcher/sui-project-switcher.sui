<!--
  <sui-project-switcher> — generic active-project (space) picker for a chrome
  strip. Trigger shows the active project's identity hue dot + name + caret;
  clicking opens a native-popover menu listing every project (hue dot + name +
  path, active one marked) with a per-row "open in its own window" affordance.

  RUNTIME-FREE / SDK-FREE. The original @ship/chrome version called
  `ship.space.list/activate` on a Connect client, `navigate('/')` to reload, and
  a pack-local `openSpace()` transport. Here ALL of that is parameterized out:
  the project list arrives as data and selections leave as events. The consuming
  app owns the SDK calls, the reload, and the open-window transport.

  Data in:
    • `prop:projects` IDENTITY binding — a live `SwitcherProject[]`.
    • `projects='[…JSON…]'` attribute — the SSR/declarative fallback.
    SwitcherProject: { id, name, path?, hue? }. `hue` is one of the design
    hue tokens (red|orange|amber|green|teal|blue|violet|pink) or omitted, in
    which case a stable hue is derived from `id`.
    `active-id` (string prop) marks the active row + drives the trigger.

  Events (bubbling, composed) — the app does the actual work:
    sui-project-select {id}        a project was chosen (≠ the active one)
    sui-project-open   {id}        the open-in-window affordance was clicked
    sui-project-switcher-ready {}  once after mount
  Parts: trigger, dot, name, menu
-->

<prop name="active-id" type="string" default="" />

<style>
  :host { display: inline-flex; align-items: center; }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-h-sm);
    max-width: var(--panel-min-w-lg);
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--foreground);
    font: inherit;
    cursor: pointer;
  }
  .trigger:hover { background: var(--hover-bg); }
  .trigger:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--ring-width) var(--ring);
  }

  .dot {
    width: var(--space-2_5);
    height: var(--space-2_5);
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--dot, var(--muted-foreground));
  }
  .dot[data-hue="red"]    { --dot: var(--hue-red); }
  .dot[data-hue="orange"] { --dot: var(--hue-orange); }
  .dot[data-hue="amber"]  { --dot: var(--hue-amber); }
  .dot[data-hue="green"]  { --dot: var(--hue-green); }
  .dot[data-hue="teal"]   { --dot: var(--hue-teal); }
  .dot[data-hue="blue"]   { --dot: var(--hue-blue); }
  .dot[data-hue="violet"] { --dot: var(--hue-violet); }
  .dot[data-hue="pink"]   { --dot: var(--hue-pink); }
  .dot[data-hue="slate"]  { --dot: var(--muted-foreground); }

  .name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1;
  }
  .chev {
    width: var(--space-2_5);
    height: var(--space-1_5);
    flex: 0 0 auto;
    color: var(--muted-foreground);
  }

  .menu {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: var(--space-1) 0;
    min-width: var(--panel-min-w-md);
    max-width: var(--panel-max-w-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .menu-title {
    padding: var(--space-2) var(--space-3) var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .row-wrap {
    position: relative;
    display: flex;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    padding-right: var(--space-9);
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .row:hover { background: var(--hover-bg); }
  .row[data-active] { background: var(--selected-bg); }
  .row-main { display: flex; flex-direction: column; gap: var(--space-half); min-width: 0; flex: 1; }
  .row-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-path {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-open {
    position: absolute;
    top: 50%;
    right: var(--space-1_5);
    transform: translateY(-50%);
    appearance: none;
    background: transparent;
    border: none;
    padding: var(--space-1);
    margin: 0;
    cursor: pointer;
    color: var(--muted-foreground);
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .row-wrap:hover .row-open,
  .row-open:focus-visible {
    opacity: 1;
  }
  .row-open:hover {
    background: var(--hover-bg);
    color: var(--foreground);
  }
  .menu-empty {
    padding: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
</style>

<button class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  aria-haspopup="menu"
  aria-expanded={menuOpen() ? 'true' : 'false'}
  aria-label={triggerAria()}
  title={activeName()}
  on:click={() => toggleMenu()}>
  <span class="dot" part="dot" attr:data-hue={activeHue()}></span>
  <span class="name" part="name">{activeName()}</span>
  <svg class="chev" viewBox="0 0 10 6" aria-hidden="true">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<div class="menu" part="menu" popover="auto" bind:this={menuEl} role="menu" aria-label="Switch project">
  <div class="menu-title">Switch project</div>
  {#for p of rows() key={p.id}}
    <div class="row-wrap" role="presentation">
      <button class="row" type="button" role="menuitemradio"
        attr:aria-checked={p.id === activeId() ? 'true' : 'false'}
        attr:data-active={p.id === activeId()}
        on:click={() => pick(p.id)}>
        <span class="dot" attr:data-hue={p.hue}></span>
        <span class="row-main">
          <span class="row-name">{p.name}</span>
          {#if p.path !== ''}
            <span class="row-path">{p.path}</span>
          {/if}
        </span>
      </button>
      <button class="row-open" type="button"
        title="Open this project in its own window"
        aria-label="Open in its own window"
        on:click={() => openAsWindow(p.id)}>
        <sui-icon name="external-link" size="sm"></sui-icon>
      </button>
    </div>
  {/for}
  {#if rows().length === 0}
    <div class="menu-empty">No projects found.</div>
  {/if}
</div>
