<!--
  <sui-project-switcher> — generic active-project (space) picker for a chrome
  strip. Trigger shows the active project's identity hue dot + name + caret;
  clicking opens a native-popover menu listing every project (hue dot + name +
  path, active one marked) with a per-row "open in its own window" affordance.

  RUNTIME-FREE / SDK-FREE. The original @ship/chrome version called
  `ship.space.list/activate` on a Connect client, `navigate('/')` to reload, and
  a pack-local `openSpace()` transport. Here ALL of that is parameterized out:
  the project list arrives as data and selections leave as events. The consuming
  app owns the SDK calls, the reload, and the open-window transport.

  Data in:
    • `prop:projects` IDENTITY binding — a live `SwitcherProject[]`.
    • `projects='[…JSON…]'` attribute — the SSR/declarative fallback.
    SwitcherProject: { id, name, path?, hue? }. `hue` is one of the design
    hue tokens (red|orange|amber|green|teal|blue|violet|pink) or omitted, in
    which case a stable hue is derived from `id`.
    `active-id` (string prop) marks the active row + drives the trigger.

  Events (bubbling, composed) — the app does the actual work:
    sui-project-select {id}        a project was chosen (≠ the active one)
    sui-project-open   {id}        the open-in-window affordance was clicked
    sui-project-switcher-ready {}  once after mount
  Parts: trigger, dot, name, menu
-->

<prop name="active-id" type="string" default="" />

<variants part="row">
  [data-active]: bg:selected-bg
</variants>



<!--
  Residual <style> — truly unavoidable bits:
  - :host display: inline-flex + align-items: center
  - .dot[data-hue=X] CSS var per hue (variants part selectors target host, not descendant)
  - .name white-space + overflow + text-overflow (not sx-able)
  - .menu position: fixed + inset + margin + overflow
  - .row-wrap position: relative (since .row-open is absolute)
  - .row text-align + font: inherit + cursor
  - .row-open position: absolute + top/right + transform: translateY(-50%) + multi-prop transition
  - .row-wrap:hover .row-open opacity: 1 (descendant rule; variants body doesn't support state prefixes)
  - .row-name + .row-path white-space + overflow + text-overflow
-->
<style>
  :host {
    display: inline-flex;
    align-items: center;
  }
  .dot { flex: 0 0 auto; }
  .dot[data-hue="red"]    { --dot: var(--hue-red); }
  .dot[data-hue="orange"] { --dot: var(--hue-orange); }
  .dot[data-hue="amber"]  { --dot: var(--hue-amber); }
  .dot[data-hue="green"]  { --dot: var(--hue-green); }
  .trigger { background: transparent; }
  .row { background: transparent; }
  .row-open { background: transparent; }
  .dot { flex: 0 0 auto; }
  .name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1;
  }
  .menu {
    position: fixed;
    inset: auto;
    margin: 0;
    overflow: hidden;
  }
  .menu-title {
    text-transform: uppercase;
  }
  .row-wrap {
    position: relative;
    display: flex;
  }
  .row {
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .row-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .row-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-path {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-open {
    position: absolute;
    top: 50%;
    right: var(--space-1_5);
    transform: translateY(-50%);
    background: transparent;
    border: none;
    margin: 0;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .row-wrap:hover .row-open,
  .row-open:focus-visible { opacity: 1; }
  .menu-empty { text-align: center; }
</style>

<row class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  align="center" gap="2"
  on:click={() => toggleMenu()}
  aria-haspopup="menu"
  aria-expanded={menuOpen() ? 'true' : 'false'}
  aria-label={triggerAria()}
  title={activeName()}
  sx="h:control-h-sm max-w:panel-min-w-lg p:0 px:2 radius:sm border:none fg:foreground cursor:pointer hover:bg:hover-bg">
  <span class="dot" part="dot" attr:data-hue={activeHue()}
    sx="w:2_5 h:2_5 radius:full bg:muted-foreground"></span>
  <span class="name" part="name"
    sx="weight:medium">{activeName()}</span>
  <svg class="chev" viewBox="0 0 10 6" aria-hidden="true"
    sx="w:2_5 h:1_5 fg:muted-foreground">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</row>

<div class="menu" part="menu" popover="auto" bind:this={menuEl} role="menu" aria-label="Switch project"
  sx="py:1 min-w:panel-min-w-md max-w:panel-max-w-md bg:popover fg:popover-foreground border:border radius:md shadow:lg">
  <div class="menu-title"
    sx="p:2 px:3 pb:1 text:xs weight:semibold tracking:wider fg:muted-foreground">Switch project</div>
  {#for p of rows() key={p.id}}
    <row class="row-wrap" role="presentation" gap="0">
      <row class="row" part="row" type="button" role="menuitemradio" align="center" gap="2"
        attr:aria-checked={p.id === activeId() ? 'true' : 'false'}
        attr:data-active={p.id === activeId()}
        on:click={() => pick(p.id)}
        sx="w:full p:2 px:3 pr:9 border:none group">
        <span class="dot" attr:data-hue={p.hue}
          sx="w:2_5 h:2_5 radius:full bg:muted-foreground"></span>
        <column class="row-main" gap="0" sx="min-w:0">
          <span class="row-name" sx="text:base weight:medium">{p.name}</span>
          {#if p.path !== ''}
            <span class="row-path" sx="text:xs fg:muted-foreground">{p.path}</span>
          {/if}
        </column>
      </row>
      <row class="row-open" part="row-open" type="button"
        title="Open this project in its own window"
        aria-label="Open in its own window"
        on:click={() => openAsWindow(p.id)}
        align="center" gap="0" justify="center"
        sx="radius:sm fg:muted-foreground p:1">
        <sui-icon name="external-link" size="sm"></sui-icon>
      </row>
    </row>
  {/for}
  {#if rows().length === 0}
    <div class="menu-empty" sx="p:3 text:sm fg:muted-foreground">No projects found.</div>
  {/if}
</div>
