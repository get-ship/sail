<!--
  <sui-label> — SUI port of <ship-label>.
  Form field label with optional required marker.

  Prop parity vs <ship-label>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  htmlFor / attribute: 'for'   for (string, '')         ✓ forwarded to inner
                                                          label.htmlFor via
                                                          controller
  size ('sm'|'md', 'sm')       size (sm|md|lg, reflect) ✓
  required (bool, false)       required (bool, reflect) ✓ shows * marker
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  slots: (default) label text  (default)                ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                part="label"             SUI names inner label
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="for" type="string" default="" />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="required" type="bool" default="false" reflect />

<theme prop="size" channels="label-fs">
  default: text-base
  sm:      text-sm
  md:      text-base
  lg:      text-sm
</theme>

<style>
  /* Local markers so the css-token lint recognizes the theme channels
   * referenced from this residual block. */
  --label-fs: ;
  /* Residual: bare `:host` rule with no prop selector (host is
     `inline-block` regardless of attribute state) and the inner
     <label>'s `font-family` aren't reachable through the sx
     theme/variants constructs. */
  :host { display: inline-block; }
  label {
    font-family: var(--font-body);
    /* De-translated from sx (text:label-fs) — ad-hoc channels are not sx
       vocabulary. */
    font-size: var(--label-fs);
  }
</style>

<label part="label" bind:this={labelEl}
  sx="display:inline weight:semibold tracking:normal fg:foreground cursor:pointer">
  <slot></slot>
  {#if required()}<span class="req" aria-hidden="true" sx="fg:destructive ml:1 weight:bold">*</span>{/if}
</label>
