<!--
  <sui-label> — SUI port of <ship-label>.
  Form field label with optional required marker.

  Prop parity vs <ship-label>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  htmlFor / attribute: 'for'   for (string, '')         ✓ forwarded to inner
                                                          label.htmlFor via
                                                          controller
  size ('sm'|'md', 'sm')       size (sm|md|lg, reflect) ✓
  required (bool, false)       required (bool, reflect) ✓ shows * marker
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  slots: (default) label text  (default)                ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                part="label"             SUI names inner label
  ─────────────────────────────────────────────────────────────────────────────
-->

<component>{
  props: {
    for: string,
    size: 'sm' | 'md' | 'lg',
    required: bool,
  },
}</component>

<!--
  Residual: every declaration below is the verbatim feat/next CSS. The
  font-size per size is selector-matrix-driven (the baseline maps
  size=md to text-base and size=sm/lg to text-sm) — sx has no
  conditional font-size in the new shape, and the framework size-fs
  channel would map size=lg to text-lg (a regression vs baseline's
  text-sm). font-family is also irreducible: sx has no font-family
  prop. The label inner-element styling that sx CAN express (weight,
  fg, cursor) is hoisted to the element via sx="…".
-->
<style>
  :host {
    display: inline-block;
  }
  :host([hidden]) { display: none; }

  label {
    display: inline;
    /* LANG-GAP(font-family): sx has no font-family prop. */
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--foreground);
    cursor: pointer;
  }

  /* LANG-GAP(per-attribute font-size): the framework size-fs channel
   * maps size=lg to text-lg; the baseline maps lg → text-sm to keep
   * the label compact. The conditional font-size stays in the
   * residual. */
  :host(:not([size])) label,
  :host([size='md']) label { font-size: var(--text-base); }
  :host([size='sm']) label,
  :host([size='lg']) label { font-size: var(--text-sm); }

  .req {
    color: var(--destructive);
    margin-left: var(--space-1);
    font-weight: 700;
  }
</style>

<label part="label" bind:this={labelEl}
  sx="display:inline weight:semibold tracking:normal fg:foreground cursor:pointer">
  <slot></slot>
  {#if required()}<span class="req" aria-hidden="true" sx="fg:destructive ml:1 weight:bold">*</span>{/if}
</label>
