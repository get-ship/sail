<!--
  <sui-timeline-item> — co-located child element for <sui-timeline>.
  Single timeline entry with gutter dot, connector line, title, and body.

  Prop parity vs <ship-timeline-item>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'default')       tone (string, 'default', ✓
                                 reflect)
  at (string, undefined)       at (string, '', reflect) ✓ ISO or relative label
  interactive (bool, false)    interactive (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-select → {}             sui-select → {}          event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: title, (default)      title, (default)         ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: dot, body, at         dot, body, at            ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: role=listitem → button controller manages       ✓
    when interactive; tabindex
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" type="string" default="default" reflect />
<prop name="at" type="string" default="" reflect />
<prop name="interactive" type="bool" default="false" reflect />

<theme prop="tone" channels="dot-tone">
  default:     foreground
  primary:     primary
  info:        info
  success:     success
  warning:     warning
  destructive: destructive
  accent:      accent-foreground
  muted:       muted-foreground
</theme>
<variants>
  [hidden]: display:none
</variants>
<variants part="dot">
  interactive: cursor:pointer
</variants>

<!-- Residual: 2-column grid layout (grid-template-columns: var(--space-5) 1fr) —
     no layout primitive; .gutter::before connector line + :first-of-type /
     :last-of-type pseudo-clipped top/bottom (descendant pseudo + structural
     pseudo — no sx/variants story); .dot geometry (width/height/border-radius
     + z-index + margin-top + flex-shrink + box-shadow ring with explicit
     offset ring); .head row (display:flex + align-items:baseline + gap +
     font + color); .at monospace label (font-family: var(--font-mono) + color
     + size + letter-spacing + margin-inline-start:auto); .content body
     typography; :host([interactive]) cursor + border-radius + outline reset;
     :host([interactive]:hover) background; the 2-layer focus ring box-shadow
     (vs the sx `ring:` shorthand — used here with explicit ring-offset +
     ring-width for visual parity); forced-colors CanvasText outline
     (system color). -->
<style>
  :host {
    display: grid;
    grid-template-columns: var(--space-5) 1fr;
    column-gap: var(--space-2);
    padding: var(--space-2) 0;
    position: relative;
  }
  [part~='dot'] {
    position: relative;
    z-index: var(--z-elevated);
  :host {
    --dot-tone: var(--muted-foreground);
  }
    width: var(--space-2_5);
    height: var(--space-2_5);
    border-radius: var(--radius-full);
    background: var(--dot-tone);
    margin-top: var(--space-1);
    flex-shrink: 0;
    box-shadow: 0 0 0 var(--space-1) var(--surface-1);
  }
  .gutter {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .gutter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--space-half);
    background: var(--border-subtle);
  }
  :host(:first-of-type) .gutter::before { top: var(--space-2_5); }
  :host(:last-of-type) .gutter::before { bottom: calc(100% - var(--space-2_5)); }
  .body { min-width: 0; }
  .head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }
  .at {
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-normal);
    margin-inline-start: auto;
  }
  .content {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
    margin-top: var(--space-1);
  }
  :host([interactive]) {
    cursor: pointer;
    border-radius: var(--radius-sm);
    outline: none;
  }
  :host([interactive]:hover) { background: var(--muted); }
  :host([interactive]:focus-visible) {
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        var(--ring);
  }
  @media (forced-colors: active) {
    :host([interactive]:focus-visible) { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<column class="gutter" gap="0" sx="position:relative">
  <span class="dot" part="dot"></span>
</column>
<column class="body" part="body" gap="0">
  <row class="head" align="baseline" gap="2">
    <slot name="title"></slot>
    {#if at()}
      <span class="at" part="at" sx="fg:muted-foreground">{at()}</span>
    {/if}
  </row>
  <column class="content" gap="0" sx="text:sm fg:muted-foreground"><slot></slot></column>
</column>
