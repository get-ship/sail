<!--
  <sui-timeline-item> — co-located child element for <sui-timeline>.
  Single timeline entry with gutter dot, connector line, title, and body.

  Prop parity vs <ship-timeline-item>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'default')       tone (string, 'default', ✓
                                 reflect)
  at (string, undefined)       at (string, '', reflect) ✓ ISO or relative label
  interactive (bool, false)    interactive (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-select → {}             sui-select → {}          event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: title, (default)      title, (default)         ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: dot, body, at         dot, body, at            ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: role=listitem → button controller manages       ✓
    when interactive; tabindex
  ─────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────────────
  - The per-component `<theme prop="tone" channels="dot-tone">` block is
    DELETED — `tone` is one of the framework's built-in 8-value contracts
    (default/primary/info/success/warning/destructive/accent/muted, exactly
    this component's vocabulary), so `.dot` now paints `bg:tone-fg` straight
    off the globally-supplied `--tone-fg` (packages/sui/runtime tones.css)
    instead of maintaining a parallel `--dot-tone` custom property. Matches
    the alert pilot's precedent: 7 of 8 values are byte-identical to the old
    per-component mapping; `accent` normalizes from the baseline's
    `--accent-foreground` to the global `--accent` (alert's port accepted an
    analogous success/warning normalization the same way) — a value
    consolidation the global tone rollout intends, not a LANG-GAP.
  - Fixed two defects inherited from the prior automated token-routing pass
    (not introduced here, but this component's gate to fix): (1) a corrupted
    `.sui-timeline-item { --dot-tone: … }` rule had been spliced INSIDE the `.dot`
    declaration block (invalid nesting); (2) the `interactive` cursor
    affordance had been narrowed to a `<variants class="dot">` rule (cursor
    on the 10px dot only) — restored to `.sui-timeline-item[interactive] { cursor:
    pointer; … }` (the whole row is the click target, per the controller's
    click/keydown handlers and feat/next).
  - `.gutter`/`.body`/`.content` were NOT flex containers in the baseline
    (plain `<div>`s; only `.head` was `display:flex`) — a prior pass had
    wrapped all of them in `<column>`/`<row>`, which for `.content` risks
    flex-wrapping arbitrary slotted body content that was plain block flow
    before. Reverted `.gutter`/`.body`/`.content` to `<div>`; kept `.head` as
    `<row align="baseline" gap="2">` (it WAS a flex row) and used
    `<row justify="center">` for `.gutter` (equivalent to the baseline's
    `display:flex; justify-content:center` for centering the single dot).
  - Style properties sx can express (bg/fg/text/weight/tracking/z/mt) moved
    to `sx=`; font-family (no sx prop), the connector-line pseudo-elements,
    the dot's fixed geometry + ring box-shadow, and the 2-layer focus ring
    stay in the residual `<style>` (tokens only, no raw values).
  - Token-routing value nudge worth flagging: the baseline's `.dot` ring was
    `box-shadow: 0 0 0 3px var(--surface-1)` — 3px has no exact token, so
    the ring now reads `var(--space-1)` (4px), a 1px widen. Also fixed the
    prior pass's letter-spacing token pick: the baseline's `.at` used
    `0.02em`, which had been mapped to `var(--tracking-normal)` (0, i.e. no
    tracking at all — defeats the intent); corrected to `var(--tracking-wide)`
    (0.04em), the nearer token that preserves the widened-tracking read on
    the monospace timestamp.
  - CSS now selects on `.dot`/`.head`/`.at` classes, not `[part=…]`
    attributes — anatomy is class-based per the wave's convention; `part=`
    attributes stay on (vestigial) pending the wave-wide scripted sweep.
  - No LANG-GAP: every prop/slot/event/ARIA rule from the baseline is fully
    expressible on this surface.
-->

<component>{
  props: {
    tone: 'default',
    at: '',
    interactive: false,
  },
}</component>
<style>
  .sui-timeline-item {
    display: grid;
    grid-template-columns: var(--space-5) 1fr;
    column-gap: var(--space-2);
    padding: var(--space-2) 0;
    position: relative;
  }

  .gutter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--space-half);
    background: var(--border-subtle);
  }
  .sui-timeline-item:first-of-type .gutter::before { top: var(--space-2_5); }
  .sui-timeline-item:last-of-type .gutter::before { bottom: calc(100% - var(--space-2_5)); }

  .body { min-width: 0; }

  .dot {
    width: var(--space-2_5);
    height: var(--space-2_5);
    border-radius: var(--radius-full);
    flex-shrink: 0;
    box-shadow: 0 0 0 var(--space-1) var(--surface-1);
  }

  .head { font-family: var(--font-body); }
  .at { font-family: var(--font-mono); margin-inline-start: auto; }

  .content {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
    margin-top: var(--space-1);
  }

  .sui-timeline-item[interactive] {
    cursor: pointer;
    border-radius: var(--radius-sm);
    outline: none;
  }
  .sui-timeline-item[interactive]:hover { background: var(--muted); }
  .sui-timeline-item[interactive]:focus-visible {
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        var(--ring);
  }
  @media (forced-colors: active) {
    .sui-timeline-item[interactive]:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-timeline-item.sui'

export default controller<Scope>({
  mount(state, host) {

    if (!host.hasAttribute('role')) host.setAttribute('role', 'listitem')

    const stopRole = effect(() => {
      if (state.$signals.interactive()) {
        host.setAttribute('role', 'button')
        if (!host.hasAttribute('tabindex')) host.setAttribute('tabindex', '0')
      } else {
        host.setAttribute('role', 'listitem')
        host.removeAttribute('tabindex')
      }
    })

    const emit = () => {
      host.dispatchEvent(
        new CustomEvent('sui-select', { bubbles: true, composed: true, detail: {} }),
      )
    }

    const onClick = () => { if (state.$signals.interactive()) emit() }

    const onKeydown = (e: KeyboardEvent) => {
      if (!state.$signals.interactive()) return
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        emit()
      }
    }

    host.addEventListener('click', onClick)
    host.addEventListener('keydown', onKeydown)

    return () => {
      stopRole()
      host.removeEventListener('click', onClick)
      host.removeEventListener('keydown', onKeydown)
    }
  },
})

</controller>
<row class="gutter" gap="0" justify="center" sx="position:relative">
  <span class="dot" sx="position:relative z:elevated bg:tone-fg mt:1"></span>
</row>
<div class="body">
  <row class="head" align="baseline" gap="2" sx="text:sm weight:medium fg:foreground">
    <slot name="title"></slot>
    {#if at()}
      <span class="at" sx="fg:muted-foreground text:xs tracking:wide">{at()}</span>
    {/if}
  </row>
  <div class="content"><slot></slot></div>
</div>
