<component>{
  props: {
    open: false,
    tone: 'default' | 'destructive',
    'confirm-label': 'Confirm',
    'cancel-label': 'Cancel',
  },
}</component>
<!--
  <sui-alert-dialog> — a confirm dialog on the native <dialog>. Composes the ONE
  dialog implementation: a native <dialog role="alertdialog"> skinned by
  DIALOG_SKIN_CSS, with its behavior via the useDialog handle (use:confirm) —
  no sui-dialog custom element, no dialogRef/show()/sui-close plumbing. The
  platform + DIALOG_SKIN_CSS give the modal top layer, backdrop, focus trap,
  ESC, focus-return, scroll-lock, and size; useDialog gives the open handle +
  aria wiring. Only the alert-icon badge + head grid stay local (the one thing
  the skin doesn't cover).

  The `open` prop (external API) bridges to the handle: opening the component
  shows the modal; a native close (ESC/backdrop) mirrors back to open=false.
-->
<style>
  .sui-alert-dialog { display: contents; --ad-fg: var(--primary); --ad-bg: var(--selected-bg); }
  .sui-alert-dialog[tone='destructive'] { --ad-fg: var(--destructive); --ad-bg: var(--tone-destructive-bg); }
  .sui-alert-dialog[hidden] { display: none; }

  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
  }
  .badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--control-h-md); height: var(--control-h-md);
    border-radius: var(--radius-lg);
    background: var(--ad-bg);
    color: var(--ad-fg);
    flex: none;
  }
  .badge svg { width: var(--icon-size-lg); height: var(--icon-size-lg); }
</style>


<controller>
import { controller, derived, effect, signal, useDialog } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-alert-dialog.sui'

export default controller({
  scope: ({ open, tone }: ViewScope<Scope>) => {
    // The ONE dialog behavior — the handle IS the `use:confirm` action.
    const confirm = useDialog()

    const confirmTone = derived<'default' | 'destructive'>(() =>
      tone() === 'destructive' ? 'destructive' : 'default',
    )

    const hostEl = signal<HTMLElement | null>(null)

    function emit(name: 'sui-confirm' | 'sui-cancel'): void {
      hostEl()?.dispatchEvent(new CustomEvent(name, { bubbles: true, composed: true }))
      open.set(false)
    }
    function onConfirm(): void { emit('sui-confirm') }
    function onCancel(): void { emit('sui-cancel') }

    return { open, confirm, confirmTone, onConfirm, onCancel, hostEl }
  },

  mount(state, host) {
    state.hostEl = host as HTMLElement

    // Bridge the external `open` prop to the dialog handle (guarded: bindOpen
    // itself no-ops showModal/close in the wrong state, so this never loops).
    const stopOpenIn = effect(() => {
      if (state.open) state.confirm.open()
      else state.confirm.close()
    })
    // Native close (ESC / backdrop) mirrors back into `open`.
    const stopOpenOut = effect(() => {
      if (!state.confirm.isOpen() && state.open) state.open = false
    })

    return () => {
      stopOpenIn()
      stopOpenOut()
    }
  },
})

</controller>
<dialog use:confirm role="alertdialog" size="sm">
  <header>
    <span class="head">
      <span class="badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
          <path d="M12 9v4M12 17h.01"/>
        </svg>
      </span>
      <slot name="title"></slot>
    </span>
  </header>
  <section><slot></slot></section>
  <footer>
    <button outline on:click={onCancel}>{cancelLabel()}</button>
    <button solid tone={confirmTone()} on:click={onConfirm}>{confirmLabel()}</button>
  </footer>
</dialog>
