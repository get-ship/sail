<!--
  <sui-alert-dialog> — SUI port of <ship-alert-dialog>.
  Thin specialization of <sui-dialog> for confirm / destructive prompts.
  Composes <sui-button> for the cancel + confirm footer actions.

  Prop / event / method parity vs <ship-alert-dialog>
  ────────────────────────────────────────────────────────────────────────
  Lit                              SUI                              Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)               open (bool, false, reflect)      ✓
  tone (default|destructive)       tone (union, 'default', reflect) ✓
  confirm-label (str, 'Confirm')   confirm-label (str, 'Confirm')   ✓
  cancel-label  (str, 'Cancel')    cancel-label  (str, 'Cancel')    ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-confirm/cancel → sui-confirm / sui-cancel             ✓
  Slots: title (named), (default) body                               ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="tone" values="default|destructive" default="default" reflect />
<prop name="confirm-label" type="string" default="Confirm" />
<prop name="cancel-label" type="string" default="Cancel" />

<style>
  :host {
    display: contents;
    --ad-fg: var(--primary);
    --ad-bg: var(--selected-bg);
  }
  :host([tone='destructive']) {
    --ad-fg: var(--destructive);
    --ad-bg: var(--tone-destructive-bg);
  }
  :host([hidden]) { display: none; }

  /* Leading tone icon badge so destructive vs neutral reads before the title. */
  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-lg);
    background: var(--ad-bg);
    color: var(--ad-fg);
    flex: none;
  }
  .badge svg { width: 19px; height: 19px; }
</style>

<sui-dialog
  role-override="alertdialog"
  size="sm"
  no-close-button
  bind:this={dialogRef}
>
  <span slot="header" class="head">
    <span class="badge" part="badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
        <path d="M12 9v4M12 17h.01"/>
      </svg>
    </span>
    <slot name="title"></slot>
  </span>
  <slot></slot>
  <span slot="footer">
    <sui-button variant="outline" on:click={onCancel}>
      {cancelLabel()}
    </sui-button>
    <sui-button
      variant="solid"
      tone={confirmTone()}
      on:click={onConfirm}
    >
      {confirmLabel()}
    </sui-button>
  </span>
</sui-dialog>
