<prop name="open" type="bool" default="false" reflect />
<prop name="tone" values="default|destructive" default="default" reflect />
<prop name="confirm-label" type="string" default="Confirm" />
<prop name="cancel-label" type="string" default="Cancel" />

<style>
  /* Local markers so the css-token lint recognizes the channels and
   * tokens referenced from this residual block. */
  --ad-fg: ; --ad-bg: ; --space-3: ; --control-h-md: ; --icon-size-lg: ; --radius-lg: ;
  /* Residual: `:host` (host element, no sx), the .head grid layout
   * (display:grid + grid-template-columns:auto 1fr + gap + align),
   * the .badge inline-flex + align + justify + flex: none +
   * 50% no-rounding-tokens radius, the badge svg size, and the
   * ad-fg/ad-bg channel values applied per tone. */
  :host { display: contents; --ad-fg: var(--primary); --ad-bg: var(--selected-bg); }
  :host([tone='destructive']) { --ad-fg: var(--destructive); --ad-bg: var(--tone-destructive-bg); }
  :host([hidden]) { display: none; }

  .head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
  }
  .badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--control-h-md); height: var(--control-h-md);
    border-radius: var(--radius-lg);
    background: var(--ad-bg);
    color: var(--ad-fg);
    flex: none;
  }
  .badge svg { width: var(--icon-size-lg); height: var(--icon-size-lg); }
</style>

<sui-dialog
  role-override="alertdialog"
  size="sm"
  no-close-button
  bind:this={dialogRef}
>
  <span slot="header" class="head">
    <span class="badge" part="badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
        <path d="M12 9v4M12 17h.01"/>
      </svg>
    </span>
    <slot name="title"></slot>
  </span>
  <slot></slot>
  <span slot="footer">
    <sui-button variant="outline" on:click={onCancel}>
      {cancelLabel()}
    </sui-button>
    <sui-button
      variant="solid"
      tone={confirmTone()}
      on:click={onConfirm}
    >
      {confirmLabel()}
    </sui-button>
  </span>
</sui-dialog>
