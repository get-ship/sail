<!--
  <sui-stack> — vertical stack with a single spacing-token gap.

  The first layout primitive in the canonical set (stack / cluster /
  grid / center). Views that previously hand-rolled a `display:flex;
  flex-direction:column; gap:var(--space-3)` rule should use this
  element instead — the goal is to make per-view CSS stylesheets
  shrink, not grow, as the design system matures.

  Children stack vertically; the gap between them is a single design-
  system spacing token (`gap="3"` → `gap: var(--space-3)`). The `align`
  prop maps to `align-items`. A `tag` attribute is intentionally not
  exposed — wrap in your own semantic element when you need one; the
  layout host is a `<div>` in the shadow.

  Prop / event / slot
  ─────────────────────────────────────────────────────────────────────
  gap   (enum, '4')   1..8 → var(--space-N). 0 = no gap.
  align (enum, 'stretch') start|center|end|stretch — align-items.
  ─────────────────────────────────────────────────────────────────────
  (no events)
  ─────────────────────────────────────────────────────────────────────
  slots: (default)
  parts: (none — the inner <div> is shadow-only)
-->

<prop name="gap" values="0|1|2|3|4|5|6|7|8" default="4" reflect />
<style>

  :host {
    display: block;
    --stack-gap: var(--space-4);
  }
  :host([hidden]) { display: none; }

  :host([gap='0']) { --stack-gap: 0; }
  :host([gap='1']) { --stack-gap: var(--space-1); }
  :host([gap='2']) { --stack-gap: var(--space-2); }
  :host([gap='3']) { --stack-gap: var(--space-3); }
  :host([gap='4']) { --stack-gap: var(--space-4); }
  :host([gap='5']) { --stack-gap: var(--space-5); }
  :host([gap='6']) { --stack-gap: var(--space-6); }
  :host([gap='7']) { --stack-gap: var(--space-7); }
  :host([gap='8']) { --stack-gap: var(--space-8); }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap);
    align-items: stretch;
  }
  :host([align='start'])   .stack { align-items: flex-start; }
  :host([align='center'])  .stack { align-items: center; }
  :host([align='end'])     .stack { align-items: flex-end; }
  :host([align='stretch']) .stack { align-items: stretch; }
</style>

<div class="stack"><slot></slot></div>
