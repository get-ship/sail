<!--
  <sui-tooltip> — SUI port of <ship-tooltip>.
  CSS-positioned tooltip shown on hover/focus-within. Wraps the trigger
  as light-DOM children; `content` slot provides the bubble body.

  Prop parity vs <ship-tooltip>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  placement                    placement (reflect)      ✓ top|bottom|left|right
    'top'|'bottom'|'left'|
    'right'
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  slots: (default) trigger     (default) trigger        ✓
         content  tooltip body  content  tooltip body   ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: aria-describedby set   controller sets same     ✓ on first slotted
    on first slotted element     on first slotted el       element via
                                                           slotchange
  Esc key blurs host           Esc key blurs host       ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                part="bubble"            SUI adds bubble part
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="placement" values="top|bottom|left|right" default="top" reflect />

<variants>
  [hidden]: display:none
</variants>
<variants part="bubble">
  [hover]:     opacity:100
  focus-within: opacity:100
</variants>

<!-- Residual: anchor positioning (anchor-name, position-anchor, position-try-*,
     calc(anchor(...))) — CSS Anchor Positioning is a raw-CSS feature with
     no sx/variants construct; the @supports block switching between
     anchor-positioned and absolute-fallback placements; the .bubble
     visuals (z-index, padding, background, color, font, border-radius,
     white-space, pointer-events, transition, box-shadow); the ::after
     arrow caret (position absolute + transform rotate); the local
     --tt-arrow-shift / --tt-arrow-overlap token subscale. -->
<style>
  :host {
    display: inline-flex;
    anchor-name: var(--sui-tooltip-anchor);
  }
  :host(:hover) [part~='bubble'],
  :host(:focus-within) [part~='bubble'] {
    opacity: 1;
  }
  [part~='bubble'] {
    --tt-arrow-shift: -3.5px;
    --tt-arrow-overlap: calc(-1 * var(--space-1));
    position: fixed;
    position-anchor: var(--sui-tooltip-anchor);
    z-index: var(--z-popover);
    padding: var(--space-1) var(--space-2);
    background: var(--foreground);
    color: var(--background);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-md);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-md);
    position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
    position-try-order: most-block-size;
  }
  [part~='bubble']::after {
    content: '';
    position: absolute;
    width: var(--space-1_25);
    height: var(--space-1_25);
    background: var(--foreground);
    transform: rotate(45deg);
  }
  @supports (anchor-name: --x) {
    :host(:not([placement])) [part~='bubble'],
    :host([placement='top']) [part~='bubble'] {
      bottom: calc(anchor(top) - var(--space-2));
      justify-self: anchor-center;
    }
    :host(:not([placement])) [part~='bubble']::after,
    :host([placement='top']) [part~='bubble']::after {
      bottom: calc(-1 * var(--space-1)); left: 50%; margin-left: var(--tt-arrow-shift);
    }
    :host([placement='bottom']) [part~='bubble'] {
      top: calc(anchor(bottom) + var(--space-2));
      justify-self: anchor-center;
    }
    :host([placement='bottom']) [part~='bubble']::after { top: calc(-1 * var(--space-1)); left: 50%; margin-left: var(--tt-arrow-shift); }
    :host([placement='left']) [part~='bubble'] {
      right: calc(anchor(left) - var(--space-2));
      align-self: anchor-center;
    }
    :host([placement='left']) [part~='bubble']::after { right: calc(-1 * var(--space-1)); top: 50%; margin-top: var(--tt-arrow-shift); }
    :host([placement='right']) [part~='bubble'] {
      left: calc(anchor(right) + var(--space-2));
      align-self: anchor-center;
    }
    :host([placement='right']) [part~='bubble']::after { left: calc(-1 * var(--space-1)); top: 50%; margin-top: var(--tt-arrow-shift); }
  }
  @supports not (anchor-name: --x) {
    :host { position: relative; }
    [part~='bubble'] { position: absolute; }
    :host(:not([placement])) [part~='bubble'],
    :host([placement='top']) [part~='bubble'] {
      bottom: calc(100% + var(--space-2)); left: 50%; transform: translateX(-50%);
    }
    :host(:not([placement])) [part~='bubble']::after,
    :host([placement='top']) [part~='bubble']::after { bottom: calc(-1 * var(--space-1)); left: 50%; margin-left: var(--tt-arrow-shift); }
    :host([placement='bottom']) [part~='bubble'] {
      top: calc(100% + var(--space-2)); left: 50%; transform: translateX(-50%);
    }
    :host([placement='bottom']) [part~='bubble']::after { top: calc(-1 * var(--space-1)); left: 50%; margin-left: var(--tt-arrow-shift); }
    :host([placement='left']) [part~='bubble'] {
      right: calc(100% + var(--space-2)); top: 50%; transform: translateY(-50%);
    }
    :host([placement='left']) [part~='bubble']::after { right: calc(-1 * var(--space-1)); top: 50%; margin-top: var(--tt-arrow-shift); }
    :host([placement='right']) [part~='bubble'] {
      left: calc(100% + var(--space-2)); top: 50%; transform: translateY(-50%);
    }
    :host([placement='right']) [part~='bubble']::after { left: calc(-1 * var(--space-1)); top: 50%; margin-top: var(--tt-arrow-shift); }
  }
</style>

<slot bind:this={defaultSlot}></slot>
<span class="bubble" role="tooltip" part="bubble" bind:this={bubbleEl}><slot name="content"></slot></span>
