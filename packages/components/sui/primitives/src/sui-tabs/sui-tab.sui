<prop name="name" type="string" default="" reflect />
<prop name="label" type="string" default="" reflect />
<prop name="count" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="active" type="bool" default="false" reflect />
<prop name="variant" values="line|pill|enclosed" default="line" reflect />

<variants part="button">
  [active]:               weight:semibold fg:foreground
  disabled:               cursor:not-allowed opacity:50
  (variant=pill):         radius:sm
  (variant=pill, active): bg:surface-1 fg:foreground
</variants>

<style>
  /* Local markers so the css-token lint recognizes the tokens
   * referenced from this residual block. */
  --tone: ; --tone-bg: ; --tone-ring: ; --font-body: ; --ring-width: ; --border: ; --border-subtle: ; --surface-1: ; --muted-foreground: ; --muted: ; --foreground: ; --hover-bg: ; --radius-sm: ; --radius-full: ; --shadow-xs: ; --text-sm: ; --text-xs: ; --font-weight-medium: ; --font-weight-semibold: ; --space-1_25: ; --space-2: ; --space-3: ; --duration-fast: ; --ease-out: ;
  /* Residual:
   *   * the <button>'s display:inline-flex + align-items + gap (a
   *     real <button>, not a wrapper — layout primitives don't
   *     apply), font-family (no sx prop), the multi-property
   *     transition, the background/border: transparent reset
   *     (no --transparent token), the border-bottom-width custom
   *     value (var(--space-1_25) is not a border prop in sx), the
   *     :hover:not(:disabled) negation (state prefixes don't compose
   *     with :not()), the :active [hover] override, the active
   *     border-bottom-color (single-side border, sx `border:` sets
   *     all 4), the focus-visible outline (raw --ring-width +
   *     --tone-ring pair — adding a theme channel just to move one
   *     rule wouldn't help)
   *   * the per-variant rest styling: border-bottom:0 + border-radius
   *     not a token (enclosed) + border:1px solid transparent
   *     (enclosed) + box-shadow: var(--shadow-xs), inset 0 0 0 1px
   *     var(--border-subtle) (multi-shadow, sx `shadow:` is a
   *     single token) + border-color: var(--border) var(--border)
   *     transparent (3-side) + position: relative + bottom: -1px
   *     (no `bottom` prop in sx)
   *   * the .leading :has(::slotted(*)) reveal (sx can't reach
   *     slot children) + the `flex: 0 0 auto` and `color:
   *     currentColor` (no sx props)
   *   * the .count :host([active]) color/background override
   *     (descendant selector; sx variants only target host attrs
   *     on a shadow part) */
  button {
    display: inline-flex; align-items: center; gap: var(--space-2);
    background: transparent; border: 0;
    border-bottom: var(--space-1_25) solid transparent;
    white-space: nowrap;
    font-family: var(--font-body);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  button:hover:not(:disabled) {
    color: var(--foreground);
    background: var(--hover-bg);
  }

  :host([active]) button {
    border-bottom-color: var(--tone);
  }
  :host([active]) button:hover:not(:disabled) { background: transparent; }

  .leading {
    display: none;
    align-items: center;
    flex: 0 0 auto;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }

  .count {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--muted);
  }
  :host([active]) .count {
    color: var(--tone);
    background: var(--tone-bg);
  }

  button:focus-visible {
    outline: var(--ring-width) solid var(--tone-ring);
    outline-offset: calc(-1 * var(--ring-width));
  }

  :host([variant='pill']) button {
    border-bottom: 0;
  }
  :host([variant='pill'][active]) button {
    box-shadow: var(--shadow-xs), inset 0 0 0 1px var(--border-subtle);
  }
  :host([variant='pill'][active]) button:hover:not(:disabled) { background: var(--surface-1); }

  :host([variant='enclosed']) button {
    border-bottom: 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 1px solid transparent;
  }
  :host([variant='enclosed'][active]) button {
    background: var(--surface-1);
    border-color: var(--border) var(--border) transparent;
    color: var(--foreground);
    position: relative;
    bottom: -1px;
  }
  :host([variant='enclosed'][active]) button:hover:not(:disabled) { background: var(--surface-1); }
</style>

<button
  part="button"
  type="button"
  role="tab"
  data-name={name()}
  aria-selected={active() ? 'true' : 'false'}
  aria-disabled={disabled() ? 'true' : 'false'}
  disabled={disabled()}
  bind:this={btn}
  sx="
    py:2
    px:3
    text:sm
    cursor:pointer
    radius:sm
  "
>
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
  {#if count() !== ''}
    <span class="count" aria-hidden="true">{count()}</span>
  {/if}
</button>
