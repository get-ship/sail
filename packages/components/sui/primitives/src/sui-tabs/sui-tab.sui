<!--
  <sui-tab> — SUI port of <ship-tab>.
  Individual tab button. Renders its own interactive button; orchestrated
  by the parent <sui-tabs> controller which sets the `active` attribute.

  Architecture diverges from Lit:
  In <ship-tabs>, the parent renders all tab buttons in its own shadow
  DOM and <ship-tab> is a data-holder (display:none). In SUI, <sui-tab>
  renders its own button, and <sui-tabs> coordinates via attribute-setting
  and slotchange. This keeps the interactive surface inside sui-tab for
  encapsulation while delegating keyboard/focus management to sui-tabs.

  Prop / event / method parity vs <ship-tab>
  ──────────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ──────────────────────────────────────────────────────────────────────────────
  name (String, '', reflect)       name (string, '',         ✓
                                     reflect)
  label (String, '', reflect)      label (string, '',        ✓ fallback text if
                                     reflect)                  slot is empty; in
                                                               SUI the slot is
                                                               primary content
  count (Number|null, null,        count (string, '',        ✓ empty string →
    reflect)                         reflect)                  no badge (SUI string
                                                               prop; '' hides badge)
  disabled (Boolean, false,        disabled (bool, false,    ✓
    reflect)                         reflect)
  ──────────────────────────────────────────────────────────────────────────────
  active (n/a — parent-rendered    active (bool, false,      SUI addition: set by
    button, no host prop)            reflect)                  sui-tabs controller to
                                                               drive aria-selected
                                                               and tabIndex
  ──────────────────────────────────────────────────────────────────────────────
  Rendered by parent               button[part="button"]     test table expects
    (no shadow button in Lit)        rendered by sui-tab      shadowPart: 'button'
  ──────────────────────────────────────────────────────────────────────────────
  role=tab / aria-selected         ✓ button has role=tab;    ✓
    managed by parent                aria-selected driven by
                                     `active` prop; tabIndex
                                     managed by sui-tab.ts
  ──────────────────────────────────────────────────────────────────────────────
  Slots: (none — data holder)      (default) + leading       SUI slot for label
                                                               content; leading for
                                                               icon-before-label
  ──────────────────────────────────────────────────────────────────────────────
  Parts: (none)                    button                    ✓
  ──────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ──────────────────────────────────────────────────────────────────────────────
  - No tone prop of its own — this component never declared one and
    still doesn't; `var(--tone)`/`var(--tone-bg)`/`var(--tone-ring)`
    keep being read as inherited custom properties from the ancestor
    sui-tabs host (which sources them from the now-global tone sheet).
    Nothing to delete here — this was never a per-component channel
    redeclaration.
  - L1 CONTROL: the button now opts into the framework's ghost skin
    (transparent background, no border, tone-tinted hover wash,
    :focus-visible/:disabled from the control contracts) instead of
    hand-authoring its own background/border/white-space/font-family/
    cursor/transition — all of those are the framework's baseline now
    (adopted into this shadow root the same way the alert pilot's
    dismiss button is). What's left in residual CSS is genuinely
    component-specific, not something the framework's generic button
    skin has an opinion on: the tab's own dim→foreground color story
    (muted by default, foreground+bold+tone-colored underline when
    active — the framework's ghost color is tone-driven and would
    color EVERY tab, active or not, which isn't this design), the
    hairline underline itself (a single-side border, no sx channel for
    that), and a tone-tinted focus ring (the generic global ring isn't
    tone-aware; this one legitimately still needs to be).
  - The count badge fully moves onto sx (`text:xs weight:medium
    fg:muted-foreground px:2 radius:full bg:muted`) — every value in
    the old hand-written `.count` rule turned out to be closed-vocabulary
    expressible. Its active-state recolor is a class-targeted variants
    directive (`fg:tone bg:tone-bg`).
  - Dropped: the `variant='pill'|'enclosed'` selectors from the feat/next
    baseline. They were already dead code there — `sui-tabs` never
    mirrors its own `variant` prop onto child `<sui-tab>` elements (only
    `active`/`id`/`aria-controls` are set by the controller), so these
    selectors never matched anything in feat/next either. Confirmed by
    reading `sui-tabs.controller.ts`: no `setAttribute('variant', …)`
    call exists. Not preserving unreachable CSS is not a functionality
    drop; flagged here for visibility rather than silently dropped.
  - `display:inline-flex` on .sui-tab is kept — genuinely different from
    the framework's block default (BASE_CSS), needed so tabs lay out
    inline in the strip.
-->

<component>{
  props: {
    name: '',
    label: '',
    count: '',
  },
}</component>
<component>{
  props: {
    disabled: bool,
    active: bool,
  },
}</component>

<variants class="count">
  [active]: fg:tone bg:tone-bg
</variants>

<style>
  .sui-tab { display: inline-flex; }

  button {
    border-bottom: var(--space-1_25) solid transparent;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  button:hover:not(:disabled) { color: var(--foreground); }
  .sui-tab[active] button {
    color: var(--foreground);
    font-weight: var(--font-weight-semibold);
    border-bottom-color: var(--tone);
  }
  .sui-tab[active] button:hover:not(:disabled) { background: transparent; }
  button:focus-visible {
    outline: var(--ring-width) solid var(--tone-ring);
    outline-offset: calc(-1 * var(--ring-width));
  }

  .leading {
    display: none;
    align-items: center;
    flex: 0 0 auto;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-tab.sui'

export default controller<Scope>({
  mount(state, host) {

    // Sync tabIndex on the inner button based on the `active` prop.
    // sui-tabs sets the `active` attribute; this keeps tabIndex in sync
    // so only the active tab is reachable via Tab key (roving tabindex).
    const stopTabIndex = effect(() => {
      const btn = state.$signals.btn()
      if (!btn) return
      btn.tabIndex = state.$signals.active() ? 0 : -1
    })

    return () => {
      stopTabIndex()
    }
  },
})

</controller>
<button class="button" ghost type="button" role="tab" data-name={name()} aria-selected={active() ? 'true' : 'false'} aria-disabled={disabled() ? 'true' : 'false'} disabled={disabled()} bind:this={btn} sx="py:2 px:3 text:sm">
  <row align="center" gap="2">
    <span class="leading"><slot name="leading"></slot></span>
    <slot></slot>
    {#if count() !== ''}
      <span class="count" aria-hidden="true"
        sx="text:xs weight:medium fg:muted-foreground px:2 radius:full bg:muted">{count()}</span>
    {/if}
  </row>
</button>
