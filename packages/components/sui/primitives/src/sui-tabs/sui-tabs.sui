<!--
  <sui-tabs> — SUI port of <ship-tabs>.
  Tab-strip container with arrow-key navigation, roving tabindex, and
  panel orchestration. Children: <sui-tab> (tab buttons via slot).
  Optionally paired with sui-tab-panel for content panels.

  Prop / event / method parity vs <ship-tabs>
  ──────────────────────────────────────────────────────────────────────────────
  Lit                              SUI                       Notes
  ──────────────────────────────────────────────────────────────────────────────
  active (String, '')              active (string, '',       ✓ name of active tab;
                                     reflect)                reflected to host attr
  variant ('underline'|            variant (underline|       ✓ 'segmented' renamed
    'segmented', 'underline')        pill|enclosed,           to 'pill' for SUI
                                     'underline', reflect)    visual catalog; Lit
                                                             'segmented' → 'pill'
  size ('sm'|'md'|'lg', 'md')      size (sm|md|lg, 'md',    ✓
                                     reflect)
  tone (Tone, undefined)           tone (union, 'default',   ✓ drives active-tab
                                     reflect)                 accent color
  sticky (Boolean, false)          sticky (bool, reflect)    ✓ sticky top positioning
  orientation ('horizontal'|       orientation (horizontal|  ✓ controls ArrowLeft/
    'vertical', 'horizontal')        vertical, 'horizontal',  Right vs Up/Down
                                     reflect)
  ──────────────────────────────────────────────────────────────────────────────
  Events: ship-tab-change          sui-tab-change            ✓ renamed; detail.name
    (CustomEvent, composed)          (CustomEvent, composed)
  ──────────────────────────────────────────────────────────────────────────────
  Keyboard: ArrowLeft/Right        ✓ controller (horizontal)  ✓
    ArrowUp/Down (vertical)        ✓ controller (vertical)    ✓
    Home / End                     ✓ controller               ✓
    Enter / Space                  ✓ controller (activate     ✓
                                     focused tab)
  Roving tabindex                  ✓ controller manages       ✓ via sui-tab.active
    (active tab = 0, rest = -1)      sui-tab[active] attr;     prop → sui-tab.ts
                                     sui-tab.ts syncs btn      mirrors to tabIndex
  aria-selected                    ✓ on button in sui-tab     ✓ via sui-tab template
    (button role=tab)                template (active prop)
  aria-controls                    ✓ set by controller        note: panel elements
                                     on tab host              need matching IDs in
                                                              light DOM for ARIA
                                                              resolution to work
  ──────────────────────────────────────────────────────────────────────────────
  Panel coordination               ✓ controller queries       ✓ queries
    (ship-tab-panel active)          [sui-tab-panel][name=X]   document for
                                     in host's subtree         sui-tab-panel
                                                              children
  ──────────────────────────────────────────────────────────────────────────────
  Slots: (default — ship-tab +     (default — sui-tab +      ✓
    ship-tab-panel)                  sui-tab-panel)
  Parts: tablist, tab, indicator   strip, tab (on sui-tab)   ✓ '.strip' satisfies
                                                             test table; per-tab
                                                             parts live in sui-tab
  ──────────────────────────────────────────────────────────────────────────────
  MutationObserver (child edits)   DEFERRED                  Lit observes child
    triggering re-render             (workaround: slotchange)  attribute mutations
                                                              for label/count
                                                              changes; SUI relying
                                                              on slotchange is
                                                              sufficient for
                                                              add/remove; in-place
                                                              edits of label/count
                                                              are a follow-up.
  ResizeObserver + indicator       DEFERRED                  underline indicator
    animation                                                animation requires
                                                             CSS custom property
                                                             measurement; not in
                                                             scope for Tier 3.
  ──────────────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ──────────────────────────────────────────────────────────────────────────────
  - `tone` is a GLOBAL framework channel now. feat/next's per-component
    `:host{--tone:var(--primary)} :host([tone='info']){--tone:var(--info)}…`
    block is DELETED — the framework ships all 8 catalog tones globally
    (suiTonesSheet). One real behavior shift this causes: feat/next's
    unconditional `--tone: var(--primary)` fired regardless of the
    `tone` attribute's actual value (there was no `[tone='default']` or
    `[tone='primary']` override, so BOTH resolved to primary) — under
    the global contract, `tone="default"` now resolves to
    `var(--foreground)` (the catalog's neutral default), matching the
    convention sui-alert/sui-badge/sui-chip already established for
    "default". `tone="primary"` still resolves to primary explicitly.
    So the out-of-the-box (no `tone` attribute set) active-tab color
    moves from primary-blue to foreground-neutral. This is the same
    catalog-wide convention shift sui-alert's own header comment
    documents for its own default tone — not a LANG-GAP, a deliberate,
    already-precedented consequence of tone going global. A caller
    that wants the old default look sets `tone="primary"` explicitly.
  - `sui-tab` (the child) never declares its own `tone` prop — it only
    reads `var(--tone)`/`var(--tone-bg)`/`var(--tone-ring)`, which
    inherit down through the light DOM from this host. That plumbing is
    unchanged; only the SOURCE of `--tone` moved from a local block to
    the global sheet.
  - The `.strip` container is now a `row` layout primitive (gap, center
    alignment) instead of a hand-rolled flex div — sx doesn't own
    gap/align (that's the layout primitives' job), so this is the
    correct new-surface home for it, not a workaround.
  - `display:block` and `[hidden]` dropped from :host — framework-owned
    now (BASE_CSS).
  - Residual <style> (verbatim feat/next, tokens only): `.strip`'s
    `border-bottom` (sx `border:` is a 4-side shorthand, no single-side
    channel), the orientation=vertical flip (flex-direction/border-side
    swap — no such sx channels), the pill/enclosed gap tweak (`gap`
    isn't sx vocabulary), and `[sticky]`'s `top:0` (no `top` channel).
    The rest of `sticky`'s and `variant=pill`'s declarations move to a
    variants directive (position/z-index/background/border/radius/
    padding are all valid sx tokens).
-->

<prop name="active" type="string" default="" reflect />
<component>{
  props: {
    variant: 'underline' | 'pill' | 'enclosed',
    size: 'sm' | 'md' | 'lg',
    tone,
    sticky: bool,
    orientation: 'horizontal' | 'vertical',
    'activation-mode': 'automatic' | 'manual',
  },
}</component>

<variants>
  sticky: position:sticky z:sticky bg:background
</variants>
<variants class="strip">
  variant=pill: border:none bg:muted radius:md p:1
</variants>

<style>
  :host([sticky]) { top: 0; }

  .strip {
    border-bottom: 1px solid var(--border);
  }
  :host([variant='enclosed']) .strip { gap: 0; }
  :host([orientation='vertical']) .strip {
    flex-direction: column;
    align-items: flex-start;
    border-bottom: 0;
    border-right: 1px solid var(--border);
  }

  ::slotted(sui-tab),
  ::slotted([slot='tab']) {
    flex: 0 0 auto;
  }
</style>


<controller>
import { controller, effect, signal } from '@ship/sui-runtime'
import type { Scope } from './sui-tabs.sui'

export default controller<Scope>({
  mount(state, host) {

    // Version counter bumped on slotchange to force the sync effect to re-run.
    const slotVersion = signal(0)

    const getTabs = (): Element[] => {
      const slot = state.$signals.tabSlot()
      if (!slot) return Array.from(host.querySelectorAll(':scope > sui-tab'))
      return (slot as HTMLSlotElement).assignedElements()
        .filter(el => el.tagName.toLowerCase() === 'sui-tab')
    }

    const activate = (name: string) => {
      if (state.$signals.active() === name) return
      state.$signals.active.set(name)
      host.dispatchEvent(new CustomEvent('sui-tab-change', {
        detail: { name }, bubbles: true, composed: true,
      }))
    }

    // Sync active + aria-controls state onto <sui-tab> and panel children.
    // Runs reactively on active changes and on slotchange (via slotVersion).
    const stopSync = effect(() => {
      slotVersion()  // track so effect re-runs on slot mutations
      const activeName = state.$signals.active()
      const tabs = getTabs()

      // Default: first tab active when active is unset and tabs exist.
      let resolved = activeName
      if (!resolved && tabs.length > 0) {
        resolved = tabs[0]!.getAttribute('name') ?? ''
        if (resolved) state.$signals.active.set(resolved)
      }

      for (const tab of tabs) {
        const name = tab.getAttribute('name') ?? ''
        if (name === resolved) {
          tab.setAttribute('active', '')
        } else {
          tab.removeAttribute('active')
        }
        tab.id = `sui-tab-${name}`
        tab.setAttribute('aria-controls', `sui-tabpanel-${name}`)
      }

      // Sync any sui-tab-panel or role=tabpanel children.
      for (const panel of Array.from(
        host.querySelectorAll(':scope > sui-tab-panel, :scope > [role="tabpanel"]'),
      )) {
        const name = panel.getAttribute('name') ?? ''
        if (name === resolved) {
          panel.removeAttribute('hidden')
          panel.setAttribute('active', '')
        } else {
          panel.setAttribute('hidden', '')
          panel.removeAttribute('active')
        }
      }
    })

    const onKeydown = (e: KeyboardEvent) => {
      const vertical = state.$signals.orientation() === 'vertical'
      const nextKey = vertical ? 'ArrowDown' : 'ArrowRight'
      const prevKey = vertical ? 'ArrowUp' : 'ArrowLeft'
      const navKeys = [nextKey, prevKey, 'Home', 'End']
      const activateKeys = ['Enter', ' ']

      const isNav = navKeys.includes(e.key)
      const isActivate = activateKeys.includes(e.key)
      if (!isNav && !isActivate) return

      const tabs = getTabs().filter(t => !t.hasAttribute('disabled'))
      if (!tabs.length) return
      const names = tabs.map(t => t.getAttribute('name') ?? '')

      // Radix-parity: manual activation moves focus without changing the
      // active panel. Enter/Space on the focused tab activates it.
      const manual = state.$signals.activationMode() === 'manual'
      const focusedTab = (e.target as Element).closest('sui-tab')
        ?? tabs.find(t => t.getAttribute('name') === state.$signals.active())
        ?? tabs[0]
      const focusedName = focusedTab?.getAttribute('name') ?? ''

      if (isActivate) {
        e.preventDefault()
        activate(focusedName)
        return
      }

      e.preventDefault()
      const refName = manual ? focusedName : state.$signals.active()
      const i = Math.max(0, names.indexOf(refName))
      let next = i

      if (e.key === nextKey) next = (i + 1) % names.length
      else if (e.key === prevKey) next = (i - 1 + names.length) % names.length
      else if (e.key === 'Home') next = 0
      else if (e.key === 'End') next = names.length - 1

      const targetName = names[next]!
      if (!manual) activate(targetName)

      queueMicrotask(() => {
        const targetTab = tabs[next] as HTMLElement
        const btn = targetTab.shadowRoot?.querySelector<HTMLElement>('button')
        // In manual mode the candidate tab isn't `active`, so its inner
        // button stays at tabindex=-1 by default. Bump it to 0 so Tab
        // away/back returns to the focused candidate (roving tabindex).
        if (manual && btn) {
          for (const t of tabs) {
            const b = (t as HTMLElement).shadowRoot?.querySelector<HTMLElement>('button')
            if (b) b.tabIndex = -1
          }
          btn.tabIndex = 0
        }
        btn ? btn.focus() : targetTab.focus()
      })
    }

    const onClick = (e: MouseEvent) => {
      const target = (e.target as Element).closest('sui-tab')
      if (!target || target.hasAttribute('disabled')) return
      const name = target.getAttribute('name') ?? ''
      if (name) activate(name)
    }

    const onSlotChange = () => slotVersion.set(slotVersion() + 1)

    const strip = state.$signals.strip()
    const tabSlot = state.$signals.tabSlot()

    if (strip) {
      strip.addEventListener('keydown', onKeydown)
      strip.addEventListener('click', onClick)
    }
    if (tabSlot) {
      tabSlot.addEventListener('slotchange', onSlotChange)
    }

    return () => {
      stopSync()
      if (strip) {
        strip.removeEventListener('keydown', onKeydown)
        strip.removeEventListener('click', onClick)
      }
      if (tabSlot) {
        tabSlot.removeEventListener('slotchange', onSlotChange)
      }
    }
  },
})

</controller>
<row class="strip" part="strip" role="tablist"
     aria-orientation={orientation()}
     bind:this={strip}
     gap="1" align="center">
  <slot bind:this={tabSlot}></slot>
</row>
