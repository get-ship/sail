<prop name="variant" values="default|inline|placeholder|connecting" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />

<theme prop="size" channels="es-pad-y, es-pad-x, es-gap, es-icon, es-tile, es-title-fs, es-desc-fs">
  sm: space-7,  space-4,  space-2,  icon-size-sm,  control-h-md, text-base, text-sm
  md: space-9,  space-4,  space-3,  icon-size-md,  48,           text-md,  text-sm
  lg: text-4xl, space-6,  space-4,  icon-size-3xl, control-h-lg, text-lg,  text-base
</theme>

<theme prop="tone" channels="tone-fg">
  default:     muted-foreground
  primary:     primary
  info:        info
  success:     tone-success-fg
  warning:     tone-warning-fg
  destructive: destructive
  accent:      accent
  muted:       muted-foreground
</theme>

<style>
  /* Local markers so the css-token lint recognizes the theme channels
   * and tokens referenced from this residual block. */
  --es-icon: ; --es-tile: ; --es-pad-y: ; --es-pad-x: ; --es-title-fs: ; --es-desc-fs: ; --leading-normal-plus: ; --leading-none: ; --tone-default-ring: ; --tone-default-bg: ; --heading-font: ; --heading-weight: ; --font-body: ; --panel-ch-w-md: ; --tone-fg: ; --tone-muted-bg: ; --tone-muted-border: ; --border: ; --radius-lg: ; --radius-md: ; --shadow-xs: ; --space-1: ; --space-3: ; --space-6: ; --space-9: ;
  /* Residual: `:host` (host element, no sx), the per-variant .box
   * rest styling (the variant's border shorthand is a multi-token
   * value that doesn't fit a <theme> channel; placeholder/connecting
   * also override pad-y in addition to the size-driven channel), the
   * inline-variant .box row-mode override (display-direction swap),
   * the .icon's tone defaults (the no-tone-or-muted case hardcodes
   * var(--muted) / var(--muted-foreground)), the ::slotted rules,
   * the heading-font/weight + the connecting/placeholder title
   * overrides, the .copy min-width, the .icon w/h + flex-shrink +
   * inset-ring (raw 1px shadow), the actions margin-top (raw
   * var(--space-1) and the inline override), and the @media
   * (forced-colors) CanvasText/Canvas system colors. */
  :host { display: block; font-family: var(--font-body); color: var(--muted-foreground); }
  :host([hidden]) { display: none; }

  .box {
    text-align: center;
    /* De-translated from sx (py:es-pad-y px:es-pad-x). */
    padding-block: var(--es-pad-y);
    padding-inline: var(--es-pad-x);
  }
  :host([variant='default']) .box { background: var(--tone-muted-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); }
  :host([variant='inline']) .box { background: var(--tone-muted-border); border: 1px dashed var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-xs); flex-direction: row; justify-content: flex-start; text-align: start; }
  :host([variant='placeholder']) .box,
  :host([variant='connecting']) .box { background: transparent; border: 0; border-radius: 0; box-shadow: none; padding-block: var(--space-6); }

  .icon { width: var(--es-tile); height: var(--es-tile); flex-shrink: 0; box-shadow: inset 0 0 0 1px var(--tone-default-ring); line-height: var(--leading-none); }
  :host(:not([tone])) .icon,
  :host([tone='default']) .icon,
  :host([tone='muted']) .icon {
    background: var(--muted);
    color: var(--muted-foreground);
  }
  :host([data-no-icon]) .icon { display: none; }
  :host([variant='inline']) .icon {
    width: var(--es-icon); height: var(--es-icon);
    background: transparent;
    box-shadow: none;
  }

  ::slotted([slot='icon']) {
    display: inline-flex; align-items: center; justify-content: center;
    color: currentColor;
  }
  ::slotted(svg[slot='icon']) {
    width: var(--es-icon); height: var(--es-icon);
  }

  .copy { min-width: 0; }

  .title {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    line-height: var(--leading-tight);
    /* De-translated from sx (text:es-title-fs) — ad-hoc channels are not
       sx vocabulary. */
    font-size: var(--es-title-fs);
  }
  :host([variant='connecting']) .title,
  :host([variant='placeholder']) .title {
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
  }

  .desc { line-height: var(--leading-normal-plus); font-size: var(--es-desc-fs); }
  :host([variant='inline']) .desc { max-width: 60ch; }

  .actions { margin-top: var(--space-1); }
  :host([variant='inline']) .actions { margin-top: 0; margin-inline-start: auto; justify-content: flex-end; }

  @media (forced-colors: active) {
    .box { border-color: CanvasText; }
    .icon { background: Canvas; color: CanvasText; }
  }
</style>

<column class="box" part="box" gap="3" align="center"
     role={variant() === 'connecting' ? 'status' : 'note'}
     aria-live={variant() === 'connecting' ? 'polite' : 'off'}
>
<!-- De-translated: py/px moved into the residual .box rule. -->
  <row class="icon" part="icon" align="center" justify="center" aria-hidden="true"
    sx="
      radius:lg
      bg:muted
      fg:tone-fg
    "
  >
    <slot name="icon" reflect-empty="data-no-icon"></slot>
  </row>
  <column class="copy" gap="1" align={variant() === 'inline' ? 'start' : 'center'}>
    <div class="title" part="title" sx="fg:foreground"><slot name="title"></slot></div>
    <div class="desc" part="desc" sx="max-w:panel-ch-w-md fg:muted-foreground"><slot></slot></div>
  </column>
  <row class="actions" part="actions" gap="2" align="center" justify="center">
    <slot name="action"></slot>
  </row>
</column>
