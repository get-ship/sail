<!--
  <sui-slider> — SUI port of <ship-slider>.
  Horizontal range slider with filled track and draggable thumb. Supports
  pointer drag, click-on-track, and full keyboard suite.

  Prop parity vs <ship-slider>
  ────────────────────────────────────────────────────────────────────────
  value (number, 0)           ✓ reflect
  min (number, 0)             ✓
  max (number, 100)           ✓
  step (number, 1)            ✓
  disabled (bool, false)      ✓ reflect
  tone (Tone, 'default')      ✓ reflect
  size (sm|md|lg, 'md')       ✓ reflect
  name (string, '')           ✓ — form field name
  label (string, 'slider')    ✓ — aria-label on thumb
  ────────────────────────────────────────────────────────────────────────
  Events: ship-change → sui-change { detail: { value: number } }
  ────────────────────────────────────────────────────────────────────────
  Parts: track, fill, thumb
-->

<prop name="value" type="number" default="0" reflect />
<prop name="min" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="step" type="number" default="1" />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="name" type="string" default="" />
<prop name="label" type="string" default="slider" />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    -webkit-tap-highlight-color: transparent;
    --tone: var(--primary);
  }
  :host([hidden]) { display: none; }

  :host(:not([tone])),
  :host([tone='default'])     { --tone: var(--primary); }
  :host([tone='primary'])     { --tone: var(--primary); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); }

  :host(:not([size])),
  :host([size='md']) { --sl-h: 6px; --sl-thumb: 16px; }
  :host([size='sm']) { --sl-h: 4px; --sl-thumb: 12px; }
  :host([size='lg']) { --sl-h: 8px; --sl-thumb: 20px; }

  .container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--sl-thumb);
    cursor: pointer;
    touch-action: none;
  }
  :host([disabled]) .container {
    cursor: not-allowed;
    color: var(--muted-foreground);
    filter: saturate(0.4);
  }

  .track {
    position: relative;
    width: 100%;
    height: var(--sl-h);
    background: var(--muted);
    border-radius: var(--radius-full);
    overflow: hidden;
    /* Hairline inset so the groove reads on light themes. */
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--tone);
    border-radius: inherit;
    /* Soft top inset-highlight for depth. */
    box-shadow: inset 0 1px 0 var(--surface-2);
  }

  .thumb {
    position: absolute;
    top: 50%;
    width: var(--sl-thumb);
    height: var(--sl-thumb);
    background: var(--surface-1);
    border: 2px solid var(--tone);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    box-sizing: border-box;
    outline: none;
  }
  .thumb:hover { box-shadow: var(--shadow-md); transform: translate(-50%, -50%) scale(1.05); }
  .thumb:active { transform: translate(-50%, -50%) scale(0.95); }

  /* Canonical focus convention, tone-tinted via local --ring-color. */
  :host(:not([disabled])) .thumb:focus-visible {
    --ring-color: var(--tone);
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (forced-colors: active) {
    .thumb { border-color: CanvasText; }
    .fill { background: Highlight; }
    .thumb:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<div class="container" bind:this={containerEl}>
  <div class="track" part="track" bind:this={trackEl}>
    <div class="fill" part="fill" bind:this={fillEl}></div>
  </div>
  <div
    class="thumb"
    part="thumb"
    role="slider"
    tabindex={disabled() ? '-1' : '0'}
    aria-valuemin={min()}
    aria-valuemax={max()}
    aria-valuenow={value()}
    aria-label={label() || 'slider'}
    aria-disabled={disabled() ? 'true' : 'false'}
    bind:this={thumbEl}
  ></div>
</div>
