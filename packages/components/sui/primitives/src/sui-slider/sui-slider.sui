<!--
  <sui-slider> — SUI port of <ship-slider>.
  Horizontal range slider with filled track and draggable thumb. Supports
  pointer drag, click-on-track, and full keyboard suite.

  Prop parity vs <ship-slider>
  ─────────────────────────────────────────────────────────────────────────────
  value (number, 0)           ✓ reflect
  min (number, 0)             ✓
  max (number, 100)           ✓
  step (number, 1)            ✓
  disabled (bool, false)      ✓ reflect
  tone (Tone, 'default')      ✓ reflect
  size (sm|md|lg, 'md')       ✓ reflect
  name (string, '')           ✓ — form field name
  label (string, 'slider')    ✓ — aria-label on thumb
  ─────────────────────────────────────────────────────────────────────────────
  Events: ship-change → sui-change { detail: { value: number } }
  ─────────────────────────────────────────────────────────────────────────────
  Parts: track, fill, thumb
-->

<prop name="value" type="number" default="0" reflect />
<prop name="min" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="step" type="number" default="1" />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="name" type="string" default="" />
<prop name="label" type="string" default="slider" />

<theme prop="tone" channels="tone">
  default:     primary
  primary:     primary
  info:        info
  success:     success
  warning:     warning
  destructive: destructive
  accent:      accent
  muted:       muted-foreground
</theme>

<variants part="container">
  size=sm: h:icon-size-xs
  size=md: h:icon-size-md
  size=lg: h:icon-size-xl
  disabled: cursor:not-allowed fg:muted-foreground
</variants>

<variants part="track">
  size=sm: h:1
  size=md: h:1_5
  size=lg: h:2
</variants>

<variants part="thumb">
  size=sm: w:icon-size-xs h:icon-size-xs
  size=md: w:icon-size-md h:icon-size-md
  size=lg: w:icon-size-xl h:icon-size-xl
</variants>

<!--
  Residual <style> — truly unavoidable bits:
  - :host display + font-family + -webkit-tap-highlight-color
  - :host(:not([tone])) default --tone (covered by <theme> default)
  - :host([size]) --sl-h/--sl-thumb vars (consumed by children)
  - .container display:flex + align-items + touch-action
  - :host([disabled]) .container filter
  - .track background + border-radius + box-shadow inset
  - .fill position + height + box-shadow inset highlight
  - .thumb position + top + border (tone-tinged via var) + border-radius + transform translate(-50%,-50%) + box-shadow + transition multi-prop + box-sizing + outline
  - .thumb :hover box-shadow + transform scale(1.05)
  - :host(:not([disabled])) .thumb:focus-visible --ring-color + outline + outline-offset
-->
<style>
  :host {
    display: block;
    font-family: var(--font-body);
    -webkit-tap-highlight-color: transparent;
    --icon-size-xs: 12px;
    --icon-size-md: 16px;
    --icon-size-xl: 20px;
  }
  :host([size='sm']) { --sl-h: var(--space-1); --sl-thumb: var(--icon-size-xs); }
  :host([size='md']) { --sl-h: var(--space-1_5); --sl-thumb: var(--icon-size-md); }
  :host([size='lg']) { --sl-h: var(--space-2); --sl-thumb: var(--icon-size-xl); }
  .container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    cursor: pointer;
    touch-action: none;
  }
  :host([disabled]) .container { filter: saturate(0.6); }
  .track {
    position: relative;
    width: 100%;
    background: var(--muted);
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--tone);
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--surface-2);
  }
  .thumb {
    position: absolute;
    top: 50%;
    background: var(--surface-1);
    border: var(--ring-width) solid var(--tone);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    box-sizing: border-box;
    outline: none;
  }
  .thumb:hover { box-shadow: var(--shadow-md); transform: translate(-50%, -50%) scale(1.05); }
  .thumb:active { transform: translate(-50%, -50%) scale(0.95); }
  :host(:not([disabled])) .thumb:focus-visible {
    --ring-color: var(--tone);
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    .thumb { border-color: CanvasText; }
    .fill { background: Highlight; }
    .thumb:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<div class="container" part="container" bind:this={containerEl}
  sx="position:relative w:full cursor:pointer">
  <div class="track" part="track" bind:this={trackEl}
    sx="w:full bg:muted radius:full overflow:hidden">
    <div class="fill" part="fill" bind:this={fillEl}
      sx="position:absolute h:full bg:tone radius:full"></div>
  </div>
  <div
    class="thumb" part="thumb" role="slider"
    tabindex={disabled() ? '-1' : '0'}
    aria-valuemin={min()}
    aria-valuemax={max()}
    aria-valuenow={value()}
    aria-label={label() || 'slider'}
    aria-disabled={disabled() ? 'true' : 'false'}
    bind:this={thumbEl}
    sx="position:absolute bg:surface-1 radius:full shadow:sm"
  ></div>
</div>
