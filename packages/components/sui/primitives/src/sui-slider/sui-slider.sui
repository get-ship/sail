<!--
  sui-slider — SUI port of ship-slider.
  Horizontal range slider with filled track and draggable thumb. Supports
  pointer drag, click-on-track, and full keyboard suite.
  Parts: track, fill, thumb.

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  - tone is a GLOBAL framework channel: no per-component theme block.
    The fill and thumb border read var(--tone) directly. ONE override
    preserved: the default tone in the global channel maps --tone to
    --foreground, but the slider's baseline visual is primary-tinted.
    :host(:not([tone])) and :host([tone=default]) restore --tone
    to --primary — same precedent as sui-toast's default-tone override.
  - size is a GLOBAL framework channel, but the slider's track HEIGHT
    and thumb SIZE don't map onto the global size family. Kept as a
    per-component theme block — same precedent as sui-input's
    per-component size channels.
  - sx is closed-vocabulary. style keeps what sx structurally cannot
    express: the container's flex layout, the track's inset border,
    the fill's top-highlight, the thumb's transform + scale, the
    tone-tinted focus outline, the forced-colors CanvasText outline,
    the disabled saturate filter, the touch-action opt-out, and the
    reduced-motion kill switch.
  - The 2px thumb border is feat/next's choice (--ring-width, the
    framework's standard stroke weight) — not quantized.
-->

<prop name="value" type="number" default="0" reflect />
<prop name="min" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="step" type="number" default="1" />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="name" type="string" default="" />
<prop name="label" type="string" default="slider" />

<theme prop="size" channels="sl-h, sl-thumb">
  sm: space-1,    icon-size-xs
  md: space-1_5,  icon-size-sm
  lg: space-2,    icon-size-md
</theme>

<style>
  --sl-h: ; --sl-thumb: ;
  :host {
    display: block;
    font-family: var(--font-body);
    -webkit-tap-highlight-color: transparent;
  }
  :host(:not([tone])),
  :host([tone='default']) { --tone: var(--primary); }

  .container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    cursor: pointer;
    touch-action: none;
  }
  :host([disabled]) .container { filter: saturate(0.6); }

  .track {
    position: relative;
    width: 100%;
    height: var(--sl-h);
    background: var(--muted);
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--tone);
    border-radius: inherit;
    box-shadow: inset 0 1px 0 var(--surface-2);
  }

  .thumb {
    position: absolute;
    top: 50%;
    width: var(--sl-thumb);
    height: var(--sl-thumb);
    background: var(--surface-1);
    border: var(--ring-width) solid var(--tone);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    box-sizing: border-box;
    outline: none;
  }
  .thumb:hover { box-shadow: var(--shadow-md); transform: translate(-50%, -50%) scale(1.05); }
  .thumb:active { transform: translate(-50%, -50%) scale(0.95); }
  :host(:not([disabled])) .thumb:focus-visible {
    --ring-color: var(--tone);
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    .thumb { border-color: CanvasText; }
    .fill { background: Highlight; }
    .thumb:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>


<controller>
import { controller, effect } from '@ship/sui-runtime'
import type { Scope } from './sui-slider.sui'

export default controller<Scope>({
  mount(state, host) {

    // Light-DOM hidden input for form participation.
    const hiddenInput = document.createElement('input')
    hiddenInput.type = 'hidden'
    host.appendChild(hiddenInput)

    const clamp = (v: number): number => {
      const step = state.$signals.step() as number
      const min = state.$signals.min() as number
      const max = state.$signals.max() as number
      const stepped = Math.round((v - min) / step) * step + min
      return Math.max(min, Math.min(max, stepped))
    }

    const setValue = (v: number) => {
      const clamped = clamp(v)
      if (clamped === (state.$signals.value() as number)) return
      state.$signals.value.set(clamped)
      hiddenInput.name = state.$signals.name() as string
      hiddenInput.value = String(clamped)
      host.dispatchEvent(new CustomEvent('sui-change', {
        detail: { value: clamped },
        bubbles: true,
        composed: true,
      }))
    }

    const valueFromPointer = (clientX: number): number => {
      const track = state.$signals.trackEl() as HTMLElement | null
      if (!track) return state.$signals.value() as number
      const rect = track.getBoundingClientRect()
      const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width))
      return (state.$signals.min() as number) + pct * ((state.$signals.max() as number) - (state.$signals.min() as number))
    }

    // Sync fill + thumb position and hidden input on value/range changes.
    const stopPositionSync = effect(() => {
      const val = state.$signals.value() as number
      const min = state.$signals.min() as number
      const max = state.$signals.max() as number
      const range = max - min || 1
      const pct = ((val - min) / range) * 100

      const fill = state.$signals.fillEl() as HTMLElement | null
      const thumb = state.$signals.thumbEl() as HTMLElement | null
      if (fill) fill.style.width = `${pct}%`
      if (thumb) thumb.style.left = `${pct}%`

      hiddenInput.name = state.$signals.name() as string
      hiddenInput.value = String(val)
    })

    let dragging = false

    const onPointerDown = (e: PointerEvent) => {
      if (state.$signals.disabled() as boolean) return
      e.preventDefault()
      dragging = true
      setValue(valueFromPointer(e.clientX))
      const thumb = state.$signals.thumbEl() as HTMLElement | null
      thumb?.focus()

      const onMove = (ev: PointerEvent) => { if (dragging) setValue(valueFromPointer(ev.clientX)) }
      const onUp = () => {
        dragging = false
        document.removeEventListener('pointermove', onMove)
        document.removeEventListener('pointerup', onUp)
      }
      document.addEventListener('pointermove', onMove)
      document.addEventListener('pointerup', onUp)
    }

    const onKeydown = (e: KeyboardEvent) => {
      if (state.$signals.disabled() as boolean) return
      const step = state.$signals.step() as number
      let handled = true
      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowUp':
          setValue((state.$signals.value() as number) + step)
          break
        case 'ArrowLeft':
        case 'ArrowDown':
          setValue((state.$signals.value() as number) - step)
          break
        case 'Home':
          setValue(state.$signals.min() as number)
          break
        case 'End':
          setValue(state.$signals.max() as number)
          break
        case 'PageUp':
          setValue((state.$signals.value() as number) + step * 10)
          break
        case 'PageDown':
          setValue((state.$signals.value() as number) - step * 10)
          break
        default:
          handled = false
      }
      if (handled) e.preventDefault()
    }

    const stopPointer = effect(() => {
      const container = state.$signals.containerEl() as HTMLElement | null
      if (!container) return
      container.addEventListener('pointerdown', onPointerDown as EventListener)
      return () => container.removeEventListener('pointerdown', onPointerDown as EventListener)
    })

    const stopKeydown = effect(() => {
      const thumb = state.$signals.thumbEl() as HTMLElement | null
      if (!thumb) return
      thumb.addEventListener('keydown', onKeydown)
      return () => thumb.removeEventListener('keydown', onKeydown)
    })

    return () => {
      stopPositionSync()
      stopPointer()
      stopKeydown()
      hiddenInput.remove()
    }
  },
})

</controller>
<div class="container" part="container" bind:this={containerEl}>
  <div class="track" part="track" bind:this={trackEl}
    sx="w:full bg:muted radius:full overflow:hidden">
    <div class="fill" part="fill" bind:this={fillEl}
      sx="position:absolute h:full bg:tone radius:full"></div>
  </div>
  <div
    class="thumb" part="thumb" role="slider"
    tabindex={disabled() ? '-1' : '0'}
    aria-valuemin={min()}
    aria-valuemax={max()}
    aria-valuenow={value()}
    aria-label={label() || 'slider'}
    aria-disabled={disabled() ? 'true' : 'false'}
    bind:this={thumbEl}
    sx="position:absolute bg:surface-1 radius:full shadow:sm"
  ></div>
</div>
