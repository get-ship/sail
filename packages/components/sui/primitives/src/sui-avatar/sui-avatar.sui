<!--
  <sui-avatar> — SUI port of <ship-avatar>.
  Image/initials/icon avatar with size, shape, and tone channels.

  Prop / event / method parity vs <ship-avatar>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  src (String, '')             src (string, '')         ✓
  name (String, '')            name (string, '')        ✓ used for aria-label
                                                         and initials derivation
  initials (String, '')        initials (string, '')    ✓ explicit override;
                                                         uppercased at display
  size ('sm'|'md'|'lg'|'xl',  size (xs|sm|md|lg|xl,    ✓ SUI adds xs (20px)
    'md')                        'md', reflect)
  shape ('round'|'square',     shape (round|square,     ✓
    'round')                     'round', reflect)
  tone (Tone, 'muted')         tone (union, 'muted',    ✓ drives background
                                 reflect)                tint in initials mode
  icon-slug (String, '')       icon-slug (string, '')   ✓ populates src from
                                                         simpleicons CDN
  ─────────────────────────────────────────────────────────────────────────────
  identity-hue (String, '')    OMITTED                  Requires controller to
                                                         compute conic-gradient
                                                         inline style; template-
                                                         only divergence.
  _errored (private state)     errored (scope signal)   Radix-parity: img.onerror
                                                         flips `errored=true`, the
                                                         template falls back to
                                                         initials. Resets when src
                                                         changes (controller).
  updated() → data-initials    OMITTED                  No host attr toggling
                                                         without controller.
  ─────────────────────────────────────────────────────────────────────────────
  Initials derivation:         1-2 char: uses           ✓ SUI derives two-word
    first+last word initial      initials prop or         initials from name in
                                 first char of name       template expression
                                 (single-word names       (multi-word full deri-
                                  only, limitation)       vation omitted for
                                                         template simplicity)
  ─────────────────────────────────────────────────────────────────────────────
  parts: wrap, initials        parts: root, initials    SUI uses 'root' for
    img                          img                      wrap parity
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="src" type="string" default="" />
<prop name="name" type="string" default="" />
<prop name="initials" type="string" default="" />
<prop name="icon-slug" type="string" default="" />
<prop name="size" values="xs|sm|md|lg|xl" default="md" reflect />
<prop name="shape" values="round|square" default="round" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="muted" reflect />

<variants part="root">
  shape=square: radius:sm
  size=xs: w:5 h:5 text:xs
  size=sm: w:control-h-sm h:control-h-sm text:xs
  size=md: w:7 h:7 text:base
  size=lg: w:control-h-lg h:control-h-lg text:lg
  size=xl: w:control-h-xl h:control-h-xl text:2xl
  tone=primary:     bg:primary fg:primary-foreground
  tone=accent:      bg:accent fg:accent-foreground
  tone=info:        bg:tone-info-bg fg:info
  tone=success:     bg:tone-success-bg fg:success
  tone=warning:     bg:tone-warning-bg fg:warning
  tone=destructive: bg:tone-destructive-bg fg:destructive
</variants>

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    /* Default (no [tone]) fill: the brand gradient — no sx/token equivalent.
       Per-tone SOLID fills come from <variants part="root"> (bg:…), which
       override this. Size + font-size also come from <variants> now. */
    --av-bg: linear-gradient(135deg, var(--primary), var(--accent));
    --av-fg: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .root {
    /* Round (the DEFAULT) = a perfect circle. Base rule, not
       `:host([shape='round'])`, because a defaulted `shape` isn't reflected to
       the attribute — so the selector wouldn't match. `shape=square` overrides
       via <variants> (radius:sm). sx has no 50% utility, so this is irreducible. */
    border-radius: 50%;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: var(--av-bg);
    color: var(--av-fg);
    font-family: var(--font-body);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1;
    overflow: hidden;
    user-select: none;
    box-shadow: inset 0 0 0 1px var(--border),
                inset 0 1px 0 var(--background);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 10%;
    box-sizing: border-box;
  }
</style>


<controller>
import { controller, effect, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-avatar.sui'

// Radix-parity: when an image is provided but fails to load, fall back
// to initials instead of leaving a broken-image rect in the avatar.
// Mirrors Radix Avatar.Image's `onLoadingStatusChange('error')` →
// Avatar.Fallback compose pattern.

export default controller({
  scope: (_ctx: ViewScope<Scope>) => {
    const errored = signal(false)
    return { errored }
  },

  mount(state, host) {
    // Reset `errored` whenever the source changes so a recovered URL
    // gets another shot at loading.
    let lastSrc = ''
    const stopSrcReset = effect(() => {
      const src = (state.iconSlug || state.src) as string
      if (src !== lastSrc) {
        lastSrc = src
        state.errored = false
      }
    })

    const onImgError = (e: Event) => {
      const tag = (e.target as HTMLElement | null)?.tagName?.toLowerCase()
      if (tag !== 'img') return
      state.errored = true
    }
    // `error` doesn't bubble, but does compose via { capture: true }.
    host.shadowRoot?.addEventListener('error', onImgError, true)

    return () => {
      stopSrcReset()
      host.shadowRoot?.removeEventListener('error', onImgError, true)
    }
  },
})

</controller>
<!-- De-translated: w:sz / h:sz / text:fs removed — the residual .root rule
     already declares width/height/font-size via var(--sz)/var(--fs). -->
<span class="root" part="root" sx="weight:bold overflow:hidden"
      role="img"
      aria-label={name() || initials() || 'avatar'}>
  {#if (iconSlug() || src()) && !errored()}
    <img part="img"
         src={iconSlug() ? 'https://cdn.simpleicons.org/' + iconSlug() : src()}
         alt={name()} />
  {:else}
    <span part="initials">
      {initials() ? initials().slice(0, 2).toUpperCase() : (name().trim().slice(0, 1).toUpperCase() || '?')}
    </span>
  {/if}
</span>
