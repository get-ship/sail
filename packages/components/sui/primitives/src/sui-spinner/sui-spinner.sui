<!--
  <sui-spinner> — SUI port of <ship-spinner>.
  Rotating ring spinner for loading states.

  Prop / event / method parity vs <ship-spinner>
  ─────────────────────────────────────────────────────────────────────────────
  tone (String, 'info')           tone (union, reflect)   ✓ default changed to
                                                          'default' (muted-fg)
                                                          as a more neutral base
  size ('sm'|'md'|'lg', 'md')     size (union, reflect)   ✓ + xs added (10px)
  label (String, 'Loading')       label (string,          △ SFC surface has no
                                    '')                     per-prop string-default
                                                            literal; baseline's
                                                            'Loading' is not
                                                            expressed — see
                                                            LANG-GAP(prop-default)
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)             ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: spinner                  part="ring"             renamed — 'ring'
                                                          describes the shape
  ─────────────────────────────────────────────────────────────────────────────
  role="status" aria-label always role="status" when      Lit always sets
    set                             label is present;     role; SUI omits it
                                    aria-hidden otherwise when no label to
                                                          avoid empty status
  Lit uses border-top-color        SUI uses border-right- right-color produces
    for the gap                     color: transparent     consistent rotation
  ─────────────────────────────────────────────────────────────────────────────
-->

<!--
LANG-GAP(prop-default): the SFC component block desugars
  `label: string` to prop type=string default='' and `centered:
  bool` to prop type=bool default=false reflect (see
  crates/sui/compiler/src/parse/preprocess.rs::expand_props). There is
  no surface to express the baseline's `label: 'Loading'` default
  literal. Result: an unkeyed spinner renders with role=null and
  aria-label=null (the template's `label() || null` short-circuits),
  where the baseline renders role="status" aria-label="Loading". The
  component still reacts to an explicit `label="…"` attribute; the gap
  is the unkeyed default. The same generic gap applies to any `bool`
  default that differs from false. A non-LANG-GAP fix would extend
  expand_props to read `label: 'Loading'` from the props object
  literal.
-->


<component>{
  props: {
    size: 'xs' | 'sm' | 'md' | 'lg',
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    label: 'Loading',
    centered: bool,
  },
}</component>

<!--
  Residual: every declaration below is the verbatim feat/next CSS. The
  components are LANG-GAPs the SFC surface cannot express today and are
  documented at the bottom of the file (see LANG-GAP comments). :host
  idioms are left as-is — the --light compile rewrites them to :scope.
-->
<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    --tone-fg: var(--muted-foreground);
    --sz: 16px;
    --bw: 2px;
  }
  :host([tone='primary'])     { --tone-fg: var(--primary);     --tone-ring: var(--tone-primary-ring); }
  :host([tone='info'])        { --tone-fg: var(--info);         --tone-ring: var(--tone-info-ring); }
  :host([tone='success'])     { --tone-fg: var(--success);      --tone-ring: var(--tone-success-ring); }
  :host([tone='warning'])     { --tone-fg: var(--warning);      --tone-ring: var(--tone-warning-ring); }
  :host([tone='destructive']) { --tone-fg: var(--destructive);  --tone-ring: var(--tone-destructive-ring); }
  :host([tone='accent'])      { --tone-fg: var(--accent);       --tone-ring: var(--tone-accent-ring); }
  :host([size='xs']) { --sz: 10px; --bw: 1.5px; }
  :host([size='sm']) { --sz: 12px; --bw: 1.5px; }
  :host([size='md']) { --sz: 16px; --bw: 2px; }
  :host([size='lg']) { --sz: 24px; --bw: 2.5px; }

  /* `centered` — block-level wrapper with vertical breathing room.
   * The 8-place inline pattern `style="margin: var(--space-8) auto;
   * display: block"` is now a one-attribute opt-in. */
  :host([centered]) {
    display: block;
    margin: var(--space-8) auto;
  }

  .ring {
    display: inline-block;
    width: var(--sz);
    height: var(--sz);
    border: var(--bw) solid var(--tone-ring);
    border-right-color: var(--tone-fg);
    border-radius: 50%;
    animation: sui-spinner-spin 0.7s linear infinite;
  }
  /* LANG-GAP(@keyframes): irreducible per the brief — sx has no
   * animation/keyframes construct and the keyframe must remain. */
  @keyframes sui-spinner-spin { to { transform: rotate(360deg); } }
  /* LANG-GAP(reduced-motion media query): no media-query / at-rule
   * surface in the SFC today; the reduced-motion fallback must stay
   * in the residual block. */
  @media (prefers-reduced-motion: reduce) { .ring { animation-duration: 1.5s; } }
</style>

<span
  class="ring"
  part="ring"
  role={label() ? 'status' : null}
  aria-label={label() || null}
  aria-hidden={label() ? null : 'true'}
></span>
