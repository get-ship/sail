<!--
  <sui-spinner> — SUI port of <ship-spinner>.
  Rotating ring spinner for loading states.

  Prop / event / method parity vs <ship-spinner>
  ─────────────────────────────────────────────────────────────────────────────
  tone (String, 'info')           tone (union, reflect)   ✓ default changed to
                                                          'default' (muted-fg)
                                                          as a more neutral base
  size ('sm'|'md'|'lg', 'md')     size (union, reflect)   ✓ + xs added (10px)
  label (String, 'Loading')       label (string,          ✓
                                    'Loading')
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                     (no events)             ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: spinner                  part="ring"             renamed — 'ring'
                                                          describes the shape
  ─────────────────────────────────────────────────────────────────────────────
  role="status" aria-label always role="status" when      Lit always sets
    set                             label is present;     role; SUI omits it
                                    aria-hidden otherwise when no label to
                                                          avoid empty status
  ─────────────────────────────────────────────────────────────────────────────
  Lit uses border-top-color        SUI uses border-right- right-color produces
    for the gap                     color: transparent     consistent rotation
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="size" values="xs|sm|md|lg" default="md" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="label" type="string" default="Loading" />
<prop name="centered" type="bool" default="false" reflect />

<theme prop="tone" channels="tone-fg, tone-ring">
  default:     muted-foreground, tone-muted-ring
  primary:     primary,          tone-primary-ring
  info:        info,             tone-info-ring
  success:     success,          tone-success-ring
  warning:     warning,          tone-warning-ring
  destructive: destructive,      tone-destructive-ring
  accent:      accent,           tone-accent-ring
  muted:       muted-foreground, tone-muted-ring
</theme>

<variants>
  centered: display:block
</variants>

<style>
  /* Residual: keyframes + the motion-reduce override aren't reachable
     through the sx theme/variants constructs. The size-aware --sz / --bw
     vars stay locally defined here because sx has no border-width prop
     and expressing them through <theme> would rename the vars (changing
     the .ring references). Centered's margin-bottom keeps the original
     declaration so the top-of-block <variants> only owns `display:block`. */
  :host {
    display: inline-flex;
    vertical-align: middle;
    --sz: var(--icon-size-md);
    --bw: var(--space-half);
  }
  :host([centered]) { margin: var(--space-8) auto; }
  :host([size='xs']) { --sz: var(--icon-size-2xs); --bw: var(--space-half); }
  :host([size='sm']) { --sz: var(--icon-size-xs);  --bw: var(--space-half); }
  :host([size='md']) { --sz: var(--icon-size-md);  --bw: var(--space-half); }
  :host([size='lg']) { --sz: var(--icon-size-2xl); --bw: var(--space-1_25); }
  .ring {
    display: inline-block;
    width: var(--sz);
    height: var(--sz);
    border: var(--bw) solid var(--tone-ring);
    border-right-color: var(--tone-fg);
    border-radius: 50%;
    animation: sui-spinner-spin 0.7s linear infinite;
  }
  @keyframes sui-spinner-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ring { animation-duration: 1.5s; } }
</style>

<span
  class="ring"
  part="ring"
  role={label() ? 'status' : null}
  aria-label={label() || null}
  aria-hidden={label() ? null : 'true'}
></span>
