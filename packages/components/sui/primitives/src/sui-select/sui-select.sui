<prop name="value" type="string" default="" form-value />
<prop name="name" type="string" default="" />
<prop name="required" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="tone" values="default|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />
<prop name="described-by" type="string" default="" />

<theme prop="tone" channels="tone, tone-fg, tone-border, tone-border-strong, tone-bg-hover, tone-ring">
  default:     foreground, foreground, border,          border-strong,    hover-bg, ring
  info:        info,        info,        tone-info-border,        tone-info-border,        tone-info-bg,        tone-info-ring
  success:     success,     success,     tone-success-border,     tone-success-border,     tone-success-bg,     tone-success-ring
  warning:     warning,     warning,     tone-warning-border,     tone-warning-border,     tone-warning-bg,     tone-warning-ring
  destructive: destructive, destructive, tone-destructive-border, tone-destructive-border, tone-destructive-bg, tone-destructive-ring
  accent:      accent,      accent,      tone-accent-border,      tone-accent-border,      tone-accent-bg,      tone-accent-ring
  muted:       muted-foreground, muted-foreground, tone-muted-border, tone-muted-border, tone-muted-bg, tone-muted-ring
</theme>

<theme prop="size" channels="sel-h, sel-px, sel-fs, sel-gap, sel-chev, sel-pad-end-extra">
  sm: control-h-sm,  density-row-px, text-xs,  space-2, icon-size-xs, space-1_5
  md: control-h-md,  space-3,        density-text, space-2, icon-size-sm, space-1_5
  lg: control-h-lg,  space-4,        text-sm,  space-2, icon-size-md, space-1_5
</theme>

<variants part="field">
  invalid:  border:destructive
  disabled: bg:muted border:subtle shadow:none cursor:not-allowed
</variants>

<style>
    /* Local markers so the css-token lint recognizes the theme channels
     * referenced from this residual block. */
    --tone: ; --tone-fg: ; --tone-bg-hover: ; --tone-border: ; --tone-border-strong: ; --tone-ring: ; --sel-h: ; --sel-px: ; --sel-fs: ; --sel-gap: ; --sel-chev: ; --sel-pad-end-extra: ; --font-body: ;
  /* Residual: `:host` (the host element doesn't take sx, and
   * `[hidden]` isn't a prop), multi-property transitions, the
   * absolute-positioned native <select> overlay (computed padding for
   * the chevron gutter), the value/chevron element positioning, the
   * stacked focus-ring box-shadow (multi-shadow, no sx vocabulary),
   * the `filter: saturate()` on disabled, the `select option` cloned-
   * child override, the `@media (forced-colors)` system-color
   * outline, the prefers-reduced-motion opt-out, and the
   * placeholder-color cue. */
  :host { display: inline-flex; vertical-align: middle; }
  :host([hidden]) { display: none; }
  :host([disabled]) { color: var(--muted-foreground); filter: saturate(0.6); }

  .field { gap: var(--sel-gap); user-select: none; -webkit-user-select: none; font-family: var(--font-body);
    /* De-translated from sx (min-h:sel-h text:sel-fs) — ad-hoc channels are
       not sx vocabulary. */
    min-height: var(--sel-h);
    font-size: var(--sel-fs);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled])) .field:hover {
    background: var(--hover-bg);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  :host([tone]:not([tone='default'])) .field {
    border-color: var(--tone-border);
  }
  :host([tone]:not([tone='default']):not([disabled])) .field:hover {
    background: var(--tone-bg-hover);
    border-color: var(--tone-border-strong);
  }

  /* The native <select> overlay — position absolute, font/color
   * inherited, appearance:none, the chevron gutter. */
  select {
    position: absolute; inset: 0; width: 100%; height: 100%; margin: 0;
    padding-inline: var(--sel-px);
    padding-inline-end: calc(var(--sel-px) + var(--sel-chev) + var(--sel-pad-end-extra));
    font: inherit; color: transparent; background: transparent;
    border: 0; outline: 0; appearance: none; -webkit-appearance: none;
    cursor: inherit; border-radius: var(--radius-md);
  }
  select option { color: var(--foreground); background: var(--background); }
  select:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  :host([invalid]) select:focus-visible { --ring-color: var(--destructive); }
  :host([disabled]) select { cursor: not-allowed; }

  .value {
    display: inline-block; max-width: 100%; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; pointer-events: none;
  }
  :host([data-placeholder]) .value { color: var(--muted-foreground); }

  .chevron {
    position: absolute; inset-block: 0; inset-inline-end: var(--sel-px);
    margin-block: auto;
    width: var(--sel-chev); height: var(--sel-chev);
    color: var(--muted-foreground); pointer-events: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  :host(:not([disabled])) .field:hover .chevron { color: var(--foreground); }
  :host([tone]:not([tone='default'])) .chevron { color: var(--tone-fg); }

  /* Stacked focus ring — two box-shadows of different widths/colors
   * (a Tailwind-style offset ring). The no-tone case uses the local
   * --ring-color override set by select:focus-visible. */
  :host(:focus-within) .field {
    outline: none;
    border-color: var(--tone-border-strong);
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width)) var(--tone-ring);
  }
  :host(:not([tone]):focus-within) .field,
  :host([tone='default']:focus-within) .field {
    border-color: var(--ring-color);
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      var(--shadow-accent);
  }
  :host([invalid]:focus-within) .field {
    border-color: var(--destructive);
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      var(--shadow-accent);
  }

  :host([disabled]) .field { filter: saturate(0.6); }

  @media (forced-colors: active) {
    :host(:focus-within) .field { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .field, .chevron { transition: none; }
  }
</style>

  <row class="field" part="field" gap="2" align="center"
    sx="
      position:relative
      weight:medium
      leading:tight
      tracking:tight
      bg:background
      fg:foreground
      border:border
      radius:md
      shadow:xs
      cursor:pointer
      group
    "
  >
  <span class="value" aria-hidden="true" bind:this={valueLabel}></span>
  <svg class="chevron" part="chevron" viewBox="0 0 16 16"
    aria-hidden="true" focusable="false" fill="none"
    stroke="currentColor" stroke-width="1.75"
    stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
  <select part="select"
    name={name()}
    disabled={disabled()}
    required={required()}
    aria-invalid={invalid() ? 'true' : 'false'}
    aria-label={label()}
    aria-describedby={describedBy()}
    bind:this={selectEl}
  ></select>
  </row>
<span hidden><slot bind:this={optionsSlot}></slot></span>
