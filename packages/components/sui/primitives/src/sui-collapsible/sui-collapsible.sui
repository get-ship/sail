<!--
  <sui-collapsible> — SUI port of <ship-collapsible>.
  Click-to-toggle disclosure with smooth height animation.

  Prop parity vs <ship-collapsible>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, reflect)     ✓
  disabled (bool, false)       disabled (bool, reflect) ✓
  ─────────────────────────────────────────────────────────────────────────────
  ship-toggle → {open: bool}   sui-toggle → {open:bool} event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: trigger               trigger                  ✓
         (default) content     (default) content        ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: content               part="content"           ✓ the content-wrap div
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: aria-expanded +        controller sets same     ✓
    aria-controls on trigger
    elements; tabindex=0 for
    non-focusable triggers
  keyboard: Enter/Space        Enter/Space on           ✓
    on trigger-wrap              trigger-wrap
  ─────────────────────────────────────────────────────────────────────────────
  animation: grid-template-    same CSS grid trick      ✓
    rows 0fr→1fr; respects
    prefers-reduced-motion
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .content-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-medium) var(--ease-out);
  }
  :host([open]) .content-wrap {
    grid-template-rows: 1fr;
  }

  .content-inner {
    overflow: hidden;
  }

  ::slotted([slot='trigger']) {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition: background var(--duration-fast) var(--ease-out);
  }
  /* Hover wash on the disclosure header. */
  ::slotted([slot='trigger']:hover) {
    background: var(--hover-bg);
  }
  /* Canonical focus convention — replaces the design's box-shadow ring. */
  ::slotted([slot='trigger']:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  :host([disabled]) ::slotted([slot='trigger']) {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .content-wrap { transition: none; }
  }
</style>

<div class="trigger-wrap" bind:this={triggerWrap}>
  <slot name="trigger" bind:this={triggerSlot}></slot>
</div>
<div class="content-wrap" part="content" bind:this={contentWrap}>
  <div class="content-inner">
    <slot></slot>
  </div>
</div>
