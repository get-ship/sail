<!--
  <sui-error-boundary> — render-fault isolation.

  Wraps a subtree. If any rendering, controller `mount()`, or reactive
  effect inside throws, the subtree is unmounted and the boundary
  displays its fallback. React-style propagation: the innermost
  boundary catches a thrown error and outer boundaries see nothing.

  Fallback resolution (first match wins):
    1. `<template slot="fallback">…</template>` child — projected via
       the named slot. Authors can read the message via the host's
       `data-error-message` attribute or by listening for
       `sui-error-boundary:caught`.
    2. `fallback-text` attribute — rendered inside a default container
       with a "Retry" button.
    3. Built-in "Something went wrong" + retry button.

  Programmatic recovery: `host.reset()` re-renders the protected
  subtree. The default fallback's retry button calls the same path.

  Event: `sui-error-boundary:caught` fires on the host when an error
  is caught; detail carries `{ error, source }` where `source` is
  `'effect' | 'mount' | 'render' | 'unknown'`.
-->

<prop name="fallback-text" type="string" default="" />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }

  .fallback {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--tone-destructive-border);
    border-radius: var(--radius-md);
    background: var(--tone-destructive-bg);
    color: var(--foreground);
    font-size: var(--text-sm);
    box-shadow: var(--shadow-xs);
  }

  .fallback-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--destructive);
    margin-top: var(--space-1);
  }

  .fallback-body { min-width: 0; }

  .message {
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .retry {
    align-self: flex-start;
    appearance: none;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--foreground);
    cursor: pointer;
    box-shadow: var(--shadow-xs);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .retry:hover {
    background: var(--muted);
  }
</style>

{#if caughtError() === null}
  <slot></slot>
{:else}
  {#if hasFallbackSlot()}
    <slot name="fallback"></slot>
  {:else}
    <div class="fallback" part="fallback" role="alert">
      <svg class="fallback-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
        <path d="M12 9v4"></path>
        <path d="M12 17h.01"></path>
      </svg>
      <sui-stack class="fallback-body" gap="1">
        <div class="message" part="message">{fallbackText() || 'Something went wrong'}</div>
        <button class="retry" part="retry" type="button" on:click={reset}>Retry</button>
      </sui-stack>
    </div>
  {/if}
{/if}
