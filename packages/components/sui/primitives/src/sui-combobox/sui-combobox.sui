<!--
  <sui-combobox> — single-select with type-to-filter.
  Options come from light-DOM <option value="x">Label</option> children
  (parsed in the controller) OR an `options="…JSON…"` attribute holding
  `[{ value, label }]`. The compiler only knows bool/number/string for
  `<prop>` types, so JSON is parsed in the controller.

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Click / focus / typing opens the dropdown.
  - ↑ / ↓ move the highlight. Enter commits. Escape closes (selection
    untouched).
  - Click on a listbox row commits + closes.
  - The filter is a case-insensitive substring match on the label.
  - The displayed input text is the matching label when closed, the
    raw filter text when typing.
  - On commit, `value` is set to the option's `value` field, the input
    shows the matching label, dropdown closes, focus stays on input.
  ─────────────────────────────────────────────────────────────────────
  ARIA: host = role=combobox, aria-expanded, aria-controls,
        aria-haspopup=listbox, aria-activedescendant pointing at the
        highlighted listbox row.
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="options" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="tone" channels="tone-border, tone-ring">
  default:     border,    primary
  primary:     primary,   primary
  info:        info,      info
  success:     success,   success
  warning:     warning,   warning
  destructive: destructive, destructive
  accent:      accent,    accent
  muted:       muted-foreground, muted-foreground
</theme>

<variants part="wrap">
  size=sm: min-h:control-h-sm text:xs px:2
  size=md: min-h:control-h-md text:base px:density-row-px
  size=lg: min-h:control-h-lg text:sm px:3

  disabled:    bg:muted border:border cursor:not-allowed
</variants>

<variants part="chevron">
  [data-open]: shadow:none
</variants>

<variants part="opt">
  [data-hl]: bg:selected-bg
</variants>

<variants part="input">
  disabled: cursor:not-allowed
</variants>

<!--
  Residual <style> — truly unavoidable bits:
  - :host position + display + flex-direction + width + vertical-align
  - :host tone/size CSS vars (consumed by .wrap via calc)
  - .wrap :hover elevation (host(:not([disabled])) .wrap:hover:not(:focus-within):not([data-open]))
  - .wrap :focus-within + [data-open] box-shadow ring (raw, calc off a --tone-ring var)
  - :host([disabled]) .wrap filter: saturate(0.6)
  - :host([disabled]) input.entry color: muted-foreground
  - input.entry font: inherit + font-family + outline: 0
  - input.entry::placeholder color
  - input.entry:disabled cursor
  - .chevron transform: rotate(180deg) on [data-open] (raw transform)
  - .listbox position: absolute + top calc + max-height + overflow-y + z-index
  - .opt font-family + user-select
  - .opt[aria-selected='true'] font-weight
  - .empty text-align: center
-->
<style>
  :host {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    width: 100%;
    vertical-align: middle;
  }
  .wrap {
    box-shadow: 0 0 0 3px var(--tone-ring);
  }
  :host(:not([disabled])) .wrap:hover:not(:focus-within):not([data-open]) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  :host([data-open]) .wrap { border-color: var(--tone-ring); }
  :host([disabled]) .wrap {
    filter: saturate(0.6);
  }
  :host([disabled]) input.entry { color: var(--muted-foreground); }
  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }
  .chevron {
    flex: 0 0 auto;
    pointer-events: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  :host([data-open]) .chevron { transform: rotate(180deg); }
  .listbox {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    max-height: var(--panel-max-h-sm);
    overflow-y: auto;
    margin: 0;
    list-style: none;
    z-index: var(--z-popover);
  }
  .opt {
    font-family: var(--font-body);
    user-select: none;
  }
  .opt[aria-selected='true'] { font-weight: var(--font-weight-semibold); }
  .empty {
    text-align: center;
  }
</style>

<row class="wrap" part="wrap" align="center" gap="2"
  sx="w:full bg:background border:tone-border radius:md shadow:xs">
  <input
    class="entry" part="input" type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    role="combobox"
    aria-expanded={open() ? 'true' : 'false'}
    aria-controls={listId()}
    aria-autocomplete="list"
    aria-activedescendant={activeId()}
    bind:value={filterText}
    bind:this={inputEl}
  />
  <svg class="chevron" part="chevron" viewBox="0 0 16 16" aria-hidden="true"
       fill="none" stroke="currentColor" stroke-width="1.75"
       stroke-linecap="round" stroke-linejoin="round"
       sx="w:icon-size-sm h:icon-size-sm fg:muted-foreground">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
</row>
{#if open() && !disabled()}
  <column class="listbox" part="listbox" role="listbox" id={listId()} gap="0"
    bind:this={listEl}
    sx="p:1 bg:popover fg:popover-foreground border:border radius:md shadow:md">
    {#for o of visibleOptions() key={o.id}}
      <row
        class="opt" part="opt"
        class:hl={o.idx === highlight()}
        attr:data-hl={o.idx === highlight()}
        role="option"
        id={o.id}
        data-value={o.value}
        aria-selected={o.value === value() ? 'true' : 'false'}
        align="center" gap="2"
        sx="p:2 radius:sm fg:foreground cursor:pointer"
      >{o.label}</row>

    {/for}
    {#if visibleOptions().length === 0}
      <li class="empty" part="empty" role="presentation"
        sx="p:2 fg:muted-foreground">No matches</li>
    {/if}
  </column>
{/if}
<span hidden><slot bind:this={optionsSlot}></slot></span>
