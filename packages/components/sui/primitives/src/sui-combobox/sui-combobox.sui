<!--
  <sui-combobox> — single-select with type-to-filter.
  Options come from light-DOM <option value="x">Label</option> children
  (parsed in the controller) OR an `options="…JSON…"` attribute holding
  `[{ value, label }]`. The compiler only knows bool/number/string for
  `<prop>` types, so JSON is parsed in the controller.

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Click / focus / typing opens the dropdown.
  - ↑ / ↓ move the highlight. Enter commits. Escape closes (selection
    untouched).
  - Click on a listbox row commits + closes.
  - The filter is a case-insensitive substring match on the label.
  - The displayed input text is the matching label when closed, the
    raw filter text when typing.
  - On commit, `value` is set to the option's `value` field, the input
    shows the matching label, dropdown closes, focus stays on input.
  ─────────────────────────────────────────────────────────────────────
  ARIA: host = role=combobox, aria-expanded, aria-controls,
        aria-haspopup=listbox, aria-activedescendant pointing at the
        highlighted listbox row.
  ─────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - tone/size are GLOBAL framework channels now (contracts.css). feat/next
    hand-rolled `.sui-combobox[tone='x'] { --tone-border: …; --tone-ring: … }`
    and `.sui-combobox[size='x'] { --h: …; --fs: …; --px: … }` directly in its
    own residual style block (no theme directive even there — an older
    pattern still).
    Both are DELETED; this skin reads var(--tone-border)/var(--tone-ring)
    and var(--size-h)/var(--size-px)/var(--size-fs) straight off the
    framework sheets. combobox's 8 tone values are exactly the framework's
    8 tones, so there's no per-component gap to fill.
  - The focus-within / open ring keeps feat/next's single box-shadow-glow
    shape (not the framework's two-layer `ring:` sx composition — that
    reads as a different, offset-gap shape). The raw `3px` becomes
    `var(--ring-width)`, the framework's own token for this thickness.
  - Disabled: feat/next's `filter: saturate(0.6)` has no sx/token
    equivalent (filter isn't sx vocabulary, and no token expresses a
    saturation amount) — collapsed to the sx `opacity:50` the framework's
    own control-contracts already use for disabled controls
    (`:disabled { opacity: 0.5 }`), same "dimmed, inert" signal through
    the closed vocabulary instead of a hand-tuned filter.
  - The input, once nested in a shadow root, now inherits the framework's
    global field skin (border/padding/shadow/min-height — shadow roots
    adopt the control skins alongside tone/size). Since the field "box"
    look here lives on .wrap (not the bare input), the input's inherited
    skin is cancelled via sx (border:none / shadow:none / p:0) so it
    doesn't draw a second box inside the wrap. `outline: 0` (kept, feat/
    next's own choice) similarly cancels the input's own focus-visible
    ring in favour of the wrap's.

  LANG-GAP — chevron rotation, compound hover state, and plain `flex`
  ─────────────────────────────────────────────────────────────────────
  `transform: rotate(180deg)` on the open chevron has no sx property at
  all (no transform/rotate in the vocabulary) — kept in the residual style
  block, same as feat/next; not a token-drift issue (no rotation-token
  concept exists to have missed). Likewise the hover affordance
  `:not([disabled]) .wrap:hover:not(:focus-within):not([data-open])` is a
  compound, multi-condition selector neither sx state-prefixes nor a
  variants block can express (its grammar covers single attributes or a
  static AND-group, not :hover combined with two :not() exclusions) —
  kept in the residual style, token-only (--border-strong, --shadow-sm).

  A third, more systemic gap: sx's `display` enum offers `inline-flex`
  but no plain `flex` — so a BLOCK-level flex row (needed here for the
  full-width, full-height-hit-area option rows; inline-flex would shrink
  each option row to its content width) can't be reached through sx at
  all and stays hand-authored in the residual style. This isn't specific
  to combobox — any full-width flex row (list rows, panel rows) hits the
  same wall.
-->

<component>{
  props: {
    name: '',
    value: '',
    placeholder: '',
    options: '',
    disabled: false,
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
    size: 'md' | 'sm' | 'lg',
  },
}</component>
<host sx="position:relative display:inline-flex w:full"></host>

<variants class="wrap">
  [disabled]: bg:muted border:border shadow:none cursor:not-allowed opacity:50
</variants>

<style>
  .sui-combobox {
    flex-direction: column;
    vertical-align: middle;
  }
  .wrap,
  .opt,
  .empty {
    font-family: var(--font-body);
  }
  .wrap {
    align-items: center;
    gap: var(--space-2);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .sui-combobox:not([disabled]) .wrap:hover:not(:focus-within):not([data-open]) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  .wrap:focus-within,
  .sui-combobox[data-open] .wrap {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 var(--ring-width) var(--tone-ring);
  }
  .entry {
    flex: 1;
    min-width: 0;
    outline: 0;
  }
  .chevron {
    flex: 0 0 auto;
    pointer-events: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .sui-combobox[data-open] .chevron { transform: rotate(180deg); }
  .listbox {
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    list-style: none;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    user-select: none;
  }
  .opt[aria-selected='true'] { font-weight: var(--font-weight-semibold); }
  .opt.hl { background: var(--selected-bg); }
  .empty { text-align: center; }
</style>


<controller>
import { controller, derived, effect, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-combobox.sui'

interface OptionRecord { value: string; label: string }
interface VisibleOption extends OptionRecord { id: string; idx: number }

let listIdSeq = 0

const parseJsonOptions = (raw: string): OptionRecord[] => {
  if (!raw) return []
  try {
    const parsed = JSON.parse(raw) as unknown
    if (!Array.isArray(parsed)) return []
    return parsed
      .map((entry) => {
        if (entry && typeof entry === 'object') {
          const o = entry as { value?: unknown; label?: unknown }
          const value = o.value != null ? String(o.value) : ''
          const label = o.label != null ? String(o.label) : value
          return value ? { value, label } : null
        }
        if (typeof entry === 'string') return { value: entry, label: entry }
        return null
      })
      .filter((o): o is OptionRecord => o !== null)
  } catch {
    return []
  }
}

const readLightOptions = (host: HTMLElement): OptionRecord[] => {
  const els = Array.from(host.querySelectorAll(':scope > option')) as HTMLOptionElement[]
  return els.map((el) => ({
    value: el.value || el.textContent?.trim() || '',
    label: el.textContent?.trim() || el.value || '',
  })).filter((o) => o.value !== '')
}

export default controller({
  scope: ({ options }: ViewScope<Scope>) => {
    const open = signal(false)
    const filterText = signal('')
    const highlight = signal(0)
    const slotOptions = signal<OptionRecord[]>([])
    const inputEl = ref<HTMLInputElement>(null)
    const listEl = ref<HTMLUListElement>(null)
    const optionsSlot = ref<HTMLSlotElement>(null)
    const listId = signal(`sui-combobox-list-${++listIdSeq}`)

    const parsedOptions = derived<OptionRecord[]>(() => {
      const fromAttr = parseJsonOptions(options())
      if (fromAttr.length > 0) return fromAttr
      return slotOptions()
    })
    const visibleOptions = derived<VisibleOption[]>(() => {
      const q = filterText().trim().toLowerCase()
      const all = parsedOptions()
      const matched = q
        ? all.filter((o) => o.label.toLowerCase().includes(q))
        : all
      return matched.map((o, idx) => ({ ...o, idx, id: `sui-combobox-opt-${idx}` }))
    })
    const activeId = derived<string>(() => {
      if (!open()) return ''
      const list = visibleOptions()
      const h = highlight()
      return list[h]?.id ?? ''
    })

    return {
      open, filterText, highlight, slotOptions,
      inputEl, listEl, optionsSlot, listId,
      parsedOptions, visibleOptions, activeId,
    }
  },

  mount(state, host) {
    let lastEmitted: string | null = null

    const refreshSlotOptions = () => {
      state.slotOptions = readLightOptions(host)
    }
    refreshSlotOptions()
    const slot = state.optionsSlot as HTMLSlotElement | null
    slot?.addEventListener('slotchange', refreshSlotOptions)

    const labelFor = (value: string): string => {
      const opts = state.parsedOptions as OptionRecord[]
      return opts.find((o) => o.value === value)?.label ?? value
    }

    // value → input text. When closed, the input mirrors the selected
    // option's label. While typing, the user's filter takes over (see
    // onInput below).
    const stopValueSync = effect(() => {
      const v = state.value
      if (!state.open) state.filterText = labelFor(v as string)
    })

    // Initial sync of input element after first paint.
    state.filterText = labelFor(state.value as string)

    // Reflect open state to a host attribute so the chevron CSS can flip.
    const stopOpenAttr = effect(() => {
      if (state.open) host.setAttribute('data-open', '')
      else host.removeAttribute('data-open')
    })

    const inputEl = state.inputEl as HTMLInputElement | null
    if (!inputEl) return

    const openList = () => {
      if (state.disabled) return
      if (!state.open) {
        state.open = true
        state.highlight = 0
        // On open, clear filter so the user sees the full list.
        state.filterText = ''
      }
    }

    const closeList = (commitLabelFromValue = true) => {
      if (!state.open) return
      state.open = false
      if (commitLabelFromValue) state.filterText = labelFor(state.value as string)
    }

    const commit = (rec: OptionRecord | undefined) => {
      if (!rec) return
      state.value = rec.value
      state.open = false
      state.filterText = rec.label
      if (lastEmitted !== rec.value) {
        lastEmitted = rec.value
        host.dispatchEvent(
          new CustomEvent('sui-change', {
            detail: { value: rec.value, label: rec.label },
            bubbles: true,
            composed: true,
          }),
        )
      }
    }

    const onFocus = () => openList()
    const onClick = () => openList()
    const onInput = () => {
      if (!state.open) state.open = true
      state.highlight = 0
    }
    const onKeydown = (e: KeyboardEvent) => {
      const list = state.visibleOptions as VisibleOption[]
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        if (!state.open) { openList(); return }
        if (list.length === 0) return
        state.highlight = (state.highlight + 1) % list.length
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        if (!state.open) { openList(); return }
        if (list.length === 0) return
        const h = state.highlight
        state.highlight = h <= 0 ? list.length - 1 : h - 1
      } else if (e.key === 'Enter') {
        if (!state.open) return
        e.preventDefault()
        const sel = list[state.highlight]
        if (sel) commit(sel)
      } else if (e.key === 'Escape') {
        if (!state.open) return
        e.preventDefault()
        closeList(true)
      } else if (e.key === 'Tab') {
        closeList(true)
      }
    }
    const onBlur = (e: FocusEvent) => {
      // Don't close when the new focus target is inside our shadow tree
      // (e.g. clicking a listbox row before mousedown→click completes).
      const next = e.relatedTarget as Node | null
      if (next && host.shadowRoot?.contains(next)) return
      setTimeout(() => closeList(true), 0)
    }

    inputEl.addEventListener('focus', onFocus)
    inputEl.addEventListener('click', onClick)
    inputEl.addEventListener('input', onInput)
    inputEl.addEventListener('keydown', onKeydown)
    inputEl.addEventListener('blur', onBlur)

    // Mousedown on a listbox row commits before blur fires.
    const onShadowMousedown = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null
      const li = target?.closest?.('li.opt[data-value]') as HTMLElement | null
      if (!li) return
      e.preventDefault()
      const value = li.dataset.value ?? ''
      const list = state.visibleOptions as VisibleOption[]
      commit(list.find((o) => o.value === value))
    }
    host.shadowRoot?.addEventListener('mousedown', onShadowMousedown as EventListener)

    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      open: openList,
      close: () => closeList(true),
    })

    return () => {
      stopValueSync()
      stopOpenAttr()
      slot?.removeEventListener('slotchange', refreshSlotOptions)
      inputEl.removeEventListener('focus', onFocus)
      inputEl.removeEventListener('click', onClick)
      inputEl.removeEventListener('input', onInput)
      inputEl.removeEventListener('keydown', onKeydown)
      inputEl.removeEventListener('blur', onBlur)
      host.shadowRoot?.removeEventListener('mousedown', onShadowMousedown as EventListener)
    }
  },
})

</controller>
<div class="wrap" sx="display:inline-flex w:full min-h:size-h px:size-px bg:background border:tone-border radius:md shadow:xs">
  <input class="entry input" type="text" name={name()} placeholder={placeholder()} disabled={disabled()} autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-expanded={open() ? 'true' : 'false'} aria-controls={listId()} aria-autocomplete="list" aria-activedescendant={activeId()} bind:value={filterText} bind:this={inputEl} sx="text:size-fs fg:foreground border:none shadow:none p:0" />
  <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" sx="w:icon-size-sm h:icon-size-sm fg:muted-foreground">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
</div>
{#if open() && !disabled()}
  <ul class="listbox" role="listbox" id={listId()} bind:this={listEl} sx="position:absolute m:0 p:1 max-h:panel-max-h-sm overflow-y:auto bg:popover fg:popover-foreground border:border radius:md shadow:md z:popover">
    {#for o of visibleOptions() key={o.id}}
      <li
        class="opt"
        class:hl={o.idx === highlight()}
        role="option"
        id={o.id}
        data-value={o.value}
        aria-selected={o.value === value() ? 'true' : 'false'}
        sx="p:2 radius:sm text:size-fs fg:foreground"
      >{o.label}</li>
    {/for}
    {#if visibleOptions().length === 0}
      <li class="empty" role="presentation" sx="p:2 text:size-fs fg:muted-foreground">No matches</li>
    {/if}
  </ul>
{/if}
<span hidden><slot bind:this={optionsSlot}></slot></span>
