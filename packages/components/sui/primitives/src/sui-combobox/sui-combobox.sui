<!--
  <sui-combobox> — single-select with type-to-filter.
  Options come from light-DOM <option value="x">Label</option> children
  (parsed in the controller) OR an `options="…JSON…"` attribute holding
  `[{ value, label }]`. The compiler only knows bool/number/string for
  `<prop>` types, so JSON is parsed in the controller.

  Behaviour
  ─────────────────────────────────────────────────────────────────────
  - Click / focus / typing opens the dropdown.
  - ↑ / ↓ move the highlight. Enter commits. Escape closes (selection
    untouched).
  - Click on a listbox row commits + closes.
  - The filter is a case-insensitive substring match on the label.
  - The displayed input text is the matching label when closed, the
    raw filter text when typing.
  - On commit, `value` is set to the option's `value` field, the input
    shows the matching label, dropdown closes, focus stays on input.
  ─────────────────────────────────────────────────────────────────────
  ARIA: host = role=combobox, aria-expanded, aria-controls,
        aria-haspopup=listbox, aria-activedescendant pointing at the
        highlighted listbox row.
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="options" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    width: 100%;
    vertical-align: middle;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: var(--control-h-md);
    --fs: var(--density-text);
    --px: var(--density-row-px);
  }
  :host([tone='primary'])     { --tone-border: var(--primary);          --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);              --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);           --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);           --tone-ring: var(--warning); }
  :host([tone='destructive']) { --tone-border: var(--destructive);       --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);            --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground);  --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: var(--control-h-sm); --fs: var(--text-xs); --px: var(--space-2); }
  :host([size='md']) { --h: var(--control-h-md); --fs: var(--density-text); --px: var(--density-row-px); }
  :host([size='lg']) { --h: var(--control-h-lg); --fs: var(--text-sm); --px: var(--space-3); }

  .wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    background: var(--background);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  /* Hover affordance — design bundle elevation (forms after-pattern,
   * rest-shadow, hover). Matches sui-input / sui-select / sui-textarea. */
  :host(:not([disabled])) .wrap:hover:not(:focus-within):not([data-open]) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .wrap:focus-within,
  :host([data-open]) .wrap {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 3px var(--tone-ring);
  }

  /* Disabled — system pattern, not blunt opacity. Matches select / input. */
  :host([disabled]) .wrap {
    background: var(--muted);
    border-color: var(--border);
    box-shadow: none;
    cursor: not-allowed;
    filter: saturate(0.6);
  }
  :host([disabled]) input.entry { color: var(--muted-foreground); }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }

  .chevron {
    flex: 0 0 auto;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: var(--muted-foreground);
    pointer-events: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  :host([data-open]) .chevron { transform: rotate(180deg); }

  .listbox {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    right: 0;
    max-height: var(--panel-max-h-sm);
    overflow-y: auto;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: var(--z-popover);
  }
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
    cursor: pointer;
    user-select: none;
  }
  .opt[aria-selected='true'] { font-weight: var(--font-weight-semibold); }
  .opt.hl {
    background: var(--selected-bg);
  }
  .empty {
    padding: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--muted-foreground);
    text-align: center;
  }
</style>

<div class="wrap" part="wrap">
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    role="combobox"
    aria-expanded={open() ? 'true' : 'false'}
    aria-controls={listId()}
    aria-autocomplete="list"
    aria-activedescendant={activeId()}
    bind:value={filterText}
    bind:this={inputEl}
  />
  <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"
       fill="none" stroke="currentColor" stroke-width="1.75"
       stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
</div>
{#if open() && !disabled()}
  <ul class="listbox" part="listbox" role="listbox" id={listId()}
      bind:this={listEl}>
    {#for o of visibleOptions() key={o.id}}
      <li
        class="opt"
        class:hl={o.idx === highlight()}
        role="option"
        id={o.id}
        data-value={o.value}
        aria-selected={o.value === value() ? 'true' : 'false'}
      >{o.label}</li>
    {/for}
    {#if visibleOptions().length === 0}
      <li class="empty" role="presentation">No matches</li>
    {/if}
  </ul>
{/if}
<span hidden><slot bind:this={optionsSlot}></slot></span>
