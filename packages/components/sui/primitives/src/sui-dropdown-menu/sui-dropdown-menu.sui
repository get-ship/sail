<!--
  <sui-dropdown-menu> — SUI port of <ship-dropdown-menu>.
  Trigger-anchored menu using the native popover API for top-layer rendering,
  light-dismiss, and ESC. Adds ARIA role=menu/menuitem and roving tabindex.

  Prop / event / method parity vs <ship-dropdown-menu>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-select          sui-select { detail:{value}} ✓ renamed
  Slots: trigger, (default)    trigger, (default)           ✓
  Parts: (none)                panel                        ✓
  ARIA: role=menu on panel,    controller sets role,        ✓
    role=menuitem + tabindex     menuitem + roving tabindex
  Keyboard: ↑↓ Home/End        ✓                           ✓
    Enter/Space activate        ✓                           ✓
    Typeahead (first char)      ✓                           ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />

<variants>
  [hidden]: display:none
</variants>

<!-- Residual: .panel popover visuals (inset/margin/min-width/padding/
     background/color/border/border-radius/box-shadow) — popover panels
     have a specific visual recipe. Positioning is delegated to the shared
     use:anchor action (the family's one positioner); open-sync to the
     shared bindPopover via usePopover. The open-state transform/opacity
     transition stays here (multi-
     property motion — no construct); ::slotted(button) and ::slotted(
     [role=menuitem]) styling (descendant pseudo selectors — variants
     only match :host attrs); ::slotted(hr) / ::slotted([data-section])
     styling; forced-colors CanvasText panel border; the .panel::backdrop
     transparent background. -->
<style>
  :host { display: inline-flex; }
  [part~='panel'] {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: var(--panel-min-w-md);
    padding: var(--space-1);
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg), inset 0 1px 0 var(--tone-muted-bg);
    display: flex; flex-direction: column;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transition:
      opacity var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out);
  }
  [part~='panel']:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  [part~='panel']::backdrop { background: transparent; }
  ::slotted(button), ::slotted([role='menuitem']) {
    display: flex; align-items: center; gap: var(--space-2);
    text-align: start;
    background: transparent; border: 0;
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit; font: inherit;
    cursor: pointer; width: 100%;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  ::slotted(button:hover), ::slotted([role='menuitem']:hover),
  ::slotted(button:focus-visible), ::slotted([role='menuitem']:focus-visible) {
    background: var(--muted);
    outline: none;
  }
  ::slotted(button[data-tone='destructive']) { color: var(--destructive); }
  ::slotted(button[data-tone='destructive']:hover) { background: var(--tone-destructive-bg); }
  ::slotted(hr) { height: 1px; border: 0; background: var(--border-subtle); margin: var(--space-1) var(--space-1); }
  ::slotted([data-section]) { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--muted-foreground); padding: var(--space-2) var(--space-2) var(--space-1); }
  @media (prefers-reduced-motion: reduce) {
    [part~='panel'] { transition: none; transform: none !important; }
  }
  @media (forced-colors: active) {
    [part~='panel'] { border: 1px solid CanvasText; }
  }
</style>


<controller>
import { controller, effect, bindNativeEvent, usePopover } from '@ship/sui-runtime'
import type { Scope } from './sui-dropdown-menu.sui'

let _seq = 0

type PopoverEl = HTMLElement & {
  showPopover?: () => void
  hidePopover?: () => void
}

export default controller<Scope>({
  mount(state, host) {
    const seq = ++_seq
    const panelId = `sui-dropdown-menu-panel-${seq}`

    const triggerWrap = state.$signals.triggerWrap() as HTMLElement | null
    const triggerSlot = state.$signals.triggerSlot() as HTMLSlotElement | null
    const panelEl = state.$signals.panelEl() as PopoverEl | null

    if (!panelEl) return
    panelEl.id = panelId

    // ── Typeahead state ──────────────────────────────────────────────────
    let typeaheadBuf = ''
    let typeaheadTimer: ReturnType<typeof setTimeout> | null = null

    function pushTypeahead(key: string): number {
      if (typeaheadTimer) clearTimeout(typeaheadTimer)
      typeaheadBuf += key.toLowerCase()
      typeaheadTimer = setTimeout(() => { typeaheadBuf = '' }, 350)
      const items = getItems()
      const i = items.indexOf(document.activeElement as HTMLElement)
      for (let j = 0; j < items.length; j++) {
        const idx = (i + 1 + j) % items.length
        const label = (items[idx]!.textContent ?? '').trim().toLowerCase()
        if (label.startsWith(typeaheadBuf)) return idx
      }
      return -1
    }

    // ── Item management ──────────────────────────────────────────────────
    function getItems(): HTMLElement[] {
      return Array.from(
        host.querySelectorAll<HTMLElement>('[role="menuitem"], button[data-value], [data-value]'),
      ).filter(el => !el.hasAttribute('disabled'))
    }

    function focusItem(index: number) {
      const items = getItems()
      if (!items.length) return
      const i = ((index % items.length) + items.length) % items.length
      for (const it of items) it.setAttribute('tabindex', '-1')
      items[i]!.setAttribute('tabindex', '0')
      items[i]!.focus()
    }

    function currentIndex(): number {
      return getItems().indexOf(document.activeElement as HTMLElement)
    }

    function setupItems() {
      getItems().forEach((el, idx) => {
        if (!el.hasAttribute('role')) el.setAttribute('role', 'menuitem')
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', idx === 0 ? '0' : '-1')
      })
    }

    function setupTrigger() {
      const els = triggerSlot?.assignedElements({ flatten: true }) as HTMLElement[] ?? []
      for (const el of els) {
        // popovertarget marks the trigger for use:anchor's positioning lookup.
        // (It can't ACTIVATE across the shadow boundary — onTriggerClick owns
        // that — but anchor.ts resolves the trigger through it.)
        el.setAttribute('popovertarget', panelId)
        el.setAttribute('aria-haspopup', 'menu')
        el.setAttribute('aria-controls', panelId)
        el.setAttribute('aria-expanded', state.$signals.open() ? 'true' : 'false')
      }
    }

    // ── Open state: the ONE implementation ─────────────────────────────────
    // usePopover's handle IS bindPopover — attaching it wires native
    // showPopover/hidePopover <-> signal + light-dismiss sync. Placement is the
    // shared use:anchor action (template). The `open` prop bridges to the
    // handle; menu reactions (data-state, aria, focus) follow the open state.
    const pop = usePopover()
    const detach = pop(panelEl) as { destroy?: () => void }

    // JS activation — native popovertarget is inert across the shadow boundary.
    const onTriggerClick = () => {
      if (state.$signals.open()) host.removeAttribute('open')
      else host.setAttribute('open', '')
    }

    // open prop → handle
    const stopIn = effect(() => {
      if (state.$signals.open()) pop.open()
      else pop.close()
    })
    // handle → open prop + menu reactions (light-dismiss/ESC land here too).
    const stopReact = effect(() => {
      const o = pop.isOpen()
      const has = host.hasAttribute('open')
      if (o && !has) host.setAttribute('open', '')
      else if (!o && has) host.removeAttribute('open')
      host.setAttribute('data-state', o ? 'open' : 'closed')
      setupTrigger()
      if (o) queueMicrotask(() => { setupItems(); focusItem(0) })
    })

    const onItemClick = (e: Event) => {
      const target = (e.target as HTMLElement).closest('[data-value]') as HTMLElement | null
      if (!target) return
      host.emit!('sui-select', { value: target.dataset.value ?? '' })
      host.removeAttribute('open')
    }

    const onKeydown = (e: KeyboardEvent) => {
      if (!state.$signals.open()) return
      const items = getItems()
      if (!items.length) return
      const i = currentIndex()
      if (e.key === 'ArrowDown') { e.preventDefault(); focusItem(i + 1) }
      else if (e.key === 'ArrowUp') { e.preventDefault(); focusItem(i - 1) }
      else if (e.key === 'Home') { e.preventDefault(); focusItem(0) }
      else if (e.key === 'End') { e.preventDefault(); focusItem(items.length - 1) }
      else if (e.key === 'Escape') { e.preventDefault(); host.removeAttribute('open') }
      else if (e.key === 'Tab') { host.removeAttribute('open') }
      else if ((e.key === 'Enter' || e.key === ' ') && i >= 0) { e.preventDefault(); items[i]!.click() }
      else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
        const next = pushTypeahead(e.key)
        if (next >= 0) { e.preventDefault(); focusItem(next) }
      }
    }

    if (triggerWrap) bindNativeEvent(triggerWrap, 'click', onTriggerClick)
    bindNativeEvent(panelEl, 'click', onItemClick)
    bindNativeEvent(host, 'keydown', onKeydown as EventListener)
    if (triggerSlot) bindNativeEvent(triggerSlot, 'slotchange', setupTrigger)
    bindNativeEvent(panelEl, 'slotchange', setupItems)

    return () => {
      if (typeaheadTimer) clearTimeout(typeaheadTimer)
      stopIn()
      stopReact()
      detach.destroy?.()
    }
  },
})

</controller>
<span class="trigger-wrap" bind:this={triggerWrap}>
  <slot name="trigger" bind:this={triggerSlot}></slot>
</span>
<div class="panel" part="panel" popover="auto" role="menu" use:anchor bind:this={panelEl}>
  <slot bind:this={itemSlot}></slot>
</div>
