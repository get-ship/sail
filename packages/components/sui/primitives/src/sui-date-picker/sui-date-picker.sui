<!--
  <sui-date-picker> — input field + calendar popover.
  Value is ISO 8601 (`YYYY-MM-DD`). The input itself is the trigger:
  clicking it (or focusing) opens the popover. The calendar is a
  month grid; arrow keys move day focus, Enter selects, Escape closes.

  Compose-points:
  - The trigger surface mirrors the <sui-input> chrome (border, focus
    ring, height matrix) so the picker drops into the same form rows.
  - The popover panel is hand-rolled (no <sui-popover>): the trigger
    isn't a <button>, so the native popovertarget wiring sui-popover
    relies on wouldn't apply. The panel uses absolute positioning
    relative to the host.
  ─────────────────────────────────────────────────────────────────────
  Props
    name        Form field name.
    value       ISO date string (YYYY-MM-DD). Empty when unset.
    min         Earliest allowed date (ISO).
    max         Latest allowed date (ISO).
    placeholder Native input placeholder shown when value is empty.
    disabled    Disables interaction + form participation.
    tone        Tones focus ring + selection.
    size        sm | md | lg.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change  { detail: { value: string } }   // ISO date or '' when cleared
  ─────────────────────────────────────────────────────────────────────

  NEW SURFACE (re-port from the feat/next baseline, parity-gate pass)
  ─────────────────────────────────────────────────────────────────────
  - Deleted the per-component tone theme block (prop=tone, channels
    tone-border + tone-ring) — those two channel names are now GLOBAL
    framework channels (contracts.css), and this component's old block
    collided with them 1:1. `border:tone-border` /
    `focus-within:ring:tone-ring` below now resolve against the framework's
    tone contract directly, same as sui-alert/sui-card/sui-select.
    (NOTE for future editors: don't spell the deleted block out in real
    open/close theme-tag syntax in this comment — the compiler's theme
    lowering pass scans for the literal tag text without regard for HTML
    comment boundaries, and a stray opening mention here will pair with
    the real closing tag on the surviving size-theme block below and
    silently swallow every prop declaration in between. Prose only.)
  - Kept the local size theme block (prop=size, channels dp-h/dp-fs/dp-px)
    (channel NAMES don't collide with the global `size-*` contract, and the
    values genuinely differ from it — global `[size]` padding is
    space-2_5/3/4 at sm/md/lg, feat/next's picker used space-2/2_5/3; same
    established pattern as sui-input/-badge/-chip keeping their own size
    theme). Fixed two values while re-porting: the `md` row had drifted to
    the density channel (`density-text`/`density-row-px`, unrelated to this
    component — feat/next's md size is a fixed 13px/10px, not
    density-reactive) — restored to `text-base`/`space-2_5`. The `lg` row's
    font size had drifted to `text-sm` (12px) instead of feat/next's 14px —
    restored to `text-md`.
  - `.day.selected`'s background/color/font-weight had been dropped entirely
    in the prior "dissolve style" pass (only `box-shadow:none` survived).
    Restored using the SOLID `--tone`/`--tone-contrast` channel pair (not
    `--tone-ring`, which is now a translucent wash, not a solid fill) — the
    channel pairing the framework provides specifically for solid-fill +
    readable-text scenarios. Net effect: still a solid, tone-colored,
    legible selected-day pill, matching feat/next's intent; the untoned/
    default case shifts from feat/next's hardcoded "solid primary" to the
    framework's generic "solid foreground" (an intentional consequence of
    tone no longer being a per-component color choice).
  - `.day.empty { visibility: hidden; }` and
    `.day:hover:not(:disabled):not(.empty) { background: var(--hover-bg); }`
    were also dropped in the prior pass — restored (leading/trailing padding
    cells were rendering as visible ghost buttons, and no day had hover
    feedback).
  - `.dow`'s font-size had drifted to `text:xs` (11px); feat/next's raw
    `0.75rem` is 12px — restored to `text:sm`.
  - `.panel`'s width had drifted to `w:panel-max-w-md` (480px); feat/next's
    raw `260px` is far closer to `--panel-max-w-sm` (320px — still a
    deliberate token-driven widening, per tokens.css's own documented
    re-port convention, and gives the 7-column day grid comfortable room).
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="min" type="string" default="" />
<prop name="max" type="string" default="" />
<prop name="placeholder" type="string" default="YYYY-MM-DD" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<theme prop="size" channels="dp-h, dp-fs, dp-px">
  sm: control-h-sm, text-sm, space-2
  md: control-h-md, text-base, space-2_5
  lg: control-h-lg, text-md, space-3
</theme>

<variants part="wrap">
  disabled: bg:muted fg:muted-foreground cursor:not-allowed
</variants>

<!--
  Residual <style> — what sx/variants/theme can't express in this primitive:
  - :host base (the new <host sx="..."> directive is position/display-able,
    but vertical-align:middle isn't tokenized).
  - [part='wrap'] multi-property transition (border-color + box-shadow).
  - :host([disabled]) [part='wrap'] `filter: saturate(0.4)` (filter has no sx kw).
  - input.entry: flex:1 + min-width:0 (the <row>'s child needs flex shorthand,
    not in sx), border:0 / outline:0 / background:transparent / padding:0 (raw
    resets; sx has no `none`/`transparent`); font: inherit + font-family /
    font-size (font: shorthand and per-property inheritance).
  - input.entry::placeholder color cue.
  - input.entry:disabled cursor.
  - .cal-icon flex:0 0 auto + pointer-events:none.
  - .panel top: calc(100% + var(--space-1)) + left:0 (absolute math — sx has
    position: but no `top:` / `left:` vocab); font-family: var(--font-body);
    font-size: var(--dp-fs).
  - .nav margin-bottom: var(--space-1).
  - .nav button: appearance:none / border:0 / background:transparent /
    padding:0 / font:inherit / font-size (font: shorthand + per-property);
    line-height (raw); display:inline-flex + align-items:center +
    justify-content:center (raw flex centering for the glyph within).
  - .label flex:1 + text-align:center (raw flex + text-align not in sx).
  - .dow text-align:center (text-align not in sx).
  - .day button: appearance:none / border:0 / background:transparent /
    font:inherit (raw); color/cursor/text-align:center/padding/border-radius
    on the bare state; box-shadow:none on .selected; the inset outline
    (focused:not(.selected)); the inset 1px (today:not(.selected)) — not
    the sx ring: model.
-->
<style>
  --dp-h: ; --dp-fs: ; --dp-px: ;
  :host {
    position: relative;
    display: inline-flex;
    width: 100%;
    vertical-align: middle;
  }
  [part='wrap'] {
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  :host([disabled]) [part='wrap'] { filter: saturate(0.4); }
  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--dp-fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }

  .cal-icon { flex: 0 0 auto; pointer-events: none; }

  .panel {
    top: calc(100% + var(--space-1));
    left: 0;
    font-family: var(--font-body);
    font-size: var(--dp-fs);
  }
  .nav { margin-bottom: var(--space-1); }
  .nav button {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-size: var(--text-md);
    line-height: var(--leading-none);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .label { flex: 1; text-align: center; }
  .dow { text-align: center; }
  .day {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    cursor: pointer;
    padding: var(--space-2) 0;
    text-align: center;
    border-radius: var(--radius-sm);
  }
  .day:disabled { color: var(--muted-foreground); opacity: 0.4; cursor: not-allowed; }
  .day.empty { visibility: hidden; }
  .day:hover:not(:disabled):not(.empty) { background: var(--hover-bg); }
  .day.selected {
    background: var(--tone);
    color: var(--tone-contrast);
    font-weight: var(--font-weight-semibold);
    box-shadow: none;
  }
  .day.focused:not(.selected) {
    outline: var(--ring-width) solid var(--tone-ring);
    outline-offset: calc(-1 * var(--ring-width));
  }
  .day.today:not(.selected) {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .wrap {
    /* De-translated from sx (min-h:dp-h px:dp-px) — ad-hoc channels are not
       sx vocabulary. */
    min-height: var(--dp-h);
    padding-inline: var(--dp-px);
  }
</style>


<controller>
import { controller, derived, ref, signal } from '@ship/sui-runtime'
import type { ViewScope } from '@ship/sui-runtime'
import type { Scope } from './sui-date-picker.sui'

interface DayCell {
  key: string
  iso: string
  day: number
  empty: boolean
  selected: boolean
  focused: boolean
  today: boolean
  disabled: boolean
  label: string
}
interface DayHeader { key: string; label: string }

const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
const DOW_SHORT = ['S', 'M', 'T', 'W', 'T', 'F', 'S']
const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
]

const pad2 = (n: number) => (n < 10 ? `0${n}` : String(n))
const isoFor = (year: number, month: number, day: number): string =>
  `${year}-${pad2(month + 1)}-${pad2(day)}`

const parseIso = (s: string): { y: number; m: number; d: number } | null => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s)
  if (!m) return null
  const y = Number(m[1])
  const mo = Number(m[2]) - 1
  const d = Number(m[3])
  if (mo < 0 || mo > 11 || d < 1 || d > 31) return null
  return { y, m: mo, d }
}

const daysInMonth = (year: number, month: number): number =>
  new Date(year, month + 1, 0).getDate()

const todayIso = (): string => {
  const d = new Date()
  return isoFor(d.getFullYear(), d.getMonth(), d.getDate())
}

const addDays = (iso: string, delta: number): string => {
  const parts = parseIso(iso)
  if (!parts) return iso
  const d = new Date(parts.y, parts.m, parts.d + delta)
  return isoFor(d.getFullYear(), d.getMonth(), d.getDate())
}

const clampIso = (iso: string, min: string, max: string): string => {
  if (min && iso < min) return min
  if (max && iso > max) return max
  return iso
}

export default controller({
  scope: ({ value, min, max }: ViewScope<Scope>) => {
    const open = signal(false)
    const today = signal(todayIso())
    const focused = signal(todayIso())
    const viewYear = signal(new Date().getFullYear())
    const viewMonth = signal(new Date().getMonth())
    const inputEl = ref<HTMLInputElement>(null)
    const panelEl = ref<HTMLDivElement>(null)

    const monthLabel = derived<string>(() =>
      `${MONTHS[viewMonth()]} ${viewYear()}`,
    )
    const dayHeaders = derived<DayHeader[]>(() =>
      DOW.map((label, idx) => ({ key: String(idx), label: DOW_SHORT[idx] ?? label })),
    )
    const monthCells = derived<DayCell[]>(() => {
      const year = viewYear()
      const month = viewMonth()
      const sel = value()
      const foc = focused()
      const td = today()
      const mn = min()
      const mx = max()
      const firstDow = new Date(year, month, 1).getDay()
      const totalDays = daysInMonth(year, month)
      const cells: DayCell[] = []
      for (let i = 0; i < firstDow; i++) {
        cells.push({
          key: `e-${i}`, iso: '', day: 0,
          empty: true, selected: false, focused: false, today: false,
          disabled: false, label: '',
        })
      }
      for (let d = 1; d <= totalDays; d++) {
        const iso = isoFor(year, month, d)
        const dt = new Date(year, month, d)
        const dayName = DOW[dt.getDay()] ?? ''
        cells.push({
          key: iso,
          iso, day: d,
          empty: false,
          selected: sel === iso,
          focused: foc === iso,
          today: td === iso,
          disabled: Boolean((mn && iso < mn) || (mx && iso > mx)),
          label: `${dayName}, ${MONTHS[month]} ${d}, ${year}`,
        })
      }
      return cells
    })

    return { open, today, focused, viewYear, viewMonth, inputEl, panelEl, monthLabel, dayHeaders, monthCells }
  },

  mount(state, host) {
    const moveView = (delta: number) => {
      let y = state.viewYear
      let m = state.viewMonth + delta
      while (m < 0) { m += 12; y -= 1 }
      while (m > 11) { m -= 12; y += 1 }
      state.viewYear = y
      state.viewMonth = m
    }

    const syncViewToValue = () => {
      const seed = (state.value as string) || (state.focused as string) || todayIso()
      const parts = parseIso(seed)
      if (!parts) return
      state.viewYear = parts.y
      state.viewMonth = parts.m
      state.focused = seed
    }

    const commit = (iso: string) => {
      const parts = parseIso(iso)
      if (!parts) return
      if (state.min && iso < state.min) return
      if (state.max && iso > state.max) return
      state.value = iso
      state.focused = iso
      state.open = false
      host.dispatchEvent(
        new CustomEvent('sui-change', {
          detail: { value: iso },
          bubbles: true,
          composed: true,
        }),
      )
    }

    const openPanel = () => {
      if (state.disabled) return
      if (state.open) return
      syncViewToValue()
      state.open = true
    }

    const closePanel = () => {
      if (!state.open) return
      state.open = false
    }

    const inputEl = state.inputEl as HTMLInputElement | null
    if (!inputEl) return

    const onInputClick = () => openPanel()
    const onInputFocus = () => openPanel()
    const onInputChange = () => {
      // User typed an ISO date manually; commit if it parses.
      const v = inputEl.value.trim()
      if (v === '') {
        state.value = ''
        host.dispatchEvent(
          new CustomEvent('sui-change', {
            detail: { value: '' },
            bubbles: true,
            composed: true,
          }),
        )
        return
      }
      const parts = parseIso(v)
      if (parts) commit(v)
    }
    const onInputKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && state.open) {
        e.preventDefault()
        closePanel()
      } else if (e.key === 'ArrowDown' && !state.open) {
        e.preventDefault()
        openPanel()
      }
    }
    inputEl.addEventListener('click', onInputClick)
    inputEl.addEventListener('focus', onInputFocus)
    inputEl.addEventListener('change', onInputChange)
    inputEl.addEventListener('keydown', onInputKeydown)

    const onPanelKeydown = (e: KeyboardEvent) => {
      const cur = (state.focused as string) || (state.value as string) || todayIso()
      let next: string | null = null
      if (e.key === 'ArrowLeft') next = addDays(cur, -1)
      else if (e.key === 'ArrowRight') next = addDays(cur, 1)
      else if (e.key === 'ArrowUp') next = addDays(cur, -7)
      else if (e.key === 'ArrowDown') next = addDays(cur, 7)
      else if (e.key === 'PageUp') next = addDays(cur, -30)
      else if (e.key === 'PageDown') next = addDays(cur, 30)
      else if (e.key === 'Enter') { e.preventDefault(); commit(cur); return }
      else if (e.key === 'Escape') { e.preventDefault(); closePanel(); inputEl.focus(); return }
      if (next != null) {
        e.preventDefault()
        const clamped = clampIso(next, state.min as string, state.max as string)
        state.focused = clamped
        const parts = parseIso(clamped)
        if (parts) {
          state.viewYear = parts.y
          state.viewMonth = parts.m
        }
      }
    }

    const onShadowClick = (e: Event) => {
      const t = e.target as HTMLElement | null
      if (!t) return
      const navBtn = t.closest?.('button[data-act]') as HTMLElement | null
      if (navBtn) {
        const act = navBtn.dataset.act
        if (act === 'prev') moveView(-1)
        else if (act === 'next') moveView(1)
        return
      }
      const day = t.closest?.('button.day[data-iso]') as HTMLButtonElement | null
      if (day && !day.disabled) commit(day.dataset.iso ?? '')
    }

    const onShadowKeydown = (e: KeyboardEvent) => {
      if (!state.open) return
      const inPanel = (e.target as HTMLElement | null)?.closest?.('.panel')
      if (inPanel) onPanelKeydown(e)
    }

    const onDocPointer = (e: Event) => {
      if (!state.open) return
      const path = e.composedPath()
      if (path.includes(host)) return
      closePanel()
    }

    host.shadowRoot?.addEventListener('click', onShadowClick)
    host.shadowRoot?.addEventListener('keydown', onShadowKeydown as EventListener)
    document.addEventListener('pointerdown', onDocPointer)

    host.expose!({
      focus: () => inputEl.focus(),
      blur: () => inputEl.blur(),
      open: openPanel,
      close: closePanel,
    })

    return () => {
      inputEl.removeEventListener('click', onInputClick)
      inputEl.removeEventListener('focus', onInputFocus)
      inputEl.removeEventListener('change', onInputChange)
      inputEl.removeEventListener('keydown', onInputKeydown)
      host.shadowRoot?.removeEventListener('click', onShadowClick)
      host.shadowRoot?.removeEventListener('keydown', onShadowKeydown as EventListener)
      document.removeEventListener('pointerdown', onDocPointer)
    }
  },
})

</controller>
<row class="wrap" part="wrap" gap="2" align="center"
  sx="w:full bg:background fg:foreground border:tone-border radius:md focus-within:ring:tone-ring">
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    inputmode="numeric"
    aria-haspopup="dialog"
    aria-expanded={open() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
  <svg class="cal-icon" part="cal-icon" viewBox="0 0 16 16" aria-hidden="true"
       fill="none" stroke="currentColor" stroke-width="1.5"
       stroke-linecap="round" stroke-linejoin="round"
       sx="w:icon-size-sm h:icon-size-sm fg:muted-foreground">
    <rect x="2" y="3" width="12" height="11" rx="1.5"></rect>
    <path d="M2 6h12 M5 1.5v3 M11 1.5v3"></path>
  </svg>
</row>
{#if open() && !disabled()}
  <div class="panel" part="panel" role="dialog" aria-label="Choose date"
       bind:this={panelEl}
       sx="position:absolute z:popover w:panel-max-w-sm p:2 bg:popover fg:popover-foreground border:border radius:md shadow:md">
    <row class="nav" part="nav" align="center" justify="between">
      <button type="button" data-act="prev" aria-label="Previous month" part="nav-btn"
        sx="w:icon-size-2xl h:icon-size-2xl radius:sm fg:muted-foreground cursor:pointer hover:bg:muted hover:fg:foreground">‹</button>
      <span class="label" part="label"
        sx="weight:semibold">{monthLabel()}</span>
      <button type="button" data-act="next" aria-label="Next month" part="nav-btn"
        sx="w:icon-size-2xl h:icon-size-2xl radius:sm fg:muted-foreground cursor:pointer hover:bg:muted hover:fg:foreground">›</button>
    </row>
    <grid class="grid" part="grid" role="grid" cols="7" gap="1">
      {#for d of dayHeaders() key={d.key}}
        <span class="dow" role="columnheader" part="dow"
          sx="text:sm fg:muted-foreground py:1 weight:medium">{d.label}</span>
      {/for}
      {#for cell of monthCells() key={cell.key}}
        <button
          type="button"
          part="day"
          disabled={cell.disabled}
          aria-label={cell.label}
          aria-selected={cell.selected ? 'true' : 'false'}
          tabindex={cell.focused ? '0' : '-1'}
          class="day {cell.empty ? 'empty' : ''} {cell.selected ? 'selected' : ''} {cell.focused ? 'focused' : ''} {cell.today ? 'today' : ''}"
          data-iso={cell.iso}
        >{cell.empty ? '' : cell.day}</button>
      {/for}
    </grid>
  </div>
{/if}
