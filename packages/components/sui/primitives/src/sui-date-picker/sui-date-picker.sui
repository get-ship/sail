<!--
  <sui-date-picker> — input field + calendar popover.
  Value is ISO 8601 (`YYYY-MM-DD`). The input itself is the trigger:
  clicking it (or focusing) opens the popover. The calendar is a
  month grid; arrow keys move day focus, Enter selects, Escape closes.

  Compose-points:
  - The trigger surface mirrors the <sui-input> chrome (border, focus
    ring, height matrix) so the picker drops into the same form rows.
  - The popover panel is hand-rolled (no <sui-popover>): the trigger
    isn't a <button>, so the native popovertarget wiring sui-popover
    relies on wouldn't apply. The panel uses absolute positioning
    relative to the host.
  ─────────────────────────────────────────────────────────────────────
  Props
    name        Form field name.
    value       ISO date string (YYYY-MM-DD). Empty when unset.
    min         Earliest allowed date (ISO).
    max         Latest allowed date (ISO).
    placeholder Native input placeholder shown when value is empty.
    disabled    Disables interaction + form participation.
    tone        Tones focus ring + selection.
    size        sm | md | lg.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change  { detail: { value: string } }   // ISO date or '' when cleared
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="min" type="string" default="" />
<prop name="max" type="string" default="" />
<prop name="placeholder" type="string" default="YYYY-MM-DD" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    position: relative;
    display: inline-flex;
    width: 100%;
    vertical-align: middle;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: 34px;
    --fs: 13px;
    --px: 10px;
  }
  :host([tone='primary'])     { --tone-border: var(--primary);          --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);              --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);           --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);           --tone-ring: var(--warning); }
  :host([tone='destructive']) { --tone-border: var(--destructive);       --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);            --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground);  --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: 28px; --fs: 12px; --px: 8px; }
  :host([size='md']) { --h: 34px; --fs: 13px; --px: 10px; }
  :host([size='lg']) { --h: 40px; --fs: 14px; --px: 12px; }

  .wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    background: var(--background);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 3px var(--tone-ring);
  }
  :host([disabled]) .wrap {
    background: var(--muted);
    color: var(--muted-foreground);
    filter: saturate(0.4);
    cursor: not-allowed;
  }

  input.entry {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }

  .cal-icon {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: var(--muted-foreground);
    pointer-events: none;
  }

  .panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: var(--z-popover);
    width: 260px;
    padding: var(--space-2);
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: var(--font-body);
    font-size: var(--fs);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-1);
  }
  .nav button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-md);
    line-height: 1;
  }
  .nav button:hover:not(:disabled) {
    background: var(--muted);
    color: var(--foreground);
  }
  .label {
    font-weight: var(--font-weight-semibold);
    text-align: center;
    flex: 1;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-1);
  }
  .dow {
    font-size: 0.75rem;
    text-align: center;
    color: var(--muted-foreground);
    padding: var(--space-1) 0;
    font-weight: var(--font-weight-medium);
  }
  .day {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    cursor: pointer;
    padding: var(--space-2) 0;
    text-align: center;
    border-radius: var(--radius-sm);
  }
  .day:disabled { color: var(--muted-foreground); opacity: 0.4; cursor: not-allowed; }
  .day.empty { visibility: hidden; }
  .day:hover:not(:disabled):not(.empty) {
    background: var(--hover-bg);
  }
  .day.selected {
    background: var(--tone-ring);
    color: var(--background);
    font-weight: var(--font-weight-semibold);
    box-shadow: none;
  }
  .day.focused:not(.selected) {
    outline: 2px solid var(--tone-ring);
    outline-offset: -2px;
  }
  .day.today:not(.selected) {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
</style>

<div class="wrap" part="wrap">
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    inputmode="numeric"
    aria-haspopup="dialog"
    aria-expanded={open() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
  <svg class="cal-icon" viewBox="0 0 16 16" aria-hidden="true"
       fill="none" stroke="currentColor" stroke-width="1.5"
       stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="12" height="11" rx="1.5"></rect>
    <path d="M2 6h12 M5 1.5v3 M11 1.5v3"></path>
  </svg>
</div>
{#if open() && !disabled()}
  <div class="panel" part="panel" role="dialog" aria-label="Choose date"
       bind:this={panelEl}>
    <div class="nav">
      <button type="button" data-act="prev" aria-label="Previous month">‹</button>
      <span class="label">{monthLabel()}</span>
      <button type="button" data-act="next" aria-label="Next month">›</button>
    </div>
    <div class="grid" role="grid">
      {#for d of dayHeaders() key={d.key}}
        <span class="dow" role="columnheader">{d.label}</span>
      {/for}
      {#for cell of monthCells() key={cell.key}}
        <button
          type="button"
          class="day"
          class:empty={cell.empty}
          class:selected={cell.selected}
          class:focused={cell.focused}
          class:today={cell.today}
          data-iso={cell.iso}
          disabled={cell.disabled}
          aria-label={cell.label}
          aria-selected={cell.selected ? 'true' : 'false'}
          tabindex={cell.focused ? '0' : '-1'}
        >{cell.day}</button>
      {/for}
    </div>
  </div>
{/if}
