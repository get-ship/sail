<!--
  <sui-navigation-item> — child element of <sui-navigation-menu>.
  Renders as an anchor when href is set; otherwise a button.

  Prop parity vs <ship-navigation-item>
  ──────────────────────────────────────────────────────────────
  value    (string, '', reflect) — unique identifier
  active   (bool, false, reflect) — reflects active state
  disabled (bool, false, reflect)
  href     (string, '') — optional URL; anchors when set
  ──────────────────────────────────────────────────────────────
  Events: ship-nav-select → sui-nav-select { detail: { value } } bubbles, composed
  ──────────────────────────────────────────────────────────────
  Slots: (default) — label content
  Parts: link, indicator
-->

<prop name="value" type="string" default="" reflect />
<prop name="active" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="href" type="string" default="" />

<variants>
  active:   fg:foreground weight:semibold
  disabled: cursor:not-allowed opacity:50
</variants>

<style>
  /* Residual: host baseline (display/position); .link font-family +
     multi-property transitions + the three-part focus-ring box-shadow
     (sx ring is a single two-layer composition, not this hand-rolled
     combo); .indicator box model + transition; [disabled] .link
     pointer-events (variants don't reach descendants, only :host);
     [active] .indicator fill; forced-colors + reduce-motion overrides
     (system color + reduced-motion media query). */
  :host { display: inline-flex; position: relative; }
  :host([hidden]) { display: none; }
  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    line-height: var(--leading-normal);
    border-radius: var(--radius);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .link:hover {
    color: var(--foreground);
    background: var(--hover-bg);
  }
  .link:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        var(--ring);
  }
  .indicator {
    position: absolute;
    bottom: 0;
    left: var(--space-3_5);
    right: var(--space-3_5);
    height: var(--space-half);
    background: var(--foreground);
    border-radius: var(--radius-full);
    opacity: 0;
    transform: scaleX(0);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  :host([active]) .indicator {
    opacity: 1;
    transform: scaleX(1);
  }
  :host([disabled]) .link { pointer-events: none; }
  @media (forced-colors: active) {
    .link:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
    :host([active]) .indicator { background: CanvasText; }
  }
  @media (prefers-reduced-motion: reduce) {
    .link, .indicator { transition: none !important; animation: none !important; }
  }
</style>

{#if href()}
  <a
    class="link"
    part="link"
    href={href()}
    aria-current={active() ? 'page' : 'false'}
  ><slot></slot></a>
{:else}
  <button
    class="link"
    part="link"
    type="button"
    aria-current={active() ? 'true' : 'false'}
    disabled={disabled()}
  ><slot></slot></button>
{/if}
<div class="indicator" part="indicator" aria-hidden="true"></div>
