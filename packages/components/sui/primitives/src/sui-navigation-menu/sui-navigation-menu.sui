<!--
  <sui-navigation-menu> — SUI port of <ship-navigation-menu>.
  Horizontal navigation bar with active-item tracking and keyboard navigation.
  No dropdown submenus in this version.

  Prop parity vs <ship-navigation-menu>
  ──────────────────────────────────────────────────────────────
  value (string, '', reflect) — active item's value
  ──────────────────────────────────────────────────────────────
  Events: ship-change → sui-change { detail: { value } } bubbles, composed
  ──────────────────────────────────────────────────────────────
  Slots: (default) — <sui-navigation-item> children
-->

<prop name="value" type="string" default="" reflect />

<style>
  :host {
    display: flex;
    align-items: stretch;
    gap: 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }
</style>

<slot bind:this={defaultSlotEl}></slot>
