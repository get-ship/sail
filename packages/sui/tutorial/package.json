{
  "name": "@ship/sui-tutorial",
  "version": "0.2.0",
  "description": "SUI tutorial — 25 lessons (paired starter + solved controller + template, plus prose). Droppable into the marketing site or any host.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./lessons/*": "./src/lessons/*",
    "./prose/*": "./src/prose/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
