<prop name="shadow" type="bool" default="false" />

<div class="dash">
  <p>healthy view — no compile errors.</p>
  <p>state: <strong>{label()}</strong></p>
  <button on:click={() => toggle()}>toggle</button>
  <!-- try editing: change `on:click` to `on:click|nope` and watch the
       inline squiggle appear — the wasm compiler reports the same
       error the LSP CLI would. -->
</div>
