<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="refs-demo">
  <input bind:this={inputEl} bind:value={text} placeholder="type here…" />
  <p>chars: <strong>{text().length}</strong> · width: <strong>{width()}px</strong></p>
  <button on:click={() => inputEl()?.focus()}>focus input</button>
  <button on:click={() => inputEl()?.select()}>select all</button>
</div>
