<component>{
  props: {
    shadow: false,
  },
}</component>
<!-- <style> is the escape hatch for: the card's h2 (font-size off the
     sx text scale — 18px sits between lg=16 and xl=20), the link's
     mono font + hover underline (pseudo-class), and the `.kind`
     span's sans font. Color, radius, border, padding, max-w, the p's
     type/lh/ink, and the kind chip's spacing all come from sx / the
     layout primitives. -->
<style>
  .closer h2 { margin: 0; font-size: 1.125rem; }
  .links a { font-family: var(--font-mono, monospace); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .links .kind { font-family: var(--font-body); }
</style>

<div class="closer" sx="p:4 border:border radius:lg bg:card max-w:panel-max-w-md">
  <column gap="3">
    <h2>{title()}</h2>
    <p sx="text:md leading:normal-plus fg:muted-foreground m:0">You've finished the tutorial. Pick a thread:</p>

    <column gap="1">
      {#for link of links() key={link.href}}
        <a href={link.href} target="_top" sx="fg:primary">
          <span class="kind" sx="fg:muted-foreground mr:2 text:xs">{link.kind}</span>
          {link.label}
        </a>
      {/for}
    </column>
  </column>
</div>