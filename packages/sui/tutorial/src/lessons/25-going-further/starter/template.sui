<prop name="shadow" type="bool" default="false" />

<style>
  .closer { display: grid; gap: 12px; padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); max-width: 28rem; }
  .closer h2 { margin: 0; font-size: 1.125rem; }
  .closer p { margin: 0; color: var(--muted-foreground); font-size: 0.875rem; line-height: 1.6; }
  .links { display: grid; gap: 4px; }
  .links a { color: var(--primary); text-decoration: none; font-family: var(--font-mono, monospace); font-size: 0.8125rem; }
  .links a:hover { text-decoration: underline; }
  .links .kind { color: var(--muted-foreground); font-family: var(--font-sans, sans-serif); margin-right: 8px; font-size: 0.75rem; }
</style>

<div class="closer">
  <h2>{title()}</h2>
  <p>You've finished the tutorial. Pick a thread:</p>

  <div class="links">
    {#for link of links() key={link.href}}
      <a href={link.href} target="_top">
        <span class="kind">{link.kind}</span>
        {link.label}
      </a>
    {/for}
  </div>
</div>
