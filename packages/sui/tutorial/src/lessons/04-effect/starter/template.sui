<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="effect">
  <p>count: <strong>{count()}</strong> — look at the document title in your browser tab.</p>
  <div class="row">
    <button on:click={() => bump(1)}>+1</button>
    <button on:click={() => bump(-1)}>−1</button>
    <button on:click={() => reset()}>reset</button>
  </div>
  <p class="hint">The title effect re-runs only when <code>count()</code> changes.</p>
</div>
