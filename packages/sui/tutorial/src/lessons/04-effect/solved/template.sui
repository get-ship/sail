<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="effect">
  <p>count: <strong>{count()}</strong> — persisted across reloads.</p>
  <p>elapsed: <strong>{elapsed()}s</strong> since this scope mounted.</p>
  <div class="row">
    <button on:click={() => bump(1)}>+1</button>
    <button on:click={() => bump(-1)}>−1</button>
    <button on:click={() => reset()}>reset</button>
  </div>
</div>
