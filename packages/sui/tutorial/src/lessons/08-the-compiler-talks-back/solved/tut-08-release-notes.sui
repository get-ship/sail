<!--
  Lesson 08 solved — every rejection answered on the compiler's terms.

  p:12px became the token p:4; the motion preset is 'fade' (the closed
  set); the date is a zero-arg derived read; the <style> block is gone —
  the row surface it hand-painted is sx now. No fix fought the language.
-->

<controller>
import { controller, signal, derived } from '@ship/sui-runtime'

interface Note {
  id: number
  tag: string
  text: string
}

export default controller(() => {
    const publishedAt = signal(new Date('2026-07-01T09:00:00Z'))
    const notes = signal<Note[]>([
      { id: 1, tag: 'feat', text: 'motion:loop — ambient animation as a directive' },
      { id: 2, tag: 'fix', text: 'exit-hold no longer races the reconciler' },
      { id: 3, tag: 'docs', text: 'the tutorial you are reading right now' },
    ])

    // The starter called formatDate(publishedAt()) IN THE TEMPLATE — an
    // argument-taking call, which renderable expressions forbid. The fix
    // is always the same move: do the work here, expose a zero-arg read.
    const published = derived(() =>
      publishedAt().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
    )

    return { notes, published }
  })
</controller>

<column gap="4" sx="p-4">
  <row align="center" justify="between">
    <h3>Release notes</h3>
    <badge tone="primary" variant="soft" motion:enter={{ opacity: 'fade' }}>v2.4.0</badge>
  </row>

  <p sx="text-sm text-muted-foreground">published {published()}</p>

  <column gap="1">
    {#for note of notes() key={note.id}}
      <row gap="3" align="center" sx="px-3 py-2 bg-surface-1 rounded-md">
        <badge tone="muted" variant="outline" size="sm">{note.tag}</badge>
        <p sx="text-sm">{note.text}</p>
      </row>
    {/for}
  </column>
</column>
