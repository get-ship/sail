<prop name="shadow" type="bool" default="false" />

<!-- The data-test attributes are what a sui-eval spec would target.
     They survive minification + keep the eval selectors stable
     against className / DOM shape churn. -->
<div class="counter">
  <p>count: <strong>{count()}</strong></p>
  <div class="row">
    <button data-test="bump-up"   on:click={() => bump(1)}>+1</button>
    <button data-test="bump-down" on:click={() => bump(-1)}>−1</button>
    <button data-test="reset"     on:click={() => reset()}>reset</button>
  </div>
</div>
