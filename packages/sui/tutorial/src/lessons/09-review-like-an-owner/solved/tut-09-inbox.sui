<!--
  Lesson 09 solved — the screen as an owner would ship it.

  Compare with the starter: the title flows from the prop; all three
  live() states render; the {#for} keys on identity (m.id); rows exit as
  well as enter; and the empty case is the semantic <empty-state>, not a
  hand-rolled div.
-->
<component>{
  props: {
    title: 'Support inbox',
  },
}</component>
<column gap="4">
  <row align="center" justify="between">
    <h3>{title()}</h3>
    <row gap="1">
      <button size="sm" tone="primary" variant={filter() === 'all' ? 'solid' : 'ghost'} on:click={() => setFilter('all')}>All</button>
      <button size="sm" tone="primary" variant={filter() === 'unread' ? 'solid' : 'ghost'} on:click={() => setFilter('unread')}>Unread</button>
    </row>
  </row>

  {#while-loading of inbox}
    <row gap="2" align="center" sx="p:4 bg:surface-1 radius:md">
      <spinner size="sm"></spinner>
      <small sx="fg:muted-foreground">loading messages…</small>
    </row>
  {/while-loading}

  {#while-error err of inbox}
    <alert tone="destructive">{err.message}</alert>
  {/while-error}

  {#if inbox().kind === 'ok'}
    <column gap="1">
      {#for m of visible() key={m.id}}
        <row gap="3" align="center" sx="px:3 py:2 bg:surface-1 border:border-subtle radius:md"
             motion:enter={{ opacity: 'fade', translate-y: 'spring:gentle', stagger: '40ms' }}
             motion:exit={{ opacity: 'fade-out' }}>
          {#if !m.read}<span sx="display:inline-block w:1_5 h:1_5 radius:full bg:primary"></span>{/if}
          <column gap="0" sx="grow:1">
            <strong sx="text:sm">{m.from}</strong>
            <small sx="fg:muted-foreground">{m.subject}</small>
          </column>
          <badge tone={m.tone} variant="soft" size="sm">{m.topic}</badge>
          <button size="sm" variant="ghost" on:click={() => archive(m.id)}>Archive</button>
        </row>
      {/for}
      {#if visible().length === 0}
        <empty-state variant="inline" tone="muted">
          <span slot="title">Inbox zero</span>
          Nothing matches this filter.
        </empty-state>
      {/if}
    </column>
  {/if}
</column>
