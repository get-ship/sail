<!--
  Lesson 09 starter — it compiles, it runs, it demos well. Ship it?

  No. Five review flaws are planted in this template, and the compiler
  accepts every one of them. Read it the way you would read an agent's
  pull request: what breaks on the second render, the slow network, the
  reorder, the translation pass — the paths the demo never took.
-->
<component>{
  props: {
    title: 'Support inbox',
  },
}</component>
<controller>
import { controller, signal, derived, live } from '@ship/sui-runtime'
import type { Scope } from './tut-09-inbox-starter.sui'

interface Message {
  id: number
  from: string
  subject: string
  topic: string
  tone: 'info' | 'warning' | 'destructive' | 'success'
  read: boolean
}

// The "server". Note the repeated topics — a non-unique field is exactly
// the kind of thing an unreviewed key= reaches for.
function fetchInbox(): Promise<Message[]> {
  const MESSAGES: Message[] = [
    { id: 1, from: 'monitoring', subject: 'p95 back under 200ms', topic: 'latency', tone: 'success', read: true },
    { id: 2, from: 'jules', subject: 'refund for order #8841?', topic: 'billing', tone: 'warning', read: false },
    { id: 3, from: 'monitoring', subject: 'error budget 40% consumed', topic: 'latency', tone: 'info', read: false },
    { id: 4, from: 'sam', subject: 'card declined on renewal', topic: 'billing', tone: 'destructive', read: false },
    { id: 5, from: 'dana', subject: 'love the new tutorial', topic: 'feedback', tone: 'info', read: true },
  ]
  return new Promise((resolve) => setTimeout(() => resolve(MESSAGES), 700))
}

// This controller is sound. Every flaw in this lesson lives in the
// TEMPLATE, and every one of them compiles — that is the point: the
// compiler owns correctness of the surface, the reviewer owns intent.
export default controller<Scope>({
  scope: () => {
    const inbox = live(fetchInbox)
    const filter = signal<'all' | 'unread'>('all')
    const archived = signal<number[]>([])

    const visible = derived(() => {
      const state = inbox()
      if (state.kind !== 'ok') return []
      return state.value.filter(
        (m) => !archived().includes(m.id) && (filter() === 'all' || !m.read),
      )
    })

    return {
      inbox,
      filter,
      visible,
      setFilter: (f: 'all' | 'unread'): void => filter.set(f),
      archive: (id: number): void => archived.set([...archived(), id]),
    }
  },
})
</controller>

<column gap="4">
  <row align="center" justify="between">
    <h3>Support inbox</h3>
    <row gap="1">
      <button size="sm" tone="primary" variant={filter() === 'all' ? 'solid' : 'ghost'} on:click={() => setFilter('all')}>All</button>
      <button size="sm" tone="primary" variant={filter() === 'unread' ? 'solid' : 'ghost'} on:click={() => setFilter('unread')}>Unread</button>
    </row>
  </row>

  {#while-error err of inbox}
    <alert tone="destructive">{err.message}</alert>
  {/while-error}

  {#if inbox().kind === 'ok'}
    <column gap="1">
      {#for m of visible() key={m.topic}}
        <row gap="3" align="center" sx="px:3 py:2 bg:surface-1 border:border-subtle radius:md"
             motion:enter={{ opacity: 'fade', translate-y: 'spring:gentle', stagger: '40ms' }}>
          {#if !m.read}<span sx="display:inline-block w:1_5 h:1_5 radius:full bg:primary"></span>{/if}
          <column gap="0" sx="grow:1">
            <strong sx="text:sm">{m.from}</strong>
            <small sx="fg:muted-foreground">{m.subject}</small>
          </column>
          <badge tone={m.tone} variant="soft" size="sm">{m.topic}</badge>
          <button size="sm" variant="ghost" on:click={() => archive(m.id)}>Archive</button>
        </row>
      {/for}
      {#if visible().length === 0}
        <div sx="p:4 text:sm fg:muted-foreground">Nothing matches this filter.</div>
      {/if}
    </column>
  {/if}
</column>
