<prop name="shadow" type="bool" default="false" />

<div class="counter">
  <p>count: <strong>{count()}</strong></p>
  <div class="row">
    <button on:click={() => bump(1)}>+1</button>
    <button on:click={() => bump(-1)}>−1</button>
    <button on:click={() => reset()}>reset</button>
  </div>
</div>
