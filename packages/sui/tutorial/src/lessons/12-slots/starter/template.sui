<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="slots-demo">
  <card>
    <chip slot="header" tone="primary">{label()}</chip>
    <p>count: <strong>{count()}</strong></p>
    <!-- TODO 1: slot a button into "footer" that calls bump() -->
  </card>

  <div class="row">
    <button ghost sm on:click={() => bump(1)}>+1</button>
    <button ghost sm on:click={() => bump(-1)}>−1</button>
  </div>
</div>
