<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="slots-demo">
  <card>
    <chip slot="header" tone={count() > 5 ? 'warning' : 'primary'}>{label()}</chip>
    <p>count: <strong>{count()}</strong></p>
    <button slot="footer" sm primary on:click={() => bump(1)}>+1 from footer</button>
  </card>

  {#if count() > 5}
    <alert tone="warning">
      <span slot="title">notice</span>
      Count exceeded 5 — adjust threshold or reset.
    </alert>
  {/if}

  <div class="row">
    <button ghost sm on:click={() => bump(1)}>+1</button>
    <button ghost sm on:click={() => bump(-1)}>−1</button>
    <button ghost sm on:click={() => count.set(0)}>reset</button>
  </div>
</div>
