<component>{
  props: {
    shadow: false,
  },
}</component>
<!-- <style> is the escape hatch for the dynamic STATE classes that class:
     toggles (done/overdue/selected) and the progress-bar fill width. Layout,
     spacing, and text come from sx + the layout keywords below. -->
<style>
  .sui-template { --pct: 0%; }
  .todo-row.done { opacity: 0.5; text-decoration: line-through; }
  .todo-row.overdue { border-color: var(--destructive); color: var(--destructive); }
  .todo-row.selected { background: var(--surface-2); }
  .bar { height: var(--space-1_5); background: var(--muted); border-radius: var(--radius-sm); overflow: hidden; }
  .bar > .fill { height: 100%; background: var(--primary); width: var(--pct, 0%); transition: width 200ms; }
</style>

<column gap="2">
  {#for t of todos() key={t.id}}
    <row
      class="todo-row"
      class:done={t.done}
      class:overdue={t.due < now()}
      class:selected={t.id === selectedId()}
      justify="between"
      align="center"
      gap="2"
      sx="py:1_5 px:2_5 border:border radius:md"
      on:click={() => selectRow(t.id)}
    >
      <strong>{t.label}</strong>
      <span sx="text:xs fg:muted-foreground">{now() > t.due ? 'overdue' : 'on time'}</span>
    </row>
  {/for}

  <div class="bar" style:--pct={pct() + '%'}>
    <div class="fill"></div>
  </div>
  <p sx="text:xs fg:muted-foreground">{pct()}% complete</p>
</column>
