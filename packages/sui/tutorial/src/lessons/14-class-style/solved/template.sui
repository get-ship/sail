<prop name="shadow" type="bool" default="false" />

<style>
  .todo-row { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; }
  .todo-row.done { opacity: 0.5; text-decoration: line-through; }
  .todo-row.overdue { border-color: var(--destructive); color: var(--destructive); }
  .todo-row.selected { background: color-mix(in oklch, var(--primary) 14%, transparent); }
  .bar { height: 6px; background: var(--muted); border-radius: 3px; overflow: hidden; margin-top: 8px; }
  .bar > .fill { height: 100%; background: var(--primary); width: var(--pct, 0%); transition: width 200ms; }
</style>

<div class="list">
  {#for t of todos() key={t.id}}
    <div
      class="todo-row"
      class:done={t.done}
      class:overdue={t.due < now()}
      class:selected={t.id === selectedId()}
      on:click={() => { select(t.id); toggle(t.id) }}
    >
      <strong>{t.label}</strong>
      <span style="margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem;">{t.due < now() ? 'overdue' : 'on time'}</span>
    </div>
  {/for}

  <div class="bar" style:--pct={pct() + '%'}>
    <div class="fill"></div>
  </div>
  <p style="font-size: 0.75rem; color: var(--muted-foreground);">{pct()}% complete</p>
</div>
