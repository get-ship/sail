<prop name="shadow" type="bool" default="false" />

<div class="chat" on:click|self={() => dismiss()}>
  <ul class="log">
    {#for m of messages() key={m.id}}
      <li>{m.text}</li>
    {/for}
  </ul>

  <form on:submit|preventDefault={() => send()}>
    <input
      bind:value={draft}
      on:keydown|key:Enter={() => send()}
      on:keydown|key:Escape={() => dismiss()}
      placeholder="enter sends · escape clears"
    />
    <button type="submit">Send</button>
  </form>

  <button type="button" on:click={() => firstAction()} disabled={fired()}>
    {fired() ? 'fired ✓' : 'click once'}
  </button>
</div>
