<prop name="shadow" type="bool" default="false" />

<div class="branch">
  {#if state() === 'idle'}
    <button on:click={() => start()}>start request</button>
  {:else if state() === 'loading'}
    <p class="muted">loading…</p>
  {:else if state() === 'error'}
    <p class="err">request failed.</p>
    <button on:click={() => start()}>retry</button>
  {:else}
    <p class="ok">done! ✓</p>
    <button on:click={() => reset()}>start over</button>
  {/if}
</div>
