<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="branch">
  {#if state() === 'idle'}
    <button on:click={() => start()}>start request</button>
  {:else if state() === 'loading'}
    <p class="muted">loading…</p>
  {:else}
    <p class="ok">done! ✓</p>
    <!-- TODO: add a "start over" button here -->
  {/if}
</div>
