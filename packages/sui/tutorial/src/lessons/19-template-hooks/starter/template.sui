<component>{
  props: {
    shadow: false,
  },
}</component>
<use-title text="SUI tutorial · step 19" />

<use-kbd>
  <on key="j" action="bumpUp" />
  <on key="k" action="bumpDown" />
  <on key="r" action="reset" />
</use-kbd>

<div class="hooks-demo">
  <p>count: <strong>{count()}</strong></p>
  <p class="hint">look at the browser tab title — also try pressing j / k / r.</p>
  <div class="row">
    <button on:click={() => bumpUp()}>+1</button>
    <button on:click={() => bumpDown()}>−1</button>
    <button on:click={() => reset()}>reset</button>
  </div>
</div>
