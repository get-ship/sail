<!--
  Lesson 05 starter — the roster renders, but only in the happy path.

  A live() handle has THREE states, and this template handles one. Add the
  {#while-loading} and {#while-error} boundaries, then wire the form.
-->

<controller>
import { controller, signal, live } from '@ship/sui-runtime'
import type { Scope } from './tut-05-team-directory-starter.sui'

interface Member {
  id: number
  name: string
  role: 'member' | 'admin'
}

// The "server": module state behind a latency-simulating fetch. Swap in a
// real fetch()/SDK call and nothing else in the lesson changes.
let nextId = 4
const DB: Member[] = [
  { id: 1, name: 'Ada Lovelace', role: 'admin' },
  { id: 2, name: 'Grace Hopper', role: 'member' },
  { id: 3, name: 'Mary Shelley', role: 'member' },
]

function fetchTeam(fail: boolean): Promise<Member[]> {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (fail) reject(new Error('503 — the team service is down. Uncheck "break the API" and reload.'))
      else resolve([...DB])
    }, 600)
  })
}

export default controller<Scope>({
  scope: () => {
    const breakApi = signal(false)
    const name = signal('')
    const role = signal<'member' | 'admin'>('member')

    // TODO 1: this source reads NO tracked signals, so it runs exactly
    // once. Add an `attempt` signal, read attempt() and breakApi() inside
    // the thunk, and both become deps — bumping either re-runs the fetch
    // (back through 'loading').
    const team = live(() => fetchTeam(false))

    return {
      team,
      breakApi,
      name,
      role,
      // TODO 2: reload() should bump the attempt signal.
      reload: (): void => {},
      // TODO 3: add() — push { id: nextId++, name, role } into DB, clear
      // the inputs, then bump attempt: the list refreshes through the same
      // fetch path as everything else. (nextId is referenced here only so
      // the untouched starter typechecks.)
      add: (): void => {
        void nextId
      },
    }
  },
})
</controller>

<column gap="4">
  <row align="center" justify="between">
    <h3>Team</h3>
    <row gap="3" align="center">
      <label sx="text-sm text-muted-foreground">
        <input type="checkbox" bind:checked={breakApi} /> break the API
      </label>
      <button size="sm" variant="outline" on:click={() => reload()}>Reload</button>
    </row>
  </row>

  <!-- TODO 4: {#while-loading of team} — a spinner row, so the first
       paint isn't blank. -->

  <!-- TODO 5: {#while-error err of team} — an <alert tone="destructive">
       showing err.message. -->

  {#if team().kind === 'ok'}
    <column gap="1">
      {#for m of team().value key={m.id}}
        <row gap="3" align="center" sx="px-3 py-2 bg-surface-1 rounded-md">
          <strong sx="grow-1 text-sm">{m.name}</strong>
          {#if m.role === 'admin'}<badge tone="primary" variant="soft" size="sm">admin</badge>{/if}
        </row>
      {/for}
    </column>
  {/if}

  <form on:submit|prevent={add}>
    <row gap="2" align="center">
      <input placeholder="Add a teammate" bind:value={name} size="sm" />
      <select bind:value={role} size="sm">
        <option value="member">member</option>
        <option value="admin">admin</option>
      </select>
      <button type="submit" size="sm" variant="solid" tone="primary">Add</button>
    </row>
  </form>
</column>
