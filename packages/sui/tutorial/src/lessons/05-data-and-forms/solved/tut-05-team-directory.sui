<!--
  Lesson 05 solved — all three states of a live() handle are explicit.

  {#while-loading} covers the first paint and every refetch;
  {#while-error} covers rejection; the value is only reachable behind
  kind === 'ok'. The form writes through bind:value / bind:checked and
  refetches by bumping a tracked signal.
-->

<controller>
import { controller, signal, derived, live } from '@ship/sui-runtime'
import type { Scope } from './tut-05-team-directory.sui'

interface Member {
  id: number
  name: string
  role: 'member' | 'admin'
}

// The "server": module state behind a latency-simulating fetch. Swap in a
// real fetch()/SDK call and nothing else in the lesson changes.
let nextId = 4
const DB: Member[] = [
  { id: 1, name: 'Ada Lovelace', role: 'admin' },
  { id: 2, name: 'Grace Hopper', role: 'member' },
  { id: 3, name: 'Mary Shelley', role: 'member' },
]

function fetchTeam(fail: boolean): Promise<Member[]> {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (fail) reject(new Error('503 — the team service is down. Uncheck "break the API" and reload.'))
      else resolve([...DB])
    }, 600)
  })
}

export default controller<Scope>({
  scope: () => {
    const attempt = signal(1)
    const breakApi = signal(false)
    const name = signal('')
    const role = signal<'member' | 'admin'>('member')

    // live() wraps the async source in a state signal:
    //   { kind: 'loading' } → { kind: 'ok', value } | { kind: 'error', error }
    // attempt() and breakApi() are read INSIDE the thunk, so both are
    // tracked deps: change either and the source re-runs, back through
    // 'loading'. That is the whole refetch story — no refetch() method,
    // just a signal you bump.
    const team = live(() => {
      attempt()
      return fetchTeam(breakApi())
    })

    const canAdd = derived(() => name().trim().length > 0)

    return {
      team,
      breakApi,
      name,
      role,
      canAdd,
      reload: (): void => attempt.set((n) => n + 1),
      add: (): void => {
        if (!canAdd()) return
        DB.push({ id: nextId++, name: name().trim(), role: role() })
        name.set('')
        role.set('member')
        attempt.set((n) => n + 1) // refetch: the list refreshes through the same path
      },
    }
  },
})
</controller>

<column gap="4">
  <row align="center" justify="between">
    <h3>Team</h3>
    <row gap="3" align="center">
      <label sx="text:sm fg:muted-foreground">
        <input type="checkbox" bind:checked={breakApi} /> break the API
      </label>
      <button size="sm" variant="outline" on:click={() => reload()}>Reload</button>
    </row>
  </row>

  {#while-loading of team}
    <row gap="2" align="center" sx="p:4 bg:surface-1 radius:md">
      <spinner size="sm"></spinner>
      <small sx="fg:muted-foreground">loading the roster…</small>
    </row>
  {/while-loading}

  {#while-error err of team}
    <alert tone="destructive">{err.message}</alert>
  {/while-error}

  {#if team().kind === 'ok'}
    <column gap="1">
      {#for m of team().value key={m.id}}
        <row gap="3" align="center" sx="px:3 py:2 bg:surface-1 radius:md">
          <strong sx="grow:1 text:sm">{m.name}</strong>
          {#if m.role === 'admin'}<badge tone="primary" variant="soft" size="sm">admin</badge>{/if}
        </row>
      {/for}
    </column>
  {/if}

  <form on:submit|prevent={add}>
    <row gap="2" align="center">
      <input placeholder="Add a teammate" bind:value={name} size="sm" />
      <select bind:value={role} size="sm">
        <option value="member">member</option>
        <option value="admin">admin</option>
      </select>
      <button type="submit" size="sm" variant="solid" tone="primary" disabled={!canAdd()}>Add</button>
    </row>
  </form>
</column>
