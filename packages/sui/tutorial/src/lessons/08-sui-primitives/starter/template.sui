<prop name="shadow" type="bool" default="false" />

<div class="dash">
  <sui-card>
    <h3 style="margin: 0 0 8px;">request rate</h3>
    <sui-stat tone="default" size="lg">
      <span slot="label">errors / sec</span>
      {rateText()}
      <span slot="hint">over the last 60s</span>
    </sui-stat>

    <div class="row">
      <span dot tone="success" size="sm" role="img" aria-label="ok"></span>
      <span>system healthy</span>
    </div>

    <div class="actions">
      <button ghost sm on:click={() => bumpRate(1)}>+1</button>
      <button ghost sm on:click={() => bumpRate(-1)}>−1</button>
      <button ghost sm on:click={() => reset()}>reset</button>
    </div>
  </sui-card>
</div>
