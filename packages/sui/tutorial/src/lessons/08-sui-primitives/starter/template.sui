<prop name="shadow" type="bool" default="false" />

<div class="dash">
  <sui-card>
    <h3 style="margin: 0 0 8px;">request rate</h3>
    <sui-stat tone="default" size="lg">
      <span slot="label">errors / sec</span>
      {rateText()}
      <span slot="hint">over the last 60s</span>
    </sui-stat>

    <div class="row">
      <sui-status-dot tone="success" size="sm" label="ok"></sui-status-dot>
      <span>system healthy</span>
    </div>

    <div class="actions">
      <sui-button variant="ghost" size="sm" on:click={() => bumpRate(1)}>+1</sui-button>
      <sui-button variant="ghost" size="sm" on:click={() => bumpRate(-1)}>−1</sui-button>
      <sui-button variant="ghost" size="sm" on:click={() => reset()}>reset</sui-button>
    </div>
  </sui-card>
</div>
