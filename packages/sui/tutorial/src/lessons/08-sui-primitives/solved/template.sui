<prop name="shadow" type="bool" default="false" />

<div class="dash">
  <sui-card tone={alarming() ? 'warning' : 'default'}>
    <h3 style="margin: 0 0 8px;">request rate</h3>
    <sui-stat tone={alarming() ? 'destructive' : 'default'} size="lg">
      <span slot="label">errors / sec</span>
      {rateText()}
      <span slot="hint">over the last 60s</span>
    </sui-stat>

    <div class="row">
      <sui-status-dot
        tone={alarming() ? 'destructive' : 'success'}
        size="sm"
        pulse={alarming()}
        label={alarming() ? 'rate limit' : 'ok'}
      ></sui-status-dot>
      <span>{alarming() ? 'rate limit exceeded' : 'system healthy'}</span>
    </div>

    {#if alarming()}
      <sui-alert tone="destructive">
        <span slot="title">rate limit exceeded</span>
        error rate is {rateText()}/s — investigate upstream.
      </sui-alert>
    {/if}

    <div class="actions">
      <sui-button variant="ghost" size="sm" on:click={() => bumpRate(1)}>+1</sui-button>
      <sui-button variant="ghost" size="sm" on:click={() => bumpRate(-1)}>−1</sui-button>
      <sui-button variant="soft" tone="primary" size="sm" on:click={() => reset()}>reset</sui-button>
    </div>
  </sui-card>
</div>
