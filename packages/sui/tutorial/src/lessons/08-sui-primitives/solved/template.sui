<prop name="shadow" type="bool" default="false" />

<card tone={alarming() ? 'warning' : 'default'}>
  <column gap="3">
    <h3>request rate</h3>

    <!-- a "stat" composed from primitives: label · big value · hint -->
    <column gap="0">
      <span sx="text:sm fg:muted-foreground">errors / sec</span>
      <strong sx="text:3xl">{rateText()}</strong>
      <span sx="text:xs fg:muted-foreground">over the last 60s</span>
    </column>

    <row gap="2" align="center">
      <span
        dot
        tone={alarming() ? 'destructive' : 'success'}
        size="sm"
        pulse={alarming()}
        role="img"
        aria-label={alarming() ? 'rate limit' : 'ok'}
      ></span>
      <span>{alarming() ? 'rate limit exceeded' : 'system healthy'}</span>
    </row>

    {#if alarming()}
      <sui-alert tone="destructive">
        <span slot="title">rate limit exceeded</span>
        error rate is {rateText()}/s — investigate upstream.
      </sui-alert>
    {/if}

    <row gap="2">
      <button ghost sm on:click={() => bumpRate(1)}>+1</button>
      <button ghost sm on:click={() => bumpRate(-1)}>−1</button>
      <button soft primary sm on:click={() => reset()}>reset</button>
    </row>
  </column>
</card>
