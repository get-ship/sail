<component>{
  props: {
    shadow: false,
  },
}</component>
<!-- <style> is the escape hatch for the row's mono font + centered text
     (no sx prop for font-family or text-align) and for the
     class:selected toggle below. The grid's auto-fill minmax template
     and the scroll container are also kept here. -->
<style>
  .rows { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 2px; max-height: 240px; overflow-y: auto; }
  .row { font-family: var(--font-mono); text-align: center; }
  .row.selected { background: var(--primary); color: var(--background); border-color: var(--primary); }
</style>

<div class="grid">
  <p>selected: <strong>{selectedId()}</strong> · press j/k to move</p>
  <div class="rows" on:keydown|key:j={() => move(1)} on:keydown|key:k={() => move(-1)} tabindex="0">
    {#for r of rows() key={r.id}}
      <div class="row" class:selected={selectedSet().has(r.id)} sx="p:1 px:2 border:border radius:sm text:sm">{r.label}</div>
    {/for}
  </div>
</div>