<prop name="shadow" type="bool" default="false" />

<div class="todo">
  <form on:submit|preventDefault={() => add()}>
    <input bind:value={draft} placeholder="What needs doing?" />
    <button type="submit">Add</button>
  </form>
  <ul>
    {#for t of todos() key={t.id}}
      <li class:done={t.done} on:click={() => toggle(t.id)}>{t.label}</li>
    {/for}
    {#if todos().length === 0}
      <li class="empty">nothing yet — type above</li>
    {/if}
  </ul>
</div>
