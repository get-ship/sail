<prop name="shadow" type="bool" default="false" />

<!-- <style> is the escape hatch for: the per-label stack layout (sx
     can't reach descendants), the `:disabled` pseudo on the submit
     button, and `font-family` / `font-weight` (no sx props). -->
<style>
  .signup label { display: grid; gap: 4px; font-size: 0.875rem; }
  .signup button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<form class="signup" on:submit|preventDefault={(e) => form.submit(e)} sx="max-w:panel-max-w-md">
  <column gap="2">
    <label>name <input type="text" bind:value={form.name} sx="px:2 py:1_5 border:border radius:md bg:background fg:foreground" /></label>
    {#if form.errors().name}<p class="err" sx="fg:destructive text:xs m:0">{form.errors().name}</p>{/if}

    <label>email <input type="email" bind:value={form.email} sx="px:2 py:1_5 border:border radius:md bg:background fg:foreground" /></label>
    {#if form.errors().email}<p class="err" sx="fg:destructive text:xs m:0">{form.errors().email}</p>{/if}

    <row align="center" gap="1">
      <input type="checkbox" bind:checked={form.accept} /> I accept the terms
    </row>
    {#if form.errors().accept}<p class="err" sx="fg:destructive text:xs m:0">{form.errors().accept}</p>{/if}

    <row gap="2" align="center" justify="between">
      <row gap="2" align="center">
        <button type="submit" disabled={!form.valid() || form.pending()} sx="px:3 py:1_5 bg:primary fg:background border:none radius:md weight:medium cursor:pointer">
          {form.pending() ? 'submitting…' : 'submit'}
        </button>
        <button type="button" on:click={() => form.reset()} sx="px:3 py:1_5 bg:transparent fg:foreground border:border radius:md cursor:pointer">reset</button>
      </row>
      <span sx="text:xs fg:muted-foreground">{form.dirty() ? 'dirty' : 'clean'}</span>
    </row>

    {#if form.lastError()}<p class="err" sx="fg:destructive text:xs m:0">submit failed: {form.lastError().message}</p>{/if}
  </column>
</form>