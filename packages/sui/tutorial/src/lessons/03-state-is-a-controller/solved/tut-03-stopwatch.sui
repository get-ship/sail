<!--
  Lesson 03 solved — a stopwatch.

  The <controller> block below owns the state; the template binds only
  what its scope() returns: clock, running, laps, and three handlers.
-->

<controller>
import { controller, signal, derived, effect } from '@ship/sui-runtime'
import type { Scope } from './tut-03-stopwatch.sui'

interface Lap {
  id: number
  at: string
}

// The controller owns ALL state. The template can bind only what scope()
// returns — nothing else exists on the other side of the boundary.
export default controller<Scope>({
  setup: () => {
    const elapsed = signal(0) // milliseconds
    const running = signal(false)
    const laps = signal<Lap[]>([])

    const clock = derived(() => {
      const total = elapsed()
      const m = Math.floor(total / 60000)
      const s = Math.floor((total % 60000) / 1000)
      const tenths = Math.floor((total % 1000) / 100)
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${tenths}`
    })

    // The interval is OWNED by this effect. It re-runs when `running`
    // flips; the returned cleanup runs before every re-run and when the
    // component unmounts — the timer cannot leak, because teardown is
    // part of the effect itself, not a separate lifecycle hook.
    effect(() => {
      if (!running()) return
      const id = setInterval(() => elapsed.set((ms) => ms + 100), 100)
      return () => clearInterval(id)
    })

    let lapId = 0

    return {
      clock,
      running,
      laps,
      toggle: (): void => running.set(!running()),
      lap: (): void => laps.set([{ id: ++lapId, at: clock() }, ...laps()]),
      reset: (): void => {
        running.set(false)
        elapsed.set(0)
        laps.set([])
      },
    }
  },
})
</controller>

<column gap="4">
  <center sx="p-6 bg-surface-1 border border-border rounded-lg">
    <strong sx="text-4xl tracking-tight">{clock()}</strong>
  </center>

  <row gap="2" justify="center">
    <button variant="solid" tone={running() ? 'warning' : 'primary'} on:click={() => toggle()}>
      {running() ? 'Pause' : 'Start'}
    </button>
    <button variant="outline" tone="primary" disabled={!running()} on:click={() => lap()}>Lap</button>
    <button variant="ghost" on:click={() => reset()}>Reset</button>
  </row>

  {#if laps().length > 0}
    <column gap="1">
      {#for lap of laps() key={lap.id}}
        <row align="center" justify="between" sx="px-3 py-1 bg-surface-1 rounded-md">
          <small sx="text-muted-foreground">lap {lap.id}</small>
          <strong sx="text-sm">{lap.at}</strong>
        </row>
      {/for}
    </column>
  {/if}
</column>
