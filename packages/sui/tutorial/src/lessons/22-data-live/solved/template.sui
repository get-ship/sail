<prop name="shadow" type="bool" default="false" />

<data name="users" source="ship.users.list()" live />

<div class="users">
  <h3>users</h3>

  {#if users().kind === 'loading'}
    <p class="muted">loading…</p>
  {:else if users().kind === 'error'}
    <p class="err">{users().error.message}</p>
  {:else}
    <p>{users().value.items.length} user{users().value.items.length === 1 ? '' : 's'}</p>
    <ul>
      {#for u of users().value.items key={u.id}}
        <li>{u.name}</li>
      {/for}
    </ul>
  {/if}
</div>
