<!--
  Lesson 06 solved — one directive, one system.

  The trigger says WHEN (hover/press/loop/enter/exit), the body says WHAT
  (property: preset). Note the variety: rotate on the restock hint, scale
  on the trigger, pulse on the unread dot, translate-x on the panel,
  staggered rows, fade-out exits. Dismiss demonstrates exit-hold — the
  framework keeps the row in the tree until its animation finishes.
-->
<column gap="4">
  <row align="center" justify="between">
    <h3>Notifications</h3>
    <row gap="2" align="center">
      <button variant="ghost" size="sm" motion:hover={{ rotate: 'spring:bouncy' }} on:click={() => restock()}>Restock</button>
      <button variant="outline" tone="primary" size="sm"
              motion:hover={{ scale: 'spring:gentle' }}
              motion:press={{ scale: 'press' }}
              on:click={() => toggle()}>
        {open() ? 'Close tray' : 'Open tray'}
        {#if unread() > 0}
          <span sx="display:inline-block w:1_5 h:1_5 radius:full bg:destructive"
                motion:loop={{ scale: 'pulse' }}></span>
        {/if}
      </button>
    </row>
  </row>

  {#if open()}
    <column gap="2"
            motion:enter={{ opacity: 'fade', translate-x: 'spring:snappy' }}
            motion:exit={{ opacity: 'fade-out' }}>
      {#for n of notes() key={n.id}}
        <row gap="3" align="center" sx="p:3 bg:surface-1 border:border-subtle radius:md"
             motion:enter={{ opacity: 'fade', translate-x: 'spring:gentle', stagger: '50ms' }}
             motion:exit={{ opacity: 'fade-out' }}>
          <badge tone={n.tone} variant="soft" size="sm">{n.kind}</badge>
          <p sx="grow:1 text:sm">{n.text}</p>
          <button variant="ghost" size="sm" on:click={() => dismiss(n.id)}>Dismiss</button>
        </row>
      {/for}
      {#if notes().length === 0}
        <p sx="p:3 text:sm fg:muted-foreground" motion:enter={{ opacity: 'fade' }}>All clear.</p>
      {/if}
    </column>
  {/if}
</column>
