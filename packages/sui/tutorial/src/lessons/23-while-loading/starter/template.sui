<prop name="shadow" type="bool" default="false" />

<data name="users" source="ship.users.list()" live />

<div class="users">
  <h3>users</h3>

  {#while-loading of users}
    <p class="muted">loading…</p>
  {/while-loading}

  {#while-error err of users}
    <p class="err">{err.message}</p>
  {/while-error}

  {#if users().kind === 'ok'}
    <p>{users().value.items.length} user{users().value.items.length === 1 ? '' : 's'}</p>
    <ul>
      {#for u of users().value.items key={u.id}}<li>{u.name}</li>{/for}
    </ul>
  {/if}
</div>
