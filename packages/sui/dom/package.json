{
  "name": "@ship/sui-dom",
  "version": "0.2.0",
  "description": "SUI DOM interpreter — parses .sui files and hydrates them against @ship/sui-runtime.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils/compile-sui.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
