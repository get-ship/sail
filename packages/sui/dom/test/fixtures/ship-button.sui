<component>{
  props: {
    tone: 'default' | 'primary',
    disabled: false,
    loading: false,
    label: '',
  },
}</component>
<button class="button" data-test="root" disabled={disabled() || loading()} aria-busy={loading() ? 'true' : 'false'} aria-label={label()}>
  <span class="content" data-test="label">{label()}</span>
  {#if loading()}
    <span class="spinner" data-test="spinner" aria-hidden="true"></span>
  {/if}
</button>
