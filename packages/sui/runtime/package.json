{
  "name": "@ship/sui-runtime",
  "version": "0.2.0",
  "description": "SUI runtime \u2014 fine-grained signals, custom-element wrapper, patch protocol applicator. The reactive engine that templates and components share.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./src/index.ts",
      "bun": "./src/index.ts",
      "module": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "require": "./src/server.ts",
      "bun": "./src/server.ts",
      "module": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./template-hooks": {
      "types": "./src/template-hooks/index.ts",
      "require": "./src/template-hooks/index.ts",
      "bun": "./src/template-hooks/index.ts",
      "module": "./src/template-hooks/index.ts",
      "default": "./dist/template-hooks/index.js"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "require": "./src/dev.ts",
      "bun": "./src/dev.ts",
      "module": "./src/dev.ts",
      "default": "./dist/dev.js"
    },
    "./route": {
      "types": "./src/route/index.ts",
      "require": "./src/route/index.ts",
      "bun": "./src/route/index.ts",
      "module": "./src/route/index.ts",
      "default": "./dist/route/index.js"
    },
    "./patch": {
      "types": "./src/patch.ts",
      "require": "./src/patch.ts",
      "bun": "./src/patch.ts",
      "module": "./src/patch.ts",
      "default": "./dist/patch.js"
    },
    "./virtual": {
      "types": "./src/virtual.ts",
      "require": "./src/virtual.ts",
      "bun": "./src/virtual.ts",
      "module": "./src/virtual.ts",
      "default": "./dist/virtual.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "dependencies": {},
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "@tanstack/virtual-core": "^3.16.1",
    "@vitest/browser": "^4.1.5",
    "axe-core": "^4.11.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
