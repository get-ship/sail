<prop name="title" type="string" default="" />
<prop name="body" type="string" default="" />
<prop name="tags" type="string" default="[]" />

<div>
  <span data-testid="title">{title()}</span>
  <button data-testid="toggle" on:click={() => expanded.set(!expanded())}>toggle</button>
  {#if expanded()}
    <div data-testid="body">{body()}</div>
    <ul data-testid="tags">
      {#for tag of parsedTags() key={tag}}
        <li>{tag}</li>
      {/for}
    </ul>
  {/if}
</div>
