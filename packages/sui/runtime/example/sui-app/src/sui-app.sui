<!--
  <sui-app> — single-component sanity-check demo.

  Goal: exercise the common authoring primitives in one screen so a
  smoke-pass against a fresh sui-runtime build either looks/feels
  right or doesn't. Not a benchmark, not a product — just a place
  to click around.

  What's here:
    - signal/derived: counter at the top, ticks-per-second derived
    - effect: 250ms tick keeps a sparkline-ish log moving
    - bindFor + keyed reorder: kanban-ish board with HTML5 DnD
    - bindClass: per-card "high-priority" + selected highlight
    - on: handlers, including async one (chrome.modal not used —
      standalone build has no daemon)
    - transition: enter/leave on card add/remove (fade + scale)
    - update() callback exercise: the chaos button mutates the row
      list, which forces bindFor through the diff path the per-field
      gating + monotone fast-path optimize.
-->

<component>{
  props: {
    shadow: false,
  },
}</component>
<div class="wrap">
  <header>
    <div>
      <h1>SUI sanity-check</h1>
      <p>standalone — no daemon, no shell, no view-host</p>
    </div>
    <div class="row">
      <div class="counter">ticks <strong>{ticks()}</strong></div>
      <div class="counter">{tickRate()}/s</div>
    </div>
  </header>

  <section>
    <h2>Counter + derived</h2>
    <div class="row">
      <div class="counter">count <strong>{count()}</strong></div>
      <div class="counter">×2 <strong>{doubled()}</strong></div>
      <button on:click={() => bump(1)}>+1</button>
      <button on:click={() => bump(-1)}>−1</button>
      <button on:click={() => bump(10)}>+10</button>
      <button class="danger" on:click={() => reset()}>reset</button>
    </div>
  </section>

  <section>
    <h2>Live tick log (effect re-fires each tick)</h2>
    <div class="ticks">
      {#for row of recentTicks() key={row.id}}
        <div class="ticks-row" class:fresh={row.id === ticks()} class:warn={row.id % 7 === 0}>
          tick {row.id} @ {row.label}
        </div>
      {/for}
    </div>
  </section>

  <section>
    <h2>Kanban — bindFor + DnD + transitions</h2>
    <div class="row" style="margin-bottom:12px">
      <div class="stat">{totalCards()} cards</div>
      <button on:click={() => addRandom()}>+ add</button>
      <button class="primary" on:click={() => chaos()}>chaos × 20</button>
      <button class="danger" on:click={() => resetBoard()}>reset board</button>
    </div>
    <div class="cols">
      {#for col of columns() key={col.id}}
        <section class="col" attr:data-col={col.id}>
          <div class="col-head">
            <span class="dot" attr:style={'background:' + col.tone}></span>
            <span>{col.title}</span>
            <span class="stat">({col.cards.length})</span>
          </div>
          <ol class="cards" attr:data-col-cards={col.id}
              on:dragover|preventDefault={(e) => onDragOver(e)}
              on:drop|preventDefault={(e) => onDrop(e, col.id, null)}>
            {#for card of col.cards key={card.id}}
              <li class="card"
                  attr:data-card={card.id}
                  draggable="true"
                  in:scale={{ from: 0.9, duration: 160 }}
                  out:fade={{ duration: 120 }}
                  on:dragstart={(e) => onDragStart(e, card.id)}
                  on:dragend={onDragEnd}
                  on:dragover|preventDefault|stopPropagation={(e) => onDragOver(e)}
                  on:drop|preventDefault|stopPropagation={(e) => onDrop(e, col.id, card.id)}>
                <div class="title">
                  {card.title}
                  {#if card.priority === 'high'}
                    <span class="pill high">high</span>
                  {:else if card.priority === 'low'}
                    <span class="pill low">low</span>
                  {/if}
                </div>
                <div class="meta">owner: {card.owner} · #{card.id}</div>
              </li>
            {/for}
            {#if col.cards.length === 0}
              <li class="card" style="border-style:dashed;cursor:default;text-align:center;color:var(--muted)">
                drop a card
              </li>
            {/if}
          </ol>
        </section>
      {/for}
    </div>
  </section>
</div>
