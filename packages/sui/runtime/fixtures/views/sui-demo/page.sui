<div data-demo="true">
  <h1>SUI Demo</h1>
  <p>Visual sanity-check for the SUI component bundle.</p>

  <section>
    <h2>button — solid</h2>
    <button solid>Default</button>
    <button solid primary>Primary</button>
    <button solid success>Success</button>
    <button solid warning>Warning</button>
    <button solid destructive>Destructive</button>
    <button solid info>Info</button>
  </section>

  <section>
    <h2>button — soft</h2>
    <button soft>Default</button>
    <button soft primary>Primary</button>
    <button soft success>Success</button>
    <button soft destructive>Destructive</button>
  </section>

  <section>
    <h2>button — outline</h2>
    <button outline primary>Primary</button>
    <button outline success>Success</button>
    <button outline destructive>Destructive</button>
  </section>

  <section>
    <h2>button — ghost</h2>
    <button ghost primary>Primary</button>
    <button ghost destructive>Destructive</button>
  </section>

  <section>
    <h2>button — sizes</h2>
    <button solid primary sm>Small</button>
    <button solid primary md>Medium</button>
    <button solid primary lg>Large</button>
  </section>

  <section>
    <h2>button — states</h2>
    <button solid primary disabled>Disabled</button>
    <button solid primary disabled aria-busy="true"><spinner size="sm"></spinner> Loading</button>
  </section>

  <section>
    <h2>sui-badge (dissolved to bare span + sx)</h2>
    <span tone="default" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-tone-bg border border-tone-border text-tone-fg">default</span>
    <span tone="primary" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-tone-bg border border-tone-border text-tone-fg">primary</span>
    <span tone="success" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-tone-bg border border-tone-border text-tone-fg">success</span>
    <span tone="warning" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-tone border border-tone text-tone-contrast">warning solid</span>
    <span tone="info" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-transparent border border-tone-border text-tone-fg">info outline</span>
    <span tone="destructive" sx="min-h-control-h-2xs px-2 text-xs font-semibold rounded-sm bg-tone border border-tone text-tone-contrast">destructive</span>
  </section>

  <section>
    <h2>sui-card</h2>
    <card>
      <h3 slot="header">Card title</h3>
      <p>Card body content lives in the default slot.</p>
      <div slot="footer"><button solid primary>Action</button></div>
    </card>
  </section>
</div>
