<div class="demo">
  <h1>SUI Demo</h1>
  <p>Visual sanity-check for the SUI component bundle.</p>

  <section>
    <h2>sui-button — solid</h2>
    <sui-button variant="solid">Default</sui-button>
    <sui-button variant="solid" tone="primary">Primary</sui-button>
    <sui-button variant="solid" tone="success">Success</sui-button>
    <sui-button variant="solid" tone="warning">Warning</sui-button>
    <sui-button variant="solid" tone="destructive">Destructive</sui-button>
    <sui-button variant="solid" tone="info">Info</sui-button>
  </section>

  <section>
    <h2>sui-button — soft</h2>
    <sui-button variant="soft">Default</sui-button>
    <sui-button variant="soft" tone="primary">Primary</sui-button>
    <sui-button variant="soft" tone="success">Success</sui-button>
    <sui-button variant="soft" tone="destructive">Destructive</sui-button>
  </section>

  <section>
    <h2>sui-button — outline</h2>
    <sui-button variant="outline" tone="primary">Primary</sui-button>
    <sui-button variant="outline" tone="success">Success</sui-button>
    <sui-button variant="outline" tone="destructive">Destructive</sui-button>
  </section>

  <section>
    <h2>sui-button — ghost</h2>
    <sui-button variant="ghost" tone="primary">Primary</sui-button>
    <sui-button variant="ghost" tone="destructive">Destructive</sui-button>
  </section>

  <section>
    <h2>sui-button — sizes</h2>
    <sui-button variant="solid" tone="primary" size="sm">Small</sui-button>
    <sui-button variant="solid" tone="primary" size="md">Medium</sui-button>
    <sui-button variant="solid" tone="primary" size="lg">Large</sui-button>
  </section>

  <section>
    <h2>sui-button — states</h2>
    <sui-button variant="solid" tone="primary" disabled>Disabled</sui-button>
    <sui-button variant="solid" tone="primary" loading>Loading</sui-button>
  </section>

  <section>
    <h2>sui-badge</h2>
    <sui-badge>default</sui-badge>
    <sui-badge tone="primary">primary</sui-badge>
    <sui-badge tone="success">success</sui-badge>
    <sui-badge tone="warning" variant="solid">warning solid</sui-badge>
    <sui-badge tone="info" variant="outline">info outline</sui-badge>
    <sui-badge tone="destructive" variant="solid">destructive</sui-badge>
  </section>

  <section>
    <h2>sui-card</h2>
    <sui-card>
      <h3 slot="header">Card title</h3>
      <p>Card body content lives in the default slot.</p>
      <div slot="footer"><sui-button variant="solid" tone="primary">Action</sui-button></div>
    </sui-card>
  </section>
</div>
