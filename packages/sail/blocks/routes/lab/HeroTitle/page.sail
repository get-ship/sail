<!--
  Lab canvas for HeroTitle. Mount only — not a template.
  Source of truth: src/blocks/HeroTitle/HeroTitle.sail
-->
<scope>
  style canvas = { pad(6) }
</scope>

<column gap="3" style(canvas)>
  <small>HeroTitle</small>
  <column gap="6">
    <h1>A fully featured React components and hooks library</h1>
    <p>Build fully functional accessible web applications with ease – Mantine includes more than 100 customizable components and hooks to cover you in any situation</p>
    <row gap="3">
      <button>Get started</button>
      <a href="https://github.com/mantinedev/mantine" variant="default">GitHub</a>
    </row>
  </column>
</column>
