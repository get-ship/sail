<!--
  HeaderSimple — brand, a few links, one action. Not a page.
-->
<navbar bordered>
  <strong slot="brand">Ship</strong>
  <row slot="center" gap="2">
    <a href="#">Features</a>
    <a href="#">Pricing</a>
    <a href="#">Learn</a>
    <a href="#">Community</a>
  </row>
  <button slot="actions" variant="ghost" size="icon" label="Toggle navigation">
    <icon name="menu"></icon>
  </button>
</navbar>
