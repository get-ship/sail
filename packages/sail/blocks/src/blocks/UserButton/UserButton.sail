<!--
  UserButton — avatar, name, email, as one control. Defaults only.
  Head-to-head: https://ui.mantine.dev/component/user-button/
  Recorded: Harriette Spoonlicker / hspoonlicker@outlook.com
-->
<button variant="ghost">
  <row align="center" gap="3" nowrap>
    <avatar
      src="https://raw.githubusercontent.com/mantinedev/mantine/master/.demo/avatars/avatar-8.png"
      name="Harriette Spoonlicker"
      initials="HS"
    ></avatar>
    <column>
      <strong>Harriette Spoonlicker</strong>
      <small>hspoonlicker@outlook.com</small>
    </column>
    <icon name="chevron-right" size="xs"></icon>
  </row>
</button>
