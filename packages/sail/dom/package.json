{
  "name": "@ship/sail-dom",
  "version": "0.3.0",
  "description": "SAIL DOM interpreter \u2014 parses .sail files and hydrates them against @ship/sail-runtime.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./test/compile-sail.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sail-runtime": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
