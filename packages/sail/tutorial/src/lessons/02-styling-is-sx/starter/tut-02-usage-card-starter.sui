<!--
  Lesson 02 starter — the structure is right, the surface is bare.

  Style this usage card with sx alone: spacing (p/px/py), color tokens
  (bg/fg), radius, border, shadow, type (text/weight/tracking), and the
  state prefixes hover: / focus-within: / current:. Raw values (px, hex)
  do not compile — every sx value is a token from a closed list.
-->
<column gap="4">
  <row gap="1">
    <!-- current: styles whichever pill carries aria-current="page".
         Style all three pills once; let the attribute pick the active one. -->
    <a href="#usage" aria-current="page">Usage</a>
    <a href="#billing">Billing</a>
    <a href="#limits">Limits</a>
  </row>

  <!-- Make this a card: surface bg, border, radius, padding, and a
       hover: shadow lift. -->
  <column gap="3">
    <row align="center" justify="between">
      <strong>Compute hours</strong>
      <small>renews in 12 days</small>
    </row>
    <row gap="2" align="end">
      <strong>412</strong>
      <small>of 500 hrs</small>
    </row>
    <p>Burst capacity unlocks automatically over 90% usage.</p>
    <!-- focus-within: should light this row's border up when the input
         has focus. -->
    <row gap="2" align="center">
      <input placeholder="Set a usage alert (hours)" size="sm" />
      <button size="sm" variant="outline" tone="primary">Notify me</button>
    </row>
  </column>
</column>
