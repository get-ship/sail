{
  "name": "@ship/sail-runtime",
  "version": "0.3.0",
  "description": "SAIL runtime \u2014 fine-grained signals, custom-element wrapper, patch protocol applicator. The reactive engine that templates and components share.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./src/server.ts"
    },
    "./template-hooks": {
      "types": "./dist/template-hooks/index.d.ts",
      "default": "./src/template-hooks/index.ts"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./src/dev.ts"
    },
    "./route": {
      "types": "./dist/route/index.d.ts",
      "default": "./src/route/index.ts"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "default": "./src/patch.ts"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./src/virtual.ts"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./src/internal.ts"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./src/contracts.ts"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./src/actions/index.ts"
    },
    "./framework": {
      "types": "./dist/framework-bundle.d.ts",
      "default": "./src/framework-bundle.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ship/tokens": "workspace:*",
    "motion": "^12.42.2",
    "motion-dom": "^12.42.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@ship/test-setup": "workspace:*",
    "@tanstack/virtual-core": "^3.16.1",
    "@vitest/browser": "^4.1.5",
    "axe-core": "^4.11.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  },
  "sideEffects": [
    "./src/boundary-elements.ts"
  ]
}
