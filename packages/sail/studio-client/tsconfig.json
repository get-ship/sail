{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/**/*.ts",
    "test/type-errors.ts",
    "test/surface-roundtrip-types.ts"
  ],
  "exclude": ["test/**/*.test.ts"]
}
