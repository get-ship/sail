{
  "name": "@ship/tokens",
  "version": "0.3.0",
  "description": "Ship design tokens \u2014 the OKLCH palette, semantic surfaces, tone ramps, role tokens, motion/density channels, and the theme catalog. The design substrate every view and <sail-*> component consumes. Depends on nothing downstream.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./src/themes.ts"
    },
    "./qa-themes": "./src/qa-themes.ts",
    "./unions": {
      "types": "./dist/generated/unions.d.ts",
      "default": "./src/generated/unions.ts"
    },
    "./themes-meta": {
      "types": "./dist/generated/themes-meta.d.ts",
      "default": "./src/generated/themes-meta.ts"
    },
    "./theme-schema": {
      "types": "./dist/theme-schema.d.ts",
      "default": "./src/theme-schema.ts"
    },
    "./themes.css": "./src/themes.css",
    "./tokens.css": "./src/tokens.css",
    "./token-registry.json": "./src/token-registry.json",
    "./sail-base.css": "./src/sail-base.css",
    "./element-skins.css": "./src/element-skins.css",
    "./products.css": "./src/products.css"
  },
  "files": [
    "src",
    "model"
  ],
  "scripts": {
    "generate": "cargo run -p sail-compiler -- tokens",
    "tokens:build": "cargo run -p sail-compiler -- tokens",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
