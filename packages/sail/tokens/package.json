{
  "name": "@ship/tokens",
  "version": "0.2.0",
  "description": "Ship design tokens — the OKLCH palette, semantic surfaces, tone ramps, role tokens, motion/density channels, and the theme catalog. The design substrate every view and <sail-*> component consumes. Depends on nothing downstream.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./themes": "./src/themes.ts",
    "./unions": "./src/generated/unions.ts",
    "./themes.css": "./src/themes.css",
    "./tokens.css": "./src/tokens.css",
    "./token-registry.json": "./src/token-registry.json",
    "./sail-base.css": "./src/sail-base.css",
    "./contracts.css": "./src/sail-base.css",
    "./element-skins.css": "./src/element-skins.css"
  },
  "files": [
    "src",
    "model"
  ],
  "scripts": {
    "generate": "cargo run -p sail-compiler -- tokens",
    "tokens:build": "cargo run -p sail-compiler -- tokens",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
