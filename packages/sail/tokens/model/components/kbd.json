{
  "$description": "Kbd component tokens (keycap chip). Defaults alias globals; themes may override component.kbd.* only.",
  "component": {
    "kbd": {
      "bg": {
        "$value": "{color.muted.default}",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      }
    }
  }
}
