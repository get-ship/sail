{
  "$description": "Dropdown component tokens. Defaults alias global design values; themes may override component.dropdown.* only.",
  "component": {
    "dropdown": {
      "bg": {
        "$value": "{color.background}",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      }
    }
  }
}
