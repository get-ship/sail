{
  "$description": "Toggle component tokens (rest paint). Defaults alias globals; themes may override component.toggle.* only.",
  "component": {
    "toggle": {
      "bg": {
        "$value": "{color.background}",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      }
    }
  }
}
