{
  "$description": "Field component tokens. Defaults alias global design values; themes may override component.field.* only.",
  "component": {
    "field": {
      "hint": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "field-hint"
          }
        }
      },
      "error": {
        "$value": "{color.destructive.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "field-error"
          }
        }
      }
    }
  }
}
