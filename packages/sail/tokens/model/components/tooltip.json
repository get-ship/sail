{
  "$description": "Tooltip bubble tokens. Inverted PE aliases globals. Motion delays stay under motion.tooltip.*.",
  "component": {
    "tooltip": {
      "bg": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "tooltip"
          }
        }
      },
      "fg": {
        "$value": "{color.background}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "tooltip-foreground"
          }
        }
      }
    }
  }
}
