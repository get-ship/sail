{
  "$description": "Empty-state component tokens. Defaults alias muted surface ramp; title aliases foreground for contrast.",
  "component": {
    "empty-state": {
      "bg": {
        "$value": "{muted}",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      },
      "title": {
        "$value": "{color.foreground}",
        "$type": "color"
      }
    }
  }
}
