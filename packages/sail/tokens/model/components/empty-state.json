{
  "$description": "Empty-state component tokens. Defaults alias muted surface ramp.",
  "component": {
    "empty-state": {
      "bg": {
        "$value": "{muted}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "empty-state"
          }
        }
      },
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "empty-state-foreground"
          }
        }
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "empty-state-border"
          }
        }
      }
    }
  }
}
