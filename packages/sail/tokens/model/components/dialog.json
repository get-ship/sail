{
  "$description": "Dialog component tokens (panel shell). Defaults alias globals; themes may override component.dialog.* only.",
  "component": {
    "dialog": {
      "bg": {
        "$value": "{color.surface.1}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog"
          }
        }
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog-foreground"
          }
        }
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog-border"
          }
        }
      },
      "divider": {
        "$value": "{color.border.subtle}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog-divider"
          }
        }
      },
      "footer": {
        "$value": "{color.muted.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog-footer"
          }
        }
      },
      "muted-fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "dialog-muted-foreground"
          }
        }
      }
    }
  }
}
