{
  "$description": "Dialog component tokens (panel shell). Defaults alias globals; themes may override component.dialog.* only.",
  "component": {
    "dialog": {
      "bg": {
        "$value": "{color.surface.1}",
        "$type": "color"
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color"
      },
      "border": {
        "$type": "border",
        "$value": {
          "color": "{color.border.default}",
          "width": "{color.border.width}",
          "style": "solid"
        }
      },
      "divider": {
        "$value": "{color.border.subtle}",
        "$type": "color"
      },
      "footer": {
        "$value": "{color.muted.default}",
        "$type": "color"
      },
      "muted-fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color"
      }
    }
  }
}
