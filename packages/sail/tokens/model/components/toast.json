{
  "$description": "Toast component tokens. Defaults alias globals; themes may override component.toast.* only. Default start-stripe aliases foreground; tone matrices still spend the semantic palette.",
  "component": {
    "toast": {
      "bg": {
        "$value": "{color.background}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "toast"
          }
        }
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "toast-foreground"
          }
        }
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "toast-border"
          }
        }
      },
      "stripe": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "toast-stripe"
          }
        }
      }
    }
  }
}
