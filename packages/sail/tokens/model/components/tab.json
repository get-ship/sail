{
  "$description": "Tab component tokens (idle/selected paint). Defaults alias globals; themes may override component.tab.* only. Line selected rail still spends primary (brand).",
  "component": {
    "tab": {
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color"
      },
      "selected-fg": {
        "$value": "{color.foreground}",
        "$type": "color"
      },
      "selected-bg": {
        "$value": "{color.background}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      }
    }
  }
}
