{
  "$description": "Tab component tokens (idle/selected paint). Defaults alias globals; themes may override component.tab.* only.",
  "component": {
    "tab": {
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "tab-foreground"
          }
        }
      },
      "selected-fg": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "tab-selected-foreground"
          }
        }
      },
      "selected-bg": {
        "$value": "{color.background}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "tab-selected"
          }
        }
      }
    }
  }
}
