{
  "$description": "Tab-list component tokens (strip chrome). Defaults alias globals; themes may override component.tab-list.* only.",
  "component": {
    "tab-list": {
      "bg": {
        "$value": "{color.background}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      },
      "rail": {
        "$value": "{color.muted.default}",
        "$type": "color"
      }
    }
  }
}
