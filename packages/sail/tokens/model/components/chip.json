{
  "$description": "Chip component tokens. Default solid aliases muted secondary (shadcn Badge parity); tone=primary etc. still ride tone channels.",
  "component": {
    "chip": {
      "bg": {
        "$value": "{muted}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "chip"
          }
        }
      },
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "chip-foreground"
          }
        }
      },
      "border": {
        "$value": "{border}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "chip-border"
          }
        }
      }
    }
  }
}
