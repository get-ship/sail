{
  "$description": "Navbar component tokens. Defaults alias global design values; themes may override component.navbar.* only.",
  "component": {
    "navbar": {
      "bg": {
        "$value": "{color.background}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "navbar"
          }
        }
      },
      "fg": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "navbar-foreground"
          }
        }
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "navbar-border"
          }
        }
      }
    }
  }
}
