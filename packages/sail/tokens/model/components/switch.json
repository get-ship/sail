{
  "$description": "Switch component tokens (track/thumb rest paint). Defaults alias globals; themes may override component.switch.* only.",
  "component": {
    "switch": {
      "track": {
        "$value": "{color.muted.default}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.strong}",
        "$type": "color"
      },
      "thumb": {
        "$value": "{color.surface.1}",
        "$type": "color"
      }
    }
  }
}
