{
  "$description": "Badge component tokens. Soft default PE aliases muted tone ramp; themes may override component.badge.* only.",
  "component": {
    "badge": {
      "bg": {
        "$value": "{muted}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "badge"
          }
        }
      },
      "fg": {
        "$value": "{color.muted.foreground}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "badge-foreground"
          }
        }
      },
      "border": {
        "$value": "{border}",
        "$type": "color",
        "$extensions": {
          "ship": {
            "cssName": "badge-border"
          }
        }
      }
    }
  }
}
