{
  "$description": "Meter component tokens (track + optimum bands). Defaults alias globals; themes may override component.meter.* only.",
  "component": {
    "meter": {
      "track": {
        "$value": "{color.muted.default}",
        "$type": "color"
      },
      "optimum": {
        "$value": "{color.success.default}",
        "$type": "color"
      },
      "suboptimum": {
        "$value": "{color.warning.default}",
        "$type": "color"
      },
      "sub-suboptimum": {
        "$value": "{color.destructive.default}",
        "$type": "color"
      }
    }
  }
}
