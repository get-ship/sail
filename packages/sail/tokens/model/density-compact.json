{
  "$description": "Density overrides for data-density=compact.",
  "density": {
    "row-py": {
      "$value": "4px",
      "$type": "dimension",
      "$extensions": {
        "ship": {
          "cssName": "density-row-py"
        }
      }
    },
    "row-px": {
      "$value": "8px",
      "$type": "dimension",
      "$extensions": {
        "ship": {
          "cssName": "density-row-px"
        }
      }
    },
    "row-gap": {
      "$value": "6px",
      "$type": "dimension",
      "$extensions": {
        "ship": {
          "cssName": "density-row-gap"
        }
      }
    },
    "text": {
      "$value": "{text-sm}",
      "$type": "dimension",
      "$extensions": {
        "ship": {
          "cssName": "density-text"
        }
      }
    },
    "icon": {
      "$value": "14px",
      "$type": "dimension",
      "$extensions": {
        "ship": {
          "cssName": "density-icon"
        }
      }
    },
    "$type": "dimension"
  },
  "$extensions": {
    "ship": {
      "selector": ":root[data-density='compact']",
      "layer": "density-compact"
    }
  }
}
