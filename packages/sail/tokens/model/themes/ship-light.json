{
  "$description": "Canonical SHIP light (base is mostly complete; personality overrides).",
  "$extensions": {
    "ship": {
      "layer": "theme",
      "themeId": "ship-light",
      "dark": false,
      "selector": ":root[data-theme='ship-light'],\n[data-theme-preview='ship-light']"
    }
  },
  "color": {
    "brandAccent": {
      "default": {
        "$value": "oklch(0.61 0.23 303)",
        "$extensions": {
          "ship": {
            "cssName": "accent"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.98 0.02 301)",
        "$extensions": {
          "ship": {
            "cssName": "accent-foreground"
          }
        },
        "$type": "color"
      }
    },
    "background": {
      "$value": "oklch(0.975 0.002 106.423)",
      "$extensions": {
        "ship": {
          "cssName": "background"
        }
      },
      "$type": "color"
    },
    "border": {
      "default": {
        "$value": "oklch(0.147 0.004 49.25 / 25%)",
        "$extensions": {
          "ship": {
            "cssName": "border"
          }
        },
        "$type": "color"
      }
    },
    "foreground": {
      "$value": "oklch(0.147 0.004 49.25)",
      "$extensions": {
        "ship": {
          "cssName": "foreground"
        }
      },
      "$type": "color"
    },
    "muted": {
      "default": {
        "$value": "oklch(0.95 0.003 106.424)",
        "$extensions": {
          "ship": {
            "cssName": "muted"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.40 0.02 58.071)",
        "$extensions": {
          "ship": {
            "cssName": "muted-foreground"
          }
        },
        "$type": "color"
      }
    },
    "primary": {
      "default": {
        "$value": "oklch(0.67 0.16 58)",
        "$extensions": {
          "ship": {
            "cssName": "primary"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.99 0.02 95)",
        "$extensions": {
          "ship": {
            "cssName": "primary-foreground"
          }
        },
        "$type": "color"
      }
    },
    "ring": {
      "default": {
        "$value": "oklch(0.67 0.16 58 / 40%)",
        "$extensions": {
          "ship": {
            "cssName": "ring"
          }
        },
        "$type": "color"
      }
    },
    "surface": {
      "overlay": {
        "$value": "none",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay"
          }
        },
        "$type": "string"
      },
      "overlay-blend": {
        "$value": "normal",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay-blend"
          }
        },
        "$type": "string"
      },
      "overlay-opacity": {
        "$value": "1",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay-opacity"
          }
        },
        "$type": "number"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "$value": "var(--font-body)",
        "$extensions": {
          "ship": {
            "cssName": "body-font"
          }
        },
        "$type": "fontFamily"
      }
    },
    "font": {
      "body": {
        "$value": "var(--font-sans, system-ui, sans-serif)",
        "$extensions": {
          "ship": {
            "cssName": "font-body"
          }
        },
        "$type": "fontFamily"
      }
    },
    "heading": {
      "font": {
        "$value": "var(--font-display, var(--font-body))",
        "$extensions": {
          "ship": {
            "cssName": "heading-font"
          }
        },
        "$type": "fontFamily"
      },
      "tracking": {
        "$value": "var(--tracking-tight)",
        "$extensions": {
          "ship": {
            "cssName": "heading-tracking"
          }
        },
        "$type": "dimension"
      },
      "weight": {
        "$value": "var(--font-weight-semibold)",
        "$extensions": {
          "ship": {
            "cssName": "heading-weight"
          }
        },
        "$type": "number"
      }
    },
    "label": {
      "font": {
        "$value": "var(--font-body)",
        "$extensions": {
          "ship": {
            "cssName": "label-font"
          }
        },
        "$type": "fontFamily"
      },
      "tracking": {
        "$value": "0.08em",
        "$extensions": {
          "ship": {
            "cssName": "label-tracking"
          }
        },
        "$type": "dimension"
      },
      "weight": {
        "$value": "var(--font-weight-semibold)",
        "$extensions": {
          "ship": {
            "cssName": "label-weight"
          }
        },
        "$type": "number"
      }
    }
  },
  "radius": {
    "md": {
      "$value": "6px",
      "$extensions": {
        "ship": {
          "cssName": "radius-md"
        }
      },
      "$type": "dimension"
    },
    "sm": {
      "$value": "4px",
      "$extensions": {
        "ship": {
          "cssName": "radius-sm"
        }
      },
      "$type": "dimension"
    }
  },
  "shadow": {
    "accent": {
      "$value": "0 0 0 3px oklch(0.67 0.16 58 / 18%), 0 8px 24px -6px oklch(0.67 0.16 58 / 30%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-accent"
        }
      },
      "$type": "shadow"
    },
    "card-rest": {
      "$value": "0 1px 2px 0 oklch(0 0 0 / 4%), 0 0 0 1px oklch(0 0 0 / 3%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-card-rest"
        }
      },
      "$type": "shadow"
    },
    "hover": {
      "$value": "0 8px 22px -4px oklch(0.55 0.10 58 / 14%), 0 2px 6px oklch(0 0 0 / 6%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-hover"
        }
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 14px 32px -6px oklch(0.55 0.10 58 / 16%), 0 4px 12px oklch(0 0 0 / 8%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-lg"
        }
      },
      "$type": "shadow"
    },
    "md": {
      "$value": "0 6px 18px -4px oklch(0.55 0.10 58 / 12%), 0 2px 6px oklch(0 0 0 / 6%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-md"
        }
      },
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 2px 4px -1px oklch(0.55 0.10 58 / 9%), 0 1px 2px oklch(0 0 0 / 4%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-sm"
        }
      },
      "$type": "shadow"
    },
    "xs": {
      "$value": "0 1px 2px 0 oklch(0.55 0.10 58 / 6%), 0 0 0 1px oklch(0 0 0 / 3%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-xs"
        }
      },
      "$type": "shadow"
    }
  },
  "component": {
    "card": {
      "backdrop-filter": {
        "$value": "none",
        "$extensions": {
          "ship": {
            "cssName": "card-backdrop-filter"
          }
        },
        "$type": "string"
      },
      "texture": {
        "$value": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='c'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23c)' opacity='0.03'/%3E%3C/svg%3E\")",
        "$extensions": {
          "ship": {
            "cssName": "card-texture"
          }
        },
        "$type": "string"
      },
      "texture-blend": {
        "$value": "overlay",
        "$extensions": {
          "ship": {
            "cssName": "card-texture-blend"
          }
        },
        "$type": "string"
      },
      "texture-opacity": {
        "$value": "1",
        "$extensions": {
          "ship": {
            "cssName": "card-texture-opacity"
          }
        },
        "$type": "number"
      },
      "fg": {
        "$value": "oklch(0.147 0.004 49.25)",
        "$extensions": {
          "ship": {
            "cssName": "card-foreground"
          }
        },
        "$type": "color"
      },
      "bg": {
        "$value": "oklch(1 0 0)",
        "$extensions": {
          "ship": {
            "cssName": "card"
          }
        },
        "$type": "color"
      }
    }
  }
}
