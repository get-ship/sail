          "$type": "dimension"
        },
        "md": {
          "$value": "3px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "2px",
          "$type": "dimension"
        },
        "xl": {
          "$value": "6px",
          "$type": "dimension"
        }
      },
      "scrollbar": {
        "radius": {
          "$value": "4px",
          "$type": "dimension"
        },
        "thumb": {
          "$value": "color-mix(in oklab, var(--foreground) 50%, transparent)",
          "$type": "color"
        },
        "thumb-hover": {
          "$value": "{foreground}",
          "$type": "color"
        }
      },
      "shadow": {
        "accent": {
          "$value": "0 0 0 3px oklch(0.87 0.18 85 / 60%)",
          "$type": "shadow"
        },
        "hover": {
          "$value": "0 0 0 2px oklch(0.87 0.18 85 / 70%)",
          "$type": "shadow"
        },
        "lg": {
          "$value": "0 0 0 2px oklch(1 0 0 / 80%)",
          "$type": "shadow"
        },
        "md": {
          "$value": "0 0 0 1px oklch(1 0 0 / 75%)",
          "$type": "shadow"
        },
        "sm": {
          "$value": "0 0 0 1px oklch(1 0 0 / 65%)",
          "$type": "shadow"
        },
        "sticky": {
          "$value": "0 0 0 1px oklch(1 0 0 / 60%)",
          "$type": "shadow"
        },
        "xl": {
          "$value": "0 0 0 2px oklch(1 0 0 / 90%)",
          "$type": "shadow"
        },
        "xs": {
          "$value": "0 0 0 1px oklch(1 0 0 / 60%)",
          "$type": "shadow"
        }
