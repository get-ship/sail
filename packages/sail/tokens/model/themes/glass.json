{
  "$description": "Glass / frost. Light-only translucent wash. Weakest gallery, kept deliberately.",
  "$extensions": {
    "sail": {
      "layer": "theme",
      "themeId": "glass",
      "defaultMode": "light",
      "supportedModes": ["light"],
      "identity": "Translucent frost.",
      "variants": {
        "density": true,
        "contrast": true,
        "reducedMotion": true
      },
      "chrome": [
        {
          "selector": "body",
          "props": {
            "background-color": "oklch(0.97 0.005 240)",
            "background-image": "radial-gradient(ellipse 80% 60% at 0% 0%, oklch(0.92 0.05 220 / 18%), transparent 75%), radial-gradient(ellipse 75% 55% at 100% 100%, oklch(0.92 0.05 30 / 14%), transparent 75%), radial-gradient(ellipse 60% 45% at 100% 0%, oklch(0.93 0.04 300 / 10%), transparent 80%)",
            "background-attachment": "fixed"
          }
        },
        {
          "selector": "body",
          "media": "(prefers-reduced-motion: no-preference)",
          "props": { "animation": "glass-mesh 36s ease-in-out infinite alternate" }
        },
        {
          "keyframes": "glass-mesh",
          "frames": {
            "0%": { "background-position": "0% 0%, 100% 100%, 100% 0%" },
            "100%": { "background-position": "8% 4%, 92% 96%, 96% 4%" }
          }
        },
        {
          "selector": "sail-card, .sail-card",
          "props": {
            "border-image": "linear-gradient(135deg, oklch(0.62 0.14 280 / 50%), oklch(1 0 0 / 60%) 30%, oklch(0.62 0.16 50 / 50%) 70%, oklch(1 0 0 / 60%)) 1"
          }
        },
        {
          "selector": "h1, h2, [class*='heading']",
          "props": {
            "text-shadow": "0 1px 0 oklch(1 0 0 / 50%), 0 0 12px oklch(0.62 0.14 280 / 14%)"
          }
        },
        {
          "selector": "sail-card:hover, .sail-card:hover",
          "props": { "--filter-backdrop": "blur(32px) saturate(220%)" }
        }
      ]
    }
  },
  "anchors": {
    "light": {
      "primary": { "space": "oklch", "l": 0.55, "c": 0.16, "h": 50 },
      "accent": { "space": "oklch", "l": 0.55, "c": 0.14, "h": 280 },
      "secondary": { "space": "oklch", "l": 0.94, "c": 0.008, "h": 240 },
      "success": { "space": "oklch", "l": 0.62, "c": 0.14, "h": 152 },
      "warning": { "space": "oklch", "l": 0.72, "c": 0.15, "h": 75 },
      "info": { "space": "oklch", "l": 0.62, "c": 0.14, "h": 230 },
      "danger": { "space": "oklch", "l": 0.6, "c": 0.22, "h": 27 },
      "neutral": { "space": "oklch", "l": 0.94, "c": 0.008, "h": 240 }
    }
  },
  "modes": {
    "light": {
      "color": {
        "background": { "$value": { "space": "oklch", "l": 0.97, "c": 0.005, "h": 240 }, "$type": "color" },
        "foreground": { "$value": { "space": "oklch", "l": 0.22, "c": 0.02, "h": 250 }, "$type": "color" },
        "muted": {
          "default": { "$value": { "space": "oklch", "l": 0.94, "c": 0.008, "h": 240 }, "$type": "color" },
          "foreground": { "$value": { "space": "oklch", "l": 0.42, "c": 0.02, "h": 250 }, "$type": "color" }
        },
        "surface": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.55 }, "$type": "color" },
        "inset": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.28 }, "$type": "color" },
        "overlay": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.78 }, "$type": "color" },
        "border": {
          "default": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.22 }, "$type": "color" },
          "subtle": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.14 }, "$type": "color" },
          "strong": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0, "a": 0.36 }, "$type": "color" }
        }
      },
      "overlay": {
        "fill": { "$value": "none", "$type": "string" },
        "blend": { "$value": "normal", "$type": "string" },
        "opacity": { "$value": "1", "$type": "number" }
      },
      "radius": {
        "sm": { "$value": "8px", "$type": "dimension" },
        "md": { "$value": "12px", "$type": "dimension" },
        "default": { "$value": "14px", "$type": "dimension" },
        "lg": { "$value": "18px", "$type": "dimension" },
        "xl": { "$value": "24px", "$type": "dimension" }
      },
      "shadow": {
        "xs": { "$value": "0 1px 0 oklch(1 0 0 / 40%) inset, 0 2px 8px oklch(0.30 0.04 240 / 6%)", "$type": "shadow" },
        "sm": { "$value": "0 1px 0 oklch(1 0 0 / 50%) inset, 0 4px 12px oklch(0.30 0.04 240 / 8%)", "$type": "shadow" },
        "md": { "$value": "0 1px 0 oklch(1 0 0 / 50%) inset, 0 8px 24px oklch(0.30 0.04 240 / 10%)", "$type": "shadow" },
        "lg": { "$value": "0 1px 0 oklch(1 0 0 / 60%) inset, 0 16px 48px oklch(0.30 0.04 240 / 16%)", "$type": "shadow" },
        "xl": { "$value": "0 1px 0 oklch(1 0 0 / 60%) inset, 0 28px 72px oklch(0.30 0.04 240 / 22%)", "$type": "shadow" },
        "card-rest": { "$value": "0 1px 0 oklch(1 0 0 / 50%) inset, 0 6px 16px oklch(0.30 0.04 240 / 8%)", "$type": "shadow" },
        "hover": { "$value": "0 1px 0 oklch(1 0 0 / 60%) inset, 0 12px 32px oklch(0.30 0.04 240 / 14%)", "$type": "shadow" },
        "sticky": { "$value": "0 1px 0 oklch(1 0 0 / 50%) inset, 0 2px 8px oklch(0.30 0.04 240 / 8%)", "$type": "shadow" },
        "accent": { "$value": "0 1px 0 oklch(1 0 0 / 60%) inset, 0 8px 24px oklch(0.62 0.16 50 / 28%)", "$type": "shadow" },
        "edge-top": { "$value": "0 -1px 0 oklch(1 0 0 / 36%) inset", "$type": "shadow" }
      },
      "filter": { "backdrop": { "$value": "blur(24px) saturate(180%)", "$type": "string" } },
      "image": { "texture": { "$value": "none", "$type": "string" } },
      "interaction": {
        "hover": { "strength": { "$value": "5%", "$type": "number" } },
        "active": { "strength": { "$value": "9%", "$type": "number" } },
        "selected": { "strength": { "$value": "12%", "$type": "number" } }
      },
      "motion": {
        "duration": {
          "fast": { "$value": "160ms", "$type": "duration" },
          "medium": { "$value": "240ms", "$type": "duration" }
        }
      },
      "$extensions": { "sail": { "dark": false } }
    }
  }
}
