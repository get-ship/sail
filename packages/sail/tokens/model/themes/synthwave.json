{
  "$description": "Retro-future neon. Dark-only magenta/cyan night.",
  "$extensions": {
    "sail": {
      "layer": "theme",
      "themeId": "synthwave",
      "defaultMode": "dark",
      "supportedModes": ["dark"],
      "identity": "Synthwave is neon night: magenta and cyan on a purple field, horizon scanlines, and a hot glow.",
      "variants": {
        "density": true,
        "contrast": true,
        "reducedMotion": true
      }
    }
  },
  "anchors": {
    "dark": {
      "primary": { "space": "oklch", "l": 0.65, "c": 0.28, "h": 340 },
      "accent": { "space": "oklch", "l": 0.75, "c": 0.22, "h": 190 },
      "secondary": { "space": "oklch", "l": 0.3, "c": 0.06, "h": 285 },
      "success": { "space": "oklch", "l": 0.7, "c": 0.2, "h": 145 },
      "warning": { "space": "oklch", "l": 0.82, "c": 0.2, "h": 95 },
      "info": { "space": "oklch", "l": 0.7, "c": 0.18, "h": 230 },
      "danger": { "space": "oklch", "l": 0.6, "c": 0.26, "h": 25 },
      "neutral": { "space": "oklch", "l": 0.3, "c": 0.06, "h": 285 }
    }
  },
  "modes": {
    "dark": {
      "color": {
        "background": { "$value": { "space": "oklch", "l": 0.16, "c": 0.06, "h": 285 }, "$type": "color" },
        "foreground": { "$value": { "space": "oklch", "l": 0.95, "c": 0.02, "h": 100 }, "$type": "color" },
        "muted": {
          "default": { "$value": { "space": "oklch", "l": 0.3, "c": 0.06, "h": 285 }, "$type": "color" },
          "foreground": { "$value": { "space": "oklch", "l": 0.72, "c": 0.04, "h": 285 }, "$type": "color" }
        },
        "surface": { "$value": { "space": "oklch", "l": 0.22, "c": 0.08, "h": 285 }, "$type": "color" },
        "inset": { "$value": { "space": "oklch", "l": 0.95, "c": 0.05, "h": 320, "a": 0.08 }, "$type": "color" },
        "overlay": { "$value": { "space": "oklch", "l": 0.22, "c": 0.08, "h": 285 }, "$type": "color" },
        "border": {
          "default": { "$value": { "space": "oklch", "l": 0.95, "c": 0.05, "h": 320, "a": 0.3 }, "$type": "color" },
          "subtle": { "$value": { "space": "oklch", "l": 0.95, "c": 0.05, "h": 320, "a": 0.18 }, "$type": "color" },
          "strong": { "$value": { "space": "oklch", "l": 0.95, "c": 0.05, "h": 320, "a": 0.45 }, "$type": "color" }
        },
        "glow": {
          "primary": {
            "$type": "gradient",
            "$value": {
              "kind": "radial",
              "stops": [
                { "color": { "op": "mix", "from": { "ref": "primary" }, "onto": "transparent", "amount": 0.18 } },
                { "color": "transparent", "at": "60%" }
              ]
            }
          },
          "accent": {
            "$type": "gradient",
            "$value": {
              "kind": "radial",
              "stops": [
                { "color": { "op": "mix", "from": { "ref": "accent" }, "onto": "transparent", "amount": 0.18 } },
                { "color": "transparent", "at": "60%" }
              ]
            }
          }
        }
      },
      "overlay": {
        "fill": {
          "$value": "repeating-linear-gradient(0deg, transparent 0 23px, oklch(0.65 0.28 340 / 5%) 23px 24px, transparent 24px 47px, oklch(0.75 0.22 190 / 5%) 47px 48px)",
          "$type": "string"
        },
        "blend": { "$value": "screen", "$type": "string" },
        "opacity": { "$value": "0.35", "$type": "number" }
      },
      "shadow": {
        "xs": { "$value": "0 1px 2px oklch(0.14 0.03 285 / 35%)", "$type": "shadow" },
        "sm": { "$value": "0 2px 4px oklch(0.14 0.03 285 / 35%), 0 1px 1px oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "md": { "$value": "0 4px 12px oklch(0.14 0.03 285 / 40%), 0 2px 2px oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "lg": { "$value": "0 8px 24px oklch(0.14 0.03 285 / 45%), 0 4px 4px oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "xl": { "$value": "0 16px 48px oklch(0.14 0.03 285 / 50%), 0 8px 8px oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "card-rest": { "$value": "0 4px 16px oklch(0.14 0.03 285 / 45%), 0 1px 1px oklch(0.14 0.03 285 / 20%)", "$type": "shadow" },
        "hover": { "$value": "0 8px 24px oklch(0.14 0.03 285 / 55%), 0 2px 2px oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "sticky": { "$value": "0 3px 10px -2px oklch(0.14 0.03 285 / 40%), 0 -1px 0 oklch(0.14 0.03 285 / 25%)", "$type": "shadow" },
        "accent": { "$value": "0 0 0 3px oklch(0.75 0.22 190 / 55%)", "$type": "shadow" },
        "inset-soft": { "$value": "inset 0 1px 2px oklch(0 0 0 / 15%)", "$type": "shadow" },
        "edge-top": { "$value": "0 -8px 24px -8px oklch(0.14 0.03 285 / 40%), 0 -1px 0 oklch(0.14 0.03 285 / 25%)", "$type": "shadow" }
      },
      "filter": { "backdrop": { "$value": "none", "$type": "string" } },
      "image": { "texture": { "$value": "none", "$type": "string" } },
      "control": {
        "lift": { "$value": "-2px", "$type": "dimension" },
        "press": {
          "scale": { "$value": "0.98", "$type": "number" },
          "translate": { "$value": "1px", "$type": "dimension" }
        }
      },
      "scrollbar": {
        "thumb": { "$value": "oklch(0.65 0.28 340)", "$type": "color" },
        "thumb-hover": { "$value": "oklch(0.75 0.22 190)", "$type": "color" }
      },
      "$extensions": { "sail": { "dark": true } }
    }
  }
}
