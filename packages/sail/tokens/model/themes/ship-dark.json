{
  "$description": "SHIP dark sibling \u2014 amber on warm navy.",
  "$extensions": {
    "ship": {
      "layer": "theme",
      "themeId": "ship-dark",
      "dark": true,
      "selector": ":root[data-theme='ship-dark'],\n[data-theme-preview='ship-dark']"
    }
  },
  "color": {
    "brandAccent": {
      "default": {
        "$value": "oklch(0.3 0.05 300)",
        "$extensions": {
          "ship": {
            "cssName": "accent"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.9 0.02 300)",
        "$extensions": {
          "ship": {
            "cssName": "accent-foreground"
          }
        },
        "$type": "color"
      }
    },
    "background": {
      "$value": "oklch(0.158 0.012 250)",
      "$extensions": {
        "ship": {
          "cssName": "background"
        }
      },
      "$type": "color"
    },
    "border": {
      "default": {
        "$value": "oklch(1 0 0 / 12%)",
        "$extensions": {
          "ship": {
            "cssName": "border"
          }
        },
        "$type": "color"
      },
      "strong": {
        "$value": "oklch(1 0 0 / 22%)",
        "$extensions": {
          "ship": {
            "cssName": "border-strong"
          }
        },
        "$type": "color"
      },
      "subtle": {
        "$value": "oklch(1 0 0 / 8%)",
        "$extensions": {
          "ship": {
            "cssName": "border-subtle"
          }
        },
        "$type": "color"
      }
    },
    "card": {
      "backdrop-filter": {
        "$value": "none",
        "$extensions": {
          "ship": {
            "cssName": "card-backdrop-filter"
          }
        },
        "$type": "string"
      },
      "foreground": {
        "$value": "oklch(0.98 0.001 106)",
        "$extensions": {
          "ship": {
            "cssName": "card-foreground"
          }
        },
        "$type": "color"
      },
      "texture": {
        "$value": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='c'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23c)' opacity='0.03'/%3E%3C/svg%3E\")",
        "$extensions": {
          "ship": {
            "cssName": "card-texture"
          }
        },
        "$type": "string"
      },
      "texture-blend": {
        "$value": "overlay",
        "$extensions": {
          "ship": {
            "cssName": "card-texture-blend"
          }
        },
        "$type": "string"
      },
      "texture-opacity": {
        "$value": "1",
        "$extensions": {
          "ship": {
            "cssName": "card-texture-opacity"
          }
        },
        "$type": "number"
      },
      "default": {
        "$value": "oklch(0.20 0.014 250)",
        "$extensions": {
          "ship": {
            "cssName": "card"
          }
        },
        "$type": "color"
      }
    },
    "foreground": {
      "$value": "oklch(0.98 0.001 106)",
      "$extensions": {
        "ship": {
          "cssName": "foreground"
        }
      },
      "$type": "color"
    },
    "muted": {
      "default": {
        "$value": "oklch(0.2 0.01 50)",
        "$extensions": {
          "ship": {
            "cssName": "muted"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.75 0.015 50)",
        "$extensions": {
          "ship": {
            "cssName": "muted-foreground"
          }
        },
        "$type": "color"
      }
    },
    "primary": {
      "default": {
        "$value": "oklch(0.77 0.16 70)",
        "$extensions": {
          "ship": {
            "cssName": "primary"
          }
        },
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(0.2 0.01 50)",
        "$extensions": {
          "ship": {
            "cssName": "primary-foreground"
          }
        },
        "$type": "color"
      }
    },
    "ring": {
      "default": {
        "$value": "oklch(0.77 0.16 70 / 30%)",
        "$extensions": {
          "ship": {
            "cssName": "ring"
          }
        },
        "$type": "color"
      }
    },
    "surface": {
      "0": {
        "$value": "oklch(0.14 0.012 250)",
        "$extensions": {
          "ship": {
            "cssName": "surface-0"
          }
        },
        "$type": "color"
      },
      "1": {
        "$value": "oklch(0.20 0.014 250)",
        "$extensions": {
          "ship": {
            "cssName": "surface-1"
          }
        },
        "$type": "color"
      },
      "2": {
        "$value": "oklch(0.24 0.014 50)",
        "$extensions": {
          "ship": {
            "cssName": "surface-2"
          }
        },
        "$type": "color"
      },
      "3": {
        "$value": "oklch(0.28 0.016 250)",
        "$extensions": {
          "ship": {
            "cssName": "surface-3"
          }
        },
        "$type": "color"
      },
      "overlay": {
        "$value": "none",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay"
          }
        },
        "$type": "string"
      },
      "overlay-blend": {
        "$value": "normal",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay-blend"
          }
        },
        "$type": "string"
      },
      "overlay-opacity": {
        "$value": "1",
        "$extensions": {
          "ship": {
            "cssName": "surface-overlay-opacity"
          }
        },
        "$type": "number"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "$value": "var(--font-body)",
        "$extensions": {
          "ship": {
            "cssName": "body-font"
          }
        },
        "$type": "fontFamily"
      }
    },
    "font": {
      "body": {
        "$value": "var(--font-sans, system-ui, sans-serif)",
        "$extensions": {
          "ship": {
            "cssName": "font-body"
          }
        },
        "$type": "fontFamily"
      }
    },
    "heading": {
      "font": {
        "$value": "var(--font-display, var(--font-body))",
        "$extensions": {
          "ship": {
            "cssName": "heading-font"
          }
        },
        "$type": "fontFamily"
      },
      "tracking": {
        "$value": "var(--tracking-tight)",
        "$extensions": {
          "ship": {
            "cssName": "heading-tracking"
          }
        },
        "$type": "dimension"
      },
      "weight": {
        "$value": "var(--font-weight-semibold)",
        "$extensions": {
          "ship": {
            "cssName": "heading-weight"
          }
        },
        "$type": "number"
      }
    },
    "label": {
      "font": {
        "$value": "var(--font-body)",
        "$extensions": {
          "ship": {
            "cssName": "label-font"
          }
        },
        "$type": "fontFamily"
      },
      "tracking": {
        "$value": "var(--tracking-normal)",
        "$extensions": {
          "ship": {
            "cssName": "label-tracking"
          }
        },
        "$type": "dimension"
      },
      "weight": {
        "$value": "var(--font-weight-semibold)",
        "$extensions": {
          "ship": {
            "cssName": "label-weight"
          }
        },
        "$type": "number"
      }
    }
  },
  "misc": {
    "card": {
      "$value": "oklch(0.205 0.012 250)",
      "$extensions": {
        "ship": {
          "cssName": "card"
        }
      },
      "$type": "color"
    }
  },
  "radius": {
    "md": {
      "$value": "6px",
      "$extensions": {
        "ship": {
          "cssName": "radius-md"
        }
      },
      "$type": "dimension"
    },
    "sm": {
      "$value": "4px",
      "$extensions": {
        "ship": {
          "cssName": "radius-sm"
        }
      },
      "$type": "dimension"
    }
  },
  "interaction": {
    "selected": {
      "strength": {
        "$value": "18%",
        "$extensions": {
          "ship": {
            "cssName": "selected-strength"
          }
        },
        "$type": "number"
      }
    }
  },
  "shadow": {
    "accent": {
      "$value": "0 0 0 3px oklch(0.77 0.16 70 / 22%), 0 8px 24px -6px oklch(0.77 0.16 70 / 38%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-accent"
        }
      },
      "$type": "shadow"
    },
    "card-rest": {
      "$value": "0 1px 2px 0 oklch(0.05 0.02 250 / 35%), 0 0 0 1px oklch(1 0 0 / 4%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-card-rest"
        }
      },
      "$type": "shadow"
    },
    "hover": {
      "$value": "0 8px 22px -4px oklch(0.10 0.04 250 / 50%), 0 2px 6px oklch(0 0 0 / 35%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-hover"
        }
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 14px 32px -6px oklch(0.10 0.04 250 / 60%), 0 4px 12px oklch(0 0 0 / 40%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-lg"
        }
      },
      "$type": "shadow"
    },
    "md": {
      "$value": "0 6px 18px -4px oklch(0.10 0.04 250 / 55%), 0 2px 6px oklch(0 0 0 / 35%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-md"
        }
      },
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 2px 6px -1px oklch(0.10 0.04 250 / 50%), 0 0 0 1px oklch(1 0 0 / 4%)",
      "$extensions": {
        "ship": {
          "cssName": "shadow-sm"
        }
      },
      "$type": "shadow"
    }
  }
}
