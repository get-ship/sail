{
  "$description": "Neo-brutalist. Light-only hard edges and high ink.",
  "$extensions": {
    "sail": {
      "layer": "theme",
      "themeId": "brut",
      "defaultMode": "light",
      "supportedModes": ["light"],
      "identity": "Hard edges, high ink.",
      "variants": {
        "density": true,
        "contrast": true,
        "reducedMotion": true
      }
    }
  },
  "anchors": {
    "light": {
      "primary": { "space": "oklch", "l": 0.14, "c": 0, "h": 0 },
      "accent": { "space": "oklch", "l": 0.55, "c": 0.24, "h": 28 },
      "secondary": { "space": "oklch", "l": 0.92, "c": 0, "h": 0 },
      "success": { "space": "oklch", "l": 0.48, "c": 0.18, "h": 145 },
      "warning": { "space": "oklch", "l": 0.72, "c": 0.19, "h": 85 },
      "info": { "space": "oklch", "l": 0.45, "c": 0.18, "h": 250 },
      "danger": { "space": "oklch", "l": 0.52, "c": 0.26, "h": 28 },
      "neutral": { "space": "oklch", "l": 0.92, "c": 0, "h": 0 }
    }
  },
  "modes": {
    "light": {
      "border": {
        "width": { "$value": "2px", "$type": "dimension" }
      },
      "color": {
        "background": { "$value": { "space": "oklch", "l": 0.97, "c": 0, "h": 0 }, "$type": "color" },
        "foreground": { "$value": { "space": "oklch", "l": 0.14, "c": 0, "h": 0 }, "$type": "color" },
        "muted": {
          "default": { "$value": { "space": "oklch", "l": 0.92, "c": 0, "h": 0 }, "$type": "color" },
          "foreground": { "$value": { "space": "oklch", "l": 0.38, "c": 0, "h": 0 }, "$type": "color" }
        },
        "surface": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0 }, "$type": "color" },
        "inset": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0 }, "$type": "color" },
        "overlay": { "$value": { "space": "oklch", "l": 1, "c": 0, "h": 0 }, "$type": "color" },
        "border": {
          "default": { "$value": { "space": "oklch", "l": 0.14, "c": 0, "h": 0 }, "$type": "color" },
          "subtle": { "$value": { "space": "oklch", "l": 0.14, "c": 0, "h": 0, "a": 0.45 }, "$type": "color" },
          "strong": { "$value": { "space": "oklch", "l": 0.14, "c": 0, "h": 0 }, "$type": "color" }
        }
      },
      "overlay": { "fill": { "$value": "none", "$type": "string" } },
      "radius": {
        "sm": { "$value": "0px", "$type": "dimension" },
        "md": { "$value": "0px", "$type": "dimension" },
        "lg": { "$value": "0px", "$type": "dimension" },
        "xl": { "$value": "0px", "$type": "dimension" }
      },
      "shadow": {
        "xs": { "$value": "none", "$type": "shadow" },
        "sm": { "$value": "none", "$type": "shadow" },
        "md": { "$value": "none", "$type": "shadow" },
        "lg": { "$value": "none", "$type": "shadow" },
        "xl": { "$value": "none", "$type": "shadow" },
        "card-rest": { "$value": "none", "$type": "shadow" },
        "hover": { "$value": "none", "$type": "shadow" },
        "sticky": { "$value": "none", "$type": "shadow" },
        "accent": { "$value": "0 0 0 3px oklch(0.62 0.24 28 / 40%)", "$type": "shadow" },
        "inset-soft": { "$value": "none", "$type": "shadow" },
        "edge-top": { "$value": "none", "$type": "shadow" }
      },
      "filter": { "backdrop": { "$value": "none", "$type": "string" } },
      "image": { "texture": { "$value": "none", "$type": "string" } },
      "control": {
        "lift": { "$value": "0px", "$type": "dimension" },
        "press": {
          "scale": { "$value": "1", "$type": "number" },
          "translate": { "$value": "0px", "$type": "dimension" }
        }
      },
      "interaction": {
        "hover": { "strength": { "$value": "14%", "$type": "number" } },
        "active": { "strength": { "$value": "22%", "$type": "number" } },
        "selected": { "strength": { "$value": "28%", "$type": "number" } }
      },
      "scrollbar": {
        "radius": { "$value": "0px", "$type": "dimension" },
        "thumb": { "$value": "oklch(0.14 0 0 / 55%)", "$type": "color" },
        "thumb-hover": { "$value": "oklch(0.14 0 0)", "$type": "color" }
      },
      "$extensions": { "sail": { "dark": false } }
    }
  }
}
