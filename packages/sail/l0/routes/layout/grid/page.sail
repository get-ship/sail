<!--
  Look: four 4-step boxes in a 2-column grid, 8px gap
  Spelling: <grid cols=2 gap=2>
  Owner: language (grid host)
  Trap: fixtures/grid-cols-off-enum.bad.sail
-->
<column gap="6">
  <l0-case look="2-col hug grid, four 16×8 bars, 8px gap" spell="&lt;grid cols=2 gap=2&gt; size(hug)">
    <l0-hug>
      <grid cols="2" gap="2">
        <l0-swatch kind="bar"></l0-swatch>
        <l0-swatch kind="bar" face="accent"></l0-swatch>
        <l0-swatch kind="bar" face="muted"></l0-swatch>
        <l0-swatch kind="bar"></l0-swatch>
      </grid>
    </l0-hug>
  </l0-case>
  <l0-case look="cols=1" spell="&lt;grid cols=1 gap=2&gt;">
    <l0-hug>
      <grid cols="1" gap="2">
        <l0-swatch kind="bar"></l0-swatch>
        <l0-swatch kind="bar" face="accent"></l0-swatch>
      </grid>
    </l0-hug>
  </l0-case>
  <l0-case look="cols=3" spell="&lt;grid cols=3 gap=2&gt;">
    <l0-hug>
      <grid cols="3" gap="2">
        <l0-swatch kind="bar"></l0-swatch>
        <l0-swatch kind="bar" face="accent"></l0-swatch>
        <l0-swatch kind="bar" face="muted"></l0-swatch>
      </grid>
    </l0-hug>
  </l0-case>
