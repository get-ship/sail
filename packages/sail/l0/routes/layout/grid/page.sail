<!--
  Look: four 4-step boxes in a 2-column grid, 8px gap
  Spelling: <grid cols=2 gap=2>
  Owner: language (grid host)
  Trap: fixtures/grid-cols-off-enum.bad.sail
-->
<column gap="6">
  <l0-case look="2-col hug grid, four 16×8 bars, 8px gap" spell="&lt;grid cols=2 gap=2&gt; size(hug)">
