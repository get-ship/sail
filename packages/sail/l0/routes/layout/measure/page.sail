<!--
  Look: a painted reading column (author-spelled ch)
  Spelling: size({ w: 38ch, max-w: 100% }) · margin({ x: auto })
  Owner: author
-->
<column gap="6">
  <l0-case look="a reading column — 38ch wide, 4-step pad" spell="size({ w: 38ch, max-w: 100% }) · margin({ x: auto }) · pad(4)">
    <l0-measure-face kind="col">reading column is author-spelled ch, not a theme token</l0-measure-face>
  </l0-case>
  <l0-case look="narrow — 20ch" spell="size({ w: 20ch, max-w: 100% })">
    <l0-measure-face kind="sm">20ch</l0-measure-face>
  </l0-case>
  <l0-case look="wide — 60ch" spell="size({ w: 60ch, max-w: 100% })">
    <l0-measure-face kind="lg">60ch</l0-measure-face>
  </l0-case>
</column>
