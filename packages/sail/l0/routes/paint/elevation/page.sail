<!--
  Look: painted boxes on the elevation shadow slot.
  Spelling: elevation({ shadow: sm })
  Owner: language (elevation slot table)
-->
<column gap="6">
  <l0-case look="shadow — none · xs · sm · md · lg · xl" spell="elevation shadow: none | xs | sm | md | lg | xl">
    <l0-elevation-face kind="rail">
      <row gap="3">
        <l0-elevation-face kind="none"></l0-elevation-face>
        <l0-elevation-face kind="xs"></l0-elevation-face>
        <l0-elevation-face kind="sm"></l0-elevation-face>
        <l0-elevation-face kind="md"></l0-elevation-face>
        <l0-elevation-face kind="lg"></l0-elevation-face>
        <l0-elevation-face kind="xl"></l0-elevation-face>
      </row>
    </l0-elevation-face>
  </l0-case>
</column>
