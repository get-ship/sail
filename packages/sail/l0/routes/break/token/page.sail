<!--
  Look: muted host, page inset around a primary face. Keyed token, not a hex dump.
  Owner: theme (breakpoint-keyed token spent in the skin)
-->
<column gap="6">
  <l0-case look="page inset keyed — space-4 at base, space-6 at tablet" spell="pad(page) · theme keys page base:4 tablet:6">
    <break-token></break-token>
  </l0-case>
</column>
