{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/compositions/*": ["./src/compositions/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/actions/*": ["./src/actions/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/themes/*": ["./themes/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
