# deploy + codegen (regenerated every build)
/dist/
/gen/
# Surfaces live in /gen/, not a tracked src/*.gen.ts dump.
/src/*.gen.ts
/routes.gen.ts
/entry.gen.ts
/components.gen.ts

# generated gallery manifest (regenerated from the primitive sources)
/src/gallery-manifest.json

# the compiler WASM is copied in from @ship/sail-compiler-wasm at build time
/public/sail_compiler_bg.wasm

# generated tutorial preview assets (regenerated by scripts/gen-tutorial-host.mjs
# + scripts/gen-tut-primitives.mjs): the concatenated theme sheet and the
# standalone <sail-*> primitives bundle the preview iframe loads.
/public/tut-preview-theme.css
/public/tut-sail-primitives.js

# Playwright
/test-results/
/playwright-report/
/.cache/
/src/playground-manifest.json
/src/gallery-manifest.json

# Sail defaults (merged by ensure_sail_gitignore)
.sail/
node_modules/
.env
