{
  // App-level Sail config (theme + serve). Project themes: tokens/themes/*.json.
  // `enabled` catalog allowlist:
  //   omit / []  → thin (no catalog themes)
  //   ["ship"]   → only those catalog ids
  //   "all"      → explicit full catalog (marketing site)
  "theme": {
    "default": "ship",
    "defaultMode": "light",
    "enabled": "all"
  },
  // clientsModule is side-effect-only (no named providers).
  "entry": {
    "clientsModule": "./src/clients.ts",
    "exposeNames": []
  }
}
