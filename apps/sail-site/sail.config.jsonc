{
  // App-level Sail config (T0 theme contract). Dual-read with sail.config.json.
  // Project themes: tokens/themes/*.json (always in generate emit set).
  // `enabled` catalog allowlist:
  //   omit / []  → thin (no catalog themes)
  //   ["ship"]   → only those catalog ids
  //   "all"      → explicit full catalog (marketing site)
  // Phase D: modes-in-file primary `ship` (theme + data-mode).
  "theme": {
    "default": "ship",
    "defaultMode": "light",
    "enabled": "all"
  }
}
