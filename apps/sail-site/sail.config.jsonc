{
  // App-level Sail config (theme + deck serve). Project themes: themes/*.json.
  // `enabled` catalog allowlist:
  //   omit / []  → thin (no catalog themes)
  //   ["ship"]   → only those catalog ids
  //   "all"      → explicit full catalog (marketing site)
  "theme": {
    "default": "ship",
    // Marketing first impression: ship/dark (honest config boot — no route force).
    "defaultMode": "dark",
    "enabled": "all"
  },
  "icons": {
    "pack": "lucide",
    "version": "1.28.0"
  },
  // Deck bundler/serve (SPEC-SAIL-CONFIG-1). clientsModule is side-effect-only.
  "deck": {
    "entry": {
      "clientsModule": "./src/clients.ts",
      "exposeNames": []
    }
  }
}
