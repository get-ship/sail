<!--
  /deck/layouts — adapted from packages/deck/docs/routes/layouts/page.sui.
-->

<controller>
// /deck/layouts — adapted from packages/deck/docs/routes/layouts.
import { controller, type ViewScope } from '@ship/sail-runtime'
import type { Scope } from './page.sui'
import { layoutFile, layoutChain } from './snippets'

export default controller((_ctx: ViewScope<Scope>) => ({ layoutFile, layoutChain }))
</controller>

<article sx="max-w-breakpoint-tablet mx-auto">
  <p sx="font-mono text-xs uppercase tracking-wide text-accent mb-2">Routing</p>
  <h1>Layouts</h1>
  <p sx="text-lg text-muted-foreground leading-relaxed">A <code>_layout.sui</code> wraps every route beneath it in shared chrome — a header, a nav, a sidebar — that survives navigation.</p>

  <h2>A layout is chrome</h2>
  <p>deck reads the layout's <strong>first custom-element tag</strong> as the chrome wrapper, then mounts each route into that element's <code>&lt;slot name="route"&gt;</code>.</p>
  <code-block code={layoutFile} lang="sui"></code-block>
  <p>This docs site's <code>routes/_layout.sui</code> is exactly that one line. <code>&lt;sail-site-shell&gt;</code> projects a <code>&lt;slot name="route"&gt;</code> — the sidebar and top bar around this page are the chrome; the article is the route.</p>

  <h2>The chrome persists</h2>
  <p>On a client-side navigation only the route slot swaps. The header, nav, and any layout state stay mounted across navigations — no chrome reflow, no flash.</p>

  <h2>Layouts compose</h2>
  <p>Nested <code>_layout.sui</code> files form a layout chain: a route is wrapped by every layout above it, outermost first.</p>
  <pre sx="font-mono text-sm leading-relaxed bg-surface-1 border border-border rounded-lg p-4 px-5 whitespace-pre-wrap break-words">{layoutChain}</pre>

  <row sx="mt-8 pt-4 border-t border-t-border">
    <a href="/deck/dynamic-routes">← Dynamic routes</a>
    <a href="/deck/reactivity">Reactivity →</a>
  </row>
</article>
