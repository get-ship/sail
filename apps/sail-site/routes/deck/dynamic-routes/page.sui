<!--
  /deck/dynamic-routes — adapted from packages/deck/docs/routes/dynamic-routes/page.sui.
-->
<controller>
import { controller, type ViewScope } from '@ship/sail-runtime'
import type { Scope } from './page.sui'
import { routeExample, readExample } from './snippets'

export default controller((_ctx: ViewScope<Scope>) => ({ routeExample, readExample }))
</controller>

<article sx="max-w-breakpoint-tablet mx-auto">
  <p sx="font-mono text-xs uppercase tracking-wide text-accent mb-2">Routing</p>
  <h1>Dynamic routes</h1>
  <p sx="text-lg text-muted-foreground leading-relaxed">A directory segment in brackets is a parameter. <code>routes/posts/[id]/page.sui</code> matches <code>/posts/anything</code>, and the view reads the value as a signal.</p>

  <h2>The [param] segment</h2>
  <p>deck emits a typed pattern — <code>/posts/:id</code> — for any <code>[param]</code> directory. Read the value with <code>route.params.&lt;name&gt;()</code>. It's a signal, so the view re-renders when the parameter changes during client-side navigation.</p>
  <pre sx="font-mono text-sm leading-relaxed bg-surface-1 border border-border rounded-lg p-4 px-5 whitespace-pre-wrap break-words">{routeExample}</pre>
  <code-block code={readExample} lang="sui"></code-block>

  <h2>Try it</h2>
  <p>This site has a live <code>[name]</code> route at <code>routes/examples/greet/[name]/</code>:</p>
  <p><a variant="solid" tone="primary" href="/deck/examples/greet/ada">Open /deck/examples/greet/ada →</a></p>

  <row sx="mt-8 pt-4 border-t border-t-border">
    <a href="/deck/routing">← File routing</a>
    <a href="/deck/layouts">Layouts →</a>
  </row>
</article>
