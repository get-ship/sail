<!--
  /components/[tag] — per-component detail view.

  Larger, focused surface for a single component: a header (back link + tag +
  description), a live preview mounted from the registered custom element,
  the CEM-driven props/slots/events table, and the optional knob playground
  when the component exposes `attributes[]` in the CEM.

  Routing: the dynamic [tag] segment is read via `ctx.route.params.tag()` in
  the controller. Lookups walk the same build-time `COMPONENTS_CATALOG` the
  flat grid reads. Unknown tag → an "unknown component" empty state with a
  back link, NOT a 404 (the catalog grid only links to tags the CEM
  declares, but a stale URL or hand-typed path is reachable).
-->
<style>
  :host {
    display: block;
    padding: var(--space-5) var(--space-6) var(--space-8);
    max-width: 82rem;
    margin: 0 auto;
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
  }
  .back:hover { color: var(--foreground); background: var(--surface-2); }
  .pack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  h1 {
    font-family: var(--font-display, var(--font-body));
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight, -0.02em);
    margin: 0 0 var(--space-1);
    color: var(--foreground);
  }
  h1 code { font-family: var(--font-mono); font-size: var(--text-2xl); }
  .desc {
    color: var(--muted-foreground);
    font-size: var(--text-base);
    line-height: 1.5;
    margin: 0 0 var(--space-5);
    max-width: 64ch;
  }

  .stage {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-7) var(--space-5);
    min-height: 18rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }
  .stage-cell {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 720px) {
    .panels { grid-template-columns: 1fr; }
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-4);
  }
  .panel-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .panel-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    letter-spacing: var(--tracking-wide, 0.05em);
    text-transform: uppercase;
  }
  .panel-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  /* props/slots/events table — same density the viewer uses internally */
  .api-table { display: grid; gap: 0; }
  .api-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--divider);
    font-size: var(--text-sm);
  }
  .api-row:last-child { border-bottom: none; }
  .api-name { font-weight: var(--font-weight-medium); color: var(--foreground); font-family: var(--font-mono); }
  .api-type { color: var(--muted-foreground); font-family: var(--font-mono); font-size: var(--text-xs); }
  .api-def  { color: var(--muted-foreground); font-family: var(--font-mono); font-size: var(--text-xs); }

  .knob-host { display: block; }

  .unknown {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    gap: var(--space-3);
    color: var(--muted-foreground);
  }
  .unknown h2 { color: var(--foreground); margin: 0; }
</style>

{#if !entry()}
  <div class="unknown" data-test="detail-unknown">
    <h2>Unknown component</h2>
    <p>No component registered as <code>&lt;{tag()}&gt;</code> in the current bundle.</p>
    <a class="back" href="/components">← Back to all components</a>
  </div>
{:else}
  <div class="head">
    <a class="back" href="/components" data-test="detail-back">← All components</a>
    <span class="pack" data-test="detail-pack">{entry().pkg}</span>
  </div>

  <h1 data-test="detail-title"><code>&lt;{entry().tag}&gt;</code></h1>
  {#if entry().description}
    <p class="desc" data-test="detail-desc">{entry().description}</p>
  {/if}

  <div class="stage" data-test="detail-stage" data-tag={entry().tag}>
    <div class="stage-cell" bind:this={stageEl}></div>
  </div>

  <div class="panels">
    <div class="panel" data-test="detail-knobs-panel">
      <div class="panel-h">
        <span class="panel-label">Props</span>
        <span class="panel-meta">{entry().props.length} prop{entry().props.length === 1 ? '' : 's'}</span>
      </div>
      {#if entry().props.length > 0}
        <sui-prop-knobs class="knob-host" prop:props={entry().props}></sui-prop-knobs>
      {:else}
        <p style="margin:0;color:var(--muted-foreground);font-size:var(--text-sm)">This component has no documented props.</p>
      {/if}
    </div>

    <div class="panel" data-test="detail-api-panel">
      <div class="panel-h">
        <span class="panel-label">API</span>
        <span class="panel-meta">{entry().props.length} props · {entry().slots.length} slots · {entry().events.length} events</span>
      </div>
      <div class="api-table" role="table" data-test="api-table">
        {#for p of entry().props key={p.name}}
          <div class="api-row" role="row">
            <span class="api-name" role="cell">{p.name}</span>
            <span class="api-type" role="cell">{p.type}</span>
            <span class="api-def" role="cell">{p.default ?? '—'}</span>
          </div>
        {/for}
        {#for s of entry().slots key={s.name ?? '(default)'}}
          <div class="api-row" role="row" data-kind="slot">
            <span class="api-name" role="cell" data-test="api-slot">slot: {s.name || '(default)'}</span>
            <span class="api-type" role="cell" colspan="2">{s.description ?? ''}</span>
          </div>
        {/for}
        {#for e of entry().events key={e.name ?? ''}}
          <div class="api-row" role="row" data-kind="event">
            <span class="api-name" role="cell" data-test="api-event">event: {e.name}</span>
            <span class="api-type" role="cell" colspan="2">{e.description ?? ''}</span>
          </div>
        {/for}
        {#if entry().props.length === 0 && entry().slots.length === 0 && entry().events.length === 0}
          <p style="margin:0;color:var(--muted-foreground);font-size:var(--text-sm)">No documented API surface in the CEM yet.</p>
        {/if}
      </div>
    </div>
  </div>
{/if}
