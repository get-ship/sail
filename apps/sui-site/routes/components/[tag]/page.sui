<!--
  /components/[tag] — per-component detail view.

  Larger, focused surface for a single component: a header (back link + tag +
  description), a live preview mounted from the registered custom element,
  the CEM-driven props/slots/events table, and the optional knob playground
  when the component exposes `attributes[]` in the CEM.

  Routing: the dynamic [tag] segment is read via `ctx.route.params.tag()` in
  the controller. Lookups walk the same build-time `COMPONENTS_CATALOG` the
  flat grid reads. Unknown tag → an "unknown component" empty state with a
  back link, NOT a 404 (the catalog grid only links to tags the CEM
  declares, but a stale URL or hand-typed path is reachable).

  CSS lives in the sibling `style.css` (the deck-route-css convention) —
  the bundler auto-imports it; an inline `<style>` here would be silently
  dropped (`sui-route-inline-style` lint warns). The class names below
  match the rules in that file.
-->

{#if !entry()}
  <div class="detail-unknown" data-test="detail-unknown">
    <h2>Unknown component</h2>
    <p>No component registered as <code>&lt;{tag()}&gt;</code> in the current bundle.</p>
    <a class="detail-back" href="/components">← Back to all components</a>
  </div>
{:else}
  <div class="detail-head">
    <a class="detail-back" href="/components" data-test="detail-back">← All components</a>
    <span class="detail-pack" data-test="detail-pack">{entry().pkg}</span>
  </div>

  <h1 class="detail-title" data-test="detail-title"><code>&lt;{entry().tag}&gt;</code></h1>
  {#if entry().description}
    <p class="detail-desc" data-test="detail-desc">{entry().description}</p>
  {/if}

  <div class="detail-stage" data-test="detail-stage" data-tag={entry().tag}>
    <div class="detail-stage-cell" bind:this={stageEl}></div>
  </div>

  <div class="detail-panels">
    <div class="detail-panel" data-test="detail-knobs-panel">
      <div class="detail-panel-h">
        <span class="detail-panel-label">Props</span>
        <span class="detail-panel-meta">{entry().props.length} prop{entry().props.length === 1 ? '' : 's'}</span>
      </div>
      {#if entry().props.length > 0}
        <sui-prop-knobs class="detail-knob-host" prop:props={entry().props}></sui-prop-knobs>
      {:else}
        <p class="detail-empty-note">This component has no documented props.</p>
      {/if}
    </div>

    <div class="detail-panel" data-test="detail-api-panel">
      <div class="detail-panel-h">
        <span class="detail-panel-label">API</span>
        <span class="detail-panel-meta">{entry().props.length} props · {entry().slots.length} slots · {entry().events.length} events</span>
      </div>
      <div class="detail-api-table" role="table" data-test="api-table">
        {#for p of entry().props key={p.name}}
          <div class="detail-api-row" role="row">
            <span class="detail-api-name" role="cell">{p.name}</span>
            <span class="detail-api-type" role="cell">{p.type}</span>
            <span class="detail-api-def" role="cell">{p.default ?? '—'}</span>
          </div>
        {/for}
        {#for s of entry().slots key={s.name ?? '(default)'}}
          <div class="detail-api-row" role="row" data-kind="slot">
            <span class="detail-api-name" role="cell" data-test="api-slot">slot: {s.name || '(default)'}</span>
            <span class="detail-api-type" role="cell" colspan="2">{s.description ?? ''}</span>
          </div>
        {/for}
        {#for e of entry().events key={e.name ?? ''}}
          <div class="detail-api-row" role="row" data-kind="event">
            <span class="detail-api-name" role="cell" data-test="api-event">event: {e.name}</span>
            <span class="detail-api-type" role="cell" colspan="2">{e.description ?? ''}</span>
          </div>
        {/for}
        {#if entry().props.length === 0 && entry().slots.length === 0 && entry().events.length === 0}
          <p class="detail-empty-note">No documented API surface in the CEM yet.</p>
        {/if}
      </div>
    </div>
  </div>
{/if}
