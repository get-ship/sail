<!--
  /components/[tag] — per-component detail view (the "gallery detail").

  A centered column: a back link, one big framed live PREVIEW STAGE, a row of
  variant chips (one per value of the component's primary enum prop — tone or
  variant), the title/meta block, then the API reference table.

  Structure is the library dogfooding itself:
    <center>       parks the live specimen dead-center of the preview stage
                   (both axes), so it no longer hugs the top edge
    <row>          centers the variant chips and the meta pills (justify="center")
    <column>       the unknown-tag empty state

  The preview is a SINGLE live instance mounted by the controller into the
  `bind:this={stageEl}` stage; clicking a variant chip flips `activeVariant`
  and the controller effect re-sets the primary prop in place.

  Routing: the dynamic [tag] segment is read via `ctx.route.params.tag()` in the
  controller. Unknown tag → an empty state with a back link, not a 404.

  A view cannot contain a <style> block — all chrome (including the API table's
  legitimately-tabular grid) lives in the sibling style.css, auto-imported by
  deck's route-css convention. Every value is a design token.
-->

{#if !entry()}
  <column class="detail-unknown" gap="3" align="center" data-test="detail-unknown">
    <h2>Unknown component</h2>
    <p>No component registered as <code>&lt;{tag()}&gt;</code> in the current bundle.</p>
    <a class="detail-back" href="/components">← All components</a>
  </column>
{:else}
  <column class="detail" gap="0" data-test="detail">
    <a class="detail-back" href="/components" data-test="detail-back">← All components</a>

    <!-- HERO — editorial, left-aligned, strong hierarchy. -->
    <header class="detail-hero">
      <span class="detail-pack" data-test="detail-pack">{entry().pack}</span>
      <h1 class="detail-title" data-test="detail-title">{entry().tag}</h1>
      {#if entry().description}
        <p class="detail-desc" data-test="detail-desc">{entry().description}</p>
      {/if}
      <div class="detail-meta">
        <span class="meta-stat"><strong>{entry().props.length}</strong> props</span>
        <span class="meta-dot"></span>
        <span class="meta-stat"><strong>{entry().slots.length}</strong> slots</span>
        <span class="meta-dot"></span>
        <span class="meta-stat"><strong>{entry().events.length}</strong> events</span>
      </div>
    </header>

    <!-- PREVIEW — the centerpiece: designed backdrop, elevated specimen. -->
    <div class="detail-preview">
      <center class="detail-stage" bind:this={stageEl} data-test="detail-stage"></center>
      {#if variants().length}
        <row class="detail-variants" gap="2" data-test="detail-variants">
          {#for v of variants() key={v}}
            <button
              type="button"
              class="vchip"
              class:vchip-on={activeVariant() === v}
              on:click={() => setVariant(v)}
              attr:data-variant={v}
              data-test="variant-chip"
            >{v}</button>
          {/for}
        </row>
      {/if}
    </div>

    <!-- API — compact, demoted reference (no longer half the page). -->
    <section class="detail-api" data-test="detail-api">
      <div class="api-headrow">
        <span class="detail-api-eyebrow">Props</span>
        <span class="api-count">{entry().props.length}</span>
      </div>
      <div class="api-table" role="table" data-test="api-table">
        {#for p of entry().props key={p.name}}
          <div class="api-row" role="row" data-test="api-prop-row">
            <code class="api-prop" role="cell">{p.name}</code>
            <code class="api-type" role="cell">{p.type}</code>
            <span class="api-def" role="cell">{p.default ?? '—'}</span>
            <span class="api-desc" role="cell">{p.description ?? ''}</span>
          </div>
        {/for}
        {#if entry().props.length === 0}
          <p class="api-empty">No documented props in the CEM yet.</p>
        {/if}
      </div>
    </section>
  </column>
{/if}
