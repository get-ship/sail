<!--
  /components/[tag] — the detail view. The live component holds center stage
  (press it, type in it, pick from it); the variant chips drive a REAL
  attribute on it; usage is a complete compiling program; props are the
  curated truth from the stdlib declarations.

  route.params.tag() picks the entry; ./registry.ts covers the FULL L1
  surface (all 48 elements) plus the two @ship/sui-fx actions, so the empty
  state below is for typos, not for real components. Each stage mounts
  through one zero-arg gate (`stage.<key>()`) — the only call shape a
  renderable expression allows.
-->
<column class="doc-wide" gap="4">
  {#if known()}
    <breadcrumb>
      <a href="/components">components</a>
      <small>{tag()}</small>
    </breadcrumb>

    <row gap="3" align="center">
      <h1 class="mono" sx="tracking:tight">{heading()}</h1>
      <badge tone="primary" variant="soft">{packLabel()}</badge>
      {#if !isFx()}
        <badge tone="muted" variant="outline">a11y ✓ · keyboard ✓</badge>
      {/if}
    </row>
    <p class="lead">{blurb()}</p>

    <row class="split" align="stretch">
      <!-- ── Live stage ────────────────────────────────────────────────── -->
      <column>
        <p class="pane-label">Live — this is the real component</p>
        <column gap="4" sx="p:5 radius:lg border:border bg:surface-0 h:full">
          <row gap="2" align="center" justify="between">
            <row gap="2" align="center">
              {#if hasVariants()}
                <span class="mono" sx="text:xs fg:muted-foreground">{variantAttr()}:</span>
                {#for v of variants() key={v}}
                  <button size="sm" tone="primary" variant={variant() === v ? 'solid' : 'ghost'} on:click={() => pick(v)}>{v}</button>
                {/for}
              {/if}
            </row>
            <row gap="2" align="center">
              <status-dot tone="success"></status-dot>
              <span class="mono" sx="text:xs fg:muted-foreground">live</span>
            </row>
          </row>

          <center data-stage sx="p:6 min-h:9 grow:1">
            <!-- ══ Inputs ══════════════════════════════════════════════ -->
            {#if stage.button()}
              <column gap="3" align="center">
                <button variant={variant()} tone="primary" size="lg" on:click={press} motion:press={{ scale: 'press' }}>
                  Press me
                </button>
                <p class="mono" sx="text:xs fg:muted-foreground">motion:press fired ×{presses()}</p>
              </column>
            {/if}
            {#if stage.input()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <input placeholder="Ada Lovelace" bind:value={name} />
                <p class="mono" sx="text:xs fg:muted-foreground">hello, {name() || 'stranger'}</p>
              </column>
            {/if}
            {#if stage.textarea()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <textarea placeholder="Tell us about yourself" bind:value={bio}></textarea>
                <p class="mono" sx="text:xs fg:muted-foreground">{bio().length} characters</p>
              </column>
            {/if}
            {#if stage.select()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <select bind:value={team}>
                  <option>Engineering</option>
                  <option>Design</option>
                  <option>Research</option>
                </select>
                <p class="mono" sx="text:xs fg:muted-foreground">team: {team()}</p>
              </column>
            {/if}
            {#if stage.combobox()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <combobox placeholder="Pick a framework — type to filter" on:sui-combobox-select={(e) => pickFw(e)}>
                  <option value="sui">SUI</option>
                  <option value="react">React</option>
                  <option value="svelte">Svelte</option>
                  <option value="solid">Solid</option>
                  <option value="vue">Vue</option>
                  <option value="qwik">Qwik</option>
                </combobox>
                <p class="mono" sx="text:xs fg:muted-foreground">picked: {fw() || 'nothing yet'}</p>
              </column>
            {/if}
            {#if stage.checkbox()}
              <column gap="3" align="center">
                <label><input type="checkbox" bind:checked={agreed} /> I agree to the terms</label>
                <p class="mono" sx="text:xs fg:muted-foreground">{agreed() ? 'thank you' : 'the platform checkbox, skinned'}</p>
              </column>
            {/if}
            {#if stage.radioGroup()}
              <radio-group label="Billing period">
                <label><input type="radio" name="stage-plan" checked /> Monthly</label>
                <label><input type="radio" name="stage-plan" /> Yearly</label>
              </radio-group>
            {/if}
            {#if stage.switchToggle()}
              <row gap="3" align="center">
                <switch bind:checked={notify} size={variant()} tone="primary"></switch>
                <p class="mono" sx="text:xs fg:muted-foreground">{notify() ? 'on' : 'off'} · size {variant()}</p>
              </row>
            {/if}
            {#if stage.slider()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <slider bind:value={load} min="0" max="100" tone={variant()}></slider>
                <progress value={load()} max="100"></progress>
                <p class="mono" sx="text:xs fg:muted-foreground">one signal, two components — {load()}%</p>
              </column>
            {/if}
            {#if stage.toggleGroup()}
              <toggle-group variant={variant()}>
                <toggle value="left">Left</toggle>
                <toggle value="center">Center</toggle>
                <toggle value="right">Right</toggle>
              </toggle-group>
            {/if}
            {#if stage.field()}
              <column gap="4" sx="w:full max-w:panel-max-w-sm">
                <field>
                  <label for="stage-name">Name</label>
                  <input id="stage-name" placeholder="Ada Lovelace" />
                </field>
                <field invalid>
                  <label for="stage-bad-email">Email</label>
                  <input id="stage-bad-email" value="not-an-email" />
                </field>
              </column>
            {/if}
            {#if stage.label()}
              <column gap="1" sx="w:full max-w:panel-max-w-sm">
                <label for="stage-email" required size={variant()}>Email</label>
                <input id="stage-email" placeholder="ada@lovelace.dev" />
              </column>
            {/if}
            {#if stage.fieldset()}
              <fieldset sx="w:full max-w:panel-max-w-sm">
                <legend>Account details</legend>
                <column gap="2">
                  <input placeholder="Name" />
                  <input placeholder="Email" />
                </column>
              </fieldset>
            {/if}
            {#if stage.dropzone()}
              <card dropzone sx="p:6 w:full max-w:panel-max-w-sm">Drop a file, or click to browse</card>
            {/if}
            {#if stage.themePicker()}
              <column gap="3" align="center">
                <theme-picker></theme-picker>
                <p class="mono" sx="text:xs fg:muted-foreground">open it — it themes this whole site, live</p>
              </column>
            {/if}

            <!-- ══ Feedback ════════════════════════════════════════════ -->
            {#if stage.alert()}
              <alert tone={variant()} sx="w:full">
                <strong>Heads up.</strong> The tone chips above restyle me — colour and icon both.
              </alert>
            {/if}
            {#if stage.progressBar()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <slider bind:value={load} min="0" max="100" tone="primary"></slider>
                <progress value={load()} max="100"></progress>
                <p class="mono" sx="text:xs fg:muted-foreground">drag the slider — same signal, {load()}%</p>
              </column>
            {/if}
            {#if stage.meter()}
              <!-- Fixed width: meter has no intrinsic width, and a percentage
                   can't resolve inside the content-sized <center> stage. -->
              <column gap="2" sx="w:panel-max-w-sm">
                <meter value="0.3"></meter>
                <meter value="0.7"></meter>
                <meter value="0.95"></meter>
              </column>
            {/if}
            {#if stage.spinner()}
              <row gap="4" align="center">
                <spinner size={variant()}></spinner>
                <spinner size={variant()} tone="primary"></spinner>
                <spinner size={variant()} tone="destructive"></spinner>
              </row>
            {/if}
            {#if stage.skeleton()}
              <row gap="3" align="center" sx="w:full max-w:panel-max-w-sm">
                <span skeleton shape={variant()} sx="w:7 h:7"></span>
                <column gap="2" sx="grow:1">
                  <span skeleton shape={variant()} size="sm"></span>
                  <span skeleton shape={variant()} size="sm"></span>
                </column>
              </row>
            {/if}
            {#if stage.emptyState()}
              <empty-state variant={variant()} sx="w:full">
                <strong slot="title">No results</strong>
                Try a different search, or clear a filter.
              </empty-state>
            {/if}
            {#if stage.errorState()}
              <error-state variant={variant()} code="ERR_TIMEOUT" sx="w:full">
                The request timed out. Retry, or check the connection.
              </error-state>
            {/if}
            {#if stage.errorBoundary()}
              <column gap="3" sx="w:full max-w:panel-max-w-sm">
                <error-boundary message="This panel could not load.">
                  <card variant="outline" sx="p:4">
                    <p sx="text:sm fg:muted-foreground">
                      A healthy boundary is invisible — this card is the wrapped
                      subtree. A render throw inside would swap in the fallback.
                    </p>
                  </card>
                </error-boundary>
              </column>
            {/if}
            {#if stage.toast()}
              <toast tone={variant()} duration="0" sx="w:full max-w:panel-max-w-sm">
                <strong>Saved.</strong> Sticky at duration 0 — hover pauses real ones.
                <button data-toast-close variant="ghost" size="sm">×</button>
              </toast>
            {/if}

            <!-- ══ Display ═════════════════════════════════════════════ -->
            {#if stage.badge()}
              <row gap="2" align="center">
                <badge variant={variant()} tone="primary">primary</badge>
                <badge variant={variant()} tone="success">success</badge>
                <badge variant={variant()} tone="warning">warning</badge>
                <badge variant={variant()} tone="destructive">destructive</badge>
                <badge variant={variant()} tone="muted">muted</badge>
              </row>
            {/if}
            {#if stage.chip()}
              <column gap="3" align="center">
                <row gap="2" align="center">
                  <chip variant={variant()} selected>Selected</chip>
                  {#if kept()}
                    <chip variant={variant()} removable on:sui-remove={dropChip}>Removable</chip>
                  {/if}
                  {#if !kept()}
                    <button variant="ghost" size="sm" on:click={restoreChip}>bring it back</button>
                  {/if}
                </row>
                <p class="mono" sx="text:xs fg:muted-foreground">× or Backspace fires sui-remove</p>
              </column>
            {/if}
            {#if stage.statusDot()}
              <row gap="2" align="center">
                <status-dot tone={variant()}></status-dot>
                <p sx="text:sm fg:muted-foreground">the tone is the message</p>
              </row>
            {/if}
            {#if stage.card()}
              <card variant={variant()} sx="p:5" motion:hover={{ scale: 'spring:gentle' }}>
                <strong>A surface</strong>
                <p sx="text:sm fg:muted-foreground">hover me — the lift is one attribute</p>
              </card>
            {/if}
            {#if stage.avatar()}
              <row gap="3" align="center">
                <avatar name="Ada Lovelace" size={variant()}></avatar>
                <avatar initials="GH" tone="primary" size={variant()}></avatar>
                <avatar name="Alan Turing" size={variant()} shape="square"></avatar>
              </row>
            {/if}
            {#if stage.icon()}
              <row gap="4" align="center">
                <icon size={variant()}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                </icon>
                <icon size={variant()}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                </icon>
                <icon size={variant()} spin>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.2-8.56" /></svg>
                </icon>
              </row>
            {/if}
            {#if stage.separator()}
              <column gap="2" sx="w:full max-w:panel-max-w-sm">
                <p sx="text:sm fg:muted-foreground">above</p>
                <separator variant={variant()}></separator>
                <p sx="text:sm fg:muted-foreground">below — and vertical:</p>
                <row gap="2" align="center">
                  <span>A</span>
                  <separator orientation="vertical" variant={variant()}></separator>
                  <span>B</span>
                </row>
              </column>
            {/if}
            {#if stage.hrRule()}
              <!-- Fixed width: an <hr> is a 1px line with no intrinsic width. -->
              <column gap="3" sx="w:panel-max-w-sm">
                <hr tone={variant()} />
                <hr tone={variant()} variant="dashed" />
              </column>
            {/if}
            {#if stage.detailsEl()}
              <details sx="w:full max-w:panel-max-w-sm">
                <summary>Advanced options</summary>
                <p>Native disclosure. Zero JavaScript — open/close is the platform.</p>
              </details>
            {/if}
            {#if stage.collapsible()}
              <collapsible sx="w:full max-w:panel-max-w-sm">
                <strong slot="trigger">Show the details</strong>
                <p>Animated open and close — and it remembers its state.</p>
              </collapsible>
            {/if}
            {#if stage.prose()}
              <column gap="2" sx="w:full max-w:panel-max-w-md">
                <h3>Plain tags, already styled</h3>
                <p>Body copy sets the baseline — <strong>strong</strong>, <em>emphasis</em>,
                   <code>inline_code()</code> and <mark>a highlight</mark> need no classes.</p>
                <blockquote>A quotation carries its own rule.</blockquote>
              </column>
            {/if}

            <!-- ══ Overlay ═════════════════════════════════════════════ -->
            {#if stage.tooltip()}
              <tooltip content="Deletes the branch — cannot be undone" placement={variant()}>
                <button tone="destructive" variant="outline">Delete branch</button>
              </tooltip>
            {/if}
            {#if stage.hoverCard()}
              <column gap="3" align="center">
                <button variant="ghost" popovertarget="stage-hc">@ada</button>
                <hover-card id="stage-hc">
                  <card sx="p:4">
                    <strong>Ada Lovelace</strong>
                    <p sx="text:sm fg:muted-foreground">wrote the first program.</p>
                  </card>
                </hover-card>
                <p class="mono" sx="text:xs fg:muted-foreground">hover or focus the trigger</p>
              </column>
            {/if}
            {#if stage.popover()}
              <column gap="3" align="center">
                <button popovertarget="stage-pop">Open popover</button>
                <popover id="stage-pop">
                  <card sx="p:4">Rides the platform top layer — Escape or click outside closes it.</card>
                </popover>
                <p class="mono" sx="text:xs fg:muted-foreground">top layer · light dismiss · zero z-index</p>
              </column>
            {/if}
            {#if stage.dropdown()}
              <column gap="3" align="center">
                <button popovertarget="stage-menu">Actions ▾</button>
                <dropdown id="stage-menu">
                  <menu-item>Edit</menu-item>
                  <menu-item>Duplicate</menu-item>
                  <menu-item tone="destructive">Delete</menu-item>
                </dropdown>
                <p class="mono" sx="text:xs fg:muted-foreground">arrows rove · type-ahead · Escape closes</p>
              </column>
            {/if}
            {#if stage.contextMenu()}
              <column gap="3" align="center" sx="w:full max-w:panel-max-w-sm">
                <card id="stage-ctx" variant="outline" sx="p:6 w:full">
                  <center><p sx="text:sm fg:muted-foreground">right-click this card</p></center>
                </card>
                <context-menu for="stage-ctx">
                  <menu-item value="cut">Cut</menu-item>
                  <menu-item value="copy">Copy</menu-item>
                  <menu-item value="paste">Paste</menu-item>
                </context-menu>
              </column>
            {/if}
            {#if stage.dialog()}
              <column gap="3" align="center">
                <button command="show-modal" commandfor="stage-dialog" motion:press={{ scale: 'press' }}>
                  Open the {variant()}
                </button>
                <p class="mono" sx="text:xs fg:muted-foreground">Escape and the backdrop close it — that's the platform</p>
                <dialog id="stage-dialog" side={sheetSide()}>
                  <header>Delete project</header>
                  <section>This cannot be undone. Top layer, focus trap, Escape — zero JavaScript.</section>
                  <footer>
                    <button command="close" commandfor="stage-dialog" variant="ghost">Cancel</button>
                    <button command="close" commandfor="stage-dialog" tone="destructive" variant="solid">Delete</button>
                  </footer>
                </dialog>
              </column>
            {/if}

            <!-- ══ Navigation ══════════════════════════════════════════ -->
            {#if stage.tabs()}
              <tabs variant={variant()} tone="primary" sx="w:full">
                <tab-list>
                  <tab>Overview</tab>
                  <tab>Activity</tab>
                  <tab>Settings</tab>
                </tab-list>
                <tab-panel><p sx="text:sm fg:muted-foreground">Arrows rove, Home and End jump — wired for you.</p></tab-panel>
                <tab-panel><p sx="text:sm fg:muted-foreground">The activity feed panel.</p></tab-panel>
                <tab-panel><p sx="text:sm fg:muted-foreground">The settings panel.</p></tab-panel>
              </tabs>
            {/if}
            {#if stage.breadcrumb()}
              <breadcrumb>
                <a href="/">Home</a>
                <a href="/components">Components</a>
                <small>breadcrumb</small>
              </breadcrumb>
            {/if}
            {#if stage.pagination()}
              <column gap="3" align="center">
                <pagination value={pageNo()} size={variant()} on:sui-page-change={(e) => goPage(e)}>
                  <page value="1">1</page>
                  <page value="2">2</page>
                  <page value="3">3</page>
                  <page value="4">4</page>
                </pagination>
                <p class="mono" sx="text:xs fg:muted-foreground">on page {pageNo()} — click one</p>
              </column>
            {/if}
            {#if stage.navbar()}
              <navbar bordered sx="w:full">
                <strong slot="brand">SHIP</strong>
                <a href="/components">Docs</a>
                <a href="/components">Components</a>
                <button slot="actions" size="sm" variant="outline">Sign in</button>
              </navbar>
            {/if}

            <!-- ══ Data ════════════════════════════════════════════════ -->
            {#if stage.table()}
              <table sx="w:full">
                <thead>
                  <tr><th>Name</th><th>Team</th><th>Status</th></tr>
                </thead>
                <tbody>
                  {#for p of people() key={p.id}}
                    <tr>
                      <td>{p.name}</td>
                      <td>{p.team}</td>
                      <td><badge tone={p.status === 'active' ? 'success' : 'muted'} size="sm">{p.status}</badge></td>
                    </tr>
                  {/for}
                </tbody>
              </table>
            {/if}

            <!-- ══ Layout ══════════════════════════════════════════════ -->
            {#if stage.layout()}
              <column gap="3" sx="w:full max-w:panel-max-w-md">
                <row gap="2" align="center" justify="between">
                  <strong>row — the x axis</strong>
                  <badge tone="primary">end</badge>
                </row>
                <grid cols="3" gap="2">
                  <card sx="p:3"><center>1</center></card>
                  <card sx="p:3"><center>2</center></card>
                  <card sx="p:3"><center>3</center></card>
                </grid>
                <center sx="p:4 border:subtle radius:md">
                  <p sx="text:sm fg:muted-foreground">center — both axes at once</p>
                </center>
              </column>
            {/if}
            {#if stage.scrollArea()}
              <scroll-area sx="max-h:panel-max-h-sm w:full max-w:panel-max-w-sm p:3 border:subtle radius:md">
                <p>Constrain it, and the overflow scrolls behind thin, themed scrollbars.</p>
                <p>Line two.</p>
                <p>Line three.</p>
                <p>Line four.</p>
                <p>Line five.</p>
                <p>Line six.</p>
                <p>Line seven.</p>
                <p>Line eight.</p>
                <p>Line nine.</p>
                <p>Line ten — still scrolling.</p>
              </scroll-area>
            {/if}

            <!-- ══ @ship/sui-fx ════════════════════════════════════════ -->
            {#if stage.fxSpotlight()}
              <div use:spotlight sx="p:8 w:full radius:lg border:border">
                <center><p sx="text:sm fg:muted-foreground">move the pointer — a spotlight follows it</p></center>
              </div>
            {/if}
            {#if stage.fxDotGrid()}
              <div use:dotGrid sx="p:8 w:full radius:lg border:border">
                <center><p sx="text:sm fg:muted-foreground">an interactive dot matrix, behind this text</p></center>
              </div>
            {/if}
          </center>

          <center>
            <p class="mono" sx="text:xs fg:muted-foreground">click it · type in it · pick from it — nothing here is a screenshot</p>
          </center>
        </column>
      </column>

      <!-- ── Usage + props ─────────────────────────────────────────────── -->
      <column gap="3">
        <p class="pane-label">Usage — a complete program, compiled on every commit</p>
        <code-block code={usageCode()}></code-block>
        <card sx="p:4">
          <column gap="3">
            <p class="eyebrow">Props</p>
            {#for r of props() key={r.name}}
              <column gap="1" motion:enter={{ opacity: 'fade', stagger: '0.05s' }}>
                <row gap="3" align="baseline">
                  <code>{r.name}</code>
                  <span class="mono" sx="text:xs fg:muted-foreground grow:1">{r.type}</span>
                </row>
                <p sx="text:sm fg:muted-foreground">{r.desc}</p>
              </column>
            {/for}
          </column>
        </card>
        <row gap="2">
          <a class="btn" href="/components">← All components</a>
          <a class="btn btn-primary" href="/reference">API reference</a>
        </row>
      </column>
    </row>
  {:else}
    <breadcrumb>
      <a href="/components">components</a>
      <small>{tag()}</small>
    </breadcrumb>
    <empty-state motion:enter={{ opacity: 'fade', translate-y: 'spring:snappy' }}>
      <strong slot="title">Nothing named “{tag()}” here</strong>
      Every element on the L1 surface has a detail page — this looks like a typo.
    </empty-state>
    <row gap="2">
      <a class="btn btn-primary" href="/components">← All components</a>
    </row>
  {/if}
</column>
