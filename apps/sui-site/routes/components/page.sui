<!--
  Component library reference. Each primitive is rendered LIVE (registered in
  this route's controller) next to its usage source. Overlay/trigger components
  (dialogs, popovers, menus, toasts) live in the interactive Playground.
-->
<style>
  .ref-head { max-width: 46rem; margin-bottom: var(--space-7); }
  .ref-head h1 { font-size: clamp(2rem, 4vw, 2.7rem); margin: 0 0 var(--space-3); }
  .ref-head p { color: var(--muted-foreground); font-size: var(--text-lg); line-height: 1.55; margin: 0; }

  .cat { margin-top: var(--space-8); }
  .cat > h2 {
    font-size: var(--text-md);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
    margin: 0 0 var(--space-5);
  }

  .comp + .comp { margin-top: var(--space-6); }
  .comp-head { display: flex; align-items: baseline; gap: var(--space-2); margin-bottom: var(--space-3); }
  .comp-head h3 { font-size: var(--text-lg); margin: 0; }
  .comp-head .tag { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--accent); }

  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .demo .preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    background: radial-gradient(130% 130% at 30% 0%, var(--surface-2), var(--surface-1));
  }
  .demo sui-codeblock { display: block; }
  .demo sui-codeblock::part(pre) {
    border: none;
    border-left: 1px solid var(--border);
    border-radius: 0;
    font-size: var(--text-xs);
    background: var(--surface-0);
    height: 100%;
  }
  @media (max-width: 760px) {
    .demo { grid-template-columns: 1fr; }
    .demo sui-codeblock::part(pre) { border-left: none; border-top: 1px solid var(--border); }
  }
</style>

<header class="ref-head">
  <p class="eyebrow">Reference</p>
  <h1>Component library</h1>
  <p>Every primitive is a themeable web component. Drop the tag in, set props, slot content. Each renders live below — these are the real components, not images. For overlays and interactive states, try the <a href="/playground">Playground</a>.</p>
</header>

<section class="cat">
  <h2>Actions</h2>
  <div class="comp">
    <div class="comp-head"><h3>Button</h3><span class="tag">&lt;sui-button&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-button tone="primary" variant="solid">Save changes</sui-button>
        <sui-button variant="outline">Cancel</sui-button>
        <sui-button variant="ghost">Ghost</sui-button>
        <sui-button tone="destructive" variant="soft" size="sm">Delete</sui-button>
      </div>
      <sui-codeblock code={code.button}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Forms</h2>

  <div class="comp">
    <div class="comp-head"><h3>Input</h3><span class="tag">&lt;sui-input&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-input type="email" placeholder="you@example.com"></sui-input></div>
      <sui-codeblock code={code.input}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Field</h3><span class="tag">&lt;sui-field&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-field>
          <sui-label slot="label" required>Email</sui-label>
          <sui-input type="email" placeholder="you@example.com"></sui-input>
          <span slot="hint">We'll never share it.</span>
        </sui-field>
      </div>
      <sui-codeblock code={code.field}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Label</h3><span class="tag">&lt;sui-label&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-label required>Email address</sui-label></div>
      <sui-codeblock code={code.label}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Checkbox</h3><span class="tag">&lt;sui-checkbox&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-checkbox checked tone="primary">Subscribe to updates</sui-checkbox></div>
      <sui-codeblock code={code.checkbox}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Switch</h3><span class="tag">&lt;sui-switch&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-switch checked label="Notifications"></sui-switch>
        <sui-switch tone="success" checked label="Auto-deploy"></sui-switch>
        <sui-switch disabled label="Locked"></sui-switch>
      </div>
      <sui-codeblock code={code.switch}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Radio group</h3><span class="tag">&lt;sui-radio-group&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-radio-group value="comfortable" label="Density" tone="primary">
          <sui-radio value="compact">Compact</sui-radio>
          <sui-radio value="comfortable">Comfortable</sui-radio>
          <sui-radio value="spacious">Spacious</sui-radio>
        </sui-radio-group>
      </div>
      <sui-codeblock code={code.radioGroup}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Toggle group</h3><span class="tag">&lt;sui-toggle-group&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-toggle-group type="single" value="b" variant="outline" name="align">
          <sui-toggle value="a">Left</sui-toggle>
          <sui-toggle value="b">Center</sui-toggle>
          <sui-toggle value="c">Right</sui-toggle>
        </sui-toggle-group>
      </div>
      <sui-codeblock code={code.toggleGroup}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Select</h3><span class="tag">&lt;sui-select&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-select value="opus" label="Model">
          <option value="opus">Claude Opus</option>
          <option value="sonnet">Claude Sonnet</option>
          <option value="haiku">Claude Haiku</option>
        </sui-select>
      </div>
      <sui-codeblock code={code.select}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Combobox</h3><span class="tag">&lt;sui-combobox&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-combobox placeholder="Pick a framework">
          <option value="sui">SUI</option>
          <option value="lit">Lit</option>
          <option value="svelte">Svelte</option>
        </sui-combobox>
      </div>
      <sui-codeblock code={code.combobox}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Autocomplete</h3><span class="tag">&lt;sui-autocomplete&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-autocomplete placeholder="Search fruit">
          <option value="apple">Apple</option>
          <option value="apricot">Apricot</option>
          <option value="banana">Banana</option>
        </sui-autocomplete>
      </div>
      <sui-codeblock code={code.autocomplete}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Textarea</h3><span class="tag">&lt;sui-textarea&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-textarea placeholder="Add a description" rows="3"></sui-textarea></div>
      <sui-codeblock code={code.textarea}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Slider</h3><span class="tag">&lt;sui-slider&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-slider value="40" label="Volume" tone="primary"></sui-slider></div>
      <sui-codeblock code={code.slider}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Color picker</h3><span class="tag">&lt;sui-color-picker&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-color-picker value="#d63b2f"></sui-color-picker></div>
      <sui-codeblock code={code.colorPicker}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>File upload</h3><span class="tag">&lt;sui-file-upload&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-file-upload accept="image/*" multiple></sui-file-upload></div>
      <sui-codeblock code={code.fileUpload}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Feedback</h2>

  <div class="comp">
    <div class="comp-head"><h3>Alert</h3><span class="tag">&lt;sui-alert&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-alert tone="success" dismissible>
          <span slot="title">Saved</span>
          Your changes were saved.
        </sui-alert>
      </div>
      <sui-codeblock code={code.alert}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Spinner</h3><span class="tag">&lt;sui-spinner&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-spinner></sui-spinner>
        <sui-spinner tone="primary" size="lg"></sui-spinner>
      </div>
      <sui-codeblock code={code.spinner}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Skeleton</h3><span class="tag">&lt;sui-skeleton&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-skeleton shape="circle"></sui-skeleton>
        <sui-skeleton shape="text"></sui-skeleton>
        <sui-skeleton shape="block"></sui-skeleton>
      </div>
      <sui-codeblock code={code.skeleton}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Empty state</h3><span class="tag">&lt;sui-empty-state&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-empty-state>
          <sui-icon slot="icon" name="inbox"></sui-icon>
          <span slot="title">No messages</span>
          Your inbox is all caught up.
          <sui-button slot="action" size="sm" variant="outline">Refresh</sui-button>
        </sui-empty-state>
      </div>
      <sui-codeblock code={code.emptyState}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Error state</h3><span class="tag">&lt;sui-error-state&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-error-state title="Failed to load" body="The agent stream disconnected." code="ERR_STREAM"></sui-error-state></div>
      <sui-codeblock code={code.errorState}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Status dot</h3><span class="tag">&lt;sui-status-dot&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-status-dot tone="success" label="Online"></sui-status-dot>
        <sui-status-dot tone="warning" pulse label="Pending"></sui-status-dot>
        <sui-status-dot tone="destructive" label="Error"></sui-status-dot>
      </div>
      <sui-codeblock code={code.statusDot}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Display</h2>

  <div class="comp">
    <div class="comp-head"><h3>Avatar</h3><span class="tag">&lt;sui-avatar&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-avatar initials="MC"></sui-avatar>
        <sui-avatar name="Ada Lovelace" tone="primary"></sui-avatar>
        <sui-avatar name="Grace Hopper" shape="square" size="lg"></sui-avatar>
      </div>
      <sui-codeblock code={code.avatar}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Badge</h3><span class="tag">&lt;sui-badge&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-badge>Default</sui-badge>
        <sui-badge tone="success">Live</sui-badge>
        <sui-badge tone="primary" variant="solid">New</sui-badge>
        <sui-badge tone="destructive" variant="outline">Error</sui-badge>
      </div>
      <sui-codeblock code={code.badge}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Chip</h3><span class="tag">&lt;sui-chip&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-chip>Design</sui-chip>
        <sui-chip tone="primary" selected>Selected</sui-chip>
        <sui-chip removable>Removable</sui-chip>
      </div>
      <sui-codeblock code={code.chip}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Card</h3><span class="tag">&lt;sui-card&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-card>
          <span slot="header">ship-it</span>
          A card groups related content on a raised surface.
          <div slot="footer"><sui-button tone="primary" size="sm">Dispatch</sui-button></div>
        </sui-card>
      </div>
      <sui-codeblock code={code.card}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Icon</h3><span class="tag">&lt;sui-icon&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-icon name="rocket" size="lg"></sui-icon>
        <sui-icon name="sparkles" size="lg" tone="primary"></sui-icon>
        <sui-icon name="git-branch" size="lg" tone="success"></sui-icon>
      </div>
      <sui-codeblock code={code.icon}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Brand mark</h3><span class="tag">&lt;sui-brand-mark&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-brand-mark size="sm"></sui-brand-mark>
        <sui-brand-mark size="lg" label="Ship"></sui-brand-mark>
      </div>
      <sui-codeblock code={code.brandMark}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Code</h3><span class="tag">&lt;sui-code&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-code>const sum = (a, b) =&gt; a + b</sui-code></div>
      <sui-codeblock code={code.code}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Markdown</h3><span class="tag">&lt;sui-markdown&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-markdown value="Renders **bold**, _italic_, and [links](#)."></sui-markdown></div>
      <sui-codeblock code={code.markdown}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>JSON view</h3><span class="tag">&lt;sui-json-view&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-json-view data={jsonData}></sui-json-view></div>
      <sui-codeblock code={code.jsonView}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Diff</h3><span class="tag">&lt;sui-diff&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-diff from="role: viewer" to="role: admin"></sui-diff></div>
      <sui-codeblock code={code.diff}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Layout</h2>

  <div class="comp">
    <div class="comp-head"><h3>Cluster</h3><span class="tag">&lt;sui-cluster&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-cluster gap="2">
          <sui-badge>One</sui-badge>
          <sui-badge tone="primary">Two</sui-badge>
          <sui-badge tone="success">Three</sui-badge>
        </sui-cluster>
      </div>
      <sui-codeblock code={code.cluster}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Stack</h3><span class="tag">&lt;sui-stack&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-stack gap="2">
          <sui-badge tone="info">Item 1</sui-badge>
          <sui-badge tone="warning">Item 2</sui-badge>
          <sui-badge tone="success">Item 3</sui-badge>
        </sui-stack>
      </div>
      <sui-codeblock code={code.stack}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Separator</h3><span class="tag">&lt;sui-separator&gt;</span></div>
    <div class="demo">
      <div class="preview" style="flex-direction: column; align-items: stretch">
        <span>Section A</span>
        <sui-separator></sui-separator>
        <span>Section B</span>
      </div>
      <sui-codeblock code={code.separator}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Scroll area</h3><span class="tag">&lt;sui-scroll-area&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-scroll-area orientation="vertical" style="height:120px;width:300px;border:1px solid var(--border);border-radius:var(--radius-md)">
          <div style="padding:8px">
            <p>Line 1</p><p>Line 2</p><p>Line 3</p><p>Line 4</p>
            <p>Line 5</p><p>Line 6</p><p>Line 7</p><p>Line 8</p>
          </div>
        </sui-scroll-area>
      </div>
      <sui-codeblock code={code.scrollArea}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Navigation</h2>

  <div class="comp">
    <div class="comp-head"><h3>Link</h3><span class="tag">&lt;sui-link&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-link href="#">Documentation</sui-link>
        <sui-link href="#" tone="primary" variant="underline">Get started</sui-link>
        <sui-link href="#" external>External site</sui-link>
      </div>
      <sui-codeblock code={code.link}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Pagination</h3><span class="tag">&lt;sui-pagination&gt;</span></div>
    <div class="demo">
      <div class="preview"><sui-pagination page="2" total="97" page-size="10"></sui-pagination></div>
      <sui-codeblock code={code.pagination}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Navigation menu</h3><span class="tag">&lt;sui-navigation-menu&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-navigation-menu value="home">
          <sui-navigation-item value="home" active>Home</sui-navigation-item>
          <sui-navigation-item value="docs">Docs</sui-navigation-item>
          <sui-navigation-item value="api">API</sui-navigation-item>
        </sui-navigation-menu>
      </div>
      <sui-codeblock code={code.navMenu}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Tabs</h3><span class="tag">&lt;sui-tabs&gt;</span></div>
    <div class="demo">
      <div class="preview" style="align-items: stretch">
        <sui-tabs active="tp1" variant="underline">
          <sui-tab name="tp1" label="Overview"></sui-tab>
          <sui-tab name="tp2" label="Details"></sui-tab>
          <sui-tab-panel name="tp1">Overview panel content.</sui-tab-panel>
          <sui-tab-panel name="tp2">Details panel content.</sui-tab-panel>
        </sui-tabs>
      </div>
      <sui-codeblock code={code.tabPanel}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Tree view</h3><span class="tag">&lt;sui-tree-view&gt;</span></div>
    <div class="demo">
      <div class="preview">
        <sui-tree-view>
          <sui-tree-item label="src" expanded>
            <sui-tree-item label="components" leaf></sui-tree-item>
            <sui-tree-item label="views" expanded>
              <sui-tree-item label="page.sui" leaf></sui-tree-item>
              <sui-tree-item label="controller.ts" leaf></sui-tree-item>
            </sui-tree-item>
          </sui-tree-item>
          <sui-tree-item label="tests" leaf></sui-tree-item>
        </sui-tree-view>
      </div>
      <sui-codeblock code={code.treeView}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Disclosure</h2>

  <div class="comp">
    <div class="comp-head"><h3>Accordion</h3><span class="tag">&lt;sui-accordion&gt;</span></div>
    <div class="demo">
      <div class="preview" style="align-items: stretch">
        <sui-accordion value="compile">
          <sui-accordion-item value="what">
            <span slot="trigger">What is SUI?</span>
            <p>A web-component UI kit compiled ahead of time from <code>.sui</code> source.</p>
          </sui-accordion-item>
          <sui-accordion-item value="compile">
            <span slot="trigger">How does it compile?</span>
            <p>Each <code>.sui</code> file becomes an ESM custom element with a scoped shadow root.</p>
          </sui-accordion-item>
        </sui-accordion>
      </div>
      <sui-codeblock code={code.accordion}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Collapsible</h3><span class="tag">&lt;sui-collapsible&gt;</span></div>
    <div class="demo">
      <div class="preview" style="align-items: stretch">
        <sui-collapsible open>
          <sui-button slot="trigger" variant="outline" size="sm">Details</sui-button>
          <p>Content revealed when the trigger is toggled.</p>
        </sui-collapsible>
      </div>
      <sui-codeblock code={code.collapsible}></sui-codeblock>
    </div>
  </div>
</section>

<section class="cat">
  <h2>Data</h2>

  <div class="comp">
    <div class="comp-head"><h3>Table</h3><span class="tag">&lt;sui-table&gt;</span></div>
    <div class="demo">
      <div class="preview" style="align-items: stretch">
        <sui-table variant="slot" label="Team" hoverable>
          <tr slot="head"><th>Name</th><th>Role</th><th>Status</th></tr>
          <tr><td>Alice</td><td>Engineer</td><td><sui-badge tone="success" size="sm">Active</sui-badge></td></tr>
          <tr><td>Bob</td><td>Designer</td><td><sui-badge tone="warning" size="sm">Away</sui-badge></td></tr>
          <tr><td>Carol</td><td>PM</td><td><sui-badge tone="muted" size="sm">Offline</sui-badge></td></tr>
        </sui-table>
      </div>
      <sui-codeblock code={code.table}></sui-codeblock>
    </div>
  </div>

  <div class="comp">
    <div class="comp-head"><h3>Timeline</h3><span class="tag">&lt;sui-timeline&gt;</span></div>
    <div class="demo">
      <div class="preview" style="align-items: stretch">
        <sui-timeline>
          <sui-timeline-item tone="success" at="2026-06-01">
            <span slot="title">Deployed</span>
            Release shipped to production.
          </sui-timeline-item>
          <sui-timeline-item tone="info" at="2026-05-30">
            <span slot="title">Review passed</span>
            All checks green.
          </sui-timeline-item>
        </sui-timeline>
      </div>
      <sui-codeblock code={code.timeline}></sui-codeblock>
    </div>
  </div>
</section>
