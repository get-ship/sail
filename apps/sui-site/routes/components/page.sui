<!--
  /components — the component browser. A pack rail, category chips, and live
  search compose over one catalog (registry.ts); every tile below renders the
  REAL component — nothing on this page is a drawing of a component.

  The `lang` tiles are the complete 48-element L1 surface (the same list the
  l1-conformance gate renders on every commit), plus the two @ship/sui-fx
  actions. Each tile gates itself on `show.<key>()` (the zero-arg visibility
  read the controller derives from the three filters), so hiding a tile
  unmounts the live component and the grid packs itself. Every tile links to
  its /components/<slug> detail page.

  Overlay-family tiles (popover, dropdown, hover-card) show their TRIGGER —
  the panel is a native [popover] wired by popovertarget, so the tile stays
  honest: what you see closed is what a page shows closed.

  The .sui packs in the rail are floor-gated on this branch (their sources
  still carry raw style blocks this compiler rejects). This page will not
  draw imitations of them — selecting a gated pack states the gap instead.
-->
<column class="doc-wide" gap="3">
  <p class="eyebrow">Components</p>
  <row gap="3" align="center">
    <h1 sx="grow:1">Components</h1>
    <span class="mono" sx="text:xs fg:muted-foreground">{countLabel()}</span>
    <input placeholder="Search — try 'tab' or 'overlay'" bind:value={query} sx="max-w:panel-max-w-sm" />
  </row>
  <p sx="text:sm fg:muted-foreground">
    Every tile is the running component — type in it, press it, open it.
    The language's own elements need no import; the packs read the same tokens.
  </p>

  <row align="stretch" gap="4">
    <!-- ── Pack rail — a filter, not a hero ──────────────────────────── -->
    <column gap="1" sx="w:panel-min-w-md">
      <p class="eyebrow">Packs</p>
      {#for p of packs() key={p.id}}
        <button class="theme-chip" on:click={() => pickPack(p.id)} aria-pressed={packSel() === p.id ? 'true' : 'false'}>
          <column gap="0" sx="px:3 py:2">
            <row gap="2" align="center">
              <strong sx="text:sm grow:1">{p.label}</strong>
              {#if p.gated}
                <badge size="sm" tone="warning" variant="outline">gated</badge>
              {:else}
                <span class="mono" sx="text:xs fg:primary">{p.count}</span>
              {/if}
            </row>
            {#if p.sub}
              <p class="mono" sx="text:xs fg:muted-foreground">{p.sub}</p>
            {/if}
          </column>
        </button>
      {/for}
      <p sx="text:xs fg:muted-foreground leading:relaxed pt:2">
        Packs read the same tokens as the language — install one and it
        already matches your theme.
      </p>
    </column>

    <!-- ── Grid ──────────────────────────────────────────────────────── -->
    <column gap="3" sx="grow:3 min-w:0">
      <row gap="2">
        {#for c of cats() key={c}}
          <button size="sm" tone="primary" variant={catSel() === c ? 'solid' : 'ghost'} on:click={() => pickCat(c)}>{c}</button>
        {/for}
      </row>

      <grid cols="4" gap="3">
        <!-- ══ Inputs ═══════════════════════════════════════════════════ -->
        {#if show.button()}
          <card padding="none" data-tile="button" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="2" align="center">
                  <button variant="solid" tone="primary" motion:press={{ scale: 'press' }}>Solid</button>
                  <button variant="outline" tone="primary">Outline</button>
                </row>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/button" sx="text:sm weight:semibold">button</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.input()}
          <card padding="none" data-tile="input" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <input placeholder="Type — it's real" bind:value={name} />
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/input" sx="text:sm weight:semibold">input</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.textarea()}
          <card padding="none" data-tile="textarea" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <textarea placeholder="A few lines…"></textarea>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/textarea" sx="text:sm weight:semibold">textarea</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.select()}
          <card padding="none" data-tile="select" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <select>
                  <option>Engineering</option>
                  <option>Design</option>
                  <option>Research</option>
                </select>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/select" sx="text:sm weight:semibold">select</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.combobox()}
          <card padding="none" data-tile="combobox" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <combobox placeholder="Search fruit — type">
                  <option value="apple">Apple</option>
                  <option value="banana">Banana</option>
                  <option value="cherry">Cherry</option>
                  <option value="kiwi">Kiwi</option>
                </combobox>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/combobox" sx="text:sm weight:semibold">combobox</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.checkbox()}
          <card padding="none" data-tile="checkbox" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <label><input type="checkbox" bind:checked={agreed} /> I agree</label>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/checkbox" sx="text:sm weight:semibold">checkbox</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.radioGroup()}
          <card padding="none" data-tile="radio-group" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <radio-group>
                  <label><input type="radio" name="plan" checked /> Monthly</label>
                  <label><input type="radio" name="plan" /> Yearly</label>
                </radio-group>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/radio-group" sx="text:sm weight:semibold">radio-group</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.switchToggle()}
          <card padding="none" data-tile="switch" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="2" align="center">
                  <switch bind:checked={notify}></switch>
                  <p sx="text:xs fg:muted-foreground">{notify() ? 'notifying' : 'muted'}</p>
                </row>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/switch" sx="text:sm weight:semibold">switch</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.slider()}
          <card padding="none" data-tile="slider" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="2" align="center" sx="w:full">
                  <slider bind:value={volume} tone="primary" sx="grow:1"></slider>
                  <span class="mono" sx="text:xs fg:muted-foreground">{volume()}</span>
                </row>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/slider" sx="text:sm weight:semibold">slider</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.toggleGroup()}
          <card padding="none" data-tile="toggle-group" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <toggle-group>
                  <toggle value="left">Left</toggle>
                  <toggle value="center">Center</toggle>
                  <toggle value="right">Right</toggle>
                </toggle-group>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/toggle-group" sx="text:sm weight:semibold">toggle-group</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.field()}
          <card padding="none" data-tile="field" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <field>
                  <label for="tile-name">Name</label>
                  <input id="tile-name" placeholder="Ada Lovelace" />
                </field>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/field" sx="text:sm weight:semibold">field</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.label()}
          <card padding="none" data-tile="label" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview gap="1" sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <label for="tile-email" required>Email</label>
                <input id="tile-email" placeholder="ada@lovelace.dev" />
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/label" sx="text:sm weight:semibold">label</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.fieldset()}
          <card padding="none" data-tile="fieldset" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <fieldset>
                  <legend>Account</legend>
                  <input placeholder="Name" sx="w:full" />
                </fieldset>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/fieldset" sx="text:sm weight:semibold">fieldset</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.dropzone()}
          <card padding="none" data-tile="dropzone" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <card dropzone sx="p:3">Drop a file, or click</card>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/dropzone" sx="text:sm weight:semibold">dropzone</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.themePicker()}
          <card padding="none" data-tile="theme-picker" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="2" align="center">
                  <theme-picker></theme-picker>
                  <p sx="text:xs fg:muted-foreground">the real one — it themes this site</p>
                </row>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/theme-picker" sx="text:sm weight:semibold">theme-picker</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">inputs</span>
                </row>
              </column>
            </column>
          </card>
        {/if}

        <!-- ══ Feedback ═════════════════════════════════════════════════ -->
        {#if show.alert()}
          <card padding="none" data-tile="alert" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <alert tone="success"><strong>Saved.</strong> Changes are live.</alert>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/alert" sx="text:sm weight:semibold">alert</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.progressBar()}
          <card padding="none" data-tile="progress" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview gap="1" sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <progress value={volume()} max="100"></progress>
                <p sx="text:xs fg:muted-foreground">driven by the slider tile — one signal</p>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/progress" sx="text:sm weight:semibold">progress</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.meter()}
          <card padding="none" data-tile="meter" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <meter value="0.7"></meter>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/meter" sx="text:sm weight:semibold">meter</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.spinner()}
          <card padding="none" data-tile="spinner" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <center data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="3" align="center">
                  <spinner></spinner>
                  <spinner tone="primary"></spinner>
                  <spinner size="lg"></spinner>
                </row>
              </center>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/spinner" sx="text:sm weight:semibold">spinner</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.skeleton()}
          <card padding="none" data-tile="skeleton" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <row gap="2" align="center" sx="w:full">
                  <span skeleton shape="circle" sx="w:7 h:7"></span>
                  <column gap="1" sx="grow:1">
                    <span skeleton shape="text" size="sm"></span>
                    <span skeleton shape="text" size="sm"></span>
                  </column>
                </row>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/skeleton" sx="text:sm weight:semibold">skeleton</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.emptyState()}
          <card padding="none" data-tile="empty-state" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <empty-state variant="inline" size="sm">
                  <strong slot="title">No results</strong>
                  Try a different search.
                </empty-state>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/empty-state" sx="text:sm weight:semibold">empty-state</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.errorState()}
          <card padding="none" data-tile="error-state" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <error-state variant="inline" size="sm" code="ERR_TIMEOUT">The request timed out.</error-state>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/error-state" sx="text:sm weight:semibold">error-state</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.errorBoundary()}
          <card padding="none" data-tile="error-boundary" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview gap="1" sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <error-boundary message="This panel could not load.">
                  <card variant="outline" sx="p:2">
                    <p sx="text:xs fg:muted-foreground">wrapped subtree — healthy, so the boundary is invisible</p>
                  </card>
                </error-boundary>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/error-boundary" sx="text:sm weight:semibold">error-boundary</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">feedback</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.toast()}
          <card padding="none" data-tile="toast" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
