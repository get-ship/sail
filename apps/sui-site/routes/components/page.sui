                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">layout</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.scrollArea()}
          <card padding="none" data-tile="scroll-area" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <column data-preview sx="p:3 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <scroll-area sx="h:9 w:full pr:2">
                  <p sx="text:xs fg:muted-foreground">line one — scroll me</p>
                  <p sx="text:xs fg:muted-foreground">line two</p>
                  <p sx="text:xs fg:muted-foreground">line three</p>
                  <p sx="text:xs fg:muted-foreground">line four</p>
                  <p sx="text:xs fg:muted-foreground">line five</p>
                </scroll-area>
              </column>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/scroll-area" sx="text:sm weight:semibold">scroll-area</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="primary" variant="soft">language</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">layout</span>
                </row>
              </column>
            </column>
          </card>
        {/if}

        <!-- ══ @ship/sui-fx (actions) ═══════════════════════════════════ -->
        {#if show.fxSpotlight()}
          <card padding="none" data-tile="use:spotlight" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <div data-preview use:spotlight sx="p:4 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <p sx="text:xs fg:muted-foreground">move the pointer — a spotlight follows it</p>
              </div>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/spotlight" sx="text:sm weight:semibold">use:spotlight</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="muted" variant="soft">fx</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">effects</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
        {#if show.fxDotGrid()}
          <card padding="none" data-tile="use:dotGrid" sx="overflow:hidden" motion:enter={{ opacity: 'fade' }}>
            <column gap="0" sx="h:full">
              <div data-preview use:dotGrid sx="p:4 min-h:9 grow:1 border-b:subtle bg:surface-0">
                <p sx="text:xs fg:muted-foreground">an interactive dot matrix, behind this text</p>
              </div>
              <column gap="1" sx="px:3 py:2">
                <a class="mono" href="/components/dot-grid" sx="text:sm weight:semibold">use:dotGrid</a>
                <row gap="2" align="center" justify="between">
                  <badge size="sm" tone="muted" variant="soft">fx</badge>
                  <span class="mono" sx="text:xs fg:muted-foreground">effects</span>
                </row>
              </column>
            </column>
          </card>
        {/if}
      </grid>

      {#if gatedSel()}
        <card variant="outline" sx="p:4" motion:enter={{ opacity: 'fade' }}>
          <column gap="2">
            <row gap="2" align="center">
              <badge tone="warning" variant="outline">floor-gated</badge>
              <strong>{gatedLabel()} can't mount on this branch</strong>
            </row>
            <p sx="text:sm fg:muted-foreground leading:relaxed">
              {gatedSub()} ships {gatedWaiting()} components, but their sources
              still carry raw style blocks — and this compiler's floor rejects
              raw CSS, in packs as much as in pages. This browser doesn't fake
              tiles with drawings: the pack appears here the day it compiles.
            </p>
          </column>
        </card>
      {/if}
      {#if none()}
        <empty-state motion:enter={{ opacity: 'fade' }}>
          <strong slot="title">Nothing matches</strong>
          Clear a filter or two — or search for less.
        </empty-state>
      {/if}
    </column>
  </row>

  <row class="page-nav" gap="2">
    <a class="btn" href="/overview">← Introduction</a>
    <a class="btn btn-primary" href="/layout">Layout →</a>
  </row>
</column>
