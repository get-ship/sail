<!--
  Ship UI landing — a long-scroll pillar page. Each pillar is a full section
  with a WORKING centerpiece: motion deals, themes repaint the whole site,
  data filters and refetches, deck deploys, AI compiles. Scroll reveals use
  spring presets so the no-scroll-timeline fallback (Firefox) still reads as
  motion, not a blink.
-->
<column class="landing-wrap">
  <column class="hero kinetic-hero" gap="4">
    <center><p class="eyebrow">SHIP UI · 0.2.0</p></center>
    <h1 sx="text:display weight:bold tracking:tight">
      <strong class="rotator-slot">
        {#for w of word() key={w}}
          <b class="rotator" motion:enter={{ opacity: 'fade' }}>{w}</b>
        {/for}
      </strong>
      included.<br /><b class="accent">All of them.</b>
    </h1>
    <center>
      <p class="lead">
        One language with the whole interface inside it — built for agents to
        write and humans to review, with no way to drift off the design system.
      </p>
    </center>
    <row class="hero-cta" gap="2">
      <a variant="solid" tone="primary" href="/getting-started" motion:press={{ scale: 'press' }}>Get started</a>
      <a variant="default" href="/why">Why a language?</a>
    </row>
  </column>
</column>

<column class="marquee-band">
  <row class="track" gap="0">
    <p>NO RAW CSS ◆ SIGNALS BUILT IN ◆ 48 COMPONENTS ◆ 9 THEMES ◆ A11Y BY CONSTRUCTION ◆ NO RAW CSS ◆ SIGNALS BUILT IN ◆ 48 COMPONENTS ◆ 9 THEMES ◆ A11Y BY CONSTRUCTION ◆ NO RAW CSS ◆ SIGNALS BUILT IN ◆ 48 COMPONENTS ◆ 9 THEMES ◆ A11Y BY CONSTRUCTION ◆ NO RAW CSS ◆ SIGNALS BUILT IN ◆ 48 COMPONENTS ◆ 9 THEMES ◆ A11Y BY CONSTRUCTION ◆&nbsp;</p>
  </row>
</column>
<column class="marquee-band alt">
  <row class="track" gap="0">
    <p>forms + validation · live data · springs + tweens · ssr · hot reload · design tokens · forms + validation · live data · springs + tweens · ssr · hot reload · design tokens · forms + validation · live data · springs + tweens · ssr · hot reload · design tokens · forms + validation · live data · springs + tweens · ssr · hot reload · design tokens ·&nbsp;</p>
  </row>
</column>

<!-- ══ MOTION ═══════════════════════════════════════════════════════════ -->
<column class="pillar">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>MOTION</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>Real physics.<br />Zero choreography code.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      Springs solved at compile time and driven by the browser. The runtime
      holds exiting elements until their animation finishes, staggers siblings
      into a sequence, and ties motion to scroll — each one a directive, not a
      library you wire up.
    </p>
    {#if dealt()}
      <grid cols="4" gap="3">
        <card sx="p:4">
          <column gap="3" align="center">
            <p class="eyebrow">FIG. 01 · SPRING PHYSICS</p>
            <div sx="w:6 h:6 radius:full bg:primary" motion:loop={{ translate-y: 'spring:bouncy' }}></div>
            <p sx="text:sm fg:muted-foreground">a mass on a spring — overshoot, settle, forever</p>
            <code>motion:loop · spring:bouncy</code>
          </column>
        </card>
        <card sx="p:4">
          <column gap="3">
            <p class="eyebrow">FIG. 02 · STAGGER WAVE</p>
            <row gap="2" align="center" sx="min-h:9">
              <div sx="w:3 h:8 radius:sm bg:primary" motion:loop={{ translate-y: 'spring:gentle', stagger: '0.12s' }}></div>
              <div sx="w:3 h:8 radius:sm bg:primary opacity:75" motion:loop={{ translate-y: 'spring:gentle', stagger: '0.12s' }}></div>
              <div sx="w:3 h:8 radius:sm bg:primary" motion:loop={{ translate-y: 'spring:gentle', stagger: '0.12s' }}></div>
              <div sx="w:3 h:8 radius:sm bg:primary opacity:75" motion:loop={{ translate-y: 'spring:gentle', stagger: '0.12s' }}></div>
              <div sx="w:3 h:8 radius:sm bg:primary" motion:loop={{ translate-y: 'spring:gentle', stagger: '0.12s' }}></div>
            </row>
            <p sx="text:sm fg:muted-foreground">the delay BETWEEN siblings makes a wave</p>
            <code>motion:loop · stagger: '0.12s'</code>
          </column>
        </card>
        <card sx="p:4">
          <column gap="3" align="center">
            <p class="eyebrow">FIG. 03 · DRIFT</p>
            <div sx="w:7 h:7 radius:md bg:tone-primary-bg border:primary" motion:loop={{ rotate: 'spring:deliberate' }}></div>
            <p sx="text:sm fg:muted-foreground">ambient rotation, compositor-driven — off under reduced motion</p>
            <code>motion:loop · rotate</code>
          </column>
        </card>
        <card sx="p:4">
          <column gap="3">
            <p class="eyebrow">FIG. 04 · EXIT HOLD</p>
            <row gap="2">
              <badge tone="primary" motion:enter={{ scale: 'spring:gentle' }} motion:exit={{ opacity: 'fade-out' }}>a</badge>
              <badge tone="primary" motion:enter={{ scale: 'spring:gentle', stagger: '0.1s' }} motion:exit={{ opacity: 'fade-out' }}>b</badge>
              <badge tone="primary" motion:enter={{ scale: 'spring:gentle', stagger: '0.1s' }} motion:exit={{ opacity: 'fade-out' }}>c</badge>
            </row>
            <p sx="text:sm fg:muted-foreground">removed elements stay mounted until their exit finishes — press replay to watch them leave and return</p>
            <code>motion:exit</code>
          </column>
        </card>
      </grid>
    {/if}
    <row gap="2">
      <button on:click={replay} variant="solid" tone="primary" motion:press={{ scale: 'press' }}>Run the figures again</button>
      <a variant="ghost" href="/motion">The whole system →</a>
    </row>
  </column>
</column>

<!-- ══ STYLE & THEMES ═══════════════════════════════════════════════════ -->
<column class="pillar tinted">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>STYLE &amp; THEMES</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>Press a button.<br />The whole site repaints.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      Components read tokens, never colors, so a theme is a complete aesthetic
      — palette, radii, shadows, type — applied in one attribute. Not a demo
      panel: these buttons restyle every page you visit next.
    </p>
    <grid cols="4" gap="3">
      <button class="theme-chip" on:click={() => pick('ship-light')} aria-pressed={theme() === 'ship-light' ? 'true' : 'false'}>
        <column data-theme-preview="ship-light" gap="2" sx="p:4 bg:background fg:foreground">
          <strong>SHIP Light</strong>
          <row gap="2"><badge tone="primary">aa</badge><badge tone="success">bb</badge></row>
        </column>
      </button>
      <button class="theme-chip" on:click={() => pick('paper')} aria-pressed={theme() === 'paper' ? 'true' : 'false'}>
        <column data-theme-preview="paper" gap="2" sx="p:4 bg:background fg:foreground">
          <strong>Paper</strong>
          <row gap="2"><badge tone="primary">aa</badge><badge tone="success">bb</badge></row>
        </column>
      </button>
      <button class="theme-chip" on:click={() => pick('console')} aria-pressed={theme() === 'console' ? 'true' : 'false'}>
        <column data-theme-preview="console" gap="2" sx="p:4 bg:background fg:foreground">
          <strong>Console</strong>
          <row gap="2"><badge tone="primary">aa</badge><badge tone="success">bb</badge></row>
        </column>
      </button>
      <button class="theme-chip" on:click={() => pick('glass')} aria-pressed={theme() === 'glass' ? 'true' : 'false'}>
        <column data-theme-preview="glass" gap="2" sx="p:4 bg:background fg:foreground">
          <strong>Glass</strong>
          <row gap="2"><badge tone="primary">aa</badge><badge tone="success">bb</badge></row>
        </column>
      </button>
    </grid>
    <row gap="2">
      <a variant="ghost" href="/theming">Theming →</a>
      <a variant="ghost" href="/styling">Styling →</a>
    </row>
  </column>
</column>

<!-- ══ REACTIVE DATA ════════════════════════════════════════════════════ -->
<column class="pillar">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>REACTIVE DATA</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>State you can watch think.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      Signals for state, compositions for the patterns, and async that is
      three explicit states — a template physically cannot render data it has
      not confirmed. Type. Invite. Reload.
    </p>
    <row class="split" align="stretch">
      <column>
        <column class="live" gap="2" sx="p:5">
          <input placeholder="Filter people" bind:value={query} />
          {#for pn of filtered() key={pn.id}}
            <row gap="2" align="center" motion:enter={{ opacity: 'fade' }}>
              <avatar></avatar>
              <strong sx="grow:1">{pn.name}</strong>
              <badge tone={pn.status === 'active' ? 'success' : 'muted'}>{pn.status}</badge>
            </row>
          {/for}
          <row gap="2">
            <button on:click={invite} variant="solid" tone="primary" motion:press={{ scale: 'press' }}>Invite</button>
            <a variant="ghost" href="/reactivity">State →</a>
          </row>
        </column>
      </column>
      <column>
        <column class="live" gap="2" sx="p:5">
          {#while-loading of users}
            <row gap="2" align="center"><spinner></spinner> <p sx="text:sm fg:muted-foreground">loading…</p></row>
          {/while-loading}
          {#if users().kind === 'ok'}
            <row gap="2">
              {#for name of users().value key={name}}
                <badge motion:enter={{ opacity: 'fade' }}>{name}</badge>
              {/for}
            </row>
          {/if}
          <row gap="2">
            <button on:click={reload} motion:press={{ scale: 'press' }}>Reload</button>
            <a variant="ghost" href="/data">Data →</a>
          </row>
        </column>
      </column>
    </row>
  </column>
</column>

<!-- ══ DECK ═════════════════════════════════════════════════════════════ -->
<column class="pillar tinted">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>DECK</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>The app layer is already wired.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      File-routed pages, server rendering, hydration, bundling, live data and
      a hot-reloading dev loop — <a href="/deck">deck</a> is the half of the
      stack that runs what SUI writes. This site is a deck app.
    </p>
    <row class="split" align="stretch">
      <column>
        <column class="term" motion:view={{ opacity: 'fade', translate-x: 'spring:deliberate' }}>
          <p><em class="dim">$</em> deck dev</p>
          <p><b class="ok">▸</b> serving http://127.0.0.1:7878</p>
          <p><em class="dim">$</em> deck build</p>
          <p><b class="ok">✓</b> SSR'd 31 routes · hydrating bundles · static out</p>
        </column>
      </column>
      <column>
        <column class="live" gap="3" sx="p:5">
          <row gap="2" align="center">
            <badge tone={status() === 'live' ? 'success' : 'warning'}>{status()}</badge>
            <strong sx="grow:1">api-gateway · build {buildNo()}</strong>
            <button on:click={deploy} disabled={status() === 'rolling'} motion:press={{ scale: 'press' }}>
              {status() === 'rolling' ? 'Rolling…' : 'Deploy'}
            </button>
          </row>
          <progress value="72" max="100"></progress>
          <a variant="ghost" href="/deck">Deck →</a>
        </column>
      </column>
    </row>
  </column>
</column>

<!-- ══ COMPONENTS ═══════════════════════════════════════════════════════ -->
<column class="pillar">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>COMPONENTS</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>The hard parts are<br />already correct.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      Keyboard traversal, focus trapping, ARIA wiring, touch targets, theming —
      the things every team gets subtly wrong are built into the elements, and
      they compile away to native markup: your DOM ships a real
      <code>&lt;dialog&gt;</code> with the behavior attached, not a div
      pretending. Which is why an agent using them can't produce an
      inaccessible screen.
    </p>
    <row gap="3" align="center" motion:view={{ opacity: 'fade', translate-y: 'spring:bouncy' }}>
      <switch checked></switch>
      <slider sx="w:half"></slider>
      <badge tone="success">live</badge>
      <spinner></spinner>
      <button variant="soft" tone="primary">soft</button>
      <button variant="outline" tone="destructive">outline</button>
      <chip>chip</chip>
      <avatar></avatar>
    </row>
    <row gap="2">
      <a variant="ghost" href="/components">All forty-eight, running →</a>
      <a variant="ghost" href="/elements">How they compile away →</a>
    </row>
  </column>
</column>

<!-- ══ AI ═══════════════════════════════════════════════════════════════ -->
<column class="pillar tinted">
  <column class="inner" gap="4">
    <p class="eyebrow" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>AI</p>
    <h2 class="big" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>Agents can't break what<br />the language won't allow.</h2>
    <p class="blurb" motion:view={{ opacity: 'fade', translate-y: 'spring:gentle' }}>
      The compiler is the guardrail: off-system styles and untyped props do
      not build, so agent output that compiles is UI you can trust. MCP
      tooling and a scored authoring eval close the loop.
    </p>
    <column class="term" sx="max-w:panel-max-w-md" motion:view={{ opacity: 'fade', translate-y: 'spring:deliberate' }}>
      <p><b class="bad">✕</b> <em class="dim">style="color:#ff0000"</em> <b class="bad">rejected</b></p>
      <p><b class="bad">✕</b> <em class="dim">&lt;div onClick=…&gt;</em> <b class="bad">rejected</b></p>
      <p><b class="ok">✓</b> sx="bg:tone-bg fg:tone-fg" <b class="ok">themed · a11y</b></p>
    </column>
    <row gap="2">
      <a variant="ghost" href="/ai">Agent tooling →</a>
    </row>
  </column>
</column>

<column class="landing-wrap">
  <p class="wordmark" motion:scroll={{ scale: 'spring:deliberate' }}>SHIP</p>
</column>
