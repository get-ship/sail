<!--
  /deck/getting-started — adapted from packages/deck/docs/routes/getting-started/page.sui.
  Snippets live in ./snippets so literal braces in example code never get scope-scanned.
-->
<controller>
import { controller, type ViewScope } from '@ship/sui-runtime'
import type { Scope } from './page.sui'
import { pageExample, controllerExample, devCmd } from './snippets'

export default controller({
  setup: (_ctx: ViewScope<Scope>) => ({ pageExample, controllerExample, devCmd }),
})
</controller>

<article sx="max-w-breakpoint-tablet mx-auto">
  <p sx="font-mono text-xs uppercase tracking-wide text-accent mb-2">Introduction</p>
  <h1>Getting started</h1>
  <p sx="text-lg text-muted-foreground leading-relaxed">You need the <code>deck</code> CLI and a folder. No project scaffold, no install, no config to start.</p>

  <h2>1. A page is a file</h2>
  <p>Create <code>routes/page.sui</code>. Whatever markup it holds is your page.</p>
  <code-block code={pageExample} lang="sui"></code-block>

  <h2>2. Add a controller</h2>
  <p>When the page needs state, add a <code>&lt;controller&gt;</code> block to the same file. It returns a scope the template reads by name — one file, template and state together.</p>
  <code-block code={controllerExample} lang="sui"></code-block>

  <h2>3. Run the dev server</h2>
  <code-block code={devCmd} lang="bash"></code-block>
  <alert tone="info">
    <strong>No build step to develop.</strong> deck compiles <code>.sui</code> in-process and serves the SPA with HMR — edit a route and it soft-reloads with state preserved.
  </alert>

  <row sx="mt-8 pt-4 border-t border-t-border">
    <a href="/deck">← Overview</a>
    <a href="/deck/routing">File routing →</a>
  </row>
</article>
