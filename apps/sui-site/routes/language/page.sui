<!--
  /language — the new authoring surface, shown live. Every control below is
  a plain HTML tag (<button>, <input>) or a language element (<spinner>,
  <icon>, <label>, <separator>) — no components, no sx, no <style>. The
  design system is applied by the framework stylesheet (tone/size contracts
  + control skin + stdlib element skins), delivered as a bundled asset.

  The buttons use the BARE-ENUM SHORTHAND: `<button primary solid>` desugars
  to `tone="primary" variant="solid"`. Every colour is a design token, so
  the whole page recolours when the theme changes — try the theme toggle.
-->
<column class="doc" gap="8">
  <column gap="2">
    <p class="eyebrow">The language</p>
    <h1>The web, with default styles</h1>
    <p class="lead">
      These are not components you import — they are plain tags the compiler
      lowers and the framework styles. You write the tag and pick a tone; the
      design system, the states, and the theme are already applied.
    </p>
  </column>

  <separator></separator>

  <!-- BUTTONS — the design system at full flex. -->
  <column gap="6">
    <column gap="3">
      <label size="sm">solid — one line each: &lt;button primary solid&gt;</label>
      <row gap="3" align="center">
        <button solid>Default</button>
        <button primary solid>Primary</button>
        <button success solid>Success</button>
        <button warning solid>Warning</button>
        <button destructive solid>Destructive</button>
      </row>
    </column>

    <column gap="3">
      <label size="sm">soft</label>
      <row gap="3" align="center">
        <button soft>Default</button>
        <button primary soft>Primary</button>
        <button success soft>Success</button>
        <button warning soft>Warning</button>
        <button destructive soft>Destructive</button>
      </row>
    </column>

    <column gap="3">
      <label size="sm">outline &amp; ghost</label>
      <row gap="3" align="center">
        <button primary outline>Outline</button>
        <button success outline>Outline</button>
        <button destructive outline>Outline</button>
        <button primary ghost>Ghost</button>
        <button ghost>Ghost</button>
      </row>
    </column>

    <column gap="3">
      <label size="sm">sizes &amp; states</label>
      <row gap="3" align="center">
        <button primary solid xs>xs</button>
        <button primary solid sm>sm</button>
        <button primary solid md>md</button>
        <button primary solid lg>lg</button>
        <button primary solid disabled>disabled</button>
        <button primary solid>
          <spinner size="sm"></spinner>
          Loading
        </button>
      </row>
    </column>
  </column>

  <separator></separator>

  <!-- FORM — plain inputs + native labels, framework-skinned. -->
  <column gap="4">
    <label size="sm">form controls</label>
    <column gap="2">
      <label>Email address</label>
      <input type="email" placeholder="you@example.com" />
    </column>
    <column gap="2">
      <label required>Password</label>
      <input type="password" placeholder="••••••••" />
    </column>
    <row gap="3" align="center">
      <button primary solid>Sign in</button>
      <button ghost>Cancel</button>
    </row>
  </column>

  <separator></separator>

  <!-- The minimal primitives, for completeness. -->
  <column gap="3">
    <label size="sm">spinner · icon</label>
    <row gap="6" align="center">
      <spinner size="sm"></spinner>
      <spinner></spinner>
      <spinner tone="primary" size="lg"></spinner>
      <icon size="lg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></icon>
    </row>
  </column>
</column>
