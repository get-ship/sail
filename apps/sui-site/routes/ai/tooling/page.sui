<!--
  /ai/tooling — the LSP and the CLI, adapted from
  packages/sui/tutorial/src/prose/10-lsp-cli/index.md. The source frames the
  tooling as "one Rust grammar, two binary delivery channels — the sui-lint
  fast check and the sui-compiler full compile"; that's the spine here.
-->

<controller>
// /ai/tooling — the LSP / CLI surface, adapted from the 10-lsp-cli tutorial
// lesson. Snippets live in ./snippets so literal braces (e.g. the
// `.lsp.json` payload) never leak into the inferred scope.
import { controller, type ViewScope } from '@ship/sail-runtime'
import type { Scope } from './page.sui'
import { lintCmd, lintOutput, compileCmd, lspJson } from './snippets'

export default controller((_ctx: ViewScope<Scope>) => ({ lintCmd, lintOutput, compileCmd, lspJson }))
</controller>

<article sx="max-w-breakpoint-tablet mx-auto">
  <p sx="font-mono text-xs uppercase tracking-wide text-accent mb-2">AI</p>
  <h1>The LSP — diagnostics on tap</h1>
  <p sx="text-lg text-muted-foreground leading-relaxed">
    SUI's language intelligence is the Rust compiler —
    <code>sui_compiler::analyze</code> (diagnostics + scope symbols + dependencies)
    and <code>check_all</code> (every diagnostic, not just the first). It's the
    same grammar the build uses, exposed to agents through two binary commands.
  </p>

  <h2>Fast per-edit lint</h2>
  <code-block code={lintCmd} lang="bash"></code-block>
  <p>
    Exits 1 on findings. Covers grammar errors, missing bindings, unstable-key
    warnings, purity violations, CSS token errors, and prop-value mismatches.
    Run this in your edit loop — it's the cheapest check and catches the most
    common authoring errors.
  </p>

  <p>Output on a file with issues:</p>
  <code-block code={lintOutput} lang="text"></code-block>
  <p>
    <code>severity</code> is <code>error</code> (compile-blocking) or
    <code>warning</code> (compiles but suspicious). The rule id is in brackets
    — useful for filtering or mapping to your editor's diagnostic provider.
    Positions are 1-based.
  </p>

  <h2>Full compile</h2>
  <code-block code={compileCmd} lang="bash"></code-block>
  <p>
    Runs the full pipeline (parse → check → lint → lower → emit) and aborts on
    errors. More thorough than the lint check — catches lowering-level issues
    the fast pass misses. Also emits the compiled JS, <code>.sui.d.ts</code>,
    and SSR HTML into the project mirror tree. Use this after the lint check
    is clean.
  </p>

  <h2>The <code>sui-lsp</code> binary (editors)</h2>
  <p>
    For editors — VS Code, Neovim, Helix, or any LSP-capable client — the
    <code>sui-lsp</code> binary provides the same intelligence over stdio.
    Same Rust grammar; hover, completion, and go-to-definition on top. Register
    it for <code>.sui</code> files with a <code>.lsp.json</code> at your
    project root and any LSP-capable editor attaches automatically:
  </p>
  <code-block code={lspJson} lang="json"></code-block>

  <h2>Why this matters</h2>
  <p>
    There is <strong>one</strong> source of truth — the Rust
    <code>sui_compiler</code> grammar — flowing through multiple surfaces:
  </p>
  <ul>
    <li><strong><code>sui-lint</code></strong> — fast per-edit binary for agents and CI</li>
    <li><strong><code>sui-compiler</code></strong> — full compile with emit, used by the deck bundler</li>
    <li><strong><code>sui-lsp</code></strong> — LSP server for editors over stdio</li>
    <li><strong>WASM compiler</strong> (<code>@ship/sail-compiler-wasm</code>) — in-browser diagnostics for the docs and any embedded editor</li>
  </ul>
  <p>
    A human typing in the docs site, an agent running <code>sui-lint</code>,
    and an editor on your laptop all see the <em>same</em> diagnostics —
    because they're all the same compiler. No second grammar to drift out of
    sync.
  </p>

  <row sx="mt-8 pt-4 border-t border-t-border">
    <a href="/ai/authoring">← Authoring</a>
    <a href="/ai/eval">Eval →</a>
  </row>
</article>
