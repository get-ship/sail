<!--
  /tutorial/[slug] — INTERACTIVE lesson, the "Tutorial — refined (2a)" layout.
  A two-column split:
    LEFT  = the lesson: header row (eyebrow + "Lesson NN / 25"), a progress
            STEPPER (one segment per lesson), the h1 / lead / prose, and a
            bottom-pinned nav bar (All lessons ← | → next lesson).
    RIGHT = the playground: a matched header row (eyebrow + Reset + Show
            solution), an EDITOR CARD (<sui-tabs> template.sui / controller.ts /
            diff over <sui-code-editor>), and a PREVIEW CARD (live status dot +
            Run, the sandboxed <iframe src="/tut-host.html">, and an OUTPUT
            CONSOLE that logs real compile / run / preview-console events).

  All wiring lives in the controller + ../../src/tutorial-boot.ts. This template
  is a pure read of state; the controller orchestrates wasm compile, postMessage,
  iframe lifecycle, theme sync, and the console log.

  Sibling style.css carries the visual rules (the bundler drops inline
  `<style>` in a `page.sui`).
-->
<div class="tut-page tut-split">
  <div class="tut-lesson">
    <div class="tut-lesson-scroll">
      <header class="tut-lesson-head">
        <div class="tut-head-row">
          <p class="tut-eyebrow">— Tutorial</p>
          <span class="tut-lesson-count">Lesson {lessonNumLabel()} / {totalLessons()}</span>
        </div>

        <nav class="tut-stepper" aria-label="Lesson progress">
          {#for step of steps() key={step.slug}}
            <a class={step.cls} href={step.href} title={step.title} aria-current={step.current ? 'step' : null}></a>
          {/for}
        </nav>

        <h1 class="tut-title">{title()}</h1>
        <p class="tut-lead">{description()}</p>
      </header>

      <div class="prose-wrap">
        <sui-prose html={proseHtml()}></sui-prose>
      </div>
    </div>

    <nav class="tut-bottom-nav">
      <a class="tut-navbtn tut-navbtn--ghost" href="/tutorial">← All lessons</a>
      {#if hasNext()}
        <a class="tut-navbtn tut-navbtn--primary" href={nextHref()}>{nextTitle()}</a>
      {/if}
    </nav>
  </div>

  <div class="tut-app-root" bind:this={rootEl}>
    <div class="tut-play-head">
      <p class="tut-eyebrow tut-eyebrow--muted">— Playground</p>
      <div class="tut-actions">
        <button data-action="reset" ghost sm>↺ Reset</button>
        <button data-action="solution" outline primary sm>Show solution</button>
      </div>
    </div>

    <section class="tut-pane tut-pane--editor">
      <div class="tut-pane-bar">
        <sui-tabs active="template" variant="pill" size="sm" class="tut-tabs">
          <sui-tab name="template">template.sui</sui-tab>
          <sui-tab name="controller">controller.ts</sui-tab>
          <sui-tab name="diff">diff</sui-tab>
        </sui-tabs>
      </div>
      <div class="tut-editor-host">
        <sui-tab-panel name="template" active>
          <sui-code-editor
            class="tut-editor"
            data-pane="template"
            language="sui"
            size="md"
          ></sui-code-editor>
        </sui-tab-panel>
        <sui-tab-panel name="controller" hidden>
          <sui-code-editor
            class="tut-editor"
            data-pane="controller"
            language="typescript"
            size="md"
          ></sui-code-editor>
        </sui-tab-panel>
        <sui-tab-panel name="diff" hidden>
          <div class="tut-diff-wrap">
            <div class="tut-diff-row">
              <div class="tut-diff-label">template.sui</div>
              <sui-diff data-pane="template"></sui-diff>
            </div>
            <div class="tut-diff-row">
              <div class="tut-diff-label">controller.ts</div>
              <sui-diff data-pane="controller"></sui-diff>
            </div>
          </div>
        </sui-tab-panel>
      </div>
    </section>

    <section class="tut-pane tut-pane--preview">
      <div class="tut-pane-bar tut-preview-bar">
        <div class="tut-live">
          <span dot class="tut-status-dot" tone="success" pulse size="sm" role="img" aria-label="ready"></span>
          <span class="tut-live-label">Preview · live</span>
        </div>
        <button data-action="run" outline primary sm>▶ Run</button>
      </div>
      <div class="tut-preview-host">
        <iframe class="tut-preview" data-base-src="/tut-host.html" title="Tutorial preview" sandbox="allow-scripts allow-same-origin"></iframe>
      </div>
      <div class="tut-console" role="log" aria-live="polite" aria-label="Preview console">
        <div class="tut-console-lines"></div>
      </div>
    </section>
  </div>
</div>
