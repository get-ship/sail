<!--
  /tutorial/[slug] — an INTERACTIVE lesson (svelte.dev/tutorial-style), ported
  from ship-marketing's proven TutorialApp. Prose renders ABOVE two panes:
    LEFT  = editor: <sui-tabs> (template.sui / controller.ts / diff) over
            a <sui-code-editor> per pane, with Reset + Show-solution actions.
            The editor is `<sui-code-editor>` (CodeMirror 6 wrapped as a SUI
            primitive), NOT a textarea — per spec, no native text surfaces
            anywhere on the sui-site.
    RIGHT = a sandboxed <iframe src="/tut-host.html"> preview that compiles
            + RUNS the lesson live in full isolation.

  All wiring lives in the controller + ../../src/tutorial-boot.ts. The page
  is pure markup; the controller orchestrates wasm compile, postMessage,
  iframe lifecycle, theme sync.

  Sibling style.css carries the visual rules (the bundler drops inline
  `<style>` in a `page.sui`).
-->
<div class="doc">
  <header class="tut-header">
    <p class="eyebrow">Tutorial</p>
    <h1 class="tut-title">{title()}</h1>
    <p class="lead">{description()}</p>
  </header>

  <div class="prose-wrap">
    <sui-prose html={proseHtml()}></sui-prose>
  </div>

  <div class="tut-app-root" bind:this={rootEl}>
    <section class="tut-pane tut-pane--editor">
      <div class="tut-pane-bar">
        <sui-tabs active="template" variant="pill" size="sm" class="tut-tabs">
          <sui-tab name="template">template.sui</sui-tab>
          <sui-tab name="controller">controller.ts</sui-tab>
          <sui-tab name="diff">diff</sui-tab>
        </sui-tabs>
        <div class="tut-actions">
          <sui-button data-action="reset" variant="ghost" size="sm">↺ Reset</sui-button>
          <sui-button data-action="solution" variant="soft" tone="primary" size="sm">Show solution</sui-button>
        </div>
      </div>
      <div class="tut-editor-host">
        <sui-tab-panel name="template" active>
          <sui-code-editor
            class="tut-editor"
            data-pane="template"
            language="sui"
            size="md"
          ></sui-code-editor>
        </sui-tab-panel>
        <sui-tab-panel name="controller" hidden>
          <sui-code-editor
            class="tut-editor"
            data-pane="controller"
            language="typescript"
            size="md"
          ></sui-code-editor>
        </sui-tab-panel>
        <sui-tab-panel name="diff" hidden>
          <div class="tut-diff-wrap">
            <div class="tut-diff-row">
              <div class="tut-diff-label">template.sui</div>
              <sui-diff data-pane="template"></sui-diff>
            </div>
            <div class="tut-diff-row">
              <div class="tut-diff-label">controller.ts</div>
              <sui-diff data-pane="controller"></sui-diff>
            </div>
          </div>
        </sui-tab-panel>
      </div>
    </section>

    <section class="tut-pane tut-pane--preview">
      <div class="tut-pane-bar">
        <sui-status-dot class="tut-status-dot" tone="muted" size="sm" label="ready"></sui-status-dot>
        <sui-button data-action="run" variant="ghost" size="sm">↻ Run</sui-button>
      </div>
      <div class="tut-error" hidden>
        <div class="tut-error-title">Compile error</div>
        <pre class="tut-error-msg"></pre>
      </div>
      <div class="tut-preview-host">
        <iframe class="tut-preview" data-base-src="/tut-host.html" title="Tutorial preview" sandbox="allow-scripts allow-same-origin"></iframe>
      </div>
    </section>
  </div>

  <div class="page-nav">
    <a class="btn" href={prevHref()}>{prevLabel()}</a>
    <a class="btn" href={nextHref()}>{nextLabel()}</a>
  </div>
</div>
