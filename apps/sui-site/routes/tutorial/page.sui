<!--
  /tutorial — the table of contents: nine lessons in four chapters,
  each a link into /tutorial/[slug]. Data is generated from
  packages/sui/tutorial by scripts/gen-tutorial.mjs.
-->

<controller>
// /tutorial — the table of contents. The grouped/ordered lesson list comes
// precomputed from `tutorial-data` (generated by scripts/gen-tutorial.mjs
// out of packages/sui/tutorial) and is handed to the template unchanged.
import { controller, type ViewScope } from '@ship/sui-runtime'
import type { Scope } from './page.sui'
import { TUTORIAL_GROUPS, TUTORIAL_LESSONS, type TutorialGroup } from '../../src/tutorial-data'

export default controller({
  scope: (_ctx: ViewScope<Scope>) => ({
    groups: (): TutorialGroup[] => TUTORIAL_GROUPS,
    total: (): number => TUTORIAL_LESSONS.length,
  }),
})
</controller>

<column sx="max-w-breakpoint-tablet mx-auto" gap="5">
  <p sx="font-mono text-xs uppercase tracking-wide text-accent mb-2">Tutorial</p>
  <h1>Learn SUI</h1>
  <p sx="text-lg text-muted-foreground leading-relaxed">
    Nine hands-on lessons — one per decision surface the language kept, then
    the loop it exists for: agents author, humans review. Each lesson pairs a
    starter to edit with a solved screen running live.
  </p>

  {#for group of groups() key={group.chapter}}
    <column gap="3">
      <h2>{group.title}</h2>
      <column gap="2">
        {#for lesson of group.lessons key={lesson.slug}}
          <a href={lesson.href}
             sx="p-4 rounded-lg border border-border bg-surface-1 hover:bg-surface-2 hover:border hover:border-border-strong">
            <row gap="3" align="center">
              <badge tone="primary" variant="soft">{lesson.order}</badge>
              <column gap="1" sx="grow-1">
                <strong>{lesson.title}</strong>
                <small sx="text-muted-foreground">{lesson.description}</small>
              </column>
            </row>
          </a>
        {/for}
      </column>
    </column>
  {/for}

  <row sx="mt-8 pt-4 border-t border-t-border">
    <a variant="default" href="/reactivity">← State</a>
    <a variant="solid" tone="primary" href="/tutorial/01-a-page-is-markup">Start lesson 1 →</a>
  </row>
</column>
