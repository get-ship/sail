<!--
  <sui-codeblock> — a syntax-highlighted code block for the docs. Takes the
  source as a `code` prop; the controller highlights it (escaping the source)
  and sets it via bindHtml, mirroring how <sui-markdown> renders. Self-styled
  in shadow (the document `.code` rules don't reach here), using the
  --syntax-* theme tokens so colours follow light/dark.
-->
<component>{
  props: {
    code: '',
    lang: 'sui',
  },
}</component>
<style>
  .sui-codeblock { display: block; }
  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
    color: var(--foreground);
  }
  .tok-tag { color: var(--syntax-tag); }
  .tok-attr { color: var(--syntax-attr); }
  .tok-string { color: var(--syntax-string); }
  .tok-comment { color: var(--syntax-comment); font-style: italic; }
  .tok-keyword { color: var(--syntax-keyword); }
  .tok-fn { color: var(--syntax-function); }
  .tok-number { color: var(--syntax-number); }
  .tok-bind { color: var(--syntax-function); }
</style>

<pre class="pre" bind:this={preEl}></pre>
