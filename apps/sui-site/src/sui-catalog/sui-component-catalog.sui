<!--
  <sui-component-catalog> — the `/components` gallery index for the SUI site.

  A centered column: a hero (eyebrow + display title + lead), a centered
  search field, a centered row of pack-filter chips, then the component
  card grid. Every component links to its /components/<tag> detail page and
  shows a LIVE specimen mounted into a framed preview stage.

  Layout is the library dogfooding itself — structure comes from primitives,
  never bespoke CSS:
    <sui-stack>    the vertical page rhythm (hero → search → chips → grid)
    <sui-cluster>  centers the search field, the pack chips, and each card's
                   meta row + preview stage
    <sui-grid>     the responsive auto-fill card gallery (min="lg" gap="4")

  Filtering is reactive without re-rendering: the controller exposes a
  `query` signal (two-way bound to <sui-input>) and an `activePack` signal;
  a card's `visible(entry)` derives from both and drives `attr:hidden`, so
  the one-shot live-preview mount (in the controller) is never disturbed.

  Data source: the build-time CEM at apps/sui-site/components.gen.ts. Only
  the visual surface (framing, tints, font tokens) lives in this stylesheet;
  every value is a design token — no literal colours, no ad-hoc grid/flex.
-->
<style>
  :host {
    display: block;
    max-width: 74rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero { text-align: center; }
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--primary);
    margin-bottom: var(--space-3);
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 2.85rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    color: var(--foreground);
    margin: 0 0 var(--space-4);
  }
  .lead {
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 52ch;
    margin: 0 auto;
  }

  /* ── Search field ──────────────────────────────────────────────────── */
  .search {
    width: 35rem;
    max-width: 100%;
  }
  .search-glyph {
    color: var(--muted-foreground);
    font-size: var(--text-md);
  }

  /* ── Pack chips ────────────────────────────────────────────────────── */
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .chip:hover { border-color: var(--border-strong); color: var(--foreground); }
  .chip-on {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .chip-count { margin-left: var(--space-2); opacity: 0.7; }

  /* ── Cards ─────────────────────────────────────────────────────────── */
  .cell {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .cell[hidden] { display: none; }
  .cell:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  /* Preview stage — bounded, tinted, clipped. <sui-cluster> centers the
     mounted specimen; this rule owns the framed surface. */
  .stage {
    height: 12rem;
    overflow: hidden;
    padding: var(--space-3);
    background: color-mix(in oklch, var(--primary) 6%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cell-foot { padding: var(--space-3) var(--space-4) var(--space-4); }
  .cell-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .cell-props {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .cell-blurb {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  /* Empty / fallback states */
  .preview-empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .no-results {
    text-align: center;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-6) 0;
  }
</style>

<sui-stack class="page" gap="6" data-test="catalog">
  <div class="hero" data-test="catalog-hero">
    <span class="eyebrow">— {totalComponents()} components · {totalPacks()} packs</span>
    <h1 class="title">Component library</h1>
    <p class="lead">Every primitive in the Ship set. Batteries-included, on-brand, and compiled to standard web components.</p>
  </div>

  <sui-cluster class="search-row" justify="center">
    <sui-input
      class="search"
      type="search"
      tone="primary"
      placeholder="Search 74 components…"
      aria-label="Search components"
      on:sui-input={onSearch}
      data-test="catalog-search"
    >
      <span slot="leading" class="search-glyph" aria-hidden="true">⌕</span>
    </sui-input>
  </sui-cluster>

  <sui-cluster class="packs" justify="center" gap="2" data-test="catalog-packs">
    {#for p of packs() key={p.id}}
      <button
        type="button"
        class="chip"
        class:chip-on={activePack() === p.id}
        on:click={() => setPack(p.id)}
        attr:data-pack={p.id}
        data-test="catalog-pack-chip"
      >
        <span class="chip-label">{p.label}</span>
        <span class="chip-count">{p.count}</span>
      </button>
    {/for}
  </sui-cluster>

  <sui-grid class="grid" min="lg" gap="4" data-test="catalog-grid">
    {#for c of components() key={c.tag}}
      <a
        class="cell"
        href={'/components/' + c.tag}
        attr:data-tag={c.tag}
        attr:hidden={c.hidden() ? true : null}
        data-test="catalog-cell"
      >
        <sui-cluster class="stage" align="center" justify="center" attr:data-preview-for={c.tag}></sui-cluster>
        <div class="cell-foot">
          <sui-cluster class="cell-meta" justify="between" align="baseline" gap="2">
            <span class="cell-tag" data-test="catalog-tag">{c.tag}</span>
            <span class="cell-props">{c.propCount} props</span>
          </sui-cluster>
          {#if c.description}
            <p class="cell-blurb">{c.description}</p>
          {/if}
        </div>
      </a>
    {/for}
  </sui-grid>

  {#if visibleCount() === 0}
    <p class="no-results" data-test="catalog-empty">No components match “{query()}”.</p>
  {/if}
</sui-stack>
