<!--
  <sui-component-catalog> — `/components` index for the SUI site.

  Renders the build-time `COMPONENTS_CATALOG` (a flat CEM aggregated from
  every `<sui-*>` pack the site depends on), grouped by source package, with
  live previews of every component actually registered in the bundle, the CEM
  metadata (props / slots / events), and one-click links into a deep viewer.

  Sourced from `apps/sui-site/components.gen.ts` — emitted by `deck build`'s
  build_assets pass. Framework-pure (no ship-platform deps).
-->
<style>
  :host {
    display: block;
    /* Page padding — comfortable on the sides + room to breathe at the
       bottom. The `fullscreen` route variant on the shell strips
       side padding for component viewer / tutorial, but the catalog
       inherits the standard 6 + 7 spacing. */
    padding: var(--space-6) var(--space-7) var(--space-8);
  }

  .cat-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
  .cat-head h1 {
    font-family: var(--font-display, var(--font-body));
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight, -0.02em);
    margin: 0;
    color: var(--foreground);
  }
  .cat-sub {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .pack {
    margin-bottom: var(--space-7);
  }
  .pack-h {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .pack-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }
  .pack-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  /* Content-driven grid: dense auto-flow + per-cell column / row spans
     driven by the `size` class on each cell. Big components
     (calendar, table, tree, code-editor) span two columns / two rows
     and get the room they need; small ones (status-dot, badge, switch,
     separator) shrink to a single column. The 280px min stays for
     `normal` / `wide` cells; `tall` is 280×~360 minimum so the cell
     preview has headroom; `compact` is 220px min so the cell packs
     tighter. `auto-flow: dense` backfills gaps when a `wide` cell
     can't fit a sibling. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-4);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
    /* Cells occupy the same slot in the grid by default — overrides
       below. `wide` spans 2 columns, `tall` spans 2 rows. */
    grid-column: span 1;
    grid-row: span 1;
  }
  .cell.wide { grid-column: span 2; }
  .cell.tall { grid-row: span 2; }
  @media (max-width: 720px) {
    .cell.wide { grid-column: span 1; }
    .cell.tall { grid-row: span 1; }
  }
  .cell.compact {
    min-height: 0;
  }
  .cell.compact .cell-preview {
    min-height: var(--space-8);
    padding: var(--space-2) var(--space-3);
  }
  .cell:hover {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 6%, var(--surface-1));
    transform: translateY(-1px);
  }

  .cell-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .cell-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
  }

  .cell-desc {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* The preview cell: the area that holds the mounted custom element.
     Heights are content-driven: a `compact` cell is short, a `tall`
     cell is generous (calendar / table need vertical space). */
  .cell-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 7rem;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-2);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    overflow: auto;
  }
  .cell.wide .cell-preview { min-height: 9rem; }
  .cell.tall .cell-preview { min-height: 22rem; align-items: flex-start; justify-content: flex-start; }

  .preview-empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .meta-row {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  .meta-label {
    flex: 0 0 var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .meta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--foreground);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-1);
  }
  .meta-none {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
</style>

<section class="cat-head" data-test="catalog-head">
  <h1>Component library</h1>
  <span class="cat-sub">{totalComponents()} components · {totalPacks()} packs</span>
</section>

{#for group of groups() key={group.id}}
  <section class="pack" data-test="catalog-pack" attr:data-pack={group.pkg}>
    <header class="pack-h">
      <span class="pack-name">{group.pkg}</span>
      <span class="pack-count">{group.count}</span>
    </header>
    <div class="grid">
      {#for c of group.components key={c.tag}}
        <a class={'cell ' + c.size} data-test="catalog-cell" attr:data-tag={c.tag} attr:data-size={c.size} href={'/components/' + c.tag}>
          <span class="cell-tag" data-test="catalog-tag">&lt;{c.tag}&gt;</span>
          {#if c.description}
            <p class="cell-desc">{c.description}</p>
          {/if}
          <div class="cell-preview" attr:data-preview-for={c.tag}></div>
          <dl class="meta">
            <div class="meta-row">
              <dt class="meta-label">props</dt>
              <dd class="meta-chips">
                {#if c.props.length}
                  {#for p of c.props key={p.name}}<span class="chip" attr:title={p.type}>{p.name}</span>{/for}
                {:else}
                  <span class="meta-none">—</span>
                {/if}
              </dd>
            </div>
            {#if c.slots.length}
              <div class="meta-row">
                <dt class="meta-label">slots</dt>
                <dd class="meta-chips">
                  {#for s of c.slots key={s.name}}<span class="chip">{s.name}</span>{/for}
                </dd>
              </div>
            {/if}
            {#if c.events.length}
              <div class="meta-row">
                <dt class="meta-label">events</dt>
                <dd class="meta-chips">
                  {#for e of c.events key={e.name}}<span class="chip">{e.name}</span>{/for}
                </dd>
              </div>
            {/if}
          </dl>
        </a>
      {/for}
    </div>
  </section>
{/for}
