<!--
  <sui-component-catalog> — the `/components` gallery index for the SUI site.

  A centered column: a hero (eyebrow + display title + lead), a centered
  search field, a centered row of category-filter chips, then the component
  card grid. Every component links to its /components/<tag> detail page and
  shows a LIVE specimen mounted into a framed preview stage.

  Layout is the library dogfooding itself — structure comes from primitives,
  never bespoke CSS:
    <column>       the vertical page rhythm (hero → search → chips → grid)
    <row>          centers the search field, the category chips, and each
                   card's meta row
    <sui-center>   parks the live specimen dead-center of the framed stage
                   (both axes), so specimens no longer hug the top edge
    <sui-grid>     the responsive auto-fill card gallery (min="lg" gap="4")

  Filtering is reactive without re-rendering: the controller exposes a
  `query` signal (bound to <sui-input>) and an `activeCategory` signal;
  a card's `visible(entry)` derives from both and drives `attr:hidden`, so
  the one-shot live-preview mount (in the controller) is never disturbed.

  Curation (the public surface):
    - The catalog filters out internal sub-primitives (sui-accordion-item,
      sui-tab/tab-panel, sui-tree-item, sui-timeline-item, sui-toast*,
      sui-radio etc.) inside the controller, BEFORE the chip row is built
      — so a category never promises more cards than it actually shows.
    - The chip row is in CATEGORY_ORDER declared by category-map.ts
      (Forms & Inputs, Layout, Overlays, Navigation, Feedback, Data Display,
      Typography, Utility) so the chip axis reflects the eight folds of the
      public API surface, not the workspace's npm pack layout.

  Data source: the build-time CEM at apps/sui-site/components.gen.ts. Only
  the visual surface (framing, tints, font tokens) lives in this stylesheet;
  every value is a design token — no literal colours, no ad-hoc grid/flex.
-->
<style>
  :host {
    display: block;
    max-width: 74rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero { text-align: center; }
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--primary);
    margin-bottom: var(--space-3);
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 2.85rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    color: var(--foreground);
    margin: 0 0 var(--space-4);
  }
  .lead {
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 52ch;
    margin: 0 auto;
  }

  /* ── Search field ──────────────────────────────────────────────────── */
  .search {
    width: 35rem;
    max-width: 100%;
  }
  .search-glyph {
    color: var(--muted-foreground);
    font-size: var(--text-md);
  }

  /* ── Category chips ────────────────────────────────────────────────── */
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .chip:hover { border-color: var(--border-strong); color: var(--foreground); }
  .chip-on {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .chip-count { margin-left: var(--space-2); opacity: 0.7; }
  .chips-wrap {
    flex-wrap: wrap;
    row-gap: var(--space-2);
    max-width: 64rem;
  }

  /* ── Cards ─────────────────────────────────────────────────────────── */
  .cell {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .cell[hidden] { display: none; }
  .cell:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  /* Preview stage — fitted to content, not a fixed box. A bare element's
     natural size drives the stage; tiny components (sui-status-dot,
     sui-switch) stay tiny, big ones (sui-calendar, sui-table) expand.
     <sui-center> still centers the specimen on both axes; min-height +
     horizontal padding prevent the surface from looking cramped when the
     specimen is a one-line label, without forcing tall primitives into a
     fixed-frame box. */
  .stage {
    min-height: 7rem;
    padding: var(--space-4);
    background: color-mix(in oklch, var(--primary) 6%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cell-foot { padding: var(--space-3) var(--space-4) var(--space-4); }
  .cell-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .cell-props {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .cell-blurb {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
  }

  /* Empty / fallback states */
  .preview-empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .no-results {
    text-align: center;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-6) 0;
  }
</style>

<column class="page" gap="6" data-test="catalog">
  <div class="hero" data-test="catalog-hero">
    <span class="eyebrow">— {totalComponents()} components · {totalCategories()} categories</span>
    <h1 class="title">Component library</h1>
    <p class="lead">The public SUI primitive surface, grouped by category. Every component is a standard web component, themed by design tokens, and compiled ahead-of-time.</p>
  </div>

  <row class="search-row" justify="center">
    <sui-input
      class="search"
      type="search"
      tone="primary"
      placeholder="Search components…"
      aria-label="Search components"
      on:sui-input={onSearch}
      data-test="catalog-search"
    >
      <span slot="leading" class="search-glyph" aria-hidden="true">⌕</span>
    </sui-input>
  </row>

  <row class="chips-wrap" justify="center" gap="2" data-test="catalog-chips">
    {#for c of chips() key={c.id}}
      <button
        type="button"
        class="chip"
        class:chip-on={activeCategory() === c.id}
        on:click={() => setCategory(c.id)}
        attr:data-category={c.id}
        data-test="catalog-category-chip"
      >
        <span class="chip-label">{c.label}</span>
        <span class="chip-count">{c.count}</span>
      </button>
    {/for}
  </row>

  <sui-grid class="grid" min="lg" gap="4" data-test="catalog-grid">
    {#for c of components() key={c.tag}}
      <a
        class="cell"
        href={'/components/' + c.tag}
        attr:data-tag={c.tag}
        attr:hidden={c.hidden() ? true : null}
        data-test="catalog-cell"
      >
        <sui-center class="stage" attr:data-preview-for={c.tag}></sui-center>
        <div class="cell-foot">
          <row class="cell-meta" justify="between" align="baseline" gap="2">
            <span class="cell-tag" data-test="catalog-tag">{c.tag}</span>
            <span class="cell-props">{c.propCount} props</span>
          </row>
          {#if c.description}
            <p class="cell-blurb">{c.description}</p>
          {/if}
        </div>
      </a>
    {/for}
  </sui-grid>

  {#if visibleCount() === 0}
    <p class="no-results" data-test="catalog-empty">No components match “{query()}”.</p>
  {/if}
</column>
