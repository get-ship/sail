<!--
  <sui-component-catalog> — the `/components` gallery index for the SUI site.

  A centered column: a hero (eyebrow + display title + lead), a centered
  search field, a centered row of surface-filter chips, then the component
  card grid. Every component links to its /components/<tag> detail page and
  shows a LIVE specimen mounted into a framed preview stage.

  Layout is the library dogfooding itself — structure comes from primitives,
  never bespoke CSS:
    <column>       the vertical page rhythm (hero → search → chips → grid)
    <row>          centers the search field, the surface chips, and each
                   card's meta row
    <center>       parks the live specimen dead-center of the framed stage
                   (both axes), so specimens no longer hug the top edge
    <grid>         the responsive auto-fill card gallery (min="lg" gap="4")

  Filtering is reactive without re-rendering: the controller exposes a
  `query` signal (bound to <sui-input>) and an `activeSurface` signal; a
  card's `visible(entry)` derives from both and drives `attr:hidden`, so
  the one-shot live-preview mount (in the controller) is never disturbed.

  Surfaces (the public surface):
    - Two chip rows: Standard Library (default, selected on load) and Packs.
      There is no "All" chip — the Standard Library chip IS the gallery,
      and Packs is a distinct secondary surface. There are no invented
      category buckets (no Forms / Layout / Overlays / Navigation / Feedback /
      Data / Typography / Utility). The only organizing axis is the pack.
    - Standard Library view: the @ship/sui-primitives pack rendered as one
      alphabetical grid. No sub-category headers, no inner dividers.
    - Packs view: each pack rendered under its pack-name header (in
      canonical order: Charts, Canvas, Chat Elements, Media, Code Editor,
      Mermaid). Standard-library entries never appear here.
    - Hidden sub-primitives (sui-accordion-item, sui-tab/tab-panel,
      sui-tree-item, sui-timeline-item, sui-toast*, sui-radio) and the
      entire viewer pack (component-viewer, prop-knobs, prop-matrix,
      render, source-panel) are filtered out inside the controller,
      BEFORE either surface is built — so a chip never promises more
      cards than it shows.

  Data source: the build-time CEM at apps/sui-site/components.gen.ts. Only
  the visual surface (framing, tints, font tokens) lives in this stylesheet;
  every value is a design token — no literal colours, no ad-hoc grid/flex.
-->
<style>
  :host {
    display: block;
    max-width: 74rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero { text-align: center; }
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--primary);
    margin-bottom: var(--space-3);
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.0;
    margin: 0 0 var(--space-4);
    /* POP: gradient ink, matching the detail hero. */
    background: linear-gradient(118deg, var(--foreground) 32%, color-mix(in oklch, var(--primary) 68%, var(--foreground)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 52ch;
    margin: 0 auto;
  }

  /* ── Search field ──────────────────────────────────────────────────── */
  .search {
    width: 35rem;
    max-width: 100%;
  }
  .search-glyph {
    color: var(--muted-foreground);
    font-size: var(--text-md);
  }

  /* ── Surface chips ─────────────────────────────────────────────────── */
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .chip:hover { border-color: var(--border-strong); color: var(--foreground); }
  .chip-on {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .chip-count { margin-left: var(--space-2); opacity: 0.7; }
  .chips-wrap {
    flex-wrap: wrap;
    row-gap: var(--space-2);
    max-width: 64rem;
  }

  /* ── Bento grid ────────────────────────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    grid-auto-rows: 12.5rem;
    grid-auto-flow: dense;
    gap: var(--space-4);
  }

  /* ── Cards ─────────────────────────────────────────────────────────── */
  .cell {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* NO transform on hover — border + shadow only, so nothing shifts. */
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .cell[hidden] { display: none; }
  .cell:hover { border-color: var(--primary); box-shadow: var(--shadow-lg); }
  .cell:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
    border-color: var(--primary);
  }

  /* Bento spans — data/complex earn a 2×2, horizontal a 2×1; dense flow
     packs the 1×1s into the gaps. */
  .cell.sz-wide { grid-column: span 2; }
  .cell.sz-lg   { grid-column: span 2; grid-row: span 2; }

  /* Preview stage — a FROZEN portrait. The specimen is a real component with
     real styles, but `pointer-events:none` makes it non-interactive: no
     hover, no clicking its buttons, no menus opening over the grid. So the
     whole card is ONE clean link → detail (no element/link click fight), and
     nothing can overflow (`overflow:hidden` + `contain:paint`). Interaction
     lives in the detail view, where it's expected and framed. */
  .stage {
    flex: 1;
    min-height: 0;
    position: relative;
    overflow: hidden;
    contain: paint;
    pointer-events: none;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Designed backdrop — fine dot-grid over a soft tint, matching detail. */
    background:
      radial-gradient(circle at 1px 1px, color-mix(in oklch, var(--foreground) 6%, transparent) 1px, transparent 0) 0 0 / 20px 20px,
      linear-gradient(155deg, color-mix(in oklch, var(--primary) 7%, var(--surface-1)) 0%, var(--surface-1) 62%);
  }
  .stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 60% at 50% 42%, color-mix(in oklch, var(--primary) 12%, transparent), transparent 74%);
    pointer-events: none;
  }
  .stage > * { position: relative; z-index: 1; max-width: 100%; }
  /* Specimen sizing is handled at mount by fit-to-stage (measures + scales
     down anything larger than its stage), so nothing bleeds out. */

  .cell-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
  }
  .cell-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .cell-arrow {
    font-family: var(--font-mono);
    color: var(--primary);
    opacity: 0;
    transform: translateX(-2px);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .cell:hover .cell-arrow { opacity: 1; transform: translateX(0); }

  /* ── Pack sections (Packs view) ───────────────────────────────────── */
  .pack-section + .pack-section { margin-top: var(--space-8); }
  .pack-section[hidden] { display: none; }
  .pack-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }
  .pack-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin: 0;
    color: var(--foreground);
  }
  .pack-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  /* Empty / fallback states */
  .preview-empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .no-results {
    text-align: center;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-6) 0;
  }
</style>

<column class="page" gap="6" data-test="catalog">
  <div class="hero" data-test="catalog-hero">
    <span class="eyebrow">— {totalComponents()} components</span>
    <h1 class="title">Component library</h1>
    <p class="lead">The public SUI primitive surface, grouped by pack. Every component is a standard web component, themed by design tokens, and compiled ahead-of-time.</p>
  </div>

  <row class="search-row" justify="center">
    <sui-input
      class="search"
      type="search"
      tone="primary"
      placeholder="Search components…"
      aria-label="Search components"
      on:sui-input={onSearch}
      data-test="catalog-search"
    >
      <span slot="leading" class="search-glyph" aria-hidden="true">⌕</span>
    </sui-input>
  </row>

  <row class="chips-wrap" justify="center" gap="2" data-test="catalog-chips">
    {#for c of chips() key={c.id}}
      <button
        type="button"
        class="chip"
        class:chip-on={activeSurface() === c.id}
        on:click={() => setSurface(c.id)}
        attr:data-surface={c.id}
        data-test="catalog-surface-chip"
      >
        <span class="chip-label">{c.label}</span>
        <span class="chip-count">{c.count}</span>
      </button>
    {/for}
  </row>

  <!-- Standard Library surface: one alphabetical grid, no sub-headers. -->
  <div class="bento" attr:hidden={activeSurface() !== 'stdlib' ? true : null} data-test="catalog-grid">
    {#for c of components() key={c.tag}}
      <a
        class="cell"
        class:sz-wide={c.size === 'wide'}
        class:sz-lg={c.size === 'lg'}
        href={'/components/' + c.tag}
        attr:data-tag={c.tag}
        attr:hidden={c.hidden() ? true : null}
        data-test="catalog-cell"
      >
        <center class="stage" attr:data-preview-for={c.tag}></center>
        <div class="cell-foot">
          <span class="cell-tag" data-test="catalog-tag">{c.tag}</span>
          <span class="cell-arrow" aria-hidden="true">→</span>
        </div>
      </a>
    {/for}
  </div>

  <!-- Packs surface: each pack rendered under its name header, in canonical
       order. Each section is its own grid (matching detail page rhythm); the
       section itself hides when its pack isn't the active surface. -->
  {#for g of packGroups() key={g.pack}}
    <section
      class="pack-section"
      attr:hidden={activeSurface() !== 'pack' ? true : null}
      attr:data-pack={g.pack}
      data-test="catalog-pack-section"
    >
      <header class="pack-header">
        <h2 class="pack-title">{g.label}</h2>
        <span class="pack-count">{g.cards.length} components</span>
      </header>
      <div class="bento">
        {#for c of g.cards key={c.tag}}
          <a
            class="cell"
            class:sz-wide={c.size === 'wide'}
            class:sz-lg={c.size === 'lg'}
            href={'/components/' + c.tag}
            attr:data-tag={c.tag}
            attr:hidden={c.hidden() ? true : null}
            data-test="catalog-cell"
          >
            <center class="stage" attr:data-preview-for={c.tag}></center>
            <div class="cell-foot">
              <span class="cell-tag" data-test="catalog-tag">{c.tag}</span>
              <span class="cell-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        {/for}
      </div>
    </section>
  {/for}

  {#if visibleCount() === 0}
    <p class="no-results" data-test="catalog-empty">No components match “{query()}”.</p>
  {/if}
</column>