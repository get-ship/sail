<!--
  <sui-component-catalog> — `/components` index for the SUI site.

  Renders the build-time `COMPONENTS_CATALOG` (a flat CEM aggregated from
  every `<sui-*>` pack the site depends on), grouped by source package, with
  live previews of every component actually registered in the bundle, the CEM
  metadata (props / slots / events), and one-click links into a deep viewer.

  Sourced from `apps/sui-site/components.gen.ts` — emitted by `deck build`'s
  build_assets pass. Framework-pure (no ship-platform deps).

  Layout: this view is the dogfood for the layout primitives — every
  grouping reads from the library:
    <sui-cluster>   header (h1 + count) and chip lists
    <sui-stack>     cell body (tag / desc / preview / meta) and meta list
    <sui-grid>      the gallery itself, with per-cell span attributes
                    (`data-col-span` / `data-row-span`) so a calendar
                    card is 2×2 and a chip card is 1×1 — content-aware,
                    not uniform.
  Only the surface chrome (border, hover tint, font tokens) lives in
  this stylesheet; structure is the primitives'.
-->
<style>
  :host {
    display: block;
    /* Hover tint — reads the pre-computed --tone-primary-bg ramp
       (a 14% primary mix defined in tokens.css) so the formula
       doesn't drift across primitives. */
    --cat-cell-hover: var(--tone-primary-bg);
  }

  .cat-head {
    margin-bottom: var(--space-5);
  }
  .cat-head h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    color: var(--foreground);
  }
  .cat-sub {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .pack {
    margin-bottom: var(--space-6);
  }
  .pack-h {
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .pack-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }
  .pack-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  /* Per-cell chrome. Layout (column/row spans + grid-auto-flow) lives
     in <sui-grid>; only the visual surface lives here. The cell body
     uses <sui-stack> for vertical rhythm. */
  .cell {
    display: block;
    padding: var(--space-3);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
    min-height: 0;
  }
  .cell:hover {
    border-color: var(--primary);
    background: var(--cat-cell-hover);
    transform: translateY(-1px);
  }

  .cell-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
    line-height: var(--leading-tight);
  }

  .cell-desc {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* The preview cell: the area that holds the mounted custom element.
     Bounded — small components stay centered, big components opt into
     wider/taller cells. `min-height` keeps the cell consistent; the
     inner element overflows with scroll if a specimen is taller than
     the box (overflow: auto on the parent catches the rest). */
  .cell-preview {
    /* The cluster primitive provides the centering flex; this rule
       owns the visual surface only (frame, floor, overflow). */
    min-height: 6.5rem;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-2);
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    overflow: auto;
  }
  /* `compact` is set on the preview when the seed has `size: 'compact'`
     (small primitives: icon, badge, chip, status-dot, separator). The
     cell itself still has the same `data-col-span` / `data-row-span`
     as before — only the preview is shrunk. */
  .cell-preview[data-compact] {
    min-height: var(--space-8);
    padding: var(--space-2);
  }
  /* Big preview when the cell spans two columns. */
  .cell[data-col-span='2'] .cell-preview { min-height: 8rem; }
  /* Tall preview when the cell spans two rows (calendar, tree, table). */
  .cell[data-row-span='2'] .cell-preview {
    min-height: 22rem;
  }
  .preview-empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .meta {
    margin: 0;
  }
  .meta-label {
    flex: 0 0 var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--foreground);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-1);
    line-height: 1.5;
  }
  .meta-none {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
</style>

<sui-cluster class="cat-head" gap="3" data-test="catalog-head">
  <h1>Component library</h1>
  <span class="cat-sub">{totalComponents()} components · {totalPacks()} packs</span>
</sui-cluster>

{#for group of groups() key={group.id}}
  <section class="pack" data-test="catalog-pack" attr:data-pack={group.pkg}>
    <sui-cluster class="pack-h" gap="2">
      <span class="pack-name">{group.pkg}</span>
      <span class="pack-count">{group.count}</span>
    </sui-cluster>
    <sui-grid min="md" gap="3" flow="dense">
      {#for c of group.components key={c.tag}}
        <a
          class="cell"
          data-test="catalog-cell"
          attr:data-tag={c.tag}
          attr:data-size={c.size}
          attr:data-col-span={c.size === 'wide' ? '2' : null}
          attr:data-row-span={c.size === 'tall' ? '2' : null}
          href={'/components/' + c.tag}
        >
          <sui-stack gap="2">
            <span class="cell-tag" data-test="catalog-tag">&lt;{c.tag}&gt;</span>
            {#if c.description}
              <p class="cell-desc">{c.description}</p>
            {/if}
            <sui-cluster class="cell-preview" align="center" justify="center" attr:data-preview-for={c.tag} attr:data-compact={c.size === 'compact'}></sui-cluster>
            <dl class="meta">
              <sui-stack gap="1">
                <sui-cluster class="meta-row" gap="2" align="baseline">
                  <dt class="meta-label">props</dt>
                  <dd class="meta-chips">
                    {#if c.props.length}
                      <sui-cluster gap="1">
                        {#for p of c.props key={p.name}}<span class="chip" attr:title={p.type}>{p.name}</span>{/for}
                      </sui-cluster>
                    {:else}
                      <span class="meta-none">—</span>
                    {/if}
                  </dd>
                </sui-cluster>
                {#if c.slots.length}
                  <sui-cluster class="meta-row" gap="2" align="baseline">
                    <dt class="meta-label">slots</dt>
                    <dd class="meta-chips">
                      <sui-cluster gap="1">
                        {#for s of c.slots key={s.name}}<span class="chip">{s.name}</span>{/for}
                      </sui-cluster>
                    </dd>
                  </sui-cluster>
                {/if}
                {#if c.events.length}
                  <sui-cluster class="meta-row" gap="2" align="baseline">
                    <dt class="meta-label">events</dt>
                    <dd class="meta-chips">
                      <sui-cluster gap="1">
                        {#for e of c.events key={e.name}}<span class="chip">{e.name}</span>{/for}
                      </sui-cluster>
                    </dd>
                  </sui-cluster>
                {/if}
              </sui-stack>
            </dl>
          </sui-stack>
        </a>
      {/for}
    </sui-grid>
  </section>
{/for}
