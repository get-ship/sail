<!--
  <sui-site-shell> — the docs chrome, written in the language, with no CSS.

  The bar and the sidebar are the SAME element — <navbar> — in two placements.
  That is what a rail is. Everything else is layout keywords, sx, and the tone
  contract.

  This file used to be 100 lines of markup over 4.8 kB of hand-rolled CSS that
  reimplemented <navbar> badly: a flex header, a sticky offset, a bottom
  hairline, undecorated links, hover and active states. All of it already lived
  in the standard library. That is precisely the failure the language exists to
  prevent — an author who does not know the element exists rebuilds it — and the
  docs site was doing it on the very page that argues you should not.
-->

<navbar sticky bordered>
  <a slot="brand" href="/" aria-label="Ship UI home">
    <row gap="2" align="center">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <circle cx="6" cy="6" r="3.4" fill="var(--primary)" />
        <circle cx="20" cy="6" r="3.4" fill="var(--primary)" opacity="0.45" />
        <circle cx="6" cy="20" r="3.4" fill="var(--primary)" opacity="0.45" />
        <circle cx="20" cy="20" r="3.4" fill="var(--primary)" opacity="0.7" />
        <path d="M6 6 L20 20 M6 6 L20 6 M6 6 L6 20" stroke="var(--primary)" stroke-width="1.4" opacity="0.5" stroke-linecap="round" />
      </svg>
      <strong>SHIP UI</strong>
    </row>
  </a>

  <a href="/overview">SUI</a>
  <a href="/deck">Deck</a>
  <a href="/ai">AI</a>

  <theme-picker slot="actions"></theme-picker>
</navbar>

<row align="stretch">
  {#if product() === 'deck'}
    <navbar placement="rail" bordered sticky>
      <label>Introduction</label>
      <a href="/deck">Overview</a>
      <a href="/deck/getting-started">Getting started</a>
      <label>Concepts</label>
      <a href="/deck/routing">Routing</a>
      <a href="/deck/dynamic-routes">Dynamic routes</a>
      <a href="/deck/layouts">Layouts</a>
      <a href="/deck/rendering">Rendering</a>
      <a href="/deck/reactivity">Reactivity</a>
      <a href="/deck/data">Live data</a>
      <label>Tooling</label>
      <a href="/deck/hmr">HMR</a>
      <a href="/deck/build">Build</a>
    </navbar>
  {:else if product() === 'ai'}
    <navbar placement="rail" bordered sticky>
      <label>AI</label>
      <a href="/ai">Overview</a>
      <a href="/ai/authoring">Authoring</a>
      <a href="/ai/tooling">Tooling</a>
      <a href="/ai/eval">Eval</a>
    </navbar>
  {:else}
    <navbar placement="rail" bordered sticky>
      <label>Start here</label>
      <a href="/overview">Overview</a>
      <a href="/why">Why SUI</a>
      <a href="/getting-started">Getting started</a>

      <label>What's given</label>
      <a href="/elements">Elements</a>
      <a href="/layout">Layout</a>
      <a href="/styling">Styling</a>
      <a href="/theming">Theming</a>
      <a href="/motion">Motion</a>
      <a href="/behavior">Behavior</a>

      <label>What you write</label>
      <a href="/reactivity">State</a>
      <a href="/control-flow">Control flow</a>
      <a href="/data-binding">Events &amp; binding</a>
      <a href="/composition">Compositions</a>
      <a href="/data">Live data</a>
      <a href="/ssr">SSR &amp; hydration</a>

      <label>Reference</label>
      <a href="/reference">Directives &amp; API</a>
      <a href="/tooling">Tooling</a>
    </navbar>
  {/if}

  <main sx="p:6 min-w:0">
    <slot name="route"></slot>
  </main>
</row>
