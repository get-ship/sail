# deck build output + codegen (regenerated every build)
/.deck/
/routes.gen.ts
/entry.gen.ts
/components.gen.ts

# generated gallery manifest (regenerated from the primitive sources)
/src/gallery-manifest.json

# the compiler WASM is copied in from @ship/sui-compiler-wasm at build time
/public/sui_compiler_bg.wasm

# generated tutorial preview assets (regenerated by scripts/gen-tutorial-host.mjs
# + scripts/gen-tut-primitives.mjs): the concatenated theme sheet and the
# standalone <sui-*> primitives bundle the preview iframe loads.
/public/tut-preview-theme.css
/public/tut-sui-primitives.js

# Playwright
/test-results/
/playwright-report/
/.cache/
/src/playground-manifest.json
/src/gallery-manifest.json
