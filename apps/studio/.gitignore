# Sail app defaults (managed by ensure_sail_gitignore)
# Dependencies & generic build
node_modules/
dist/
*.tsbuildinfo
*.log
.DS_Store

# Deploy is `dist/` above. Generate is `.sail/` below.

# Codegen (sail routes / build / dev)
routes.gen.ts
entry.gen.ts
components.gen.ts

# Compiler companions next to .sail sources
*.sail.d.ts
*.controller.ts

# Env / secrets
.env
.env.*
!.env.example

# Test runners
test-results/
playwright-report/
blob-report/
.cache/
coverage/

# Ephemeral Sail local store (tasks, agent scratch — never commit)
.sail/
