{
  "theme": {
    "default": "studio",
    "defaultMode": "dark",
    // Themes activity dogfoods the full catalog: app delivery CSS must include
    // every id we list, or data-theme-preview paint is a no-op (all look like :root).
    "enabled": [
      "studio",
      "my-ship",
      "my-theme-vbtk",
      "ship",
      "sail",
      "neutral",
      "paper",
      "halo",
      "console",
      "contrast",
      "glass",
      "brut",
      "8bit",
      "synthwave"
    ]
  },
  "editor": "vscode",
  "network": ["self"],
  // Studio is client-rendered (SPA): the workbench is client-heavy
  // (CodeMirror, canvas preview, bridge) and the SPA path gets
  // state-preserving HMR. Server-owned state streams over the ops watch
  // SSE — not SSR payloads. SSR dogfooding moves to content apps
  // (sail-site); see .agents/plans/specs/TOOL-4-studio-shell.md.
  "render": "csr",
  // Ban <div>/<span> for app-local components under src/ (routes/ has its own).
  "raw_containers": false,
  // Studio layout gate (Workstream A): promote main-axis overflow, collapsed
  // boxes, and height-chain findings to Error so `sail check` / `sail dev`
  // exit non-zero. Non-studio packages omit this key and keep soft warns.
  "layout": "warn",
  "entry": {
    "clientsModule": "./src/clients.ts",
    "exposeNames": []
  }
}
