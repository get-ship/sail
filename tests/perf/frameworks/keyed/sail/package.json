{
  "name": "js-framework-benchmark-sail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "js-framework-benchmark": {
    "frameworkVersion": "0.1.0",
    "frameworkHomeURL": "https://github.com/madvib/ship",
    "language": "JavaScript"
  },
  "scripts": {
    "build-dev": "bun scripts/precompile.mjs && esbuild src/main.ts --bundle --format=esm --target=es2020 --outfile=dist/main.js --sourcemap",
    "build-prod": "bun scripts/precompile.mjs && esbuild src/main.ts --bundle --format=esm --target=es2020 --minify --outfile=dist/main.js"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
