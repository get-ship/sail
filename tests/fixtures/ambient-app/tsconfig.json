{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../packages/sail/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ship/sail-runtime": ["../../../packages/sail/runtime/src/index.ts"],
      "@ship/sail-runtime/*": ["../../../packages/sail/runtime/src/*"]
