<!-- PARITY-1: sidebar-left row (grow/shrink/nowrap). -->
<column w="full" sx={style.minH(screen)}>
  <row grow nowrap align="stretch" w="full">
    <column shrink="0" w="48" sx={style.pad(3)}>
      <span>Side</span>
    </column>
    <column grow min-w="0" sx={style.pad(3)}>
      <span>Main content</span>
    </column>
  </row>
</column>
