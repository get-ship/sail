<!-- Nested L1 cards in a column (geometry only; paint is separate). -->
<column gap="4" style({ box: w(full).pad(4) })>
  <card style({ box: w(full) })>
    <span slot="header">Card A</span>
    <span>Body A</span>
  </card>
  <card style({ box: w(full) })>
    <span slot="header">Card B</span>
    <span>Body B</span>
  </card>
</column>
