    { "id": "compat", "re": "\\bcompat\\b" },
    { "id": "transitional", "re": "\\btransitional\\b" },
    { "id": "migration", "re": "\\bmigration\\b" },
    { "id": "TODO remove", "re": "TODO remove" },
    { "id": "keep for now", "re": "keep for now" },
    { "id": "old path", "re": "old path" },
    { "id": "shim", "re": "\\bshim\\b" },
    { "id": "backwards", "re": "\\bbackwards\\b" },
    { "id": "alias for", "re": "alias for" }
