{
  "productOut": "dist",
  "generateOut": ".sail",
  "forbiddenOut": [".sail-out", ".deck", "node_modules/.sail", "test-results"],
  "trackedGenerated": [
    {
      "path": "crates/sail/compiler/primitives.json",
      "emitter": "cargo run -p sail-compiler -- prop-registry",
      "gate": "stdlib-coupled — check after L1 stdlib move"
    },
    {
      "path": "apps/sail-site/src/compositions/tutorial-data.ts",
      "emitter": "apps/sail-site/scripts/gen-tutorial.ts",
      "gate": "bun apps/sail-site/scripts/gen-tutorial.ts --check"
    },
    {
      "path": "crates/sail/lint/schemas/sail.config.schema.json",
      "emitter": "sail_lint::emit_sail_config_schema",
      "gate": "cargo test -p sail-lint --lib committed_schema"
    },
    {
      "path": "packages/sail/grammar/grammar.js",
      "emitter": "packages/sail/grammar bun run generate",
      "gate": "packages/sail/grammar/tests/grammar_generated.rs"
    },
    {
      "path": "packages/sail/grammar/queries/highlights.scm",
      "emitter": "packages/sail/grammar bun run generate",
      "gate": "packages/sail/grammar/tests/grammar_generated.rs"
    },
    {
      "path": "packages/sail/grammar/queries/injections.scm",
      "emitter": "packages/sail/grammar bun run generate",
      "gate": "packages/sail/grammar/tests/injections.rs"
    },
    {
      "path": "packages/sail/studio-client/src/generated/client.ts",
      "emitter": "sail-ops codegen",
      "gate": "packages/sail/studio-client/test/contract-drift.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/element-skins.css",
      "emitter": "cargo run -p sail-compiler -- framework-css",
      "gate": "stdlib-coupled — check after L1 stdlib move"
    },
    {
      "path": "packages/sail/tokens/src/tokens.css",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/themes.css",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/products.css",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/token-registry.json",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/generated/unions.ts",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "packages/sail/tokens/src/generated/themes-meta.ts",
      "emitter": "cargo run -p sail-compiler -- tokens",
      "gate": "packages/sail/tokens/test/tokens.test.ts"
    },
    {
      "path": "crates/sail/ops/schemas/catalog.json",
      "emitter": "sail op gen",
      "gate": "sail-ops assert_no_drift"
    },
    {
      "path": "crates/sail/ops/schemas/mcp-tools.json",
      "emitter": "sail op gen",
      "gate": "sail-ops assert_no_drift"
    }
  ],
  "ignoredGenerated": [
    "apps/*/.sail/**",
    "apps/sail-site/gen/**",
    "apps/*/routes.gen.ts",
    "apps/*/entry.gen.ts",
    "apps/*/components.gen.ts"
  ],
  "loadBearingScripts": [
    {
      "path": "apps/sail-site/scripts/gen-runtime-surface.ts",
      "must": "--check",
      "foldInto": "packages/sail/runtime (author-surface owner)"
    },
    {
      "path": "apps/sail-site/scripts/gen-tutorial.ts",
      "must": "--check",
      "foldInto": "sail-compiler / docs content pipeline"
    },
    {
      "path": "scripts/emit-package-dts.ts",
      "must": "invoked by bun prepare / emit:package-dts",
      "foldInto": "bun prepare / bake — not product sail types"
    }
  ]
}
