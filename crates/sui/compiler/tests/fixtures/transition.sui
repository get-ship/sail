<data name="visible" source="ship.bool.value" />
<data name="items" source="ship.items.list" />

<div class="container">
  {#if visible()}
    <span transition:fade={{ duration: 150 }}>fade me</span>
  {/if}

  {#if visible()}
    <p in:slide out:scale={{ from: 0.8 }}>asymmetric</p>
  {/if}

  {#for item of items() key={item.id}}
    <li transition:slide={{ axis: 'x', duration: 100 }}>{item.label}</li>
  {/for}
</div>
