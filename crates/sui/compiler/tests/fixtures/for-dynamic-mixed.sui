<controller>
import { controller } from '@ship/sui-runtime'
export default controller({
  setup: () => ({ rows: [{ id: 1, label: "a" }, { id: 2, label: "b" }] }),
})
</controller>

<table>
  {#for row of rows() key={row.id}}
    <tr aria-selected={rows().length > 0}><td>{row.label}</td></tr>
  {/for}
</table>
