<controller>
import { controller, signal } from '@ship/sui-runtime'

export default controller({
  setup: () => ({ count: signal(0) }),
  derived: {
    doubled: ({ count }) => count() * 2,
    label: ({ count }) => `count is ${count()}`,
  },
  on: {
    inc: ({ count }) => count.set(count() + 1),
  },
})
</controller>

<div>
  <p>{label()}</p>
  <p>doubled: {doubled()}</p>
  <button on:click={inc}>+</button>
</div>
