<!--
  <icon> — L1 language element. Sizes and inks one glyph: a slotted SVG, a
  `name` from the host's icon endpoint (deck serves the embedded lucide set),
  or an arbitrary `src` URL. Behavior rides `use:icon` (fetch, single-flight
  cache, ARIA); ink is currentColor inheritance. Framing is <icon-frame>'s
  job; brand/identity mappings are app-land composition, not language.
-->

<component>{
  props: {
    /** Named glyph from the icon endpoint (deck serves the embedded lucide
        set). Empty keeps slotted children. */
    name: '',
    /** Fetch an arbitrary SVG URL instead of a named glyph; wins over name. */
    src: '',
    /** Accessible name — role=img + aria-label; label-less icons are
        aria-hidden decoration. */
    label: '',
    size: 'xs' | 'sm' | 'md' | 'lg' | 'xl',
    spin: false,
  },
}</component>

<style>
  .sui-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -0.125em;
    flex: 0 0 auto;
    color: currentColor;
    --sz: var(--icon-size-md);
  }
  .sui-icon[size='xs'] { --sz: var(--icon-size-2xs); }
  .sui-icon[size='sm'] { --sz: var(--icon-size-sm); }
  .sui-icon[size='lg'] { --sz: var(--icon-size-xl); }
  .sui-icon[size='xl'] { --sz: var(--icon-size-2xl); }

  /* Both glyph sources fill the icon box: the action-injected svg and a
     slotted one. */
  .sui-icon svg {
    display: block;
    width: var(--sz);
    height: var(--sz);
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sui-icon[spin] svg { animation: sui-spin 0.8s linear infinite; }
  }

</style>

<span use:icon><slot></slot></span>
