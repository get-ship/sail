<!--
  <spinner> — L1 language element (element mode). Bare tag: it lowers away
  at compile time; the skin below routes to the framework layer keyed on
  .sui-spinner; the contract feeds the element manifest.

  Faithful to the feat/next sui-spinner baseline. Per-instance dynamics
  (a custom aria-label) belong to the USE SITE — its attributes merge onto
  the root, overriding the static defaults here.
-->

<component>{
  props: {
    size: 'xs' | 'sm' | 'md' | 'lg',
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent',
    centered: false,
  },
}</component>

<style>
  .sui-spinner {
    display: inline-flex;
    vertical-align: middle;
    --tone-fg: var(--muted-foreground);
    --sz: var(--icon-size-md);
    --bw: var(--control-stroke);
  }
  .sui-spinner[tone='primary']     { --tone-fg: var(--primary);     --tone-ring: var(--tone-primary-ring); }
  .sui-spinner[tone='info']        { --tone-fg: var(--info);        --tone-ring: var(--tone-info-ring); }
  .sui-spinner[tone='success']     { --tone-fg: var(--success);     --tone-ring: var(--tone-success-ring); }
  .sui-spinner[tone='warning']     { --tone-fg: var(--warning);     --tone-ring: var(--tone-warning-ring); }
  .sui-spinner[tone='destructive'] { --tone-fg: var(--destructive); --tone-ring: var(--tone-destructive-ring); }
  .sui-spinner[tone='accent']      { --tone-fg: var(--accent);      --tone-ring: var(--tone-accent-ring); }
  .sui-spinner[size='xs'] { --sz: 10px; --bw: 1.5px; }
  .sui-spinner[size='sm'] { --sz: var(--icon-size-sm); --bw: 1.5px; }
  .sui-spinner[size='lg'] { --sz: var(--icon-size-xl); --bw: 2.5px; }
  .sui-spinner[centered] {
    display: block;
    margin: var(--space-8) auto;
  }
  .ring {
    display: inline-block;
    width: var(--sz);
    height: var(--sz);
    border: var(--bw) solid var(--tone-ring, var(--border-subtle));
    border-right-color: var(--tone-fg);
    border-radius: 50%;
    animation: sui-spin 0.7s linear infinite;
  }
  @keyframes sui-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ring { animation-duration: 1.5s; } }
</style>

<span class="spin" role="status" aria-label="Loading">
  <span class="ring" aria-hidden="true"></span>
</span>
