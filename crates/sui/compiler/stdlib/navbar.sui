<!--
  <navbar> — the application nav bar. One element, three placements.

    <navbar sticky bordered>                     top bar (default)
      <brand-mark slot="brand" />
      <a href="/">Home</a> <a href="/docs">Docs</a>
      <button slot="actions">Sign in</button>
    </navbar>

    <navbar placement="rail" bordered>…</navbar>   vertical rail (sidebar)
    <navbar placement="bottom">…</navbar>          bottom bar (mobile)

  A rail is not a different component — it is a navbar on its side. `bordered`
  puts the hairline on the edge that faces the content, and `sticky` pins it to
  the edge it sits on, so both follow from the placement rather than from three
  separate elements with three sets of props.

  Domain-neutral: brand slot (start), the default slot (links), actions slot
  (end). The product fills them; the navbar names no domain concept.
-->

<component>{
  props: {
    placement: 'top' | 'rail' | 'bottom',
    sticky: bool,
    bordered: bool,
  },
}</component>

<style>
  .sui-navbar {
    display: flex;
    background: var(--background);
    color: var(--foreground);
    gap: var(--space-4);
  }

  /* ── top / bottom: a horizontal bar ─────────────────────────────────── */
  .sui-navbar[placement='top'],
  .sui-navbar[placement='bottom'] {
    flex-direction: row;
    align-items: center;
    min-height: 3.5rem;
    padding: var(--space-2) var(--space-4);
  }
  .sui-navbar[placement='top'][bordered]    { border-block-end: 1px solid var(--border); }
  .sui-navbar[placement='bottom'][bordered] { border-block-start: 1px solid var(--border); }
  .sui-navbar[placement='top'][sticky] {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 100);
  }
  .sui-navbar[placement='bottom'][sticky] {
    position: sticky;
    bottom: 0;
    z-index: var(--z-sticky, 100);
  }

  /* ── rail: the same bar, on its side ────────────────────────────────── */
  .sui-navbar[placement='rail'] {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-4);
    min-width: 14rem;
  }
  .sui-navbar[placement='rail'][bordered] { border-inline-end: 1px solid var(--border); }
  .sui-navbar[placement='rail'][sticky] {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
  }

  /* ── the three regions ──────────────────────────────────────────────── */
  .sui-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    font-weight: var(--font-weight-semibold);
  }
  .sui-nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1 1 auto;
    min-width: 0;
  }
  .sui-navbar[placement='rail'] .sui-nav-links {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-1);
    flex: 1 1 auto;
  }
  .sui-nav-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    margin-inline-start: auto;
  }
  .sui-navbar[placement='rail'] .sui-nav-actions {
    flex-direction: column;
    align-items: stretch;
    margin-inline-start: 0;
    margin-block-start: auto;
  }

  /* Nav links are chrome: undecorated, and they light up on hover/current. */
  .sui-nav-links a {
    display: block;
    padding: var(--space-1_5) var(--space-2_5);
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .sui-nav-links a:hover { color: var(--foreground); background: var(--hover-bg); }
  .sui-nav-links a[aria-current] {
    color: var(--foreground);
    background: var(--hover-bg);
    font-weight: var(--font-weight-medium);
  }
</style>

<nav>
  <div class="sui-nav-brand"><slot name="brand"></slot></div>
  <div class="sui-nav-links"><slot></slot></div>
  <div class="sui-nav-actions"><slot name="actions"></slot></div>
</nav>
