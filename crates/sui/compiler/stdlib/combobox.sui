<!--
  <combobox placeholder="…"> — L1 filtering picker (element mode). A text input
  that filters a listbox and commits one option.

  The platform ALMOST has this: `<input list>` + `<datalist>` is native typeahead
  with zero JS — but the UA draws that popup and it cannot be styled or themed.
  That gap, and only that gap, is why this is a primitive rather than a native+skin.

  The listbox is a native [popover] anchored by use:anchor — the same two
  mechanisms <popover>/<dropdown>/<tooltip> already run on, not a third. use:combobox
  supplies everything the ARIA pattern demands (ids, popovertarget, aria-expanded /
  -controls / -activedescendant, filter-as-you-type, Up/Down/Home/End, Enter to
  commit, Escape to close) so the author writes the tag and the options and nothing
  else. Commit emits `sui-combobox-select` with { value, label } and reflects to
  the element's `value`.

  Element mode is STATIC structure, so `placeholder` is not bound in the template:
  it rides through to the lowered root as an attribute and use:combobox forwards
  it to the inner input — the same way use:anchor reads `placement`.

    <combobox placeholder="Pick a fruit">
      <option value="apple">Apple</option>
      <option value="banana">Banana</option>
    </combobox>
-->

<scope>
  props: {
    placeholder = ''
    value = ''
  }
</scope>

<style>
  .sui-combobox {
    display: block;
    position: relative;
    font-family: var(--font-body);
  }

  .sui-combobox .input {
    width: 100%;
  }

  .sui-combobox .listbox {
    position: fixed;
    inset: auto;
    margin: 0;
    /* The listbox tracks the field it filters — narrower is a lie about the
       content, wider is a second box floating over the page. */
    min-width: anchor-size(width, 12rem);
    max-height: 16rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-1);
    color: var(--popover-foreground);
    background: var(--popover);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-popover, 1000);
  }
  .sui-combobox .listbox::backdrop { background: transparent; }

  .sui-combobox .listbox option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1_5) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: inherit;
    cursor: pointer;
  }
  /* The ACTIVE option is the keyboard's cursor. It is not :hover and it is not
     focus — focus never leaves the input in this pattern (that's the whole point
     of aria-activedescendant), so the highlight has to be ours to draw. */
  .sui-combobox .listbox option[data-active] {
    background: var(--hover-bg);
  }
  .sui-combobox .listbox option[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .sui-combobox .listbox option:hover:not([disabled]) {
    background: var(--hover-bg);
  }
  /* Filtered-out options are `hidden`, which <option> ignores by default in
     some UAs — say it outright. */
  .sui-combobox .listbox option[hidden] { display: none; }

  .sui-combobox .empty {
    padding: var(--space-2);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
</style>

<div use:combobox>
  <input class="input" type="text">
  <div class="listbox" popover use:anchor placement="bottom-start">
    <slot></slot>
  </div>
</div>
