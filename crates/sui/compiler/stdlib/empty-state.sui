<!--
  <empty-state> — L1 language element (element mode). A centered placeholder for
  empty lists / missing content: an icon tile, a title, description copy, and an
  action row. Named slots (icon / title / action + the default description slot)
  project at compile time; bare tag lowers to <div class="sui-empty-state">.

  Faithful to the feat/next sui-empty-state baseline. Shadow-isms dissolved at L1:
  - host/.box split → collapsed onto the single root (the root IS the box).
  - reactive align={variant==='inline'?...} on the copy column → CSS variant rule.
  - reflect-empty="data-no-icon" (a JS slot-emptiness reflect) → `.icon:empty`
    (pure CSS — an empty icon slot leaves the tile empty, so it hides itself).
  - reactive role/aria-live (only the `connecting` variant is a live region) →
    the use:emptyState action, off a static role=note default.
  Icon tile tints per tone from the global [tone] channel; default/muted stay
  neutral (empty states read quiet by default).
-->

<component>{
  props: {
    variant: 'default' | 'inline' | 'placeholder' | 'connecting',
    size: 'sm' | 'md' | 'lg',
    tone: 'default' | 'primary' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted',
  },
}</component>

<style>
  :host {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--es-gap);
    padding: var(--es-pad-y) var(--es-pad-x);
    text-align: center;
    font-family: var(--font-body);
    color: var(--muted-foreground);
    background: var(--es-bg);
    border: var(--es-border);
    border-radius: var(--es-radius);
    box-shadow: var(--es-shadow);
    /* size: md base; sm/lg override below */
    --es-pad-y: 64px;
    --es-pad-x: 16px;
    --es-gap: var(--space-3);
    --es-icon: 22px;
    --es-tile: 48px;
    --es-title-fs: var(--text-md);
    --es-desc-fs: var(--text-sm);
    --es-radius: var(--radius-lg);
    --es-border: 1px solid var(--border);
    /* card surface — theme-adaptive (--card resolves dark in dark themes;
       --tone-muted-bg does NOT and would render near-white, unreadable). */
    --es-bg: var(--card);
    --es-shadow: var(--shadow-xs);
  }

  :host([size='sm']) {
    --es-pad-y: var(--space-7); --es-pad-x: var(--space-4); --es-gap: var(--space-2);
    --es-icon: 16px; --es-tile: 36px; --es-title-fs: var(--text-base);
  }
  :host([size='lg']) {
    --es-pad-y: 96px; --es-pad-x: var(--space-6); --es-gap: var(--space-4);
    --es-icon: 28px; --es-tile: 64px; --es-title-fs: var(--text-lg); --es-desc-fs: var(--text-base);
  }

  :host([variant='placeholder']),
  :host([variant='connecting']) {
    --es-border: 0; --es-bg: transparent; --es-radius: 0; --es-shadow: none; --es-pad-y: var(--space-6);
  }
  :host([variant='inline']) {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: start;
    --es-border: 1px dashed var(--border);
    --es-bg: var(--tone-muted-border);
    --es-radius: var(--radius-md);
    --es-pad-y: var(--space-3);
    --es-pad-x: var(--space-4);
    --es-gap: var(--space-3);
  }

  :host .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--es-tile);
    height: var(--es-tile);
    border-radius: var(--radius-lg);
    background: var(--tone-bg);
    color: var(--tone-fg);
    line-height: 1;
    box-shadow: inset 0 0 0 1px var(--tone-ring);
  }
  :host(:not([tone])) .icon,
  :host([tone='default']) .icon,
  :host([tone='muted']) .icon {
    background: var(--muted);
    color: var(--muted-foreground);
    box-shadow: none;
  }
  :host .icon:empty { display: none; }
  :host([variant='inline']) .icon {
    width: var(--es-icon); height: var(--es-icon);
    background: transparent; box-shadow: none;
  }
  :host .icon svg { width: var(--es-icon); height: var(--es-icon); }

  :host .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    min-width: 0;
  }
  :host([variant='inline']) .copy { align-items: start; }

  :host .title {
    font-family: var(--heading-font);
    font-size: var(--es-title-fs);
    font-weight: var(--heading-weight);
    color: var(--foreground);
    line-height: var(--leading-tight);
  }
  :host([variant='connecting']) .title,
  :host([variant='placeholder']) .title {
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
  }
  :host .title:empty { display: none; }

  :host .desc {
    font-size: var(--es-desc-fs);
    max-width: 38ch;
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  :host([variant='inline']) .desc { max-width: 60ch; }
  :host .desc:empty { display: none; }

  :host .actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }
  :host([variant='inline']) .actions {
    margin-top: 0;
    margin-inline-start: auto;
    justify-content: flex-end;
  }
  :host .actions:empty { display: none; }

  @media (forced-colors: active) {
    :host { border-color: CanvasText; }
    :host .icon { background: Canvas; color: CanvasText; }
  }
</style>

<div use:emptyState role="note" aria-live="off">
  <div class="icon" part="icon" aria-hidden="true"><slot name="icon"></slot></div>
  <div class="copy" part="copy">
    <div class="title" part="title"><slot name="title"></slot></div>
    <div class="desc" part="desc"><slot></slot></div>
  </div>
  <div class="actions" part="actions"><slot name="action"></slot></div>
</div>
