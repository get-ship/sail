<!--
  <nav-top> — L1 top navigation bar (element mode). A domain-neutral bar: brand
  slot (start), the default slot for nav links (fills), actions slot (end). The
  product fills the slots with its own content — nav-top itself names no domain
  concept. Bare tag lowers to <header class="sui-nav-top">.

    <nav-top bordered sticky>
      <brand-mark slot="brand" />
      <a href="/">Home</a> <a href="/docs">Docs</a>
      <button slot="actions">Sign in</button>
    </nav-top>

  bordered adds the bottom hairline; sticky pins to the top.
-->

<component>{ props: { sticky: bool, bordered: bool } }</component>

<style>
  .sui-nav-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding: var(--space-2) var(--space-4);
    background: var(--background);
    color: var(--foreground);
  }
  .sui-nav-top[bordered] { border-bottom: 1px solid var(--border); }
  .sui-nav-top[sticky] { position: sticky; top: 0; z-index: var(--z-sticky, 100); }

  .sui-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    font-weight: var(--font-weight-semibold);
  }
  .sui-nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1 1 auto;
    min-width: 0;
  }
  .sui-nav-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    margin-inline-start: auto;
  }
</style>

<header>
  <div class="sui-nav-brand"><slot name="brand"></slot></div>
  <nav class="sui-nav-links"><slot></slot></nav>
  <div class="sui-nav-actions"><slot name="actions"></slot></div>
</header>
