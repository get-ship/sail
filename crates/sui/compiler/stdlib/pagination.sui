<!--
  <pagination> — L1 pager (element mode). A nav of <page> controls; use:pagination
  marks the page matching `value` with aria-current and emits `sui-page-change`
  on click. Prev/next are <page>s whose value is the target page (disabled at the
  ends). Bare tag lowers to <nav class="sui-pagination">.

    <pagination value="3">
      <page value="2" aria-label="Previous">‹</page>
      <page value="1">1</page> <page value="2">2</page> <page value="3">3</page>
      <page value="4" aria-label="Next">›</page>
    </pagination>
-->

<component>{
  props: {
    value: string,
    size: 'sm' | 'md' | 'lg',
  },
}</component>

<style>
  .sui-pagination {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    --pg-h: var(--control-h-md);
    --pg-fs: var(--text-sm);
  }
  .sui-pagination[size='sm'] { --pg-h: var(--control-h-sm); --pg-fs: var(--text-xs); }
  .sui-pagination[size='lg'] { --pg-h: var(--control-h-lg); --pg-fs: var(--text-base); }
</style>

<nav use:pagination>
  <slot></slot>
</nav>
