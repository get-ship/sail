<div class="chat-gallery">
  <header class="chat-gallery-header">
    <h1>sui/chat-elements</h1>
    <p class="chat-gallery-desc">
      Unbound multi-modal chat primitives — message · message-list · composer ·
      thinking-dots · tool-call · citation. Pure framework tier; no SDK reads.
    </p>
  </header>

  <!-- ── sui-citation ──────────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-citation</h2>
    <p class="chat-gallery-section-desc">
      Numbered source pill. Clicking emits <code>sui-citation-open</code>.
    </p>

    <div class="chat-gallery-card">
      <h3>index 1 — short label</h3>
      <sui-citation source="Ship docs" index={1}></sui-citation>
    </div>

    <div class="chat-gallery-card">
      <h3>index 2 — URL source</h3>
      <sui-citation source="https://ship.example.com/reference" index={2}></sui-citation>
    </div>

    <div class="chat-gallery-card">
      <h3>index 3 — long label (truncates)</h3>
      <sui-citation source="A very long citation label that will be clipped by the max-width" index={3}></sui-citation>
    </div>

    <div class="chat-gallery-card">
      <h3>inline inside prose</h3>
      <p>
        The agent used three sources
        <sui-citation source="Ship docs" index={1}></sui-citation>
        <sui-citation source="RFC 9110" index={2}></sui-citation>
        to answer your question.
      </p>
    </div>
  </section>

  <!-- ── sui-composer ──────────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-composer</h2>
    <p class="chat-gallery-section-desc">
      Message input + send control. Single-line by default; <code>multiline</code>
      grows to a textarea. Emits <code>sui-composer-submit</code> on send.
    </p>

    <div class="chat-gallery-card">
      <h3>default — single-line, placeholder</h3>
      <sui-composer placeholder="Message the agent…"></sui-composer>
    </div>

    <div class="chat-gallery-card">
      <h3>multiline — Shift+Enter for newlines</h3>
      <sui-composer placeholder="Write a long message…" multiline></sui-composer>
    </div>

    <div class="chat-gallery-card">
      <h3>disabled</h3>
      <sui-composer placeholder="Sending…" disabled></sui-composer>
    </div>

    <div class="chat-gallery-card">
      <h3>with trailing slot — extra action beside Send</h3>
      <sui-composer placeholder="Ask anything…">
        <button slot="trailing" type="button" style="font-size:11px;padding:4px 8px;">Mic</button>
      </sui-composer>
    </div>
  </section>

  <!-- ── sui-message ────────────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-message</h2>
    <p class="chat-gallery-section-desc">
      Single chat bubble. Role drives alignment + tone; content-type drives inner
      shape; status tints the border. Trailing slot for per-message actions.
    </p>

    <div class="chat-gallery-card">
      <h3>role: assistant — text (default)</h3>
      <sui-message role="assistant" timestamp="2026-06-05T14:00:00Z">
        Here is the information you requested about SUI components.
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>role: user</h3>
      <sui-message role="user" timestamp="2026-06-05T14:01:00Z">
        Can you show me the chat-elements pack?
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>role: system</h3>
      <sui-message role="system">
        You are a helpful assistant with access to Ship tools.
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>role: tool</h3>
      <sui-message role="tool" content-type="text">
        Tool output: 42 results found.
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>content-type: code</h3>
      <sui-message role="assistant" content-type="code">
        const x = signal(0);
const doubled = derived(() => x() * 2);
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>content-type: terminal-snapshot</h3>
      <sui-message role="assistant" content-type="terminal-snapshot">
        $ cargo run -p sui-compiler -- build page.sui
compiled 1 file(s)
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>status: sending</h3>
      <sui-message role="user" status="sending">
        Sending this message now…
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>status: error</h3>
      <sui-message role="user" status="error">
        This message failed to send.
      </sui-message>
    </div>

    <div class="chat-gallery-card">
      <h3>with trailing slot — copy action</h3>
      <sui-message role="assistant" timestamp="2026-06-05T14:02:00Z">
        The answer is forty-two.
        <span slot="trailing" style="font-size:11px;color:var(--muted-foreground)">Copy</span>
      </sui-message>
    </div>
  </section>

  <!-- ── sui-message-list ───────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-message-list</h2>
    <p class="chat-gallery-section-desc">
      Keyed, windowed, auto-scrolling column. Items via <code>prop:items</code>;
      <code>sticky-bottom</code> pins to newest. Empty state via the
      <code>empty</code> slot.
    </p>

    <div class="chat-gallery-card">
      <h3>empty state — no items</h3>
      <div style="height:200px;border:1px solid var(--border);border-radius:var(--radius-md)">
        <sui-message-list prop:items={emptyItems()}>
          <span slot="empty" style="color:var(--muted-foreground);font-size:13px">
            No messages yet. Start the conversation.
          </span>
        </sui-message-list>
      </div>
    </div>

    <div class="chat-gallery-card">
      <h3>sticky-bottom=true — pre-loaded thread</h3>
      <div style="height:300px;border:1px solid var(--border);border-radius:var(--radius-md)">
        <sui-message-list prop:items={threadItems()}>
          <span slot="empty">No messages.</span>
        </sui-message-list>
      </div>
    </div>
  </section>

  <!-- ── sui-thinking-dots ──────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-thinking-dots</h2>
    <p class="chat-gallery-section-desc">
      Three bouncing dots signalling an assistant composing a reply. Pure
      presentational; no controller. Screen-reader-friendly live region.
    </p>

    <div class="chat-gallery-card">
      <h3>size: sm | md (default) | lg</h3>
      <div class="chat-gallery-row">
        <sui-thinking-dots size="sm"></sui-thinking-dots>
        <sui-thinking-dots size="md"></sui-thinking-dots>
        <sui-thinking-dots size="lg"></sui-thinking-dots>
      </div>
    </div>

    <div class="chat-gallery-card">
      <h3>tone: default | primary | info | success | warning | destructive | accent | muted</h3>
      <div class="chat-gallery-row">
        <sui-thinking-dots tone="default"></sui-thinking-dots>
        <sui-thinking-dots tone="primary"></sui-thinking-dots>
        <sui-thinking-dots tone="info"></sui-thinking-dots>
        <sui-thinking-dots tone="success"></sui-thinking-dots>
        <sui-thinking-dots tone="warning"></sui-thinking-dots>
        <sui-thinking-dots tone="destructive"></sui-thinking-dots>
        <sui-thinking-dots tone="accent"></sui-thinking-dots>
        <sui-thinking-dots tone="muted"></sui-thinking-dots>
      </div>
    </div>

    <div class="chat-gallery-card">
      <h3>custom label — overrides announced text</h3>
      <sui-thinking-dots label="Model is composing" size="md" tone="primary"></sui-thinking-dots>
    </div>

    <div class="chat-gallery-card">
      <h3>inline inside a message bubble</h3>
      <sui-message role="assistant">
        <sui-thinking-dots size="sm" tone="muted"></sui-thinking-dots>
      </sui-message>
    </div>
  </section>

  <!-- ── sui-tool-call ──────────────────────────────────────────── -->
  <section class="chat-gallery-section">
    <h2>sui-tool-call</h2>
    <p class="chat-gallery-section-desc">
      Collapsible record of one tool invocation. Header shows name + status dot;
      body shows args (default slot) and result (<code>result</code> slot).
    </p>

    <div class="chat-gallery-card">
      <h3>status: running — body collapsed</h3>
      <sui-tool-call name="list_files" status="running">
        { "path": "/workspace/src" }
      </sui-tool-call>
    </div>

    <div class="chat-gallery-card">
      <h3>status: ok — body collapsed</h3>
      <sui-tool-call name="read_file" status="ok">
        { "path": "/workspace/src/lib.rs" }
        <span slot="result">pub fn hello() -&gt; &amp;'static str { "world" }</span>
      </sui-tool-call>
    </div>

    <div class="chat-gallery-card">
      <h3>status: error — body collapsed</h3>
      <sui-tool-call name="run_tests" status="error">
        { "suite": "unit" }
        <span slot="result">Error: test runner not found</span>
      </sui-tool-call>
    </div>

    <div class="chat-gallery-card">
      <h3>open=true — body expanded on load</h3>
      <sui-tool-call name="search_code" status="ok" open>
        { "query": "sui-message", "scope": "packages/" }
        <span slot="result">Found 7 matches in 3 files.</span>
      </sui-tool-call>
    </div>
  </section>
</div>

<style>
  .chat-gallery {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-6, 24px);
    font-family: var(--font-body);
    color: var(--foreground);
  }

  .chat-gallery-header {
    margin-bottom: var(--space-8, 32px);
  }
  .chat-gallery-header h1 {
    font-size: 28px;
    font-weight: var(--font-weight-bold, 700);
    margin: 0 0 var(--space-2, 8px);
  }
  .chat-gallery-desc {
    font-size: 14px;
    color: var(--muted-foreground);
    margin: 0;
  }

  .chat-gallery-section {
    margin-bottom: var(--space-8, 32px);
  }
  .chat-gallery-section h2 {
    font-size: 18px;
    font-weight: var(--font-weight-semibold, 600);
    margin: 0 0 var(--space-1, 4px);
    font-family: var(--font-mono, monospace);
    color: var(--primary);
  }
  .chat-gallery-section-desc {
    font-size: 13px;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-4, 16px);
  }

  .chat-gallery-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    padding: var(--space-4, 16px);
    margin-bottom: var(--space-3, 12px);
  }
  .chat-gallery-card h3 {
    font-size: 11px;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-3, 12px);
  }
  .chat-gallery-card code {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    background: color-mix(in oklch, var(--muted) 50%, var(--card));
    border-radius: 3px;
    padding: 1px 4px;
  }

  .chat-gallery-row {
    display: flex;
    align-items: center;
    gap: var(--space-4, 16px);
    flex-wrap: wrap;
  }
</style>
