<column gap="8" sx="p-6 max-w-breakpoint-tablet mx-auto">
  <header sx="border-b border-b-border pb-4">
    <h1 sx="text-2xl font-bold text-foreground mb-2">sui/canvas</h1>
    <p sx="text-muted-foreground text-sm">
      Pack <strong>sui/canvas</strong> — pan/zoom substrate, SVG diagram board,
      freehand whiteboard, and graph layout surface.
      Cards marked <em>domain-stub</em> await a backend spec before live data
      is wired; all props below are static mock values only.
    </p>
  </header>

  <grid min="sm">

    <!-- sui-canvas ─────────────────────────────────────────────── -->
    <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
      <row gap="3">
        <span sx="text-lg font-semibold text-foreground font-mono">sui-canvas</span>
        <span sx="text-xs font-medium font-body text-warning-foreground bg-warning rounded-sm px-2 py-1 tracking-wide">domain-stub — awaits backend spec</span>
      </row>
      <p sx="text-muted-foreground text-sm leading-relaxed">
        Bare pan/zoom/infinite-surface substrate. Hosts arbitrary world-space
        content via the default slot; pan and zoom with pointer/wheel.
      </p>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <sui-canvas theme="light" grid="dots" label="Demo canvas">
          <div>Node A</div>
          <div>Node B</div>
        </sui-canvas>
      </column>
      <dl sx="text-sm text-muted-foreground">
        <dt>theme</dt><dd>"light"</dd>
        <dt>grid</dt><dd>"dots"</dd>
        <dt>label</dt><dd>"Demo canvas"</dd>
        <dt>readonly</dt><dd>false</dd>
      </dl>
    </column>

    <!-- sui-board ──────────────────────────────────────────────── -->
    <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
      <row gap="3">
        <span sx="text-lg font-semibold text-foreground font-mono">sui-board</span>
        <span sx="text-xs font-medium font-body text-warning-foreground bg-warning rounded-sm px-2 py-1 tracking-wide">domain-stub — awaits backend spec</span>
      </row>
      <p sx="text-muted-foreground text-sm leading-relaxed">
        SVG-native node/edge/port diagram. Nodes are DOM divs; edges are SVG
        paths. Geometry is owned by the board; slot content owns visuals.
      </p>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <sui-board theme="light" grid="dots" layout="none" label="Demo board">
          <div slot="node-a">Agent A</div>
          <div slot="node-b">Agent B</div>
        </sui-board>
      </column>
      <dl sx="text-sm text-muted-foreground">
        <dt>theme</dt><dd>"light"</dd>
        <dt>grid</dt><dd>"dots"</dd>
        <dt>layout</dt><dd>"none"</dd>
        <dt>label</dt><dd>"Demo board"</dd>
      </dl>
    </column>

    <!-- sui-draw ───────────────────────────────────────────────── -->
    <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
      <row gap="3">
        <span sx="text-lg font-semibold text-foreground font-mono">sui-draw</span>
        <span sx="text-xs font-medium font-body text-warning-foreground bg-warning rounded-sm px-2 py-1 tracking-wide">domain-stub — awaits backend spec</span>
      </row>
      <p sx="text-muted-foreground text-sm leading-relaxed">
        Excalidraw-class freehand whiteboard. SVG-native strokes + shapes +
        selection. No canvas engine — token-themeable paths throughout.
      </p>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <sui-draw theme="light" grid="lines" tool="select" label="Demo whiteboard">
          <span slot="toolbar">toolbar slot</span>
        </sui-draw>
      </column>
      <dl sx="text-sm text-muted-foreground">
        <dt>theme</dt><dd>"light"</dd>
        <dt>grid</dt><dd>"lines"</dd>
        <dt>tool</dt><dd>"select"</dd>
        <dt>sketchy</dt><dd>false</dd>
        <dt>label</dt><dd>"Demo whiteboard"</dd>
      </dl>
    </column>

    <!-- sui-graph-canvas ───────────────────────────────────────── -->
    <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
      <row gap="3">
        <span sx="text-lg font-semibold text-foreground font-mono">sui-graph-canvas</span>
        <span sx="text-xs font-medium font-body text-warning-foreground bg-warning rounded-sm px-2 py-1 tracking-wide">domain-stub — awaits backend spec</span>
      </row>
      <p sx="text-muted-foreground text-sm leading-relaxed">
        Positioned-graph primitive. Renders bezier SVG edges + absolutely-
        positioned node cards. Per-kind node templates via the hidden "node"
        slot.
      </p>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <sui-graph-canvas
          nodes='[{"id":"a","label":"Commander","kind":"agent","x":120,"y":80},{"id":"b","label":"Coder","kind":"agent","x":340,"y":180}]'
          edges='[{"id":"e1","source":"a","target":"b","kind":"agent"}]'
          width="480"
          height="240"
          layout="positioned"
        ></sui-graph-canvas>
      </column>
      <dl sx="text-sm text-muted-foreground">
        <dt>nodes</dt><dd>2 mock nodes (JSON)</dd>
        <dt>edges</dt><dd>1 mock edge (JSON)</dd>
        <dt>width</dt><dd>480</dd>
        <dt>height</dt><dd>240</dd>
        <dt>layout</dt><dd>"positioned"</dd>
      </dl>
    </column>

  </grid>
</column>
