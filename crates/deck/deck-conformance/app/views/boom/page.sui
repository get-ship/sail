<data name="result" source="ship.demo.boom()" live />

<div class="boom-demo">
  <h1>Error Boundary</h1>
  {#while-loading of result}
  <p class="boom-fallback">Loading…</p>
  {/while-loading}
  {#while-error err of result}
  <p class="boom-fallback">Something went wrong</p>
  {/while-error}
  {#if result().kind === 'ok'}
  <p>Value: {result().value.data}</p>
  {/if}
</div>
