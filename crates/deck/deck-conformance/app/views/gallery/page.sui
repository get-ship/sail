<div class="gallery">
  <header class="gallery-header">
    <h1>SUI Component Gallery</h1>
    <p class="gallery-note">
      Primitives marked <strong>sui/*</strong> are real, fully implemented SUI
      components. Sections marked <strong>ship/*</strong> are domain stubs
      backed by the deck-conformance in-memory store — they exercise the live-data
      wire but carry no production Ship logic.
    </p>
  </header>

  <section class="gallery-themes">
    <h2>Theme</h2>
    <div class="theme-buttons">
      <button class:active={activeTheme() === 'ship-light'} on:click={() => activeTheme.set('ship-light')}>SHIP Light</button>
      <button class:active={activeTheme() === 'ship-dark'} on:click={() => activeTheme.set('ship-dark')}>SHIP Dark</button>
      <button class:active={activeTheme() === 'paper'} on:click={() => activeTheme.set('paper')}>Paper</button>
      <button class:active={activeTheme() === 'halo'} on:click={() => activeTheme.set('halo')}>Halo</button>
      <button class:active={activeTheme() === 'console'} on:click={() => activeTheme.set('console')}>Console</button>
      <button class:active={activeTheme() === 'contrast'} on:click={() => activeTheme.set('contrast')}>Contrast</button>
    </div>
    <p class="theme-current">Active: {activeTheme()}</p>
  </section>

  <section class="gallery-components">
    <h2>Shared components</h2>
    <p>
      demo-chip resolves from the app's component workspace; widgets uses the
      same tag, so the multi-entry build hoists it into one shared chunk.
    </p>
    <demo-chip>gallery-alpha</demo-chip>
  </section>

  <nav class="gallery-nav">
    <h2>Pack sections</h2>
    <ul>
      <li><a href="/_deck/view/counter">counter — signal basics (sui/*)</a></li>
      <li><a href="/_deck/view/clock">clock — live data tick (&lt;client name="api"&gt;, api/demo.*)</a></li>
      <li><a href="/_deck/view/todos">todos — live list + mutation (ship/demo.*)</a></li>
      <li><a href="/_deck/view/boom">boom — error boundary (ship/demo.*)</a></li>
      <li><a href="/_deck/view/greet">greet — static SSR (sui/*)</a></li>
      <li><a href="/_deck/view/hello">hello — constant folding (sui/*)</a></li>
      <li><a href="/_deck/view/widgets">widgets — component composition (sui/*)</a></li>
    </ul>
  </nav>
</div>
