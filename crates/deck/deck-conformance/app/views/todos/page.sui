<controller>
import { controller, live } from '@ship/sui-runtime'
import { call } from 'ship'
export default controller({
  setup: (_ctx) => ({ list: live(() => call('ship.demo.todos', {})) }),
})
</controller>

<column gap="3" sx="p-6 max-w-breakpoint-tablet mx-auto">
  <h1 sx="text-2xl font-bold text-foreground">Todos</h1>

  <form mutation="ship.demo.addTodo">
    <input name="text" placeholder="New todo…" />
    <button type="submit">Add</button>
  </form>

  {#while-loading of list}
  <p sx="text-muted-foreground text-sm">Loading…</p>
  {/while-loading}
  {#while-error err of list}
  <p sx="text-destructive text-sm">Error: {err.message}</p>
  {/while-error}
  {#if list().kind === 'ok'}
  <column gap="1" sx="list-none p-0 m-0">
    {#for item of list().value.items key={item.id}}
    <li aria-pressed={item.done} sx="pressed:line-through pressed:text-muted-foreground rounded-md p-1">{item.text}</li>
    {/for}
  </column>
  {/if}
</column>
