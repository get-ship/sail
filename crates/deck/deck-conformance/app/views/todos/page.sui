<data name="list" source="ship.demo.todos()" live />

<div class="todos-demo">
  <h1>Todos</h1>

  <form mutation="ship.demo.addTodo">
    <input name="text" placeholder="New todo…" />
    <button type="submit">Add</button>
  </form>

  {#while-loading of list}
  <p>Loading…</p>
  {/while-loading}
  {#while-error err of list}
  <p>Error: {err.message}</p>
  {/while-error}
  {#if list().kind === 'ok'}
  <ul>
    {#for item of list().value.items key={item.id}}
    <li class:done={item.done}>{item.text}</li>
    {/for}
  </ul>
  {/if}
</div>
