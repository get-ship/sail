<div class="gallery-ship-authority">
  <header class="section-header">
    <h1>ship/authority — Domain Stubs</h1>
    <p class="section-note">
      Pack <strong>ship/authority</strong>. Each card below renders the real custom
      element tag with static mock attribute values so the shell registers and
      paints. A visible badge on each card marks it as a domain stub — no
      <code>ship.*</code> calls, no live data.
    </p>
  </header>

  <!-- ship-approval-card -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>ship-approval-card</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>request: string</code> (JSON-encoded AuthorityRequest). No slots.
      In production the host owns <code>ship.authority.pending()</code> via
      <code>live()</code> and passes each item via <code>prop:request</code>;
      this stub passes a static JSON string. Emits <code>ship-decide</code> and
      <code>ship-inspect</code> custom events.
    </p>
    <div class="stub-preview">
      <div class="stub-variant">
        <span class="stub-variant-label">kind=capability · risk=high</span>
        <ship-approval-card request='{"id":"req-001","agent":"claude-opus","space":"work","kind":"capability","scope":"read_file","path":"/etc/hosts","why":"Need to read the hosts file to resolve local DNS entries","risk":"high"}'></ship-approval-card>
      </div>
      <div class="stub-variant">
        <span class="stub-variant-label">kind=command · risk=medium</span>
        <ship-approval-card request='{"id":"req-002","agent":"codex-agent","space":"personal","kind":"command","command":"npm install --global some-cli","why":"Installing a global CLI tool needed for the build pipeline","risk":"medium"}'></ship-approval-card>
      </div>
      <div class="stub-variant">
        <span class="stub-variant-label">kind=capability · risk=low</span>
        <ship-approval-card request='{"id":"req-003","agent":"cursor-bot","space":"work","kind":"capability","scope":"read_file","path":"./src/config.ts","why":"Checking project config for context","risk":"low"}'></ship-approval-card>
      </div>
    </div>
  </section>

  <!-- ship-capability-request -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>ship-capability-request</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>request: string</code>, <code>duration: once|session|always</code>,
      <code>open: bool</code>. Wraps <code>sui-dialog</code> as an alertdialog.
      In production the host opens it when the operator clicks the agent name on
      <code>ship-approval-card</code>. Emits <code>ship-decide</code> and
      <code>ship-dismiss</code>. Shown open here so the dialog chrome is visible.
    </p>
    <div class="stub-preview">
      <div class="stub-variant">
        <span class="stub-variant-label">open=true · duration=session</span>
        <div class="stub-dialog-host">
          <ship-capability-request
            open
            duration="session"
            request='{"id":"req-004","agent":"claude-opus","space":"work","kind":"capability","scope":"write_file","path":"./output/report.md","why":"Writing the final analysis report to the output directory","risk":"medium"}'
          ></ship-capability-request>
        </div>
      </div>
      <div class="stub-variant">
        <span class="stub-variant-label">open=true · duration=once</span>
        <div class="stub-dialog-host">
          <ship-capability-request
            open
            duration="once"
            request='{"id":"req-005","agent":"gemini-agent","space":"personal","kind":"capability","scope":"read_file","path":"/home/user/.ssh/config","why":"Reading SSH config to list available hosts","risk":"high"}'
          ></ship-capability-request>
        </div>
      </div>
    </div>
  </section>

  <!-- sui-auth-dialog -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>sui-auth-dialog</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>open: bool</code>, <code>mode: sign-in|sign-up</code>,
      <code>loading: bool</code>, <code>backdrop: default|blur|solid</code>.
      Slots: <code>header</code>, <code>harnesses</code>, <code>terms</code>.
      Emits <code>sui-auth-submit</code>, <code>sui-mode-change</code>,
      <code>sui-close</code>. Shown open here so the dialog chrome is visible.
    </p>
    <div class="stub-preview">
      <div class="stub-variant">
        <span class="stub-variant-label">mode=sign-in · backdrop=blur · open=true</span>
        <div class="stub-dialog-host">
          <sui-auth-dialog open mode="sign-in" backdrop="blur">
            <span slot="header">Sign in to Ship</span>
            <div slot="harnesses">
              <sui-button variant="outline" size="md">Continue with Claude</sui-button>
            </div>
            <span slot="terms">By signing in you agree to the Terms of Service.</span>
          </sui-auth-dialog>
        </div>
      </div>
      <div class="stub-variant">
        <span class="stub-variant-label">mode=sign-up · backdrop=solid · open=true</span>
        <div class="stub-dialog-host">
          <sui-auth-dialog open mode="sign-up" backdrop="solid">
            <span slot="header">Create your account</span>
            <span slot="terms">Free during beta. No credit card required.</span>
          </sui-auth-dialog>
        </div>
      </div>
      <div class="stub-variant">
        <span class="stub-variant-label">loading=true · mode=sign-in · open=true</span>
        <div class="stub-dialog-host">
          <sui-auth-dialog open mode="sign-in" loading backdrop="default">
            <span slot="header">Sign in to Ship</span>
            <span slot="terms">Hang tight…</span>
          </sui-auth-dialog>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .gallery-ship-authority {
    padding: var(--space-6);
    max-width: 960px;
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }

  .section-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-4);
  }

  .section-header h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }

  .section-note {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.6;
  }

  .stub-section {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .stub-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }

  .stub-heading code {
    font-family: var(--font-mono);
    font-size: inherit;
  }

  .stub-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--tone-warning-fg);
    background: var(--tone-warning-bg);
    border: 1px solid var(--tone-warning-border);
    border-radius: var(--radius-full);
    padding: 2px var(--space-2);
    white-space: nowrap;
  }

  .stub-desc {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.6;
  }

  .stub-preview {
    display: grid;
    gap: var(--space-4);
  }

  .stub-variant {
    display: grid;
    gap: var(--space-2);
    border: 1px solid var(--divider, var(--border));
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--surface-2, var(--background));
  }

  .stub-variant-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-transform: lowercase;
    letter-spacing: var(--tracking-wide);
    font-family: var(--font-mono);
  }

  .stub-dialog-host {
    position: relative;
    min-height: 200px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
</style>
