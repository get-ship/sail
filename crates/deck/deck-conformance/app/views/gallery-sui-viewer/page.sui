<div class="section">
  <header class="section-header">
    <h1>sui/viewer</h1>
    <p class="section-note">
      The five viewing primitives: <strong>sui-component-viewer</strong>,
      <strong>sui-prop-knobs</strong>, <strong>sui-prop-matrix</strong>,
      <strong>sui-render</strong>, and <strong>sui-source-panel</strong>.
      Scalar props are demonstrated below. Structured inputs (source signal,
      CEM attrs, compile fn) arrive via <code>prop:*</code> identity at runtime.
    </p>
  </header>

  <!-- ── sui-component-viewer ───────────────────────────────────────── -->
  <section class="component-card">
    <h2 class="card-title">sui-component-viewer</h2>
    <p class="card-desc">
      The composition primitive — one tag a host drops in to get a live,
      reactive preview of a SUI component (stage + knobs + matrix + source).
    </p>
    <div class="variants">
      <div class="variant-row">
        <span class="variant-label">viewport-width=full (default)</span>
        <sui-component-viewer component-name="sui-button" viewport-width="full"></sui-component-viewer>
      </div>
      <div class="variant-row">
        <span class="variant-label">viewport-width=desktop</span>
        <sui-component-viewer component-name="sui-button" viewport-width="desktop"></sui-component-viewer>
      </div>
      <div class="variant-row">
        <span class="variant-label">viewport-width=tablet</span>
        <sui-component-viewer component-name="sui-alert" viewport-width="tablet"></sui-component-viewer>
      </div>
      <div class="variant-row">
        <span class="variant-label">viewport-width=mobile</span>
        <sui-component-viewer component-name="sui-code" viewport-width="mobile"></sui-component-viewer>
      </div>
    </div>
  </section>

  <!-- ── sui-prop-knobs ────────────────────────────────────────────── -->
  <section class="component-card">
    <h2 class="card-title">sui-prop-knobs</h2>
    <p class="card-desc">
      The CEM-driven playground — classifies each attribute into an enum
      toggle-group, bool switch, number input, or text input. No scalar
      structural props: knob content arrives via <code>prop:props</code>
      (CEM attrs) and <code>prop:value</code> (current values) at runtime.
    </p>
    <div class="variants">
      <div class="variant-row">
        <span class="variant-label">idle (no CEM wired)</span>
        <sui-prop-knobs></sui-prop-knobs>
      </div>
    </div>
  </section>

  <!-- ── sui-prop-matrix ───────────────────────────────────────────── -->
  <section class="component-card">
    <h2 class="card-title">sui-prop-matrix</h2>
    <p class="card-desc">
      The Storybook-style state sweep — derives axes from the target CEM and
      builds the full cartesian grid, one <code>sui-render</code> per cell.
    </p>
    <div class="variants">
      <div class="variant-row">
        <span class="variant-label">component-name=sui-button</span>
        <sui-prop-matrix component-name="sui-button"></sui-prop-matrix>
      </div>
      <div class="variant-row">
        <span class="variant-label">component-name=sui-alert</span>
        <sui-prop-matrix component-name="sui-alert"></sui-prop-matrix>
      </div>
      <div class="variant-row">
        <span class="variant-label">component-name="" (empty state)</span>
        <sui-prop-matrix component-name=""></sui-prop-matrix>
      </div>
    </div>
  </section>

  <!-- ── sui-render ────────────────────────────────────────────────── -->
  <section class="component-card">
    <h2 class="card-title">sui-render</h2>
    <p class="card-desc">
      The engine primitive — a live, reactive mount stage. The bound
      <code>compile()</code> and raw <code>source</code> arrive via
      <code>prop:*</code> identity; the three scalar attrs control mode and
      viewport framing.
    </p>
    <div class="variants">
      <div class="variant-row">
        <span class="variant-label">mode=source viewport-width=full</span>
        <sui-render mode="source" viewport-width="full"></sui-render>
      </div>
      <div class="variant-row">
        <span class="variant-label">mode=tag viewport-width=desktop</span>
        <sui-render mode="tag" component-name="sui-button" viewport-width="desktop"></sui-render>
      </div>
      <div class="variant-row">
        <span class="variant-label">mode=source viewport-width=tablet</span>
        <sui-render mode="source" viewport-width="tablet"></sui-render>
      </div>
      <div class="variant-row">
        <span class="variant-label">mode=source viewport-width=mobile</span>
        <sui-render mode="source" viewport-width="mobile"></sui-render>
      </div>
    </div>
  </section>

  <!-- ── sui-source-panel ──────────────────────────────────────────── -->
  <section class="component-card">
    <h2 class="card-title">sui-source-panel</h2>
    <p class="card-desc">
      Source + paste-able snippet — shows the raw <code>.sui</code> source and
      a recomputed snippet that default-diffs the current prop values. The Copy
      button writes the snippet to the clipboard.
    </p>
    <div class="variants">
      <div class="variant-row">
        <span class="variant-label">component-name=sui-button lang=html</span>
        <sui-source-panel component-name="sui-button" lang="html"></sui-source-panel>
      </div>
      <div class="variant-row">
        <span class="variant-label">component-name=sui-alert lang=html</span>
        <sui-source-panel component-name="sui-alert" lang="html"></sui-source-panel>
      </div>
      <div class="variant-row">
        <span class="variant-label">component-name=sui-code lang=html</span>
        <sui-source-panel component-name="sui-code" lang="html"></sui-source-panel>
      </div>
    </div>
  </section>
</div>

<style>
  .section {
    padding: var(--space-6);
    max-width: 960px;
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }

  .section-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-4);
  }

  .section-header h1 {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }

  .section-note {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    margin: 0;
  }

  .component-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
    font-family: var(--font-mono);
  }

  .card-desc {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.6;
  }

  .variants {
    display: grid;
    gap: var(--space-4);
  }

  .variant-row {
    display: grid;
    gap: var(--space-2);
    border: 1px solid var(--divider);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--surface-2);
  }

  .variant-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    text-transform: lowercase;
    letter-spacing: var(--tracking-wide);
    font-family: var(--font-mono);
  }
</style>
