<column gap="8" sx="p-6 max-w-breakpoint-tablet mx-auto">
  <header sx="border-b border-b-border pb-4">
    <h1 sx="text-2xl font-bold text-foreground mb-2">sui/viewer</h1>
    <p sx="text-muted-foreground text-sm">
      The five viewing primitives: <strong>sui-component-viewer</strong>,
      <strong>sui-prop-knobs</strong>, <strong>sui-prop-matrix</strong>,
      <strong>sui-render</strong>, and <strong>sui-source-panel</strong>.
      Scalar props are demonstrated below. Structured inputs (source signal,
      CEM attrs, compile fn) arrive via <code>prop:*</code> identity at runtime.
    </p>
  </header>

  <!-- ── sui-component-viewer ───────────────────────────────────────── -->
  <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
    <h2 sx="text-lg font-semibold text-foreground font-mono">sui-component-viewer</h2>
    <p sx="text-muted-foreground text-sm leading-relaxed">
      The composition primitive — one tag a host drops in to get a live,
      reactive preview of a SUI component (stage + knobs + matrix + source).
    </p>
    <column gap="4">
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">viewport-width=full (default)</span>
        <sui-component-viewer component-name="sui-button" viewport-width="full"></sui-component-viewer>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">viewport-width=desktop</span>
        <sui-component-viewer component-name="sui-button" viewport-width="desktop"></sui-component-viewer>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">viewport-width=tablet</span>
        <sui-component-viewer component-name="sui-field" viewport-width="tablet"></sui-component-viewer>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">viewport-width=mobile</span>
        <sui-component-viewer component-name="sui-code" viewport-width="mobile"></sui-component-viewer>
      </column>
    </column>
  </column>

  <!-- ── sui-prop-knobs ────────────────────────────────────────────── -->
  <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
    <h2 sx="text-lg font-semibold text-foreground font-mono">sui-prop-knobs</h2>
    <p sx="text-muted-foreground text-sm leading-relaxed">
      The CEM-driven playground — classifies each attribute into an enum
      toggle-group, bool switch, number input, or text input. No scalar
      structural props: knob content arrives via <code>prop:props</code>
      (CEM attrs) and <code>prop:value</code> (current values) at runtime.
    </p>
    <column gap="4">
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">idle (no CEM wired)</span>
        <sui-prop-knobs></sui-prop-knobs>
      </column>
    </column>
  </column>

  <!-- ── sui-prop-matrix ───────────────────────────────────────────── -->
  <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
    <h2 sx="text-lg font-semibold text-foreground font-mono">sui-prop-matrix</h2>
    <p sx="text-muted-foreground text-sm leading-relaxed">
      The Storybook-style state sweep — derives axes from the target CEM and
      builds the full cartesian grid, one <code>sui-render</code> per cell.
    </p>
    <column gap="4">
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name=sui-button</span>
        <sui-prop-matrix component-name="sui-button"></sui-prop-matrix>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name=sui-field</span>
        <sui-prop-matrix component-name="sui-field"></sui-prop-matrix>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name="" (empty state)</span>
        <sui-prop-matrix component-name=""></sui-prop-matrix>
      </column>
    </column>
  </column>

  <!-- ── sui-render ────────────────────────────────────────────────── -->
  <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
    <h2 sx="text-lg font-semibold text-foreground font-mono">sui-render</h2>
    <p sx="text-muted-foreground text-sm leading-relaxed">
      The engine primitive — a live, reactive mount stage. The bound
      <code>compile()</code> and raw <code>source</code> arrive via
      <code>prop:*</code> identity; the three scalar attrs control mode and
      viewport framing.
    </p>
    <column gap="4">
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">mode=source viewport-width=full</span>
        <sui-render mode="source" viewport-width="full"></sui-render>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">mode=tag viewport-width=desktop</span>
        <sui-render mode="tag" component-name="sui-button" viewport-width="desktop"></sui-render>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">mode=source viewport-width=tablet</span>
        <sui-render mode="source" viewport-width="tablet"></sui-render>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">mode=source viewport-width=mobile</span>
        <sui-render mode="source" viewport-width="mobile"></sui-render>
      </column>
    </column>
  </column>

  <!-- ── sui-source-panel ──────────────────────────────────────────── -->
  <column gap="4" sx="border border-border rounded-lg bg-surface-1 p-5">
    <h2 sx="text-lg font-semibold text-foreground font-mono">sui-source-panel</h2>
    <p sx="text-muted-foreground text-sm leading-relaxed">
      Source + paste-able snippet — shows the raw <code>.sui</code> source and
      a recomputed snippet that default-diffs the current prop values. The Copy
      button writes the snippet to the clipboard.
    </p>
    <column gap="4">
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name=sui-button lang=html</span>
        <sui-source-panel component-name="sui-button" lang="html"></sui-source-panel>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name=sui-field lang=html</span>
        <sui-source-panel component-name="sui-field" lang="html"></sui-source-panel>
      </column>
      <column gap="2" sx="border border-divider rounded-md p-3 bg-surface-2">
        <span sx="text-xs font-medium text-muted-foreground lowercase tracking-wide font-mono">component-name=sui-code lang=html</span>
        <sui-source-panel component-name="sui-code" lang="html"></sui-source-panel>
      </column>
    </column>
  </column>
</column>
