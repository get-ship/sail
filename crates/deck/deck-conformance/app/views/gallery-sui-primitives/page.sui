    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-card</h2>
    <row gap="3" align="start">
      <card sx="w-48">
        <span slot="header">Default card</span>
        Content in the default slot.
