      <error-state size="sm"><span slot="title">Load failed</span>
        Connection timed out.
        <sui-button slot="action" variant="outline" size="sm">Retry</sui-button>
      </error-state>
    </row>
  </section>

  <!-- Field + Label -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">field / sui-label / sui-input / sui-textarea</h2>
    <column gap="3" sx="max-w-panel-max-w-sm">
      <field>
        <sui-label slot="label" required>Name</sui-label>
        <input type="text" placeholder="Enter your name" name="demo-name">
