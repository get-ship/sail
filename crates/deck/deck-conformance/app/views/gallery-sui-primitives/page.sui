  <!-- Tree view -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-tree-view</h2>
    <row gap="3" align="start">
      <sui-tree>
        <sui-tree-item label="src" expanded>
          <sui-tree-item label="components" leaf>
            <icon slot="icon" name="folder" size="sm"></icon>
          </sui-tree-item>
          <sui-tree-item label="views" expanded>
            <sui-tree-item label="page.sui" leaf></sui-tree-item>
            <sui-tree-item label="controller.ts" leaf></sui-tree-item>
          </sui-tree-item>
        </sui-tree-item>
        <sui-tree-item label="tests" leaf></sui-tree-item>
      </sui-tree>
    </row>
