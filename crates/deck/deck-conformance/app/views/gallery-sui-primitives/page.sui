      <tabs active="e1" variant="enclosed" size="sm">
        <sui-tab name="e1" label="Code"></sui-tab>
        <sui-tab name="e2" label="Preview"></sui-tab>
      </tabs>
    </column>
  </section>

  <!-- Timeline -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-timeline</h2>
    <row gap="3" align="start">
      <sui-timeline>
        <sui-timeline-item tone="success" at="2026-06-01">
          <span slot="title">Deployed</span>
          Release shipped to production.
        </sui-timeline-item>
        <sui-timeline-item tone="info" at="2026-05-30">
          <span slot="title">Review passed</span>
          All checks green.
        </sui-timeline-item>
        <sui-timeline-item tone="muted" at="2026-05-28">
          <span slot="title">PR opened</span>
          Initial draft created.
        </sui-timeline-item>
      </sui-timeline>
    </row>
  </section>

  <!-- Toast -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-toast (static preview)</h2>
    <column gap="3" sx="max-w-panel-max-w-sm">
      <toast tone="info">
        <span slot="title">Info toast</span>
        Something happened you should know about.
      </toast>
      <toast tone="success" show-progress>
        <span slot="title">Success</span>
        File uploaded successfully.
      </toast>
      <toast tone="destructive" dismissible>
        <span slot="title">Error</span>
        Upload failed — try again.
      </toast>
