  <!-- Scroll area -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-scroll-area</h2>
    <row gap="3" align="start">
      <scroll-area orientation="vertical" sx="h-32 w-panel-max-w-sm border border-border rounded-md">
        <column gap="1" sx="p-2">
          <p>Line 1</p><p>Line 2</p><p>Line 3</p><p>Line 4</p>
          <p>Line 5</p><p>Line 6</p><p>Line 7</p><p>Line 8</p>
        </column>
