  <!-- JSON view -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-json-view</h2>
    <row gap="3" align="start">
      <sui-json-view data={'{"name":"SUI","version":1,"stable":true}'} depth="2" expanded></sui-json-view>
    </row>
  </section>

  <!-- Markdown -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-markdown</h2>
    <row gap="3" align="start" sx="max-w-panel-max-w-md">
      <sui-markdown value="## Hello from **Markdown**&#10;&#10;- Item one&#10;- Item two&#10;- `code` inline"></sui-markdown>
    </row>
  </section>

  <!-- Diff -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-diff</h2>
    <row gap="3" align="start">
      <sui-diff from="const x = 1;" to="const x = 2;"></sui-diff>
    </row>
  </section>

  <!-- Table (slot mode) -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-table (slot mode)</h2>
    <row gap="3" align="start">
      <table variant="slot" label="Demo table" hoverable>
        <tr slot="head"><th>Name</th><th>Role</th><th>Status</th></tr>
        <tr><td>Alice</td><td>Engineer</td><td><span tone="success" sx="inline-block min-h-control-h-2xs px-1_5 text-xs font-semibold rounded-sm bg-tone-bg border-tone-border text-tone-fg">Active</span></td></tr>
        <tr><td>Bob</td><td>Designer</td><td><span tone="warning" sx="inline-block min-h-control-h-2xs px-1_5 text-xs font-semibold rounded-sm bg-tone-bg border-tone-border text-tone-fg">Away</span></td></tr>
        <tr><td>Carol</td><td>PM</td><td><span tone="muted" sx="inline-block min-h-control-h-2xs px-1_5 text-xs font-semibold rounded-sm bg-tone-bg border-tone-border text-tone-fg">Offline</span></td></tr>
      </table>
    </row>
  </section>

  <!-- Color picker -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-color-picker</h2>
    <row gap="3" align="start">
      <sui-color-picker name="demo-color1" value="#3b82f6"></sui-color-picker>
      <sui-color-picker name="demo-color2" value="#22c55e" size="sm"></sui-color-picker>
      <sui-color-picker name="demo-color3" value="#ef4444" size="lg" tone="primary"></sui-color-picker>
    </row>
  </section>

  <!-- Date picker -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-date-picker</h2>
    <row gap="3" align="start">
      <sui-date-picker name="demo-date1" placeholder="YYYY-MM-DD"></sui-date-picker>
      <sui-date-picker name="demo-date2" value="2026-06-05" tone="primary" size="sm"></sui-date-picker>
    </row>
  </section>

  <!-- File upload -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-file-upload</h2>
    <column gap="3" sx="max-w-panel-max-w-sm">
      <sui-file-upload accept="image/*,application/pdf" tone="primary"></sui-file-upload>
      <sui-file-upload multiple accept=".json,.csv" tone="muted"></sui-file-upload>
    </column>
  </section>

  <!-- Autocomplete -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-autocomplete</h2>
    <row gap="3" align="start">
      <combobox name="demo-ac" placeholder="Search fruits…" suggestions='["Apple","Apricot","Banana","Blueberry","Cherry","Date"]' size="md"></combobox>
    </row>
  </section>

  <!-- ── OVERLAYS ─────────────────────────────────────────────────────────── -->

  <!-- sui-dialog -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-dialog</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Modal dialog — size=md, backdrop=default</p>
        <sui-button variant="outline" size="sm" on:click={dialogDemo.open}>Open dialog</sui-button>
        <dialog use:dialogDemo>
          <header>Confirm action</header>
          <section>Are you sure you want to proceed? This cannot be undone.</section>
          <footer>
            <sui-button variant="outline" size="sm" on:click={dialogDemo.close}>Cancel</sui-button>
            <sui-button variant="solid" tone="primary" size="sm" on:click={dialogDemo.close}>Confirm</sui-button>
          </footer>
        </dialog>
      </column>
    </row>
  </section>

  <!-- sui-alert-dialog -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-alert-dialog</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Destructive confirm dialog with built-in cancel/confirm footer</p>
        <sui-button variant="outline" tone="destructive" size="sm" on:click={() => alertDialogOpen.set(true)}>Delete item</sui-button>
        <dialog role="alertdialog"
          prop:open={alertDialogOpen()}
          tone="destructive"
          confirm-label="Delete"
          cancel-label="Keep it"
        >
          <span slot="title">Delete this item?</span>
          This action is permanent and cannot be reversed. All associated data will be removed.
        </dialog>
      </column>
    </row>
  </section>

  <!-- sui-drawer -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-drawer</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Side-sheet panel — side=right, size=md</p>
        <sui-button variant="outline" size="sm" on:click={() => drawerOpen.set(true)}>Open drawer</sui-button>
        <dialog side="end" prop:open={drawerOpen()} side="right" size="md">
          <span slot="title">Settings</span>
          <span slot="description">Adjust your workspace preferences.</span>
          <column gap="3">
            <field>
              <sui-label slot="label">Theme</sui-label>
              <select name="drawer-theme"><option value="light">Light</option><option value="dark">Dark</option></select>
            </field>
            <field>
              <sui-label slot="label">Language</sui-label>
              <select name="drawer-lang"><option value="en">English</option><option value="es">Español</option></select>
            </field>
          </column>
          <span slot="footer">
            <sui-button variant="outline" size="sm" on:click={() => drawerOpen.set(false)}>Cancel</sui-button>
            <sui-button variant="solid" tone="primary" size="sm" on:click={() => drawerOpen.set(false)}>Save</sui-button>
          </span>
        </dialog>
      </column>
    </row>
  </section>

  <!-- sui-popover -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-popover</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Anchor-positioned popover — placement=bottom</p>
        <popover placement="bottom">
          <sui-button slot="trigger" variant="outline" size="sm">Open popover</sui-button>
          <column gap="1" sx="p-3 max-w-56">
            <strong sx="text-sm">Popover content</strong>
            <p sx="text-xs text-muted-foreground">
              Click outside or press Escape to dismiss. Uses native popover API for top-layer rendering.
            </p>
          </column>
        </popover>
      </column>
    </row>
  </section>

  <!-- sui-dropdown-menu -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-dropdown-menu</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Trigger-anchored menu with ARIA role=menu + keyboard navigation</p>
        <dropdown>
          <sui-button slot="trigger" variant="outline" size="sm">
            Actions
            <icon slot="trailing" name="chevron-down" size="xs"></icon>
          </sui-button>
          <sui-menu-item value="edit">Edit</sui-menu-item>
          <sui-menu-item value="duplicate">Duplicate</sui-menu-item>
          <sui-menu-separator></sui-menu-separator>
          <sui-menu-item value="delete" tone="destructive">Delete</sui-menu-item>
        </dropdown>
      </column>
    </row>
  </section>

  <!-- sui-hover-card -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-hover-card</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Hover-triggered rich content overlay — placement=bottom, delay=300ms</p>
        <hover-card placement="bottom" show-delay="300" hide-delay="150">
          <sui-button slot="trigger" variant="ghost" size="sm">
            <avatar name="Alice Hart" size="sm" tone="primary"></avatar>
            Alice Hart
          </sui-button>
          <column gap="2">
            <row gap="2">
              <avatar name="Alice Hart" size="md" tone="primary"></avatar>
              <column gap="0">
                <span sx="font-semibold text-sm">Alice Hart</span>
                <span sx="text-xs text-muted-foreground">Senior Engineer</span>
              </column>
            </row>
            <p sx="text-xs text-muted-foreground">
              Joined 2023 · 142 contributions · Rust, TypeScript
            </p>
          </column>
        </hover-card>
      </column>
    </row>
  </section>

  <!-- sui-context-menu -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-context-menu</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Right-click triggered overlay menu — positioned at cursor via show(x,y)</p>
        <context-menu>
          <column slot="trigger" sx="py-4 px-6 border border-border rounded-md text-center text-sm text-muted-foreground select-none cursor-context-menu">Right-click this area</column>
          <sui-menu-item value="open">Open</sui-menu-item>
          <sui-menu-item value="rename">Rename</sui-menu-item>
          <sui-menu-separator></sui-menu-separator>
          <sui-menu-item value="copy">Copy path</sui-menu-item>
          <sui-menu-separator></sui-menu-separator>
          <sui-menu-item value="delete" tone="destructive">Move to trash</sui-menu-item>
        </context-menu>
      </column>
    </row>
  </section>

  <!-- ── OPAQUE-JSON-PROP ──────────────────────────────────────────────────── -->

  <!-- sui-combobox -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-combobox</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48 max-w-panel-max-w-sm">
        <p sx="text-xs text-muted-foreground leading-normal">Single-select with type-to-filter — options via JSON</p>
        <combobox
          name="demo-combo"
          placeholder="Search framework…"
          options='[{"value":"react","label":"React"},{"value":"vue","label":"Vue"},{"value":"svelte","label":"Svelte"},{"value":"solid","label":"SolidJS"},{"value":"sui","label":"SUI (Ship)"}]'
          size="md"
        ></combobox>
      </column>
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48 max-w-64">
        <p sx="text-xs text-muted-foreground leading-normal">Pre-selected value · size=sm</p>
        <combobox
          name="demo-combo2"
          value="sui"
          options='[{"value":"react","label":"React"},{"value":"vue","label":"Vue"},{"value":"sui","label":"SUI (Ship)"}]'
          size="sm"
          tone="primary"
        ></combobox>
      </column>
    </row>
  </section>

  <!-- sui-calendar -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-calendar</h2>
    <column gap="3">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Month view with 3 events — focus-date=2026-06-05</p>
        <sui-calendar
          view="month"
          focus-date="2026-06-05"
          events='[{"id":"e1","title":"Team standup","start":"2026-06-03T09:00:00","end":"2026-06-03T09:30:00","tone":"primary"},{"id":"e2","title":"Design review","start":"2026-06-10T14:00:00","end":"2026-06-10T15:00:00","tone":"info"},{"id":"e3","title":"Ship launch","start":"2026-06-20T12:00:00","end":"2026-06-20T13:00:00","tone":"success"}]'
        ></sui-calendar>
      </column>
    </column>
  </section>

  <!-- sui-tree -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-tree</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-panel-min-w-md">
        <p sx="text-xs text-muted-foreground leading-normal">Hierarchical tree — selectable=single, show-guides</p>
        <sui-tree
          label="File system"
          selectable="single"
          show-guides
          nodes='[{"id":"src","label":"src","children":[{"id":"comp","label":"components","children":[{"id":"btn","label":"sui-button.sui"},{"id":"card","label":"sui-card.sui"}]},{"id":"views","label":"views","children":[{"id":"pg","label":"page.sui"},{"id":"ct","label":"controller.ts"}]}]},{"id":"tests","label":"tests"}]'
        ></sui-tree>
      </column>
    </row>
  </section>

  <!-- sui-tree-view / sui-tree-item — already covered above but was a thin static stub; a full grid follows -->
  <!-- sui-tree-grid -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-tree-grid</h2>
    <column gap="3">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Hierarchical tree-grid (role=treegrid) — columns with Name, Size, Kind</p>
        <sui-tree-grid
          label="Artifact tree"
          selectable="single"
          nodes='[{"id":"dist","label":"dist","size":"2.4 MB","kind":"dir","children":[{"id":"main","label":"main.js","size":"1.1 MB","kind":"js"},{"id":"css","label":"style.css","size":"42 KB","kind":"css"},{"id":"assets","label":"assets","size":"1.2 MB","kind":"dir","children":[{"id":"logo","label":"logo.svg","size":"4 KB","kind":"svg"}]}]},{"id":"pkg","label":"package.json","size":"1.8 KB","kind":"json"}]'
          columns='[{"id":"label","header":"Name","accessorKey":"label"},{"id":"size","header":"Size","accessorKey":"size"},{"id":"kind","header":"Kind","accessorKey":"kind"}]'
        ></sui-tree-grid>
      </column>
    </column>
  </section>

  <!-- sui-sheet -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-sheet</h2>
    <column gap="3">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">Spreadsheet primitive — 2-D cell space with A1 addressing and formula bar</p>
        <dialog side="end"
          label="Budget sheet"
          show-headers
          show-gridlines
          show-formula-bar
          workbook={'{"sheets":[{"id":"sheet1","name":"Q2 Budget","cells":{"A1":{"v":"Category"},"B1":{"v":"Budget"},"C1":{"v":"Spent"},"A2":{"v":"Engineering"},"B2":{"v":50000},"C2":{"v":42300},"A3":{"v":"Design"},"B3":{"v":20000},"C3":{"v":18750},"A4":{"v":"Marketing"},"B4":{"v":15000},"C4":{"v":9200}}}]}'}
          sx="h-56"
        ></dialog>
      </column>
    </column>
  </section>

  <!-- ── INFRA/COMPANION ───────────────────────────────────────────────────── -->

  <!-- sui-portal -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-portal</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">
          Teleports slotted children into a different DOM location (stacking-context escape).
          The portal below appends a labelled marker to <code>body</code> — inspect the
          DOM to confirm it lives outside this view's mount point.
        </p>
                  <column sx="hidden" data-portal-demo aria-hidden="true">
            [sui-portal demo — this node lives in &lt;body&gt;, not in the gallery mount]
          </column>
                <p sx="text-xs text-muted-foreground italic">Portal active — check DevTools &gt; Elements for the marker in &lt;body&gt;.</p>
      </column>
    </row>
  </section>

  <!-- sui-toast-container -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-toast-container / sui-toast-host</h2>
    <row gap="3" align="start">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">
          <code>sui-toast-container</code> is the fixed-position stacking host.
          <code>sui-toast-host</code> wraps it and listens for <code>ship:notify</code> events.
          Click the button to dispatch a notify event — the host shows the toast.
        </p>
        <toast-region position="bottom-end"></toast-region>
        <row gap="3" align="start">
          <sui-button variant="outline" size="sm" on:click={() => showSuccessToast()}>
            Show success toast
          </sui-button>
          <sui-button variant="outline" size="sm" on:click={() => showErrorToast()}>
            Show error toast
          </sui-button>
          <sui-button variant="outline" size="sm" on:click={() => showInfoToast()}>
            Show info toast
          </sui-button>
        </row>
      </column>
    </row>
  </section>

  <!-- sui-tab-panel -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-tab-panel (inside sui-tabs)</h2>
    <column gap="3">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">
          <code>sui-tab-panel</code> is the companion panel element driven by the parent
          <code>sui-tabs</code> controller. Each panel shows when its <code>name</code>
          matches the active tab.
        </p>
        <tabs active="tp1" variant="line">
          <sui-tab name="tp1" label="Overview"></sui-tab>
          <sui-tab name="tp2" label="Details"></sui-tab>
          <sui-tab name="tp3" label="History"></sui-tab>
          <tab-panel name="tp1">
            <column sx="p-4 text-sm text-muted-foreground bg-surface-2 rounded-md">
              Overview panel — rendered when the Overview tab is active.
              Uses <code>animation: sui-tab-panel-fade</code> on transition.
            </column>
          </tab-panel>
          <tab-panel name="tp2">
            <column sx="p-4 text-sm text-muted-foreground bg-surface-2 rounded-md">
              Details panel — secondary content rendered on demand.
            </column>
          </tab-panel>
          <tab-panel name="tp3">
            <column sx="p-4 text-sm text-muted-foreground bg-surface-2 rounded-md">
              History panel — lazy content until the user navigates here.
            </column>
          </tab-panel>
        </tabs>
      </column>
    </column>
  </section>

  <!-- sui-error-boundary -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">sui-error-boundary</h2>
    <column gap="3">
      <column gap="3" sx="border border-border rounded-md bg-surface-1 p-4 min-w-48">
        <p sx="text-xs text-muted-foreground leading-normal">
          Render-fault isolation. Toggle the switch to simulate a subtree error;
          the boundary catches it and shows the fallback. Click Retry to recover.
        </p>
        <row gap="3" align="start">
          <label><switch name="demo-eb-trigger" prop:checked={triggerError()} on:change={(e) => triggerError.set(e.target.checked)}></switch> Trigger subtree error</label>
        </row>
        <error-boundary fallback-text="The widget threw an error — click Retry to recover.">
          {#if triggerError()}
            <column sx="hidden">This subtree is broken (error boundary will catch)</column>
          {:else}
            <column sx="p-4 text-sm bg-surface-2 rounded-md text-success-foreground">
              Subtree is healthy. Toggle the switch above to simulate a fault.
            </column>
          {/if}
        </error-boundary>
      </column>
    </column>
  </section>

  <!-- ── #263-BLOCKED ──────────────────────────────────────────────────────── -->

  <!-- sui-board / sui-draw / sui-media-av / sui-media-image / sui-media-csv -->
  <section>
    <h2 sx="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3 pb-2 border-b border-b-border">Blocked by #263 — production-compile gap</h2>
    <column gap="3">

      <column gap="2" sx="p-4 rounded-md border border-tone-destructive-border bg-tone-destructive-bg">
        <row gap="3">
          <code>sui-board</code>
          <span tone="destructive" sx="inline-block min-h-control-h-2xs px-2 text-xs font-medium rounded-full bg-tone-bg border border-tone-border text-tone-fg whitespace-nowrap">blocked by #263 — production-compile gap</span>
        </row>
        <p sx="text-xs text-muted-foreground leading-relaxed">
          <code>sui-board</code> uses <code>Set.prototype.has()</code> inside template
          expressions, which the real (native) SUI compiler rejects. Passes jsdom tests;
          fails <code>cargo run -p sui-compiler -- build</code>. Tracked in #263.
        </p>
      </column>

      <column gap="2" sx="p-4 rounded-md border border-tone-destructive-border bg-tone-destructive-bg">
        <row gap="3">
          <code>sui-draw</code>
          <span tone="destructive" sx="inline-block min-h-control-h-2xs px-2 text-xs font-medium rounded-full bg-tone-bg border border-tone-border text-tone-fg whitespace-nowrap">blocked by #263 — production-compile gap</span>
        </row>
        <p sx="text-xs text-muted-foreground leading-relaxed">
          <code>sui-draw</code> uses <code>Set.prototype.has()</code> inside template
          expressions, which the real (native) SUI compiler rejects. Passes jsdom tests;
          fails <code>cargo run -p sui-compiler -- build</code>. Tracked in #263.
        </p>
      </column>

      <column gap="2" sx="p-4 rounded-md border border-tone-destructive-border bg-tone-destructive-bg">
        <row gap="3">
          <code>sui-media-av</code> / <code>sui-media-image</code> / <code>sui-media-csv</code>
          <span tone="destructive" sx="inline-block min-h-control-h-2xs px-2 text-xs font-medium rounded-full bg-tone-bg border border-tone-border text-tone-fg whitespace-nowrap">blocked by #263 — production-compile gap</span>
        </row>
        <p sx="text-xs text-muted-foreground leading-relaxed">
          All three <code>sui-media-*</code> components use <code>bind:this</code> on
          non-root elements inside conditional branches, which the real compiler rejects.
          The gallery-sui-media view covers the scalar-attr surface of these components
          (no expressions involving the blocked patterns). Tracked in #263.
        </p>
      </column>

    </column>
  </section>
</column>
