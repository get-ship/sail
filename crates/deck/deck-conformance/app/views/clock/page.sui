<client name="api" />
<data name="t" source="api.demo.clock()" live />

<div class="clock-demo">
  <h1>Live Clock</h1>
  {#while-loading of t}
  <p>Loading…</p>
  {/while-loading}
  {#while-error err of t}
  <p>Error: {err.message}</p>
  {/while-error}
  {#if t().kind === 'ok'}
  <p class="tick">Tick: <strong>{t().value.now}</strong></p>
  {/if}
</div>
