<column gap="2" sx={style.pad(6).maxW(breakpoint-tablet).mx(auto)}>
  <h1 sx={style.fontSize(2xl).fontWeight(bold).fg(foreground)}>Greet</h1>
  <p sx={style.fg(muted-foreground).fontSize(sm)}>Pick a name to greet:</p>
  <ul sx={style.list(none).pad(0).m(0)}>
    <li><a href="/_deck/view/greet/zelda">greet/zelda</a></li>
    <li><a href="/_deck/view/greet/link">greet/link</a></li>
    <li><a href="/_deck/view/greet/ganon">greet/ganon</a></li>
  </ul>
</column>
