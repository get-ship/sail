        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "$ref": "#/definitions/Json"
      },
      "theme": {
        "$ref": "#/definitions/Json"
      },
      "tree": {
        "$ref": "#/definitions/Json"
      }
