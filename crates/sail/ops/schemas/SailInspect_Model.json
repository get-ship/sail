          "height",
          "width"
        ],
        "properties": {
          "height": {
            "type": "number",
            "format": "double"
          },
          "width": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InspectModelRet",
    "type": "object",
    "required": [
      "data",
      "diagnostics",
      "file",
      "layout",
      "modelVersion",
      "state",
      "theme",
      "tree"
