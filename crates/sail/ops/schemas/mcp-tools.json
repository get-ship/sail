          "format": "uint32",
          "minimum": 0.0
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "column",
        "line"
      ]
    }
  },
