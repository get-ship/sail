        "topic"
      ]
    }
  },
  {
    "name": "sail_check",
    "description": "Run Sail lint/compile diagnostics for a file path or inline source. Returns structured JSON diagnostics (severity, rule, message, line/col, optional rewrite FixPlan). Optional `fix`: off|suggest|apply for confluent allow-listed rewrites (sail-compose-rhythm, sail-compose-contrast, sail-compose-spacing, sail-no-raw-container, spinnaker typo, participation-style, display-on-layout, prefer-primitive). Prefer `source` for snippets; `path` is workspace-relative only (path escape refused — WI4).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actor": {
          "description": "Attribution when fix=apply (e.g. `agent`, `human:name`).",
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "description": "Auto-fix: `off` | `suggest` | `apply`. Default `off` (unattended). `suggest` attaches machine fix payloads without writing; `apply` rewrites the file when `path` is set (or returns fixed `source` when inline).",
          "type": [
            "string",
            "null"
          ]
        },
        "includeTs": {
          "description": "When true (default), merge mapped tsgo TypeScript diagnostics into structure/check results (SPEC-LSP-1 studio gutters). Soft-noops when tsgo is absent. Set `false` for structure-only / faster agent polls.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "path": {
          "description": "Workspace-relative path (WI4: path escape refused). Prefer with no `source` to read disk; absolute / `..` paths are PermissionDenied.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Inline source — unrestricted (source mode; WI4 leaves this unchanged).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "sail_hover",
    "description": "Typed hover at a 1-based .sail position. Uses sail-lsp virtual_ts + tsgo for controller/scope/template TS regions; structure symbols otherwise. Soft-degrades when tsgo is absent.",
