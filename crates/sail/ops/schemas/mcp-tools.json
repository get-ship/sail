[
  {
    "name": "sail_surface",
    "description": "Progressive disclosure of the Sail authoring surface from compiler SSOT. Pass topic: core | layout | style | tokens | l1 | control-flow.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "description": "core | layout | style | tokens | l1 | control-flow",
          "type": "string"
        }
      },
