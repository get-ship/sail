<!--
  <code-block> — syntax-highlighted source.
  pre sx (leading-code + tab-2); .tok-* via compiler descendant map → skins.
-->
<scope>
  props: {
    code = ''
    lang = 'sail'
  }
</scope>
<div use:syntaxHighlight sx="block">
  <pre sx="m-0 font-mono text-sm leading-code tab-2 bg-surface-1 text-foreground border border-border rounded-lg py-4 px-5 overflow-x-auto whitespace-pre"></pre>
</div>
