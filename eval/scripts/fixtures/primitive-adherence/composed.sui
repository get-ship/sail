<!-- FIXTURE (positive): composes the layout primitives, spends design tokens.
     Layout is sui-grid / column / row; UI is sui-* primitives;
     props ride the design-system scale (gap="4", min="md") and every style
     value is a design token. No ad-hoc grid/flex layout off :host, no
     hex/px/raw font. This is the HIGH-scoring shape and it compiles clean
     against the SUI contract in .claude/skills/sui/SKILL.md. -->
<prop name="title" type="string" default="" />

<style>
  :host {
    display: block;
    color: var(--foreground);
    font-family: var(--body-font);
  }
  .panel {
    background: var(--card);
    color: var(--card-foreground);
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
</style>

<column gap="4">
  <row gap="2" justify="between">
    <sui-button tone="primary">{title()}</sui-button>
    <sui-button>Add</sui-button>
  </row>

  <sui-grid class="panel" min="md" gap="3">
    <sui-card>
      <column gap="2">
        <sui-badge tone="success">Ready</sui-badge>
        <span>Item one</span>
      </column>
    </sui-card>
    <sui-card>
      <span>Item two</span>
    </sui-card>
  </sui-grid>
</column>
