<!-- Space Chrome editor — recorded lane output (composed shape).
     Layout is sui-grid / column / row; every styled value is a token;
     every template expression is a pure function of scope signals. -->

<sui-grid min="lg" gap="4">
  <!-- Editor pane: the appearance inspector -->
  <sui-card>
    <column gap="4">
      <row gap="2" justify="between">
        <h2>Appearance</h2>
        {#if dirty()}
          <sui-badge tone="warning">● {editCount()} unsaved</sui-badge>
        {/if}
      </row>

      {#for group of groups() key={group.id}}
        <column gap="2">
          <h3>{group.label}</h3>
          <row gap="1" role="radiogroup" aria-label={group.label}>
            {#for option of group.options key={option}}
              <sui-button
                tone={config()[group.id] === option ? 'primary' : 'neutral'}
                aria-pressed={config()[group.id] === option}
                on:click={() => choose(group.id, option)}
              >{option}</sui-button>
            {/for}
          </row>
        </column>
      {/for}

      <row gap="2" justify="end">
        <sui-button tone="primary" on:click={() => save()}>Save</sui-button>
      </row>
    </column>
  </sui-card>

  <!-- Preview pane: the live space, derived from the editor state -->
  <sui-card class="preview">
    <column gap="3">
      <row gap="2" justify="between">
        <sui-badge tone="info">{config().theme}</sui-badge>
        <span class="sync">live · {spaceName()} · {editCount()} edits</span>
      </row>

      {#match config().nav}
        {:case 'top'}
          <div class="preview-nav-top">nav: top</div>
        {:case 'rail'}
          <div class="preview-nav-rail">nav: rail</div>
        {:case 'none'}
          <span>nav: none</span>
      {/match}

      <p>dock: {config().dock} · density: {config().density}</p>
      <p>glyph: {config().glyph} · accent: {config().accent}</p>
    </column>
  </sui-card>
</sui-grid>

<style>
  :host {
    display: block;
    color: var(--foreground);
    font-family: var(--body-font);
    padding: var(--space-4);
  }
  .preview {
    background: var(--card);
    color: var(--card-foreground);
    border: var(--border);
    border-radius: var(--radius-md);
  }
  .sync {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  .preview-nav-top {
    border-block-end: var(--border);
    padding: var(--space-2);
  }
  .preview-nav-rail {
    border-inline-start: var(--border);
    padding: var(--space-2);
  }
</style>
