<column gap="6" sx={style.pad(8)}>
  <h1>Features</h1>
  <grid cols="3" gap="4">
    <card>
      <column gap="2" sx={style.pad(4)}>
        <h2>Fast</h2>
        <p>Compile and ship without a heavy runtime tax.</p>
      </column>
    </card>
    <card>
      <column gap="2" sx={style.pad(4)}>
        <h2>Typed</h2>
        <p>Props and controllers stay honest under TypeScript.</p>
      </column>
    </card>
    <card>
      <column gap="2" sx={style.pad(4)}>
        <h2>Accessible</h2>
        <p>L1 elements carry roles and labels by default.</p>
      </column>
    </card>
  </grid>
</column>
