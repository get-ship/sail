// Behavioral acceptance for the Authority approval view. Queried by what a user
// perceives (visible text, role+name) — never CSS/signals. given.ship fakes the
// authority domain at the SDK boundary, so no daemon is needed.
//
// The fake pending list two scenarios assume:
//   [0] Editor · Paperback   capability  fs:read ~/Documents/drafts/   risk medium
//   [1] Rust Lane · Ship      command     git push --force-with-lease   risk high
{
  "view": "authority",
  "scenarios": [
    {
      "name": "queue shows the header and pending requests",
      "given": {
        "url": "/authority",
        "ship": {
          "authority.pending": [
            { "id": "r1", "agent": "Editor", "space": "Paperback", "kind": "capability",
              "scope": "fs:read", "path": "~/Documents/drafts/",
              "why": "to import workspace-tab.md into the current draft",
              "risk": "medium", "ageLabel": "38s" },
            { "id": "r2", "agent": "Rust Lane", "space": "Ship", "kind": "command",
              "command": "git push --force-with-lease origin main",
              "why": "push 3 rebased commits", "risk": "high", "ageLabel": "1m" }
          ]
        }
      },
      "steps": [
        { "see": "Authority" },
        { "see": "role:heading name:Awaiting your decision" },
        { "see": "Editor" },
        { "see": "Paperback" },
        { "see": "git push --force-with-lease origin main" },
        { "see": "role:button name:Allow this session" },
        { "see": "role:button name:Deny" }
      ]
    },
    {
      "name": "allowing a request removes it from the queue",
      "given": {
        "url": "/authority",
        "ship": {
          "authority.pending": [
            { "id": "r1", "agent": "Editor", "space": "Paperback", "kind": "capability",
              "scope": "fs:read", "path": "~/Documents/drafts/",
              "why": "to import a file", "risk": "medium", "ageLabel": "38s" }
          ]
        }
      },
      "steps": [
        { "see": "Editor" },
        { "click": "Allow this session" },
        { "notSee": "Editor" }
      ]
    },
    {
      "name": "capability modal shows scope, why, and duration options",
      "given": {
        "url": "/authority",
        "ship": {
          "authority.pending": [
            { "id": "r1", "agent": "Editor", "space": "Paperback", "kind": "capability",
              "scope": "fs:read", "path": "~/Documents/drafts/",
              "why": "to import workspace-tab.md into the current draft",
              "risk": "medium", "ageLabel": "38s" }
          ]
        }
      },
      "steps": [
        { "click": "Editor" },
        { "see": "SCOPE" },
        { "see": "WHY" },
        { "see": "FOR HOW LONG" },
        { "see": "Always" },
        { "see": "role:button name:Allow" }
      ]
    },
    {
      "name": "empty queue shows a caught-up state",
      "given": { "url": "/authority", "ship": { "authority.pending": [] } },
      "steps": [
        { "see": "Authority" },
        { "notSee": "role:heading name:Awaiting your decision" },
        { "see": "caught up" }
      ]
    }
  ]
}
