// Behavioral acceptance for the Space Chrome editor (paired editing). Queried by
// what a user perceives. No ship data needed — the config is local editor state,
// the preview is derived from it. The core assertion is "edit here → reflected
// there": choosing a control updates the preview.
{
  "view": "space-editor",
  "scenarios": [
    {
      "name": "the appearance inspector renders its groups",
      "given": { "url": "/space-editor" },
      "steps": [
        { "see": "Appearance" },
        { "see": "Theme" },
        { "see": "Nav" },
        { "see": "Dock" },
        { "see": "Density" }
      ]
    },
    {
      "name": "the preview reflects the default theme",
      "given": { "url": "/space-editor" },
      "steps": [
        { "see": "paper" }
      ]
    },
    {
      "name": "choosing a dark theme updates the live preview",
      "given": { "url": "/space-editor" },
      "steps": [
        { "choose": { "option": "ship-dark", "in": "Theme" } },
        { "see": "ship-dark" }
      ]
    },
    {
      "name": "choosing rail nav updates the preview",
      "given": { "url": "/space-editor" },
      "steps": [
        { "choose": { "option": "rail", "in": "Nav" } },
        { "see": "rail" }
      ]
    },
    {
      "name": "editing reveals an unsaved indicator and a Save",
      "given": { "url": "/space-editor" },
      "steps": [
        { "choose": { "option": "halo", "in": "Theme" } },
        { "see": "unsaved" },
        { "see": "role:button name:Save" }
      ]
    }
  ]
}
